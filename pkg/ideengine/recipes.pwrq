# task: list the plain text (UTF-8) files in a directory tree
# also: text readable utf8 not binary
# slot dir path = .
get_childitem("{{dir}}"; {Recurse: true})
| select((.Mode | startswith("d") | not) and .Length > 0)
| select(read_bytes(.FullName) | is_utf8)
| .FullName

## file-types-tree
# task: what kind of file each file in a tree is, by its magic bytes
# also: file types magic detect identify every file
# slot dir path = .
get_childitem("{{dir}}"; {Recurse: true})
| select((.Mode | startswith("d") | not) and .Length > 0)
| {Name: .FullName, Type: (.FullName | read_bytes | file_type)}

## readonly-files
# task: list the read-only files
# also: readonly read only write protected permissions
# slot dir path = .
get_childitem("{{dir}}"; {Recurse: true})
| select(.IsReadOnly)
| .FullName

## file-exists
# task: check whether a file or path exists
# also: exists present test check
# slot file file = notes.txt
test_path("{{file}}")

## file-details
# task: the details of one file - its size, times and permissions (stat)
# also: stat info details size modified created mode
# slot file file = notes.txt
get_childitem("{{file}}" | dirname)
| select(.Name == ("{{file}}" | basename))
| {Name: .FullName, Size: (.Length | human_bytes), Created: .CreationTime, Modified: .LastWriteTime, Mode}

## list-archive
# task: list the files inside a zip or tar archive without extracting it
# also: zip tar contents inside list
# slot file file = archive.zip
read_archive("{{file}}")
| map({Name, Size: (.Length | human_bytes)})

## find-archives
# task: find the archive files (zip, tar, gz) in a directory tree
# also: archives zips tarballs compressed packages
# slot dir path = .
get_childitem("{{dir}}"; {Recurse: true})
| select(.Extension | ascii_downcase | IN(".zip", ".tar", ".gz", ".tgz", ".bz2", ".xz", ".7z"))
| {Name: .FullName, Size: (.Length | human_bytes)}

## search-in-archive
# task: extract an archive and search inside its files for text
# also: grep inside zip unzip and search archive contents
# slot file file = archive.zip
# slot pattern pattern: What text or pattern to search for? = hi
expand_archive("{{file}}"; "{{file}}.d") as $written
| select_string("{{file}}.d"; "{{pattern}}")
| "\(.Path):\(.LineNumber): \(.Line)"

## extract-archive
# task: extract (unzip, untar) an archive into a directory
# also: unzip untar unpack decompress
# slot file file = archive.zip
# slot dir path: Into which directory? = out
expand_archive("{{file}}"; "{{dir}}")

## make-archive
# task: compress a directory into a zip (or tar.gz) archive
# also: zip tar compress pack bundle backup
# slot dir path = .
# slot file file: What should the archive be called? = archive.zip
compress_archive("{{dir}}"; "{{file}}")

## backup-folder-dated
# task: back up a folder into a zip archive with today's date in its name
# also: backup snapshot dated zip archive today
# slot dir path = src
compress_archive("{{dir}}"; "{{dir}}-\(now | todate | .[0:10]).zip")
| {Archive: .FullName, Size: (.Length | human_bytes)}

## read-csv
