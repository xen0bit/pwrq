## sqlite-to-csv
# task: export a table of a SQLite database (.db) to a CSV file
# also: export sqlite csv dump table
# slot file file = app.db
# slot table text: Which table? = users
# slot out file: Where should it be saved? = users.csv
[invoke_sqlite_query("{{file}}"; "select * from {{table}}") | del(.PwrqType)]
| (.[0] | keys) as $cols
| [$cols] + map([.[$cols[]] | tostring])
| csv_stringify
| out_file("{{out}}")

## sqlite-to-json
# task: export a SQLite table as JSON
# also: export sqlite json dump table
# slot file file = app.db
# slot table text: Which table? = users
[invoke_sqlite_query("{{file}}"; "select * from {{table}}") | del(.PwrqType)]
| tojson

## sqlite-execute
# task: run an insert, update or delete statement on a SQLite database
# also: insert update delete exec sql statement modify
# slot file file = app.db
# slot sql text: Which complete SQL statement should run? = update users set name = 'ada' where id = 1
invoke_sqlite_command("{{file}}"; "{{sql}}")
| .RowsAffected

## listing-to-sqlite
# task: save a directory listing into a SQLite table
# also: inventory files database sqlite index catalog
# slot dir path = .
# slot db file: Which database file? = files.db
[get_childitem("{{dir}}"; {Recurse: true}) | select(.Mode | startswith("d") | not) | {Name: .FullName, Extension, Bytes: .Length, Modified: .LastWriteTime}]
| out_sqlite("{{db}}"; "files")
| .RowCount

## top-memory-processes
# task: the processes using the most memory (RAM)
# also: ram memory hogs mem usage ps
# slot n number = 10
[get_process]
| sort_by(-.WorkingSet)
| .[:{{n}}]
| map({Id, Name, Memory: (.WorkingSet | human_bytes)})

## top-cpu-processes
# task: the processes using the most CPU
# also: cpu hogs busy load ps top
# slot n number = 10
[get_process]
| sort_by(-.CPU)
| .[:{{n}}]
| map({Id, Name, CPU})

## find-process
# task: find running processes by name
# also: running pid ps grep process is running
# slot name text: Which process or program? = bash
get_process
| select(.Name | test("{{name}}"; "i"))
| {Id, Name, Memory: (.WorkingSet | human_bytes), StartTime}

## kill-process
# task: kill (stop) a process by its id
# also: kill pid stop terminate process
# slot pid number = 12345
stop_process({{pid}})

## kill-by-name
# task: stop every process with a given name (killall)
# also: killall pkill stop all processes named
# slot name text: Which process or program? = sleep
[get_process | select(.Name == "{{name}}") | .Id]
| map(stop_process(.))

## count-processes
# task: count the running processes, and how many of each program
# also: how many processes running ps
[get_process]
| {Total: length, ByName: (count_by("Name") | to_entries | sort_by(-.value) | .[:10] | from_entries)}

## running-services
# task: list the running system services
# also: systemd daemons services running
get_service
| select(.Status == "Running")
| .Name

## stopped-services
# task: list the system services that are not running
# also: stopped inactive dead failed services
get_service
| select(.Status != "Running")
| .Name

## start-service
# task: start a system service
# also: systemctl start service enable run
# slot name text: Which service? = cron
start_service("{{name}}")

## stop-service
# task: stop a system service
# also: systemctl stop service halt
# slot name text: Which service? = cron
stop_service("{{name}}")

## which-command
# task: find where a program (executable command) is installed on the PATH
# also: which where installed path binary executable
# slot name text: Which program or command? = git
which("{{name}}")

## path-entries
# task: list the directories on the PATH environment variable
# also: PATH directories
$ENV.PATH
| split(":")

## environment-variables
# task: list the environment variables
# also: env vars environment
$ENV
| to_entries
| map("\(.key)=\(.value)")

## env-var
# task: the value an environment variable is set to, such as $HOME
# also: env var echo $ getenv variable value set to what is
# slot name text: Which environment variable? = HOME
$ENV["{{name}}"]

## current-user
# task: who am I - the current user name
# also: whoami user username logged in
$ENV.USER

## disk-free
# task: how full the disk is, used and available space (df)
# also: df disk free space full usage partition
# slot dir path = /
sh("df -h {{dir}} | tail -1")
| [splits("\\s+")]
| {Filesystem: .[0], Size: .[1], Used: .[2], Available: .[3], UsePercent: .[4]}

## memory-info
# task: how much memory the machine has, total and available
# also: free -h ram memory total available
cat("/proc/meminfo")
| split("\n")
| map(capture("^(?<key>MemTotal|MemFree|MemAvailable):\\s+(?<kb>\\d+) kB") | {(.key): (.kb | tonumber * 1024 | human_bytes)})
| add

## load-average
# task: the machine's load averages
# also: load average uptime cpu load busy
cat("/proc/loadavg")
| split(" ")
| .[0:3]
| map(tonumber)
| {Load1: .[0], Load5: .[1], Load15: .[2]}

## uptime
# task: how long the machine has been up
# also: uptime boot running since
cat("/proc/uptime")
| split(" ") | .[0]
| tonumber
| {Seconds: ., Days: (. / 86400 | floor), Hours: (. % 86400 / 3600 | floor)}

## cpu-count
# task: how many CPUs (cores) the machine has
# also: nproc cores cpus processors
sh("nproc")
| tonumber

## run-command
# task: run a shell command and get its output
# also: shell exec run execute
# slot command text: Which shell command? = uname -a
sh("{{command}}")

## current-date
# task: the current date and time, today's date
# also: today date time now clock
get_date
| {Date, Time, DayOfWeek, Timezone}

## unix-timestamp
# task: the current time as a Unix timestamp (epoch seconds)
# also: epoch unix time seconds now timestamp
now
| floor

## time-in-zone
# task: what time it is now in another time zone, such as Asia/Tokyo
# also: timezone time zone what time is it in
# slot zone text: Which time zone? = Asia/Tokyo
to_timezone(now; "{{zone}}")

## current-directory
# task: the current (working) directory
# also: pwd cwd working directory where am i
get_location
| .Path

## resolve-host
# task: resolve a host name (domain) to its IP addresses, a DNS lookup
# also: dns lookup ip address resolve nslookup dig
# slot host host = example.com
resolve_host("{{host}}")

## reverse-dns
# task: reverse DNS lookup, the host name of an IP address
# also: ptr hostname reverse lookup name of ip
# slot ip ip = 8.8.8.8
reverse_dns("{{ip}}")

## ping-host
# task: ping a host, check whether it is reachable
# also: ping reachable alive up
# slot host host = example.com
test_connection("{{host}}")

## resolve-hosts-file
# task: resolve every host name listed in a file
# also: dns lookup each host list resolve all
# slot file file = hosts.txt
cat("{{file}}")
| split("\n")
| map(select(length > 0) | {Host: ., Addresses: resolve_host(.)})

## ping-hosts-file
# task: check which hosts listed in a file are reachable
# also: health check ping all hosts list up down
# slot file file = hosts.txt
cat("{{file}}")
| split("\n")
| map(select(length > 0) | {Host: ., Reachable: test_connection(.; {Count: 1, Quiet: true})})

## port-open
# task: check whether a TCP port is open on a host
# also: port open listening tcp nc
# slot host host = example.com
# slot port number: Which port? = 443
test_connection("{{host}}"; {TcpPort: {{port}}, Quiet: true})

## http-status
# task: check whether a website is up, its HTTP status code
# also: up down status website online curl
# slot url url = https://example.com
invoke_web_request("{{url}}")
| {StatusCode, Status, ContentType}

## http-headers
# task: the HTTP response headers of a URL
# also: headers response curl -I
# slot url url = https://example.com
invoke_web_request("{{url}}")
| .Headers

## fetch-page
# task: fetch a web page and get its text (curl)
# also: curl wget get page html body content
# slot url url = https://example.com
invoke_web_request("{{url}}")
| .Content

## page-title
# task: the title of a web page
# also: title html page heading
# slot url url = https://example.com
invoke_web_request("{{url}}")
| .Content
| capture("<title>(?<title>[^<]*)</title>").title

## fetch-json-field
# task: fetch JSON from an API and take one field
# also: api field json value rest
# slot url url = https://api.github.com
# slot field field = current_user_url
invoke_rest_method("{{url}}")
| .{{field}}

## post-json
# task: POST JSON to a URL and see the response
# also: post send json body api request curl -X POST
# slot url url = https://httpbin.org/post
# slot body text: What JSON should be sent? = {"name": "ada"}
invoke_web_request("{{url}}"; {Method: "POST", Body: "{{body}}", ContentType: "application/json"})
| {StatusCode, Content}

## request-with-header
# task: send a web request with a custom header, such as an authorization token
# also: header authorization bearer token custom headers curl -H
# slot url url = https://httpbin.org/headers
# slot name text: Which header? = Authorization
# slot value text: What is the header's value? = Bearer TOKEN
invoke_web_request("{{url}}"; {Headers: {"{{name}}": "{{value}}"}})
| .Content

## save-json-response
# task: download JSON from an API and save it to a file on disk
# also: save api response json to file
# slot url url = https://api.github.com
# slot out file: Where should it be saved? = response.json
invoke_rest_method("{{url}}")
| tojson
| out_file("{{out}}")

## check-links
# task: check every URL mentioned in a file and show each one's HTTP status
# also: link checker dead links broken urls status
# slot file file = links.txt
cat("{{file}}")
| extract_urls
| unique
| map(. as $u | {Url: $u, Status: (try (invoke_web_request($u; {TimeoutSec: 10}) | .StatusCode) catch "failed")})

## download-url-list
# task: download every URL listed in a file
# also: download all urls list batch wget -i
# slot file file = urls.txt
cat("{{file}}")
| split("\n")
| map(select(length > 0) | . as $u | invoke_web_request($u; {OutFile: ($u | split("/") | last)}) | {Url: $u, Saved: .Path})

## fetch-json
# task: fetch JSON from a REST API endpoint
# also: api rest get json curl
# slot url url = https://api.github.com
invoke_rest_method("{{url}}")

## page-links
# task: extract the links (URLs) from a web page
# also: links hrefs urls scrape
# slot url url = https://example.com
invoke_web_request("{{url}}")
| .Content
| extract_urls
| unique

## download-file
# task: download a file from a URL and save it
# also: download save wget curl -o fetch
# slot url url = https://example.com
# slot file file: Where should it be saved? = page.html
invoke_web_request("{{url}}"; {OutFile: "{{file}}"})
| {StatusCode, Saved: "{{file}}"}

## ip-info
# task: whether an IP address is private, public or loopback, and its version
# also: private public address rfc1918
# slot ip ip = 192.168.1.10
"{{ip}}"
| {ip: ., version: ip_version, private: is_private_ip, loopback: is_loopback}

## cidr-info
# task: the range of a CIDR subnet: network, broadcast, first and last host, size
# also: subnet cidr range hosts netmask
# slot cidr text: Which CIDR range or subnet? = 10.0.0.0/24
"{{cidr}}"
| {network: cidr_network, broadcast: cidr_broadcast, first: cidr_first_host, last: cidr_last_host, size: cidr_size}

## count-items
# task: count the items (elements, entries) of the input
# also: length count how many size
length

## object-keys
# task: list the keys (fields, properties) of the input
# also: keys fields properties columns
if type == "array" then map(keys) | add | unique else keys end

## filter-by-field
# task: keep only the items whose field equals a value
# also: where equals filter only matching
# slot field field = status
# slot value text: Which value? = active
map(select(.{{field}} == "{{value}}"))

## filter-greater-than
# task: keep only the items whose numeric field is above (greater than) a number
# also: older bigger above more than greater over
# slot field field = age
# slot number number: Above what number? = 30
map(select(.{{field}} > {{number}}))

## sort-by-field
# task: sort the items by a field
# also: sort order arrange by
# slot field field = name
sort_by(.{{field}})

## top-by-field
# task: the top items with the largest value of a field
# also: top highest best most largest
# slot field field = score
# slot n number = 5
sort_by(-.{{field}})
| .[:{{n}}]

## group-count
# task: count the items by (grouped by) a field, how many of each value
# also: count per by group tally histogram
# slot field field = status
count_by("{{field}}")

## group-by-field
# task: group the items by a field
# also: group bucket by
# slot field field = status
group_by(.{{field}})
| map({key: (.[0].{{field}} | tostring), value: .})
| from_entries

## sum-field
# task: the total (sum) of a numeric field
# also: total sum add up
# slot field field = amount
map(.{{field}})
| add

## average-field
# task: the average (mean) of a numeric field
# also: average mean avg
# slot field field = amount
map(.{{field}})
| add / length

## stats-field
# task: statistics of a numeric field: min, max, mean, median, standard deviation
# also: statistics min max median stddev summary
# slot field field = amount
map(.{{field}})
| summary

## unique-values
# task: the distinct (unique) values of a field
# also: distinct unique values set
# slot field field = status
map(.{{field}})
| unique

## pluck-field
# task: the value of one field from every item
# also: just only extract values field ids names
# slot field field = name
map(.{{field}})

## remove-duplicates
# task: remove duplicate items
# also: dedupe duplicates unique
unique

## flatten-json
# task: flatten nested JSON into dotted keys
# also: flatten nested dotted
flatten_keys

## as-table
# task: show the items as a table
# also: table format pretty
format_table(.)

## extract-emails
# task: extract the email addresses from text
# also: emails addresses
extract_emails
| unique

## extract-urls
# task: extract the URLs (links) from text
# also: urls links
extract_urls
| unique

## extract-ips
# task: extract the IP addresses from text
# also: ip addresses
extract_ips
| unique

## base64-decode
# task: decode base64
# also: base64 decode
base64_decode

## base64-encode
# task: encode as base64
# also: base64 encode
base64_encode

## jwt-decode
# task: decode a JWT (JSON web token)
# also: jwt token claims
jwt_decode

## url-decode
# task: decode a URL-encoded (percent-encoded) string
# also: percent decode unescape
url_decode

## text-lines
# task: split text into lines, dropping blank ones
# also: lines split newline
split("\n")
| map(select(test("\\S")))

## sha256-text
# task: the sha256 hash of the input text
# also: hash sha256 string
sha256

## timestamps-to-dates
# task: convert Unix timestamps (epoch seconds) to readable dates
# also: epoch unix timestamps dates
if type == "array" then map(todate) else todate end

## sentiment
# task: use a decision model to tell the sentiment of text: positive, neutral or negative
# also: positive negative tone mood d1
invoke_systemone({sentiment: {type: "choice", instructions: "What is the sentiment of the text?", criteria: {positive: null, neutral: null, negative: null}}})
| .sentiment.choice

## text-yes-no
# task: use a decision model to answer a yes or no question about the input text
# also: ask d1 decision question yes no
# slot question phrase: What question should be asked? = Is this urgent?
invoke_systemone({q: {type: "noul", instructions: "{{question}}"}})
| .q.noul

## classify-lines
# task: use a decision model to flag the lines of a file that match a description
# also: d1 lines about flag classify
# slot file file = app.log
# slot subject phrase: What should the lines be about? = a failure
cat("{{file}}")
| split("\n")
| map(select(length > 0))
| map({line: ., p: invoke_systemone({q: {type: "noul", instructions: "Is this line about {{subject}}?"}}).q.noul})
| map(select(.p > 0.5) | .line)

## triage-errors
# task: use a decision model to triage the errors in a log by severity, most urgent first
# also: triage severity urgent errors d1 prioritize
# slot file file = app.log
# slot pattern pattern: What text or pattern to search for? = ERROR
grep_lines("{{file}}"; "{{pattern}}")
| unique
| map({Error: ., Severity: invoke_systemone({s: {type: "choice", instructions: "How severe is this error?", criteria: {urgent: "Needs action now", soon: "Should be fixed soon", noise: "Harmless noise"}}}).s.choice})
| sort_by(.Severity)

## urgent-todos
# task: use a decision model to find which TODO comments are urgent
# also: urgent todos prioritize d1 important fixme
# slot dir path = .
[select_string("{{dir}}"; "TODO|FIXME") | {Path, LineNumber, Line}]
| map(select(.Line | invoke_systemone({q: {type: "noul", instructions: "Is this an urgent task?"}}).q.noul > 0.5))

## summarize-file
# task: summarize a file with a language model (LLM)
# also: summary tldr llm
# slot file file = notes.txt
cat("{{file}}")
| invoke_llm("Summarize this in three sentences:\n\n\(.)")

## ask-llm
# task: ask a language model (LLM) a question
# also: llm ask chatgpt claude prompt question
# slot question text: What question should be asked? = What is jq?
invoke_llm("{{question}}")

## code-rules
# task: scan source code for security problems with the pwrgrep rules
# also: security scan vulnerabilities audit pwrgrep lint
# slot dir path = .
# slot language text: Which programming language? = go
invoke_pwrgrep("{{dir}}"; "{{language}}")
| {RuleId, Path, LineNumber, Message}

## findings-per-rule
# task: how many findings each pwrgrep security rule produced
# also: findings count per rule audit summary
# slot dir path = .
# slot language text: Which programming language? = go
[invoke_pwrgrep("{{dir}}"; "{{language}}")]
| count_by("RuleId")

## list-functions
# task: outline Go source code: the names of the functions it defines
# also: functions defined func names symbols outline
# slot dir path = .
select_ast("{{dir}}"; "func $NAME($$$ARGS) { $$$BODY }")
| .Captures.NAME

## cmdlet-help
# task: how to use a pwrq cmdlet or function: show its help and usage
# also: help usage how to use man page documentation
# slot name text: Which cmdlet? = get_childitem
get_help("{{name}}")
