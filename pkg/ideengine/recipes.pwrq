# slot table text: Which table? = rows
cat("{{file}}")
| csv_parse
| .[0] as $header
| .[1:]
| map([$header, .] | transpose | map({key: .[0], value: .[1]}) | from_entries)
| out_sqlite("{{db}}"; "{{table}}")
| .RowCount

