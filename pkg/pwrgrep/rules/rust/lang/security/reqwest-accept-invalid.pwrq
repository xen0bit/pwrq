# rules: reqwest-accept-invalid
# from: rust/lang/security/reqwest-accept-invalid.yml

. as $root
| ( ($root | scan_ast(["*.rs"]; [
      "reqwest::Client::builder(). $$$_ .danger_accept_invalid_certs(true)",
      "reqwest::Client::builder(). $$$_ .danger_accept_invalid_hostnames(true)"
    ])) as $all
    | ( $all | of(["reqwest::Client::builder(). $$$_ .danger_accept_invalid_hostnames(true)","reqwest::Client::builder(). $$$_ .danger_accept_invalid_certs(true)"])
        | finding("reqwest-accept-invalid";
            "Dangerously accepting invalid TLS information") ) )
| report
