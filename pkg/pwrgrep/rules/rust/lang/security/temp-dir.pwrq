# rules: temp-dir
# from: rust/lang/security/temp-dir.yml

. as $root
| ( ($root | scan_ast(["*.rs"]; [
      "std::env::temp_dir()"
    ])) as $all
    | ( $all | of(["std::env::temp_dir()"])
        | finding("temp-dir";
            "temp_dir should not be used for security operations.") ) )
| report
