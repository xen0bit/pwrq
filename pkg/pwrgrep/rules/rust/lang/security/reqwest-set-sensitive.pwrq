# rules: reqwest-set-sensitive
# languages: rust
# from: rust/lang/security/reqwest-set-sensitive.yml

. as $root
| ( ($root | scan_ast(["*.rs"]; [
      "let mut $HEADERS = header::HeaderMap::new();\n$$$_\nlet $HEADER_VALUE = $PWRQDEEP1;\n$$$_\n$HEADERS.insert($HEADER, $HEADER_VALUE);",
      "let mut $HEADERS = header::HeaderMap::new();\n$$$_\nlet $HEADER_VALUE = $PWRQDEEP1;\n$$$_\n$HEADER_VALUE.set_sensitive(true);\n$$$_\n$HEADERS.insert($HEADER, $HEADER_VALUE);"
    ])) as $all
    | ( $all | of(["let mut $HEADERS = header::HeaderMap::new();\n$$$_\nlet $HEADER_VALUE = $PWRQDEEP1;\n$$$_\n$HEADERS.insert($HEADER, $HEADER_VALUE);"])
          | where_capture_ast("PWRQDEEP1"; "header::HeaderValue::$FROM_FUNC($$$_)")
          | not_at($all | of(["let mut $HEADERS = header::HeaderMap::new();\n$$$_\nlet $HEADER_VALUE = $PWRQDEEP1;\n$$$_\n$HEADER_VALUE.set_sensitive(true);\n$$$_\n$HEADERS.insert($HEADER, $HEADER_VALUE);"])
          | where_capture_ast("PWRQDEEP1"; "header::HeaderValue::$FROM_FUNC($$$_)"))
        | finding("reqwest-set-sensitive";
            "Set sensitive flag on security headers with 'set_sensitive' to treat data with special care") ) )
| report
