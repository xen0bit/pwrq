      "function $F($$$_,$INPUT,$$$_) {\n  $$$_\n  $OPTS = {sandbox: $PWRQDEEP1};\n  $$$_\n  new NodeVM($OPTS,$$$_);\n  $$$_\n}",
      "function $F($$$_,$INPUT,$$$_) {\n  $$$_\n  $OPTS = {sandbox: $PWRQDEEP1};\n  $$$_\n  new VM($OPTS,$$$_);\n  $$$_\n}",
      "function $F($$$_,$INPUT,$$$_) {\n  $$$_\n  $VAR = $PWRQDEEP1;\n  $$$_\n  $CONTEXT = {$NAME: $PWRQDEEP2};\n  $$$_\n  $OPTS = {sandbox: $PWRQDEEP3};\n  $$$_\n  new NodeVM($OPTS,$$$_);\n  $$$_\n}",
