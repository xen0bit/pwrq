          | where_capture_ast("PWRQDEEP1"; "$INPUT")
          | where_capture_ast("PWRQDEEP2"; "$CONTEXT"))
          + ($all | of(["function $F($$$_,$INPUT,$$$_) {\n  $$$_\n  $VAR = $PWRQDEEP1;\n  $$$_\n  $CONTEXT = {$NAME: $PWRQDEEP2};\n  $$$_\n  new VM({sandbox: $PWRQDEEP3},$$$_);\n  $$$_\n}"])
          | where_capture_ast("PWRQDEEP1"; "$INPUT")
