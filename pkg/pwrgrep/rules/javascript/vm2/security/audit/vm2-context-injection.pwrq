          | where_capture_ast("PWRQDEEP1"; "$INPUT")
          | where_capture_ast("PWRQDEEP2"; "$VAR")
          | where_capture_ast("PWRQDEEP3"; "$CONTEXT"))
          + ($all | of(["function $F($$$_,$INPUT,$$$_) {\n  $$$_\n  new VM({sandbox: $PWRQDEEP1},$$$_);\n  $$$_\n}"])
