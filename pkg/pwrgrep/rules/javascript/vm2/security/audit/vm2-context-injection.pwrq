          | where_capture_ast("PWRQDEEP1"; "$INPUT"))
          + ($all | of(["function $F($$$_,$INPUT,$$$_) {\n  $$$_\n  $CONTEXT = $PWRQDEEP1;\n  $$$_\n  $OPTS = {sandbox: $PWRQDEEP2};\n  $$$_\n  new VM($OPTS,$$$_);\n  $$$_\n}"])
          | where_capture_ast("PWRQDEEP1"; "$INPUT")
          | where_capture_ast("PWRQDEEP2"; "$CONTEXT"))
          + ($all | of(["function $F($$$_,$INPUT,$$$_) {\n  $$$_\n  $CONTEXT = {$NAME: $PWRQDEEP1};\n  $$$_\n  $OPTS = {sandbox: $PWRQDEEP2};\n  $$$_\n  new VM($OPTS,$$$_);\n  $$$_\n}"])
          | where_capture_ast("PWRQDEEP1"; "$INPUT")
          | where_capture_ast("PWRQDEEP2"; "$CONTEXT"))
          + ($all | of(["function $F($$$_,$INPUT,$$$_) {\n  $$$_\n  $VAR = $PWRQDEEP1;\n  $$$_\n  $CONTEXT = {$NAME: $PWRQDEEP2};\n  $$$_\n  $OPTS = {sandbox: $PWRQDEEP3};\n  $$$_\n  new VM($OPTS,$$$_);\n  $$$_\n}"])
          | where_capture_ast("PWRQDEEP1"; "$INPUT")
          | where_capture_ast("PWRQDEEP2"; "$VAR")
