      "function $F($$$_,$INPUT,$$$_) {\n  $$$_\n  $CONTEXT = $PWRQDEEP1;\n  $$$_\n  $OPTS = {sandbox: $PWRQDEEP2};\n  $$$_\n  new NodeVM($OPTS,$$$_);\n  $$$_\n}",
      "function $F($$$_,$INPUT,$$$_) {\n  $$$_\n  $CONTEXT = $PWRQDEEP1;\n  $$$_\n  $OPTS = {sandbox: $PWRQDEEP2};\n  $$$_\n  new VM($OPTS,$$$_);\n  $$$_\n}",
