          | where_capture_ast("PWRQDEEP1"; "$INPUT")
          | where_capture_ast("PWRQDEEP2"; "$VAR")
          | where_capture_ast("PWRQDEEP3"; "$CONTEXT"))
          + ($all | of(["function ($$$_,$INPUT,$$$_) {\n  $$$_\n  $OPTS = {sandbox: $PWRQDEEP1};\n  $$$_\n  new VM($OPTS,$$$_);\n  $$$_\n}"])
          | where_capture_ast("PWRQDEEP1"; "$INPUT"))
          + ($all | of(["function ($$$_,$INPUT,$$$_) {\n  $$$_\n  $CONTEXT = $PWRQDEEP1;\n  $$$_\n  $OPTS = {sandbox: $PWRQDEEP2};\n  $$$_\n  new VM($OPTS,$$$_);\n  $$$_\n}"])
          | where_capture_ast("PWRQDEEP1"; "$INPUT")
