# rules: create-de-cipher-no-iv
# from: javascript/node-crypto/security/create-de-cipher-no-iv.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$CRYPTO.createCipher($$$_)",
      "$CRYPTO.createDecipher($$$_)"
    ])) as $all
    | ( $all | of(["$CRYPTO.createCipher($$$_)","$CRYPTO.createDecipher($$$_)"])
        | finding("create-de-cipher-no-iv";
            "The deprecated functions 'createCipher' and 'createDecipher' generate the same initialization vector every time.") ) )
| report
