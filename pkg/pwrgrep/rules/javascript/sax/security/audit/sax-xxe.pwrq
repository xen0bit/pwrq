# rules: sax-xxe
# languages: javascript, typescript
# from: javascript/sax/security/audit/sax-xxe.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "require('sax');\n$$$_\n$PARSER.on('doctype',$$$_);",
      "require('sax');\n$$$_\n$PARSER.ondoctype = $$$_;"
    ])) as $all
    | ( $all | of(["require('sax');\n$$$_\n$PARSER.ondoctype = $$$_;","require('sax');\n$$$_\n$PARSER.on('doctype',$$$_);"])
        | finding("sax-xxe";
            "Use of 'ondoctype' in 'sax' library detected.") ) )
| report
