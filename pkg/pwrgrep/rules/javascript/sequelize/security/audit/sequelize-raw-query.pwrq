# rules: sequelize-raw-query
# from: javascript/sequelize/security/audit/sequelize-raw-query.yaml

. as $root
| ( ($root | scan_regex(["*.js","*.ts"]; [
      "(?P<DATABASE>\\S+)\\.sequelize\\.query\\((?P<SQL>\\S+)\\s+\\+\\s+(?P<VALUE>\\S+),\\s+[\\s\\S]*?\\)",
      "(?P<DATABASE>\\S+)\\.sequelize\\.query\\(`[\\s\\S]*?\\$\\{[\\s\\S]*?\\}[\\s\\S]*?`,\\s+[\\s\\S]*?\\)",
      "(?P<QUERY>\\S+)\\s+=\\s+(?P<SQL>\\S+)\\s+\\+\\s+(?P<VALUE>\\S+)\\s+[\\s\\S]*?\\s+(?P<DATABASE>\\S+)\\.sequelize\\.query\\((?P<QUERY>\\S+),\\s+[\\s\\S]*?\\)",
      "(?P<QUERY>\\S+)\\s+=\\s+(?P<SQL>\\S+)\\s+\\+\\s+(?P<VALUE>\\S+)\\s+[\\s\\S]*?\\s+Sequelize\\.literal\\((?P<QUERY>\\S+)\\)",
      "(?P<QUERY>\\S+)\\s+=\\s+`[\\s\\S]*?\\$\\{[\\s\\S]*?\\}[\\s\\S]*?`\\s+[\\s\\S]*?\\s+(?P<DATABASE>\\S+)\\.sequelize\\.query\\((?P<QUERY>\\S+),\\s+[\\s\\S]*?\\)",
      "(?P<QUERY>\\S+)\\s+=\\s+`[\\s\\S]*?\\$\\{[\\s\\S]*?\\}[\\s\\S]*?`\\s+[\\s\\S]*?\\s+Sequelize\\.literal\\((?P<QUERY>\\S+)\\)",
      "Sequelize\\.literal\\((?P<SQL>\\S+)\\s+\\+\\s+(?P<VALUE>\\S+)\\)",
      "Sequelize\\.literal\\(`[\\s\\S]*?\\$\\{[\\s\\S]*?\\}[\\s\\S]*?`\\)"
    ])) as $all
    | ( $all | of(["(?P<DATABASE>\\S+)\\.sequelize\\.query\\(`[\\s\\S]*?\\$\\{[\\s\\S]*?\\}[\\s\\S]*?`,\\s+[\\s\\S]*?\\)","(?P<QUERY>\\S+)\\s+=\\s+`[\\s\\S]*?\\$\\{[\\s\\S]*?\\}[\\s\\S]*?`\\s+[\\s\\S]*?\\s+(?P<DATABASE>\\S+)\\.sequelize\\.query\\((?P<QUERY>\\S+),\\s+[\\s\\S]*?\\)","(?P<DATABASE>\\S+)\\.sequelize\\.query\\((?P<SQL>\\S+)\\s+\\+\\s+(?P<VALUE>\\S+),\\s+[\\s\\S]*?\\)","(?P<QUERY>\\S+)\\s+=\\s+(?P<SQL>\\S+)\\s+\\+\\s+(?P<VALUE>\\S+)\\s+[\\s\\S]*?\\s+(?P<DATABASE>\\S+)\\.sequelize\\.query\\((?P<QUERY>\\S+),\\s+[\\s\\S]*?\\)","Sequelize\\.literal\\(`[\\s\\S]*?\\$\\{[\\s\\S]*?\\}[\\s\\S]*?`\\)","(?P<QUERY>\\S+)\\s+=\\s+`[\\s\\S]*?\\$\\{[\\s\\S]*?\\}[\\s\\S]*?`\\s+[\\s\\S]*?\\s+Sequelize\\.literal\\((?P<QUERY>\\S+)\\)","Sequelize\\.literal\\((?P<SQL>\\S+)\\s+\\+\\s+(?P<VALUE>\\S+)\\)","(?P<QUERY>\\S+)\\s+=\\s+(?P<SQL>\\S+)\\s+\\+\\s+(?P<VALUE>\\S+)\\s+[\\s\\S]*?\\s+Sequelize\\.literal\\((?P<QUERY>\\S+)\\)"])
        | finding("sequelize-raw-query";
            "Avoiding SQL string concatenation: untrusted input concatenated with raw SQL query can result in SQL Injection.") ) )
| report
