# rules: jose-exposed-data
# languages: javascript, typescript
# from: javascript/jose/security/audit/jose-exposed-data.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$JOSE.JWT.sign($INPUT,$$$_)",
      "$JWT.sign($INPUT,$$$_)",
      "function $F($$$_,$INPUT,$$$_) {$$$_}",
      "function ($$$_,$INPUT,$$$_) {$$$_}",
      "require('jose');\n$$$_"
    ])) as $all
    | ( ($all | of(["$JOSE.JWT.sign($INPUT,$$$_)","$JWT.sign($INPUT,$$$_)"])
          | within($all | of(["function ($$$_,$INPUT,$$$_) {$$$_}"])))
          + ($all | of(["$JOSE.JWT.sign($INPUT,$$$_)","$JWT.sign($INPUT,$$$_)"])
          | within($all | of(["function $F($$$_,$INPUT,$$$_) {$$$_}"])))
          | in_files_with($all | of(["require('jose');\n$$$_"]))
        | finding("jose-exposed-data";
            "The object is passed strictly to jose.JWT.sign(...) Make sure that sensitive information is not exposed through JWT token payload.") ) )
| report
