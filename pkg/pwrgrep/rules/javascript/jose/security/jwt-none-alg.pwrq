# rules: jwt-none-alg
# from: javascript/jose/security/jwt-none-alg.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "var $JOSE = require(\"jose\");\n$$$_\nvar { JWK, JWT } = $JOSE;\n$$$_\n$T = JWT.verify($P, JWK.None,$$$_);",
      "var $JOSE = require(\"jose\");\n$$$_\nvar { JWK, JWT } = $JOSE;\n$$$_\nJWT.verify($P, JWK.None,$$$_);",
      "var $JOSE = require(\"jose\");\n$$$_\nvar { JWK, JWT } = $JOSE;\n$$$_\nvar $T = JWT.verify($P, JWK.None,$$$_);"
    ])) as $all
    | ( $all | of(["var $JOSE = require(\"jose\");\n$$$_\nvar { JWK, JWT } = $JOSE;\n$$$_\nvar $T = JWT.verify($P, JWK.None,$$$_);","var $JOSE = require(\"jose\");\n$$$_\nvar { JWK, JWT } = $JOSE;\n$$$_\n$T = JWT.verify($P, JWK.None,$$$_);","var $JOSE = require(\"jose\");\n$$$_\nvar { JWK, JWT } = $JOSE;\n$$$_\nJWT.verify($P, JWK.None,$$$_);"])
        | finding("jwt-none-alg";
            "Detected use of the 'none' algorithm in a JWT token.") ) )
| report
