# rules: eval-detected
# from: javascript/browser/security/eval-detected.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "eval(\"$$$_\")",
      "eval($$$_)"
    ])) as $all
    | ( $all | of(["eval($$$_)"])
          | not_at($all | of(["eval(\"$$$_\")"]))
        | finding("eval-detected";
            "Detected the use of eval().") ) )
| report
