# rules: insecure-document-method
# languages: javascript, typescript
# from: javascript/browser/security/insecure-document-method.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$EL.innerHTML = \"$$$_\";",
      "$EL.innerHTML = $HTML;",
      "$EL.outerHTML = \"$$$_\";",
      "$EL.outerHTML = $HTML;",
      "document.write(\"$$$_\")",
      "document.write($$$_)"
    ])) as $all
    | ( $all | of(["$EL.innerHTML = $HTML;","$EL.outerHTML = $HTML;","document.write($$$_)"])
          | not_at($all | of(["$EL.innerHTML = \"$$$_\";"]))
          | not_at($all | of(["$EL.outerHTML = \"$$$_\";"]))
          | not_at($all | of(["document.write(\"$$$_\")"]))
        | finding("insecure-document-method";
            "User controlled data in methods like `innerHTML`, `outerHTML` or `document.write` is an anti-pattern that can lead to XSS vulnerabilities") ) )
| report
