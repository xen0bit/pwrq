# rules: wkhtmltopdf-injection
# from: javascript/wkhtmltopdf/security/audit/wkhtmltopdf-injection.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "\"$$$_\"",
      "$WK = require('wkhtmltopdf');\n$$$_",
      "$WK(\"$$$_\",$$$_)",
      "$WK($INPUT,$$$_)",
      "var $INPUT = \"$$$_\";\n$$$_"
    ])) as $all
    | ( $all | of(["$WK($INPUT,$$$_)"])
          | in_files_with($all | of(["$WK = require('wkhtmltopdf');\n$$$_"]))
          | in_files_without($all | of(["var $INPUT = \"$$$_\";\n$$$_","\"$$$_\""]))
          | not_at($all | of(["$WK(\"$$$_\",$$$_)"]))
        | finding("wkhtmltopdf-injection";
            "If unverified user data can reach the `wkhtmltopdf` it can result in Server-Side Request Forgery vulnerabilities") ) )
| report
