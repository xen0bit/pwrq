# rules: ajv-allerrors-true
# languages: javascript, typescript
# from: javascript/ajv/security/audit/ajv-allerrors-true.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$SETTINGS = {$$$_,allErrors: true,$$$_}\n$$$_",
      "new Ajv($SETTINGS,$$$_)",
      "new Ajv({$$$_,allErrors: true,$$$_},$$$_)"
    ])) as $all
    | ( ($all | of(["new Ajv({$$$_,allErrors: true,$$$_},$$$_)"]))
          + ($all | of(["new Ajv($SETTINGS,$$$_)"])
          | in_files_with($all | of(["$SETTINGS = {$$$_,allErrors: true,$$$_}\n$$$_"])))
        | finding("ajv-allerrors-true";
            "By setting `allErrors: true` in `Ajv` library, all error objects will be allocated without limit.") ) )
| report
