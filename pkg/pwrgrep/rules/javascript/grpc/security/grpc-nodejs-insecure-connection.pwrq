# rules: grpc-nodejs-insecure-connection
# languages: javascript, typescript
# from: javascript/grpc/security/grpc-nodejs-insecure-connection.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "require('grpc');\n$$$_\n$CREDS = $PWRQDEEP1;\n$$$_\n$GRPC($ADDR,$$$_,$CREDS,$$$_);",
      "require('grpc');\n$$$_\n$CREDS = $PWRQDEEP1;\n$$$_\nnew $GRPC($ADDR,$$$_,$CREDS,$$$_);",
      "require('grpc');\n$$$_\n$GRPC($ADDR,$$$_,$CREDENTIALS.createInsecure(),$$$_);",
      "require('grpc');\n$$$_\nnew $GRPC($ADDR,$$$_,$CREDENTIALS.createInsecure(),$$$_);"
    ])) as $all
    | ( ($all | of(["require('grpc');\n$$$_\n$GRPC($ADDR,$$$_,$CREDENTIALS.createInsecure(),$$$_);"]))
          + ($all | of(["require('grpc');\n$$$_\nnew $GRPC($ADDR,$$$_,$CREDENTIALS.createInsecure(),$$$_);"]))
          + ($all | of(["require('grpc');\n$$$_\n$CREDS = $PWRQDEEP1;\n$$$_\n$GRPC($ADDR,$$$_,$CREDS,$$$_);"])
          | where_capture_ast("PWRQDEEP1"; "$CREDENTIALS.createInsecure()"))
          + ($all | of(["require('grpc');\n$$$_\n$CREDS = $PWRQDEEP1;\n$$$_\nnew $GRPC($ADDR,$$$_,$CREDS,$$$_);"])
          | where_capture_ast("PWRQDEEP1"; "$CREDENTIALS.createInsecure()"))
        | finding("grpc-nodejs-insecure-connection";
            "Found an insecure gRPC connection.") ) )
| report
