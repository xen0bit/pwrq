# rules: unsafe-argon2-config
# languages: javascript, typescript
# from: javascript/argon2/security/unsafe-argon2-config.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$ARGON = require('argon2');\n$$$_",
      "$ARGON.hash($$$_,$Y)",
      "$Y",
      "{type: $$$_}",
      "{type: $ARGON.argon2id}\n$$$_"
    ])) as $all
    | ( (($all | of(["$Y"])
          | within($all | of(["$ARGON.hash($$$_,$Y)"]))))
          | reaching((($all | of(["{type: $$$_}"])
          | in_files_with($all | of(["$ARGON = require('argon2');\n$$$_"]))));
              (($all | of(["{type: $ARGON.argon2id}\n$$$_"]))))
        | finding("unsafe-argon2-config";
            "Prefer Argon2id where possible.") ) )
| report
