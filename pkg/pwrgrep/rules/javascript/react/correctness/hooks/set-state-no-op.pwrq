# rules: calling-set-state-on-current-state
# from: javascript/react/correctness/hooks/set-state-no-op.yaml

. as $root
| ( ($root | scan_ast(["*.js"]; [
      "$Y($X);",
      "const [$X, $Y] = useState($$$_);\n$$$_"
    ])) as $all
    | ( $all | of(["$Y($X);"])
          | in_files_with($all | of(["const [$X, $Y] = useState($$$_);\n$$$_"]))
        | finding("calling-set-state-on-current-state";
            "Calling setState on the current state is always a no-op.") ) )
| report
