# rules: detect-insecure-websocket
# from: javascript/lang/security/detect-insecure-websocket.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "\\bws:\\/\\/",
      "\\bws:\\/\\/127.0.0.1.*",
      "\\bws:\\/\\/localhost.*"
    ])) as $all
    | ( $all | of(["\\bws:\\/\\/"])
          | outside($all | of(["\\bws:\\/\\/localhost.*"]))
          | outside($all | of(["\\bws:\\/\\/127.0.0.1.*"]))
        | finding("detect-insecure-websocket";
            "Insecure WebSocket Detected.") ) )
| report
