# rules: detect-eval-with-expression
# languages: javascript, typescript
# from: javascript/lang/security/detect-eval-with-expression.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$PROP = new URLSearchParams($WINDOW. $$$_ .location.hash.substring(1)).get('$$$_')\n  $$$_",
      "$PROP = new URLSearchParams($WINDOW. $$$_ .location.search).get('$$$_')\n  $$$_",
      "$PROP = new URLSearchParams(location.hash.substring(1)).get('$$$_')\n  $$$_",
      "$PROP = new URLSearchParams(location.search).get('$$$_')\n  $$$_",
      "$PROPS = new\nURLSearchParams($WINDOW. $$$_ .location.hash.substring(1))\n  $$$_",
      "$PROPS = new URLSearchParams($WINDOW. $$$_ .location.search)\n  $$$_",
      "$PROPS = new URLSearchParams(location.hash.substring(1))\n$$$_",
      "$PROPS = new URLSearchParams(location.search)\n  $$$_",
      "$PROPS.get('$$$_')",
      "$WINDOW. $$$_ .location.hash",
      "$WINDOW. $$$_ .location.hash = $FUNC($$$_)",
      "$WINDOW. $$$_ .location.href",
      "$WINDOW. $$$_ .location.href = $FUNC($$$_)",
      "$WINDOW. $$$_ .location.search",
      "$WINDOW. $$$_ .location.search = $FUNC($$$_)",
      "eval($PWRQDEEP1)",
      "location.hash",
      "location.hash = $FUNC($$$_)",
      "location.href",
      "location.href = $FUNC($$$_)",
      "location.search",
      "location.search = $FUNC($$$_)",
      "new Function($PWRQDEEP1)",
      "new Function($PWRQDEEP1)($$$_)",
      "setInterval($PWRQDEEP1,$$$_)",
      "setTimeout($PWRQDEEP1,$$$_)",
      "window.eval($PWRQDEEP1)"
    ])) as $all
    | ( ((($all | of(["eval($PWRQDEEP1)"])
          | where_capture_ast("PWRQDEEP1"; "$SINK"))
          + ($all | of(["window.eval($PWRQDEEP1)"])
          | where_capture_ast("PWRQDEEP1"; "$SINK"))
          + ($all | of(["new Function($PWRQDEEP1)"])
          | where_capture_ast("PWRQDEEP1"; "$SINK"))
          + ($all | of(["new Function($PWRQDEEP1)($$$_)"])
          | where_capture_ast("PWRQDEEP1"; "$SINK"))
          + ($all | of(["setTimeout($PWRQDEEP1,$$$_)"])
          | where_capture_ast("PWRQDEEP1"; "$SINK"))
          + ($all | of(["setInterval($PWRQDEEP1,$$$_)"])
          | where_capture_ast("PWRQDEEP1"; "$SINK"))
          | focus("SINK")))
          | reaching(((($all
          | within($all | of(["$PROP = new URLSearchParams($WINDOW. $$$_ .location.search).get('$$$_')\n  $$$_"])))
          + ($all
          | within($all | of(["$PROP = new URLSearchParams(location.search).get('$$$_')\n  $$$_"])))
          + ($all
          | within($all | of(["$PROP = new URLSearchParams($WINDOW. $$$_ .location.hash.substring(1)).get('$$$_')\n  $$$_"])))
          + ($all
          | within($all | of(["$PROP = new URLSearchParams(location.hash.substring(1)).get('$$$_')\n  $$$_"])))
          | focus("PROP"))
              + (($all
          | within($all | of(["$PROPS = new URLSearchParams($WINDOW. $$$_ .location.search)\n  $$$_"])))
          + ($all
          | within($all | of(["$PROPS = new URLSearchParams(location.search)\n  $$$_"])))
          + ($all
          | within($all | of(["$PROPS = new\nURLSearchParams($WINDOW. $$$_ .location.hash.substring(1))\n  $$$_"])))
          + ($all
          | in_files_with($all | of(["$PROPS = new URLSearchParams(location.hash.substring(1))\n$$$_"])))
          | at_same_place(($all | of(["$PROPS.get('$$$_')"])))
          | focus("PROPS"))
              + ($all | of(["location.href","location.hash","location.search","$WINDOW. $$$_ .location.href","$WINDOW. $$$_ .location.hash","$WINDOW. $$$_ .location.search"])));
              (($all | of(["location.href = $FUNC($$$_)","location.hash = $FUNC($$$_)","location.search = $FUNC($$$_)","$WINDOW. $$$_ .location.href = $FUNC($$$_)","$WINDOW. $$$_ .location.hash = $FUNC($$$_)","$WINDOW. $$$_ .location.search = $FUNC($$$_)"]))))
        | finding("detect-eval-with-expression";
            "Detected use of dynamic execution of JavaScript which may come from user-input, which can lead to Cross-Site-Scripting (XSS).") ) )
| report
