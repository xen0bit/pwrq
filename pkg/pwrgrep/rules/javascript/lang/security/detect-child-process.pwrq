# rules: detect-child-process
# languages: javascript, typescript
# from: javascript/lang/security/detect-child-process.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$CMD = \"$$$_\"\n$$$_",
      "$CMD = [\"$$$_\",$$$_]\n$$$_",
      "$CP = require('child_process')\n$$$_",
      "$CP.$EXEC(\"$$$_\",$$$_)",
      "$CP.$EXEC([\"$$$_\",$$$_],$$$_)",
      "$CP.exec($CMD,$$$_)",
      "$CP.execSync($CMD,$$$_)",
      "$CP.spawn($CMD,$$$_)",
      "$CP.spawnSync($CMD,$$$_)",
      "child_process.$EXEC(\"$$$_\",$$$_)",
      "child_process.$EXEC([\"$$$_\",$$$_],$$$_)",
      "child_process.exec($CMD,$$$_)",
      "child_process.execSync($CMD,$$$_)",
      "child_process.spawn($CMD,$$$_)",
      "child_process.spawnSync($CMD,$$$_)",
      "function $$$_ ($$$_,$FUNC,$$$_) {\n  $$$_\n}",
      "import $CP from 'child_process'\n$$$_",
      "import * as $CP from 'child_process'\n$$$_"
    ])) as $all
    | ( ((($all
          | in_files_with($all | of(["$CP = require('child_process')\n$$$_"])))
          + ($all
          | in_files_with($all | of(["import * as $CP from 'child_process'\n$$$_"])))
          + ($all
          | in_files_with($all | of(["import $CP from 'child_process'\n$$$_"])))
          | at_same_place(($all | of(["$CP.exec($CMD,$$$_)","$CP.execSync($CMD,$$$_)","$CP.spawn($CMD,$$$_)","$CP.spawnSync($CMD,$$$_)"])))
          | outside($all | of(["$CP.$EXEC(\"$$$_\",$$$_)"]))
          | outside($all | of(["$CP.$EXEC([\"$$$_\",$$$_],$$$_)"]))
          | in_files_without($all | of(["$CMD = \"$$$_\"\n$$$_"]))
          | in_files_without($all | of(["$CMD = [\"$$$_\",$$$_]\n$$$_"]))
          | focus("CMD"))
              + ($all | of(["child_process.exec($CMD,$$$_)","child_process.execSync($CMD,$$$_)","child_process.spawn($CMD,$$$_)","child_process.spawnSync($CMD,$$$_)"])
          | outside($all | of(["child_process.$EXEC(\"$$$_\",$$$_)"]))
          | outside($all | of(["child_process.$EXEC([\"$$$_\",$$$_],$$$_)"]))
          | in_files_without($all | of(["$CMD = \"$$$_\"\n$$$_"]))
          | in_files_without($all | of(["$CMD = [\"$$$_\",$$$_]\n$$$_"]))
          | focus("CMD")))
          | reaching((($all
          | within($all | of(["function $$$_ ($$$_,$FUNC,$$$_) {\n  $$$_\n}"]))
          | focus("FUNC")));
              ([]))
        | finding("detect-child-process";
            "Detected calls to child_process from a function argument `$FUNC`.") ) )
| report
