# rules: html-in-template-string
# languages: javascript, typescript
# from: javascript/lang/security/html-in-template-string.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "`$$$_${$VAR}$HTML`",
      "`$HTML${$VAR}$$$_`"
    ])) as $all
    | ( $all | of(["`$HTML${$VAR}$$$_`","`$$$_${$VAR}$HTML`"])
          | where_capture("HTML"; "^(?:.*</?[a-zA-Z])")
        | finding("html-in-template-string";
            "This template literal looks like HTML and has interpolated variables.") ) )
| report
