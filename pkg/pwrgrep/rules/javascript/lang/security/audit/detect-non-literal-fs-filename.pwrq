      "lutimes($FILE, $$$_)",
      "lutimesSync($FILE, $$$_)",
      "mkdir($FILE, $$$_)",
      "mkdirSync($FILE, $$$_)",
      "mkdtemp($FILE, $$$_)",
      "mkdtempSync($FILE, $$$_)",
      "open($FILE, $$$_)",
      "openSync($FILE, $$$_)",
      "opendir($FILE, $$$_)",
      "opendirSync($FILE, $$$_)",
      "read($FILE, $$$_)",
