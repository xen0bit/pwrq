# rules: node-mssql-sqli
# languages: javascript, typescript
# from: javascript/lang/security/audit/sqli/node-mssql-sqli.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$REQ = $POOL.request($$$_)\n$$$_",
      "$REQ.query($QUERY,$$$_)",
      "function $$$_ ($$$_,$FUNC,$$$_) {\n  $$$_\n}",
      "import 'mssql';\n$$$_",
      "require('mssql');\n$$$_"
    ])) as $all
    | ( ((($all
          | in_files_with($all | of(["require('mssql');\n$$$_"])))
          + ($all
          | in_files_with($all | of(["import 'mssql';\n$$$_"])))
          | at_same_place(($all | of(["$REQ.query($QUERY,$$$_)"])))
          | in_files_with($all | of(["$REQ = $POOL.request($$$_)\n$$$_"]))
          | focus("QUERY")))
          | reaching((($all
          | within($all | of(["function $$$_ ($$$_,$FUNC,$$$_) {\n  $$$_\n}"]))
          | focus("FUNC")));
              ([]))
        | finding("node-mssql-sqli";
            "Detected string concatenation with a non-literal variable in a `mssql` JS SQL statement.") ) )
| report
