# rules: node-mysql-sqli
# languages: typescript
# from: javascript/lang/security/audit/sqli/node-mysql-sqli.yaml

. as $root
| ( ($root | scan_ast(["*.ts"]; [
      "$POOL.execute($QUERY, $$$_)",
      "$POOL.query($QUERY, $$$_)",
      "$Y",
      "$Y.body",
      "$Y.cookies",
      "$Y.headers",
      "$Y.params",
      "$Y.query",
      "function $$$_ ($$$_, $Y,$$$_) {$$$_}",
      "function $$$_ ($$$_, $Y: number,$$$_) {$$$_}",
      "import $S from \"$IMPORT\"\n$$$_",
      "import * as $S from \"$IMPORT\"\n$$$_",
      "import { $$$_ } from \"$IMPORT\"\n$$$_",
      "parseInt($$$_)",
      "require(\"$IMPORT\")\n$$$_"
    ])) as $all
    | ( ((($all
          | within($all | of(["$POOL.query($QUERY, $$$_)"])))
          + ($all
          | within($all | of(["$POOL.execute($QUERY, $$$_)"])))
          | at_same_place((($all
          | in_files_with($all | of(["import $S from \"$IMPORT\"\n$$$_"])))
          + ($all
          | in_files_with($all | of(["import { $$$_ } from \"$IMPORT\"\n$$$_"])))
          + ($all
          | in_files_with($all | of(["import * as $S from \"$IMPORT\"\n$$$_"])))
          + ($all
          | in_files_with($all | of(["require(\"$IMPORT\")\n$$$_"])))))
          | focus("QUERY")
          | where_capture("IMPORT"; "^(?:(mysql|mysql2))")))
          | reaching((($all | of(["$Y"])
          | within($all | of(["function $$$_ ($$$_, $Y,$$$_) {$$$_}"]))
          | outside($all | of(["function $$$_ ($$$_, $Y: number,$$$_) {$$$_}"]))
          | outside($all | of(["$Y.query"]))
          | outside($all | of(["$Y.body"]))
          | outside($all | of(["$Y.params"]))
          | outside($all | of(["$Y.cookies"]))
          | outside($all | of(["$Y.headers"]))));
              (($all | of(["parseInt($$$_)"]))))
        | finding("node-mysql-sqli";
            "Detected a `$IMPORT` SQL statement that comes from a function argument.") ) )
| report
