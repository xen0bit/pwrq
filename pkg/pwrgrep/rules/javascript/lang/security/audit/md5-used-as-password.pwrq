# rules: md5-used-as-password
# languages: javascript
# from: javascript/lang/security/audit/md5-used-as-password.yaml

. as $root
| ( ($root | scan_ast(["*.js"]; [
      "$CRYPTO.createHash(\"md5\")",
      "$FUNCTION($$$_);"
    ])) as $all
    | ( (($all | of(["$FUNCTION($$$_);"])
          | where_capture("FUNCTION"; "^(?:(?i)(.*password.*))")))
          | reaching((($all | of(["$CRYPTO.createHash(\"md5\")"])));
              ([]))
        | finding("md5-used-as-password";
            "It looks like MD5 is used as a password hash.") ) )
| report
