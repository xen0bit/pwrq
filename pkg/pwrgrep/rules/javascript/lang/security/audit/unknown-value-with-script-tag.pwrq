# rules: unknown-value-with-script-tag
# languages: javascript, typescript
# from: javascript/lang/security/audit/unknown-value-with-script-tag.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$OTHERFUNC($$$_, $PWRQDEEP1, $$$_)",
      "$UNK",
      "$UNK = $ANYFUNC($$$_);\n$$$_\n$OTHERFUNC($$$_, $PWRQDEEP1, $$$_);"
    ])) as $all
    | ( $all | of(["$OTHERFUNC($$$_, $PWRQDEEP1, $$$_)"])
          | where_capture_ast("PWRQDEEP1"; "\"=~/.*<script.*/\"")
          | at_same_place(($all | of(["$UNK"])))
          | within($all | of(["$UNK = $ANYFUNC($$$_);\n$$$_\n$OTHERFUNC($$$_, $PWRQDEEP1, $$$_);"])
          | where_capture_ast("PWRQDEEP1"; "$UNK"))
        | finding("unknown-value-with-script-tag";
            "Cannot determine what '$UNK' is and it is used with a '<script>' tag.") ) )
| report
