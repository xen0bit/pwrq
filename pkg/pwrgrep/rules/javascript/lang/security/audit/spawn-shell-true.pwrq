# rules: spawn-shell-true
# languages: javascript, typescript
# from: javascript/lang/security/audit/spawn-shell-true.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$CP.spawn($$$_,{shell: $SHELL})",
      "$CP.spawn($$$_,{shell: false})",
      "$CP.spawnSync($$$_,{shell: $SHELL})",
      "$CP.spawnSync($$$_,{shell: false})",
      "spawn($$$_,{shell: $SHELL})",
      "spawn($$$_,{shell: false})",
      "spawnSync($$$_,{shell: $SHELL})",
      "spawnSync($$$_,{shell: false})"
    ])) as $all
    | ( $all | of(["spawn($$$_,{shell: $SHELL})","spawnSync($$$_,{shell: $SHELL})","$CP.spawn($$$_,{shell: $SHELL})","$CP.spawnSync($$$_,{shell: $SHELL})"])
          | not_at($all | of(["spawn($$$_,{shell: false})"]))
          | not_at($all | of(["spawnSync($$$_,{shell: false})"]))
          | not_at($all | of(["$CP.spawn($$$_,{shell: false})"]))
          | not_at($all | of(["$CP.spawnSync($$$_,{shell: false})"]))
        | finding("spawn-shell-true";
            "Found '$SPAWN' with '{shell: $SHELL}'.") ) )
| report
