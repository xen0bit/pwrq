# rules: zlib-async-loop
# languages: javascript, typescript
# from: javascript/lang/best-practice/zlib-async-loop.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$SMTH.forEach($$$_)",
      "$SMTH.map($$$_)",
      "$SMTH.reduce($$$_)",
      "$SMTH.reduceRight($$$_)",
      "do {\n    $$$_\n} while ($$$_)",
      "for ($$$_) {\n    $$$_\n}",
      "while ($$$_) {\n    $$$_\n}",
      "zlib.$METHOD($$$_);"
    ])) as $all
    | ( ($all
          | within($all | of(["for ($$$_) {\n    $$$_\n}"])))
          + ($all
          | within($all | of(["while ($$$_) {\n    $$$_\n}"])))
          + ($all
          | within($all | of(["do {\n    $$$_\n} while ($$$_)"])))
          + ($all
          | within($all | of(["$SMTH.forEach($$$_)"])))
          + ($all
          | within($all | of(["$SMTH.map($$$_)"])))
          + ($all
          | within($all | of(["$SMTH.reduce($$$_)"])))
          + ($all
          | within($all | of(["$SMTH.reduceRight($$$_)"])))
          | at_same_place(($all | of(["zlib.$METHOD($$$_);"])))
          | where_capture_not("METHOD"; "(?:Sync)$")
        | finding("zlib-async-loop";
            "Creating and using a large number of zlib objects simultaneously can cause significant memory fragmentation.") ) )
| report
