# rules: assigned-undefined
# from: javascript/lang/best-practice/assigned-undefined.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "const undefined = $X;",
      "let undefined = $X;",
      "undefined = $X;",
      "var undefined = $X;"
    ])) as $all
    | ( $all | of(["undefined = $X;","var undefined = $X;","let undefined = $X;","const undefined = $X;"])
        | finding("assigned-undefined";
            "`undefined` is not a reserved keyword in Javascript, so this is \"valid\" Javascript but highly confusing and likely to result in bugs.") ) )
| report
