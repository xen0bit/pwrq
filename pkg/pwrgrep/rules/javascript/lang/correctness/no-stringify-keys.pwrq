# rules: no-stringify-keys
# languages: javascript, typescript
# from: javascript/lang/correctness/no-stringify-keys.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$OBJECT[$$$_]",
      "$STRINGIFY = JSON.stringify\n$$$_\n$STRINGIFY($$$_)",
      "$STRINGIFY($$$_)",
      "JSON.stringify($$$_)"
    ])) as $all
    | ( (($all | of(["$OBJECT[$$$_]"])))
          | reaching((($all | of(["JSON.stringify($$$_)"]))
              + ($all | of(["$STRINGIFY($$$_)"])
          | within($all | of(["$STRINGIFY = JSON.stringify\n$$$_\n$STRINGIFY($$$_)"]))));
              ([]))
        | finding("no-stringify-keys";
            "JSON stringify does not produce a stable key ordering, and should not be relied on for producing object keys.") ) )
| report
