# rules: detect-angular-resource-loading
# from: javascript/angular/security/detect-angular-resource-loading.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$sceDelegateProvider.resourceUrlWhitelist([$$$_,$DOM,$$$_]);",
      "$sceDelegateProvider.resourceUrlWhitelist([$$$_,'**',$$$_]);"
    ])) as $all
    | ( ($all | of(["$sceDelegateProvider.resourceUrlWhitelist([$$$_,'**',$$$_]);"]))
          + ($all | of(["$sceDelegateProvider.resourceUrlWhitelist([$$$_,$DOM,$$$_]);"])
          | where_capture("DOM"; "^'.*\\*\\*.+'$"))
        | finding("detect-angular-resource-loading";
            "$sceDelegateProvider allowlisting can introduce security issues if wildcards are used.") ) )
| report
