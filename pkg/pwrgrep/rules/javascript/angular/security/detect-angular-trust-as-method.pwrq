# rules: detect-angular-trust-as-method
# languages: javascript, typescript
# from: javascript/angular/security/detect-angular-trust-as-method.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$sce.trustAs($$$_)",
      "$sce.trustAsHtml($$$_)",
      "$scope.$X",
      "app.controller($$$_, function($scope,$sce) {\n$$$_\n});"
    ])) as $all
    | ( (($all | of(["$sce.trustAs($$$_)"]))
              + ($all | of(["$sce.trustAsHtml($$$_)"])))
          | reaching((($all | of(["$scope.$X"])
          | within($all | of(["app.controller($$$_, function($scope,$sce) {\n$$$_\n});"]))));
              ([]))
        | finding("detect-angular-trust-as-method";
            "The use of $sce.trustAs can be dangerous if unsanitized user input flows through this API.") ) )
| report
