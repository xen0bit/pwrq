# rules: detect-angular-element-taint
# languages: javascript, typescript
# from: javascript/angular/security/detect-angular-element-taint.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$ANGULAR = angular.element($$$_)\n$$$_\n$ANGULAR. $$$_ .$SINK($QUERY)",
      "$DECODE($PWRQDEEP1)",
      "$RES.data",
      "$http.$METHOD($$$_).$CONTINUE(function $FUNC($RES) {$$$_})",
      "$location.search($$$_)",
      "$sanitize($$$_)",
      "$sce.getTrustedHtml($$$_)",
      "DOMPurify.sanitize($$$_)",
      "angular.element($$$_). $$$_ .$SINK($QUERY)",
      "document.location.search",
      "location.search",
      "window.document.location.search",
      "window.location.search"
    ])) as $all
    | ( ((($all
          | within($all | of(["angular.element($$$_). $$$_ .$SINK($QUERY)"])))
          + ($all
          | within($all | of(["$ANGULAR = angular.element($$$_)\n$$$_\n$ANGULAR. $$$_ .$SINK($QUERY)"])))
          | where_capture("SINK"; "^(after|append|html|prepend|replaceWith|wrap)$")
          | focus("QUERY")))
          | reaching((($all | of(["window.location.search","window.document.location.search","document.location.search","location.search","$location.search($$$_)"]))
              + (($all | of(["$DECODE($PWRQDEEP1)"])
          | where_capture_ast("PWRQDEEP1"; "location.hash"))
          + ($all | of(["$DECODE($PWRQDEEP1)"])
          | where_capture_ast("PWRQDEEP1"; "window.location.hash"))
          + ($all | of(["$DECODE($PWRQDEEP1)"])
          | where_capture_ast("PWRQDEEP1"; "document.location.hash"))
          + ($all | of(["$DECODE($PWRQDEEP1)"])
          | where_capture_ast("PWRQDEEP1"; "location.href"))
          + ($all | of(["$DECODE($PWRQDEEP1)"])
          | where_capture_ast("PWRQDEEP1"; "window.location.href"))
          + ($all | of(["$DECODE($PWRQDEEP1)"])
          | where_capture_ast("PWRQDEEP1"; "document.location.href"))
          + ($all | of(["$DECODE($PWRQDEEP1)"])
          | where_capture_ast("PWRQDEEP1"; "document.URL"))
          + ($all | of(["$DECODE($PWRQDEEP1)"])
          | where_capture_ast("PWRQDEEP1"; "window.document.URL"))
          + ($all | of(["$DECODE($PWRQDEEP1)"])
          | where_capture_ast("PWRQDEEP1"; "document.location.href"))
          + ($all | of(["$DECODE($PWRQDEEP1)"])
          | where_capture_ast("PWRQDEEP1"; "document.location.href"))
          + ($all | of(["$DECODE($PWRQDEEP1)"])
          | where_capture_ast("PWRQDEEP1"; "$location.absUrl()"))
          + ($all | of(["$DECODE($PWRQDEEP1)"])
          | where_capture_ast("PWRQDEEP1"; "$location.url()"))
          + ($all | of(["$DECODE($PWRQDEEP1)"])
          | where_capture_ast("PWRQDEEP1"; "$location.hash()"))
          | where_capture("DECODE"; "^(unescape|decodeURI|decodeURIComponent)$"))
              + ($all | of(["$RES.data"])
          | within($all | of(["$http.$METHOD($$$_).$CONTINUE(function $FUNC($RES) {$$$_})"]))
          | where_capture("METHOD"; "^(get|delete|head|jsonp|post|put|patch)")));
              (($all | of(["$sce.getTrustedHtml($$$_)","$sanitize($$$_)","DOMPurify.sanitize($$$_)"]))))
        | finding("detect-angular-element-taint";
            "Use of angular.element can lead to XSS if user-input is treated as part of the HTML element within `$SINK`.") ) )
| report
