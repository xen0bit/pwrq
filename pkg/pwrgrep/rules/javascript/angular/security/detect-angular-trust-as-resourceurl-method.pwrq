# rules: detect-angular-trust-as-resourceurl-method
# from: javascript/angular/security/detect-angular-trust-as-resourceurl-method.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$SOURCE = $scope.$INPUT;\n$sce.trustAsResourceUrl($SOURCE);",
      "$sce.trustAsResourceUrl($scope.$INPUT);",
      "app.controller($$$_, function($scope,$sce){\n$$$_\n});"
    ])) as $all
    | ( $all | of(["$SOURCE = $scope.$INPUT;\n$sce.trustAsResourceUrl($SOURCE);","$sce.trustAsResourceUrl($scope.$INPUT);"])
          | within($all | of(["app.controller($$$_, function($scope,$sce){\n$$$_\n});"]))
        | finding("detect-angular-trust-as-resourceurl-method";
            "The use of $sce.trustAsResourceUrl can be dangerous if unsanitized user input flows through this API.") ) )
| report
