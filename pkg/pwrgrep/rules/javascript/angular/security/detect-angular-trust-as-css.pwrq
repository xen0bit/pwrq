# rules: detect-angular-trust-as-css-method
# languages: javascript, typescript
# from: javascript/angular/security/detect-angular-trust-as-css.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$SOURCE = $scope.$INPUT;\n$sce.trustAsCss($SOURCE);",
      "$sce.trustAsCss($scope.$INPUT);",
      "app.controller($$$_, function($scope,$sce){\n$$$_\n});"
    ])) as $all
    | ( $all | of(["$SOURCE = $scope.$INPUT;\n$sce.trustAsCss($SOURCE);","$sce.trustAsCss($scope.$INPUT);"])
          | within($all | of(["app.controller($$$_, function($scope,$sce){\n$$$_\n});"]))
        | finding("detect-angular-trust-as-css-method";
            "The use of $sce.trustAsCss can be dangerous if unsanitized user input flows through this API.") ) )
| report
