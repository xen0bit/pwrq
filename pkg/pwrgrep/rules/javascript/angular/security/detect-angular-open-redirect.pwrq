# rules: detect-angular-open-redirect
# languages: javascript, typescript
# from: javascript/angular/security/detect-angular-open-redirect.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$window.location.href = \"$$$_\"",
      "$window.location.href = $$$_"
    ])) as $all
    | ( $all | of(["$window.location.href = $$$_"])
          | not_at($all | of(["$window.location.href = \"$$$_\""]))
        | finding("detect-angular-open-redirect";
            "Use of $window.location.href can lead to open-redirect if user input is used for redirection.") ) )
| report
