# rules: tofastproperties-code-execution
# languages: javascript, typescript
# from: javascript/bluebird/security/audit/tofastproperties-code-execution.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$BB = require('bluebird');\n$$$_",
      "$UTIL.toFastProperties($SINK,$$$_)",
      "function $$$_ ($$$_, $ARG,$$$_) {$$$_}",
      "import 'bluebird';\n$$$_",
      "toFastProperties($SINK,$$$_)"
    ])) as $all
    | ( (($all | of(["$UTIL.toFastProperties($SINK,$$$_)","toFastProperties($SINK,$$$_)"])
          | at_same_place((($all
          | in_files_with($all | of(["$BB = require('bluebird');\n$$$_"])))
          + ($all
          | in_files_with($all | of(["import 'bluebird';\n$$$_"])))))
          | focus("SINK")))
          | reaching((($all
          | within($all | of(["function $$$_ ($$$_, $ARG,$$$_) {$$$_}"]))
          | focus("ARG")));
              ([]))
        | finding("tofastproperties-code-execution";
            "Potential arbitrary code execution, whatever is provided to `toFastProperties` is sent straight to eval()") ) )
| report
