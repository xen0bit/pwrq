# rules: expat-xxe
# languages: javascript, typescript
# from: javascript/node-expat/security/audit/expat-xxe.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$X = \"$$$_\";\n$$$_\n$PARSER.parse($X);",
      "$X = \"$$$_\";\n$$$_\n$PARSER.write($X);",
      "require('node-expat');\n$$$_\nnew Parser($$$_);\n$$$_\n$PARSER.parse(\"$$$_\");",
      "require('node-expat');\n$$$_\nnew Parser($$$_);\n$$$_\n$PARSER.parse($$$_);",
      "require('node-expat');\n$$$_\nnew Parser($$$_);\n$$$_\n$PARSER.write(\"$$$_\");",
      "require('node-expat');\n$$$_\nnew Parser($$$_);\n$$$_\n$PARSER.write($$$_);",
      "var $EXPAT = require('node-expat');\n$$$_\nnew $EXPAT.Parser($$$_);\n$$$_\n$PARSER.parse(\"$$$_\");",
      "var $EXPAT = require('node-expat');\n$$$_\nnew $EXPAT.Parser($$$_);\n$$$_\n$PARSER.parse($$$_);",
      "var $EXPAT = require('node-expat');\n$$$_\nnew $EXPAT.Parser($$$_);\n$$$_\n$PARSER.write(\"$$$_\");",
      "var $EXPAT = require('node-expat');\n$$$_\nnew $EXPAT.Parser($$$_);\n$$$_\n$PARSER.write($$$_);"
    ])) as $all
    | ( $all | of(["var $EXPAT = require('node-expat');\n$$$_\nnew $EXPAT.Parser($$$_);\n$$$_\n$PARSER.parse($$$_);","var $EXPAT = require('node-expat');\n$$$_\nnew $EXPAT.Parser($$$_);\n$$$_\n$PARSER.write($$$_);","require('node-expat');\n$$$_\nnew Parser($$$_);\n$$$_\n$PARSER.parse($$$_);","require('node-expat');\n$$$_\nnew Parser($$$_);\n$$$_\n$PARSER.write($$$_);"])
          | not_at($all | of(["var $EXPAT = require('node-expat');\n$$$_\nnew $EXPAT.Parser($$$_);\n$$$_\n$PARSER.parse(\"$$$_\");"]))
          | not_at($all | of(["var $EXPAT = require('node-expat');\n$$$_\nnew $EXPAT.Parser($$$_);\n$$$_\n$PARSER.write(\"$$$_\");"]))
          | not_at($all | of(["require('node-expat');\n$$$_\nnew Parser($$$_);\n$$$_\n$PARSER.parse(\"$$$_\");"]))
          | not_at($all | of(["require('node-expat');\n$$$_\nnew Parser($$$_);\n$$$_\n$PARSER.write(\"$$$_\");"]))
          | not_at($all | of(["$X = \"$$$_\";\n$$$_\n$PARSER.parse($X);"]))
          | not_at($all | of(["$X = \"$$$_\";\n$$$_\n$PARSER.write($X);"]))
        | finding("expat-xxe";
            "If unverified user data can reach the XML Parser it can result in XML External or Internal Entity (XXE) Processing vulnerabilities") ) )
| report
