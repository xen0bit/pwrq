# rules: apollo-axios-ssrf
# languages: javascript
# from: javascript/apollo/security/apollo-axios-ssrf.yaml

. as $root
| ( ($root | scan_ast(["*.js"]; [
      "Query: {\n  $METHOD(parent, args, context, info) {\n    $$$_\n    $DATA = args.$DATAVAL\n    $$$_\n    async function $INNERFUNC($$$_,$INNERARG,$$$_){\n      $$$_\n    }\n    $$$_\n    return $INNERFUNC($$$_,$DATA,$$$_)\n    }\n  }",
      "const $RESPONSE = await axios.request($INNERARG,$$$_)"
    ])) as $all
    | ( $all | of(["const $RESPONSE = await axios.request($INNERARG,$$$_)"])
          | within($all | of(["Query: {\n  $METHOD(parent, args, context, info) {\n    $$$_\n    $DATA = args.$DATAVAL\n    $$$_\n    async function $INNERFUNC($$$_,$INNERARG,$$$_){\n      $$$_\n    }\n    $$$_\n    return $INNERFUNC($$$_,$DATA,$$$_)\n    }\n  }"]))
        | finding("apollo-axios-ssrf";
            "User-controllable argument $DATAVAL to $METHOD passed to Axios via internal handler $INNERFUNC.") ) )
| report
