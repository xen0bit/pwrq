# rules: deno-dangerous-run
# languages: javascript, typescript
# from: javascript/deno/security/audit/deno-dangerous-run.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$CMD = \"=~/(sh|bash|ksh|csh|tcsh|zsh)/\"\n$$$_",
      "Deno.run({cmd: [\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\",$INPUT,$$$_]},$$$_)",
      "Deno.run({cmd: [$CMD,\"-c\",$INPUT,$$$_]},$$$_)",
      "Deno.run({cmd: [$INPUT,$$$_]},$$$_)",
      "function $$$_ ($$$_, $ARG,$$$_) {$$$_}"
    ])) as $all
    | ( ((($all | of(["Deno.run({cmd: [$INPUT,$$$_]},$$$_)"]))
          + ($all | of(["Deno.run({cmd: [\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\",$INPUT,$$$_]},$$$_)"]))
          + ($all | of(["Deno.run({cmd: [$CMD,\"-c\",$INPUT,$$$_]},$$$_)"])
          | in_files_with($all | of(["$CMD = \"=~/(sh|bash|ksh|csh|tcsh|zsh)/\"\n$$$_"])))
          | focus("INPUT")))
          | reaching((($all
          | within($all | of(["function $$$_ ($$$_, $ARG,$$$_) {$$$_}"]))
          | focus("ARG")));
              ([]))
        | finding("deno-dangerous-run";
            "Detected non-literal calls to Deno.run().") ) )
| report
