# rules: playwright-exposed-chrome-devtools
# languages: javascript, typescript
# from: javascript/playwright/security/audit/playwright-exposed-chrome-devtools.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "require('playwright');\n$$$_"
    ])) as $all
    | ( ($all
          | where_text("--remote-debugging-address"))
          + ($all
          | where_text("--remote-debugging-port"))
          + ($all
          | where_text("--remote-debugging-socket-name"))
          + ($all
          | where_text("--remote-debugging-targets"))
          | in_files_with($all | of(["require('playwright');\n$$$_"]))
        | finding("playwright-exposed-chrome-devtools";
            "Remote debugging protocol does not perform any authentication, so exposing it too widely can be a security risk.") ) )
| report
