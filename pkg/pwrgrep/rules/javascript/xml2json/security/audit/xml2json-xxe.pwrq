# rules: xml2json-xxe
# from: javascript/xml2json/security/audit/xml2json-xxe.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "var $XML = require('xml2json');\n$$$_\n$XML.toJson(\"$$$_\",$$$_);",
      "var $XML = require('xml2json');\n$$$_\n$XML.toJson($$$_);",
      "var $XML = require('xml2json');\n$$$_\nvar $S = \"$$$_\";\n$$$_\n$XML.toJson($S,$$$_);"
    ])) as $all
    | ( $all | of(["var $XML = require('xml2json');\n$$$_\n$XML.toJson($$$_);"])
          | not_at($all | of(["var $XML = require('xml2json');\n$$$_\n$XML.toJson(\"$$$_\",$$$_);"]))
          | not_at($all | of(["var $XML = require('xml2json');\n$$$_\nvar $S = \"$$$_\";\n$$$_\n$XML.toJson($S,$$$_);"]))
        | finding("xml2json-xxe";
            "If unverified user data can reach the XML Parser it can result in XML External or Internal Entity (XXE) Processing vulnerabilities") ) )
| report
