# rules: js-input-reaches-effect
# languages: javascript, typescript, tsx
# fixture: javascript/input-reaches-effect.ts
#
# Source to sink: a value from js-external-input that arrives, through
# assignments, at an argument of one of js-side-effects. It answers "what can
# the outside world steer?", which is a question about behaviour before it is
# one about security.
#
# The following is within one function and by assignment only - see reaching
# in pkg/udf/pwrgrep. A value handed to a helper and returned is not followed,
# so an absence here is not proof there is no path.

["*.js", "*.jsx", "*.mjs", "*.cjs", "*.ts", "*.tsx", "*.mts", "*.cts"] as $globs
| ["process.env.$K", "process.env[$K]", "process.argv", "req.params", "req.query", "req.body",
   "req.headers", "req.cookies", "location.search", "location.hash", "localStorage.getItem($$$_)"] as $sources
| ["exec($$$A)", "execSync($$$A)", "spawn($$$A)", "execFile($$$A)", "eval($$$A)",
   "fs.writeFileSync($$$A)", "fs.writeFile($$$A)", "fs.unlinkSync($$$A)", "fs.rmSync($$$A)",
   "fetch($$$A)", "axios.get($$$A)", "axios.post($$$A)", "$DB.query($$$A)", "$DB.execute($$$A)",
   "document.write($$$A)"] as $sinks
| scan_ast($globs; $sources + $sinks) as $all
| $all | of($sinks)
| reaching($all | of($sources); [])
| finding("js-input-reaches-effect"; "external input reaches this call's arguments $A")
| report
