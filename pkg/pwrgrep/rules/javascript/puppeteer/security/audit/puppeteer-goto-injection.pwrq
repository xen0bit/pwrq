# rules: puppeteer-goto-injection
# languages: javascript, typescript
# from: javascript/puppeteer/security/audit/puppeteer-goto-injection.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$PAGE.goto(\"$$$_\",$$$_)",
      "$PAGE.goto($INPUT,$$$_)",
      "require('puppeteer');\n$$$_",
      "require('puppeteer');\n$$$_\nvar $INPUT = \"$$$_\";\n$$$_\n$PAGE.goto($INPUT,$$$_)"
    ])) as $all
    | ( $all | of(["$PAGE.goto($INPUT,$$$_)"])
          | in_files_with($all | of(["require('puppeteer');\n$$$_"]))
          | outside($all | of(["require('puppeteer');\n$$$_\nvar $INPUT = \"$$$_\";\n$$$_\n$PAGE.goto($INPUT,$$$_)"]))
          | not_at($all | of(["$PAGE.goto(\"$$$_\",$$$_)"]))
        | finding("puppeteer-goto-injection";
            "If unverified user data can reach the `goto` method it can result in Server-Side Request Forgery vulnerabilities") ) )
| report
