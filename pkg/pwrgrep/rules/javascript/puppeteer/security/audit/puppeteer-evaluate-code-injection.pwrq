# rules: puppeteer-evaluate-code-injection
# languages: javascript, typescript
# from: javascript/puppeteer/security/audit/puppeteer-evaluate-code-injection.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$PAGE.evaluate(\"$$$_\",$$$_)",
      "$PAGE.evaluate($INPUT,$$$_)",
      "$PAGE.evaluate(function($$$_){$$$_},$$$_)",
      "$PAGE.evaluateHandle(\"$$$_\",$$$_)",
      "$PAGE.evaluateHandle($INPUT,$$$_)",
      "$PAGE.evaluateHandle(function($$$_){$$$_},$$$_)",
      "$PAGE.evaluateOnNewDocument(\"$$$_\",$$$_)",
      "$PAGE.evaluateOnNewDocument($INPUT,$$$_)",
      "$PAGE.evaluateOnNewDocument(function($$$_){$$$_},$$$_)",
      "require('puppeteer');\n$$$_",
      "var $INPUT = function $FNAME($$$_){$$$_};\n$$$_"
    ])) as $all
    | ( $all | of(["$PAGE.evaluate($INPUT,$$$_)","$PAGE.evaluateHandle($INPUT,$$$_)","$PAGE.evaluateOnNewDocument($INPUT,$$$_)"])
          | in_files_with($all | of(["require('puppeteer');\n$$$_"]))
          | in_files_without($all | of(["var $INPUT = function $FNAME($$$_){$$$_};\n$$$_"]))
          | not_at($all | of(["$PAGE.evaluate(\"$$$_\",$$$_)"]))
          | not_at($all | of(["$PAGE.evaluate(function($$$_){$$$_},$$$_)"]))
          | not_at($all | of(["$PAGE.evaluateHandle(\"$$$_\",$$$_)"]))
          | not_at($all | of(["$PAGE.evaluateHandle(function($$$_){$$$_},$$$_)"]))
          | not_at($all | of(["$PAGE.evaluateOnNewDocument(\"$$$_\",$$$_)"]))
          | not_at($all | of(["$PAGE.evaluateOnNewDocument(function($$$_){$$$_},$$$_)"]))
        | finding("puppeteer-evaluate-code-injection";
            "If unverified user data can reach the `evaluate` method it can result in Server-Side Request Forgery vulnerabilities") ) )
| report
