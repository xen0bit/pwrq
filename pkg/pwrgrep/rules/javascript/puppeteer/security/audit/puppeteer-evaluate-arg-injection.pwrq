# rules: puppeteer-evaluate-arg-injection
# languages: javascript, typescript
# from: javascript/puppeteer/security/audit/puppeteer-evaluate-arg-injection.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$PAGE.evaluate($CODE,$$$_,$PWRQDEEP1,$$$_)",
      "$PAGE.evaluateHandle($CODE,$$$_,$PWRQDEEP1,$$$_)",
      "$PAGE.evaluateOnNewDocument($CODE,$$$_,$PWRQDEEP1,$$$_)",
      "function $FUNC ($$$_,$INPUT,$$$_) {$$$_}",
      "function ($$$_,$INPUT,$$$_) {$$$_}",
      "require('puppeteer');\n$$$_"
    ])) as $all
    | ( ($all
          | within($all | of(["function $FUNC ($$$_,$INPUT,$$$_) {$$$_}"])))
          + ($all
          | within($all | of(["function ($$$_,$INPUT,$$$_) {$$$_}"])))
          | at_same_place((($all | of(["$PAGE.evaluate($CODE,$$$_,$PWRQDEEP1,$$$_)"])
          | where_capture_ast("PWRQDEEP1"; "$INPUT"))
          + ($all | of(["$PAGE.evaluateHandle($CODE,$$$_,$PWRQDEEP1,$$$_)"])
          | where_capture_ast("PWRQDEEP1"; "$INPUT"))
          + ($all | of(["$PAGE.evaluateOnNewDocument($CODE,$$$_,$PWRQDEEP1,$$$_)"])
          | where_capture_ast("PWRQDEEP1"; "$INPUT"))))
          | in_files_with($all | of(["require('puppeteer');\n$$$_"]))
        | finding("puppeteer-evaluate-arg-injection";
            "If unverified user data can reach the `evaluate` method it can result in Server-Side Request Forgery vulnerabilities") ) )
| report
