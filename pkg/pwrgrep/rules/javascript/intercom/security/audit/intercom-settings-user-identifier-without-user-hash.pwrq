# rules: intercom-settings-user-identifier-without-user-hash
# languages: javascript
# from: javascript/intercom/security/audit/intercom-settings-user-identifier-without-user-hash.yaml

. as $root
| ( ($root | scan_ast(["*.js"]; [
      "$VAR = {$$$_, email: $EMAIL, $$$_};\n$$$_\nIntercom('boot', $VAR);",
      "$VAR = {$$$_, user_hash: $USER_HASH, $$$_};\n$$$_\nIntercom('boot', $VAR);",
      "$VAR = {$$$_, user_id: $EMAIL, $$$_};\n$$$_\nIntercom('boot', $VAR);",
      "Intercom('boot', {$$$_, email: $EMAIL, $$$_});",
      "Intercom('boot', {$$$_, user_hash: $USER_HASH, $$$_});",
      "Intercom('boot', {$$$_, user_id: $USER_ID, $$$_});",
      "window.intercomSettings = {$$$_, email: $EMAIL, $$$_};",
      "window.intercomSettings = {$$$_, user_hash: $USER_HASH, $$$_};",
      "window.intercomSettings = {$$$_, user_id: $USER_ID, $$$_};"
    ])) as $all
    | ( $all | of(["window.intercomSettings = {$$$_, email: $EMAIL, $$$_};","window.intercomSettings = {$$$_, user_id: $USER_ID, $$$_};","Intercom('boot', {$$$_, email: $EMAIL, $$$_});","Intercom('boot', {$$$_, user_id: $USER_ID, $$$_});","$VAR = {$$$_, email: $EMAIL, $$$_};\n$$$_\nIntercom('boot', $VAR);","$VAR = {$$$_, user_id: $EMAIL, $$$_};\n$$$_\nIntercom('boot', $VAR);"])
          | not_at($all | of(["window.intercomSettings = {$$$_, user_hash: $USER_HASH, $$$_};"]))
          | not_at($all | of(["Intercom('boot', {$$$_, user_hash: $USER_HASH, $$$_});"]))
          | not_at($all | of(["$VAR = {$$$_, user_hash: $USER_HASH, $$$_};\n$$$_\nIntercom('boot', $VAR);"]))
        | finding("intercom-settings-user-identifier-without-user-hash";
            "Found an initialization of the Intercom Messenger that identifies a User, but does not specify a `user_hash`.") ) )
| report
