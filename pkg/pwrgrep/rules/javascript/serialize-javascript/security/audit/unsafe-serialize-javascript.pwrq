# rules: unsafe-serialize-javascript
# languages: javascript, typescript
# from: javascript/serialize-javascript/security/audit/unsafe-serialize-javascript.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$S = require('serialize-javascript');\n$$$_",
      "$S($$$_, {unsafe: true});",
      "encodeURI($$$_)",
      "escape($$$_)"
    ])) as $all
    | ( $all | of(["$S($$$_, {unsafe: true});"])
          | in_files_with($all | of(["$S = require('serialize-javascript');\n$$$_"]))
          | outside($all | of(["escape($$$_)"]))
          | outside($all | of(["encodeURI($$$_)"]))
        | finding("unsafe-serialize-javascript";
            "`serialize-javascript` used with `unsafe` parameter, this could be vulnerable to XSS.") ) )
| report
