# rules: express-jwt-hardcoded-secret
# languages: javascript, typescript
# from: javascript/express/security/express-jwt-hardcoded-secret.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$JWT = require('express-jwt');\n$$$_",
      "$JWT({$$$_,secret: \"$Y\",$$$_},$$$_)",
      "$OPTS = \"$Y\";\n$$$_\n$JWT({$$$_,secret: $OPTS},$$$_);",
      "import $JWT from 'express-jwt';\n$$$_",
      "import * as $JWT from 'express-jwt';\n$$$_",
      "import { $$$_, $JWT, $$$_ } from 'express-jwt';\n$$$_"
    ])) as $all
    | ( ($all
          | in_files_with($all | of(["$JWT = require('express-jwt');\n$$$_"])))
          + ($all
          | in_files_with($all | of(["import $JWT from 'express-jwt';\n$$$_"])))
          + ($all
          | in_files_with($all | of(["import * as $JWT from 'express-jwt';\n$$$_"])))
          + ($all
          | in_files_with($all | of(["import { $$$_, $JWT, $$$_ } from 'express-jwt';\n$$$_"])))
          | at_same_place(($all | of(["$JWT({$$$_,secret: \"$Y\",$$$_},$$$_)","$OPTS = \"$Y\";\n$$$_\n$JWT({$$$_,secret: $OPTS},$$$_);"])))
          | focus("Y")
        | finding("express-jwt-hardcoded-secret";
            "A hard-coded credential was detected.") ) )
| report
