# rules: cors-misconfiguration
# languages: typescript
# from: javascript/express/security/cors-misconfiguration.yaml

. as $root
| ( ($root | scan_ast(["*.ts"]; [
      "$APP.$METHOD($$$_, function $FUNC($REQ, $RES) {$$$_})",
      "$APP.$METHOD($$$_, function $FUNC($REQ, $RES, $NEXT) {$$$_})",
      "$REQ.body",
      "$REQ.cookies",
      "$REQ.headers",
      "$REQ.params",
      "$REQ.query",
      "$RES.header($HEADER, $X)",
      "$RES.set($HEADER, $X)",
      "$RES.set({$HEADER: $X}, $$$_)",
      "$RES.setHeader($HEADER, $X)",
      "$RES.writeHead($STATUS, {$HEADER: $X}, $$$_)",
      "({ $REQ }: Request,$RES: Response) => {$$$_}",
      "({ $REQ }: Request,$RES: Response, $NEXT: NextFunction) =>\n{$$$_}",
      "body",
      "cookies",
      "function $$$_ ($REQ, $RES) {$$$_}",
      "function $$$_ ($REQ, $RES, $NEXT) {$$$_}",
      "headers",
      "params",
      "query"
    ])) as $all
    | ( (($all | of(["$RES.set($HEADER, $X)","$RES.header($HEADER, $X)","$RES.setHeader($HEADER, $X)","$RES.set({$HEADER: $X}, $$$_)","$RES.writeHead($STATUS, {$HEADER: $X}, $$$_)"])
          | focus("X")
          | where_capture("HEADER"; "^(?:.*(Access-Control-Allow-Origin|access-control-allow-origin).*)")))
          | reaching(((($all
          | within($all | of(["function $$$_ ($REQ, $RES) {$$$_}"])))
          + ($all
          | within($all | of(["function $$$_ ($REQ, $RES, $NEXT) {$$$_}"])))
          + (($all
          | within($all | of(["$APP.$METHOD($$$_, function $FUNC($REQ, $RES) {$$$_})"])))
          + ($all
          | within($all | of(["$APP.$METHOD($$$_, function $FUNC($REQ, $RES, $NEXT) {$$$_})"])))
          | where_capture("METHOD"; "^(get|post|put|head|delete|options)$"))
          | at_same_place(($all | of(["$REQ.query","$REQ.body","$REQ.params","$REQ.cookies","$REQ.headers"]))))
              + (($all
          | within($all | of(["({ $REQ }: Request,$RES: Response, $NEXT: NextFunction) =>\n{$$$_}"])))
          + ($all
          | within($all | of(["({ $REQ }: Request,$RES: Response) => {$$$_}"])))
          | at_same_place(($all | of(["params","query","cookies","headers","body"])))
          | focus("REQ")));
              ([]))
        | finding("cors-misconfiguration";
            "By letting user input control CORS parameters, there is a risk that software does not properly verify that the source of data or communication is valid.") ) )
| report
