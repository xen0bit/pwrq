# rules: express-third-party-object-deserialization
# languages: typescript
# from: javascript/express/security/audit/express-third-party-object-deserialization.yaml

. as $root
| ( ($root | scan_ast(["*.ts"]; [
      "$APP.$METHOD($$$_, function $FUNC($REQ, $RES) {$$$_})",
      "$APP.$METHOD($$$_, function $FUNC($REQ, $RES, $NEXT) {$$$_})",
      "$REQ.body",
      "$REQ.cookies",
      "$REQ.files.$ANYTHING.data.toString('utf8')",
      "$REQ.files.$ANYTHING['data'].toString('utf8')",
      "$REQ.headers",
      "$REQ.params",
      "$REQ.query",
      "$SER = require('$IMPORT')\n$$$_",
      "$SER.$FUNC($$$_)",
      "({ $REQ }: Request,$RES: Response) => {$$$_}",
      "({ $REQ }: Request,$RES: Response, $NEXT: NextFunction) =>\n{$$$_}",
      "body",
      "cookies",
      "files.$ANYTHING.data.toString('utf8')",
      "files.$ANYTHING['data'].toString('utf8')",
      "function $$$_ ($REQ, $RES) {$$$_}",
      "function $$$_ ($REQ, $RES, $NEXT) {$$$_}",
      "headers",
      "import $SER from '$IMPORT'\n $$$_",
      "import * as $SER from '$IMPORT'\n$$$_",
      "params",
      "query"
    ])) as $all
    | ( (((($all
          | in_files_with($all | of(["$SER = require('$IMPORT')\n$$$_"])))
          + ($all
          | within($all | of(["import $SER from '$IMPORT'\n $$$_"])))
          + ($all
          | in_files_with($all | of(["import * as $SER from '$IMPORT'\n$$$_"])))
          | at_same_place(($all | of(["$SER.$FUNC($$$_)"])))
          | where_capture("IMPORT"; "^(node-serialize|serialize-to-js)$")
          | where_capture("FUNC"; "^(unserialize|deserialize)$"))))
          | reaching(((($all
          | within($all | of(["function $$$_ ($REQ, $RES) {$$$_}"])))
          + ($all
          | within($all | of(["function $$$_ ($REQ, $RES, $NEXT) {$$$_}"])))
          + (($all
          | within($all | of(["$APP.$METHOD($$$_, function $FUNC($REQ, $RES) {$$$_})"])))
          + ($all
          | within($all | of(["$APP.$METHOD($$$_, function $FUNC($REQ, $RES, $NEXT) {$$$_})"])))
          | where_capture("METHOD"; "^(get|post|put|head|delete|options)$"))
          | at_same_place(($all | of(["$REQ.query","$REQ.body","$REQ.params","$REQ.cookies","$REQ.headers","$REQ.files.$ANYTHING.data.toString('utf8')","$REQ.files.$ANYTHING['data'].toString('utf8')"]))))
              + (($all
          | within($all | of(["({ $REQ }: Request,$RES: Response, $NEXT: NextFunction) =>\n{$$$_}"])))
          + ($all
          | within($all | of(["({ $REQ }: Request,$RES: Response) => {$$$_}"])))
          | at_same_place(($all | of(["params","query","cookies","headers","body","files.$ANYTHING.data.toString('utf8')","files.$ANYTHING['data'].toString('utf8')"])))
          | focus("REQ")));
              ([]))
        | finding("express-third-party-object-deserialization";
            "The following function call $SER.$FUNC accepts user controlled data which can result in Remote Code Execution (RCE) through Object Deserialization.") ) )
| report
