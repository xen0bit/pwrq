# rules: express-check-directory-listing
# from: javascript/express/security/audit/express-check-directory-listing.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$APP.use($$$_, $SERVEINDEX($$$_), $$$_)",
      "$APP.use(require('serve-index')($$$_))",
      "$SERVEINDEX = require('serve-index')\n$$$_",
      "$VALUE = $SERVEINDEX($$$_)\n$$$_",
      "$VALUE($$$_)",
      "import $SERVEINDEX from 'serve-index'\n$$$_",
      "import * as $SERVEINDEX from 'serve-index'\n$$$_"
    ])) as $all
    | ( ($all | of(["$APP.use(require('serve-index')($$$_))"]))
          + (($all)
          + ($all)
          + ($all)
          | at_same_place((($all | of(["$VALUE($$$_)"])
          | in_files_with($all | of(["$VALUE = $SERVEINDEX($$$_)\n$$$_"])))
          + ($all | of(["$APP.use($$$_, $SERVEINDEX($$$_), $$$_)"])))))
        | finding("express-check-directory-listing";
            "Directory listing/indexing is enabled, which may lead to disclosure of sensitive directories and files.") ) )
| report
