# rules: express-jwt-not-revoked
# languages: javascript, typescript
# from: javascript/express/security/audit/express-jwt-not-revoked.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$JWT = require('express-jwt');\n$$$_",
      "$JWT($$$_)",
      "$JWT($PWRQDEEP1,$$$_)",
      "$OPTS = $PWRQDEEP1;\n$$$_\n$JWT($OPTS,$$$_);"
    ])) as $all
    | ( $all | of(["$JWT($$$_)"])
          | in_files_with($all | of(["$JWT = require('express-jwt');\n$$$_"]))
          | outside($all | of(["$JWT($PWRQDEEP1,$$$_)"])
          | where_capture_ast("PWRQDEEP1"; "{isRevoked:$$$_}"))
          | outside($all | of(["$OPTS = $PWRQDEEP1;\n$$$_\n$JWT($OPTS,$$$_);"])
          | where_capture_ast("PWRQDEEP1"; "{isRevoked:$$$_}"))
        | finding("express-jwt-not-revoked";
            "No token revoking configured for `express-jwt`.") ) )
| report
