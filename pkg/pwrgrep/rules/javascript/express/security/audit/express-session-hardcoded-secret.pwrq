# rules: express-session-hardcoded-secret
# from: javascript/express/security/audit/express-session-hardcoded-secret.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$APP.use($SESSION({$$$_}))",
      "$SECRET = $VALUE\n$$$_\n$APP.use($SESSION($SECRET))",
      "$SESSION = require('express-session');\n$$$_",
      "import $SESSION from 'express-session'\n$$$_",
      "import * as $SESSION from 'express-session'\n$$$_",
      "import {$$$_, $SESSION, $$$_} from 'express-session'\n$$$_",
      "secret: '$Y'"
    ])) as $all
    | ( ($all)
          + ($all)
          + ($all)
          + ($all)
        | finding("express-session-hardcoded-secret";
            "A hard-coded credential was detected.") ) )
| report
