# rules: var-in-href
# from: javascript/express/security/audit/xss/ejs/var-in-href.yaml

. as $root
| ( ($root | scan_regex(["*.ejs","*.html"]; [
      "<a.*href\\s*=[^>]*?[^\\/&=]<%.*?%>.*?>"
    ])) as $all
    | ( $all | of(["<a.*href\\s*=[^>]*?[^\\/&=]<%.*?%>.*?>"])
        | finding("var-in-href";
            "Detected a template variable used in an anchor tag with the 'href' attribute.") ) )
| report
