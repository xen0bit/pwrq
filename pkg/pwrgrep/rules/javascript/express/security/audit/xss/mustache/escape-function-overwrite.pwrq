# rules: escape-function-overwrite
# languages: javascript, typescript
# from: javascript/express/security/audit/xss/mustache/escape-function-overwrite.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "\"mustache\"",
      "$MUSTACHE = require(\"mustache\");\n$$$_",
      "$MUSTACHE.escape = $$$_",
      "Mustache.escape = $$$_"
    ])) as $all
    | ( ($all | of(["Mustache.escape = $$$_"]))
          + ($all | of(["$MUSTACHE.escape = $$$_"])
          | in_files_with($all | of(["$MUSTACHE = require(\"mustache\");\n$$$_","\"mustache\""])))
        | finding("escape-function-overwrite";
            "The Mustache escape function is being overwritten.") ) )
| report
