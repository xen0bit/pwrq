# rules: var-in-script-src
# from: javascript/express/security/audit/xss/ejs/var-in-script-src.yaml

. as $root
| ( ($root | scan_regex(["*.ejs","*.html"]; [
      "<%\\s+[\\s\\S]*?\\s+>",
      "<script\\s+[\\s\\S]*?>",
      "src\\s+=\\s+\"[\\s\\S]*?\"",
      "src\\s+=\\s+'[\\s\\S]*?'"
    ])) as $all
    | ( ($all
          | within($all | of(["src\\s+=\\s+'[\\s\\S]*?'"])))
          + ($all
          | within($all | of(["src\\s+=\\s+\"[\\s\\S]*?\""])))
          | at_same_place(($all | of(["<%\\s+[\\s\\S]*?\\s+>"])))
          | within($all | of(["<script\\s+[\\s\\S]*?>"]))
        | finding("var-in-script-src";
            "Detected a template variable used as the 'src' in a script tag.") ) )
| report
