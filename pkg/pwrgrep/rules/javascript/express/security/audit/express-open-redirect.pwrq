# rules: express-open-redirect
# languages: typescript
# from: javascript/express/security/audit/express-open-redirect.yaml

. as $root
| ( ($root | scan_ast(["*.ts"]; [
      "$APP.$METHOD($$$_, function $FUNC($REQ, $RES) {$$$_})",
      "$APP.$METHOD($$$_, function $FUNC($REQ, $RES, $NEXT) {$$$_})",
      "$ASSIGN = $REQ. $$$_ .$VALUE\n$$$_",
      "$ASSIGN = $REQ. $$$_ .$VALUE + $$$A\n$$$_",
      "$ASSIGN = $REQ.$VALUE['$$$_']\n$$$_",
      "$ASSIGN = $REQ.$VALUE['$$$_'] + $$$A\n$$$_",
      "$ASSIGN = `${$REQ. $$$_ .$VALUE}$$$_`\n$$$_",
      "$ASSIGN = `${$REQ.$VALUE['$$$_']}$$$_`\n$$$_",
      "$REQ. $$$_ .$VALUE",
      "$REQ.$VALUE",
      "$REQ.body",
      "$REQ.cookies",
      "$REQ.headers",
      "$REQ.params",
      "$REQ.query",
      "$RES.redirect(\"$HTTP\"+$REQ. $$$_ .$VALUE + $$$A)",
      "$RES.redirect(\"$HTTP\"+$REQ. $$$_ .$VALUE)",
      "$RES.redirect(\"$HTTP\"+$REQ.$VALUE[$$$_] + $$$A)",
      "$RES.redirect(\"$HTTP\"+$REQ.$VALUE[$$$_])",
      "$RES.redirect($ASSIGN + $$$FOO)",
      "$RES.redirect($ASSIGN)",
      "$RES.redirect($REQ. $$$_ .$VALUE + $$$A)",
      "$RES.redirect($REQ. $$$_ .$VALUE)",
      "$RES.redirect($REQ.$VALUE['$$$_'] + $$$A)",
      "$RES.redirect($REQ.$VALUE['$$$_'])",
      "$RES.redirect(`$HTTP${$REQ. $$$_ .$VALUE}$$$_`)",
      "$RES.redirect(`$HTTP${$REQ.$VALUE[$$$_]}$$$_`)",
      "$RES.redirect(`${$ASSIGN}$$$_`)",
      "$RES.redirect(`${$REQ. $$$_ .$VALUE}$$$_`)",
      "$RES.redirect(`${$REQ.$VALUE['$$$_']}$$$_`)",
      "({ $REQ }: Request,$RES: Response) => {$$$_}",
      "({ $REQ }: Request,$RES: Response, $NEXT: NextFunction) =>\n{$$$_}",
      "body",
      "cookies",
      "function $$$_ ($REQ, $RES) {$$$_}",
      "function $$$_ ($REQ, $RES, $NEXT) {$$$_}",
      "headers",
      "params",
      "query"
    ])) as $all
    | ( (($all | of(["$RES.redirect(\"$HTTP\"+$REQ. $$$_ .$VALUE)","$RES.redirect(\"$HTTP\"+$REQ. $$$_ .$VALUE + $$$A)","$RES.redirect(`$HTTP${$REQ. $$$_ .$VALUE}$$$_`)","$RES.redirect(\"$HTTP\"+$REQ.$VALUE[$$$_])","$RES.redirect(\"$HTTP\"+$REQ.$VALUE[$$$_] + $$$A)","$RES.redirect(`$HTTP${$REQ.$VALUE[$$$_]}$$$_`)"])
          | at_same_place(($all | of(["$REQ. $$$_ .$VALUE"])))
          | where_capture("HTTP"; "^https?:\\/\\/$"))
              + ($all | of(["$RES.redirect($REQ. $$$_ .$VALUE)","$RES.redirect($REQ. $$$_ .$VALUE + $$$A)","$RES.redirect(`${$REQ. $$$_ .$VALUE}$$$_`)"])
          | at_same_place(($all | of(["$REQ. $$$_ .$VALUE"]))))
              + ($all | of(["$RES.redirect($REQ.$VALUE['$$$_'])","$RES.redirect($REQ.$VALUE['$$$_'] + $$$A)","$RES.redirect(`${$REQ.$VALUE['$$$_']}$$$_`)"])
          | at_same_place(($all | of(["$REQ.$VALUE"]))))
              + (($all
          | in_files_with($all | of(["$ASSIGN = $REQ. $$$_ .$VALUE\n$$$_"])))
          + ($all
          | in_files_with($all | of(["$ASSIGN = $REQ.$VALUE['$$$_']\n$$$_"])))
          + ($all
          | in_files_with($all | of(["$ASSIGN = $REQ. $$$_ .$VALUE + $$$A\n$$$_"])))
          + ($all
          | in_files_with($all | of(["$ASSIGN = $REQ.$VALUE['$$$_'] + $$$A\n$$$_"])))
          + ($all
          | in_files_with($all | of(["$ASSIGN = `${$REQ. $$$_ .$VALUE}$$$_`\n$$$_"])))
          + ($all
          | in_files_with($all | of(["$ASSIGN = `${$REQ.$VALUE['$$$_']}$$$_`\n$$$_"])))
          | at_same_place(($all | of(["$RES.redirect($ASSIGN)","$RES.redirect($ASSIGN + $$$FOO)","$RES.redirect(`${$ASSIGN}$$$_`)"])))
          | focus("ASSIGN")))
          | reaching(((($all
          | within($all | of(["function $$$_ ($REQ, $RES) {$$$_}"])))
          + ($all
          | within($all | of(["function $$$_ ($REQ, $RES, $NEXT) {$$$_}"])))
          + (($all
          | within($all | of(["$APP.$METHOD($$$_, function $FUNC($REQ, $RES) {$$$_})"])))
          + ($all
          | within($all | of(["$APP.$METHOD($$$_, function $FUNC($REQ, $RES, $NEXT) {$$$_})"])))
          | where_capture("METHOD"; "^(get|post|put|head|delete|options)$"))
          | at_same_place(($all | of(["$REQ.query","$REQ.body","$REQ.params","$REQ.cookies","$REQ.headers"]))))
              + (($all
          | within($all | of(["({ $REQ }: Request,$RES: Response, $NEXT: NextFunction) =>\n{$$$_}"])))
          + ($all
          | within($all | of(["({ $REQ }: Request,$RES: Response) => {$$$_}"])))
          | at_same_place(($all | of(["params","query","cookies","headers","body"])))
          | focus("REQ")));
              ([]))
        | finding("express-open-redirect";
            "The application redirects to a URL specified by user-supplied input `$REQ` that is not validated.") ) )
| report
