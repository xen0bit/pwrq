# rules: express-ssrf
# languages: typescript
# from: javascript/express/security/audit/express-ssrf.yaml

. as $root
| ( ($root | scan_ast(["*.ts"]; [
      "$ASSIGN",
      "$ASSIGN = \"$HTTP\"+ $REQ. $$$_ .$VALUE\n$$$_",
      "$ASSIGN = \"$HTTP\"+$REQ. $$$_ .$VALUE + $$$A\n$$$_",
      "$ASSIGN = \"$HTTP\"+$REQ.$VALUE[$$$_]\n$$$_",
      "$ASSIGN = \"$HTTP\"+$REQ.$VALUE[$$$_] + $$$A\n$$$_",
      "$ASSIGN = $REQ. $$$_ .$VALUE\n$$$_",
      "$ASSIGN = $REQ. $$$_ .$VALUE + $$$A\n$$$_",
      "$ASSIGN = $REQ. $$$_ .$VALUE['$$$_']\n$$$_",
      "$ASSIGN = $REQ. $$$_ .$VALUE['$$$_'] + $$$A\n$$$_",
      "$ASSIGN = `$HTTP${$REQ.$VALUE[$$$_]}$$$_`\n$$$_",
      "$ASSIGN = `${$REQ. $$$_ .$VALUE['$$$_']}$$$_`\n$$$_",
      "$ASSIGN = `${$REQ. $$$_ .$VALUE}$$$_`\n$$$_",
      "$REQ. $$$_ .$VALUE",
      "$REQ.$VALUE",
      "$REQ.body",
      "$REQ.cookies",
      "$REQ.headers",
      "$REQ.params",
      "$REQ.query",
      "$REQUEST = require('request')\n$$$_",
      "$REQUEST.$METHOD(\"$HTTP\"+$ASSIGN + $$$A,$$$_)",
      "$REQUEST.$METHOD(\"$HTTP\"+$ASSIGN,$$$_)",
      "$REQUEST.$METHOD(\"$HTTP\"+$REQ. $$$_ .$VALUE + $$$A)",
      "$REQUEST.$METHOD(\"$HTTP\"+$REQ. $$$_ .$VALUE)",
      "$REQUEST.$METHOD(\"$HTTP\"+$REQ.$VALUE[$$$_] + $$$A)",
      "$REQUEST.$METHOD(\"$HTTP\"+$REQ.$VALUE[$$$_])",
      "$REQUEST.$METHOD($ASSIGN + $$$FOO,$$$_)",
      "$REQUEST.$METHOD($ASSIGN,$$$_)",
      "$REQUEST.$METHOD($REQ. $$$_ .$VALUE + $$$A,$$$_)",
      "$REQUEST.$METHOD($REQ. $$$_ .$VALUE,$$$_)",
      "$REQUEST.$METHOD($REQ.$VALUE['$$$_'] + $$$A,$$$_)",
      "$REQUEST.$METHOD($REQ.$VALUE['$$$_'],$$$_)",
      "$REQUEST.$METHOD(`$HTTP${$ASSIGN}$$$_`,$$$_)",
      "$REQUEST.$METHOD(`$HTTP${$REQ. $$$_ .$VALUE}$$$_`)",
      "$REQUEST.$METHOD(`$HTTP${$REQ.$VALUE[$$$_]}$$$_`)",
      "$REQUEST.$METHOD(`${$ASSIGN}$$$_`,$$$_)",
      "$REQUEST.$METHOD(`${$REQ. $$$_ .$VALUE}$$$_`,$$$_)",
      "$REQUEST.$METHOD(`${$REQ.$VALUE['$$$_']}$$$_`,$$$_)",
      "({ $REQ }: $EXPRESS.Request,$$$_) => {$$$_}",
      "({ $REQ }: Request,$$$_) =>\n{$$$_}",
      "body",
      "cookies",
      "function $$$_ ($REQ, $$$_) {$$$_}",
      "headers",
      "import $REQUEST from 'request'\n$$$_",
      "import * as $REQUEST from 'request'\n$$$_",
      "params",
      "query"
    ])) as $all
    | ( ((($all
          | in_files_with($all | of(["$REQUEST = require('request')\n$$$_"])))
          + ($all
          | in_files_with($all | of(["import * as $REQUEST from 'request'\n$$$_"])))
          + ($all
          | in_files_with($all | of(["import $REQUEST from 'request'\n$$$_"])))
          | at_same_place(($all | of(["$REQUEST.$METHOD(\"$HTTP\"+$REQ. $$$_ .$VALUE)","$REQUEST.$METHOD(\"$HTTP\"+$REQ. $$$_ .$VALUE + $$$A)","$REQUEST.$METHOD(`$HTTP${$REQ. $$$_ .$VALUE}$$$_`)","$REQUEST.$METHOD(\"$HTTP\"+$REQ.$VALUE[$$$_])","$REQUEST.$METHOD(\"$HTTP\"+$REQ.$VALUE[$$$_] + $$$A)","$REQUEST.$METHOD(`$HTTP${$REQ.$VALUE[$$$_]}$$$_`)"])))
          | at_same_place(($all | of(["$REQ. $$$_ .$VALUE"])))
          | where_capture("METHOD"; "^(get|post|put|patch|del|head|delete)$")
          | where_capture("HTTP"; "^(https?:\\/\\/|//)$"))
              + (($all
          | in_files_with($all | of(["$REQUEST = require('request')\n$$$_"])))
          + ($all
          | in_files_with($all | of(["import * as $REQUEST from 'request'\n$$$_"])))
          + ($all
          | in_files_with($all | of(["import $REQUEST from 'request'\n$$$_"])))
          | at_same_place(($all | of(["$REQUEST.$METHOD($REQ. $$$_ .$VALUE,$$$_)","$REQUEST.$METHOD($REQ. $$$_ .$VALUE + $$$A,$$$_)","$REQUEST.$METHOD(`${$REQ. $$$_ .$VALUE}$$$_`,$$$_)"])))
          | at_same_place(($all | of(["$REQ. $$$_ .$VALUE"])))
          | where_capture("METHOD"; "^(get|post|put|patch|del|head|delete)$"))
              + (($all
          | in_files_with($all | of(["$REQUEST = require('request')\n$$$_"])))
          + ($all
          | in_files_with($all | of(["import * as $REQUEST from 'request'\n$$$_"])))
          + ($all
          | in_files_with($all | of(["import $REQUEST from 'request'\n$$$_"])))
          | at_same_place(($all | of(["$REQUEST.$METHOD($REQ.$VALUE['$$$_'],$$$_)","$REQUEST.$METHOD($REQ.$VALUE['$$$_'] + $$$A,$$$_)","$REQUEST.$METHOD(`${$REQ.$VALUE['$$$_']}$$$_`,$$$_)"])))
          | at_same_place(($all | of(["$REQ.$VALUE"])))
          | where_capture("METHOD"; "^(get|post|put|patch|del|head|delete)$"))
              + (($all
          | in_files_with($all | of(["$REQUEST = require('request')\n$$$_"])))
          + ($all
          | in_files_with($all | of(["import * as $REQUEST from 'request'\n$$$_"])))
          + ($all
          | in_files_with($all | of(["import $REQUEST from 'request'\n$$$_"])))
          | at_same_place((($all
          | in_files_with($all | of(["$ASSIGN = $REQ. $$$_ .$VALUE\n$$$_"])))
          + ($all
          | in_files_with($all | of(["$ASSIGN = $REQ. $$$_ .$VALUE['$$$_']\n$$$_"])))
          + ($all
          | in_files_with($all | of(["$ASSIGN = $REQ. $$$_ .$VALUE + $$$A\n$$$_"])))
          + ($all
          | in_files_with($all | of(["$ASSIGN = $REQ. $$$_ .$VALUE['$$$_'] + $$$A\n$$$_"])))
          + ($all
          | in_files_with($all | of(["$ASSIGN = `${$REQ. $$$_ .$VALUE}$$$_`\n$$$_"])))
          + ($all
          | in_files_with($all | of(["$ASSIGN = `${$REQ. $$$_ .$VALUE['$$$_']}$$$_`\n$$$_"])))
          + (($all
          | in_files_with($all | of(["$ASSIGN = \"$HTTP\"+ $REQ. $$$_ .$VALUE\n$$$_"])))
          + ($all
          | in_files_with($all | of(["$ASSIGN = \"$HTTP\"+$REQ. $$$_ .$VALUE + $$$A\n$$$_"])))
          + ($all
          | in_files_with($all | of(["$ASSIGN = \"$HTTP\"+$REQ.$VALUE[$$$_]\n$$$_"])))
          + ($all
          | in_files_with($all | of(["$ASSIGN = \"$HTTP\"+$REQ.$VALUE[$$$_] + $$$A\n$$$_"])))
          + ($all
          | in_files_with($all | of(["$ASSIGN = `$HTTP${$REQ.$VALUE[$$$_]}$$$_`\n$$$_"])))
          | where_capture("HTTP"; "^(https?:\\/\\/|//)$"))))
          | at_same_place((($all | of(["$REQUEST.$METHOD($ASSIGN,$$$_)"]))
          + ($all | of(["$REQUEST.$METHOD($ASSIGN + $$$FOO,$$$_)"]))
          + ($all | of(["$REQUEST.$METHOD(`${$ASSIGN}$$$_`,$$$_)"]))
          + ($all | of(["$REQUEST.$METHOD(\"$HTTP\"+$ASSIGN,$$$_)","$REQUEST.$METHOD(\"$HTTP\"+$ASSIGN + $$$A,$$$_)","$REQUEST.$METHOD(`$HTTP${$ASSIGN}$$$_`,$$$_)"])
          | where_capture("HTTP"; "^(https?:\\/\\/|//)$"))))
          | at_same_place(($all | of(["$ASSIGN"])))
          | where_capture("METHOD"; "^(get|post|put|patch|del|head|delete)$")))
          | reaching(((($all
          | within($all | of(["function $$$_ ($REQ, $$$_) {$$$_}"])))
          | at_same_place(($all | of(["$REQ.query","$REQ.body","$REQ.params","$REQ.cookies","$REQ.headers"]))))
              + (($all
          | within($all | of(["({ $REQ }: Request,$$$_) =>\n{$$$_}"])))
          + ($all
          | within($all | of(["({ $REQ }: $EXPRESS.Request,$$$_) => {$$$_}"])))
          | at_same_place(($all | of(["params","query","cookies","headers","body"])))
          | focus("REQ")));
              ([]))
        | finding("express-ssrf";
            "The following request $REQUEST.$METHOD() was found to be crafted from user-input `$REQ` which can lead to Server-Side Request Forgery (SSRF) vulnerabilities.") ) )
| report
