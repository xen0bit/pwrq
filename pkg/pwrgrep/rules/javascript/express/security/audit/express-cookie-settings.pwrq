          | at_same_place(($all | of(["$SESSION($$$_)"])))
          | outside($all | of(["$SESSION(<$$$_ {cookie:{domain:$$$_}} $$$_>,$$$_)"]))
          | outside($all | of(["$OPTS = <$$$_ {cookie:{domain:$$$_}} $$$_>;\n$$$_\n$SESSION($OPTS,$$$_);"]))
          | outside($all | of(["$OPTS = $$$_;\n$$$_\n$COOKIE = <$$$_ {domain:$$$_} $$$_>;\n$$$_\n$SESSION($OPTS,$$$_);"]))
          | outside($all | of(["$OPTS = $$$_;\n$$$_\n$OPTS.cookie = <$$$_ {domain:$$$_} $$$_>;\n$$$_\n$SESSION($OPTS,$$$_);"]))
          | outside($all | of(["$OPTS = $$$_;\n$$$_\n$COOKIE.domain = $$$_;\n$$$_\n$SESSION($OPTS,$$$_);"]))
          | outside($all | of(["$OPTS = $$$_;\n$$$_\n$OPTS.cookie.domain = $$$_;\n$$$_\n$SESSION($OPTS,$$$_);"]))
        | finding("express-cookie-session-no-domain";
            "Default session middleware settings: `domain` not set.") )
      + ( ($all)
          + ($all)
          | at_same_place(($all | of(["$SESSION($$$_)"])))
          | outside($all | of(["$SESSION(<$$$_ {cookie:{path:$$$_}} $$$_>,$$$_)"]))
          | outside($all | of(["$OPTS = <$$$_ {cookie:{path:$$$_}} $$$_>;\n$$$_\n$SESSION($OPTS,$$$_);"]))
          | outside($all | of(["$OPTS = $$$_;\n$$$_\n$COOKIE = <$$$_ {path:$$$_} $$$_>;\n$$$_\n$SESSION($OPTS,$$$_);"]))
          | outside($all | of(["$OPTS = $$$_;\n$$$_\n$OPTS.cookie = <$$$_ {path:$$$_} $$$_>;\n$$$_\n$SESSION($OPTS,$$$_);"]))
          | outside($all | of(["$OPTS = $$$_;\n$$$_\n$COOKIE.path = $$$_;\n$$$_\n$SESSION($OPTS,$$$_);"]))
          | outside($all | of(["$OPTS = $$$_;\n$$$_\n$OPTS.cookie.path = $$$_;\n$$$_\n$SESSION($OPTS,$$$_);"]))
        | finding("express-cookie-session-no-path";
            "Default session middleware settings: `path` not set.") )
      + ( ($all)
          + ($all)
          | at_same_place(($all | of(["$SESSION($$$_)"])))
          | outside($all | of(["$SESSION(<$$$_ {cookie:{expires:$$$_}} $$$_>,$$$_)"]))
          | outside($all | of(["$OPTS = <$$$_ {cookie:{expires:$$$_}} $$$_>;\n$$$_\n$SESSION($OPTS,$$$_);"]))
          | outside($all | of(["$OPTS = $$$_;\n$$$_\n$COOKIE = <$$$_ {expires:$$$_} $$$_>;\n$$$_\n$SESSION($OPTS,$$$_);"]))
          | outside($all | of(["$OPTS = $$$_;\n$$$_\n$OPTS.cookie = <$$$_ {expires:$$$_} $$$_>;\n$$$_\n$SESSION($OPTS,$$$_);"]))
          | outside($all | of(["$OPTS = $$$_;\n$$$_\n$COOKIE.expires = $$$_;\n$$$_\n$SESSION($OPTS,$$$_);"]))
          | outside($all | of(["$OPTS = $$$_;\n$$$_\n$OPTS.cookie.expires = $$$_;\n$$$_\n$SESSION($OPTS,$$$_);"]))
        | finding("express-cookie-session-no-expires";
