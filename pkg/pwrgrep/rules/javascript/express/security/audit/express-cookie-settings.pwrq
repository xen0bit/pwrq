          | at_same_place(($all | of(["$SESSION($$$_)"])))
          | outside($all | of(["$SESSION(<$$$_ {cookie:{secure:true}} $$$_>,$$$_)"]))
          | outside($all | of(["$OPTS = <$$$_ {cookie:{secure:true}} $$$_>;\n$$$_\n$SESSION($OPTS,$$$_);"]))
          | outside($all | of(["$OPTS = $$$_;\n$$$_\n$COOKIE = <$$$_ {secure:true} $$$_>;\n$$$_\n$SESSION($OPTS,$$$_);"]))
          | outside($all | of(["$OPTS = $$$_;\n$$$_\n$OPTS.cookie = <$$$_ {secure:true} $$$_>;\n$$$_\n$SESSION($OPTS,$$$_);"]))
          | outside($all | of(["$OPTS = $$$_;\n$$$_\n$COOKIE.secure = true;\n$$$_\n$SESSION($OPTS,$$$_);"]))
          | outside($all | of(["$OPTS = $$$_;\n$$$_\n$OPTS.cookie.secure = true;\n$$$_\n$SESSION($OPTS,$$$_);"]))
        | finding("express-cookie-session-no-secure";
