      "$OPTS = $$$_;\n$$$_\n$OPTS.cookie = <$$$_ {domain:$$$_} $$$_>;\n$$$_\n$SESSION($OPTS,$$$_);",
      "$OPTS = $$$_;\n$$$_\n$OPTS.cookie = <$$$_ {expires:$$$_} $$$_>;\n$$$_\n$SESSION($OPTS,$$$_);",
      "$OPTS = $$$_;\n$$$_\n$OPTS.cookie = <$$$_ {httpOnly:true} $$$_>;\n$$$_\n$SESSION($OPTS,$$$_);",
      "$OPTS = $$$_;\n$$$_\n$OPTS.cookie = <$$$_ {path:$$$_} $$$_>;\n$$$_\n$SESSION($OPTS,$$$_);",
      "$OPTS = $$$_;\n$$$_\n$OPTS.cookie = <$$$_ {secure:true} $$$_>;\n$$$_\n$SESSION($OPTS,$$$_);",
      "$OPTS = $$$_;\n$$$_\n$OPTS.cookie.domain = $$$_;\n$$$_\n$SESSION($OPTS,$$$_);",
      "$OPTS = $$$_;\n$$$_\n$OPTS.cookie.expires = $$$_;\n$$$_\n$SESSION($OPTS,$$$_);",
      "$OPTS = $$$_;\n$$$_\n$OPTS.cookie.httpOnly = true;\n$$$_\n$SESSION($OPTS,$$$_);",
      "$OPTS = $$$_;\n$$$_\n$OPTS.cookie.path = $$$_;\n$$$_\n$SESSION($OPTS,$$$_);",
      "$OPTS = $$$_;\n$$$_\n$OPTS.cookie.secure = true;\n$$$_\n$SESSION($OPTS,$$$_);",
      "$OPTS = $$$_;\n$$$_\n$OPTS.name = $$$_;\n$$$_\n$SESSION($OPTS,$$$_);",
      "$OPTS = <$$$_ {cookie:{domain:$$$_}} $$$_>;\n$$$_\n$SESSION($OPTS,$$$_);",
      "$OPTS = <$$$_ {cookie:{expires:$$$_}} $$$_>;\n$$$_\n$SESSION($OPTS,$$$_);",
      "$OPTS = <$$$_ {cookie:{httpOnly:true}} $$$_>;\n$$$_\n$SESSION($OPTS,$$$_);",
      "$OPTS = <$$$_ {cookie:{path:$$$_}} $$$_>;\n$$$_\n$SESSION($OPTS,$$$_);",
      "$OPTS = <$$$_ {cookie:{secure:true}} $$$_>;\n$$$_\n$SESSION($OPTS,$$$_);",
      "$OPTS = <$$$_ {name:$$$_} $$$_>;\n$$$_\n$SESSION($OPTS,$$$_);",
      "$SESSION = require('cookie-session');\n$$$_",
      "$SESSION = require('express-session');\n$$$_",
      "$SESSION($$$_)",
      "$SESSION(<$$$_ {cookie:{domain:$$$_}} $$$_>,$$$_)",
      "$SESSION(<$$$_ {cookie:{expires:$$$_}} $$$_>,$$$_)",
      "$SESSION(<$$$_ {cookie:{httpOnly:true}} $$$_>,$$$_)",
      "$SESSION(<$$$_ {cookie:{path:$$$_}} $$$_>,$$$_)",
      "$SESSION(<$$$_ {cookie:{secure:true}} $$$_>,$$$_)",
      "$SESSION(<$$$_ {name:$$$_} $$$_>,$$$_)"
    ])) as $all
    | ( ($all)
          + ($all)
          | at_same_place(($all | of(["$SESSION($$$_)"])))
          | outside($all | of(["$SESSION(<$$$_ {name:$$$_} $$$_>,$$$_)"]))
          | outside($all | of(["$OPTS = <$$$_ {name:$$$_} $$$_>;\n$$$_\n$SESSION($OPTS,$$$_);"]))
          | outside($all | of(["$OPTS = $$$_;\n$$$_\n$OPTS.name = $$$_;\n$$$_\n$SESSION($OPTS,$$$_);"]))
        | finding("express-cookie-session-default-name";
