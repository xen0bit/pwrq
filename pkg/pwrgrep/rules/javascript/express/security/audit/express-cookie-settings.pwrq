          | at_same_place(($all | of(["$SESSION($$$_)"])))
          | outside($all | of(["$SESSION(<$$$_ {cookie:{httpOnly:true}} $$$_>,$$$_)"]))
          | outside($all | of(["$OPTS = <$$$_ {cookie:{httpOnly:true}} $$$_>;\n$$$_\n$SESSION($OPTS,$$$_);"]))
          | outside($all | of(["$OPTS = $$$_;\n$$$_\n$COOKIE = <$$$_ {httpOnly:true} $$$_>;\n$$$_\n$SESSION($OPTS,$$$_);"]))
          | outside($all | of(["$OPTS = $$$_;\n$$$_\n$OPTS.cookie = <$$$_ {httpOnly:true} $$$_>;\n$$$_\n$SESSION($OPTS,$$$_);"]))
          | outside($all | of(["$OPTS = $$$_;\n$$$_\n$COOKIE.httpOnly = true;\n$$$_\n$SESSION($OPTS,$$$_);"]))
          | outside($all | of(["$OPTS = $$$_;\n$$$_\n$OPTS.cookie.httpOnly = true;\n$$$_\n$SESSION($OPTS,$$$_);"]))
        | finding("express-cookie-session-no-httponly";
