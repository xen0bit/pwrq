# rules: express-vm2-injection
# languages: typescript
# from: javascript/express/security/express-vm2-injection.yaml

. as $root
| ( ($root | scan_ast(["*.ts"]; [
      "$APP.$METHOD($$$_, function $FUNC($REQ, $RES) {$$$_})",
      "$APP.$METHOD($$$_, function $FUNC($REQ, $RES, $NEXT) {$$$_})",
      "$REQ.body",
      "$REQ.cookies",
      "$REQ.headers",
      "$REQ.params",
      "$REQ.query",
      "$VM = new NodeVM($$$_)\n$$$_",
      "$VM = new VM($$$_)\n$$$_",
      "$VM.run($$$_)",
      "({ $REQ }: Request,$RES: Response) => {$$$_}",
      "({ $REQ }: Request,$RES: Response, $NEXT: NextFunction) =>\n{$$$_}",
      "body",
      "cookies",
      "function $$$_ ($REQ, $RES) {$$$_}",
      "function $$$_ ($REQ, $RES, $NEXT) {$$$_}",
      "headers",
      "new NodeVM($$$_)",
      "new NodeVM($$$_).run($$$_)",
      "new VM($$$_)",
      "new VM($$$_).run($$$_)",
      "new VMScript($$$_)",
      "params",
      "query",
      "require('vm2')\n$$$_"
    ])) as $all
    | ( (((($all
          | in_files_with($all | of(["$VM = new VM($$$_)\n$$$_"])))
          + ($all
          | in_files_with($all | of(["$VM = new NodeVM($$$_)\n$$$_"])))
          | at_same_place(($all | of(["$VM.run($$$_)"]))))
          + ($all | of(["new VM($$$_).run($$$_)"]))
          + ($all | of(["new NodeVM($$$_).run($$$_)"]))
          + ($all | of(["new VMScript($$$_)"]))
          + ($all | of(["new VM($$$_)"]))
          + ($all | of(["new NodeVM($$$_)"]))
          | in_files_with($all | of(["require('vm2')\n$$$_"]))))
          | reaching(((($all
          | within($all | of(["function $$$_ ($REQ, $RES) {$$$_}"])))
          + ($all
          | within($all | of(["function $$$_ ($REQ, $RES, $NEXT) {$$$_}"])))
          + (($all
          | within($all | of(["$APP.$METHOD($$$_, function $FUNC($REQ, $RES) {$$$_})"])))
          + ($all
          | within($all | of(["$APP.$METHOD($$$_, function $FUNC($REQ, $RES, $NEXT) {$$$_})"])))
          | where_capture("METHOD"; "^(get|post|put|head|delete|options)$"))
          | at_same_place(($all | of(["$REQ.query","$REQ.body","$REQ.params","$REQ.cookies","$REQ.headers"]))))
              + (($all
          | within($all | of(["({ $REQ }: Request,$RES: Response, $NEXT: NextFunction) =>\n{$$$_}"])))
          + ($all
          | within($all | of(["({ $REQ }: Request,$RES: Response) => {$$$_}"])))
          | at_same_place(($all | of(["params","query","cookies","headers","body"])))
          | focus("REQ")));
              ([]))
        | finding("express-vm2-injection";
            "Make sure that unverified user data can not reach `vm2`.") ) )
| report
