# rules: express-expat-xxe
# languages: typescript
# from: javascript/express/security/express-expat-xxe.yaml

. as $root
| ( ($root | scan_ast(["*.ts"]; [
      "$APP.$METHOD($$$_, function $FUNC($REQ, $RES) {$$$_})",
      "$APP.$METHOD($$$_, function $FUNC($REQ, $RES, $NEXT) {$$$_})",
      "$PARSER = new $XML.Parser($$$_);\n$$$_",
      "$PARSER.parse($QUERY)",
      "$PARSER.write($QUERY)",
      "$REQ.body",
      "$REQ.cookies",
      "$REQ.headers",
      "$REQ.params",
      "$REQ.query",
      "$XML = require('node-expat')\n$$$_",
      "({ $REQ }: Request,$RES: Response) => {$$$_}",
      "({ $REQ }: Request,$RES: Response, $NEXT: NextFunction) =>\n{$$$_}",
      "body",
      "cookies",
      "function $$$_ ($REQ, $RES) {$$$_}",
      "function $$$_ ($REQ, $RES, $NEXT) {$$$_}",
      "headers",
      "import $XML from 'node-expat'\n$$$_",
      "import * as $XML from 'node-expat'\n$$$_",
      "params",
      "query"
    ])) as $all
    | ( ((($all
          | in_files_with($all | of(["$XML = require('node-expat')\n$$$_"])))
          + ($all
          | in_files_with($all | of(["import $XML from 'node-expat'\n$$$_"])))
          + ($all
          | in_files_with($all | of(["import * as $XML from 'node-expat'\n$$$_"])))
          | at_same_place((($all
          | in_files_with($all | of(["$PARSER = new $XML.Parser($$$_);\n$$$_"])))))
          | at_same_place(($all | of(["$PARSER.parse($QUERY)","$PARSER.write($QUERY)"])))
          | focus("QUERY")))
          | reaching(((($all
          | within($all | of(["function $$$_ ($REQ, $RES) {$$$_}"])))
          + ($all
          | within($all | of(["function $$$_ ($REQ, $RES, $NEXT) {$$$_}"])))
          + (($all
          | within($all | of(["$APP.$METHOD($$$_, function $FUNC($REQ, $RES) {$$$_})"])))
          + ($all
          | within($all | of(["$APP.$METHOD($$$_, function $FUNC($REQ, $RES, $NEXT) {$$$_})"])))
          | where_capture("METHOD"; "^(get|post|put|head|delete|options)$"))
          | at_same_place(($all | of(["$REQ.query","$REQ.body","$REQ.params","$REQ.cookies","$REQ.headers"]))))
              + (($all
          | within($all | of(["({ $REQ }: Request,$RES: Response, $NEXT: NextFunction) =>\n{$$$_}"])))
          + ($all
          | within($all | of(["({ $REQ }: Request,$RES: Response) => {$$$_}"])))
          | at_same_place(($all | of(["params","query","cookies","headers","body"])))
          | focus("REQ")));
              ([]))
        | finding("express-expat-xxe";
            "Make sure that unverified user data can not reach the XML Parser, as it can result in XML External or Internal Entity (XXE) Processing vulnerabilities.") ) )
| report
