# rules: tainted-sql-string
# languages: typescript
# from: javascript/express/security/injection/tainted-sql-string.yaml

. as $root
| ( ($root | scan_ast(["*.ts"]; [
      "\"$SQLSTR\" + $EXPR",
      "\"$SQLSTR\".concat($EXPR)",
      "$REQ.body",
      "$REQ.cookies",
      "$REQ.headers",
      "$REQ.params",
      "$REQ.query",
      "($$$_,{ $REQ }: $EXPRESS.Request,$$$_) => {$$$_}",
      "($$$_,{ $REQ }: Request,$$$_) => {$$$_}",
      "`$SQLSTR${$EXPR}$$$_`",
      "body",
      "cookies",
      "function $$$_ ($$$_,$REQ, $$$_) {$$$_}",
      "headers",
      "params",
      "query",
      "util.format($SQLSTR, $EXPR)"
    ])) as $all
    | ( (((($all
          | within($all | of(["\"$SQLSTR\" + $EXPR"])))
          + ($all
          | within($all | of(["\"$SQLSTR\".concat($EXPR)"])))
          + ($all | of(["util.format($SQLSTR, $EXPR)"]))
          + ($all | of(["`$SQLSTR${$EXPR}$$$_`"]))
          | where_capture("SQLSTR"; "^(?:.*\\b(?i)(select|delete|insert|create|update\\s+.+\\sset|alter|drop)\\b.*)"))
          | focus("EXPR")))
          | reaching(((($all
          | within($all | of(["function $$$_ ($$$_,$REQ, $$$_) {$$$_}"])))
          | at_same_place(($all | of(["$REQ.query","$REQ.body","$REQ.params","$REQ.cookies","$REQ.headers"]))))
              + (($all
          | within($all | of(["($$$_,{ $REQ }: Request,$$$_) => {$$$_}"])))
          + ($all
          | within($all | of(["($$$_,{ $REQ }: $EXPRESS.Request,$$$_) => {$$$_}"])))
          | at_same_place(($all | of(["params","query","cookies","headers","body"])))
          | focus("REQ")));
              ([]))
        | finding("tainted-sql-string";
            "Detected user input used to manually construct a SQL string.") ) )
| report
