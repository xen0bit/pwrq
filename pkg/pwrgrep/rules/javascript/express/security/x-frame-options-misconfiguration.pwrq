# rules: x-frame-options-misconfiguration
# languages: typescript
# from: javascript/express/security/x-frame-options-misconfiguration.yaml

. as $root
| ( ($root | scan_ast(["*.ts"]; [
      "$APP.$METHOD($$$_, function $FUNC($REQ, $RES) {$$$_})",
      "$APP.$METHOD($$$_, function $FUNC($REQ, $RES, $NEXT) {$$$_})",
      "$REQ.body",
      "$REQ.cookies",
      "$REQ.headers",
      "$REQ.params",
      "$REQ.query",
      "$RES.header($HEADER, $$$_)",
      "$RES.set($HEADER, $$$_)",
      "$RES.set({$HEADER: $$$_}, $$$_)",
      "$RES.setHeader($HEADER, $$$_)",
      "$RES.writeHead($STATUS, {$HEADER: $$$_}, $$$_)",
      "({ $REQ }: Request,$RES: Response) => {$$$_}",
      "({ $REQ }: Request,$RES: Response, $NEXT: NextFunction) =>\n{$$$_}",
      "body",
      "cookies",
      "function $$$_ ($REQ, $RES) {$$$_}",
      "function $$$_ ($REQ, $RES, $NEXT) {$$$_}",
      "headers",
      "params",
      "query"
    ])) as $all
    | ( (($all | of(["$RES.set($HEADER, $$$_)","$RES.header($HEADER, $$$_)","$RES.setHeader($HEADER, $$$_)","$RES.set({$HEADER: $$$_}, $$$_)","$RES.writeHead($STATUS, {$HEADER: $$$_}, $$$_)"])
          | where_capture("HEADER"; "^(?:.*(X-Frame-Options|x-frame-options).*)")))
          | reaching(((($all
          | within($all | of(["function $$$_ ($REQ, $RES) {$$$_}"])))
          + ($all
          | within($all | of(["function $$$_ ($REQ, $RES, $NEXT) {$$$_}"])))
          + (($all
          | within($all | of(["$APP.$METHOD($$$_, function $FUNC($REQ, $RES) {$$$_})"])))
          + ($all
          | within($all | of(["$APP.$METHOD($$$_, function $FUNC($REQ, $RES, $NEXT) {$$$_})"])))
          | where_capture("METHOD"; "^(get|post|put|head|delete|options)$"))
          | at_same_place(($all | of(["$REQ.query","$REQ.body","$REQ.params","$REQ.cookies","$REQ.headers"]))))
              + (($all
          | within($all | of(["({ $REQ }: Request,$RES: Response, $NEXT: NextFunction) =>\n{$$$_}"])))
          + ($all
          | within($all | of(["({ $REQ }: Request,$RES: Response) => {$$$_}"])))
          | at_same_place(($all | of(["params","query","cookies","headers","body"])))
          | focus("REQ")));
              ([]))
        | finding("x-frame-options-misconfiguration";
            "By letting user input control `X-Frame-Options` header, there is a risk that software does not properly verify whether or not a browser should be allowed to render a page in an `iframe`.") ) )
| report
