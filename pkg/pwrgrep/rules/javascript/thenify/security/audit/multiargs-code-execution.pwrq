# rules: multiargs-code-execution
# from: javascript/thenify/security/audit/multiargs-code-execution.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$OPTS = {multiArgs: $$$_};\n$$$_\n$THENIFY($FN,$OPTS,$$$_);",
      "$OPTS = {multiArgs: false};\n$$$_\n$THENIFY($FN,$OPTS,$$$_)",
      "$THENIFY = require('thenify');\n$$$_",
      "$THENIFY($FN, {multiArgs: $$$_},$$$_)",
      "$THENIFY($FN, {multiArgs: false},$$$_)",
      "import 'thenify';\n$$$_"
    ])) as $all
    | ( $all | of(["$THENIFY($FN, {multiArgs: $$$_},$$$_)","$OPTS = {multiArgs: $$$_};\n$$$_\n$THENIFY($FN,$OPTS,$$$_);"])
          | at_same_place((($all)
          + ($all)))
          | not_at($all | of(["$THENIFY($FN, {multiArgs: false},$$$_)"]))
          | not_at($all | of(["$OPTS = {multiArgs: false};\n$$$_\n$THENIFY($FN,$OPTS,$$$_)"]))
        | finding("multiargs-code-execution";
            "Potential arbitrary code execution, piped to eval") ) )
| report
