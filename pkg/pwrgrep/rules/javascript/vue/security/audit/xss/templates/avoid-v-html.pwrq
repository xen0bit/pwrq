# rules: avoid-v-html
# from: javascript/vue/security/audit/xss/templates/avoid-v-html.yaml

. as $root
| ( ($root | scan_regex(["*.vue"]; [
      "<[^<>]*v-html="
    ])) as $all
    | ( $all | of(["<[^<>]*v-html="])
        | finding("avoid-v-html";
            "Dynamically rendering arbitrary HTML on your website can be very dangerous because it can easily lead to XSS vulnerabilities.") ) )
| report
