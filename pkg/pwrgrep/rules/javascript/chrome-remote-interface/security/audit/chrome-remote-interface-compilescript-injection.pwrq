# rules: chrome-remote-interface-compilescript-injection
# languages: javascript, typescript
# from: javascript/chrome-remote-interface/security/audit/chrome-remote-interface-compilescript-injection.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$PAGE.navigate({url: $SINK},$$$_)",
      "$PAGE.setDocumentContent({html: $SINK},$$$_)",
      "$RUNTIME.compileScript({expression: $SINK},$$$_)",
      "$RUNTIME.evaluate({expression: $SINK},$$$_)",
      "$RUNTIME.printToPDF({footerTemplate: $SINK},$$$_)",
      "$RUNTIME.printToPDF({headerTemplate: $SINK},$$$_)",
      "function $$$_ ($$$_, $ARG,$$$_) {$$$_}",
      "import 'chrome-remote-interface';\n$$$_",
      "require('chrome-remote-interface');\n$$$_"
    ])) as $all
    | ( ((($all
          | in_files_with($all | of(["require('chrome-remote-interface');\n$$$_"])))
          + ($all
          | in_files_with($all | of(["import 'chrome-remote-interface';\n$$$_"])))
          | at_same_place(($all | of(["$RUNTIME.compileScript({expression: $SINK},$$$_)","$RUNTIME.evaluate({expression: $SINK},$$$_)","$PAGE.navigate({url: $SINK},$$$_)","$RUNTIME.printToPDF({headerTemplate: $SINK},$$$_)","$RUNTIME.printToPDF({footerTemplate: $SINK},$$$_)","$PAGE.setDocumentContent({html: $SINK},$$$_)"])))
          | focus("SINK")))
          | reaching((($all
          | within($all | of(["function $$$_ ($$$_, $ARG,$$$_) {$$$_}"]))
          | focus("ARG")));
              ([]))
        | finding("chrome-remote-interface-compilescript-injection";
            "If unverified user data can reach the `compileScript` method it can result in Server-Side Request Forgery vulnerabilities") ) )
| report
