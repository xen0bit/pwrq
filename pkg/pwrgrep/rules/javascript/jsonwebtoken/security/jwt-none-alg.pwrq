# rules: jwt-none-alg
# from: javascript/jsonwebtoken/security/jwt-none-alg.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "\"jsonwebtoken\"",
      "$JWT = require(\"jsonwebtoken\");\n$$$_",
      "$JWT.verify($P, $X, {algorithms:[$$$_,'none',$$$_]},$$$_)"
    ])) as $all
    | ( $all | of(["$JWT.verify($P, $X, {algorithms:[$$$_,'none',$$$_]},$$$_)"])
          | in_files_with($all | of(["$JWT = require(\"jsonwebtoken\");\n$$$_","\"jsonwebtoken\""]))
        | finding("jwt-none-alg";
            "Detected use of the 'none' algorithm in a JWT token.") ) )
| report
