# rules: multiple-entrypoint-instructions
# from: dockerfile/correctness/multiple-entrypoint-instructions.yaml

. as $root
| ( ($root | scan_regex(["Dockerfile*"]; [
      "ENTRYPOINT\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+(?P<ENTRYPOINT_INSTR>\\S+)"
    ])) as $all
    | ( $all | of(["ENTRYPOINT\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+(?P<ENTRYPOINT_INSTR>\\S+)"])
          | where_capture_ast("ENTRYPOINT_INSTR"; "ENTRYPOINT\\s+[\\s\\S]*?")
          | focus("ENTRYPOINT_INSTR")
        | finding("multiple-entrypoint-instructions";
            "Multiple ENTRYPOINT instructions were found.") ) )
| report
