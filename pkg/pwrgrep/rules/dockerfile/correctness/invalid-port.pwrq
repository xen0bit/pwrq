# rules: invalid-port
# from: dockerfile/correctness/invalid-port.yaml

. as $root
| ( ($root | scan_regex(["Dockerfile*"]; [
      "EXPOSE\\s+(?P<PORT>\\S+)"
    ])) as $all
    | ( ($all | of(["EXPOSE\\s+(?P<PORT>\\S+)"])
          | where_capture_compare("$PORT > 65535"))
        | finding("invalid-port";
            "Detected an invalid port number.") ) )
| report
