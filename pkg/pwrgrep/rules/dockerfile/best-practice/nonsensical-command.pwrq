# rules: nonsensical-command
# from: dockerfile/best-practice/nonsensical-command.yaml

. as $root
| ( ($root | scan_regex(["Dockerfile*"]; [
      "RUN\\s+(?P<CMD>\\S+)\\s+[\\s\\S]*?"
    ])) as $all
    | ( $all | of(["RUN\\s+(?P<CMD>\\S+)\\s+[\\s\\S]*?"])
          | where_capture("CMD"; "^(?:(shutdown|service|ps|free|top|kill|mount|ifconfig|nano|vim))")
        | finding("nonsensical-command";
            "Some commands such as `$CMD` do not make sense in a container.") ) )
| report
