# rules: set-pipefail
# from: dockerfile/best-practice/set-pipefail.yaml

. as $root
| ( ($root | scan_regex(["Dockerfile*"]; [
      "RUN\\s+[\\s\\S]*?\\s+\\|\\s+[\\s\\S]*?",
      "RUN\\s+[\\s\\S]*?\\s+\\|\\|\\s+[\\s\\S]*?",
      "SHELL\\s+\\[\"\\/bin\\/ash\",\\s+[\\s\\S]*?\\]\\s+[\\s\\S]*?\\s+RUN\\s+[\\s\\S]*?\\s+\\|\\s+[\\s\\S]*?",
      "SHELL\\s+\\[[\\s\\S]*?,\\s+\"pipefail\",\\s+[\\s\\S]*?\\]\\s+[\\s\\S]*?\\s+RUN\\s+[\\s\\S]*?\\s+\\|\\s+[\\s\\S]*?"
    ])) as $all
    | ( $all | of(["RUN\\s+[\\s\\S]*?\\s+\\|\\s+[\\s\\S]*?","RUN\\s+[\\s\\S]*?\\s+\\|\\|\\s+[\\s\\S]*?"])
          | outside($all | of(["SHELL\\s+\\[[\\s\\S]*?,\\s+\"pipefail\",\\s+[\\s\\S]*?\\]\\s+[\\s\\S]*?\\s+RUN\\s+[\\s\\S]*?\\s+\\|\\s+[\\s\\S]*?"]))
          | outside($all | of(["SHELL\\s+\\[\"\\/bin\\/ash\",\\s+[\\s\\S]*?\\]\\s+[\\s\\S]*?\\s+RUN\\s+[\\s\\S]*?\\s+\\|\\s+[\\s\\S]*?"]))
        | finding("set-pipefail";
            "Only the exit code from the final command in this RUN instruction will be evaluated unless 'pipefail' is set.") ) )
| report
