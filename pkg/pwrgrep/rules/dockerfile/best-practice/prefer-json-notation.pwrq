# rules: prefer-json-notation
# from: dockerfile/best-practice/prefer-json-notation.yaml

. as $root
| ( ($root | scan_regex(["Dockerfile*"]; [
      "CMD\\s+(?P<WORD>\\S+)\\s+[\\s\\S]*?",
      "CMD\\s+\\[[\\s\\S]*?\\]",
      "ENTRYPOINT\\s+(?P<WORD>\\S+)\\s+[\\s\\S]*?",
      "ENTRYPOINT\\s+\\[[\\s\\S]*?\\]"
    ])) as $all
    | ( ($all | of(["CMD\\s+(?P<WORD>\\S+)\\s+[\\s\\S]*?"])
          | outside($all | of(["CMD\\s+\\[[\\s\\S]*?\\]"])))
          + ($all | of(["ENTRYPOINT\\s+(?P<WORD>\\S+)\\s+[\\s\\S]*?"])
          | outside($all | of(["ENTRYPOINT\\s+\\[[\\s\\S]*?\\]"])))
        | finding("prefer-json-notation";
            "Prefer JSON notation when using CMD or ENTRYPOINT.") ) )
| report
