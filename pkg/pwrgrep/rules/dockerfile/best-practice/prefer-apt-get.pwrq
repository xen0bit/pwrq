# rules: prefer-apt-get
# languages: dockerfile
# from: dockerfile/best-practice/prefer-apt-get.yaml

. as $root
| ( ($root | scan_ast(["Dockerfile*"]; [
      "RUN apt $$$_",
      "RUN apt-get $$$_"
    ])) as $all
    | ( $all | of(["RUN apt $$$_"])
          | not_at($all | of(["RUN apt-get $$$_"]))
        | finding("prefer-apt-get";
            "'apt-get' is preferred as an unattended tool for stability.") ) )
| report
