# rules: avoid-dnf-update
# from: dockerfile/best-practice/avoid-dnf-update.yaml

. as $root
| ( ($root | scan_regex(["Dockerfile*"]; [
      "dnf\\s+update"
    ])) as $all
    | ( $all | of(["dnf\\s+update"])
        | finding("avoid-dnf-update";
            "Packages in base images should be up-to-date, removing the need for 'dnf update'.") ) )
| report
