# rules: avoid-apt-get-upgrade
# languages: dockerfile
# from: dockerfile/best-practice/avoid-apt-get-upgrade.yaml

. as $root
| ( ($root | scan_ast(["Dockerfile*"]; [
      "RUN $$$_ apt-get dist-upgrade $$$_",
      "RUN $$$_ apt-get upgrade $$$_"
    ])) as $all
    | ( $all | of(["RUN $$$_ apt-get upgrade $$$_","RUN $$$_ apt-get dist-upgrade $$$_"])
        | finding("avoid-apt-get-upgrade";
            "Packages in base containers should be up-to-date, removing the need to upgrade or dist-upgrade.") ) )
| report
