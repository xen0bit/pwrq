# rules: prefer-copy-over-add
# languages: dockerfile
# from: dockerfile/best-practice/prefer-copy-over-add.yaml

. as $root
| ( ($root | scan_ast(["Dockerfile*"]; [
      "ADD $FROM $TO"
    ])) as $all
    | ( $all | of(["ADD $FROM $TO"])
          | where_capture("FROM"; "^(?:(^[A-Za-z]+:\\/\\/|.*[.](gz|bz2|zip|tar)$))")
          | focus("FROM")
        | finding("prefer-copy-over-add";
            "The ADD command will accept and include files from a URL and automatically extract archives.") ) )
| report
