# rules: remove-package-cache
# from: dockerfile/best-practice/remove-package-cache.yaml

. as $root
| ( ($root | scan_regex(["Dockerfile*"]; [
      "RUN\\s+[\\s\\S]*?\\s+&&\\s+apt\\-get\\s+clean\\s+[\\s\\S]*?",
      "RUN\\s+[\\s\\S]*?\\s+apt\\-get\\s+update\\s+[\\s\\S]*?",
      "apt\\-get\\s+update"
    ])) as $all
    | ( $all | of(["RUN\\s+[\\s\\S]*?\\s+apt\\-get\\s+update\\s+[\\s\\S]*?"])
          | at_same_place(($all | of(["apt\\-get\\s+update"])))
          | outside($all | of(["RUN\\s+[\\s\\S]*?\\s+&&\\s+apt\\-get\\s+clean\\s+[\\s\\S]*?"]))
        | finding("remove-package-cache";
            "The package cache was not deleted after running 'apt-get update', which increases the size of the image.") ) )
| report
