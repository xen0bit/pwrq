# rules: avoid-platform-with-from
# from: dockerfile/best-practice/avoid-platform-with-from.yaml

. as $root
| ( ($root | scan_regex(["Dockerfile*"]; [
      "FROM\\s+\\-\\-platform=(?P<PLATFORM>\\S+)\\s+(?P<IMAGE>\\S+)"
    ])) as $all
    | ( $all | of(["FROM\\s+\\-\\-platform=(?P<PLATFORM>\\S+)\\s+(?P<IMAGE>\\S+)"])
        | finding("avoid-platform-with-from";
            "Using '--platform' with FROM restricts the image to build on a single platform.") ) )
| report
