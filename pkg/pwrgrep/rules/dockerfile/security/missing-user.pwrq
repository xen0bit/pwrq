# rules: missing-user
# from: dockerfile/security/missing-user.yaml

. as $root
| ( ($root | scan_regex(["Dockerfile*"]; [
      "CMD\\s+(?P<VARS>[\\s\\S]*?)",
      "USER\\s+(?P<USER>\\S+)\\s+[\\s\\S]*?"
    ])) as $all
    | ( $all | of(["CMD\\s+(?P<VARS>[\\s\\S]*?)"])
          | in_files_without($all | of(["USER\\s+(?P<USER>\\S+)\\s+[\\s\\S]*?"]))
        | finding("missing-user";
            "By not specifying a USER, a program in the container may run as 'root'.") ) )
| report
