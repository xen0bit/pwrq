# rules: last-user-is-root
# from: dockerfile/security/last-user-is-root.yaml

. as $root
| ( ($root | scan_regex(["Dockerfile*"]; [
      "USER\\s+root",
      "USER\\s+root\\s+[\\s\\S]*?\\s+USER\\s+(?P<X>\\S+)"
    ])) as $all
    | ( $all | of(["USER\\s+root"])
          | outside(($all | of(["USER\\s+root\\s+[\\s\\S]*?\\s+USER\\s+(?P<X>\\S+)"])))
        | finding("last-user-is-root";
            "The last user in the container is 'root'.") ) )
| report
