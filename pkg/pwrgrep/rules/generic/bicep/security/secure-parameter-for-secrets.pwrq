# rules: secure-parameter-for-secrets
# from: generic/bicep/security/secure-parameter-for-secrets.yaml

. as $root
| ( ($root | scan_regex(["*.bicep"]; [
      "@secure\\(\\)\\s+param\\s+(?P<NAME>\\S+)\\s+string",
      "param\\s+(?P<NAME>\\S+)\\s+string"
    ])) as $all
    | ( $all | of(["param\\s+(?P<NAME>\\S+)\\s+string"])
          | outside($all | of(["@secure\\(\\)\\s+param\\s+(?P<NAME>\\S+)\\s+string"]))
          | where_capture("NAME"; "^(?:(?i).*(password|secret|token))")
        | finding("secure-parameter-for-secrets";
            "Mark sensitive parameters with the @secure() decorator.") ) )
| report
