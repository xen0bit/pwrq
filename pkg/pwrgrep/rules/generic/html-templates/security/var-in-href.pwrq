# rules: var-in-href
# from: generic/html-templates/security/var-in-href.yaml

. as $root
| ( ($root | scan_regex(["*.html","*.mustache","*.hbs"]; [
      "<a\\s+[\\s\\S]*?>",
      "href\\s+=\\s+\"\\/\\{\\{\\s+[\\s\\S]*?\\s+\\}\\}\"",
      "href\\s+=\\s+\"\\{\\{\\s+[\\s\\S]*?\\s+\\}\\}\"",
      "href\\s+=\\s+\"\\{\\{\\s+url_for\\([\\s\\S]*?\\)\\s+[\\s\\S]*?\\s+\\}\\}\"",
      "href\\s+=\\s+'\\/\\{\\{\\s+[\\s\\S]*?\\s+\\}\\}'",
      "href\\s+=\\s+'\\{\\{\\s+[\\s\\S]*?\\s+\\}\\}'",
      "href\\s+=\\s+'\\{\\{\\s+url_for\\([\\s\\S]*?\\)\\s+[\\s\\S]*?\\s+\\}\\}'",
      "href\\s+=\\s+\\{\\{\\s+[\\s\\S]*?\\s+\\}\\}",
      "href\\s+=\\s+\\{\\{\\s+url_for\\([\\s\\S]*?\\)\\s+[\\s\\S]*?\\s+\\}\\}"
    ])) as $all
    | ( $all | of(["href\\s+=\\s+\\{\\{\\s+[\\s\\S]*?\\s+\\}\\}","href\\s+=\\s+\"\\{\\{\\s+[\\s\\S]*?\\s+\\}\\}\"","href\\s+=\\s+'\\{\\{\\s+[\\s\\S]*?\\s+\\}\\}'"])
          | within($all | of(["<a\\s+[\\s\\S]*?>"]))
          | outside($all | of(["href\\s+=\\s+\\{\\{\\s+url_for\\([\\s\\S]*?\\)\\s+[\\s\\S]*?\\s+\\}\\}"]))
          | outside($all | of(["href\\s+=\\s+\"\\{\\{\\s+url_for\\([\\s\\S]*?\\)\\s+[\\s\\S]*?\\s+\\}\\}\""]))
          | outside($all | of(["href\\s+=\\s+'\\{\\{\\s+url_for\\([\\s\\S]*?\\)\\s+[\\s\\S]*?\\s+\\}\\}'"]))
          | outside($all | of(["href\\s+=\\s+\"\\/\\{\\{\\s+[\\s\\S]*?\\s+\\}\\}\""]))
          | outside($all | of(["href\\s+=\\s+'\\/\\{\\{\\s+[\\s\\S]*?\\s+\\}\\}'"]))
        | finding("var-in-href";
            "Detected a template variable used in an anchor tag with the 'href' attribute.") ) )
| report
