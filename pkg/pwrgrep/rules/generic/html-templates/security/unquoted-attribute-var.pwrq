# rules: unquoted-attribute-var
# from: generic/html-templates/security/unquoted-attribute-var.yaml

. as $root
| ( ($root | scan_regex(["*.html","*.mustache","*.hbs"]; [
      "<(?P<TAG>\\S+)\\s+[\\s\\S]*?>",
      "=\"[\\s\\S]*?\"",
      "='[\\s\\S]*?'",
      "\\{\\{\\s+[\\s\\S]*?\\s+\\}\\}"
    ])) as $all
    | ( $all | of(["\\{\\{\\s+[\\s\\S]*?\\s+\\}\\}"])
          | within($all | of(["<(?P<TAG>\\S+)\\s+[\\s\\S]*?>"]))
          | outside($all | of(["=\"[\\s\\S]*?\""]))
          | outside($all | of(["='[\\s\\S]*?'"]))
        | finding("unquoted-attribute-var";
            "Detected a unquoted template variable as an attribute.") ) )
| report
