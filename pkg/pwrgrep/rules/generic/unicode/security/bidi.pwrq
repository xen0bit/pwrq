# rules: contains-bidirectional-characters
# from: generic/unicode/security/bidi.yml

. as $root
| ( ($root | scan_regex(["*.c","*.cs","*.go","*.java","*.js","*.json","*.kt","*.lua","*.ml","*.php","*.py","*.rb","*.rs","*.scala","*.sh","*.ts","*.yaml"]; [
      "‪",
      "‫",
      "‬",
      "‭",
      "‮",
      "⁦",
      "⁧",
      "⁨",
      "⁩"
    ])) as $all
    | ( $all | of(["‪","‫","‭","‮","⁦","⁧","⁨","‬","⁩"])
        | finding("contains-bidirectional-characters";
            "This code contains bidirectional (bidi) characters.") ) )
| report
