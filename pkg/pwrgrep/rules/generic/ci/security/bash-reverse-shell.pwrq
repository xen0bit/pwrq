# rules: bash_reverse_shell
# from: generic/ci/security/bash-reverse-shell.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "<[\\s\\S]*?>\\/dev\\/tcp\\/[\\s\\S]*?\\/[\\s\\S]*?;\\s+cat\\s+<&[\\s\\S]*?\\s+\\|\\s+while\\s+read\\s+line;\\s+do\\s+\\$line\\s+2>&[\\s\\S]*?\\s+>&[\\s\\S]*?;done",
      "<[\\s\\S]*?>\\/dev\\/tcp\\/[\\s\\S]*?\\/[\\s\\S]*?;\\s+sh\\s+<&[\\s\\S]*?\\s+>&[\\s\\S]*?\\s+2>&",
      "sh\\s+\\-i\\s+>&\\s+\\/dev\\/udp\\/[\\s\\S]*?\\/[\\s\\S]*?\\s+0>&1",
      "sh\\s+\\-i\\s+[\\s\\S]*?<[\\s\\S]*?>\\s+\\/dev\\/tcp\\/[\\s\\S]*?\\/[\\s\\S]*?\\s+[\\s\\S]*?<&[\\s\\S]*?\\s+1>&[\\s\\S]*?\\s+2>&"
    ])) as $all
    | ( $all | of(["sh\\s+\\-i\\s+>&\\s+\\/dev\\/udp\\/[\\s\\S]*?\\/[\\s\\S]*?\\s+0>&1","<[\\s\\S]*?>\\/dev\\/tcp\\/[\\s\\S]*?\\/[\\s\\S]*?;\\s+sh\\s+<&[\\s\\S]*?\\s+>&[\\s\\S]*?\\s+2>&","<[\\s\\S]*?>\\/dev\\/tcp\\/[\\s\\S]*?\\/[\\s\\S]*?;\\s+cat\\s+<&[\\s\\S]*?\\s+\\|\\s+while\\s+read\\s+line;\\s+do\\s+\\$line\\s+2>&[\\s\\S]*?\\s+>&[\\s\\S]*?;done","sh\\s+\\-i\\s+[\\s\\S]*?<[\\s\\S]*?>\\s+\\/dev\\/tcp\\/[\\s\\S]*?\\/[\\s\\S]*?\\s+[\\s\\S]*?<&[\\s\\S]*?\\s+1>&[\\s\\S]*?\\s+2>&"])
        | finding("bash_reverse_shell";
            "Semgrep found a bash reverse shell") ) )
| report
