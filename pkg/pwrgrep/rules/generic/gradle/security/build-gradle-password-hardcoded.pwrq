# rules: build-gradle-password-hardcoded
# from: generic/gradle/security/build-gradle-password-hardcoded.yaml

. as $root
| ( ($root | scan_regex(["*build.gradle"]; [
      "password\\s+=\\s+env\\[[\\s\\S]*?\\]\\s+\\?:\\s+\"(?P<SECRET>\\S+)\""
    ])) as $all
    | ( $all | of(["password\\s+=\\s+env\\[[\\s\\S]*?\\]\\s+\\?:\\s+\"(?P<SECRET>\\S+)\""])
        | finding("build-gradle-password-hardcoded";
            "A secret is hard-coded in the application.") ) )
| report
