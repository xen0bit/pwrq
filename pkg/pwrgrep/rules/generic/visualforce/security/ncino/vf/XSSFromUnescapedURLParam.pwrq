# rules: xss-from-unescaped-url-param
# from: generic/visualforce/security/ncino/vf/XSSFromUnescapedURLParam.yaml

. as $root
| ( ($root | scan_regex(["*.component","*.page"]; [
      "<apex:outputText[\\s\\S]*?escape=\"false\"[\\s\\S]*?value=\"\\{![\\s\\S]*?CurrentPage\\.parameters\\.(?P<URL_PARAM>\\S+)\\}\"[\\s\\S]*?\\/>",
      "<apex:outputText[\\s\\S]*?value=\"\\{![\\s\\S]*?CurrentPage\\.parameters\\.(?P<URL_PARAM>\\S+)\\}\"[\\s\\S]*?escape=\"false\"[\\s\\S]*?\\/>",
      "<script>[\\s\\S]*?'\\{![\\s\\S]*?CurrentPage\\.parameters\\.(?P<URL_PARAM>\\S+)\\}'[\\s\\S]*?<\\/script>",
      "<script>[\\s\\S]*?'\\{![\\s\\S]*?JSENCODE\\([\\s\\S]*?CurrentPage\\.parameters\\.(?P<URL_PARAM>\\S+)\\}\\)'[\\s\\S]*?<\\/script>"
    ])) as $all
    | ( $all | of(["<apex:outputText[\\s\\S]*?escape=\"false\"[\\s\\S]*?value=\"\\{![\\s\\S]*?CurrentPage\\.parameters\\.(?P<URL_PARAM>\\S+)\\}\"[\\s\\S]*?\\/>","<apex:outputText[\\s\\S]*?value=\"\\{![\\s\\S]*?CurrentPage\\.parameters\\.(?P<URL_PARAM>\\S+)\\}\"[\\s\\S]*?escape=\"false\"[\\s\\S]*?\\/>","<script>[\\s\\S]*?'\\{![\\s\\S]*?CurrentPage\\.parameters\\.(?P<URL_PARAM>\\S+)\\}'[\\s\\S]*?<\\/script>"])
          | not_at($all | of(["<script>[\\s\\S]*?'\\{![\\s\\S]*?JSENCODE\\([\\s\\S]*?CurrentPage\\.parameters\\.(?P<URL_PARAM>\\S+)\\}\\)'[\\s\\S]*?<\\/script>"]))
        | finding("xss-from-unescaped-url-param";
            "To remediate this issue, ensure that all URL parameters are properly escaped before including them in scripts.") ) )
| report
