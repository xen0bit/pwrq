# rules: csp-header-attribute
# from: generic/visualforce/security/ncino/xml/CSPHeaderAttribute.yaml

. as $root
| ( ($root | scan_regex(["*.page"]; [
      "<apex:page[\\s\\S]*?>[\\s\\S]*?<!\\-\\-\\s+deprecated\\s+\\-\\->[\\s\\S]*?<\\/apex:page>",
      "<apex:page[\\s\\S]*?>[\\s\\S]*?<!\\-\\-deprecated\\-\\->[\\s\\S]*?<\\/apex:page>",
      "<apex:page[\\s\\S]*?>[\\s\\S]*?<\\/apex:page>",
      "<apex:page[\\s\\S]*?cspHeader=\"true\"[\\s\\S]*?>[\\s\\S]*?<\\/apex:page>"
    ])) as $all
    | ( $all | of(["<apex:page[\\s\\S]*?>[\\s\\S]*?<\\/apex:page>"])
          | not_at($all | of(["<apex:page[\\s\\S]*?cspHeader=\"true\"[\\s\\S]*?>[\\s\\S]*?<\\/apex:page>"]))
          | not_at($all | of(["<apex:page[\\s\\S]*?>[\\s\\S]*?<!\\-\\-deprecated\\-\\->[\\s\\S]*?<\\/apex:page>"]))
          | not_at($all | of(["<apex:page[\\s\\S]*?>[\\s\\S]*?<!\\-\\-\\s+deprecated\\s+\\-\\->[\\s\\S]*?<\\/apex:page>"]))
        | finding("csp-header-attribute";
            "Visualforce Pages must have the cspHeader attribute set to true.") ) )
| report
