# rules: missing-internal
# from: generic/nginx/security/missing-internal.yaml

. as $root
| ( ($root | scan_regex(["*.conf","*.vhost","sites-available/*","sites-enabled/*"]; [
      "location\\s+[\\s\\S]*?\\s+\\{\\s+[\\s\\S]*?\\.\\s+[\\s\\S]*?\\.\\s+\\}",
      "location\\s+[\\s\\S]*?\\s+\\{\\s+[\\s\\S]*?\\.\\s+internal;\\s+[\\s\\S]*?\\.\\s+\\}",
      "proxy_pass\\s+(?P<URL>[\\s\\S]*?);"
    ])) as $all
    | ( $all | of(["proxy_pass\\s+(?P<URL>[\\s\\S]*?);"])
          | within($all | of(["location\\s+[\\s\\S]*?\\s+\\{\\s+[\\s\\S]*?\\.\\s+[\\s\\S]*?\\.\\s+\\}"]))
          | outside($all | of(["location\\s+[\\s\\S]*?\\s+\\{\\s+[\\s\\S]*?\\.\\s+internal;\\s+[\\s\\S]*?\\.\\s+\\}"]))
          | where_capture("URL"; "^(?:(.*\\$.*))")
        | finding("missing-internal";
            "This location block contains a 'proxy_pass' directive but does not contain the 'internal' directive.") ) )
| report
