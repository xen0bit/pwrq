# rules: dynamic-proxy-scheme
# from: generic/nginx/security/dynamic-proxy-scheme.yaml

. as $root
| ( ($root | scan_regex(["*.conf","*.vhost","sites-available/*","sites-enabled/*"]; [
      "proxy_pass\\s+\\$(?P<SCHEME>\\S+):\\/\\/\\s+[\\s\\S]*?;"
    ])) as $all
    | ( $all | of(["proxy_pass\\s+\\$(?P<SCHEME>\\S+):\\/\\/\\s+[\\s\\S]*?;"])
        | finding("dynamic-proxy-scheme";
            "The protocol scheme for this proxy is dynamically determined.") ) )
| report
