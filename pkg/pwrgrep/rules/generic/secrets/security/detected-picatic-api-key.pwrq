# rules: detected-picatic-api-key
# from: generic/secrets/security/detected-picatic-api-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "sk_live_[0-9a-z]{32}"
    ])) as $all
    | ( $all | of(["sk_live_[0-9a-z]{32}"])
        | finding("detected-picatic-api-key";
            "Picatic API Key detected") ) )
| report
