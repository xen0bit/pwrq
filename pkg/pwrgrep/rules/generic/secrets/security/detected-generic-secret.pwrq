# rules: detected-generic-secret
# from: generic/secrets/security/detected-generic-secret.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "[sS][eE][cC][rR][eE][tT][:= \\t]*['|\\\"]?(?<SECRET>[0-9a-zA-Z]{32,45})['|\\\"]?"
    ])) as $all
    | ( $all | of(["[sS][eE][cC][rR][eE][tT][:= \\t]*['|\\\"]?(?<SECRET>[0-9a-zA-Z]{32,45})['|\\\"]?"])
          | where_capture_entropy("SECRET")
        | finding("detected-generic-secret";
            "Generic Secret detected") ) )
| report
