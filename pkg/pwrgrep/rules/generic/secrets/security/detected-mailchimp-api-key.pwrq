# rules: detected-mailchimp-api-key
# from: generic/secrets/security/detected-mailchimp-api-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "[0-9a-f]{32}-us[0-9]{1,2}"
    ])) as $all
    | ( $all | of(["[0-9a-f]{32}-us[0-9]{1,2}"])
        | finding("detected-mailchimp-api-key";
            "MailChimp API Key detected") ) )
| report
