# rules: detected-etc-shadow
# from: generic/secrets/security/detected-etc-shadow.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "^(\\s*)(?P<ROOT>root:[x!*]*:[0-9]*:[0-9]*)"
    ])) as $all
    | ( $all | of(["^(\\s*)(?P<ROOT>root:[x!*]*:[0-9]*:[0-9]*)"])
          | focus("ROOT")
        | finding("detected-etc-shadow";
            "linux shadow file detected") ) )
| report
