# rules: detected-ssh-password
# from: generic/secrets/security/detected-ssh-password.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "sshpass -p\\s*['|\\\\\\\"][^%]"
    ])) as $all
    | ( $all | of(["sshpass -p\\s*['|\\\\\\\"][^%]"])
        | finding("detected-ssh-password";
            "SSH Password detected") ) )
| report
