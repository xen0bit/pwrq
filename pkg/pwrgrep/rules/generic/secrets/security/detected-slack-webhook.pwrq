# rules: detected-slack-webhook
# from: generic/secrets/security/detected-slack-webhook.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "https://hooks.slack.com/services/T0000000[0]/B0000000[0]/XXXXXXXXXXXXXXXXXXXXXXX[X]",
      "https://hooks\\.slack\\.com/services/T[a-zA-Z0-9_]{8,10}/B[a-zA-Z0-9_]{8,10}/[a-zA-Z0-9_]{24}"
    ])) as $all
    | ( $all | of(["https://hooks\\.slack\\.com/services/T[a-zA-Z0-9_]{8,10}/B[a-zA-Z0-9_]{8,10}/[a-zA-Z0-9_]{24}"])
          | not_at($all | of(["https://hooks.slack.com/services/T0000000[0]/B0000000[0]/XXXXXXXXXXXXXXXXXXXXXXX[X]"]))
        | finding("detected-slack-webhook";
            "Slack Webhook detected") ) )
| report
