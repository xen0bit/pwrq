# rules: detected-pgp-private-key-block
# from: generic/secrets/security/detected-pgp-private-key-block.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "-----BEGIN PGP PRIVATE KEY BLOCK-----"
    ])) as $all
    | ( $all | of(["-----BEGIN PGP PRIVATE KEY BLOCK-----"])
        | finding("detected-pgp-private-key-block";
            "Something that looks like a PGP private key block is detected.") ) )
| report
