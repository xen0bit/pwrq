# rules: detected-square-oauth-secret
# from: generic/secrets/security/detected-square-oauth-secret.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "sq0csp-[0-9A-Za-z\\\\\\-_]{43}"
    ])) as $all
    | ( $all | of(["sq0csp-[0-9A-Za-z\\\\\\-_]{43}"])
        | finding("detected-square-oauth-secret";
            "Square OAuth Secret detected") ) )
| report
