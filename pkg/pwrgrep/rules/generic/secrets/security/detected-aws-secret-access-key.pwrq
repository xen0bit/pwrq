# rules: detected-aws-secret-access-key
# from: generic/secrets/security/detected-aws-secret-access-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "((\"|'|`)?((?i)aws)_?\\w*((?i)secret)_?\\w*(\"|'|`)?\\s{0,50}(:|=>|=)\\s{0,50}(\"|'|`)?[A-Za-z0-9/+=]{40}(\"|'|`)?)",
      "(?i)example|sample|test|fake|xxxxxx"
    ])) as $all
    | ( $all | of(["((\"|'|`)?((?i)aws)_?\\w*((?i)secret)_?\\w*(\"|'|`)?\\s{0,50}(:|=>|=)\\s{0,50}(\"|'|`)?[A-Za-z0-9/+=]{40}(\"|'|`)?)"])
          | not_at($all | of(["(?i)example|sample|test|fake|xxxxxx"]))
        | finding("detected-aws-secret-access-key";
            "AWS Secret Access Key detected") ) )
| report
