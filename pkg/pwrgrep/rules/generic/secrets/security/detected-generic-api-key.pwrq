# rules: detected-generic-api-key
# from: generic/secrets/security/detected-generic-api-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "[aA][pP][iI]_?[kK][eE][yY][=_:\\s-]+['|\"]?(?<SECRET>[0-9a-zA-Z]{32,45})['|\"]?"
    ])) as $all
    | ( $all | of(["[aA][pP][iI]_?[kK][eE][yY][=_:\\s-]+['|\"]?(?<SECRET>[0-9a-zA-Z]{32,45})['|\"]?"])
          | where_capture_entropy("SECRET")
        | finding("detected-generic-api-key";
            "Generic API Key detected") ) )
| report
