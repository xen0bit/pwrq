# rules: detected-npm-registry-auth-token
# from: generic/secrets/security/detected-npm-registry-auth-token.yaml

. as $root
| ( ($root | scan_regex(["*npmrc*"]; [
      "(?P<AUTHTOKEN>\\S+)\\s+=\\s+(?P<VALUE>\\S+)",
      "(?P<AUTHTOKEN>\\S+)\\s+=\\s+\\$\\{[\\s\\S]*?\\}"
    ])) as $all
    | ( $all | of(["(?P<AUTHTOKEN>\\S+)\\s+=\\s+(?P<VALUE>\\S+)"])
          | where_capture("AUTHTOKEN"; "^(?:_(authToken|auth|password))")
          | not_at($all | of(["(?P<AUTHTOKEN>\\S+)\\s+=\\s+\\$\\{[\\s\\S]*?\\}"]))
        | finding("detected-npm-registry-auth-token";
            "NPM registry authentication token detected") ) )
| report
