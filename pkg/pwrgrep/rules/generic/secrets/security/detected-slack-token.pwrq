# rules: detected-slack-token
# from: generic/secrets/security/detected-slack-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(xox[pboa]-[0-9]{12}-[0-9]{12}-[0-9]{12}-[a-z0-9]{32})",
      "xox.-[0-9]{12}-[0-9]{12}-[0-9a-zA-Z]{24}"
    ])) as $all
    | ( $all | of(["(xox[pboa]-[0-9]{12}-[0-9]{12}-[0-9]{12}-[a-z0-9]{32})","xox.-[0-9]{12}-[0-9]{12}-[0-9a-zA-Z]{24}"])
        | finding("detected-slack-token";
            "Slack Token detected") ) )
| report
