# rules: detected-google-api-key
# from: generic/secrets/security/detected-google-api-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "\\bAIzaSy[0-9A-Za-z-_]{33}\\b",
      "\\bAIzaSy[0-9A-Za-z-_]{33}\\b[=]"
    ])) as $all
    | ( $all | of(["\\bAIzaSy[0-9A-Za-z-_]{33}\\b"])
          | not_at($all | of(["\\bAIzaSy[0-9A-Za-z-_]{33}\\b[=]"]))
        | finding("detected-google-api-key";
            "Google API Key Detected") ) )
| report
