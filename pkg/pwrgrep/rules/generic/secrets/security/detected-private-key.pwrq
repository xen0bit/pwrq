# rules: detected-private-key
# from: generic/secrets/security/detected-private-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "\\-\\-\\-\\-\\-BEGIN\\s+(?P<TYPE>\\S+)\\s+PRIVATE\\s+KEY\\-\\-\\-\\-\\-\\s+(?P<KEY>\\S+)",
      "\\-\\-\\-\\-\\-BEGIN\\s+PRIVATE\\s+KEY\\-\\-\\-\\-\\-\\s+(?P<KEY>\\S+)"
    ])) as $all
    | ( ($all | of(["\\-\\-\\-\\-\\-BEGIN\\s+(?P<TYPE>\\S+)\\s+PRIVATE\\s+KEY\\-\\-\\-\\-\\-\\s+(?P<KEY>\\S+)"])
          | where_capture("TYPE"; "^(?:(?i)([dr]sa|ec|openssh|encrypted)?)"))
          + ($all | of(["\\-\\-\\-\\-\\-BEGIN\\s+PRIVATE\\s+KEY\\-\\-\\-\\-\\-\\s+(?P<KEY>\\S+)"]))
          | where_capture_entropy("KEY")
        | finding("detected-private-key";
            "Private Key detected.") ) )
| report
