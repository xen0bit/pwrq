# rules: detected-google-cloud-api-key
# from: generic/secrets/security/detected-google-cloud-api-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "AIza[0-9A-Za-z\\\\-_]{35}"
    ])) as $all
    | ( $all | of(["AIza[0-9A-Za-z\\\\-_]{35}"])
        | finding("detected-google-cloud-api-key";
            "Google Cloud API Key detected") ) )
| report
