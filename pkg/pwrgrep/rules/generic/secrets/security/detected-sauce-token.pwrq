# rules: detected-sauce-token
# from: generic/secrets/security/detected-sauce-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)sauce.{0,50}(\\\\\\\"|'|`)?[0-9a-f-]{36}(\\\\\\\"|'|`)?"
    ])) as $all
    | ( $all | of(["(?i)sauce.{0,50}(\\\\\\\"|'|`)?[0-9a-f-]{36}(\\\\\\\"|'|`)?"])
        | finding("detected-sauce-token";
            "Sauce Token detected") ) )
| report
