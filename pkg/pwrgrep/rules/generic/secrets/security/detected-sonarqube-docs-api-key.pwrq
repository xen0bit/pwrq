# rules: detected-sonarqube-docs-api-key
# from: generic/secrets/security/detected-sonarqube-docs-api-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)sonar.{0,50}(\\\\\\\"|'|`)?[0-9a-f]{40}(\\\\\\\"|'|`)?"
    ])) as $all
    | ( $all | of(["(?i)sonar.{0,50}(\\\\\\\"|'|`)?[0-9a-f]{40}(\\\\\\\"|'|`)?"])
        | finding("detected-sonarqube-docs-api-key";
            "SonarQube Docs API Key detected") ) )
| report
