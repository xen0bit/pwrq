# rules: detected-kolide-api-key
# from: generic/secrets/security/detected-kolide-api-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "k2sk_v[0-9]_[0-9a-zA-Z]{24}"
    ])) as $all
    | ( $all | of(["k2sk_v[0-9]_[0-9a-zA-Z]{24}"])
        | finding("detected-kolide-api-key";
            "Kolide API Key detected") ) )
| report
