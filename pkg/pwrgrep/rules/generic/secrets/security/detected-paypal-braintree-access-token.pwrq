# rules: detected-paypal-braintree-access-token
# from: generic/secrets/security/detected-paypal-braintree-access-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "access_token\\$production\\$[0-9a-z]{16}\\$[0-9a-z]{32}"
    ])) as $all
    | ( $all | of(["access_token\\$production\\$[0-9a-z]{16}\\$[0-9a-z]{32}"])
        | finding("detected-paypal-braintree-access-token";
            "PayPal Braintree Access Token detected") ) )
| report
