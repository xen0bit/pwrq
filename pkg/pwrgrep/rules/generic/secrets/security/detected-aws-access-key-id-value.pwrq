# rules: detected-aws-access-key-id-value
# from: generic/secrets/security/detected-aws-access-key-id-value.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)example|sample|test|fake",
      "\\b(A3T[A-Z0-9]|AKIA|AGPA|AROA|AIPA|ANPA|ANVA|ASIA)[A-Z0-9]{16}\\b"
    ])) as $all
    | ( $all | of(["\\b(A3T[A-Z0-9]|AKIA|AGPA|AROA|AIPA|ANPA|ANVA|ASIA)[A-Z0-9]{16}\\b"])
          | not_at($all | of(["(?i)example|sample|test|fake"]))
        | finding("detected-aws-access-key-id-value";
            "AWS Access Key ID Value detected.") ) )
| report
