# rules: detected-outlook-team
# from: generic/secrets/security/detected-outlook-team.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "https://outlook\\.office\\.com/webhook/[0-9a-f-]{36}"
    ])) as $all
    | ( $all | of(["https://outlook\\.office\\.com/webhook/[0-9a-f-]{36}"])
        | finding("detected-outlook-team";
            "Outlook Team detected") ) )
| report
