# rules: detected-facebook-access-token
# from: generic/secrets/security/detected-facebook-access-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "EAAAACZAVC6ygB[0-9A-Za-z]+",
      "EAAAAZAw4[0-9A-Za-z]+",
      "EAACEdEose0cBA[0-9A-Za-z]+"
    ])) as $all
    | ( $all | of(["EAACEdEose0cBA[0-9A-Za-z]+","EAAAACZAVC6ygB[0-9A-Za-z]+","EAAAAZAw4[0-9A-Za-z]+"])
        | finding("detected-facebook-access-token";
            "Facebook Access Token detected") ) )
| report
