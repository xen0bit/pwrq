# rules: detected-softlayer-api-key
# from: generic/secrets/security/detected-softlayer-api-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)softlayer.{0,50}[\"|'|`]?[a-z0-9]{64}[\"|'|`]?"
    ])) as $all
    | ( $all | of(["(?i)softlayer.{0,50}[\"|'|`]?[a-z0-9]{64}[\"|'|`]?"])
        | finding("detected-softlayer-api-key";
            "SoftLayer API Key detected") ) )
| report
