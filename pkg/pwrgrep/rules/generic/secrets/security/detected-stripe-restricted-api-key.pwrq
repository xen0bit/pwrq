# rules: detected-stripe-restricted-api-key
# from: generic/secrets/security/detected-stripe-restricted-api-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "rk_live_[0-9a-zA-Z]{24}"
    ])) as $all
    | ( $all | of(["rk_live_[0-9a-zA-Z]{24}"])
        | finding("detected-stripe-restricted-api-key";
            "Stripe Restricted API Key detected") ) )
| report
