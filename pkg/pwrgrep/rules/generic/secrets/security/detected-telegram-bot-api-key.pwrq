# rules: detected-telegram-bot-api-key
# from: generic/secrets/security/detected-telegram-bot-api-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "[0-9]+:AA[0-9A-Za-z\\-_]{33}",
      "go\\.mod.*",
      "v[\\d]+\\.[\\d]+\\.[\\d]+.*"
    ])) as $all
    | ( $all | of(["[0-9]+:AA[0-9A-Za-z\\-_]{33}"])
          | not_at($all | of(["go\\.mod.*"]))
          | not_at($all | of(["v[\\d]+\\.[\\d]+\\.[\\d]+.*"]))
        | finding("detected-telegram-bot-api-key";
            "Telegram Bot API Key detected") ) )
| report
