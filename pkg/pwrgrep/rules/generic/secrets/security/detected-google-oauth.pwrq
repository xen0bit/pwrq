# rules: detected-google-oauth-url
# from: generic/secrets/security/detected-google-oauth.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "[0-9]+-[0-9A-Za-z_]{32}\\.apps\\.googleusercontent\\.com"
    ])) as $all
    | ( $all | of(["[0-9]+-[0-9A-Za-z_]{32}\\.apps\\.googleusercontent\\.com"])
        | finding("detected-google-oauth-url";
            "Google OAuth url detected") ) )
| report
