# rules: detected-square-access-token
# from: generic/secrets/security/detected-square-access-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "sq0atp-[0-9A-Za-z\\-_]{22}"
    ])) as $all
    | ( $all | of(["sq0atp-[0-9A-Za-z\\-_]{22}"])
        | finding("detected-square-access-token";
            "Square Access Token detected") ) )
| report
