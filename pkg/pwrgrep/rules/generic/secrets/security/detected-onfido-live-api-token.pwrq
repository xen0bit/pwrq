# rules: detected-onfido-live-api-token
# from: generic/secrets/security/detected-onfido-live-api-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?:api_live(?:_[a-zA-Z]{2})?\\.[a-zA-Z0-9-_]{11}\\.[-_a-zA-Z0-9]{32})"
    ])) as $all
    | ( $all | of(["(?:api_live(?:_[a-zA-Z]{2})?\\.[a-zA-Z0-9-_]{11}\\.[-_a-zA-Z0-9]{32})"])
        | finding("detected-onfido-live-api-token";
            "Onfido live API Token detected") ) )
| report
