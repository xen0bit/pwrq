# rules: detected-bcrypt-hash
# from: generic/secrets/security/detected-bcrypt-hash.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "\\$2[aby]?\\$[\\d]+\\$[./A-Za-z0-9]{53}"
    ])) as $all
    | ( $all | of(["\\$2[aby]?\\$[\\d]+\\$[./A-Za-z0-9]{53}"])
        | finding("detected-bcrypt-hash";
            "bcrypt hash detected") ) )
| report
