# rules: linear-api-key
# from: generic/secrets/gitleaks/linear-api-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "lin_api_(?i)[a-z0-9]{40}"
    ])) as $all
    | ( $all | of(["lin_api_(?i)[a-z0-9]{40}"])
        | finding("linear-api-key";
            "A gitleaks linear-api-key was detected which attempts to identify hard-coded credentials.") ) )
| report
