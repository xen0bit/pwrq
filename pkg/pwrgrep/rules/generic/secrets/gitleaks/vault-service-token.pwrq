# rules: vault-service-token
# from: generic/secrets/gitleaks/vault-service-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b(hvs\\.[a-z0-9_-]{90,100})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b(hvs\\.[a-z0-9_-]{90,100})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("vault-service-token";
            "A gitleaks vault-service-token was detected which attempts to identify hard-coded credentials.") ) )
| report
