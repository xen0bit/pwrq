# rules: adobe-client-secret
# from: generic/secrets/gitleaks/adobe-client-secret.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b((p8e-)(?i)[a-z0-9]{32})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b((p8e-)(?i)[a-z0-9]{32})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("adobe-client-secret";
            "A gitleaks adobe-client-secret was detected which attempts to identify hard-coded credentials.") ) )
| report
