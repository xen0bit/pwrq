# rules: cloudflare-origin-ca-key
# from: generic/secrets/gitleaks/cloudflare-origin-ca-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "\\b(v1\\.0-[a-f0-9]{24}-[a-f0-9]{146})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["\\b(v1\\.0-[a-f0-9]{24}-[a-f0-9]{146})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("cloudflare-origin-ca-key";
            "A gitleaks cloudflare-origin-ca-key was detected which attempts to identify hard-coded credentials.") ) )
| report
