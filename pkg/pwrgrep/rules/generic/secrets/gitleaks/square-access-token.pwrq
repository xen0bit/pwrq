# rules: square-access-token
# from: generic/secrets/gitleaks/square-access-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b((EAAA|sq0atp-)[0-9A-Za-z\\-_]{22,60})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b((EAAA|sq0atp-)[0-9A-Za-z\\-_]{22,60})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("square-access-token";
            "A gitleaks square-access-token was detected which attempts to identify hard-coded credentials.") ) )
| report
