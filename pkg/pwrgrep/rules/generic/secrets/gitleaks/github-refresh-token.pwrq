# rules: github-refresh-token
# from: generic/secrets/gitleaks/github-refresh-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "ghr_[0-9a-zA-Z]{36}"
    ])) as $all
    | ( $all | of(["ghr_[0-9a-zA-Z]{36}"])
        | finding("github-refresh-token";
            "A gitleaks github-refresh-token was detected which attempts to identify hard-coded credentials.") ) )
| report
