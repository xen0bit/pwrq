# rules: digitalocean-access-token
# from: generic/secrets/gitleaks/digitalocean-access-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b(doo_v1_[a-f0-9]{64})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b(doo_v1_[a-f0-9]{64})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("digitalocean-access-token";
            "A gitleaks digitalocean-access-token was detected which attempts to identify hard-coded credentials.") ) )
| report
