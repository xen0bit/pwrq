# rules: scalingo-api-token
# from: generic/secrets/gitleaks/scalingo-api-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "\\b(tk-us-[a-zA-Z0-9-_]{48})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["\\b(tk-us-[a-zA-Z0-9-_]{48})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("scalingo-api-token";
            "A gitleaks scalingo-api-token was detected which attempts to identify hard-coded credentials.") ) )
| report
