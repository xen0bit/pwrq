# rules: huggingface-organization-api-token
# from: generic/secrets/gitleaks/huggingface-organization-api-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?:^|[\\\\'\"` >=:\\(,)])(api_org_[a-zA-Z]{34})(?:$|[\\\\'\"` <\\),])"
    ])) as $all
    | ( $all | of(["(?:^|[\\\\'\"` >=:\\(,)])(api_org_[a-zA-Z]{34})(?:$|[\\\\'\"` <\\),])"])
        | finding("huggingface-organization-api-token";
            "A gitleaks huggingface-organization-api-token was detected which attempts to identify hard-coded credentials.") ) )
| report
