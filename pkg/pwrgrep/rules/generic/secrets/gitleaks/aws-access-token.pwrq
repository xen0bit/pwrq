# rules: aws-access-token
# from: generic/secrets/gitleaks/aws-access-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?:A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z0-9]{16}"
    ])) as $all
    | ( $all | of(["(?:A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z0-9]{16}"])
        | finding("aws-access-token";
            "A gitleaks aws-access-token was detected which attempts to identify hard-coded credentials.") ) )
| report
