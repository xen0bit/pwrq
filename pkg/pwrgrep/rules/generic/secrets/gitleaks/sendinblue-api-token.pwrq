# rules: sendinblue-api-token
# from: generic/secrets/gitleaks/sendinblue-api-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b(xkeysib-[a-f0-9]{64}\\-(?i)[a-z0-9]{16})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b(xkeysib-[a-f0-9]{64}\\-(?i)[a-z0-9]{16})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("sendinblue-api-token";
            "A gitleaks sendinblue-api-token was detected which attempts to identify hard-coded credentials.") ) )
| report
