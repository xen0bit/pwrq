# rules: prefect-api-token
# from: generic/secrets/gitleaks/prefect-api-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b(pnu_[a-z0-9]{36})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b(pnu_[a-z0-9]{36})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("prefect-api-token";
            "A gitleaks prefect-api-token was detected which attempts to identify hard-coded credentials.") ) )
| report
