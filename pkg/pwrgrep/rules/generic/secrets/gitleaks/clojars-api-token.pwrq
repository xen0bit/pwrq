# rules: clojars-api-token
# from: generic/secrets/gitleaks/clojars-api-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)(CLOJARS_)[a-z0-9]{60}"
    ])) as $all
    | ( $all | of(["(?i)(CLOJARS_)[a-z0-9]{60}"])
        | finding("clojars-api-token";
            "A gitleaks clojars-api-token was detected which attempts to identify hard-coded credentials.") ) )
| report
