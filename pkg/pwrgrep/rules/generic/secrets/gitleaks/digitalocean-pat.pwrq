# rules: digitalocean-pat
# from: generic/secrets/gitleaks/digitalocean-pat.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b(dop_v1_[a-f0-9]{64})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b(dop_v1_[a-f0-9]{64})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("digitalocean-pat";
            "A gitleaks digitalocean-pat was detected which attempts to identify hard-coded credentials.") ) )
| report
