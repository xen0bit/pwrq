# rules: dynatrace-api-token
# from: generic/secrets/gitleaks/dynatrace-api-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "dt0c01\\.(?i)[a-z0-9]{24}\\.[a-z0-9]{64}"
    ])) as $all
    | ( $all | of(["dt0c01\\.(?i)[a-z0-9]{24}\\.[a-z0-9]{64}"])
        | finding("dynatrace-api-token";
            "A gitleaks dynatrace-api-token was detected which attempts to identify hard-coded credentials.") ) )
| report
