# rules: sendgrid-api-token
# from: generic/secrets/gitleaks/sendgrid-api-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b(SG\\.(?i)[a-z0-9=_\\-\\.]{66})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b(SG\\.(?i)[a-z0-9=_\\-\\.]{66})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("sendgrid-api-token";
            "A gitleaks sendgrid-api-token was detected which attempts to identify hard-coded credentials.") ) )
| report
