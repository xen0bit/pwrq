# rules: github-pat
# from: generic/secrets/gitleaks/github-pat.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "ghp_[0-9a-zA-Z]{36}"
    ])) as $all
    | ( $all | of(["ghp_[0-9a-zA-Z]{36}"])
        | finding("github-pat";
            "A gitleaks github-pat was detected which attempts to identify hard-coded credentials.") ) )
| report
