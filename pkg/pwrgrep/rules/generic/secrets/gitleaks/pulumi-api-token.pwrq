# rules: pulumi-api-token
# from: generic/secrets/gitleaks/pulumi-api-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b(pul-[a-f0-9]{40})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b(pul-[a-f0-9]{40})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("pulumi-api-token";
            "A gitleaks pulumi-api-token was detected which attempts to identify hard-coded credentials.") ) )
| report
