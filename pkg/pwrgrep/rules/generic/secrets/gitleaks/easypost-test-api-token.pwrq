# rules: easypost-test-api-token
# from: generic/secrets/gitleaks/easypost-test-api-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "\\bEZTK(?i)[a-z0-9]{54}"
    ])) as $all
    | ( $all | of(["\\bEZTK(?i)[a-z0-9]{54}"])
        | finding("easypost-test-api-token";
            "A gitleaks easypost-test-api-token was detected which attempts to identify hard-coded credentials.") ) )
| report
