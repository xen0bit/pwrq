# rules: flutterwave-secret-key
# from: generic/secrets/gitleaks/flutterwave-secret-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "FLWSECK_TEST-(?i)[a-h0-9]{32}-X"
    ])) as $all
    | ( $all | of(["FLWSECK_TEST-(?i)[a-h0-9]{32}-X"])
        | finding("flutterwave-secret-key";
            "A gitleaks flutterwave-secret-key was detected which attempts to identify hard-coded credentials.") ) )
| report
