# rules: facebook-access-token
# from: generic/secrets/gitleaks/facebook-access-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b(\\d{15,16}(\\||%)[0-9a-z\\-_]{27,40})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b(\\d{15,16}(\\||%)[0-9a-z\\-_]{27,40})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("facebook-access-token";
            "A gitleaks facebook-access-token was detected which attempts to identify hard-coded credentials.") ) )
| report
