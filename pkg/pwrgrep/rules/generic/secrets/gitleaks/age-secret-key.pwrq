# rules: age-secret-key
# from: generic/secrets/gitleaks/age-secret-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "AGE-SECRET-KEY-1[QPZRY9X8GF2TVDW0S3JN54KHCE6MUA7L]{58}"
    ])) as $all
    | ( $all | of(["AGE-SECRET-KEY-1[QPZRY9X8GF2TVDW0S3JN54KHCE6MUA7L]{58}"])
        | finding("age-secret-key";
            "A gitleaks age-secret-key was detected which attempts to identify hard-coded credentials.") ) )
| report
