# rules: duffel-api-token
# from: generic/secrets/gitleaks/duffel-api-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "duffel_(test|live)_(?i)[a-z0-9_\\-=]{43}"
    ])) as $all
    | ( $all | of(["duffel_(test|live)_(?i)[a-z0-9_\\-=]{43}"])
        | finding("duffel-api-token";
            "A gitleaks duffel-api-token was detected which attempts to identify hard-coded credentials.") ) )
| report
