# rules: slack-user-token
# from: generic/secrets/gitleaks/slack-user-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(xox[pe](?:-[0-9]{10,13}){3}-[a-zA-Z0-9-]{28,34})"
    ])) as $all
    | ( $all | of(["(xox[pe](?:-[0-9]{10,13}){3}-[a-zA-Z0-9-]{28,34})"])
        | finding("slack-user-token";
            "A gitleaks slack-user-token was detected which attempts to identify hard-coded credentials.") ) )
| report
