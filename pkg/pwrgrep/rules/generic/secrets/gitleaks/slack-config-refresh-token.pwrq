# rules: slack-config-refresh-token
# from: generic/secrets/gitleaks/slack-config-refresh-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)(xoxe-\\d-[A-Z0-9]{146})"
    ])) as $all
    | ( $all | of(["(?i)(xoxe-\\d-[A-Z0-9]{146})"])
        | finding("slack-config-refresh-token";
            "A gitleaks slack-config-refresh-token was detected which attempts to identify hard-coded credentials.") ) )
| report
