# rules: slack-bot-token
# from: generic/secrets/gitleaks/slack-bot-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(xoxb-[0-9]{10,13}\\-[0-9]{10,13}[a-zA-Z0-9-]*)"
    ])) as $all
    | ( $all | of(["(xoxb-[0-9]{10,13}\\-[0-9]{10,13}[a-zA-Z0-9-]*)"])
        | finding("slack-bot-token";
            "A gitleaks slack-bot-token was detected which attempts to identify hard-coded credentials.") ) )
| report
