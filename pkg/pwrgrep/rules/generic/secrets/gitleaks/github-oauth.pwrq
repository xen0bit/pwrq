# rules: github-oauth
# from: generic/secrets/gitleaks/github-oauth.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "gho_[0-9a-zA-Z]{36}"
    ])) as $all
    | ( $all | of(["gho_[0-9a-zA-Z]{36}"])
        | finding("github-oauth";
            "A gitleaks github-oauth was detected which attempts to identify hard-coded credentials.") ) )
| report
