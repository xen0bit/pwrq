# rules: gcp-api-key
# from: generic/secrets/gitleaks/gcp-api-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b(AIza[0-9A-Za-z\\\\-_]{35})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b(AIza[0-9A-Za-z\\\\-_]{35})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("gcp-api-key";
            "A gitleaks gcp-api-key was detected which attempts to identify hard-coded credentials.") ) )
| report
