# rules: flutterwave-public-key
# from: generic/secrets/gitleaks/flutterwave-public-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "FLWPUBK_TEST-(?i)[a-h0-9]{32}-X"
    ])) as $all
    | ( $all | of(["FLWPUBK_TEST-(?i)[a-h0-9]{32}-X"])
        | finding("flutterwave-public-key";
            "A gitleaks flutterwave-public-key was detected which attempts to identify hard-coded credentials.") ) )
| report
