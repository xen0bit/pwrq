# rules: grafana-api-key
# from: generic/secrets/gitleaks/grafana-api-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b(eyJrIjoi[A-Za-z0-9]{70,400}={0,2})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b(eyJrIjoi[A-Za-z0-9]{70,400}={0,2})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("grafana-api-key";
            "A gitleaks grafana-api-key was detected which attempts to identify hard-coded credentials.") ) )
| report
