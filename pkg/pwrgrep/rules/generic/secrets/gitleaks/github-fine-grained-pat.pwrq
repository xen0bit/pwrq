# rules: github-fine-grained-pat
# from: generic/secrets/gitleaks/github-fine-grained-pat.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "github_pat_[0-9a-zA-Z_]{82}"
    ])) as $all
    | ( $all | of(["github_pat_[0-9a-zA-Z_]{82}"])
        | finding("github-fine-grained-pat";
            "A gitleaks github-fine-grained-pat was detected which attempts to identify hard-coded credentials.") ) )
| report
