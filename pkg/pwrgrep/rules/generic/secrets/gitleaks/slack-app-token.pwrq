# rules: slack-app-token
# from: generic/secrets/gitleaks/slack-app-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)(xapp-\\d-[A-Z0-9]+-\\d+-[a-z0-9]+)"
    ])) as $all
    | ( $all | of(["(?i)(xapp-\\d-[A-Z0-9]+-\\d+-[a-z0-9]+)"])
        | finding("slack-app-token";
            "A gitleaks slack-app-token was detected which attempts to identify hard-coded credentials.") ) )
| report
