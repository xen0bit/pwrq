# rules: hashicorp-tf-api-token
# from: generic/secrets/gitleaks/hashicorp-tf-api-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)[a-z0-9]{14}\\.atlasv1\\.[a-z0-9\\-_=]{60,70}"
    ])) as $all
    | ( $all | of(["(?i)[a-z0-9]{14}\\.atlasv1\\.[a-z0-9\\-_=]{60,70}"])
        | finding("hashicorp-tf-api-token";
            "A gitleaks hashicorp-tf-api-token was detected which attempts to identify hard-coded credentials.") ) )
| report
