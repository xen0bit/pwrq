# rules: rubygems-api-token
# from: generic/secrets/gitleaks/rubygems-api-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b(rubygems_[a-f0-9]{48})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b(rubygems_[a-f0-9]{48})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("rubygems-api-token";
            "A gitleaks rubygems-api-token was detected which attempts to identify hard-coded credentials.") ) )
| report
