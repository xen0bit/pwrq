# rules: slack-webhook-url
# from: generic/secrets/gitleaks/slack-webhook-url.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(https?:\\/\\/)?hooks.slack.com\\/(services|workflows)\\/[A-Za-z0-9+\\/]{43,46}"
    ])) as $all
    | ( $all | of(["(https?:\\/\\/)?hooks.slack.com\\/(services|workflows)\\/[A-Za-z0-9+\\/]{43,46}"])
        | finding("slack-webhook-url";
            "A gitleaks slack-webhook-url was detected which attempts to identify hard-coded credentials.") ) )
| report
