# rules: doppler-api-token
# from: generic/secrets/gitleaks/doppler-api-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(dp\\.pt\\.)(?i)[a-z0-9]{43}"
    ])) as $all
    | ( $all | of(["(dp\\.pt\\.)(?i)[a-z0-9]{43}"])
        | finding("doppler-api-token";
            "A gitleaks doppler-api-token was detected which attempts to identify hard-coded credentials.") ) )
| report
