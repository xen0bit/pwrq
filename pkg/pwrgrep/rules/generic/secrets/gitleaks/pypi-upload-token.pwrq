# rules: pypi-upload-token
# from: generic/secrets/gitleaks/pypi-upload-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "pypi-AgEIcHlwaS5vcmc[A-Za-z0-9\\-_]{50,1000}"
    ])) as $all
    | ( $all | of(["pypi-AgEIcHlwaS5vcmc[A-Za-z0-9\\-_]{50,1000}"])
        | finding("pypi-upload-token";
            "A gitleaks pypi-upload-token was detected which attempts to identify hard-coded credentials.") ) )
| report
