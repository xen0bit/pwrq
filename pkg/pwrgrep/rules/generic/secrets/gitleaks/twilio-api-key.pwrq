# rules: twilio-api-key
# from: generic/secrets/gitleaks/twilio-api-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "SK[0-9a-fA-F]{32}"
    ])) as $all
    | ( $all | of(["SK[0-9a-fA-F]{32}"])
        | finding("twilio-api-key";
            "A gitleaks twilio-api-key was detected which attempts to identify hard-coded credentials.") ) )
| report
