# rules: planetscale-password
# from: generic/secrets/gitleaks/planetscale-password.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b(pscale_pw_(?i)[a-z0-9=\\-_\\.]{32,64})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b(pscale_pw_(?i)[a-z0-9=\\-_\\.]{32,64})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("planetscale-password";
            "A gitleaks planetscale-password was detected which attempts to identify hard-coded credentials.") ) )
| report
