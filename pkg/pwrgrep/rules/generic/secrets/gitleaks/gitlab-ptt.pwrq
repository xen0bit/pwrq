# rules: gitlab-ptt
# from: generic/secrets/gitleaks/gitlab-ptt.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "glptt-[0-9a-f]{40}"
    ])) as $all
    | ( $all | of(["glptt-[0-9a-f]{40}"])
        | finding("gitlab-ptt";
            "A gitleaks gitlab-ptt was detected which attempts to identify hard-coded credentials.") ) )
| report
