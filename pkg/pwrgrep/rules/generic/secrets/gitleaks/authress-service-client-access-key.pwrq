# rules: authress-service-client-access-key
# from: generic/secrets/gitleaks/authress-service-client-access-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b((?:sc|ext|scauth|authress)_[a-z0-9]{5,30}\\.[a-z0-9]{4,6}\\.acc[_-][a-z0-9-]{10,32}\\.[a-z0-9+/_=-]{30,120})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b((?:sc|ext|scauth|authress)_[a-z0-9]{5,30}\\.[a-z0-9]{4,6}\\.acc[_-][a-z0-9-]{10,32}\\.[a-z0-9+/_=-]{30,120})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("authress-service-client-access-key";
            "A gitleaks authress-service-client-access-key was detected which attempts to identify hard-coded credentials.") ) )
| report
