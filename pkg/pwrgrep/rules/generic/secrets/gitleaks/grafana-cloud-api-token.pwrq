# rules: grafana-cloud-api-token
# from: generic/secrets/gitleaks/grafana-cloud-api-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b(glc_[A-Za-z0-9+/]{32,400}={0,2})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b(glc_[A-Za-z0-9+/]{32,400}={0,2})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("grafana-cloud-api-token";
            "A gitleaks grafana-cloud-api-token was detected which attempts to identify hard-coded credentials.") ) )
| report
