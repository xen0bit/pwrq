# rules: shopify-shared-secret
# from: generic/secrets/gitleaks/shopify-shared-secret.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "shpss_[a-fA-F0-9]{32}"
    ])) as $all
    | ( $all | of(["shpss_[a-fA-F0-9]{32}"])
        | finding("shopify-shared-secret";
            "A gitleaks shopify-shared-secret was detected which attempts to identify hard-coded credentials.") ) )
| report
