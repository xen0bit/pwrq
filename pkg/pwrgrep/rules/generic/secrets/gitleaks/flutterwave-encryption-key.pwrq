# rules: flutterwave-encryption-key
# from: generic/secrets/gitleaks/flutterwave-encryption-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "FLWSECK_TEST-(?i)[a-h0-9]{12}"
    ])) as $all
    | ( $all | of(["FLWSECK_TEST-(?i)[a-h0-9]{12}"])
        | finding("flutterwave-encryption-key";
            "A gitleaks flutterwave-encryption-key was detected which attempts to identify hard-coded credentials.") ) )
| report
