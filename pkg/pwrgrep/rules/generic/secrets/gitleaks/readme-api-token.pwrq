# rules: readme-api-token
# from: generic/secrets/gitleaks/readme-api-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b(rdme_[a-z0-9]{70})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b(rdme_[a-z0-9]{70})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("readme-api-token";
            "A gitleaks readme-api-token was detected which attempts to identify hard-coded credentials.") ) )
| report
