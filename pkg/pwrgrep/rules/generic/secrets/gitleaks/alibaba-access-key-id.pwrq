# rules: alibaba-access-key-id
# from: generic/secrets/gitleaks/alibaba-access-key-id.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b((LTAI)(?i)[a-z0-9]{20})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b((LTAI)(?i)[a-z0-9]{20})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("alibaba-access-key-id";
            "A gitleaks alibaba-access-key-id was detected which attempts to identify hard-coded credentials.") ) )
| report
