# rules: shippo-api-token
# from: generic/secrets/gitleaks/shippo-api-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b(shippo_(live|test)_[a-f0-9]{40})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b(shippo_(live|test)_[a-f0-9]{40})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("shippo-api-token";
            "A gitleaks shippo-api-token was detected which attempts to identify hard-coded credentials.") ) )
| report
