# rules: npm-access-token
# from: generic/secrets/gitleaks/npm-access-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b(npm_[a-z0-9]{36})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b(npm_[a-z0-9]{36})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("npm-access-token";
            "A gitleaks npm-access-token was detected which attempts to identify hard-coded credentials.") ) )
| report
