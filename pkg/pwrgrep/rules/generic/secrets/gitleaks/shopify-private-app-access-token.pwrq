# rules: shopify-private-app-access-token
# from: generic/secrets/gitleaks/shopify-private-app-access-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "shppa_[a-fA-F0-9]{32}"
    ])) as $all
    | ( $all | of(["shppa_[a-fA-F0-9]{32}"])
        | finding("shopify-private-app-access-token";
            "A gitleaks shopify-private-app-access-token was detected which attempts to identify hard-coded credentials.") ) )
| report
