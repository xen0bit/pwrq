# rules: frameio-api-token
# from: generic/secrets/gitleaks/frameio-api-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "fio-u-(?i)[a-z0-9\\-_=]{64}"
    ])) as $all
    | ( $all | of(["fio-u-(?i)[a-z0-9\\-_=]{64}"])
        | finding("frameio-api-token";
            "A gitleaks frameio-api-token was detected which attempts to identify hard-coded credentials.") ) )
| report
