# rules: planetscale-api-token
# from: generic/secrets/gitleaks/planetscale-api-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b(pscale_tkn_(?i)[a-z0-9=\\-_\\.]{32,64})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b(pscale_tkn_(?i)[a-z0-9=\\-_\\.]{32,64})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("planetscale-api-token";
            "A gitleaks planetscale-api-token was detected which attempts to identify hard-coded credentials.") ) )
| report
