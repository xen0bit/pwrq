# rules: shopify-access-token
# from: generic/secrets/gitleaks/shopify-access-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "shpat_[a-fA-F0-9]{32}"
    ])) as $all
    | ( $all | of(["shpat_[a-fA-F0-9]{32}"])
        | finding("shopify-access-token";
            "A gitleaks shopify-access-token was detected which attempts to identify hard-coded credentials.") ) )
| report
