# rules: gitlab-rrt
# from: generic/secrets/gitleaks/gitlab-rrt.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "GR1348941[0-9a-zA-Z\\-\\_]{20}"
    ])) as $all
    | ( $all | of(["GR1348941[0-9a-zA-Z\\-\\_]{20}"])
        | finding("gitlab-rrt";
            "A gitleaks gitlab-rrt was detected which attempts to identify hard-coded credentials.") ) )
| report
