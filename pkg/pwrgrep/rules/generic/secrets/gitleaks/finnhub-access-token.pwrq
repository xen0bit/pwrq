# rules: finnhub-access-token
# from: generic/secrets/gitleaks/finnhub-access-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)(?:finnhub)(?:[0-9a-z\\-_\\t .]{0,20})(?:[\\s|']|[\\s|\"]){0,3}(?:=|>|:{1,3}=|\\|\\|:|<=|=>|:|\\?=)(?:'|\\\"|\\s|=|\\x60){0,5}([a-z0-9]{20})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)(?:finnhub)(?:[0-9a-z\\-_\\t .]{0,20})(?:[\\s|']|[\\s|\"]){0,3}(?:=|>|:{1,3}=|\\|\\|:|<=|=>|:|\\?=)(?:'|\\\"|\\s|=|\\x60){0,5}([a-z0-9]{20})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("finnhub-access-token";
            "A gitleaks finnhub-access-token was detected which attempts to identify hard-coded credentials.") ) )
| report
