# rules: slack-legacy-token
# from: generic/secrets/gitleaks/slack-legacy-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(xox[os]-\\d+-\\d+-\\d+-[a-fA-F\\d]+)"
    ])) as $all
    | ( $all | of(["(xox[os]-\\d+-\\d+-\\d+-[a-fA-F\\d]+)"])
        | finding("slack-legacy-token";
            "A gitleaks slack-legacy-token was detected which attempts to identify hard-coded credentials.") ) )
| report
