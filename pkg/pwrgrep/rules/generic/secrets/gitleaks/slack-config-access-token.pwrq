# rules: slack-config-access-token
# from: generic/secrets/gitleaks/slack-config-access-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)(xoxe.xox[bp]-\\d-[A-Z0-9]{163,166})"
    ])) as $all
    | ( $all | of(["(?i)(xoxe.xox[bp]-\\d-[A-Z0-9]{163,166})"])
        | finding("slack-config-access-token";
            "A gitleaks slack-config-access-token was detected which attempts to identify hard-coded credentials.") ) )
| report
