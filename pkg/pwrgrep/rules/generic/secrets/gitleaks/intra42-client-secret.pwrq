# rules: intra42-client-secret
# from: generic/secrets/gitleaks/intra42-client-secret.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b(s-s4t2(?:ud|af)-[abcdef0123456789]{64})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b(s-s4t2(?:ud|af)-[abcdef0123456789]{64})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("intra42-client-secret";
            "A gitleaks intra42-client-secret was detected which attempts to identify hard-coded credentials.") ) )
| report
