# rules: github-app-token
# from: generic/secrets/gitleaks/github-app-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(ghu|ghs)_[0-9a-zA-Z]{36}"
    ])) as $all
    | ( $all | of(["(ghu|ghs)_[0-9a-zA-Z]{36}"])
        | finding("github-app-token";
            "A gitleaks github-app-token was detected which attempts to identify hard-coded credentials.") ) )
| report
