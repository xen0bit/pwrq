# rules: shopify-custom-access-token
# from: generic/secrets/gitleaks/shopify-custom-access-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "shpca_[a-fA-F0-9]{32}"
    ])) as $all
    | ( $all | of(["shpca_[a-fA-F0-9]{32}"])
        | finding("shopify-custom-access-token";
            "A gitleaks shopify-custom-access-token was detected which attempts to identify hard-coded credentials.") ) )
| report
