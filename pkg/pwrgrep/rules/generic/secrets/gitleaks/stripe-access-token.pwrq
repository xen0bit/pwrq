# rules: stripe-access-token
# from: generic/secrets/gitleaks/stripe-access-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b((sk|rk)_(test|live|prod)_[0-9a-z]{10,99})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b((sk|rk)_(test|live|prod)_[0-9a-z]{10,99})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("stripe-access-token";
            "A gitleaks stripe-access-token was detected which attempts to identify hard-coded credentials.") ) )
| report
