# rules: databricks-api-token
# from: generic/secrets/gitleaks/databricks-api-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b(dapi[a-h0-9]{32})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b(dapi[a-h0-9]{32})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("databricks-api-token";
            "A gitleaks databricks-api-token was detected which attempts to identify hard-coded credentials.") ) )
| report
