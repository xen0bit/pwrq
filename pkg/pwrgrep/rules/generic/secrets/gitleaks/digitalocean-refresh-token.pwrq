# rules: digitalocean-refresh-token
# from: generic/secrets/gitleaks/digitalocean-refresh-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b(dor_v1_[a-f0-9]{64})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b(dor_v1_[a-f0-9]{64})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("digitalocean-refresh-token";
            "A gitleaks digitalocean-refresh-token was detected which attempts to identify hard-coded credentials.") ) )
| report
