# rules: huggingface-access-token
# from: generic/secrets/gitleaks/huggingface-access-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?:^|[\\\\'\"` >=:])(hf_[a-zA-Z]{34})(?:$|[\\\\'\"` <])"
    ])) as $all
    | ( $all | of(["(?:^|[\\\\'\"` >=:])(hf_[a-zA-Z]{34})(?:$|[\\\\'\"` <])"])
        | finding("huggingface-access-token";
            "A gitleaks huggingface-access-token was detected which attempts to identify hard-coded credentials.") ) )
| report
