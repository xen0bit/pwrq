# rules: slack-legacy-bot-token
# from: generic/secrets/gitleaks/slack-legacy-bot-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(xoxb-[0-9]{8,14}\\-[a-zA-Z0-9]{18,26})"
    ])) as $all
    | ( $all | of(["(xoxb-[0-9]{8,14}\\-[a-zA-Z0-9]{18,26})"])
        | finding("slack-legacy-bot-token";
            "A gitleaks slack-legacy-bot-token was detected which attempts to identify hard-coded credentials.") ) )
| report
