# rules: facebook-page-access-token
# from: generic/secrets/gitleaks/facebook-page-access-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b(EAA[MC][a-z0-9]{20,})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b(EAA[MC][a-z0-9]{20,})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("facebook-page-access-token";
            "A gitleaks facebook-page-access-token was detected which attempts to identify hard-coded credentials.") ) )
| report
