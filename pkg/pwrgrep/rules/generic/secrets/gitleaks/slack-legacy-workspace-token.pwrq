# rules: slack-legacy-workspace-token
# from: generic/secrets/gitleaks/slack-legacy-workspace-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(xox[ar]-(?:\\d-)?[0-9a-zA-Z]{8,48})"
    ])) as $all
    | ( $all | of(["(xox[ar]-(?:\\d-)?[0-9a-zA-Z]{8,48})"])
        | finding("slack-legacy-workspace-token";
            "A gitleaks slack-legacy-workspace-token was detected which attempts to identify hard-coded credentials.") ) )
| report
