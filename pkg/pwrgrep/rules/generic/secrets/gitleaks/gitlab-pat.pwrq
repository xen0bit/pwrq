# rules: gitlab-pat
# from: generic/secrets/gitleaks/gitlab-pat.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "glpat-[0-9a-zA-Z\\-\\_]{20}"
    ])) as $all
    | ( $all | of(["glpat-[0-9a-zA-Z\\-\\_]{20}"])
        | finding("gitlab-pat";
            "A gitleaks gitlab-pat was detected which attempts to identify hard-coded credentials.") ) )
| report
