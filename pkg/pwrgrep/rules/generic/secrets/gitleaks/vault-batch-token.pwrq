# rules: vault-batch-token
# from: generic/secrets/gitleaks/vault-batch-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b(hvb\\.[a-z0-9_-]{138,212})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b(hvb\\.[a-z0-9_-]{138,212})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("vault-batch-token";
            "A gitleaks vault-batch-token was detected which attempts to identify hard-coded credentials.") ) )
| report
