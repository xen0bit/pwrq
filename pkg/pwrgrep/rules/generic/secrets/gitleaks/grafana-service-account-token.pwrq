# rules: grafana-service-account-token
# from: generic/secrets/gitleaks/grafana-service-account-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b(glsa_[A-Za-z0-9]{32}_[A-Fa-f0-9]{8})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b(glsa_[A-Za-z0-9]{32}_[A-Fa-f0-9]{8})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("grafana-service-account-token";
            "A gitleaks grafana-service-account-token was detected which attempts to identify hard-coded credentials.") ) )
| report
