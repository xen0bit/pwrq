# rules: infracost-api-token
# from: generic/secrets/gitleaks/infracost-api-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b(ico-[a-zA-Z0-9]{32})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b(ico-[a-zA-Z0-9]{32})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("infracost-api-token";
            "A gitleaks infracost-api-token was detected which attempts to identify hard-coded credentials.") ) )
| report
