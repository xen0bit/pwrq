# rules: postman-api-token
# from: generic/secrets/gitleaks/postman-api-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b(PMAK-(?i)[a-f0-9]{24}\\-[a-f0-9]{34})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b(PMAK-(?i)[a-f0-9]{24}\\-[a-f0-9]{34})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("postman-api-token";
            "A gitleaks postman-api-token was detected which attempts to identify hard-coded credentials.") ) )
| report
