# rules: harness-api-key
# from: generic/secrets/gitleaks/harness-api-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "((?:pat|sat)\\.[a-zA-Z0-9]{22}\\.[a-zA-Z0-9]{24}\\.[a-zA-Z0-9]{20})"
    ])) as $all
    | ( $all | of(["((?:pat|sat)\\.[a-zA-Z0-9]{22}\\.[a-zA-Z0-9]{24}\\.[a-zA-Z0-9]{20})"])
        | finding("harness-api-key";
            "A gitleaks harness-api-key was detected which attempts to identify hard-coded credentials.") ) )
| report
