# rules: easypost-api-token
# from: generic/secrets/gitleaks/easypost-api-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "\\bEZAK(?i)[a-z0-9]{54}"
    ])) as $all
    | ( $all | of(["\\bEZAK(?i)[a-z0-9]{54}"])
        | finding("easypost-api-token";
            "A gitleaks easypost-api-token was detected which attempts to identify hard-coded credentials.") ) )
| report
