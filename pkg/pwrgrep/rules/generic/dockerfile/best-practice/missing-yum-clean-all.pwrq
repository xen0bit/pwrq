# rules: missing-yum-clean-all
# from: generic/dockerfile/best-practice/missing-yum-clean-all.yaml

. as $root
| ( ($root | scan_regex(["*dockerfile*","*Dockerfile*"]; [
      "RUN\\s+[\\s\\S]*?\\s+&&\\s+\\\\\\s+yum\\s+clean\\s+all",
      "RUN\\s+[\\s\\S]*?\\s+&&\\s+yum\\s+clean\\s+all",
      "yum\\s+(?P<COMMAND>\\S+)"
    ])) as $all
    | ( $all | of(["yum\\s+(?P<COMMAND>\\S+)"])
          | outside($all | of(["RUN\\s+[\\s\\S]*?\\s+&&\\s+yum\\s+clean\\s+all"]))
          | outside($all | of(["RUN\\s+[\\s\\S]*?\\s+&&\\s+\\\\\\s+yum\\s+clean\\s+all"]))
        | finding("missing-yum-clean-all";
            "This yum command does not end with '&& yum clean all'.") ) )
| report
