# rules: use-absolute-workdir
# from: generic/dockerfile/best-practice/use-absolute-workdir.yaml

. as $root
| ( ($root | scan_regex(["*dockerfile*","*Dockerfile*"]; [
      "ENV\\s+(?P<VAR>\\S+)=(?P<VALUE>\\S+)\\s+[\\s\\S]*?\\s+(?P<CMD>\\S+)\\s+\\$\\{(?P<VAR>\\S+)\\}",
      "WORKDIR\\s+(?P<VALUE>\\S+)"
    ])) as $all
    | ( ($all | of(["WORKDIR\\s+(?P<VALUE>\\S+)"]))
          + ($all | of(["ENV\\s+(?P<VAR>\\S+)=(?P<VALUE>\\S+)\\s+[\\s\\S]*?\\s+(?P<CMD>\\S+)\\s+\\$\\{(?P<VAR>\\S+)\\}"])
          | where_capture_ast("CMD"; "WORKDIR")
          | focus("CMD"))
        | finding("use-absolute-workdir";
            "Detected a relative WORKDIR.") ) )
| report
