# rules: multiple-cmd-instructions
# from: generic/dockerfile/correctness/multiple-cmd-instructions.yaml

. as $root
| ( ($root | scan_regex(["Dockerfile*"]; [
      "CMD\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+CMD\\s+[\\s\\S]*?",
      "CMD\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+CMD\\s+\\[[\\s\\S]*?\\]",
      "CMD\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+FROM\\s+(?P<IMAGE>\\S+)\\s+[\\s\\S]*?\\s+CMD\\s+[\\s\\S]*?",
      "CMD\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+HEALTHCHECK\\s+(?P<CMD>\\S+)",
      "CMD\\s+\\[[\\s\\S]*?\\]\\s+[\\s\\S]*?\\s+CMD\\s+[\\s\\S]*?",
      "CMD\\s+\\[[\\s\\S]*?\\]\\s+[\\s\\S]*?\\s+CMD\\s+\\[[\\s\\S]*?\\]",
      "CMD\\s+\\[[\\s\\S]*?\\]\\s+[\\s\\S]*?\\s+HEALTHCHECK\\s+(?P<CMD>\\S+)",
      "HEALTHCHECK\\s+(?P<CMD>\\S+)\\s+[\\s\\S]*?\\s+CMD\\s+[\\s\\S]*?",
      "HEALTHCHECK\\s+(?P<CMD>\\S+)\\s+[\\s\\S]*?\\s+CMD\\s+\\[[\\s\\S]*?\\]"
    ])) as $all
    | ( $all | of(["CMD\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+CMD\\s+[\\s\\S]*?","CMD\\s+\\[[\\s\\S]*?\\]\\s+[\\s\\S]*?\\s+CMD\\s+\\[[\\s\\S]*?\\]","CMD\\s+\\[[\\s\\S]*?\\]\\s+[\\s\\S]*?\\s+CMD\\s+[\\s\\S]*?","CMD\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+CMD\\s+\\[[\\s\\S]*?\\]"])
          | outside($all | of(["CMD\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+FROM\\s+(?P<IMAGE>\\S+)\\s+[\\s\\S]*?\\s+CMD\\s+[\\s\\S]*?"]))
          | not_at($all | of(["HEALTHCHECK\\s+(?P<CMD>\\S+)\\s+[\\s\\S]*?\\s+CMD\\s+[\\s\\S]*?"]))
          | not_at($all | of(["HEALTHCHECK\\s+(?P<CMD>\\S+)\\s+[\\s\\S]*?\\s+CMD\\s+\\[[\\s\\S]*?\\]"]))
          | not_at($all | of(["CMD\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+HEALTHCHECK\\s+(?P<CMD>\\S+)"]))
          | not_at($all | of(["CMD\\s+\\[[\\s\\S]*?\\]\\s+[\\s\\S]*?\\s+HEALTHCHECK\\s+(?P<CMD>\\S+)"]))
        | finding("multiple-cmd-instructions";
            "Multiple CMD instructions were found.") ) )
| report
