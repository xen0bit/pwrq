# rules: alias-must-be-unique
# from: generic/dockerfile/correctness/alias-must-be-unique.yaml

. as $root
| ( ($root | scan_regex(["*dockerfile*","*Dockerfile*"]; [
      "FROM\\s+[\\s\\S]*?\\s+AS\\s+(?P<REF>\\S+)\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+FROM\\s+[\\s\\S]*?\\s+AS\\s+(?P<REF>\\S+)",
      "FROM\\s+[\\s\\S]*?\\s+AS\\s+(?P<REF>\\S+)\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+FROM\\s+[\\s\\S]*?\\s+AS\\s+(?P<REF>\\S+)\\-",
      "FROM\\s+[\\s\\S]*?\\s+as\\s+(?P<REF>\\S+)\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+FROM\\s+[\\s\\S]*?\\s+as\\s+(?P<REF>\\S+)",
      "FROM\\s+[\\s\\S]*?\\s+as\\s+(?P<REF>\\S+)\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+FROM\\s+[\\s\\S]*?\\s+as\\s+(?P<REF>\\S+)\\-"
    ])) as $all
    | ( $all | of(["FROM\\s+[\\s\\S]*?\\s+as\\s+(?P<REF>\\S+)\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+FROM\\s+[\\s\\S]*?\\s+as\\s+(?P<REF>\\S+)","FROM\\s+[\\s\\S]*?\\s+AS\\s+(?P<REF>\\S+)\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+FROM\\s+[\\s\\S]*?\\s+AS\\s+(?P<REF>\\S+)"])
          | outside($all | of(["FROM\\s+[\\s\\S]*?\\s+as\\s+(?P<REF>\\S+)\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+FROM\\s+[\\s\\S]*?\\s+as\\s+(?P<REF>\\S+)\\-"]))
          | outside($all | of(["FROM\\s+[\\s\\S]*?\\s+AS\\s+(?P<REF>\\S+)\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+FROM\\s+[\\s\\S]*?\\s+AS\\s+(?P<REF>\\S+)\\-"]))
        | finding("alias-must-be-unique";
            "Image aliases must have a unique name, and '$REF' is used twice.") ) )
| report
