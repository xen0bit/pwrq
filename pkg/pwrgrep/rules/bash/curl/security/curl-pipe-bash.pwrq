# rules: curl-pipe-bash
# from: bash/curl/security/curl-pipe-bash.yaml

. as $root
| ( ($root | scan_ast(["*.sh"]; [
      "$$$_ /bin/bash -c \"$(curl $$$_)\"",
      "$$$_ /bin/bash <(curl $$$_)",
      "$$$_ bash -c \"$(curl $$$_)\"",
      "$$$_ bash <(curl $$$_)",
      "curl $$$_ | $$$_ /bin/bash $$$_",
      "curl $$$_ | $$$_ bash $$$_"
    ])) as $all
    | ( $all | of(["curl $$$_ | $$$_ bash $$$_","curl $$$_ | $$$_ /bin/bash $$$_","$$$_ bash <(curl $$$_)","$$$_ /bin/bash <(curl $$$_)","$$$_ bash -c \"$(curl $$$_)\"","$$$_ /bin/bash -c \"$(curl $$$_)\""])
        | finding("curl-pipe-bash";
            "Data is being piped into `bash` from a `curl` command.") ) )
| report
