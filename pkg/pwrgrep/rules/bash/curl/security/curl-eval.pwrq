# rules: curl-eval
# languages: bash
# from: bash/curl/security/curl-eval.yaml

. as $root
| ( ($root | scan_ast(["*.sh"]; [
      "$(curl $$$_)",
      "`curl $$$_`",
      "eval $$$_"
    ])) as $all
    | ( (($all | of(["eval $$$_"])))
          | reaching((($all | of(["$(curl $$$_)"]))
              + ($all | of(["`curl $$$_`"])));
              ([]))
        | finding("curl-eval";
            "Data is being eval'd from a `curl` command.") ) )
| report
