# rules: ifs-tampering
# languages: bash
# from: bash/lang/security/ifs-tampering.yaml

. as $root
| ( ($root | scan_ast(["*.sh"]; [
      "IFS=$$$_"
    ])) as $all
    | ( $all | of(["IFS=$$$_"])
        | finding("ifs-tampering";
            "The special variable IFS affects how splitting takes place when expanding unquoted variables.") ) )
| report
