# rules: avoid-tainted-file-access
# languages: ruby
# from: ruby/rails/security/audit/avoid-tainted-file-access.yaml

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "Dir.$X($$$_)",
      "File.$X($$$_)",
      "IO.$X($$$_)",
      "Kernel.$X($$$_)",
      "PStore.$X($$$_)",
      "Pathname.$X($$$_)",
      "chdir",
      "chroot",
      "cookies",
      "delete",
      "entries",
      "foreach",
      "glob",
      "install",
      "lchmod",
      "lchown",
      "link",
      "load",
      "load_file",
      "makedirs",
      "move",
      "new",
      "open",
      "params",
      "read",
      "readlines",
      "rename",
      "request.env",
      "rmdir",
      "safe_unlink",
      "symlink",
      "syscopy",
      "sysopen",
      "truncate",
      "unlink"
    ])) as $all
    | ( (($all | of(["Dir.$X($$$_)","File.$X($$$_)","IO.$X($$$_)","Kernel.$X($$$_)","PStore.$X($$$_)","Pathname.$X($$$_)"])))
          | reaching((($all | of(["params"]))
              + ($all | of(["cookies"]))
              + ($all | of(["request.env"])));
              ([]))
        | finding("avoid-tainted-file-access";
            "Using user input when accessing files is potentially dangerous.") ) )
| report
