# rules: libxml-backend
# languages: ruby
# from: ruby/rails/security/audit/xxe/libxml-backend.yaml

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "ActiveSupport::XmlMini.backend = \"LibXML\""
    ])) as $all
    | ( $all | of(["ActiveSupport::XmlMini.backend = \"LibXML\""])
        | finding("libxml-backend";
            "This application is using LibXML as the XML backend.") ) )
| report
