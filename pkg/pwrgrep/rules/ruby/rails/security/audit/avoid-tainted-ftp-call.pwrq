# rules: avoid-tainted-ftp-call
# languages: ruby
# from: ruby/rails/security/audit/avoid-tainted-ftp-call.yaml

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "$FTP = Net::FTP.$OPEN($$$_)\n$$$_\n$FTP.$METHOD($$$_)",
      "$FTP.$METHOD($$$_)",
      "Net::FTP.$X($$$_)",
      "cookies",
      "params",
      "request.env"
    ])) as $all
    | ( ((($all | of(["Net::FTP.$X($$$_)"]))
          + ($all | of(["$FTP.$METHOD($$$_)"])
          | within($all | of(["$FTP = Net::FTP.$OPEN($$$_)\n$$$_\n$FTP.$METHOD($$$_)"])))))
          | reaching((($all | of(["params"]))
              + ($all | of(["cookies"]))
              + ($all | of(["request.env"])));
              ([]))
        | finding("avoid-tainted-ftp-call";
            "Using user input when accessing files is potentially dangerous.") ) )
| report
