# rules: avoid-session-manipulation
# languages: ruby
# from: ruby/rails/security/audit/avoid-session-manipulation.yaml

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "cookies",
      "params",
      "request.env",
      "session[$$$_]"
    ])) as $all
    | ( (($all | of(["session[$$$_]"])))
          | reaching((($all | of(["params"]))
              + ($all | of(["cookies"]))
              + ($all | of(["request.env"])));
              ([]))
        | finding("avoid-session-manipulation";
            "This gets data from session using user inputs.") ) )
| report
