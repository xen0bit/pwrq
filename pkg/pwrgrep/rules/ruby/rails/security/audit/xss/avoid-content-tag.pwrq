# rules: avoid-content-tag
# languages: ruby
# from: ruby/rails/security/audit/xss/avoid-content-tag.yaml

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "content_tag($$$_)"
    ])) as $all
    | ( $all | of(["content_tag($$$_)"])
        | finding("avoid-content-tag";
            "'content_tag()' bypasses HTML escaping for some portion of the content.") ) )
| report
