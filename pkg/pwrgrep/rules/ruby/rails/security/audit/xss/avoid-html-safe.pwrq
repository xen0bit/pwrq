# rules: avoid-html-safe
# from: ruby/rails/security/audit/xss/avoid-html-safe.yaml

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "$STR.html_safe",
      "$STR.html_safe.$MORE"
    ])) as $all
    | ( $all | of(["$STR.html_safe","$STR.html_safe.$MORE"])
        | finding("avoid-html-safe";
            "'html_safe()' does not make the supplied string safe.") ) )
| report
