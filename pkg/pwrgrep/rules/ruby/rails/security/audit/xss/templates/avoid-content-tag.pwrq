# rules: avoid-content-tag
# from: ruby/rails/security/audit/xss/templates/avoid-content-tag.yaml

. as $root
| ( ($root | scan_regex(["*.erb"]; [
      "<%=\\s+[\\s\\S]*?\\s+%>",
      "content_tag"
    ])) as $all
    | ( $all | of(["content_tag"])
          | within($all | of(["<%=\\s+[\\s\\S]*?\\s+%>"]))
        | finding("avoid-content-tag";
            "'content_tag' exhibits unintuitive escaping behavior and may accidentally expose your application to cross-site scripting.") ) )
| report
