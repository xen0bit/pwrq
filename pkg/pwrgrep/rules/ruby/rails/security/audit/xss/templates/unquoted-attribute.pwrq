# rules: unquoted-attribute
# from: ruby/rails/security/audit/xss/templates/unquoted-attribute.yaml

. as $root
| ( ($root | scan_regex(["*.erb"]; [
      "<%=\\s+[\\s\\S]*?\\s+%>",
      "<(?P<TAG>\\S+)\\s+[\\s\\S]*?>",
      "=\"<%=\\s+[\\s\\S]*?\\s+%>\"",
      "=\"[\\s\\S]*?\"",
      "='<%=\\s+[\\s\\S]*?\\s+%>'",
      "='[\\s\\S]*?'"
    ])) as $all
    | ( $all | of(["<%=\\s+[\\s\\S]*?\\s+%>"])
          | within($all | of(["<(?P<TAG>\\S+)\\s+[\\s\\S]*?>"]))
          | outside($all | of(["=\"[\\s\\S]*?\""]))
          | outside($all | of(["=\"<%=\\s+[\\s\\S]*?\\s+%>\""]))
          | outside($all | of(["='[\\s\\S]*?'"]))
          | outside($all | of(["='<%=\\s+[\\s\\S]*?\\s+%>'"]))
        | finding("unquoted-attribute";
            "Detected a unquoted template variable as an attribute.") ) )
| report
