# rules: alias-for-html-safe
# from: ruby/rails/security/audit/xss/templates/alias-for-html-safe.yaml

. as $root
| ( ($root | scan_regex(["*.erb"]; [
      "<%==\\s+(?P<A>[\\s\\S]*?)\\.to_json\\s+%>",
      "<%==\\s+[\\s\\S]*?\\s+%>"
    ])) as $all
    | ( $all | of(["<%==\\s+[\\s\\S]*?\\s+%>"])
          | not_at($all | of(["<%==\\s+(?P<A>[\\s\\S]*?)\\.to_json\\s+%>"]))
        | finding("alias-for-html-safe";
            "The syntax `<%== ...") ) )
| report
