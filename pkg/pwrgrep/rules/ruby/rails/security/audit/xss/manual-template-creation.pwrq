# rules: manual-template-creation
# from: ruby/rails/security/audit/xss/manual-template-creation.yaml

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "ERB.new($$$_)"
    ])) as $all
    | ( $all | of(["ERB.new($$$_)"])
        | finding("manual-template-creation";
            "Detected manual creation of an ERB template.") ) )
| report
