# rules: avoid-link-to
# languages: ruby
# from: ruby/rails/security/audit/xss/avoid-link-to.yaml

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "\"#{$$$_}$$$_\"",
      "\"$$$_#{$$$_}$$$_\"",
      "$MODEL.link($$$_)",
      "$MODEL.page($$$_)",
      "$MODEL.site($$$_)",
      "$MODEL.uri($$$_)",
      "$MODEL.url($$$_)",
      "cookies",
      "link_to($$$_)",
      "params",
      "request.env"
    ])) as $all
    | ( (($all | of(["link_to($$$_)"])))
          | reaching((($all | of(["params"]))
              + ($all | of(["cookies"]))
              + ($all | of(["request.env"]))
              + ($all | of(["$MODEL.url($$$_)","$MODEL.uri($$$_)","$MODEL.link($$$_)","$MODEL.page($$$_)","$MODEL.site($$$_)"])));
              (($all | of(["\"$$$_#{$$$_}$$$_\""])
          | not_at($all | of(["\"#{$$$_}$$$_\""])))))
        | finding("avoid-link-to";
            "This code includes user input in `link_to`.") ) )
| report
