# rules: avoid-redirect
# languages: ruby
# from: ruby/rails/security/audit/xss/avoid-redirect.yaml

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "$MODEL.$X(\"$$$_\")",
      "$MODEL.$X($$$_)",
      "all",
      "cookies",
      "create",
      "create!",
      "find",
      "find_by",
      "find_by!",
      "find_by_sql",
      "first",
      "from",
      "group",
      "having",
      "joins",
      "last",
      "lock",
      "new",
      "order",
      "params",
      "params.merge(:host => $$$_)",
      "params.merge(:only_path => true)",
      "redirect_to($$$_)",
      "reorder",
      "request.env",
      "select",
      "take",
      "where"
    ])) as $all
    | ( (($all | of(["redirect_to($$$_)"])))
          | reaching((($all | of(["params"]))
              + ($all | of(["cookies"]))
              + ($all | of(["request.env"]))
              + ($all | of(["$MODEL.$X($$$_)"])
          | not_at($all | of(["$MODEL.$X(\"$$$_\")"]))));
              (($all | of(["params.merge(:only_path => true)"]))
              + ($all | of(["params.merge(:host => $$$_)"]))))
        | finding("avoid-redirect";
            "When a redirect uses user input, a malicious user can spoof a website under a trusted URL or access restricted parts of a site.") ) )
| report
