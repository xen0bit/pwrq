# rules: check-send-file
# languages: ruby
# from: ruby/rails/security/brakeman/check-send-file.yaml

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "cookies. $$$_ .$PROPERTY[$$$_]",
      "cookies[$$$_]",
      "params[$$$_]",
      "request.env[$$$_]",
      "send_file $$$_"
    ])) as $all
    | ( (($all | of(["send_file $$$_"])))
          | reaching(((($all | of(["cookies[$$$_]"]))
          + ($all | of(["cookies. $$$_ .$PROPERTY[$$$_]"])
          | where_capture_not("PROPERTY"; "^(?:signed|encrypted)"))
          + ($all | of(["params[$$$_]"]))
          + ($all | of(["request.env[$$$_]"]))));
              ([]))
        | finding("check-send-file";
            "Allowing user input to `send_file` allows a malicious user to potentially read arbitrary files from the server.") ) )
| report
