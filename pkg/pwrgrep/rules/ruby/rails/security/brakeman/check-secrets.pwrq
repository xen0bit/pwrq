# rules: check-secrets
# languages: ruby
# from: ruby/rails/security/brakeman/check-secrets.yaml

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "$VAR = \"$VALUE\""
    ])) as $all
    | ( $all | of(["$VAR = \"$VALUE\""])
          | where_capture("VAR"; "^(?:(?i)password|secret|(rest_auth_site|api)_key$)")
          | where_capture("VALUE"; "^(?:.+)")
        | finding("check-secrets";
            "Found a Brakeman-style secret - a variable with the name password/secret/api_key/rest_auth_site_key and a non-empty string literal value.") ) )
| report
