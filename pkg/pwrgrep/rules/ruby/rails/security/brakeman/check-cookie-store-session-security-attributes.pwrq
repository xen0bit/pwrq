# rules: check-cookie-store-session-security-attributes
# from: ruby/rails/security/brakeman/check-cookie-store-session-security-attributes.yaml

. as $root
| ( ($root | scan_regex(["*.rb"]; [
      "(?P<CLASS>\\S+)\\.application\\.config\\.session_store\\s+:cookie_store,\\s+[\\s\\S]*?,\\s+(?P<KEY>\\S+):\\s+false,\\s+[\\s\\S]*?",
      "(?P<MODULE>\\S+)::Application\\.config\\.session_store\\s+:cookie_store,\\s+[\\s\\S]*?,\\s+:(?P<KEY>\\S+)\\s+=>\\s+false,\\s+[\\s\\S]*?",
      ":(?P<KEY>\\S+)\\s+=>\\s+false",
      "ActionController::Base\\.session\\s+=\\s+\\{[\\s\\S]*?\\}"
    ])) as $all
    | ( ($all | of([":(?P<KEY>\\S+)\\s+=>\\s+false"])
          | within($all | of(["ActionController::Base\\.session\\s+=\\s+\\{[\\s\\S]*?\\}"])))
          + ($all | of(["(?P<MODULE>\\S+)::Application\\.config\\.session_store\\s+:cookie_store,\\s+[\\s\\S]*?,\\s+:(?P<KEY>\\S+)\\s+=>\\s+false,\\s+[\\s\\S]*?"]))
          + ($all | of(["(?P<CLASS>\\S+)\\.application\\.config\\.session_store\\s+:cookie_store,\\s+[\\s\\S]*?,\\s+(?P<KEY>\\S+):\\s+false,\\s+[\\s\\S]*?"]))
          | where_capture("KEY"; "^(session_)?(http_?only|secure)$")
        | finding("check-cookie-store-session-security-attributes";
            "Found a Rails `cookie_store` session configuration setting the `$KEY` attribute to `false`.") ) )
| report
