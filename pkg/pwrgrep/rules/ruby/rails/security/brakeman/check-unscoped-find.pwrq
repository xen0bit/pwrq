# rules: check-unscoped-find
# languages: ruby
# from: ruby/rails/security/brakeman/check-unscoped-find.yaml

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "$MODEL.find($$$_)",
      "$MODEL.find_by_id!($$$_)",
      "$MODEL.find_by_id($$$_)",
      "cookies. $$$_ .$PROPERTY[$$$_]",
      "cookies[$$$_]",
      "params[$$$_]",
      "request.env[$$$_]"
    ])) as $all
    | ( (($all | of(["$MODEL.find($$$_)","$MODEL.find_by_id($$$_)","$MODEL.find_by_id!($$$_)"])
          | where_capture("MODEL"; "^(?:[A-Z]\\S+)")))
          | reaching(((($all | of(["cookies[$$$_]"]))
          + ($all | of(["cookies. $$$_ .$PROPERTY[$$$_]"])
          | where_capture_not("PROPERTY"; "^(?:signed|encrypted)"))
          + ($all | of(["params[$$$_]"]))
          + ($all | of(["request.env[$$$_]"]))));
              ([]))
        | finding("check-unscoped-find";
            "Found an unscoped `find(...)` with user-controllable input.") ) )
| report
