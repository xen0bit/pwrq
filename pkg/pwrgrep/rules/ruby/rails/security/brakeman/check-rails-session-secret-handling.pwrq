# rules: check-rails-session-secret-handling
# from: ruby/rails/security/brakeman/check-rails-session-secret-handling.yaml

. as $root
| ( ($root | scan_regex(["*.rb"]; [
      "(?P<RAILS>\\S+)::Application\\.config\\.(?P<KEY>\\S+)\\s+=\\s+\"(?P<LITERAL>\\S+)\"",
      ":(?P<KEY>\\S+)\\s+=>\\s+\"(?P<LITERAL>\\S+)\"",
      "ActionController::Base\\.session\\s+=\\s+\\{[\\s\\S]*?\\}",
      "Rails\\.application\\.config\\.(?P<KEY>\\S+)\\s+=\\s+\"(?P<LITERAL>\\S+)\""
    ])) as $all
    | ( ($all | of([":(?P<KEY>\\S+)\\s+=>\\s+\"(?P<LITERAL>\\S+)\""])
          | within($all | of(["ActionController::Base\\.session\\s+=\\s+\\{[\\s\\S]*?\\}"])))
          + ($all | of(["(?P<RAILS>\\S+)::Application\\.config\\.(?P<KEY>\\S+)\\s+=\\s+\"(?P<LITERAL>\\S+)\""]))
          + ($all | of(["Rails\\.application\\.config\\.(?P<KEY>\\S+)\\s+=\\s+\"(?P<LITERAL>\\S+)\""]))
          | where_capture("KEY"; "^secret(_(token|key_base))?$")
        | finding("check-rails-session-secret-handling";
            "Found a string literal assignment to a Rails session secret `$KEY`.") ) )
| report
