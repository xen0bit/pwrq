# rules: check-render-local-file-include
# languages: ruby
# from: ruby/rails/security/brakeman/check-render-local-file-include.yaml

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "$MAP[$$$_]",
      "File.basename($$$_)",
      "params[$$$_]",
      "render $$$_, action: $X",
      "render $$$_, file: $X",
      "render $$$_, inline: $X",
      "render $$$_, template: $X",
      "render $X, $$$_"
    ])) as $all
    | ( (($all | of(["render $$$_, file: $X","render $$$_, inline: $X","render $$$_, template: $X","render $$$_, action: $X","render $X, $$$_"])
          | focus("X")))
          | reaching((($all | of(["params[$$$_]"])));
              (($all | of(["$MAP[$$$_]"]))
              + ($all | of(["File.basename($$$_)"]))))
        | finding("check-render-local-file-include";
            "Found request parameters in a call to `render`.") ) )
| report
