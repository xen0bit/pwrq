# rules: check-dynamic-render-local-file-include
# from: ruby/rails/security/brakeman/check-dynamic-render-local-file-include.yaml

. as $root
| ( ($root | scan_regex(["*.erb"]; [
      "params\\[[\\s\\S]*?\\]",
      "render\\s+:file\\s+=>\\s+[\\s\\S]*?"
    ])) as $all
    | ( $all | of(["params\\[[\\s\\S]*?\\]"])
          | within($all | of(["render\\s+:file\\s+=>\\s+[\\s\\S]*?"]))
        | finding("check-dynamic-render-local-file-include";
            "Found request parameters in a call to `render` in a dynamic context.") ) )
| report
