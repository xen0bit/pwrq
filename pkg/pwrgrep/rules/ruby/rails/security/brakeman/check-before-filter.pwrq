# rules: check-before-filter
# from: ruby/rails/security/brakeman/check-before-filter.yaml

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "skip_before_action $$$_, :except => $ARGS",
      "skip_before_filter $$$_, :except => $ARGS",
      "skip_filter $$$_, :except => $ARGS"
    ])) as $all
    | ( $all | of(["skip_filter $$$_, :except => $ARGS","skip_before_filter $$$_, :except => $ARGS","skip_before_action $$$_, :except => $ARGS"])
        | finding("check-before-filter";
            "Disabled-by-default Rails controller checks make it much easier to introduce access control mistakes.") ) )
| report
