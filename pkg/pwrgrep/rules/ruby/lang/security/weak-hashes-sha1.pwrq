# rules: weak-hashes-sha1
# from: ruby/lang/security/weak-hashes-sha1.yaml

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "Digest::SHA1.$FUNC",
      "OpenSSL::Digest::SHA1.$FUNC",
      "OpenSSL::HMAC.$FUNC(\"sha1\",$$$_)"
    ])) as $all
    | ( $all | of(["Digest::SHA1.$FUNC","OpenSSL::Digest::SHA1.$FUNC","OpenSSL::HMAC.$FUNC(\"sha1\",$$$_)"])
        | finding("weak-hashes-sha1";
            "Should not use SHA1 to generate hashes.") ) )
| report
