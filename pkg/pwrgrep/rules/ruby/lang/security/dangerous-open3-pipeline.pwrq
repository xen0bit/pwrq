# rules: dangerous-open3-pipeline
# languages: ruby
# from: ruby/lang/security/dangerous-open3-pipeline.yaml

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "Open3.$PIPE($$$_)",
      "Open3.$PIPE($$$_,\"$$$_\",$$$_)"
    ])) as $all
    | ( $all | of(["Open3.$PIPE($$$_)"])
          | not_at($all | of(["Open3.$PIPE($$$_,\"$$$_\",$$$_)"]))
          | where_capture("PIPE"; "^(pipeline|pipeline_r|pipeline_rw|pipeline_start|pipeline_w)$")
        | finding("dangerous-open3-pipeline";
            "Detected non-static command inside $PIPE.") ) )
| report
