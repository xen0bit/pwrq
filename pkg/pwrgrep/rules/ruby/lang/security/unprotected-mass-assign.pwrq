# rules: mass-assignment-vuln
# from: ruby/lang/security/unprotected-mass-assign.yaml

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "$MOD.new($$$_, params[$CODE], :without_protection => true, $$$_)",
      "$MOD.new(params[$CODE])",
      "attr_accessible $VAR\n$$$_\n$MOD.new(params[$CODE])"
    ])) as $all
    | ( $all | of(["$MOD.new(params[$CODE])","$MOD.new($$$_, params[$CODE], :without_protection => true, $$$_)"])
          | outside($all | of(["attr_accessible $VAR\n$$$_\n$MOD.new(params[$CODE])"]))
        | finding("mass-assignment-vuln";
            "Checks for calls to without_protection during mass assignment (which allows record creation from hash values).") ) )
| report
