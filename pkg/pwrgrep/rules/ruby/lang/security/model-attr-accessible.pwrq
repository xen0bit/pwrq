# rules: model-attr-accessible
# languages: ruby
# from: ruby/lang/security/model-attr-accessible.yaml

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "$$$_.permit($$$_, :account_id, $$$_)",
      "$$$_.permit($$$_, :admin, $$$_)",
      "$$$_.permit($$$_, :banned, $$$_)",
      "$$$_.permit($$$_, :role, $$$_)",
      "attr_accessible $$$_, :account_id, $$$_",
      "attr_accessible $$$_, :admin, $$$_",
      "attr_accessible $$$_, :banned, $$$_",
      "attr_accessible $$$_, :role, $$$_",
      "params.permit!"
    ])) as $all
    | ( $all | of(["$$$_.permit($$$_, :admin, $$$_)","$$$_.permit($$$_, :role, $$$_)","$$$_.permit($$$_, :banned, $$$_)","$$$_.permit($$$_, :account_id, $$$_)","attr_accessible $$$_, :admin, $$$_","attr_accessible $$$_, :role, $$$_","attr_accessible $$$_, :banned, $$$_","attr_accessible $$$_, :account_id, $$$_","params.permit!"])
        | finding("model-attr-accessible";
            "Checks for dangerous permitted attributes that can lead to mass assignment vulnerabilities.") ) )
| report
