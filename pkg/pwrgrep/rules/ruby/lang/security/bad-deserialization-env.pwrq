# rules: bad-deserialization-env
# languages: ruby
# from: ruby/lang/security/bad-deserialization-env.yaml

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "CSV.load($$$_)",
      "Marshal.load($$$_)",
      "Marshal.restore($$$_)",
      "Oj.load($X)",
      "Oj.object_load($$$_)",
      "request.env"
    ])) as $all
    | ( (($all | of(["CSV.load($$$_)","Marshal.load($$$_)","Marshal.restore($$$_)","Oj.object_load($$$_)","Oj.load($X)"])))
          | reaching((($all | of(["request.env"])));
              ([]))
        | finding("bad-deserialization-env";
            "Checks for unsafe deserialization.") ) )
| report
