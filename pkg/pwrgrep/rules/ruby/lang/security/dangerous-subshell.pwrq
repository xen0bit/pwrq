# rules: dangerous-subshell
# languages: ruby
# from: ruby/lang/security/dangerous-subshell.yaml

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "\"$$$_\"",
      "$VAL = \"$$$_\"\n$$$_",
      "`$$$_#{\"$$$_\"}$$$_`",
      "`$$$_#{$VAL}$$$_`"
    ])) as $all
    | ( $all | of(["`$$$_#{$VAL}$$$_`"])
          | not_at($all | of(["`$$$_#{\"$$$_\"}$$$_`"]))
          | in_files_without($all | of(["$VAL = \"$$$_\"\n$$$_","\"$$$_\""]))
        | finding("dangerous-subshell";
            "Detected non-static command inside `...`.") ) )
| report
