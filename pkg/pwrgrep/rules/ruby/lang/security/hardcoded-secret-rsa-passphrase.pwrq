# rules: hardcoded-secret-rsa-passphrase
# from: ruby/lang/security/hardcoded-secret-rsa-passphrase.yaml

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "$ASSIGN = '$$$_'\n$$$_",
      "$ASSIGN = '$$$_'\n$$$_\ndef $METHOD($$$_)\n  $OPENSSL = OpenSSL::PKey::RSA.new($$$_)\n$$$_\nend\n$$$_",
      "$OPENSSL = OpenSSL::PKey::RSA.new($$$_)\n$$$_",
      "$OPENSSL.export($$$_,$ASSIGN)",
      "$OPENSSL.export($$$_,'$$$_')",
      "$OPENSSL.to_pem($$$_,$ASSIGN)",
      "$OPENSSL.to_pem($$$_,'$$$_')",
      "OpenSSL::PKey::RSA.new($$$_).export($$$_, '$$$_')",
      "OpenSSL::PKey::RSA.new($$$_).to_pem($$$_, '$$$_')",
      "OpenSSL::PKey::RSA.new($$$_, $ASSIGN)",
      "OpenSSL::PKey::RSA.new($$$_, '$$$_')",
      "def $METHOD1($$$_)\n$$$_\n$ASSIGN = '$$$_'\n$$$_\nend\n$$$_\ndef $METHOD2($$$_)\n$$$_\n$OPENSSL = OpenSSL::PKey::RSA.new($$$_)\n$$$_\nend\n$$$_",
      "def $METHOD1($$$_)\n$$$_\n$ASSIGN = '$$$_'\n$$$_\nend\n$$$_\ndef $METHOD2($$$_)\n$$$_\nend",
      "def $METHOD1($$$_)\n$$$_\n$OPENSSL = OpenSSL::PKey::RSA.new($$$_)\n$$$_\n$ASSIGN = '$$$_'\n$$$_\nend\n$$$_"
    ])) as $all
    | ( ($all | of(["OpenSSL::PKey::RSA.new($$$_, '$$$_')"]))
          + ($all | of(["OpenSSL::PKey::RSA.new($$$_).to_pem($$$_, '$$$_')"]))
          + ($all | of(["OpenSSL::PKey::RSA.new($$$_).export($$$_, '$$$_')"]))
          + ($all | of(["$OPENSSL.export($$$_,'$$$_')","$OPENSSL.to_pem($$$_,'$$$_')"])
          | in_files_with($all | of(["$OPENSSL = OpenSSL::PKey::RSA.new($$$_)\n$$$_"])))
          + (($all | of(["OpenSSL::PKey::RSA.new($$$_, $ASSIGN)"])
          | in_files_with($all | of(["$ASSIGN = '$$$_'\n$$$_"])))
          + ($all | of(["OpenSSL::PKey::RSA.new($$$_, $ASSIGN)"])
          | within($all | of(["def $METHOD1($$$_)\n$$$_\n$ASSIGN = '$$$_'\n$$$_\nend\n$$$_\ndef $METHOD2($$$_)\n$$$_\nend"])))
          + ($all | of(["$OPENSSL.export($$$_,$ASSIGN)","$OPENSSL.to_pem($$$_,$ASSIGN)"])
          | in_files_with($all | of(["$ASSIGN = '$$$_'\n$$$_\ndef $METHOD($$$_)\n  $OPENSSL = OpenSSL::PKey::RSA.new($$$_)\n$$$_\nend\n$$$_"])))
          + ($all | of(["$OPENSSL.export($$$_,$ASSIGN)","$OPENSSL.to_pem($$$_,$ASSIGN)"])
          | in_files_with($all | of(["def $METHOD1($$$_)\n$$$_\n$OPENSSL = OpenSSL::PKey::RSA.new($$$_)\n$$$_\n$ASSIGN = '$$$_'\n$$$_\nend\n$$$_"])))
          + ($all | of(["$OPENSSL.export($$$_,$ASSIGN)","$OPENSSL.to_pem($$$_,$ASSIGN)"])
          | in_files_with($all | of(["def $METHOD1($$$_)\n$$$_\n$ASSIGN = '$$$_'\n$$$_\nend\n$$$_\ndef $METHOD2($$$_)\n$$$_\n$OPENSSL = OpenSSL::PKey::RSA.new($$$_)\n$$$_\nend\n$$$_"]))))
        | finding("hardcoded-secret-rsa-passphrase";
            "Found the use of an hardcoded passphrase for RSA.") ) )
| report
