# rules: hardcoded-secret-rsa-passphrase
# from: ruby/lang/security/hardcoded-secret-rsa-passphrase.yaml

. as $root
| ( ($root | scan_regex(["*.rb"]; [
      "(?P<ASSIGN>\\S+)\\s+=\\s+'[\\s\\S]*?'\\s+[\\s\\S]*?",
      "(?P<ASSIGN>\\S+)\\s+=\\s+'[\\s\\S]*?'\\s+[\\s\\S]*?\\s+def\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+(?P<OPENSSL>\\S+)\\s+=\\s+OpenSSL::PKey::RSA\\.new\\([\\s\\S]*?\\)\\s+[\\s\\S]*?\\s+end\\s+[\\s\\S]*?",
      "(?P<OPENSSL>\\S+)\\.export\\([\\s\\S]*?,'[\\s\\S]*?'\\)",
      "(?P<OPENSSL>\\S+)\\.export\\([\\s\\S]*?,(?P<ASSIGN>\\S+)\\)",
      "(?P<OPENSSL>\\S+)\\.to_pem\\([\\s\\S]*?,'[\\s\\S]*?'\\)",
      "(?P<OPENSSL>\\S+)\\.to_pem\\([\\s\\S]*?,(?P<ASSIGN>\\S+)\\)",
      "(?P<OPENSSL>\\S+)\\s+=\\s+OpenSSL::PKey::RSA\\.new\\([\\s\\S]*?\\)\\s+[\\s\\S]*?",
      "OpenSSL::PKey::RSA\\.new\\([\\s\\S]*?,\\s+'[\\s\\S]*?'\\)",
      "OpenSSL::PKey::RSA\\.new\\([\\s\\S]*?,\\s+(?P<ASSIGN>\\S+)\\)",
      "OpenSSL::PKey::RSA\\.new\\([\\s\\S]*?\\)\\.export\\([\\s\\S]*?,\\s+'[\\s\\S]*?'\\)",
      "OpenSSL::PKey::RSA\\.new\\([\\s\\S]*?\\)\\.to_pem\\([\\s\\S]*?,\\s+'[\\s\\S]*?'\\)",
      "def\\s+(?P<METHOD1>\\S+)\\([\\s\\S]*?\\)\\s+[\\s\\S]*?\\s+(?P<ASSIGN>\\S+)\\s+=\\s+'[\\s\\S]*?'\\s+[\\s\\S]*?\\s+end\\s+[\\s\\S]*?\\s+def\\s+(?P<METHOD2>\\S+)\\([\\s\\S]*?\\)\\s+[\\s\\S]*?\\s+(?P<OPENSSL>\\S+)\\s+=\\s+OpenSSL::PKey::RSA\\.new\\([\\s\\S]*?\\)\\s+[\\s\\S]*?\\s+end\\s+[\\s\\S]*?",
      "def\\s+(?P<METHOD1>\\S+)\\([\\s\\S]*?\\)\\s+[\\s\\S]*?\\s+(?P<ASSIGN>\\S+)\\s+=\\s+'[\\s\\S]*?'\\s+[\\s\\S]*?\\s+end\\s+[\\s\\S]*?\\s+def\\s+(?P<METHOD2>\\S+)\\([\\s\\S]*?\\)\\s+[\\s\\S]*?\\s+end",
      "def\\s+(?P<METHOD1>\\S+)\\([\\s\\S]*?\\)\\s+[\\s\\S]*?\\s+(?P<OPENSSL>\\S+)\\s+=\\s+OpenSSL::PKey::RSA\\.new\\([\\s\\S]*?\\)\\s+[\\s\\S]*?\\s+(?P<ASSIGN>\\S+)\\s+=\\s+'[\\s\\S]*?'\\s+[\\s\\S]*?\\s+end\\s+[\\s\\S]*?"
    ])) as $all
    | ( ($all | of(["OpenSSL::PKey::RSA\\.new\\([\\s\\S]*?,\\s+'[\\s\\S]*?'\\)"]))
          + ($all | of(["OpenSSL::PKey::RSA\\.new\\([\\s\\S]*?\\)\\.to_pem\\([\\s\\S]*?,\\s+'[\\s\\S]*?'\\)"]))
          + ($all | of(["OpenSSL::PKey::RSA\\.new\\([\\s\\S]*?\\)\\.export\\([\\s\\S]*?,\\s+'[\\s\\S]*?'\\)"]))
          + ($all | of(["(?P<OPENSSL>\\S+)\\.export\\([\\s\\S]*?,'[\\s\\S]*?'\\)","(?P<OPENSSL>\\S+)\\.to_pem\\([\\s\\S]*?,'[\\s\\S]*?'\\)"])
          | in_files_with($all | of(["(?P<OPENSSL>\\S+)\\s+=\\s+OpenSSL::PKey::RSA\\.new\\([\\s\\S]*?\\)\\s+[\\s\\S]*?"])))
          + (($all | of(["OpenSSL::PKey::RSA\\.new\\([\\s\\S]*?,\\s+(?P<ASSIGN>\\S+)\\)"])
          | in_files_with($all | of(["(?P<ASSIGN>\\S+)\\s+=\\s+'[\\s\\S]*?'\\s+[\\s\\S]*?"])))
          + ($all | of(["OpenSSL::PKey::RSA\\.new\\([\\s\\S]*?,\\s+(?P<ASSIGN>\\S+)\\)"])
          | within($all | of(["def\\s+(?P<METHOD1>\\S+)\\([\\s\\S]*?\\)\\s+[\\s\\S]*?\\s+(?P<ASSIGN>\\S+)\\s+=\\s+'[\\s\\S]*?'\\s+[\\s\\S]*?\\s+end\\s+[\\s\\S]*?\\s+def\\s+(?P<METHOD2>\\S+)\\([\\s\\S]*?\\)\\s+[\\s\\S]*?\\s+end"])))
          + ($all | of(["(?P<OPENSSL>\\S+)\\.export\\([\\s\\S]*?,(?P<ASSIGN>\\S+)\\)","(?P<OPENSSL>\\S+)\\.to_pem\\([\\s\\S]*?,(?P<ASSIGN>\\S+)\\)"])
          | in_files_with($all | of(["(?P<ASSIGN>\\S+)\\s+=\\s+'[\\s\\S]*?'\\s+[\\s\\S]*?\\s+def\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+(?P<OPENSSL>\\S+)\\s+=\\s+OpenSSL::PKey::RSA\\.new\\([\\s\\S]*?\\)\\s+[\\s\\S]*?\\s+end\\s+[\\s\\S]*?"])))
          + ($all | of(["(?P<OPENSSL>\\S+)\\.export\\([\\s\\S]*?,(?P<ASSIGN>\\S+)\\)","(?P<OPENSSL>\\S+)\\.to_pem\\([\\s\\S]*?,(?P<ASSIGN>\\S+)\\)"])
          | in_files_with($all | of(["def\\s+(?P<METHOD1>\\S+)\\([\\s\\S]*?\\)\\s+[\\s\\S]*?\\s+(?P<OPENSSL>\\S+)\\s+=\\s+OpenSSL::PKey::RSA\\.new\\([\\s\\S]*?\\)\\s+[\\s\\S]*?\\s+(?P<ASSIGN>\\S+)\\s+=\\s+'[\\s\\S]*?'\\s+[\\s\\S]*?\\s+end\\s+[\\s\\S]*?"])))
          + ($all | of(["(?P<OPENSSL>\\S+)\\.export\\([\\s\\S]*?,(?P<ASSIGN>\\S+)\\)","(?P<OPENSSL>\\S+)\\.to_pem\\([\\s\\S]*?,(?P<ASSIGN>\\S+)\\)"])
          | in_files_with($all | of(["def\\s+(?P<METHOD1>\\S+)\\([\\s\\S]*?\\)\\s+[\\s\\S]*?\\s+(?P<ASSIGN>\\S+)\\s+=\\s+'[\\s\\S]*?'\\s+[\\s\\S]*?\\s+end\\s+[\\s\\S]*?\\s+def\\s+(?P<METHOD2>\\S+)\\([\\s\\S]*?\\)\\s+[\\s\\S]*?\\s+(?P<OPENSSL>\\S+)\\s+=\\s+OpenSSL::PKey::RSA\\.new\\([\\s\\S]*?\\)\\s+[\\s\\S]*?\\s+end\\s+[\\s\\S]*?"]))))
        | finding("hardcoded-secret-rsa-passphrase";
            "Found the use of an hardcoded passphrase for RSA.") ) )
| report
