# rules: weak-hashes-md5
# languages: ruby
# from: ruby/lang/security/weak-hashes-md5.yaml

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "Digest::MD5.base64digest $X",
      "Digest::MD5.digest $X",
      "Digest::MD5.hexdigest $X",
      "Digest::MD5.new",
      "OpenSSL::Digest::MD5.base64digest $X",
      "OpenSSL::Digest::MD5.digest $X",
      "OpenSSL::Digest::MD5.hexdigest $X",
      "OpenSSL::Digest::MD5.new"
    ])) as $all
    | ( $all | of(["Digest::MD5.base64digest $X","Digest::MD5.hexdigest $X","Digest::MD5.digest $X","Digest::MD5.new","OpenSSL::Digest::MD5.base64digest $X","OpenSSL::Digest::MD5.hexdigest $X","OpenSSL::Digest::MD5.digest $X","OpenSSL::Digest::MD5.new"])
        | finding("weak-hashes-md5";
            "Should not use md5 to generate hashes.") ) )
| report
