# rules: file-disclosure
# from: ruby/lang/security/file-disclosure.yaml

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "config.serve_static_assets = true"
    ])) as $all
    | ( $all | of(["config.serve_static_assets = true"])
        | finding("file-disclosure";
            "Special requests can determine whether a file exists on a filesystem that's outside the Rails app's root directory.") ) )
| report
