# rules: force-ssl-false
# from: ruby/lang/security/force-ssl-false.yaml

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "config.force_ssl = false"
    ])) as $all
    | ( $all | of(["config.force_ssl = false"])
        | finding("force-ssl-false";
            "Checks for configuration setting of force_ssl to false.") ) )
| report
