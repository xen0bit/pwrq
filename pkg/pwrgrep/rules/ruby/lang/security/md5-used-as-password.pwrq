# rules: md5-used-as-password
# languages: ruby
# from: ruby/lang/security/md5-used-as-password.yaml

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "$FUNCTION($$$_);",
      "Digest::MD5"
    ])) as $all
    | ( (($all | of(["$FUNCTION($$$_);"])
          | where_capture("FUNCTION"; "^(?:(?i)(.*password.*))")))
          | reaching((($all | of(["Digest::MD5"])));
              ([]))
        | finding("md5-used-as-password";
            "It looks like MD5 is used as a password hash.") ) )
| report
