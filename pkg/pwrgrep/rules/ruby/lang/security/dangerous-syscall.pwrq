# rules: dangerous-syscall
# languages: ruby
# from: ruby/lang/security/dangerous-syscall.yaml

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "syscall"
    ])) as $all
    | ( $all | of(["syscall"])
        | finding("dangerous-syscall";
            "'syscall' is essentially unsafe and unportable.") ) )
| report
