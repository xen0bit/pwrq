# rules: ruby-jwt-exposed-data
# from: ruby/jwt/security/audit/jwt-exposed-data.yaml

. as $root
| ( ($root | scan_regex(["*.rb"]; [
      "JWT\\.encode\\((?P<INPUT>\\S+),[\\s\\S]*?\\)",
      "def\\s+(?P<FUNC>\\S+)\\([\\s\\S]*?,(?P<INPUT>\\S+),[\\s\\S]*?\\)\\s+[\\s\\S]*?\\s+end",
      "require\\s+'jwt'\\s+[\\s\\S]*?"
    ])) as $all
    | ( $all | of(["JWT\\.encode\\((?P<INPUT>\\S+),[\\s\\S]*?\\)"])
          | in_files_with($all | of(["require\\s+'jwt'\\s+[\\s\\S]*?"]))
          | within($all | of(["def\\s+(?P<FUNC>\\S+)\\([\\s\\S]*?,(?P<INPUT>\\S+),[\\s\\S]*?\\)\\s+[\\s\\S]*?\\s+end"]))
        | finding("ruby-jwt-exposed-data";
            "The object is passed strictly to jsonwebtoken.sign(...) Make sure that sensitive information is not exposed through JWT token payload.") ) )
| report
