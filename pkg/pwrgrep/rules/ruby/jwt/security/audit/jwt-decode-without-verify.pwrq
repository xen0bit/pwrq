# rules: ruby-jwt-decode-without-verify
# languages: ruby
# from: ruby/jwt/security/audit/jwt-decode-without-verify.yaml

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "JWT.decode($PAYLOAD,$SECRET,false,$$$_)",
      "require 'jwt'\n$$$_"
    ])) as $all
    | ( $all | of(["JWT.decode($PAYLOAD,$SECRET,false,$$$_)"])
          | in_files_with($all | of(["require 'jwt'\n$$$_"]))
        | finding("ruby-jwt-decode-without-verify";
            "Detected the decoding of a JWT token without a verify step.") ) )
| report
