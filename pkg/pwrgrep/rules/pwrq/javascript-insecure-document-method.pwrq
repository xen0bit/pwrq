# rules: javascript-insecure-document-method
# languages: javascript
# fixture: javascript/insecure-document-method.js
# from: javascript/browser/security/insecure-document-method.yaml (insecure-document-method)
#
# CWE-79. Assigning to innerHTML parses what you assign, so a value that came
# from outside the program becomes markup, and markup runs.
#
# Three alternatives, three exclusions, and the exclusions are the same three
# calls with the value pinned to a string literal. The original writes that pin
# as `"..."`; pwrq writes it as a typed hole, $S:string, and the pairing is then
# not_at - the excluded pattern has to describe the same code, not merely
# appear in the same file.

["$EL.innerHTML = $HTML", "$EL.outerHTML = $HTML", "document.write($$$_)"] as $writes
| ["$EL.innerHTML = $S:string", "$EL.outerHTML = $S:string", "document.write($S:string)"] as $constant
| scan_ast("*.js"; $writes + $constant) as $all
| ($all | of($writes) | not_at($all | of($constant)))
| finding("javascript-insecure-document-method";
    "this parses its value as HTML, so anything in it that looks like markup is "
    + "markup; assign to textContent, or sanitise first")
| report
