# rules: javascript-spawn-shell
# languages: javascript
# fixture: javascript/spawn-shell.js
# from: javascript/lang/security/audit/spawn-shell-true.yaml (spawn-shell-true)
#
# A child process spawned through a shell, which turns the argument list back
# into a string for something else to parse.
#
# The original writes the option as `{shell: $SHELL}` and then excludes
# `{shell: false}`, rather than matching `{shell: true}` directly, because the
# option takes a shell path as readily as it takes a boolean. The port keeps
# that shape: a hole for the value, and the one safe value excluded by name.

["$CP.spawn($$$_, {shell: $S})", "$CP.spawnSync($$$_, {shell: $S})"] as $spawns
| ["$CP.spawn($$$_, {shell: false})", "$CP.spawnSync($$$_, {shell: false})"] as $off
| scan_ast("*.js"; $spawns + $off) as $all
| ($all | of($spawns) | not_at($all | of($off)))
| finding("javascript-spawn-shell";
    "spawning through a shell makes the command string syntax again; "
    + "pass the arguments as a list with shell: false")
| report
