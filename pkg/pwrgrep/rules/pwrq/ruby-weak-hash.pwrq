# rules: ruby-weak-hash
# languages: ruby
# fixture: ruby/weak-hash.rb
# from: ruby/lang/security/weak-hashes-sha1.yaml (weak-hashes-sha1)
#
# CWE-328, and the third language in this corpus to spell it differently.
#
# The original's patterns are `Digest::SHA1.$FUNC` with no argument list at
# all, because a method reference and a call to it are treated there as the
# same thing. pwrq does not: a pattern is matched as written, so a bare
# `Digest::SHA1.$FUNC` is a query for a method reference and will not find a
# call. The port adds the arguments the code has.

["Digest::SHA1.$FUNC($$$_)",
 "OpenSSL::Digest::SHA1.$FUNC($$$_)",
 "OpenSSL::HMAC.$FUNC(\"sha1\", $$$_)"] as $calls
| scan_ast("*.rb"; $calls)
| finding("ruby-weak-hash";
    "SHA-1 has a published collision, so this digest cannot stand for the data; "
    + "SHA-256 instead")
| report
