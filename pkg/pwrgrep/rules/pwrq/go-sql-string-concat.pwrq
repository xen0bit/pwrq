# rules: go-sql-string-concat
# fixture: go/sql-string-concat.go
# from: go/lang/security/audit/sqli/gosql-sqli.yaml (gosql-sqli)
#
# CWE-89. A query assembled by pasting text together is a query whose shape the
# caller decides.
#
# Three of the original's operators show up here at once. `$DB.$METHOD(...)`
# with a hole for the method name is `$DB.$M(...)`, and the two `...` around
# the argument that matters are $$$_ - the query may be the first argument or
# the second, as QueryContext shows.
#
# The exclusion is the interesting one. `pattern-not: $DB.$METHOD(..., "..." +
# "...", ...)` uses `"..."` to mean "any string literal", and pwrq spells that
# as a typed hole: $S:interpreted_string_literal. A query
# pasted together out of nothing but literals is fully decided by the program,
# so it is excluded here as it is there.
#
# The import guard is the original's, and joined by file for the reason
# go-weak-hash explains.

["$DB.$M($$$_, $X + $Y, $$$_)",
 "$DB.$M($$$_, fmt.Sprintf($F, $$$_), $$$_)"] as $built
| ["$DB.$M($$$_, $S1:interpreted_string_literal + $S2:interpreted_string_literal, $$$_)"] as $constant
| ["\"database/sql\""] as $imports
| scan_ast("*.go"; $built + $constant + $imports) as $all
| ($all | of($built)
   | not_at($all | of($constant))
   | in_files_with($all | of($imports)))
| finding("go-sql-string-concat";
    "$M is given a query built by pasting text together; "
    + "pass the value as a parameter instead")
| report
