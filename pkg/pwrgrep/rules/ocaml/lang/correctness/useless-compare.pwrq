# rules: useless-compare
# from: ocaml/lang/correctness/useless-compare.yaml

. as $root
| ( ($root | scan_ast(["*.ml"]; [
      "$MODULE.compare $X $X",
      "compare $X $X"
    ])) as $all
    | ( $all | of(["compare $X $X","$MODULE.compare $X $X"])
        | finding("useless-compare";
            "This comparison is useless because the expressions being compared are identical.") ) )
| report
