# rules: broken-input-line, prefer-read-in-binary-mode, prefer-write-in-binary-mode
# from: ocaml/lang/portability/crlf-support.yaml

. as $root
| ( ($root | scan_ast(["*.ml"]; [
      "input_line",
      "open_in",
      "open_out"
    ])) as $all
    | ( $all | of(["input_line"])
        | finding("broken-input-line";
            "'input_line' leaves a '\\r' (CR) character when reading lines from a Windows text file, whose lines end in \"\\r\\n\" (CRLF).") )
      + ( $all | of(["open_in"])
        | finding("prefer-read-in-binary-mode";
            "'open_in' behaves differently on Windows and on Unix-like systems with respect to line endings.") )
      + ( $all | of(["open_out"])
        | finding("prefer-write-in-binary-mode";
            "'open_out' behaves differently on Windows and on Unix-like systems with respect to line endings.") ) )
| report
