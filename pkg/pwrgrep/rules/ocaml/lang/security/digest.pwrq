# rules: ocamllint-digest
# languages: ocaml
# from: ocaml/lang/security/digest.yaml

. as $root
| ( ($root | scan_ast(["*.ml"]; [
      "Digest.bytes",
      "Digest.channel",
      "Digest.file",
      "Digest.string",
      "Digest.subbytes",
      "Digest.substring"
    ])) as $all
    | ( $all | of(["Digest.string","Digest.bytes","Digest.substring","Digest.subbytes","Digest.channel","Digest.file"])
        | finding("ocamllint-digest";
            "Digest uses MD5 and should not be used for security purposes.") ) )
| report
