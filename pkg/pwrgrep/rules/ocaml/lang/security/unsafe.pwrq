# rules: ocamllint-unsafe
# languages: ocaml
# from: ocaml/lang/security/unsafe.yaml

. as $root
| ( ($root | scan_ast(["*.ml"]; [
      "$X.unsafe_blit",
      "$X.unsafe_blit_string",
      "$X.unsafe_chr",
      "$X.unsafe_environment",
      "$X.unsafe_fill",
      "$X.unsafe_get",
      "$X.unsafe_getenv",
      "$X.unsafe_of_int",
      "$X.unsafe_of_string",
      "$X.unsafe_output",
      "$X.unsafe_output_string",
      "$X.unsafe_read",
      "$X.unsafe_recv",
      "$X.unsafe_recvfrom",
      "$X.unsafe_send",
      "$X.unsafe_sendto",
      "$X.unsafe_set",
      "$X.unsafe_set_int16",
      "$X.unsafe_set_int32",
      "$X.unsafe_set_int64",
      "$X.unsafe_set_int8",
      "$X.unsafe_set_uint16_ne",
      "$X.unsafe_set_uint8",
      "$X.unsafe_single_write",
      "$X.unsafe_string",
      "$X.unsafe_sub",
      "$X.unsafe_to_string",
      "$X.unsafe_write"
    ])) as $all
    | ( $all | of(["$X.unsafe_get","$X.unsafe_set","$X.unsafe_to_string","$X.unsafe_of_string","$X.unsafe_blit","$X.unsafe_blit_string","$X.unsafe_fill","$X.unsafe_to_string","$X.unsafe_getenv","$X.unsafe_environment","$X.unsafe_chr","$X.unsafe_of_int","$X.unsafe_output","$X.unsafe_output_string","$X.unsafe_read","$X.unsafe_recv","$X.unsafe_recvfrom","$X.unsafe_send","$X.unsafe_sendto","$X.unsafe_set","$X.unsafe_set_int16","$X.unsafe_set_int32","$X.unsafe_set_int64","$X.unsafe_set_int8","$X.unsafe_set_uint16_ne","$X.unsafe_set_uint8","$X.unsafe_single_write","$X.unsafe_string","$X.unsafe_sub","$X.unsafe_write"])
        | finding("ocamllint-unsafe";
            "Unsafe functions do not perform boundary checks or have other side effects, use with care.") ) )
| report
