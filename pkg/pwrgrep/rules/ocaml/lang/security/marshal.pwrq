# rules: ocamllint-marshal
# languages: ocaml
# from: ocaml/lang/security/marshal.yaml

. as $root
| ( ($root | scan_ast(["*.ml"]; [
      "Marshal.from_bytes",
      "Marshal.from_channel",
      "Marshal.from_string",
      "input_value"
    ])) as $all
    | ( $all | of(["input_value","Marshal.from_channel","Marshal.from_bytes","Marshal.from_string"])
        | finding("ocamllint-marshal";
            "Marshaling is currently not type-safe and can lead to insecure behaviour when untrusted data is marshalled.") ) )
| report
