# rules: ocamllint-bool-true, ocamllint-bool-false
# languages: ocaml
# from: ocaml/lang/best-practice/bool.yaml

. as $root
| ( ($root | scan_ast(["*.ml"]; [
      "$X != false",
      "$X <> true",
      "$X = false",
      "$X = true",
      "$X == false",
      "$X == true"
    ])) as $all
    | ( $all | of(["$X = true","$X == true","$X != false"])
        | finding("ocamllint-bool-true";
            "Comparison to boolean.") )
      + ( $all | of(["$X = false","$X == false","$X <> true"])
        | finding("ocamllint-bool-false";
            "Comparison to boolean.") ) )
| report
