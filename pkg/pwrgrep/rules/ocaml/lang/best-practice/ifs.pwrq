# rules: ocamllint-useless-else, ocamllint-backwards-if
# languages: ocaml
# from: ocaml/lang/best-practice/ifs.yaml

. as $root
| ( ($root | scan_ast(["*.ml"]; [
      "if $E then $E1 else ()",
      "if $E then () else $E2"
    ])) as $all
    | ( $all | of(["if $E then $E1 else ()"])
        | finding("ocamllint-useless-else";
            "Useless else.") )
      + ( $all | of(["if $E then () else $E2"])
        | finding("ocamllint-backwards-if";
            "Backwards if.") ) )
| report
