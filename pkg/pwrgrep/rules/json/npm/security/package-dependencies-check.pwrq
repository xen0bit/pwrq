# rules: package-dependencies-check
# from: json/npm/security/package-dependencies-check.yml

. as $root
| ( ($root | scan_regex(["*.json"]; [
      "\"_shrinkwrap\":\\s+\\{\\s+[\\s\\S]*?\\s+\\}",
      "\"dependencies\":\\s+\\{\\s+[\\s\\S]*?\\s+\\}",
      "\"devDependencies\":\\s+\\{\\s+[\\s\\S]*?\\s+\\}",
      "\"optionalDependencies\":\\s+\\{\\s+[\\s\\S]*?\\s+\\}",
      "\"peerDependencies\":\\s+\\{\\s+[\\s\\S]*?\\s+\\}",
      "\\\\\"\\[\\\\w\\\\\\-\\.\\]\\*\\\\\"\\\\s\\*:\\\\s\\*\\\\\"\\[\\\\d\\.\\]\\+\\-\\[\\\\w\\.\\]\\+\\\\\"",
      "\\\\\"\\[\\\\w\\\\\\-\\.\\]\\*\\\\\"\\\\s\\*:\\\\s\\*\\\\\"\\[\\^~\\\\\\-\\\\\\^><=\\\\\"x\\]\\*\\[~\\\\\\-\\\\\\^><=x\\]\\+\\.\\*\\\\\"",
      "\\\\\"\\[\\\\w\\\\\\-\\.\\]\\*\\\\\"\\\\s\\*:\\\\s\\*\\\\\"latest\\\\\""
    ])) as $all
    | ( $all | of(["\\\\\"\\[\\\\w\\\\\\-\\.\\]\\*\\\\\"\\\\s\\*:\\\\s\\*\\\\\"latest\\\\\"","\\\\\"\\[\\\\w\\\\\\-\\.\\]\\*\\\\\"\\\\s\\*:\\\\s\\*\\\\\"\\[\\^~\\\\\\-\\\\\\^><=\\\\\"x\\]\\*\\[~\\\\\\-\\\\\\^><=x\\]\\+\\.\\*\\\\\""])
          | at_same_place((($all
          | within($all | of(["\"dependencies\":\\s+\\{\\s+[\\s\\S]*?\\s+\\}"])))
          + ($all
          | within($all | of(["\"devDependencies\":\\s+\\{\\s+[\\s\\S]*?\\s+\\}"])))
          + ($all
          | within($all | of(["\"optionalDependencies\":\\s+\\{\\s+[\\s\\S]*?\\s+\\}"])))
          + ($all
          | within($all | of(["\"peerDependencies\":\\s+\\{\\s+[\\s\\S]*?\\s+\\}"])))))
          | not_at($all | of(["\\\\\"\\[\\\\w\\\\\\-\\.\\]\\*\\\\\"\\\\s\\*:\\\\s\\*\\\\\"\\[\\\\d\\.\\]\\+\\-\\[\\\\w\\.\\]\\+\\\\\""]))
          | outside($all | of(["\"_shrinkwrap\":\\s+\\{\\s+[\\s\\S]*?\\s+\\}"]))
        | finding("package-dependencies-check";
            "Package dependencies with variant versions may lead to dependency hijack and confusion attacks.") ) )
| report
