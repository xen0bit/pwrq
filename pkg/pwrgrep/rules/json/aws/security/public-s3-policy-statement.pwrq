# rules: public-s3-policy-statement
# from: json/aws/security/public-s3-policy-statement.yaml

. as $root
| ( ($root | scan_ast(["*.json"]; [
      "{\n  \"Effect\": \"Allow\",\n  \"Principal\": \"*\",\n  \"Resource\": [\n    $$$_, \"=~/arn:aws:s3.*/\", $$$_\n  ],\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["{\n  \"Effect\": \"Allow\",\n  \"Principal\": \"*\",\n  \"Resource\": [\n    $$$_, \"=~/arn:aws:s3.*/\", $$$_\n  ],\n  $$$_\n}"])
        | finding("public-s3-policy-statement";
            "Detected public S3 bucket policy.") ) )
| report
