# rules: wildcard-assume-role
# from: json/aws/security/wildcard-assume-role.yaml

. as $root
| ( ($root | scan_regex(["*.json"]; [
      "\"Principal\":\\s+\\{[\\s\\S]*?,\\s+\"AWS\":\\s+\"\\*\",\\s+[\\s\\S]*?\\}",
      "\"Statement\":\\s+\\[[\\s\\S]*?\\]",
      "\\{[\\s\\S]*?,\\s+\"Effect\":\\s+\"Allow\",\\s+[\\s\\S]*?,\\s+\"Action\":\\s+\"sts:AssumeRole\",\\s+[\\s\\S]*?\\}"
    ])) as $all
    | ( $all | of(["\"Principal\":\\s+\\{[\\s\\S]*?,\\s+\"AWS\":\\s+\"\\*\",\\s+[\\s\\S]*?\\}"])
          | within($all | of(["\"Statement\":\\s+\\[[\\s\\S]*?\\]"]))
          | within($all | of(["\\{[\\s\\S]*?,\\s+\"Effect\":\\s+\"Allow\",\\s+[\\s\\S]*?,\\s+\"Action\":\\s+\"sts:AssumeRole\",\\s+[\\s\\S]*?\\}"]))
        | finding("wildcard-assume-role";
            "Detected wildcard access granted to sts:AssumeRole.") ) )
| report
