# rules: session-cookie-samesitenone
# languages: go
# from: go/gorilla/security/audit/session-cookie-samesitenone.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "&sessions.Options{\n  $$$_,\n  SameSite: http.SameSiteNoneMode,\n  $$$_,\n}",
      "&sessions.Options{\n  $$$_,\n}"
    ])) as $all
    | ( $all | of(["&sessions.Options{\n  $$$_,\n}"])
          | within($all | of(["&sessions.Options{\n  $$$_,\n  SameSite: http.SameSiteNoneMode,\n  $$$_,\n}"]))
        | finding("session-cookie-samesitenone";
            "Found SameSiteNoneMode setting in Gorilla session options.") ) )
| report
