# rules: jwt-go-none-algorithm
# from: go/jwt-go/security/jwt-none-alg.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "\"github.com/dgrijalva/jwt-go\"",
      "\"github.com/golang-jwt/jwt\"",
      "import \"github.com/dgrijalva/jwt-go\"\n$$$_",
      "import \"github.com/golang-jwt/jwt\"\n$$$_",
      "jwt.SigningMethodNone",
      "jwt.UnsafeAllowNoneSignatureType"
    ])) as $all
    | ( ($all)
          + ($all)
          | at_same_place(($all | of(["jwt.SigningMethodNone","jwt.UnsafeAllowNoneSignatureType"])))
        | finding("jwt-go-none-algorithm";
            "Detected use of the 'none' algorithm in a JWT token.") ) )
| report
