# rules: jwt-go-parse-unverified
# from: go/jwt-go/security/audit/jwt-parse-unverified.yaml

. as $root
| ( ($root | scan_regex(["*.go"]; [
      "(?P<JWT>\\S+)\\.ParseUnverified\\([\\s\\S]*?\\)",
      "import\\s+\"github\\.com\\/dgrijalva\\/jwt\\-go\"\\s+[\\s\\S]*?"
    ])) as $all
    | ( $all | of(["(?P<JWT>\\S+)\\.ParseUnverified\\([\\s\\S]*?\\)"])
          | in_files_with($all | of(["import\\s+\"github\\.com\\/dgrijalva\\/jwt\\-go\"\\s+[\\s\\S]*?"]))
        | finding("jwt-go-parse-unverified";
            "Detected the decoding of a JWT token without a verify step.") ) )
| report
