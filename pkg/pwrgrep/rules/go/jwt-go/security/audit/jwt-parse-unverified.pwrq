# rules: jwt-go-parse-unverified
# from: go/jwt-go/security/audit/jwt-parse-unverified.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "\"github.com/dgrijalva/jwt-go\"",
      "$JWT.ParseUnverified($$$_)",
      "import \"github.com/dgrijalva/jwt-go\"\n$$$_"
    ])) as $all
    | ( $all | of(["$JWT.ParseUnverified($$$_)"])
          | in_files_with($all | of(["import \"github.com/dgrijalva/jwt-go\"\n$$$_","\"github.com/dgrijalva/jwt-go\""]))
        | finding("jwt-go-parse-unverified";
            "Detected the decoding of a JWT token without a verify step.") ) )
| report
