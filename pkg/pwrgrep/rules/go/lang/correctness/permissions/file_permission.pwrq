# rules: incorrect-default-permission
# languages: go
# from: go/lang/correctness/permissions/file_permission.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "ioutil.WriteFile($NAME, $DATA, $PERM)",
      "os.Chmod($NAME, $PERM)",
      "os.Mkdir($NAME, $PERM)",
      "os.MkdirAll($NAME, $PERM)",
      "os.OpenFile($NAME, $FLAG, $PERM)"
    ])) as $all
    | ( $all | of(["os.Chmod($NAME, $PERM)","os.Mkdir($NAME, $PERM)","os.OpenFile($NAME, $FLAG, $PERM)","os.MkdirAll($NAME, $PERM)","ioutil.WriteFile($NAME, $DATA, $PERM)"])
          | where_capture_compare("$PERM > 0o600")
          | focus("PERM")
        | finding("incorrect-default-permission";
            "Detected file permissions that are set to more than `0600` (user/owner can read and write).") ) )
| report
