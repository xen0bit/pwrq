# rules: no-interpolation-in-tag
# from: go/lang/security/audit/xss/no-interpolation-in-tag.yaml

. as $root
| ( ($root | scan_regex(["*.html","*.thtml","*.gohtml","*.tmpl","*.tpl"]; [
      "<\\{\\{\\s+[\\s\\S]*?\\s+\\}\\}\\s+[\\s\\S]*?\\s+>"
    ])) as $all
    | ( $all | of(["<\\{\\{\\s+[\\s\\S]*?\\s+\\}\\}\\s+[\\s\\S]*?\\s+>"])
        | finding("no-interpolation-in-tag";
            "Detected template variable interpolation in an HTML tag.") ) )
| report
