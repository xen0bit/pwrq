# rules: import-text-template
# languages: go
# from: go/lang/security/audit/xss/import-text-template.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "import \"$IMPORT\""
    ])) as $all
    | ( $all | of(["import \"$IMPORT\""])
          | where_capture("IMPORT"; "^(text/template)$")
          | focus("IMPORT")
        | finding("import-text-template";
            "When working with web applications that involve rendering user-generated content, it's important to properly escape any HTML content to prevent Cross-Site Scripting (XSS) attacks.") ) )
| report
