# rules: no-io-writestring-to-responsewriter
# languages: go
# from: go/lang/security/audit/xss/no-io-writestring-to-responsewriter.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "func $HANDLER($$$_, $WRITER http.ResponseWriter, $$$_) {\n  $$$_\n}",
      "func($$$_, $WRITER http.ResponseWriter, $$$_) {\n  $$$_\n}",
      "io.WriteString($WRITER, \"$$$_\")",
      "io.WriteString($WRITER, $STRING)"
    ])) as $all
    | ( ($all
          | within($all | of(["func $HANDLER($$$_, $WRITER http.ResponseWriter, $$$_) {\n  $$$_\n}"])))
          + ($all
          | within($all | of(["func($$$_, $WRITER http.ResponseWriter, $$$_) {\n  $$$_\n}"])))
          | at_same_place(($all | of(["io.WriteString($WRITER, $STRING)"])))
          | not_at($all | of(["io.WriteString($WRITER, \"$$$_\")"]))
        | finding("no-io-writestring-to-responsewriter";
            "Detected 'io.WriteString()' writing directly to 'http.ResponseWriter'.") ) )
| report
