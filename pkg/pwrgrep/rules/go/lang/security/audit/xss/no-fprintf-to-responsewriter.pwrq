# rules: no-fprintf-to-responsewriter
# languages: go
# from: go/lang/security/audit/xss/no-fprintf-to-responsewriter.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "fmt.$PRINTF($WRITER, \"$$$_\")",
      "fmt.$PRINTF($WRITER, $$$_)",
      "func $HANDLER($$$_, $WRITER http.ResponseWriter, $$$_) {\n  $$$_\n}",
      "func($$$_, $WRITER http.ResponseWriter, $$$_) {\n  $$$_\n}"
    ])) as $all
    | ( ($all
          | within($all | of(["func $HANDLER($$$_, $WRITER http.ResponseWriter, $$$_) {\n  $$$_\n}"])))
          + ($all
          | within($all | of(["func($$$_, $WRITER http.ResponseWriter, $$$_) {\n  $$$_\n}"])))
          | at_same_place(($all | of(["fmt.$PRINTF($WRITER, $$$_)"])))
          | not_at($all | of(["fmt.$PRINTF($WRITER, \"$$$_\")"]))
        | finding("no-fprintf-to-responsewriter";
            "Detected 'Fprintf' or similar writing to 'http.ResponseWriter'.") ) )
| report
