# rules: dangerous-exec-command
# from: go/lang/security/audit/dangerous-exec-command.yaml

. as $root
| ( ($root | scan_regex(["*.go"]; [
      "(?P<CMD>\\S+),(?P<ERR>\\S+)\\s+:=\\s+exec\\.LookPath\\(\"[\\s\\S]*?\"\\);\\s+[\\s\\S]*?",
      "(?P<CMD>\\S+)\\s+=\\s+\"[\\s\\S]*?\";\\s+[\\s\\S]*?",
      "exec\\.CommandContext\\((?P<CTX>\\S+),\"=~\\/\\(sh\\|bash\\|ksh\\|csh\\|tcsh\\|zsh\\)\\/\",\"\\-c\",(?P<CMD>\\S+),[\\s\\S]*?\\)",
      "exec\\.CommandContext\\((?P<CTX>\\S+),\"=~\\/\\\\\\/bin\\\\\\/env\\/\",\"=~\\/\\(sh\\|bash\\|ksh\\|csh\\|tcsh\\|zsh\\)\\/\",\"\\-c\",(?P<CMD>\\S+),[\\s\\S]*?\\)",
      "exec\\.CommandContext\\((?P<CTX>\\S+),\"[\\s\\S]*?\",\"[\\s\\S]*?\",\"[\\s\\S]*?\",[\\s\\S]*?\\)",
      "exec\\.CommandContext\\((?P<CTX>\\S+),\"[\\s\\S]*?\",[\\s\\S]*?\\)",
      "exec\\.CommandContext\\((?P<CTX>\\S+),(?P<CMD>\\S+),[\\s\\S]*?\\)",
      "exec\\.Command\\(\"=~\\/\\(sh\\|bash\\|ksh\\|csh\\|tcsh\\|zsh\\)\\/\",\"\\-c\",(?P<CMD>\\S+),[\\s\\S]*?\\)",
      "exec\\.Command\\(\"=~\\/\\\\\\/bin\\\\\\/env\\/\",\"=~\\/\\(sh\\|bash\\|ksh\\|csh\\|tcsh\\|zsh\\)\\/\",\"\\-c\",(?P<CMD>\\S+),[\\s\\S]*?\\)",
      "exec\\.Command\\(\"[\\s\\S]*?\",\"[\\s\\S]*?\",\"[\\s\\S]*?\",[\\s\\S]*?\\)",
      "exec\\.Command\\(\"[\\s\\S]*?\",[\\s\\S]*?\\)",
      "exec\\.Command\\((?P<CMD>\\S+),[\\s\\S]*?\\)",
      "import\\s+\"os\\/exec\"\\s+[\\s\\S]*?"
    ])) as $all
    | ( ($all | of(["exec\\.Command\\((?P<CMD>\\S+),[\\s\\S]*?\\)","exec\\.CommandContext\\((?P<CTX>\\S+),(?P<CMD>\\S+),[\\s\\S]*?\\)"])
          | not_at($all | of(["exec\\.Command\\(\"[\\s\\S]*?\",[\\s\\S]*?\\)"]))
          | not_at($all | of(["exec\\.CommandContext\\((?P<CTX>\\S+),\"[\\s\\S]*?\",[\\s\\S]*?\\)"])))
          + ($all | of(["exec\\.Command\\(\"=~\\/\\(sh\\|bash\\|ksh\\|csh\\|tcsh\\|zsh\\)\\/\",\"\\-c\",(?P<CMD>\\S+),[\\s\\S]*?\\)","exec\\.CommandContext\\((?P<CTX>\\S+),\"=~\\/\\(sh\\|bash\\|ksh\\|csh\\|tcsh\\|zsh\\)\\/\",\"\\-c\",(?P<CMD>\\S+),[\\s\\S]*?\\)"])
          | not_at($all | of(["exec\\.Command\\(\"[\\s\\S]*?\",\"[\\s\\S]*?\",\"[\\s\\S]*?\",[\\s\\S]*?\\)"]))
          | not_at($all | of(["exec\\.CommandContext\\((?P<CTX>\\S+),\"[\\s\\S]*?\",\"[\\s\\S]*?\",\"[\\s\\S]*?\",[\\s\\S]*?\\)"])))
          + ($all | of(["exec\\.Command\\(\"=~\\/\\\\\\/bin\\\\\\/env\\/\",\"=~\\/\\(sh\\|bash\\|ksh\\|csh\\|tcsh\\|zsh\\)\\/\",\"\\-c\",(?P<CMD>\\S+),[\\s\\S]*?\\)","exec\\.CommandContext\\((?P<CTX>\\S+),\"=~\\/\\\\\\/bin\\\\\\/env\\/\",\"=~\\/\\(sh\\|bash\\|ksh\\|csh\\|tcsh\\|zsh\\)\\/\",\"\\-c\",(?P<CMD>\\S+),[\\s\\S]*?\\)"]))
          | in_files_with($all | of(["import\\s+\"os\\/exec\"\\s+[\\s\\S]*?"]))
          | in_files_without($all | of(["(?P<CMD>\\S+),(?P<ERR>\\S+)\\s+:=\\s+exec\\.LookPath\\(\"[\\s\\S]*?\"\\);\\s+[\\s\\S]*?"]))
          | in_files_without($all | of(["(?P<CMD>\\S+)\\s+=\\s+\"[\\s\\S]*?\";\\s+[\\s\\S]*?"]))
        | finding("dangerous-exec-command";
            "Detected non-static command inside Command.") ) )
| report
