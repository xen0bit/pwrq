# rules: cookie-missing-httponly
# from: go/lang/security/audit/net/cookie-missing-httponly.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "http.Cookie{\n  $$$_,\n  HttpOnly: true,\n  $$$_,\n}",
      "http.Cookie{\n  $$$_,\n}"
    ])) as $all
    | ( $all | of(["http.Cookie{\n  $$$_,\n}"])
          | outside($all | of(["http.Cookie{\n  $$$_,\n  HttpOnly: true,\n  $$$_,\n}"]))
        | finding("cookie-missing-httponly";
            "A session cookie was detected without setting the 'HttpOnly' flag.") ) )
| report
