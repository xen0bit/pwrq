# rules: pprof-debug-exposure
# from: go/lang/security/audit/net/pprof.yaml

. as $root
| ( ($root | scan_regex(["*.go"]; [
      "(?P<MUX>\\S+)\\s+=\\s+http\\.NewServeMux\\([\\s\\S]*?\\)\\s+[\\s\\S]*?\\s+http\\.ListenAndServe\\((?P<ADDR>\\S+),\\s+(?P<MUX>\\S+)\\)",
      "func\\s+(?P<ANY>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}",
      "http\\.ListenAndServe\\(\"=~\\/\\^127\\[\\.\\]0\\[\\.\\]0\\[\\.\\]1\\.\\*\\/\",\\s+[\\s\\S]*?\\)",
      "http\\.ListenAndServe\\(\"=~\\/\\^localhost\\.\\*\\/\",\\s+[\\s\\S]*?\\)",
      "http\\.ListenAndServe\\([\\s\\S]*?\\)",
      "import\\s+_\\s+\"net\\/http\\/pprof\"\\s+[\\s\\S]*?"
    ])) as $all
    | ( $all | of(["http\\.ListenAndServe\\([\\s\\S]*?\\)"])
          | in_files_with($all | of(["import\\s+_\\s+\"net\\/http\\/pprof\"\\s+[\\s\\S]*?"]))
          | within($all | of(["func\\s+(?P<ANY>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}"]))
          | outside($all | of(["(?P<MUX>\\S+)\\s+=\\s+http\\.NewServeMux\\([\\s\\S]*?\\)\\s+[\\s\\S]*?\\s+http\\.ListenAndServe\\((?P<ADDR>\\S+),\\s+(?P<MUX>\\S+)\\)"]))
          | not_at($all | of(["http\\.ListenAndServe\\(\"=~\\/\\^localhost\\.\\*\\/\",\\s+[\\s\\S]*?\\)"]))
          | not_at($all | of(["http\\.ListenAndServe\\(\"=~\\/\\^127\\[\\.\\]0\\[\\.\\]0\\[\\.\\]1\\.\\*\\/\",\\s+[\\s\\S]*?\\)"]))
        | finding("pprof-debug-exposure";
            "The profiling 'pprof' endpoint is automatically exposed on /debug/pprof.") ) )
| report
