# rules: dynamic-httptrace-clienttrace
# from: go/lang/security/audit/net/dynamic-httptrace-clienttrace.yaml

. as $root
| ( ($root | scan_regex(["*.go"]; [
      "httptrace\\.WithClientTrace\\((?P<ANY>\\S+),\\s+(?P<TRACE>\\S+)\\)",
      "package\\s+(?P<PACKAGE>\\S+)\\s+[\\s\\S]*?\\s+&httptrace\\.ClientTrace\\s+\\{\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?"
    ])) as $all
    | ( $all | of(["httptrace\\.WithClientTrace\\((?P<ANY>\\S+),\\s+(?P<TRACE>\\S+)\\)"])
          | in_files_without($all | of(["package\\s+(?P<PACKAGE>\\S+)\\s+[\\s\\S]*?\\s+&httptrace\\.ClientTrace\\s+\\{\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?"]))
        | finding("dynamic-httptrace-clienttrace";
            "Detected a potentially dynamic ClientTrace.") ) )
| report
