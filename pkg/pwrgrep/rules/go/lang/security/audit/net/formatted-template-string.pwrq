# rules: formatted-template-string
# languages: go
# from: go/lang/security/audit/net/formatted-template-string.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "$T = \"$$$_\"\n$$$_\n$OTHER, $ERR = fmt.$P($$$_, $T, $$$_)\n$$$_\ntemplate.HTML($OTHER, $$$_)",
      "$T = \"$$$_\"\n$$$_\n$T = $FXN($$$_, $T, $$$_)\n$$$_\ntemplate.HTML($T, $$$_)",
      "$T = $X + $Y\n$$$_\ntemplate.HTML($T, $$$_)",
      "$T = fmt.$P(\"$$$_\", $$$_)\n$$$_\ntemplate.HTML($T, $$$_)",
      "$T, $ERR = fmt.$P(\"$$$_\", $$$_)\n$$$_\ntemplate.HTML($T, $$$_)",
      "template.HTML(\"$$$_\" + \"$$$_\")",
      "template.HTML($T + $X, $$$_)",
      "template.HTML(fmt.$P(\"$$$_\", $$$_), $$$_)"
    ])) as $all
    | ( $all | of(["template.HTML($T + $X, $$$_)","template.HTML(fmt.$P(\"$$$_\", $$$_), $$$_)","$T = \"$$$_\"\n$$$_\n$T = $FXN($$$_, $T, $$$_)\n$$$_\ntemplate.HTML($T, $$$_)","$T = fmt.$P(\"$$$_\", $$$_)\n$$$_\ntemplate.HTML($T, $$$_)","$T, $ERR = fmt.$P(\"$$$_\", $$$_)\n$$$_\ntemplate.HTML($T, $$$_)","$T = $X + $Y\n$$$_\ntemplate.HTML($T, $$$_)","$T = \"$$$_\"\n$$$_\n$OTHER, $ERR = fmt.$P($$$_, $T, $$$_)\n$$$_\ntemplate.HTML($OTHER, $$$_)"])
          | not_at($all | of(["template.HTML(\"$$$_\" + \"$$$_\")"]))
        | finding("formatted-template-string";
            "Found a formatted template string passed to 'template.HTML()'.") ) )
| report
