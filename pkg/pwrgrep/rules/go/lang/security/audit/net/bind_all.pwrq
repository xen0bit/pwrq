# rules: avoid-bind-to-all-interfaces
# languages: go
# from: go/lang/security/audit/net/bind_all.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "net.Listen($NETWORK, \"=~/^0.0.0.0:.*$/\", $$$_)",
      "net.Listen($NETWORK, \"=~/^:.*$/\", $$$_)",
      "tls.Listen($NETWORK, \"=~/^0.0.0.0:.*$/\", $$$_)",
      "tls.Listen($NETWORK, \"=~/^:.*$/\", $$$_)"
    ])) as $all
    | ( $all | of(["tls.Listen($NETWORK, \"=~/^0.0.0.0:.*$/\", $$$_)","net.Listen($NETWORK, \"=~/^0.0.0.0:.*$/\", $$$_)","tls.Listen($NETWORK, \"=~/^:.*$/\", $$$_)","net.Listen($NETWORK, \"=~/^:.*$/\", $$$_)"])
        | finding("avoid-bind-to-all-interfaces";
            "Detected a network listener listening on 0.0.0.0 or an empty string.") ) )
| report
