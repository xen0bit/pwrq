# rules: unescaped-data-in-js
# languages: go
# from: go/lang/security/audit/net/unescaped-data-in-js.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "$T = \"$$$_\"\n$$$_\n$OTHER, $ERR = fmt.$P($$$_, $T, $$$_)\n$$$_\ntemplate.JS($OTHER, $$$_)",
      "$T = \"$$$_\"\n$$$_\n$T = $FXN($$$_, $T, $$$_)\n$$$_\ntemplate.JS($T, $$$_)",
      "$T = $X + $Y\n$$$_\ntemplate.JS($T, $$$_)",
      "$T = fmt.$P(\"$$$_\", $$$_)\n$$$_\ntemplate.JS($T, $$$_)",
      "$T, $ERR = fmt.$P(\"$$$_\", $$$_)\n$$$_\ntemplate.JS($T, $$$_)",
      "template.JS($T + $X, $$$_)",
      "template.JS(fmt.$P(\"$$$_\", $$$_), $$$_)"
    ])) as $all
    | ( $all | of(["template.JS($T + $X, $$$_)","template.JS(fmt.$P(\"$$$_\", $$$_), $$$_)","$T = \"$$$_\"\n$$$_\n$T = $FXN($$$_, $T, $$$_)\n$$$_\ntemplate.JS($T, $$$_)","$T = fmt.$P(\"$$$_\", $$$_)\n$$$_\ntemplate.JS($T, $$$_)","$T, $ERR = fmt.$P(\"$$$_\", $$$_)\n$$$_\ntemplate.JS($T, $$$_)","$T = $X + $Y\n$$$_\ntemplate.JS($T, $$$_)","$T = \"$$$_\"\n$$$_\n$OTHER, $ERR = fmt.$P($$$_, $T, $$$_)\n$$$_\ntemplate.JS($OTHER, $$$_)"])
        | finding("unescaped-data-in-js";
            "Found a formatted template string passed to 'template.JS()'.") ) )
| report
