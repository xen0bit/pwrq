# rules: dangerous-exec-cmd
# from: go/lang/security/audit/dangerous-exec-cmd.yaml

. as $root
| ( ($root | scan_regex(["*.go"]; [
      "(?P<ARGS>\\S+)\\s+=\\s+\\[\\]string\\{\"[\\s\\S]*?\",[\\s\\S]*?\\};\\s+[\\s\\S]*?",
      "(?P<CMD>\\S+),(?P<ERR>\\S+)\\s+:=\\s+exec\\.LookPath\\(\"=~\\/\\(sh\\|bash\\|ksh\\|csh\\|tcsh\\|zsh\\)\\/\"\\);\\s+[\\s\\S]*?",
      "(?P<CMD>\\S+),(?P<ERR>\\S+)\\s+:=\\s+exec\\.LookPath\\(\"[\\s\\S]*?\"\\);\\s+[\\s\\S]*?",
      "(?P<CMD>\\S+)\\s+=\\s+\"[\\s\\S]*?\";\\s+[\\s\\S]*?",
      "(?P<CMD>\\S+)\\s+=\\s+\"[\\s\\S]*?\";\\s+[\\s\\S]*?\\s+(?P<ARGS>\\S+)\\s+=\\s+\\[\\]string\\{(?P<CMD>\\S+),[\\s\\S]*?\\};\\s+[\\s\\S]*?",
      "(?P<CMD>\\S+)\\s+=\\s+exec\\.LookPath\\(\"[\\s\\S]*?\"\\);\\s+[\\s\\S]*?\\s+(?P<ARGS>\\S+)\\s+=\\s+\\[\\]string\\{(?P<CMD>\\S+),[\\s\\S]*?\\};\\s+[\\s\\S]*?",
      "(?P<EXE>\\S+)\\s+=\\s+\"[\\s\\S]*?\";\\s+[\\s\\S]*?",
      "exec\\.Cmd\\s+\\{[\\s\\S]*?,Args:\\s+(?P<ARGS>\\S+),[\\s\\S]*?\\}",
      "exec\\.Cmd\\s+\\{[\\s\\S]*?,Args:\\s+\\[\\]string\\{\"=~\\/\\(sh\\|bash\\|ksh\\|csh\\|tcsh\\|zsh\\)\\/\",\"\\-c\",(?P<EXE>\\S+),[\\s\\S]*?\\},[\\s\\S]*?\\}",
      "exec\\.Cmd\\s+\\{[\\s\\S]*?,Args:\\s+\\[\\]string\\{\"[\\s\\S]*?\",\"[\\s\\S]*?\",\"[\\s\\S]*?\",[\\s\\S]*?\\},[\\s\\S]*?\\}",
      "exec\\.Cmd\\s+\\{[\\s\\S]*?,Args:\\s+\\[\\]string\\{\"[\\s\\S]*?\",[\\s\\S]*?\\},[\\s\\S]*?\\}",
      "exec\\.Cmd\\s+\\{[\\s\\S]*?,Args:\\s+\\[\\]string\\{(?P<CMD>\\S+),\"\\-c\",(?P<EXE>\\S+),[\\s\\S]*?\\},[\\s\\S]*?\\}",
      "exec\\.Cmd\\s+\\{[\\s\\S]*?,Args:\\s+\\[\\]string\\{(?P<CMD>\\S+),[\\s\\S]*?\\},[\\s\\S]*?\\}",
      "exec\\.Cmd\\s+\\{[\\s\\S]*?,Args:\\s+\\[\\]string\\{[\\s\\S]*?\\},[\\s\\S]*?\\}",
      "exec\\.Cmd\\s+\\{[\\s\\S]*?,Path:\\s+\"[\\s\\S]*?\",[\\s\\S]*?\\}",
      "exec\\.Cmd\\s+\\{[\\s\\S]*?,Path:\\s+(?P<CMD>\\S+),[\\s\\S]*?\\}",
      "import\\s+\"os\\/exec\"\\s+[\\s\\S]*?"
    ])) as $all
    | ( ($all | of(["exec\\.Cmd\\s+\\{[\\s\\S]*?,Path:\\s+(?P<CMD>\\S+),[\\s\\S]*?\\}"])
          | not_at($all | of(["exec\\.Cmd\\s+\\{[\\s\\S]*?,Path:\\s+\"[\\s\\S]*?\",[\\s\\S]*?\\}"]))
          | in_files_without($all | of(["(?P<CMD>\\S+),(?P<ERR>\\S+)\\s+:=\\s+exec\\.LookPath\\(\"[\\s\\S]*?\"\\);\\s+[\\s\\S]*?"]))
          | in_files_without($all | of(["(?P<CMD>\\S+)\\s+=\\s+\"[\\s\\S]*?\";\\s+[\\s\\S]*?"])))
          + ($all | of(["exec\\.Cmd\\s+\\{[\\s\\S]*?,Args:\\s+(?P<ARGS>\\S+),[\\s\\S]*?\\}"])
          | not_at($all | of(["exec\\.Cmd\\s+\\{[\\s\\S]*?,Args:\\s+\\[\\]string\\{[\\s\\S]*?\\},[\\s\\S]*?\\}"]))
          | in_files_without($all | of(["(?P<ARGS>\\S+)\\s+=\\s+\\[\\]string\\{\"[\\s\\S]*?\",[\\s\\S]*?\\};\\s+[\\s\\S]*?"]))
          | in_files_without($all | of(["(?P<CMD>\\S+)\\s+=\\s+\"[\\s\\S]*?\";\\s+[\\s\\S]*?\\s+(?P<ARGS>\\S+)\\s+=\\s+\\[\\]string\\{(?P<CMD>\\S+),[\\s\\S]*?\\};\\s+[\\s\\S]*?"]))
          | in_files_without($all | of(["(?P<CMD>\\S+)\\s+=\\s+exec\\.LookPath\\(\"[\\s\\S]*?\"\\);\\s+[\\s\\S]*?\\s+(?P<ARGS>\\S+)\\s+=\\s+\\[\\]string\\{(?P<CMD>\\S+),[\\s\\S]*?\\};\\s+[\\s\\S]*?"])))
          + ($all | of(["exec\\.Cmd\\s+\\{[\\s\\S]*?,Args:\\s+\\[\\]string\\{(?P<CMD>\\S+),[\\s\\S]*?\\},[\\s\\S]*?\\}"])
          | not_at($all | of(["exec\\.Cmd\\s+\\{[\\s\\S]*?,Args:\\s+\\[\\]string\\{\"[\\s\\S]*?\",[\\s\\S]*?\\},[\\s\\S]*?\\}"]))
          | in_files_without($all | of(["(?P<CMD>\\S+),(?P<ERR>\\S+)\\s+:=\\s+exec\\.LookPath\\(\"[\\s\\S]*?\"\\);\\s+[\\s\\S]*?"]))
          | in_files_without($all | of(["(?P<CMD>\\S+)\\s+=\\s+\"[\\s\\S]*?\";\\s+[\\s\\S]*?"])))
          + (($all | of(["exec\\.Cmd\\s+\\{[\\s\\S]*?,Args:\\s+\\[\\]string\\{\"=~\\/\\(sh\\|bash\\|ksh\\|csh\\|tcsh\\|zsh\\)\\/\",\"\\-c\",(?P<EXE>\\S+),[\\s\\S]*?\\},[\\s\\S]*?\\}"]))
          + ($all | of(["exec\\.Cmd\\s+\\{[\\s\\S]*?,Args:\\s+\\[\\]string\\{(?P<CMD>\\S+),\"\\-c\",(?P<EXE>\\S+),[\\s\\S]*?\\},[\\s\\S]*?\\}"])
          | in_files_with($all | of(["(?P<CMD>\\S+),(?P<ERR>\\S+)\\s+:=\\s+exec\\.LookPath\\(\"=~\\/\\(sh\\|bash\\|ksh\\|csh\\|tcsh\\|zsh\\)\\/\"\\);\\s+[\\s\\S]*?"])))
          | not_at($all | of(["exec\\.Cmd\\s+\\{[\\s\\S]*?,Args:\\s+\\[\\]string\\{\"[\\s\\S]*?\",\"[\\s\\S]*?\",\"[\\s\\S]*?\",[\\s\\S]*?\\},[\\s\\S]*?\\}"]))
          | in_files_without($all | of(["(?P<EXE>\\S+)\\s+=\\s+\"[\\s\\S]*?\";\\s+[\\s\\S]*?"])))
          | in_files_with($all | of(["import\\s+\"os\\/exec\"\\s+[\\s\\S]*?"]))
        | finding("dangerous-exec-cmd";
            "Detected non-static command inside exec.Cmd.") ) )
| report
