# rules: pg-orm-sqli
# from: go/lang/security/audit/sqli/pg-orm-sqli.yaml

. as $root
| ( ($root | scan_regex(["*.go"]; [
      "\"[\\s\\S]*?\"",
      "(?P<DB>\\S+)\\.(?P<INTFUNC1>\\S+)\\([\\s\\S]*?\\)\\.(?P<METHOD>\\S+)\\([\\s\\S]*?,\\s+\"[\\s\\S]*?\",\\s+[\\s\\S]*?\\)\\.(?P<INTFUNC2>\\S+)\\([\\s\\S]*?\\)",
      "(?P<DB>\\S+)\\.(?P<INTFUNC1>\\S+)\\([\\s\\S]*?\\)\\.(?P<METHOD>\\S+)\\([\\s\\S]*?,\\s+(?P<X>\\S+)\\s+\\+\\s+(?P<Y>\\S+),\\s+[\\s\\S]*?\\)\\.(?P<INTFUNC2>\\S+)\\([\\s\\S]*?\\)",
      "(?P<DB>\\S+)\\.(?P<METHOD>\\S+)\\([\\s\\S]*?,\"[\\s\\S]*?\",[\\s\\S]*?\\)",
      "(?P<DB>\\S+)\\.(?P<METHOD>\\S+)\\([\\s\\S]*?,(?P<QUERY>\\S+),[\\s\\S]*?\\)",
      "(?P<DB>\\S+)\\.(?P<METHOD>\\S+)\\([\\s\\S]*?,\\s+fmt\\.Sprintf\\(\"[\\s\\S]*?\",\\s+(?P<PARAM1>\\S+),\\s+[\\s\\S]*?\\),\\s+[\\s\\S]*?\\)",
      "(?P<DB>\\S+)\\s+=\\s+pg\\.Connect\\([\\s\\S]*?\\)\\s+[\\s\\S]*?",
      "(?P<QUERY>\\S+)\\s+=\\s+\"[\\s\\S]*?\"\\s+\\+\\s+\"[\\s\\S]*?\"",
      "(?P<QUERY>\\S+)\\s+=\\s+\"[\\s\\S]*?\"\\s+\\+\\s+\"[\\s\\S]*?\"\\s+[\\s\\S]*?",
      "(?P<QUERY>\\S+)\\s+=\\s+(?P<X>\\S+)\\s+\\+\\s+(?P<Y>\\S+)\\s+[\\s\\S]*?",
      "(?P<QUERY>\\S+)\\s+=\\s+fmt\\.Sprintf\\(\"[\\s\\S]*?\",\\s+(?P<PARAM1>\\S+),\\s+[\\s\\S]*?\\)\\s+[\\s\\S]*?",
      "(?P<QUERY>\\S+)\\s+=\\s+fmt\\.Sprintf\\(\"[\\s\\S]*?\",\\s+[\\s\\S]*?,\"[\\s\\S]*?\",\\s+[\\s\\S]*?\\)\\s+[\\s\\S]*?",
      "(?P<QUERY>\\S+)\\s+\\+=\\s+\"[\\s\\S]*?\"\\s+[\\s\\S]*?",
      "(?P<QUERY>\\S+)\\s+\\+=\\s+(?P<X>\\S+)\\s+[\\s\\S]*?",
      "filepath\\.Join\\([\\s\\S]*?\\)",
      "func\\s+(?P<FUNCNAME>\\S+)\\([\\s\\S]*?,\\s+(?P<DB>\\S+)\\s+\\*pg\\.DB,\\s+[\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}",
      "import\\s+\\(\\s+[\\s\\S]*?\\s+\"(?P<IMPORT>\\S+)\"\\s+\\)\\s+[\\s\\S]*?",
      "path\\.Join\\([\\s\\S]*?\\)"
    ])) as $all
    | ( ($all | of(["(?P<DB>\\S+)\\.(?P<METHOD>\\S+)\\([\\s\\S]*?,(?P<QUERY>\\S+),[\\s\\S]*?\\)"])
          | at_same_place((($all
          | in_files_with($all | of(["(?P<QUERY>\\S+)\\s+=\\s+(?P<X>\\S+)\\s+\\+\\s+(?P<Y>\\S+)\\s+[\\s\\S]*?"])))
          + ($all
          | in_files_with($all | of(["(?P<QUERY>\\S+)\\s+\\+=\\s+(?P<X>\\S+)\\s+[\\s\\S]*?"])))
          + ($all
          | in_files_with($all | of(["(?P<QUERY>\\S+)\\s+=\\s+fmt\\.Sprintf\\(\"[\\s\\S]*?\",\\s+(?P<PARAM1>\\S+),\\s+[\\s\\S]*?\\)\\s+[\\s\\S]*?","\"[\\s\\S]*?\""])))))
          | in_files_without($all | of(["(?P<QUERY>\\S+)\\s+\\+=\\s+\"[\\s\\S]*?\"\\s+[\\s\\S]*?","\"[\\s\\S]*?\""]))
          | in_files_without($all | of(["(?P<QUERY>\\S+)\\s+=\\s+\"[\\s\\S]*?\"\\s+\\+\\s+\"[\\s\\S]*?\"\\s+[\\s\\S]*?"])))
          + ($all | of(["(?P<DB>\\S+)\\.(?P<INTFUNC1>\\S+)\\([\\s\\S]*?\\)\\.(?P<METHOD>\\S+)\\([\\s\\S]*?,\\s+(?P<X>\\S+)\\s+\\+\\s+(?P<Y>\\S+),\\s+[\\s\\S]*?\\)\\.(?P<INTFUNC2>\\S+)\\([\\s\\S]*?\\)"]))
          + ($all | of(["(?P<DB>\\S+)\\.(?P<METHOD>\\S+)\\([\\s\\S]*?,\\s+fmt\\.Sprintf\\(\"[\\s\\S]*?\",\\s+(?P<PARAM1>\\S+),\\s+[\\s\\S]*?\\),\\s+[\\s\\S]*?\\)"]))
          + ($all
          | in_files_with($all | of(["(?P<DB>\\S+)\\s+=\\s+pg\\.Connect\\([\\s\\S]*?\\)\\s+[\\s\\S]*?"])))
          + ($all
          | within($all | of(["func\\s+(?P<FUNCNAME>\\S+)\\([\\s\\S]*?,\\s+(?P<DB>\\S+)\\s+\\*pg\\.DB,\\s+[\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}"])))
          | in_files_with($all | of(["import\\s+\\(\\s+[\\s\\S]*?\\s+\"(?P<IMPORT>\\S+)\"\\s+\\)\\s+[\\s\\S]*?"]))
          | where_capture("IMPORT"; "^(?:.*go-pg)")
          | in_files_without($all | of(["(?P<QUERY>\\S+)\\s+=\\s+fmt\\.Sprintf\\(\"[\\s\\S]*?\",\\s+[\\s\\S]*?,\"[\\s\\S]*?\",\\s+[\\s\\S]*?\\)\\s+[\\s\\S]*?"]))
          | in_files_without($all | of(["(?P<QUERY>\\S+)\\s+\\+=\\s+\"[\\s\\S]*?\"\\s+[\\s\\S]*?","\"[\\s\\S]*?\""]))
          | not_at($all | of(["(?P<DB>\\S+)\\.(?P<METHOD>\\S+)\\([\\s\\S]*?,\"[\\s\\S]*?\",[\\s\\S]*?\\)"]))
          | not_at($all | of(["(?P<DB>\\S+)\\.(?P<INTFUNC1>\\S+)\\([\\s\\S]*?\\)\\.(?P<METHOD>\\S+)\\([\\s\\S]*?,\\s+\"[\\s\\S]*?\",\\s+[\\s\\S]*?\\)\\.(?P<INTFUNC2>\\S+)\\([\\s\\S]*?\\)"]))
          | outside($all | of(["(?P<QUERY>\\S+)\\s+=\\s+\"[\\s\\S]*?\"\\s+\\+\\s+\"[\\s\\S]*?\""]))
          | not_at($all | of(["\"[\\s\\S]*?\""]))
          | not_at($all | of(["path\\.Join\\([\\s\\S]*?\\)"]))
          | not_at($all | of(["filepath\\.Join\\([\\s\\S]*?\\)"]))
          | where_capture("METHOD"; "^(Where|WhereOr|Join|GroupExpr|OrderExpr|ColumnExpr)$")
        | finding("pg-orm-sqli";
            "Detected string concatenation with a non-literal variable in a go-pg ORM SQL statement.") ) )
| report
