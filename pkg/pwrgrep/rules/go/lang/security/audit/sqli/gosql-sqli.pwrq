# rules: gosql-sqli
# from: go/lang/security/audit/sqli/gosql-sqli.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "\"$$$_\"",
      "$DB, $$$_ = sql.Open($$$_)\n$$$_",
      "$DB.$METHOD($$$_, \"$$$_\" + \"$$$_\", $$$_)",
      "$DB.$METHOD($$$_, $X + $Y, $$$_)",
      "$DB.$METHOD($$$_, fmt.Sprintf(\"$$$_\", $PARAM1, $$$_), $$$_)",
      "$DB.$METHOD($$$_,$QUERY,$$$_)",
      "$QUERY += \"$$$_\"\n$$$_",
      "$QUERY += $X\n$$$_",
      "$QUERY = \"$$$_\" + \"$$$_\"\n$$$_",
      "$QUERY = $X + $Y\n$$$_",
      "$QUERY = fmt.Sprintf(\"$$$_\", $PARAM1, $$$_)\n$$$_",
      "func $FUNCNAME($$$_, $DB *sql.DB, $$$_) {\n  $$$_\n}"
    ])) as $all
    | ( ($all | of(["$DB.$METHOD($$$_,$QUERY,$$$_)"])
          | at_same_place((($all)
          + ($all)
          + ($all)))
          | in_files_without($all | of(["$QUERY += \"$$$_\"\n$$$_","\"$$$_\""]))
          | in_files_without($all | of(["$QUERY = \"$$$_\" + \"$$$_\"\n$$$_"])))
          + ($all | of(["$DB.$METHOD($$$_, $X + $Y, $$$_)"]))
          + ($all | of(["$DB.$METHOD($$$_, fmt.Sprintf(\"$$$_\", $PARAM1, $$$_), $$$_)"]))
          | at_same_place((($all)
          + ($all)))
          | not_at($all | of(["$DB.$METHOD($$$_, \"$$$_\" + \"$$$_\", $$$_)"]))
          | where_capture("METHOD"; "^(Exec|ExecContent|Query|QueryContext|QueryRow|QueryRowContext)$")
        | finding("gosql-sqli";
            "Detected string concatenation with a non-literal variable in a \"database/sql\" Go SQL statement.") ) )
| report
