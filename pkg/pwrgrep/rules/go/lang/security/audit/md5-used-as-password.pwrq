# rules: md5-used-as-password
# languages: go
# from: go/lang/security/audit/md5-used-as-password.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "$FUNCTION($$$_)",
      "md5.New",
      "md5.Sum"
    ])) as $all
    | ( (($all | of(["$FUNCTION($$$_)"])
          | where_capture("FUNCTION"; "^(?:(?i)(.*password.*))")))
          | reaching((($all | of(["md5.New","md5.Sum"])));
              ([]))
        | finding("md5-used-as-password";
            "It looks like MD5 is used as a password hash.") ) )
| report
