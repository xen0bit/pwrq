# rules: dangerous-syscall-exec
# from: go/lang/security/audit/dangerous-syscall-exec.yaml

. as $root
| ( ($root | scan_regex(["*.go"]; [
      "(?P<ARGS>\\S+)\\s+:=\\s+\\[\\]string\\{\"=~\\/\\(sh\\|bash\\|ksh\\|csh\\|tcsh\\|zsh\\)\\/\",\"\\-c\",(?P<EXE>\\S+),[\\s\\S]*?\\};\\s+[\\s\\S]*?",
      "(?P<ARGS>\\S+)\\s+:=\\s+\\[\\]string\\{\"[\\s\\S]*?\",\"[\\s\\S]*?\",\"[\\s\\S]*?\",[\\s\\S]*?\\};\\s+[\\s\\S]*?",
      "(?P<ARGS>\\S+)\\s+:=\\s+\\[\\]string\\{\"[\\s\\S]*?\",[\\s\\S]*?\\};\\s+[\\s\\S]*?",
      "(?P<BIN>\\S+),(?P<ERR>\\S+)\\s+:=\\s+exec\\.LookPath\\(\"[\\s\\S]*?\"\\);\\s+[\\s\\S]*?",
      "(?P<BIN>\\S+)\\s+=\\s+\"[\\s\\S]*?\";\\s+[\\s\\S]*?",
      "(?P<CMD>\\S+),(?P<ERR>\\S+)\\s+:=\\s+exec\\.LookPath\\(\"=~\\/\\(sh\\|bash\\|ksh\\|csh\\|tcsh\\|zsh\\)\\/\"\\);\\s+[\\s\\S]*?\\s+(?P<ARGS>\\S+)\\s+=\\s+\\[\\]string\\{(?P<CMD>\\S+),\"\\-c\",(?P<EXE>\\S+),[\\s\\S]*?\\};\\s+[\\s\\S]*?",
      "(?P<CMD>\\S+),(?P<ERR>\\S+)\\s+:=\\s+exec\\.LookPath\\(\"[\\s\\S]*?\"\\);\\s+[\\s\\S]*?\\s+(?P<ARGS>\\S+)\\s+=\\s+\\[\\]string\\{(?P<CMD>\\S+),\"[\\s\\S]*?\",\"[\\s\\S]*?\",[\\s\\S]*?\\};\\s+[\\s\\S]*?",
      "(?P<CMD>\\S+),(?P<ERR>\\S+)\\s+:=\\s+exec\\.LookPath\\(\"[\\s\\S]*?\"\\);\\s+[\\s\\S]*?\\s+(?P<ARGS>\\S+)\\s+=\\s+\\[\\]string\\{(?P<CMD>\\S+),[\\s\\S]*?\\};\\s+[\\s\\S]*?",
      "(?P<CMD>\\S+)\\s+=\\s+\"=~\\/\\(sh\\|bash\\|ksh\\|csh\\|tcsh\\|zsh\\)\\/\";\\s+[\\s\\S]*?\\s+(?P<ARGS>\\S+)\\s+=\\s+\\[\\]string\\{(?P<CMD>\\S+),\"\\-c\",(?P<EXE>\\S+),[\\s\\S]*?\\};\\s+[\\s\\S]*?",
      "(?P<CMD>\\S+)\\s+=\\s+\"[\\s\\S]*?\";\\s+[\\s\\S]*?\\s+(?P<ARGS>\\S+)\\s+=\\s+\\[\\]string\\{(?P<CMD>\\S+),\"[\\s\\S]*?\",\"[\\s\\S]*?\",[\\s\\S]*?\\};\\s+[\\s\\S]*?",
      "(?P<CMD>\\S+)\\s+=\\s+\"[\\s\\S]*?\";\\s+[\\s\\S]*?\\s+(?P<ARGS>\\S+)\\s+=\\s+\\[\\]string\\{(?P<CMD>\\S+),[\\s\\S]*?\\};\\s+[\\s\\S]*?",
      "import\\s+\"syscall\"\\s+[\\s\\S]*?",
      "syscall\\.(?P<METHOD>\\S+)\\(\"[\\s\\S]*?\",[\\s\\S]*?\\)",
      "syscall\\.(?P<METHOD>\\S+)\\((?P<BIN>\\S+),(?P<ARGS>\\S+),[\\s\\S]*?\\)",
      "syscall\\.(?P<METHOD>\\S+)\\((?P<BIN>\\S+),[\\s\\S]*?\\)",
      "syscall\\.(?P<METHOD>\\S+)\\((?P<BIN>\\S+),\\[\\]string\\{\"=~\\/\\(sh\\|bash\\|ksh\\|csh\\|tcsh\\|zsh\\)\\/\",\"\\-c\",(?P<EXE>\\S+),[\\s\\S]*?\\},[\\s\\S]*?\\)",
      "syscall\\.(?P<METHOD>\\S+)\\((?P<BIN>\\S+),\\[\\]string\\{\"[\\s\\S]*?\",\"[\\s\\S]*?\",\"[\\s\\S]*?\",[\\s\\S]*?\\},[\\s\\S]*?\\)",
      "syscall\\.(?P<METHOD>\\S+)\\((?P<BIN>\\S+),\\[\\]string\\{\"[\\s\\S]*?\",[\\s\\S]*?\\},[\\s\\S]*?\\)"
    ])) as $all
    | ( ($all | of(["syscall\\.(?P<METHOD>\\S+)\\((?P<BIN>\\S+),[\\s\\S]*?\\)"])
          | not_at($all | of(["syscall\\.(?P<METHOD>\\S+)\\(\"[\\s\\S]*?\",[\\s\\S]*?\\)"]))
          | in_files_without($all | of(["(?P<BIN>\\S+),(?P<ERR>\\S+)\\s+:=\\s+exec\\.LookPath\\(\"[\\s\\S]*?\"\\);\\s+[\\s\\S]*?"]))
          | in_files_without($all | of(["(?P<BIN>\\S+)\\s+=\\s+\"[\\s\\S]*?\";\\s+[\\s\\S]*?"])))
          + ($all | of(["syscall\\.(?P<METHOD>\\S+)\\((?P<BIN>\\S+),(?P<ARGS>\\S+),[\\s\\S]*?\\)"])
          | not_at($all | of(["syscall\\.(?P<METHOD>\\S+)\\((?P<BIN>\\S+),\\[\\]string\\{\"[\\s\\S]*?\",[\\s\\S]*?\\},[\\s\\S]*?\\)"]))
          | in_files_without($all | of(["(?P<ARGS>\\S+)\\s+:=\\s+\\[\\]string\\{\"[\\s\\S]*?\",[\\s\\S]*?\\};\\s+[\\s\\S]*?"]))
          | in_files_without($all | of(["(?P<CMD>\\S+)\\s+=\\s+\"[\\s\\S]*?\";\\s+[\\s\\S]*?\\s+(?P<ARGS>\\S+)\\s+=\\s+\\[\\]string\\{(?P<CMD>\\S+),[\\s\\S]*?\\};\\s+[\\s\\S]*?"]))
          | in_files_without($all | of(["(?P<CMD>\\S+),(?P<ERR>\\S+)\\s+:=\\s+exec\\.LookPath\\(\"[\\s\\S]*?\"\\);\\s+[\\s\\S]*?\\s+(?P<ARGS>\\S+)\\s+=\\s+\\[\\]string\\{(?P<CMD>\\S+),[\\s\\S]*?\\};\\s+[\\s\\S]*?"])))
          + ($all | of(["syscall\\.(?P<METHOD>\\S+)\\((?P<BIN>\\S+),\\[\\]string\\{\"=~\\/\\(sh\\|bash\\|ksh\\|csh\\|tcsh\\|zsh\\)\\/\",\"\\-c\",(?P<EXE>\\S+),[\\s\\S]*?\\},[\\s\\S]*?\\)"])
          | not_at($all | of(["syscall\\.(?P<METHOD>\\S+)\\((?P<BIN>\\S+),\\[\\]string\\{\"[\\s\\S]*?\",\"[\\s\\S]*?\",\"[\\s\\S]*?\",[\\s\\S]*?\\},[\\s\\S]*?\\)"])))
          + ($all | of(["syscall\\.(?P<METHOD>\\S+)\\((?P<BIN>\\S+),(?P<ARGS>\\S+),[\\s\\S]*?\\)"])
          | at_same_place((($all
          | in_files_with($all | of(["(?P<ARGS>\\S+)\\s+:=\\s+\\[\\]string\\{\"=~\\/\\(sh\\|bash\\|ksh\\|csh\\|tcsh\\|zsh\\)\\/\",\"\\-c\",(?P<EXE>\\S+),[\\s\\S]*?\\};\\s+[\\s\\S]*?"])))
          + ($all
          | in_files_with($all | of(["(?P<CMD>\\S+)\\s+=\\s+\"=~\\/\\(sh\\|bash\\|ksh\\|csh\\|tcsh\\|zsh\\)\\/\";\\s+[\\s\\S]*?\\s+(?P<ARGS>\\S+)\\s+=\\s+\\[\\]string\\{(?P<CMD>\\S+),\"\\-c\",(?P<EXE>\\S+),[\\s\\S]*?\\};\\s+[\\s\\S]*?"])))
          + ($all
          | in_files_with($all | of(["(?P<CMD>\\S+),(?P<ERR>\\S+)\\s+:=\\s+exec\\.LookPath\\(\"=~\\/\\(sh\\|bash\\|ksh\\|csh\\|tcsh\\|zsh\\)\\/\"\\);\\s+[\\s\\S]*?\\s+(?P<ARGS>\\S+)\\s+=\\s+\\[\\]string\\{(?P<CMD>\\S+),\"\\-c\",(?P<EXE>\\S+),[\\s\\S]*?\\};\\s+[\\s\\S]*?"])))))
          | in_files_without($all | of(["(?P<ARGS>\\S+)\\s+:=\\s+\\[\\]string\\{\"[\\s\\S]*?\",\"[\\s\\S]*?\",\"[\\s\\S]*?\",[\\s\\S]*?\\};\\s+[\\s\\S]*?"]))
          | in_files_without($all | of(["(?P<CMD>\\S+)\\s+=\\s+\"[\\s\\S]*?\";\\s+[\\s\\S]*?\\s+(?P<ARGS>\\S+)\\s+=\\s+\\[\\]string\\{(?P<CMD>\\S+),\"[\\s\\S]*?\",\"[\\s\\S]*?\",[\\s\\S]*?\\};\\s+[\\s\\S]*?"]))
          | in_files_without($all | of(["(?P<CMD>\\S+),(?P<ERR>\\S+)\\s+:=\\s+exec\\.LookPath\\(\"[\\s\\S]*?\"\\);\\s+[\\s\\S]*?\\s+(?P<ARGS>\\S+)\\s+=\\s+\\[\\]string\\{(?P<CMD>\\S+),\"[\\s\\S]*?\",\"[\\s\\S]*?\",[\\s\\S]*?\\};\\s+[\\s\\S]*?"])))
          | in_files_with($all | of(["import\\s+\"syscall\"\\s+[\\s\\S]*?"]))
          | where_capture("METHOD"; "^(?:(Exec|ForkExec))")
        | finding("dangerous-syscall-exec";
            "Detected non-static command inside Exec.") ) )
| report
