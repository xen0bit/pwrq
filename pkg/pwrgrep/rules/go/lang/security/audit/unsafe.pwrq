# rules: use-of-unsafe-block
# from: go/lang/security/audit/unsafe.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "unsafe.$FUNC($$$_)"
    ])) as $all
    | ( $all | of(["unsafe.$FUNC($$$_)"])
        | finding("use-of-unsafe-block";
            "Using the unsafe package in Go gives you low-level memory management and many of the strengths of the C language, but also steps around the type safety of Go and can lead to buffer overflows and possible arbitrary code execution by an attacker.") ) )
| report
