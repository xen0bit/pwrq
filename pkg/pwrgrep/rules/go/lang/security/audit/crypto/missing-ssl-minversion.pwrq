# rules: missing-ssl-minversion
# from: go/lang/security/audit/crypto/missing-ssl-minversion.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "tls.Config{ $$$CONF }",
      "tls.Config{$$$_, MinVersion: $$$_, $$$_}"
    ])) as $all
    | ( $all | of(["tls.Config{ $$$CONF }"])
          | not_at($all | of(["tls.Config{$$$_, MinVersion: $$$_, $$$_}"]))
        | finding("missing-ssl-minversion";
            "`MinVersion` is missing from this TLS configuration.") ) )
| report
