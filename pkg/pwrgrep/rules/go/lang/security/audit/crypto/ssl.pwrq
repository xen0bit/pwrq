# rules: ssl-v3-is-insecure
# languages: go
# from: go/lang/security/audit/crypto/ssl.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "tls.Config{$$$_, MinVersion: $TLS.VersionSSL30, $$$_}"
    ])) as $all
    | ( $all | of(["tls.Config{$$$_, MinVersion: $TLS.VersionSSL30, $$$_}"])
        | finding("ssl-v3-is-insecure";
            "SSLv3 is insecure because it has known vulnerabilities.") ) )
| report
