# rules: math-random-used
# languages: go
# from: go/lang/security/audit/crypto/math_random.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "$$$_\n$RAND.$FUNC($$$_)",
      "$$$_\nrand.$FUNC($$$_)",
      "import \"$MATH\"",
      "import $RAND \"$MATH\""
    ])) as $all
    | ( $all | of(["import $RAND \"$MATH\"","import \"$MATH\""])
          | at_same_place((($all
          | within($all | of(["$$$_\nrand.$FUNC($$$_)"])))
          + ($all
          | within($all | of(["$$$_\n$RAND.$FUNC($$$_)"])))))
          | where_capture("MATH"; "^(math/rand(\\/v[0-9]+)*)$")
          | focus("MATH")
        | finding("math-random-used";
            "Do not use `math/rand`.") ) )
| report
