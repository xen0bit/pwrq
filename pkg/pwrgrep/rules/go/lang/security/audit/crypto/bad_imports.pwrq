# rules: insecure-module-used
# from: go/lang/security/audit/crypto/bad_imports.yaml

. as $root
| ( ($root | scan_regex(["*.go"]; [
      "cgi\\.(?P<FUNC>\\S+)\\([\\s\\S]*?\\)",
      "import\\s+\"net\\/http\\/cgi\"\\s+[\\s\\S]*?"
    ])) as $all
    | ( ($all | of(["cgi\\.(?P<FUNC>\\S+)\\([\\s\\S]*?\\)"])
          | in_files_with($all | of(["import\\s+\"net\\/http\\/cgi\"\\s+[\\s\\S]*?"])))
        | finding("insecure-module-used";
            "The package `net/http/cgi` is on the import blocklist.") ) )
| report
