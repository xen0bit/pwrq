# rules: path-traversal-inside-zip-extraction
# from: go/lang/security/zip.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "reader, $ERR := zip.OpenReader($ARCHIVE)\n$$$_\nfor _, $FILE := range reader.File {\n  $$$_\n  path := filepath.Join($TARGET, $FILE.Name)\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["reader, $ERR := zip.OpenReader($ARCHIVE)\n$$$_\nfor _, $FILE := range reader.File {\n  $$$_\n  path := filepath.Join($TARGET, $FILE.Name)\n  $$$_\n}"])
        | finding("path-traversal-inside-zip-extraction";
            "File traversal when extracting zip archive") ) )
| report
