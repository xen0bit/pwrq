# rules: bad-tmp-file-creation
# from: go/lang/security/bad_tmp.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "ioutil.WriteFile(\"=~//tmp/.*$/\", $$$_)",
      "os.Create(\"=~//tmp/.*$/\", $$$_)"
    ])) as $all
    | ( $all | of(["ioutil.WriteFile(\"=~//tmp/.*$/\", $$$_)","os.Create(\"=~//tmp/.*$/\", $$$_)"])
        | finding("bad-tmp-file-creation";
            "File creation in shared tmp directory without using ioutil.Tempfile") ) )
| report
