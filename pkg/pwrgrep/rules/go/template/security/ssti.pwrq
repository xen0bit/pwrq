# rules: go-ssti
# from: go/template/security/ssti.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "\"html/template\"",
      "$ARG := $REQ.Form.Get($$$_)\n$$$_\n$T, $ERR := $TMPL.Parse($TEMPLATE)",
      "$ARG := $REQ.PostForm.Get($$$_)\n$$$_\n$T, $ERR := $TMPL.Parse($TEMPLATE)",
      "$ARG := $REQ.URL.Query().Get($$$_)\n$$$_\n$T, $ERR := $TMPL.Parse($TEMPLATE)",
      "$TEMPLATE = fmt.Sprintf(\"$$$_\", $ARG, $$$_)",
      "func $FN($$$_, $REQ *http.Request, $$$_){\n$$$_\n}",
      "func $FN($$$_, $REQ http.Request, $$$_){\n$$$_\n}",
      "func($$$_, $REQ *http.Request, $$$_){\n$$$_\n}",
      "import (\"html/template\")\n$$$_"
    ])) as $all
    | ( $all | of(["$TEMPLATE = fmt.Sprintf(\"$$$_\", $ARG, $$$_)"])
          | in_files_with($all | of(["import (\"html/template\")\n$$$_","\"html/template\""]))
        | finding("go-ssti";
            "A server-side template injection occurs when an attacker is able to use native template syntax to inject a malicious payload into a template, which is then executed server-side.") ) )
| report
