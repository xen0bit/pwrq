# rules: go-insecure-templates
# from: go/template/security/insecure-types.yaml

. as $root
| ( ($root | scan_regex(["*.go"]; [
      "import\\s+\"html\\/template\"\\s+[\\s\\S]*?",
      "var\\s+(?P<VAR>\\S+)\\s+template\\.CSS\\s+=\\s+(?P<EXP>\\S+)",
      "var\\s+(?P<VAR>\\S+)\\s+template\\.HTMLAttr\\s+=\\s+(?P<EXP>\\S+)",
      "var\\s+(?P<VAR>\\S+)\\s+template\\.HTML\\s+=\\s+(?P<EXP>\\S+)",
      "var\\s+(?P<VAR>\\S+)\\s+template\\.JSStr\\s+=\\s+(?P<EXP>\\S+)",
      "var\\s+(?P<VAR>\\S+)\\s+template\\.JS\\s+=\\s+(?P<EXP>\\S+)",
      "var\\s+(?P<VAR>\\S+)\\s+template\\.Srcset\\s+=\\s+(?P<EXP>\\S+)"
    ])) as $all
    | ( $all | of(["var\\s+(?P<VAR>\\S+)\\s+template\\.HTML\\s+=\\s+(?P<EXP>\\S+)","var\\s+(?P<VAR>\\S+)\\s+template\\.CSS\\s+=\\s+(?P<EXP>\\S+)","var\\s+(?P<VAR>\\S+)\\s+template\\.HTMLAttr\\s+=\\s+(?P<EXP>\\S+)","var\\s+(?P<VAR>\\S+)\\s+template\\.JS\\s+=\\s+(?P<EXP>\\S+)","var\\s+(?P<VAR>\\S+)\\s+template\\.JSStr\\s+=\\s+(?P<EXP>\\S+)","var\\s+(?P<VAR>\\S+)\\s+template\\.Srcset\\s+=\\s+(?P<EXP>\\S+)"])
          | in_files_with($all | of(["import\\s+\"html\\/template\"\\s+[\\s\\S]*?"]))
        | finding("go-insecure-templates";
            "usage of insecure template types.") ) )
| report
