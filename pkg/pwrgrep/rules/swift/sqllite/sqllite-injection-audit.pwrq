# rules: swift-potential-sqlite-injection
# languages: swift
# from: swift/sqllite/sqllite-injection-audit.yaml

. as $root
| ( ($root | scan_ast(["*.swift"]; [
      "\"$$$_\\($X)$$$_\"",
      "$SQL = \"$$$_\" + $X",
      "$SQL = $X + \"$$$_\"",
      "sqlite3_exec($DB, $SQL, $$$_)",
      "sqlite3_prepare_v2($DB, $SQL, $$$_)"
    ])) as $all
    | ( (($all | of(["sqlite3_exec($DB, $SQL, $$$_)","sqlite3_prepare_v2($DB, $SQL, $$$_)"])
          | focus("SQL")))
          | reaching((($all | of(["\"$$$_\\($X)$$$_\"","$SQL = \"$$$_\" + $X","$SQL = $X + \"$$$_\""])));
              ([]))
        | finding("swift-potential-sqlite-injection";
            "Potential Client-side SQL injection which has different impacts depending on the SQL use-case.") ) )
| report
