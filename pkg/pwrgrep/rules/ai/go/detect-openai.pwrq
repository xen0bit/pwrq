# rules: detect-openai
# from: ai/go/detect-openai.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "gogpt.NewClient($$$_)",
      "import \"github.com/sashabaranov/go-openai\""
    ])) as $all
    | ( $all | of(["import \"github.com/sashabaranov/go-openai\"","gogpt.NewClient($$$_)"])
        | finding("detect-openai";
            "Possibly found usage of AI: OpenAI") ) )
| report
