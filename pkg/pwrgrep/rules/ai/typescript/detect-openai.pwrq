# rules: detect-openai
# languages: javascript, typescript
# from: ai/typescript/detect-openai.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$CLIENT.chat.completions.$FUNC($$$_)",
      "import \"openai\"",
      "import $ANYTHING from \"openai\";",
      "new OpenAI($$$_)"
    ])) as $all
    | ( $all | of(["import \"openai\"","import $ANYTHING from \"openai\";","new OpenAI($$$_)","$CLIENT.chat.completions.$FUNC($$$_)"])
        | finding("detect-openai";
            "Possibly found usage of AI: OpenAI") ) )
| report
