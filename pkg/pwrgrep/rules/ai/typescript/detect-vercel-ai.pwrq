# rules: detect-vercel-ai
# languages: javascript, typescript
# from: ai/typescript/detect-vercel-ai.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "generateText({model:$$$_})",
      "generateText({prompt:$$$_})",
      "import \"@ai-sdk\"",
      "import \"ai\""
    ])) as $all
    | ( $all | of(["import \"ai\"","import \"@ai-sdk\"","generateText({model:$$$_})","generateText({prompt:$$$_})"])
        | finding("detect-vercel-ai";
            "Possibly found usage of AI: VercelAI") ) )
| report
