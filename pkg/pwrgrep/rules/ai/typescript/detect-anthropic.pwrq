# rules: detect-anthropic
# from: ai/typescript/detect-anthropic.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "anthropic.messages.$FUNC($$$_)",
      "import \"@anthropic-ai\"",
      "import $ANYTHING from \"@anthropic-ai\";",
      "new Anthropic($$$_)"
    ])) as $all
    | ( $all | of(["import \"@anthropic-ai\"","import $ANYTHING from \"@anthropic-ai\";","new Anthropic($$$_)","anthropic.messages.$FUNC($$$_)"])
        | finding("detect-anthropic";
            "Possibly found usage of AI: Anthropic") ) )
| report
