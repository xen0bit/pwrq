# rules: detect-openai
# from: ai/python/detect-openai.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$CLIENT.chat.completions.$FUNC($$$_)",
      "OpenAI($$$_)",
      "from openai import $ANYTHING",
      "import openai"
    ])) as $all
    | ( $all | of(["import openai","from openai import $ANYTHING","OpenAI($$$_)","$CLIENT.chat.completions.$FUNC($$$_)"])
        | finding("detect-openai";
            "Possibly found usage of AI: OpenAI") ) )
| report
