# rules: detect-tensorflow
# languages: python
# from: ai/python/detect-tensorflow.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "import tensorflow"
    ])) as $all
    | ( $all | of(["import tensorflow"])
        | finding("detect-tensorflow";
            "Possibly found usage of AI tooling: Tensorflow") ) )
| report
