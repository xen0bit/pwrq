# rules: detect-pytorch
# languages: python
# from: ai/python/detect-pytorch.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "import torch",
      "torch.$FUNC($$$_)"
    ])) as $all
    | ( $all | of(["import torch","torch.$FUNC($$$_)"])
        | finding("detect-pytorch";
            "Possibly found usage of AI tooling: PyTorch") ) )
| report
