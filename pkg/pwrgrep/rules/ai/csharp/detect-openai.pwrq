# rules: detect-openai
# languages: c_sharp
# from: ai/csharp/detect-openai.yaml

. as $root
| ( ($root | scan_ast(["*.cs"]; [
      "(ChatClient $CLIENT)",
      "(ChatClient $CLIENT).$FUNC($$$_)",
      "using OpenAI"
    ])) as $all
    | ( $all | of(["using OpenAI","(ChatClient $CLIENT)","(ChatClient $CLIENT).$FUNC($$$_)"])
        | finding("detect-openai";
            "Possibly found usage of AI: OpenAI") ) )
| report
