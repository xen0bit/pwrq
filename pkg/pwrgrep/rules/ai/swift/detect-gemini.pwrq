# rules: detect-gemini
# from: ai/swift/detect-gemini.yaml

. as $root
| ( ($root | scan_ast(["*.swift"]; [
      "GenerativeModel($$$_)",
      "import GoogleGenerativeAI"
    ])) as $all
    | ( $all | of(["import GoogleGenerativeAI","GenerativeModel($$$_)"])
        | finding("detect-gemini";
            "Possibly found usage of AI: Gemini") ) )
| report
