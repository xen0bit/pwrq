# rules: detect-generic-ai-gem
# from: ai/generic/detect-generic-ai-gem.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "GoogleGenerativeAI",
      "google\\/generative\\-ai"
    ])) as $all
    | ( $all | of(["google\\/generative\\-ai","GoogleGenerativeAI"])
        | finding("detect-generic-ai-gem";
            "Possibly found usage of AI: Gemini") ) )
| report
