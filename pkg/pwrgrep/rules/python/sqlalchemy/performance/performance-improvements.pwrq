# rules: len-all-count, batch-import
# languages: python
# from: python/sqlalchemy/performance/performance-improvements.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "for $X in $Y:\n  db.session.add($Z)",
      "len($X.all())"
    ])) as $all
    | ( $all | of(["len($X.all())"])
        | finding("len-all-count";
            "Using QUERY.count() instead of len(QUERY.all()) sends less data to the client since the SQLAlchemy method is performed server-side.") )
      + ( $all | of(["for $X in $Y:\n  db.session.add($Z)"])
        | finding("batch-import";
            "Rather than adding one element at a time, consider batch loading to improve performance.") ) )
| report
