# rules: bad-operator-in-filter
# languages: python
# from: python/sqlalchemy/correctness/bad-operator-in-filter.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$A and $B",
      "$A in $B",
      "$A is $B",
      "$A is not $B",
      "$A not in $B",
      "$A or $B",
      "$TARGET.filter($$$_)",
      "def $ANY($$$_):\n    $$$_\n    $MODEL.query",
      "not $A"
    ])) as $all
    | ( $all | of(["not $A","$A is $B","$A is not $B","$A and $B","$A or $B","$A in $B","$A not in $B"])
          | within($all | of(["def $ANY($$$_):\n    $$$_\n    $MODEL.query"]))
          | within($all | of(["$TARGET.filter($$$_)"]))
        | finding("bad-operator-in-filter";
            "Only comparison operators should be used inside SQLAlchemy filter expressions.") ) )
| report
