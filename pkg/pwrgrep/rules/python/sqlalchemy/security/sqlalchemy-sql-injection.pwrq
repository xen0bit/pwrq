# rules: sqlalchemy-sql-injection
# languages: python
# from: python/sqlalchemy/security/sqlalchemy-sql-injection.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "def $FUNC($$$_,$VAR,$$$_):\n  $$$_\n  $SESSION.query($$$_).$SQLFUNC(\"$$$_\".$FORMATFUNC($$$_,$VAR,$$$_))",
      "def $FUNC($$$_,$VAR,$$$_):\n  $$$_\n  $SESSION.query.$SQLFUNC(\"$$$_\".$FORMATFUNC($$$_,$VAR,$$$_))",
      "def $FUNC($$$_,$VAR,$$$_):\n  $$$_\n  $SESSION.query.join($$$_).$SQLFUNC(\"$$$_\".$FORMATFUNC($$$_,$VAR,$$$_))",
      "def $FUNC($$$_,$VAR,$$$_):\n  $$$_\n  query.$SQLFUNC(\"$$$_\".$FORMATFUNC($$$_,$VAR,$$$_))"
    ])) as $all
    | ( $all | of(["def $FUNC($$$_,$VAR,$$$_):\n  $$$_\n  $SESSION.query($$$_).$SQLFUNC(\"$$$_\".$FORMATFUNC($$$_,$VAR,$$$_))","def $FUNC($$$_,$VAR,$$$_):\n  $$$_\n  $SESSION.query.join($$$_).$SQLFUNC(\"$$$_\".$FORMATFUNC($$$_,$VAR,$$$_))","def $FUNC($$$_,$VAR,$$$_):\n  $$$_\n  $SESSION.query.$SQLFUNC(\"$$$_\".$FORMATFUNC($$$_,$VAR,$$$_))","def $FUNC($$$_,$VAR,$$$_):\n  $$$_\n  query.$SQLFUNC(\"$$$_\".$FORMATFUNC($$$_,$VAR,$$$_))"])
          | where_capture("SQLFUNC"; "^(?:(group_by|order_by|distinct|having|filter))")
          | where_capture_not("FORMATFUNC"; "^(?:bindparams)")
        | finding("sqlalchemy-sql-injection";
            "Distinct, Having, Group_by, Order_by, and Filter in SQLAlchemy can cause sql injections if the developer inputs raw SQL into the before-mentioned clauses.") ) )
| report
