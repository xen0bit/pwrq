# rules: formatted-string-bashoperator
# languages: python
# from: python/airflow/security/audit/formatted-string-bashoperator.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$CMD = \"$$$_\"\n$$$_\n$CMD += $CONCAT\n$$$_\nairflow.operators.bash_operator.BashOperator($$$_, bash_command=$CMD, $$$_)",
      "$CMD = \"$$$_\" % $PARAMS\n$$$_\nairflow.operators.bash_operator.BashOperator($$$_, bash_command=$CMD, $$$_)",
      "$CMD = \"$$$_\" + $CONCAT\n$$$_\nairflow.operators.bash_operator.BashOperator($$$_, bash_command=$CMD, $$$_)",
      "$CMD = $STR.format($$$_)\n$$$_\nairflow.operators.bash_operator.BashOperator($$$_, bash_command=$CMD, $$$_)",
      "$CMD = f\"$$$_\"\n$$$_\nairflow.operators.bash_operator.BashOperator($$$_, bash_command=$CMD, $$$_)",
      "airflow.operators.bash_operator.BashOperator($$$_, bash_command=\"$$$_\" % $PARAMS, $$$_)",
      "airflow.operators.bash_operator.BashOperator($$$_, bash_command=\"$$$_\" + $CONCAT, $$$_)",
      "airflow.operators.bash_operator.BashOperator($$$_, bash_command=\"$$$_\".format($$$_), $$$_)",
      "airflow.operators.bash_operator.BashOperator($$$_, bash_command=f\"$$$_\", $$$_)"
    ])) as $all
    | ( $all | of(["airflow.operators.bash_operator.BashOperator($$$_, bash_command=\"$$$_\" + $CONCAT, $$$_)","airflow.operators.bash_operator.BashOperator($$$_, bash_command=\"$$$_\".format($$$_), $$$_)","airflow.operators.bash_operator.BashOperator($$$_, bash_command=f\"$$$_\", $$$_)","airflow.operators.bash_operator.BashOperator($$$_, bash_command=\"$$$_\" % $PARAMS, $$$_)","$CMD = \"$$$_\" % $PARAMS\n$$$_\nairflow.operators.bash_operator.BashOperator($$$_, bash_command=$CMD, $$$_)","$CMD = $STR.format($$$_)\n$$$_\nairflow.operators.bash_operator.BashOperator($$$_, bash_command=$CMD, $$$_)","$CMD = f\"$$$_\"\n$$$_\nairflow.operators.bash_operator.BashOperator($$$_, bash_command=$CMD, $$$_)","$CMD = \"$$$_\" + $CONCAT\n$$$_\nairflow.operators.bash_operator.BashOperator($$$_, bash_command=$CMD, $$$_)","$CMD = \"$$$_\"\n$$$_\n$CMD += $CONCAT\n$$$_\nairflow.operators.bash_operator.BashOperator($$$_, bash_command=$CMD, $$$_)"])
        | finding("formatted-string-bashoperator";
            "Found a formatted string in BashOperator: $CMD.") ) )
| report
