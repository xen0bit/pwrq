# rules: check-is-none-explicitly
# languages: python
# from: python/correctness/check-is-none-explicitly.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$X and $X == 0",
      "$X.get($FIELD) and $X[$FIELD] == 0"
    ])) as $all
    | ( $all | of(["$X and $X == 0","$X.get($FIELD) and $X[$FIELD] == 0"])
        | finding("check-is-none-explicitly";
            "This expression will always return False because 0 is a false-y value.") ) )
| report
