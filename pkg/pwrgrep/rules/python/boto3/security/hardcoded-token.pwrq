# rules: hardcoded-token
# languages: python
# from: python/boto3/security/hardcoded-token.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "\"$$$_\"",
      "$BOTO. $$$_ .$W($$$_,$TOKEN=\"$VALUE\",$$$_)",
      "$W($$$_,$TOKEN=\"$VALUE\",$$$_)"
    ])) as $all
    | ( (($all | of(["$W($$$_,$TOKEN=\"$VALUE\",$$$_)","$BOTO. $$$_ .$W($$$_,$TOKEN=\"$VALUE\",$$$_)"])
          | where_capture("TOKEN"; "^(?:(aws_session_token|aws_access_key_id|aws_secret_access_key))")
          | where_capture_entropy("VALUE")))
          | reaching((($all | of(["\"$$$_\""])));
              ([]))
        | finding("hardcoded-token";
            "A hard-coded credential was detected.") ) )
| report
