# rules: use-timeout
# from: python/requests/best-practice/use-timeout.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$SESSION = requests.Session($$$_)\n$$$_",
      "$SESSION.$W($$$_, **$KWARGS)",
      "$SESSION.$W($$$_, timeout=$N, $$$_)",
      "$SESSION.delete($$$_)",
      "$SESSION.get($$$_)",
      "$SESSION.head($$$_)",
      "$SESSION.patch($$$_)",
      "$SESSION.post($$$_)",
      "$SESSION.put($$$_)",
      "requests.$W($$$_, **$KWARGS)",
      "requests.$W($$$_, timeout=$N, $$$_)",
      "requests.delete($$$_)",
      "requests.get($$$_)",
      "requests.head($$$_)",
      "requests.patch($$$_)",
      "requests.post($$$_)",
      "requests.put($$$_)",
      "requests.request($$$_)"
    ])) as $all
    | ( ($all | of(["requests.request($$$_)","requests.get($$$_)","requests.post($$$_)","requests.put($$$_)","requests.delete($$$_)","requests.head($$$_)","requests.patch($$$_)"])
          | not_at($all | of(["requests.$W($$$_, timeout=$N, $$$_)"]))
          | not_at($all | of(["requests.$W($$$_, **$KWARGS)"])))
          + ($all | of(["$SESSION.get($$$_)","$SESSION.post($$$_)","$SESSION.put($$$_)","$SESSION.delete($$$_)","$SESSION.head($$$_)","$SESSION.patch($$$_)"])
          | in_files_with($all | of(["$SESSION = requests.Session($$$_)\n$$$_"]))
          | not_at($all | of(["$SESSION.$W($$$_, timeout=$N, $$$_)"]))
          | not_at($all | of(["$SESSION.$W($$$_, **$KWARGS)"])))
        | finding("use-timeout";
            "Detected a 'requests' call without a timeout set.") ) )
| report
