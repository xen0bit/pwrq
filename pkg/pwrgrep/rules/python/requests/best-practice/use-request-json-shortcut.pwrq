# rules: python.requests.best-practice.use-request-json-shortcut
# from: python/requests/best-practice/use-request-json-shortcut.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "import json; $$$_",
      "import requests; $$$_",
      "requests.$METHOD($$$_, body=json.dumps($BODY), $$$_)"
    ])) as $all
    | ( $all | of(["requests.$METHOD($$$_, body=json.dumps($BODY), $$$_)"])
          | within($all | of(["import json; $$$_"]))
          | within($all | of(["import requests; $$$_"]))
        | finding("python.requests.best-practice.use-request-json-shortcut";
            "The requests library has a convenient shortcut for sending JSON requests, which lets you stop worrying about serializing the body yourself.") ) )
| report
