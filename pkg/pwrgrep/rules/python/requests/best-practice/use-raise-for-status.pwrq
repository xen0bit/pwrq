# rules: use-raise-for-status
# from: python/requests/best-practice/use-raise-for-status.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$RESP = requests.$METHOD($$$_)\n$$$_\nif $RESP.ok:\n  $$$_",
      "$RESP = requests.$METHOD($$$_)\n$$$_\nif not $RESP.ok:\n  $$$_",
      "$RESP = requests.$METHOD($$$_)\n$RESP.raise_for_status($$$_)",
      "$RESP = requests.$METHOD($$$_)\nif $RESP.status_code != $$$_:\n  $$$_",
      "$RESP = requests.$METHOD($$$_)\nif $RESP.status_code == $$$_:\n  $$$_",
      "requests.$METHOD($$$_).raise_for_status($$$_)",
      "requests.delete($$$_)",
      "requests.get($$$_)",
      "requests.head($$$_)",
      "requests.patch($$$_)",
      "requests.post($$$_)",
      "requests.put($$$_)",
      "requests.request($$$_)",
      "with $$$_ as $$$_:\n  $$$_\n  $RESP = requests.$METHOD($$$_)\n  $$$_\n$RESP.raise_for_status($$$_)",
      "with $$$_:\n  $$$_\n  $RESP = requests.$METHOD($$$_)\n  $$$_\n$RESP.raise_for_status($$$_)"
    ])) as $all
    | ( $all | of(["requests.request($$$_)","requests.get($$$_)","requests.post($$$_)","requests.put($$$_)","requests.delete($$$_)","requests.head($$$_)","requests.patch($$$_)"])
          | outside($all | of(["$RESP = requests.$METHOD($$$_)\n$RESP.raise_for_status($$$_)"]))
          | outside($all | of(["requests.$METHOD($$$_).raise_for_status($$$_)"]))
          | outside($all | of(["$RESP = requests.$METHOD($$$_)\nif $RESP.status_code == $$$_:\n  $$$_"]))
          | outside($all | of(["$RESP = requests.$METHOD($$$_)\nif $RESP.status_code != $$$_:\n  $$$_"]))
          | outside($all | of(["$RESP = requests.$METHOD($$$_)\n$$$_\nif $RESP.ok:\n  $$$_"]))
          | outside($all | of(["$RESP = requests.$METHOD($$$_)\n$$$_\nif not $RESP.ok:\n  $$$_"]))
          | outside($all | of(["with $$$_:\n  $$$_\n  $RESP = requests.$METHOD($$$_)\n  $$$_\n$RESP.raise_for_status($$$_)"]))
          | outside($all | of(["with $$$_ as $$$_:\n  $$$_\n  $RESP = requests.$METHOD($$$_)\n  $$$_\n$RESP.raise_for_status($$$_)"]))
        | finding("use-raise-for-status";
            "There's an HTTP request made with requests, but the raise_for_status() utility method isn't used.") ) )
| report
