# rules: no-auth-over-http
# from: python/requests/security/no-auth-over-http.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$URL = \"=~/http:\\/\\/$$$_/\"\n$$$_\nrequests.$W($URL, $$$_, auth=$X, $$$_)",
      "requests.$W(\"=~/http:\\/\\/.*/\", $$$_, auth=$X, $$$_)"
    ])) as $all
    | ( $all | of(["requests.$W(\"=~/http:\\/\\/.*/\", $$$_, auth=$X, $$$_)","$URL = \"=~/http:\\/\\/$$$_/\"\n$$$_\nrequests.$W($URL, $$$_, auth=$X, $$$_)"])
        | finding("no-auth-over-http";
            "Authentication detected over HTTP.") ) )
| report
