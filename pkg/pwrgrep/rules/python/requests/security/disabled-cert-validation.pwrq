# rules: disabled-cert-validation
# from: python/requests/security/disabled-cert-validation.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "requests.delete($$$_, verify=False, $$$_)",
      "requests.get($$$_, verify=False, $$$_)",
      "requests.head($$$_, verify=False, $$$_)",
      "requests.options($$$_, verify=False, $$$_)",
      "requests.patch($$$_, verify=False, $$$_)",
      "requests.post($$$_, verify=False, $$$_)",
      "requests.put($$$_, verify=False, $$$_)",
      "requests.request($$$_, verify=False, $$$_)"
    ])) as $all
    | ( $all | of(["requests.put($$$_, verify=False, $$$_)","requests.patch($$$_, verify=False, $$$_)","requests.delete($$$_, verify=False, $$$_)","requests.head($$$_, verify=False, $$$_)","requests.options($$$_, verify=False, $$$_)","requests.request($$$_, verify=False, $$$_)","requests.get($$$_, verify=False, $$$_)","requests.post($$$_, verify=False, $$$_)"])
        | finding("disabled-cert-validation";
            "Certificate verification has been explicitly disabled.") ) )
| report
