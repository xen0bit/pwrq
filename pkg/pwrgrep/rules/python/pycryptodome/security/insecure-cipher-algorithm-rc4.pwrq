# rules: insecure-cipher-algorithm-rc4
# languages: python
# from: python/pycryptodome/security/insecure-cipher-algorithm-rc4.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "Crypto.Cipher.ARC4.new($$$_)",
      "Cryptodome.Cipher.ARC4.new($$$_)"
    ])) as $all
    | ( $all | of(["Cryptodome.Cipher.ARC4.new($$$_)","Crypto.Cipher.ARC4.new($$$_)"])
        | finding("insecure-cipher-algorithm-rc4";
            "Detected ARC4 cipher algorithm which is considered insecure.") ) )
| report
