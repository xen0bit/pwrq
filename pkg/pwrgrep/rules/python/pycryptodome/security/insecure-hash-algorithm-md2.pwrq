# rules: insecure-hash-algorithm-md2
# from: python/pycryptodome/security/insecure-hash-algorithm-md2.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "Crypto.Hash.MD2.new($$$_)",
      "Cryptodome.Hash.MD2.new ($$$_)"
    ])) as $all
    | ( $all | of(["Crypto.Hash.MD2.new($$$_)","Cryptodome.Hash.MD2.new ($$$_)"])
        | finding("insecure-hash-algorithm-md2";
            "Detected MD2 hash algorithm which is considered insecure.") ) )
| report
