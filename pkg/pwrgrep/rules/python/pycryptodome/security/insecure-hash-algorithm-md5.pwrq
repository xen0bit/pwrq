# rules: insecure-hash-algorithm-md5
# from: python/pycryptodome/security/insecure-hash-algorithm-md5.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "Crypto.Hash.MD5.new($$$_)",
      "Cryptodome.Hash.MD5.new ($$$_)"
    ])) as $all
    | ( $all | of(["Crypto.Hash.MD5.new($$$_)","Cryptodome.Hash.MD5.new ($$$_)"])
        | finding("insecure-hash-algorithm-md5";
            "Detected MD5 hash algorithm which is considered insecure.") ) )
| report
