# rules: insecure-cipher-algorithm-rc2
# languages: python
# from: python/pycryptodome/security/insecure-cipher-algorithm-rc2.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "Crypto.Cipher.ARC2.new($$$_)",
      "Cryptodome.Cipher.ARC2.new($$$_)"
    ])) as $all
    | ( $all | of(["Cryptodome.Cipher.ARC2.new($$$_)","Crypto.Cipher.ARC2.new($$$_)"])
        | finding("insecure-cipher-algorithm-rc2";
            "Detected RC2 cipher algorithm which is considered insecure.") ) )
| report
