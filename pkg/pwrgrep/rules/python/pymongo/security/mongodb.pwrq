# rules: mongo-client-bad-auth
# from: python/pymongo/security/mongodb.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "pymongo.MongoClient($$$_, authMechanism='MONGODB-CR')"
    ])) as $all
    | ( $all | of(["pymongo.MongoClient($$$_, authMechanism='MONGODB-CR')"])
        | finding("mongo-client-bad-auth";
            "Warning MONGODB-CR was deprecated with the release of MongoDB 3.6 and is no longer supported by MongoDB 4.0 (see https://api.mongodb.com/python/current/examples/authentication.html for details).") ) )
| report
