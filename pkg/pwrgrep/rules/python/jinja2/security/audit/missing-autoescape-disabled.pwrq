# rules: missing-autoescape-disabled
# languages: python
# from: python/jinja2/security/audit/missing-autoescape-disabled.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "jinja2.Environment($$$_)",
      "jinja2.Environment($$$_, autoescape=$VAL, $$$_)"
    ])) as $all
    | ( $all | of(["jinja2.Environment($$$_)"])
          | not_at($all | of(["jinja2.Environment($$$_, autoescape=$VAL, $$$_)"]))
        | finding("missing-autoescape-disabled";
            "Detected a Jinja2 environment without autoescaping.") ) )
| report
