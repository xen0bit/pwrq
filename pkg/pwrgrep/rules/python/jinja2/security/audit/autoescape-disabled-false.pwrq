# rules: incorrect-autoescape-disabled
# languages: python
# from: python/jinja2/security/audit/autoescape-disabled-false.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "jinja2.Environment($$$_ , autoescape=$VAL, $$$_)",
      "jinja2.Environment($$$_ , autoescape=True, $$$_)",
      "jinja2.Environment($$$_ , autoescape=jinja2.select_autoescape($$$_), $$$_)"
    ])) as $all
    | ( $all | of(["jinja2.Environment($$$_ , autoescape=$VAL, $$$_)"])
          | not_at($all | of(["jinja2.Environment($$$_ , autoescape=True, $$$_)"]))
          | not_at($all | of(["jinja2.Environment($$$_ , autoescape=jinja2.select_autoescape($$$_), $$$_)"]))
          | focus("VAL")
        | finding("incorrect-autoescape-disabled";
            "Detected a Jinja2 environment with 'autoescaping' disabled.") ) )
| report
