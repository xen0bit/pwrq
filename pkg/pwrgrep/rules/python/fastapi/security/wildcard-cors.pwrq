# rules: wildcard-cors
# languages: python
# from: python/fastapi/security/wildcard-cors.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$APP.add_middleware(\n  CORSMiddleware,\n  allow_origins=$ORIGIN,\n  $$$_);",
      "[$$$_, \"*\", $$$_]"
    ])) as $all
    | ( (($all | of(["$APP.add_middleware(\n  CORSMiddleware,\n  allow_origins=$ORIGIN,\n  $$$_);"])
          | focus("ORIGIN")))
          | reaching((($all | of(["[$$$_, \"*\", $$$_]"])));
              ([]))
        | finding("wildcard-cors";
            "CORS policy allows any origin (using wildcard '*').") ) )
| report
