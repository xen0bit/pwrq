# rules: python37-compatibility-importlib, python37-compatibility-importlib2, python37-compatibility-httpconn, python37-compatibility-httpsconn, python37-compatibility-importlib3, python37-compatibility-textiowrapper, python37-compatibility-ipv6network1, python37-compatibility-ipv6network2, python37-compatibility-ipv4network1, python37-compatibility-ipv4network2, python37-compatibility-locale1, python37-compatibility-math1, python37-compatibility-multiprocess1, python37-compatibility-multiprocess2, python37-compatibility-os1, python37-compatibility-os2-ok2, python37-compatibility-pdb
# from: python/lang/compatibility/python37.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "TextIOWrapper.reconfigure($$$_)",
      "http.client.HTTPConnection(blocksize=$X,$$$_)",
      "http.client.HTTPSConnection(blocksize=$X,$$$_)",
      "if hasattr(os, 'pwritev'):\n    $$$_",
      "import importlib.abc.ResourceReader",
      "import importlib.resources",
      "importlib.source_hash()",
      "ipaddress.IPv4Network.subnet_of($X)",
      "ipaddress.IPv4Network.supernet_of($X)",
      "ipaddress.IPv6Network.subnet_of($X)",
      "ipaddress.IPv6Network.supernet_of($X)",
      "locale.format_string(monetary=$X, $$$_)",
      "math.remainder($X, $Y)",
      "multiprocessing.Process.close()",
      "multiprocessing.Process.kill()",
      "os.preadv($$$_)",
      "os.pwritev($$$_)",
      "pdb.set_trace(header=$X, $$$_)"
    ])) as $all
    | ( $all | of(["importlib.source_hash()"])
        | finding("python37-compatibility-importlib";
            "source_hash' is only available on Python 3.7+.") )
      + ( $all | of(["import importlib.resources"])
        | finding("python37-compatibility-importlib2";
            "Found 'importlib.resources', which is a module only available on Python 3.7+.") )
      + ( $all | of(["http.client.HTTPConnection(blocksize=$X,$$$_)"])
        | finding("python37-compatibility-httpconn";
            "Found usage of the 'blocksize' argument in a HTTPConnection call.") )
      + ( $all | of(["http.client.HTTPSConnection(blocksize=$X,$$$_)"])
        | finding("python37-compatibility-httpsconn";
            "Found usage of the 'blocksize' argument in a HTTPSConnection call.") )
      + ( $all | of(["import importlib.abc.ResourceReader"])
        | finding("python37-compatibility-importlib3";
            "Found usage of 'importlib.abc.ResourceReader'.") )
      + ( $all | of(["TextIOWrapper.reconfigure($$$_)"])
        | finding("python37-compatibility-textiowrapper";
            "Found usage of 'importlib.abc.ResourceReader'.") )
      + ( $all | of(["ipaddress.IPv6Network.subnet_of($X)"])
        | finding("python37-compatibility-ipv6network1";
            "IPv6Network.subnet_of is only available on Python 3.7+ and is therefore not backwards compatible.") )
      + ( $all | of(["ipaddress.IPv6Network.supernet_of($X)"])
        | finding("python37-compatibility-ipv6network2";
            "IPv6Network.supernet_of is only available on Python 3.7+ and is therefore not backwards compatible.") )
      + ( $all | of(["ipaddress.IPv4Network.subnet_of($X)"])
        | finding("python37-compatibility-ipv4network1";
            "IPv4Network.subnet_of is only available on Python 3.7+ and is therefore not backwards compatible.") )
      + ( $all | of(["ipaddress.IPv4Network.supernet_of($X)"])
        | finding("python37-compatibility-ipv4network2";
            "IPv4Network.supernet_of is only available on Python 3.7+ and is therefore not backwards compatible.") )
      + ( $all | of(["locale.format_string(monetary=$X, $$$_)"])
        | finding("python37-compatibility-locale1";
            "Found usage of the 'monetary' argument in a function call of 'locale.format_string'.") )
      + ( $all | of(["math.remainder($X, $Y)"])
        | finding("python37-compatibility-math1";
            "math.remainder is only available on Python 3.7+ and is therefore not backwards compatible.") )
      + ( $all | of(["multiprocessing.Process.close()"])
        | finding("python37-compatibility-multiprocess1";
            "multiprocessing.Process.close() is only available on Python 3.7+ and is therefore not backwards compatible.") )
      + ( $all | of(["multiprocessing.Process.kill()"])
        | finding("python37-compatibility-multiprocess2";
            "multiprocessing.Process.kill() is only available on Python 3.7+ and is therefore not backwards compatible.") )
      + ( $all | of(["os.preadv($$$_)"])
        | finding("python37-compatibility-os1";
            "os.preadv() is only available on Python 3.7+ and is therefore not backwards compatible.") )
      + ( $all | of(["os.pwritev($$$_)"])
          | outside($all | of(["if hasattr(os, 'pwritev'):\n    $$$_"]))
        | finding("python37-compatibility-os2-ok2";
            "os.pwritev() is only available on Python 3.3+ and is therefore not backwards compatible.") )
      + ( $all | of(["pdb.set_trace(header=$X, $$$_)"])
        | finding("python37-compatibility-pdb";
            "pdb.set_trace() with the header argument is only available on Python 3.7+ and is therefore not backwards compatible.") ) )
| report
