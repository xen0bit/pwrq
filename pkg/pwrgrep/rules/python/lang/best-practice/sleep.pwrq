# rules: arbitrary-sleep
# from: python/lang/best-practice/sleep.yaml

. as $root
| ( ($root | scan_regex(["*.py"]; [
      "time\\.sleep\\((?P<F>\\S+)\\([\\s\\S]*?\\)\\)",
      "time\\.sleep\\((?P<X>\\S+):\\s+float\\)",
      "time\\.sleep\\((?P<X>\\S+):\\s+int\\)"
    ])) as $all
    | ( $all | of(["time\\.sleep\\((?P<X>\\S+):\\s+int\\)","time\\.sleep\\((?P<X>\\S+):\\s+float\\)"])
          | not_at($all | of(["time\\.sleep\\((?P<F>\\S+)\\([\\s\\S]*?\\)\\)"]))
        | finding("arbitrary-sleep";
            "time.sleep() call; did you mean to leave this in?") ) )
| report
