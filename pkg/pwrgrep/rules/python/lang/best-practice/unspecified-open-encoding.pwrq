# rules: unspecified-open-encoding
# languages: python
# from: python/lang/best-practice/unspecified-open-encoding.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "open($$$_)",
      "open($$$_, encoding=\"$$$_\", $$$_)",
      "open($F, \"$$$_\", $B, \"$$$_\", $$$_)",
      "open($FILE)",
      "open($FILE, $$$_)",
      "open($FILE, $$$_, mode=$MODE, $$$_)",
      "open($FILE, $M, $$$_)",
      "open($FILE, $MODE, $$$_)"
    ])) as $all
    | ( ($all | of(["open($FILE)"]))
          + ($all | of(["open($FILE, $$$_)"])
          | not_at($all | of(["open($FILE, $M, $$$_)"]))
          | where_text_not("open\\(.*(?:encoding|mode)=.*\\)"))
          + ($all | of(["open($FILE, $MODE, $$$_)"])
          | where_capture_not("MODE"; "^(?:.*b.*)"))
          + ($all | of(["open($FILE, $$$_, mode=$MODE, $$$_)"])
          | where_capture_not("MODE"; "^(?:.*b.*)"))
          | within($all | of(["open($$$_)"]))
          | not_at($all | of(["open($$$_, encoding=\"$$$_\", $$$_)"]))
          | not_at($all | of(["open($F, \"$$$_\", $B, \"$$$_\", $$$_)"]))
        | finding("unspecified-open-encoding";
            "Missing 'encoding' parameter.") ) )
| report
