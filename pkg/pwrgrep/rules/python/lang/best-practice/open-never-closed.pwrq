# rules: open-never-closed
# from: python/lang/best-practice/open-never-closed.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$F = ZipFile.open($$$_)",
      "$F = ZipFile.open($$$_)\n$$$_\n$F.close()",
      "$F = ZipFile.open($$$_)\n$$$_\ntry:\n    $$$_\nfinally:\n    $F.close()",
      "$F = io.open($$$_)",
      "$F = io.open($$$_)\n$$$_\n$F.close()",
      "$F = io.open($$$_)\n$$$_\ntry:\n    $$$_\nfinally:\n    $F.close()",
      "$F = open($$$_)",
      "$F = open($$$_)\n$$$_\n$F.close()",
      "$F = open($$$_)\n$$$_\ntry:\n    $$$_\nfinally:\n    $F.close()",
      "$F = tarfile.open($$$_)",
      "$F = tarfile.open($$$_)\n$$$_\n$F.close()",
      "$F = tarfile.open($$$_)\n$$$_\ntry:\n    $$$_\nfinally:\n    $F.close()",
      "$F = tempfile.NamedTemporaryFile($$$_)",
      "$F = tempfile.NamedTemporaryFile($$$_)\n$$$_\n$F.close()",
      "$F = tempfile.NamedTemporaryFile($$$_)\n$$$_\ntry:\n    $$$_\nfinally:\n    $F.close()",
      "$F = tempfile.SpooledTemporaryFile($$$_)",
      "$F = tempfile.SpooledTemporaryFile($$$_)\n$$$_\n$F.close()",
      "$F = tempfile.SpooledTemporaryFile($$$_)\n$$$_\ntry:\n    $$$_\nfinally:\n    $F.close()",
      "$F = tempfile.TemporaryFile($$$_)",
      "$F = tempfile.TemporaryFile($$$_)\n$$$_\n$F.close()",
      "$F = tempfile.TemporaryFile($$$_)\n$$$_\ntry:\n    $$$_\nfinally:\n    $F.close()"
    ])) as $all
    | ( $all | of(["$F = open($$$_)","$F = io.open($$$_)","$F = tarfile.open($$$_)","$F = ZipFile.open($$$_)","$F = tempfile.TemporaryFile($$$_)","$F = tempfile.NamedTemporaryFile($$$_)","$F = tempfile.SpooledTemporaryFile($$$_)"])
          | outside($all | of(["$F = open($$$_)\n$$$_\n$F.close()"]))
          | outside($all | of(["$F = io.open($$$_)\n$$$_\n$F.close()"]))
          | outside($all | of(["$F = tarfile.open($$$_)\n$$$_\n$F.close()"]))
          | outside($all | of(["$F = ZipFile.open($$$_)\n$$$_\n$F.close()"]))
          | outside($all | of(["$F = tempfile.TemporaryFile($$$_)\n$$$_\n$F.close()"]))
          | outside($all | of(["$F = tempfile.NamedTemporaryFile($$$_)\n$$$_\n$F.close()"]))
          | outside($all | of(["$F = tempfile.SpooledTemporaryFile($$$_)\n$$$_\n$F.close()"]))
          | outside($all | of(["$F = open($$$_)\n$$$_\ntry:\n    $$$_\nfinally:\n    $F.close()"]))
          | outside($all | of(["$F = io.open($$$_)\n$$$_\ntry:\n    $$$_\nfinally:\n    $F.close()"]))
          | outside($all | of(["$F = tarfile.open($$$_)\n$$$_\ntry:\n    $$$_\nfinally:\n    $F.close()"]))
          | outside($all | of(["$F = ZipFile.open($$$_)\n$$$_\ntry:\n    $$$_\nfinally:\n    $F.close()"]))
          | outside($all | of(["$F = tempfile.TemporaryFile($$$_)\n$$$_\ntry:\n    $$$_\nfinally:\n    $F.close()"]))
          | outside($all | of(["$F = tempfile.NamedTemporaryFile($$$_)\n$$$_\ntry:\n    $$$_\nfinally:\n    $F.close()"]))
          | outside($all | of(["$F = tempfile.SpooledTemporaryFile($$$_)\n$$$_\ntry:\n    $$$_\nfinally:\n    $F.close()"]))
        | finding("open-never-closed";
            "file object opened without corresponding close") ) )
| report
