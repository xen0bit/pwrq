# rules: avoid-unsafe-ruamel
# languages: python
# from: python/lang/security/deserialization/avoid-unsafe-ruamel.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "ruamel.yaml.YAML($$$_, typ='base', $$$_)",
      "ruamel.yaml.YAML($$$_, typ='unsafe', $$$_)"
    ])) as $all
    | ( $all | of(["ruamel.yaml.YAML($$$_, typ='unsafe', $$$_)","ruamel.yaml.YAML($$$_, typ='base', $$$_)"])
        | finding("avoid-unsafe-ruamel";
            "Avoid using unsafe `ruamel.yaml.YAML()`.") ) )
| report
