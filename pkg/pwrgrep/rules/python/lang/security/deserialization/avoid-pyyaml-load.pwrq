# rules: avoid-pyyaml-load
# from: python/lang/security/deserialization/avoid-pyyaml-load.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$YAML = ruamel.yaml.YAML($$$_)\n$$$_",
      "import yaml\n$$$_",
      "yaml.load($$$_, Loader=yaml.CLoader, $$$_)",
      "yaml.load($$$_, Loader=yaml.Loader, $$$_)",
      "yaml.load($$$_, Loader=yaml.UnsafeLoader, $$$_)",
      "yaml.load_all($$$_, Loader=yaml.CLoader, $$$_)",
      "yaml.load_all($$$_, Loader=yaml.Loader, $$$_)",
      "yaml.load_all($$$_, Loader=yaml.UnsafeLoader, $$$_)",
      "yaml.unsafe_load($$$_)"
    ])) as $all
    | ( $all | of(["yaml.unsafe_load($$$_)","yaml.load($$$_, Loader=yaml.Loader, $$$_)","yaml.load($$$_, Loader=yaml.UnsafeLoader, $$$_)","yaml.load($$$_, Loader=yaml.CLoader, $$$_)","yaml.load_all($$$_, Loader=yaml.Loader, $$$_)","yaml.load_all($$$_, Loader=yaml.UnsafeLoader, $$$_)","yaml.load_all($$$_, Loader=yaml.CLoader, $$$_)"])
          | in_files_with($all | of(["import yaml\n$$$_"]))
          | in_files_without($all | of(["$YAML = ruamel.yaml.YAML($$$_)\n$$$_"]))
        | finding("avoid-pyyaml-load";
            "Detected a possible YAML deserialization vulnerability.") ) )
| report
