# rules: dangerous-annotations-usage
# languages: python
# from: python/lang/security/audit/dangerous-annotations-usage.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$C.__annotations__[$NAME] = \"$$$_\"",
      "$C.__annotations__[$NAME] = $X",
      "$C.__annotations__[$NAME] = typing.$Y"
    ])) as $all
    | ( $all | of(["$C.__annotations__[$NAME] = $X"])
          | not_at($all | of(["$C.__annotations__[$NAME] = \"$$$_\""]))
          | not_at($all | of(["$C.__annotations__[$NAME] = typing.$Y"]))
          | where_capture_not("X"; "^(?:(int|float|complex|list|tuple|range|str|bytes|bytearray|memoryview|set|frozenset|dict))")
        | finding("dangerous-annotations-usage";
            "Annotations passed to `typing.get_type_hints` are evaluated in `globals` and `locals` namespaces.") ) )
| report
