# rules: dangerous-interactive-code-run-audit
# from: python/lang/security/audit/dangerous-code-run-audit.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$PL = code.compile_command(\"$$$_\",$$$_)\n$$$_\n$X.runcode($PL,$$$_)",
      "$PL = code.compile_command($PAYLOAD,$$$_)\n$$$_\n$X.runcode($PL,$$$_)",
      "$X = code.InteractiveConsole($$$_)\n$$$_",
      "$X = code.InteractiveInterpreter($$$_)\n$$$_",
      "$X.push(\"$$$_\",$$$_)",
      "$X.push($PAYLOAD,$$$_)",
      "$X.runcode(code.compile_command(\"$$$_\"),$$$_)",
      "$X.runcode(code.compile_command($PAYLOAD),$$$_)",
      "$X.runsource(\"$$$_\",$$$_)",
      "$X.runsource($PAYLOAD,$$$_)"
    ])) as $all
    | ( $all | of(["$X.push($PAYLOAD,$$$_)","$X.runsource($PAYLOAD,$$$_)","$X.runcode(code.compile_command($PAYLOAD),$$$_)","$PL = code.compile_command($PAYLOAD,$$$_)\n$$$_\n$X.runcode($PL,$$$_)"])
          | at_same_place((($all)
          + ($all)))
          | not_at($all | of(["$X.push(\"$$$_\",$$$_)"]))
          | not_at($all | of(["$X.runsource(\"$$$_\",$$$_)"]))
          | not_at($all | of(["$X.runcode(code.compile_command(\"$$$_\"),$$$_)"]))
          | not_at($all | of(["$PL = code.compile_command(\"$$$_\",$$$_)\n$$$_\n$X.runcode($PL,$$$_)"]))
        | finding("dangerous-interactive-code-run-audit";
            "Found dynamic content inside InteractiveConsole/InteractiveInterpreter method.") ) )
| report
