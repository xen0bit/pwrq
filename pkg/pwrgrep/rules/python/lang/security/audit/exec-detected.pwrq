# rules: exec-detected
# languages: python
# from: python/lang/security/audit/exec-detected.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "exec(\"$$$_\")",
      "exec($$$_)"
    ])) as $all
    | ( $all | of(["exec($$$_)"])
          | not_at($all | of(["exec(\"$$$_\")"]))
        | finding("exec-detected";
            "Detected the use of exec().") ) )
| report
