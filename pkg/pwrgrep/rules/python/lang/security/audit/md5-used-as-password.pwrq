# rules: md5-used-as-password
# languages: python
# from: python/lang/security/audit/md5-used-as-password.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$FUNCTION($$$_)",
      "Crypto.Hash.MD5",
      "Cryptodome.Hash.MD5",
      "cryptography.hazmat.primitives.hashes.MD5",
      "hashlib.md5",
      "hashlib.new($$$_, name=\"MD5\", $$$_)"
    ])) as $all
    | ( (($all | of(["$FUNCTION($$$_)"])
          | where_capture("FUNCTION"; "^(?:(?i)(.*password.*))")))
          | reaching((($all | of(["hashlib.md5","hashlib.new($$$_, name=\"MD5\", $$$_)","Cryptodome.Hash.MD5","Crypto.Hash.MD5","cryptography.hazmat.primitives.hashes.MD5"])));
              ([]))
        | finding("md5-used-as-password";
            "It looks like MD5 is used as a password hash.") ) )
| report
