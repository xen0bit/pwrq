# rules: dangerous-subprocess-use-tainted-env-args
# languages: python
# from: python/lang/security/audit/dangerous-subprocess-use-tainted-env-args.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$A",
      "$ARGS",
      "$ARGS = $PARSER.parse_args()",
      "$OPTS, $ARGS = getopt.getopt($$$_)\n$$$_",
      "$OPTS, $ARGS = getopt.gnu_getopt($$$_)\n$$$_",
      "$PARSER = argparse.ArgumentParser($$$_)\n$$$_",
      "$PARSER = optparse.OptionParser($$$_)\n$$$_",
      "$PWRQDEEP1",
      "for $O, $A in $OPTS:\n  $$$_",
      "os.environ",
      "os.environ.get('$FOO', $$$_)",
      "os.environb",
      "os.environb.get('$FOO', $$$_)",
      "os.getenv('$ANYTHING', $$$_)",
      "os.getenvb('$ANYTHING', $$$_)",
      "shlex.quote($$$_)",
      "subprocess.$FUNC(\"$$$_\", $$$_)",
      "subprocess.$FUNC(\"=~/(python)/\", $CMD)",
      "subprocess.$FUNC(\"=~/(python)/\",\"$$$_\",$$$_)",
      "subprocess.$FUNC(\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\", $CMD)",
      "subprocess.$FUNC(\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\",\"$$$_\",$$$_)",
      "subprocess.$FUNC($CMD, $$$_)",
      "subprocess.$FUNC((\"$$$_\",$$$_), $$$_)",
      "subprocess.$FUNC((\"=~/(python)/\", $CMD),$$$_)",
      "subprocess.$FUNC((\"=~/(python)/\",\"$$$_\",$$$_),$$$_)",
      "subprocess.$FUNC((\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\", $CMD), $$$_)",
      "subprocess.$FUNC((\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\",\"$$$_\",$$$_),$$$_)",
      "subprocess.$FUNC([\"$$$_\",$$$_], $$$_)",
      "subprocess.$FUNC([\"=~/(python)/\", $CMD],$$$_)",
      "subprocess.$FUNC([\"=~/(python)/\",\"$$$_\",$$$_],$$$_)",
      "subprocess.$FUNC([\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\", $CMD], $$$_)",
      "subprocess.$FUNC([\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\",\"$$$_\",$$$_],$$$_)",
      "subprocess.CalledProcessError($$$_)",
      "subprocess.SubprocessError($$$_)",
      "sys.argv",
      "sys.orig_argv"
    ])) as $all
    | ( ((($all | of(["subprocess.$FUNC($CMD, $$$_)"])
          | not_at($all | of(["subprocess.$FUNC(\"$$$_\", $$$_)"]))
          | not_at($all | of(["subprocess.$FUNC([\"$$$_\",$$$_], $$$_)"]))
          | not_at($all | of(["subprocess.$FUNC((\"$$$_\",$$$_), $$$_)"]))
          | not_at($all | of(["subprocess.CalledProcessError($$$_)"]))
          | not_at($all | of(["subprocess.SubprocessError($$$_)"])))
          + ($all | of(["subprocess.$FUNC(\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\", $CMD)"])
          | not_at($all | of(["subprocess.$FUNC(\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\",\"$$$_\",$$$_)"])))
          + ($all | of(["subprocess.$FUNC([\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\", $CMD], $$$_)","subprocess.$FUNC((\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\", $CMD), $$$_)"])
          | not_at($all | of(["subprocess.$FUNC([\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\",\"$$$_\",$$$_],$$$_)"]))
          | not_at($all | of(["subprocess.$FUNC((\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\",\"$$$_\",$$$_),$$$_)"])))
          + ($all | of(["subprocess.$FUNC(\"=~/(python)/\", $CMD)"])
          | not_at($all | of(["subprocess.$FUNC(\"=~/(python)/\",\"$$$_\",$$$_)"])))
          + ($all | of(["subprocess.$FUNC([\"=~/(python)/\", $CMD],$$$_)","subprocess.$FUNC((\"=~/(python)/\", $CMD),$$$_)"])
          | not_at($all | of(["subprocess.$FUNC([\"=~/(python)/\",\"$$$_\",$$$_],$$$_)"]))
          | not_at($all | of(["subprocess.$FUNC((\"=~/(python)/\",\"$$$_\",$$$_),$$$_)"])))
          | focus("CMD")))
          | reaching(((($all | of(["os.environ","os.environ.get('$FOO', $$$_)","os.environb","os.environb.get('$FOO', $$$_)","os.getenv('$ANYTHING', $$$_)","os.getenvb('$ANYTHING', $$$_)"]))
          + (($all | of(["sys.argv","sys.orig_argv"]))
          + ($all | of(["$PWRQDEEP1"])
          | where_capture_ast("PWRQDEEP1"; "$ARGS")
          | in_files_with($all | of(["$PARSER = argparse.ArgumentParser($$$_)\n$$$_"]))
          | within($all | of(["$ARGS = $PARSER.parse_args()"])))
          + ($all | of(["$PWRQDEEP1"])
          | where_capture_ast("PWRQDEEP1"; "$ARGS")
          | in_files_with($all | of(["$PARSER = optparse.OptionParser($$$_)\n$$$_"]))
          | within($all | of(["$ARGS = $PARSER.parse_args()"])))
          + (($all
          | in_files_with($all | of(["$OPTS, $ARGS = getopt.getopt($$$_)\n$$$_"])))
          + ($all
          | in_files_with($all | of(["$OPTS, $ARGS = getopt.gnu_getopt($$$_)\n$$$_"])))
          | at_same_place((($all | of(["$A"])
          | within($all | of(["for $O, $A in $OPTS:\n  $$$_"])))
          + ($all | of(["$ARGS"]))))))));
              (($all | of(["shlex.quote($$$_)"]))))
        | finding("dangerous-subprocess-use-tainted-env-args";
            "Detected subprocess function '$FUNC' with user controlled data.") ) )
| report
