# rules: dangerous-asyncio-create-exec-audit
# languages: python
# from: python/lang/security/audit/dangerous-asyncio-create-exec-audit.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "asyncio.create_subprocess_exec($$$_)",
      "asyncio.create_subprocess_exec($PROG, \"$$$_\", $$$_)",
      "asyncio.create_subprocess_exec($PROG, \"=~/(sh|bash|ksh|csh|tcsh|zsh)/\", \"-c\", \"$$$_\", $$$_)",
      "asyncio.create_subprocess_exec($PROG, \"=~/(sh|bash|ksh|csh|tcsh|zsh)/\", \"-c\",$$$_)",
      "asyncio.create_subprocess_exec($PROG, [\"$$$_\",$$$_], $$$_)",
      "asyncio.create_subprocess_exec($PROG, [\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\", \"-c\", \"$$$_\", $$$_], $$$_)",
      "asyncio.create_subprocess_exec($PROG, [\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\", \"-c\", $$$_], $$$_)",
      "asyncio.subprocess.create_subprocess_exec($$$_)",
      "asyncio.subprocess.create_subprocess_exec($PROG, \"$$$_\", $$$_)",
      "asyncio.subprocess.create_subprocess_exec($PROG, \"=~/(sh|bash|ksh|csh|tcsh|zsh)/\", \"-c\", \"$$$_\", $$$_)",
      "asyncio.subprocess.create_subprocess_exec($PROG, \"=~/(sh|bash|ksh|csh|tcsh|zsh)/\", \"-c\",$$$_)",
      "asyncio.subprocess.create_subprocess_exec($PROG, [\"$$$_\",$$$_], $$$_)",
      "asyncio.subprocess.create_subprocess_exec($PROG, [\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\", \"-c\", \"$$$_\", $$$_], $$$_)",
      "asyncio.subprocess.create_subprocess_exec($PROG, [\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\", \"-c\", $$$_], $$$_)"
    ])) as $all
    | ( ($all | of(["asyncio.create_subprocess_exec($$$_)"])
          | not_at($all | of(["asyncio.create_subprocess_exec($PROG, \"$$$_\", $$$_)"]))
          | not_at($all | of(["asyncio.create_subprocess_exec($PROG, [\"$$$_\",$$$_], $$$_)"])))
          + ($all | of(["asyncio.create_subprocess_exec($PROG, \"=~/(sh|bash|ksh|csh|tcsh|zsh)/\", \"-c\",$$$_)"])
          | not_at($all | of(["asyncio.create_subprocess_exec($PROG, \"=~/(sh|bash|ksh|csh|tcsh|zsh)/\", \"-c\", \"$$$_\", $$$_)"])))
          + ($all | of(["asyncio.create_subprocess_exec($PROG, [\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\", \"-c\", $$$_], $$$_)"])
          | not_at($all | of(["asyncio.create_subprocess_exec($PROG, [\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\", \"-c\", \"$$$_\", $$$_], $$$_)"])))
          + ($all | of(["asyncio.subprocess.create_subprocess_exec($$$_)"])
          | not_at($all | of(["asyncio.subprocess.create_subprocess_exec($PROG, \"$$$_\", $$$_)"]))
          | not_at($all | of(["asyncio.subprocess.create_subprocess_exec($PROG, [\"$$$_\",$$$_], $$$_)"])))
          + ($all | of(["asyncio.subprocess.create_subprocess_exec($PROG, \"=~/(sh|bash|ksh|csh|tcsh|zsh)/\", \"-c\",$$$_)"])
          | not_at($all | of(["asyncio.subprocess.create_subprocess_exec($PROG, \"=~/(sh|bash|ksh|csh|tcsh|zsh)/\", \"-c\", \"$$$_\", $$$_)"])))
          + ($all | of(["asyncio.subprocess.create_subprocess_exec($PROG, [\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\", \"-c\", $$$_], $$$_)"])
          | not_at($all | of(["asyncio.subprocess.create_subprocess_exec($PROG, [\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\", \"-c\", \"$$$_\", $$$_], $$$_)"])))
        | finding("dangerous-asyncio-create-exec-audit";
            "Detected 'create_subprocess_exec' function without a static string.") ) )
| report
