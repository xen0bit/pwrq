# rules: paramiko-implicit-trust-host-key
# from: python/lang/security/audit/paramiko-implicit-trust-host-key.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$CLIENT = paramiko.client.SSHClient($$$_)\n$$$_\n$CLIENT.set_missing_host_key_policy($$$_)",
      "paramiko.client.AutoAddPolicy",
      "paramiko.client.WarningPolicy"
    ])) as $all
    | ( $all | of(["paramiko.client.AutoAddPolicy","paramiko.client.WarningPolicy"])
          | within($all | of(["$CLIENT = paramiko.client.SSHClient($$$_)\n$$$_\n$CLIENT.set_missing_host_key_policy($$$_)"]))
        | finding("paramiko-implicit-trust-host-key";
            "Detected a paramiko host key policy that implicitly trusts a server's host key.") ) )
| report
