# rules: ssl-wrap-socket-is-deprecated
# from: python/lang/security/audit/ssl-wrap-socket-is-deprecated.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "ssl.wrap_socket($$$_)"
    ])) as $all
    | ( $all | of(["ssl.wrap_socket($$$_)"])
        | finding("ssl-wrap-socket-is-deprecated";
            "'ssl.wrap_socket()' is deprecated.") ) )
| report
