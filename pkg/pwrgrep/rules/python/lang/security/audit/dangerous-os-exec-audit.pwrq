# rules: dangerous-os-exec-audit
# languages: python
# from: python/lang/security/audit/dangerous-os-exec-audit.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "os.$METHOD(\"$$$_\", $$$_)",
      "os.$METHOD(\"$$$_\", $PATH, \"$$$_\", \"$$$_\",$$$_)",
      "os.$METHOD(\"$$$_\", [$PATH,\"$$$_\",\"$$$_\",$$$_],$$$_)",
      "os.$METHOD($$$_)",
      "os.$METHOD($BASH, $PATH, \"-c\", $CMD,$$$_)",
      "os.$METHOD($BASH,[$PATH,\"-c\",$CMD,$$$_],$$$_)"
    ])) as $all
    | ( ($all | of(["os.$METHOD($$$_)"])
          | not_at($all | of(["os.$METHOD(\"$$$_\", $$$_)"]))
          | where_capture("METHOD"; "^(?:(execl|execle|execlp|execlpe|execv|execve|execvp|execvpe))"))
          + ($all | of(["os.$METHOD($BASH,[$PATH,\"-c\",$CMD,$$$_],$$$_)"])
          | not_at($all | of(["os.$METHOD(\"$$$_\", [$PATH,\"$$$_\",\"$$$_\",$$$_],$$$_)"]))
          | where_capture("METHOD"; "^(?:(execv|execve|execvp|execvpe))")
          | where_capture("BASH"; "^(?:(.*)(sh|bash|ksh|csh|tcsh|zsh))"))
          + ($all | of(["os.$METHOD($BASH, $PATH, \"-c\", $CMD,$$$_)"])
          | not_at($all | of(["os.$METHOD(\"$$$_\", $PATH, \"$$$_\", \"$$$_\",$$$_)"]))
          | where_capture("METHOD"; "^(?:(execl|execle|execlp|execlpe))")
          | where_capture("BASH"; "^(?:(.*)(sh|bash|ksh|csh|tcsh|zsh))"))
        | finding("dangerous-os-exec-audit";
            "Found dynamic content when spawning a process.") ) )
| report
