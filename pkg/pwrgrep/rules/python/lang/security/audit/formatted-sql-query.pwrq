# rules: formatted-sql-query
# languages: python
# from: python/lang/security/audit/formatted-sql-query.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "\"$$$_\"",
      "$DB.execute(\"$$$_\" % $$$_)",
      "$DB.execute(\"$$$_\".format($$$_))",
      "$DB.execute($SQL)",
      "$DB.execute(f\"$$$_\")",
      "$SQL = \"$$$_\" % $$$_\n$$$_",
      "$SQL = \"$$$_\".format($$$_)\n$$$_",
      "$SQL = f\"$$$_{$X}$$$_\"\n$$$_"
    ])) as $all
    | ( ($all | of(["$DB.execute(\"$$$_\" % $$$_)"]))
          + ($all | of(["$DB.execute(\"$$$_\".format($$$_))"]))
          + ($all | of(["$DB.execute(f\"$$$_\")"]))
          + (($all
          | in_files_with($all | of(["$SQL = \"$$$_\" % $$$_\n$$$_","\"$$$_\""])))
          + ($all
          | in_files_with($all | of(["$SQL = \"$$$_\".format($$$_)\n$$$_","\"$$$_\""])))
          + ($all
          | in_files_with($all | of(["$SQL = f\"$$$_{$X}$$$_\"\n$$$_"])))
          | at_same_place(($all | of(["$DB.execute($SQL)"]))))
        | finding("formatted-sql-query";
            "Detected possible formatted SQL query.") ) )
| report
