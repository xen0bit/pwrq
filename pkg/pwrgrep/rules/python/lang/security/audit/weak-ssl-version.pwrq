# rules: weak-ssl-version
# languages: python
# from: python/lang/security/audit/weak-ssl-version.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "pyOpenSSL.SSL.SSLv23_METHOD",
      "pyOpenSSL.SSL.SSLv2_METHOD",
      "pyOpenSSL.SSL.SSLv3_METHOD",
      "pyOpenSSL.SSL.TLSv1_1_METHOD",
      "pyOpenSSL.SSL.TLSv1_METHOD",
      "ssl.PROTOCOL_SSLv2",
      "ssl.PROTOCOL_SSLv3",
      "ssl.PROTOCOL_TLSv1",
      "ssl.PROTOCOL_TLSv1_1"
    ])) as $all
    | ( $all | of(["ssl.PROTOCOL_SSLv2","ssl.PROTOCOL_SSLv3","ssl.PROTOCOL_TLSv1","ssl.PROTOCOL_TLSv1_1","pyOpenSSL.SSL.SSLv2_METHOD","pyOpenSSL.SSL.SSLv23_METHOD","pyOpenSSL.SSL.SSLv3_METHOD","pyOpenSSL.SSL.TLSv1_METHOD","pyOpenSSL.SSL.TLSv1_1_METHOD"])
        | finding("weak-ssl-version";
            "An insecure SSL version was detected.") ) )
| report
