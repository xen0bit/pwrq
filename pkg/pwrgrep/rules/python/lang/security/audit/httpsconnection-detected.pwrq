# rules: httpsconnection-detected
# from: python/lang/security/audit/httpsconnection-detected.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "http.client.HTTPSConnection($$$_)",
      "httplib.HTTPSConnection($$$_)",
      "six.moves.http_client.HTTPSConnection($$$_)"
    ])) as $all
    | ( $all | of(["httplib.HTTPSConnection($$$_)","http.client.HTTPSConnection($$$_)","six.moves.http_client.HTTPSConnection($$$_)"])
        | finding("httpsconnection-detected";
            "The HTTPSConnection API has changed frequently with minor releases of Python.") ) )
| report
