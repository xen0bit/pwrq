# rules: python-logger-credential-disclosure
# languages: python
# from: python/lang/security/audit/logging/logger-credential-leak.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$LOGGER_OBJ.$LOGGER_CALL($FORMAT_STRING,$$$_)"
    ])) as $all
    | ( $all | of(["$LOGGER_OBJ.$LOGGER_CALL($FORMAT_STRING,$$$_)"])
          | where_capture("LOGGER_OBJ"; "^(?:(?i)(_logger|logger|self.logger|log))")
          | where_capture("LOGGER_CALL"; "^(?:(debug|info|warn|warning|error|exception|critical))")
          | where_capture("FORMAT_STRING"; "^(?:(?i).*(api.key|secret|credential|token|password).*\\%s.*)")
        | finding("python-logger-credential-disclosure";
            "Detected a python logger call with a potential hardcoded secret $FORMAT_STRING being logged.") ) )
| report
