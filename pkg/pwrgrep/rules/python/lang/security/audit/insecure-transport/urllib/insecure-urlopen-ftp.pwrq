# rules: insecure-urlopen-ftp
# languages: python
# from: python/lang/security/audit/insecure-transport/urllib/insecure-urlopen-ftp.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$URL = \"=~/^[Ff][Tt][Pp]://.*/\"\n$$$_\nurllib.request.urlopen($URL, $$$_)",
      "def $FUNC($$$_, $URL = \"=~/^[Ff][Tt][Pp]://.*/\", $$$_):\n  $$$_\n  urllib.request.urlopen($URL, $$$_)",
      "urllib.request.urlopen(\"=~/^[Ff][Tt][Pp]://.*/\", $$$_)"
    ])) as $all
    | ( $all | of(["urllib.request.urlopen(\"=~/^[Ff][Tt][Pp]://.*/\", $$$_)","$URL = \"=~/^[Ff][Tt][Pp]://.*/\"\n$$$_\nurllib.request.urlopen($URL, $$$_)","def $FUNC($$$_, $URL = \"=~/^[Ff][Tt][Pp]://.*/\", $$$_):\n  $$$_\n  urllib.request.urlopen($URL, $$$_)"])
        | finding("insecure-urlopen-ftp";
            "Detected 'urllib.urlopen()' using 'ftp://'.") ) )
| report
