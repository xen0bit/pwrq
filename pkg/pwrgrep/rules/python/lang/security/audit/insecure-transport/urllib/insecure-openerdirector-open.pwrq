# rules: insecure-openerdirector-open
# from: python/lang/security/audit/insecure-transport/urllib/insecure-openerdirector-open.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$OPENERDIRECTOR = urllib.request.OpenerDirector($$$_)\n$$$_",
      "$OPENERDIRECTOR.open(\"=~/[Hh][Tt][Tt][Pp]://.*/\", $$$_)",
      "$OPENERDIRECTOR.open($URL, $$$_)",
      "$URL = \"=~/[Hh][Tt][Tt][Pp]://.*/\"\n$$$_\n$OPENERDIRECTOR.open($URL, $$$_)",
      "$URL = \"=~/[Hh][Tt][Tt][Pp]://.*/\"\n$$$_\nurllib.request.OpenerDirector($$$_).open($URL, $$$_)",
      "def $FUNC($$$_, $URL = \"=~/[Hh][Tt][Tt][Pp]://.*/\", $$$_):\n  $$$_",
      "urllib.request.OpenerDirector($$$_).open(\"=~/[Hh][Tt][Tt][Pp]://.*/\", $$$_)",
      "urllib.request.OpenerDirector($$$_).open($URL, $$$_)"
    ])) as $all
    | ( ($all | of(["urllib.request.OpenerDirector($$$_).open(\"=~/[Hh][Tt][Tt][Pp]://.*/\", $$$_)"]))
          + ($all | of(["$OPENERDIRECTOR.open(\"=~/[Hh][Tt][Tt][Pp]://.*/\", $$$_)"])
          | in_files_with($all | of(["$OPENERDIRECTOR = urllib.request.OpenerDirector($$$_)\n$$$_"])))
          + ($all | of(["$URL = \"=~/[Hh][Tt][Tt][Pp]://.*/\"\n$$$_\n$OPENERDIRECTOR.open($URL, $$$_)"])
          | in_files_with($all | of(["$OPENERDIRECTOR = urllib.request.OpenerDirector($$$_)\n$$$_"])))
          + ($all | of(["$URL = \"=~/[Hh][Tt][Tt][Pp]://.*/\"\n$$$_\nurllib.request.OpenerDirector($$$_).open($URL, $$$_)"]))
          + (($all | of(["urllib.request.OpenerDirector($$$_).open($URL, $$$_)"]))
          + ($all | of(["$OPENERDIRECTOR.open($URL, $$$_)"])
          | in_files_with($all | of(["$OPENERDIRECTOR = urllib.request.OpenerDirector($$$_)\n$$$_"])))
          | within($all | of(["def $FUNC($$$_, $URL = \"=~/[Hh][Tt][Tt][Pp]://.*/\", $$$_):\n  $$$_"])))
        | finding("insecure-openerdirector-open";
            "Detected an unsecured transmission channel.") ) )
| report
