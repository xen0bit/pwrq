# rules: insecure-urlretrieve-ftp
# from: python/lang/security/audit/insecure-transport/urllib/insecure-urlretrieve-ftp.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$URL = \"=~/^[Ff][Tt][Pp]://.*/\"\n$$$_\nurllib.request.urlretrieve($URL, $$$_)",
      "def $FUNC($$$_, $URL = \"=~/^[Ff][Tt][Pp]://.*/\", $$$_):\n  $$$_\n  urllib.request.urlretrieve($URL, $$$_)",
      "urllib.request.urlretrieve(\"=~/^[Ff][Tt][Pp]://.*/\", $$$_)"
    ])) as $all
    | ( $all | of(["urllib.request.urlretrieve(\"=~/^[Ff][Tt][Pp]://.*/\", $$$_)","$URL = \"=~/^[Ff][Tt][Pp]://.*/\"\n$$$_\nurllib.request.urlretrieve($URL, $$$_)","def $FUNC($$$_, $URL = \"=~/^[Ff][Tt][Pp]://.*/\", $$$_):\n  $$$_\n  urllib.request.urlretrieve($URL, $$$_)"])
        | finding("insecure-urlretrieve-ftp";
            "Detected 'urllib.urlretrieve()' using 'ftp://'.") ) )
| report
