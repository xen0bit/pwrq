# rules: request-session-http-in-with-context
# languages: python
# from: python/lang/security/audit/insecure-transport/requests/request-session-http-in-with-context.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "\"$URL\"",
      "$SESSION.$W($SINK, $$$_)",
      "$SESSION.request($METHOD, $SINK, $$$_)",
      "with requests.Session($$$_) as $SESSION:\n  $$$_"
    ])) as $all
    | ( (($all | of(["$SESSION.$W($SINK, $$$_)","$SESSION.request($METHOD, $SINK, $$$_)"])
          | within($all | of(["with requests.Session($$$_) as $SESSION:\n  $$$_"]))
          | focus("SINK")))
          | reaching((($all | of(["\"$URL\""])));
              ([]))
        | finding("request-session-http-in-with-context";
            "Detected a request using 'http://'.") ) )
| report
