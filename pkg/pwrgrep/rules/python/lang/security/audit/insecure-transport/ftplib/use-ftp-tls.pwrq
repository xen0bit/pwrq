# rules: use-ftp-tls
# from: python/lang/security/audit/insecure-transport/ftplib/use-ftp-tls.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "ftplib.FTP($$$_)",
      "ftplib.FTP_TLS($$$_)"
    ])) as $all
    | ( $all | of(["ftplib.FTP($$$_)"])
          | not_at($all | of(["ftplib.FTP_TLS($$$_)"]))
        | finding("use-ftp-tls";
            "The 'FTP' class sends information unencrypted.") ) )
| report
