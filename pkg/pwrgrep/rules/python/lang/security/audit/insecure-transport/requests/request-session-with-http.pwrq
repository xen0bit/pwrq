# rules: request-session-with-http
# languages: python
# from: python/lang/security/audit/insecure-transport/requests/request-session-with-http.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "\"$URL\"",
      "requests.Session($$$_).$W($SINK, $$$_)",
      "requests.Session($$$_).request($METHOD, $SINK, $$$_)"
    ])) as $all
    | ( (($all | of(["requests.Session($$$_).$W($SINK, $$$_)","requests.Session($$$_).request($METHOD, $SINK, $$$_)"])
          | focus("SINK")))
          | reaching((($all | of(["\"$URL\""])));
              ([]))
        | finding("request-session-with-http";
            "Detected a request using 'http://'.") ) )
| report
