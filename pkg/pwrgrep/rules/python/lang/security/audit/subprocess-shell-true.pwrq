# rules: subprocess-shell-true
# languages: python
# from: python/lang/security/audit/subprocess-shell-true.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "subprocess.$FUNC(\"$$$_\", shell=True, $$$_)",
      "subprocess.$FUNC($$$_, shell=$TRUE, $$$_)"
    ])) as $all
    | ( $all | of(["subprocess.$FUNC($$$_, shell=$TRUE, $$$_)"])
          | where_capture_ast("TRUE"; "True")
          | not_at($all | of(["subprocess.$FUNC(\"$$$_\", shell=True, $$$_)"]))
          | focus("TRUE")
        | finding("subprocess-shell-true";
            "Found 'subprocess' function '$FUNC' with 'shell=True'.") ) )
| report
