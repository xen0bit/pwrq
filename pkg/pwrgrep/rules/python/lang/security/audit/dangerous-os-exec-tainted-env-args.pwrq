# rules: dangerous-os-exec-tainted-env-args
# languages: python
# from: python/lang/security/audit/dangerous-os-exec-tainted-env-args.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$A",
      "$ARGS",
      "$ARGS = $PARSER.parse_args()",
      "$CMD",
      "$OPTS, $ARGS = getopt.getopt($$$_)\n$$$_",
      "$OPTS, $ARGS = getopt.gnu_getopt($$$_)\n$$$_",
      "$PARSER = argparse.ArgumentParser($$$_)\n$$$_",
      "$PARSER = optparse.OptionParser($$$_)\n$$$_",
      "$PWRQDEEP1",
      "for $O, $A in $OPTS:\n  $$$_",
      "os.$METHOD(\"$$$_\", $$$_)",
      "os.$METHOD(\"$$$_\", $PATH, \"$$$_\", \"$$$_\",$$$_)",
      "os.$METHOD(\"$$$_\", [$PATH,\"$$$_\",\"$$$_\",$$$_],$$$_)",
      "os.$METHOD($$$_)",
      "os.$METHOD($BASH, $PATH, \"-c\", $CMD,$$$_)",
      "os.$METHOD($BASH,[$PATH,\"-c\",$CMD,$$$_],$$$_)",
      "os.environ",
      "os.environ.get('$FOO', $$$_)",
      "os.environb",
      "os.environb.get('$FOO', $$$_)",
      "os.getenv('$ANYTHING', $$$_)",
      "os.getenvb('$ANYTHING', $$$_)",
      "sys.argv",
      "sys.orig_argv"
    ])) as $all
    | ( ((($all | of(["os.$METHOD($$$_)"])
          | not_at($all | of(["os.$METHOD(\"$$$_\", $$$_)"]))
          | where_capture("METHOD"; "^(?:(execl|execle|execlp|execlpe|execv|execve|execvp|execvpe))"))
          + ($all | of(["$CMD"])
          | not_at($all | of(["os.$METHOD(\"$$$_\", [$PATH,\"$$$_\",\"$$$_\",$$$_],$$$_)"]))
          | within($all | of(["os.$METHOD($BASH,[$PATH,\"-c\",$CMD,$$$_],$$$_)"]))
          | where_capture("METHOD"; "^(?:(execv|execve|execvp|execvpe))")
          | where_capture("BASH"; "^(?:(.*)(sh|bash|ksh|csh|tcsh|zsh))"))
          + ($all | of(["$CMD"])
          | not_at($all | of(["os.$METHOD(\"$$$_\", $PATH, \"$$$_\", \"$$$_\",$$$_)"]))
          | within($all | of(["os.$METHOD($BASH, $PATH, \"-c\", $CMD,$$$_)"]))
          | where_capture("METHOD"; "^(?:(execl|execle|execlp|execlpe))")
          | where_capture("BASH"; "^(?:(.*)(sh|bash|ksh|csh|tcsh|zsh))"))))
          | reaching(((($all | of(["os.environ","os.environ.get('$FOO', $$$_)","os.environb","os.environb.get('$FOO', $$$_)","os.getenv('$ANYTHING', $$$_)","os.getenvb('$ANYTHING', $$$_)"]))
          + (($all | of(["sys.argv","sys.orig_argv"]))
          + ($all | of(["$PWRQDEEP1"])
          | where_capture_ast("PWRQDEEP1"; "$ARGS")
          | in_files_with($all | of(["$PARSER = argparse.ArgumentParser($$$_)\n$$$_"]))
          | within($all | of(["$ARGS = $PARSER.parse_args()"])))
          + ($all | of(["$PWRQDEEP1"])
          | where_capture_ast("PWRQDEEP1"; "$ARGS")
          | in_files_with($all | of(["$PARSER = optparse.OptionParser($$$_)\n$$$_"]))
          | within($all | of(["$ARGS = $PARSER.parse_args()"])))
          + (($all
          | in_files_with($all | of(["$OPTS, $ARGS = getopt.getopt($$$_)\n$$$_"])))
          + ($all
          | in_files_with($all | of(["$OPTS, $ARGS = getopt.gnu_getopt($$$_)\n$$$_"])))
          | at_same_place((($all | of(["$A"])
          | within($all | of(["for $O, $A in $OPTS:\n  $$$_"])))
          + ($all | of(["$ARGS"]))))))));
              ([]))
        | finding("dangerous-os-exec-tainted-env-args";
            "Found user controlled content when spawning a process.") ) )
| report
