# rules: dangerous-testcapi-run-in-subinterp-tainted-env-args
# languages: python
# from: python/lang/security/audit/dangerous-testcapi-run-in-subinterp-tainted-env-args.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$A",
      "$ARGS",
      "$ARGS = $PARSER.parse_args()",
      "$OPTS, $ARGS = getopt.getopt($$$_)\n$$$_",
      "$OPTS, $ARGS = getopt.gnu_getopt($$$_)\n$$$_",
      "$PARSER = argparse.ArgumentParser($$$_)\n$$$_",
      "$PARSER = optparse.OptionParser($$$_)\n$$$_",
      "$PAYLOAD",
      "$PWRQDEEP1",
      "_testcapi.run_in_subinterp(\"$$$_\", $$$_)",
      "_testcapi.run_in_subinterp($PAYLOAD, $$$_)",
      "for $O, $A in $OPTS:\n  $$$_",
      "os.environ",
      "os.environ.get('$FOO', $$$_)",
      "os.environb",
      "os.environb.get('$FOO', $$$_)",
      "os.getenv('$ANYTHING', $$$_)",
      "os.getenvb('$ANYTHING', $$$_)",
      "sys.argv",
      "sys.orig_argv",
      "test.support.run_in_subinterp(\"$$$_\", $$$_)",
      "test.support.run_in_subinterp($PAYLOAD, $$$_)"
    ])) as $all
    | ( ((($all
          | within($all | of(["_testcapi.run_in_subinterp($PAYLOAD, $$$_)"])))
          + ($all
          | within($all | of(["test.support.run_in_subinterp($PAYLOAD, $$$_)"])))
          | at_same_place(($all | of(["$PAYLOAD"])))
          | not_at($all | of(["_testcapi.run_in_subinterp(\"$$$_\", $$$_)"]))
          | not_at($all | of(["test.support.run_in_subinterp(\"$$$_\", $$$_)"]))))
          | reaching(((($all | of(["os.environ","os.environ.get('$FOO', $$$_)","os.environb","os.environb.get('$FOO', $$$_)","os.getenv('$ANYTHING', $$$_)","os.getenvb('$ANYTHING', $$$_)"]))
          + (($all | of(["sys.argv","sys.orig_argv"]))
          + ($all | of(["$PWRQDEEP1"])
          | where_capture_ast("PWRQDEEP1"; "$ARGS")
          | in_files_with($all | of(["$PARSER = argparse.ArgumentParser($$$_)\n$$$_"]))
          | within($all | of(["$ARGS = $PARSER.parse_args()"])))
          + ($all | of(["$PWRQDEEP1"])
          | where_capture_ast("PWRQDEEP1"; "$ARGS")
          | in_files_with($all | of(["$PARSER = optparse.OptionParser($$$_)\n$$$_"]))
          | within($all | of(["$ARGS = $PARSER.parse_args()"])))
          + (($all
          | in_files_with($all | of(["$OPTS, $ARGS = getopt.getopt($$$_)\n$$$_"])))
          + ($all
          | in_files_with($all | of(["$OPTS, $ARGS = getopt.gnu_getopt($$$_)\n$$$_"])))
          | at_same_place((($all | of(["$A"])
          | within($all | of(["for $O, $A in $OPTS:\n  $$$_"])))
          + ($all | of(["$ARGS"]))))))));
              ([]))
        | finding("dangerous-testcapi-run-in-subinterp-tainted-env-args";
            "Found user controlled content in `run_in_subinterp`.") ) )
| report
