# rules: dangerous-subprocess-use-audit
# languages: python
# from: python/lang/security/audit/dangerous-subprocess-use-audit.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$ARR = [\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\", \"-c\", $$$_]\n$$$_",
      "$ARR = [$$$_]\n$$$_",
      "subprocess.$FUNC(\"$$$_\", $$$_)",
      "subprocess.$FUNC(\"=~/(python)/\",\"$$$_\",$$$_)",
      "subprocess.$FUNC(\"=~/(python)/\",$$$_)",
      "subprocess.$FUNC(\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\",\"$$$_\",$$$_)",
      "subprocess.$FUNC(\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\",$$$_)",
      "subprocess.$FUNC($$$_)",
      "subprocess.$FUNC((\"$$$_\",$$$_), $$$_)",
      "subprocess.$FUNC((\"=~/(python)/\",\"$$$_\",$$$_),$$$_)",
      "subprocess.$FUNC((\"=~/(python)/\",$$$_),$$$_)",
      "subprocess.$FUNC((\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\",\"$$$_\",$$$_),$$$_)",
      "subprocess.$FUNC((\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\",$$$_),$$$_)",
      "subprocess.$FUNC(*$ARR, $$$_)",
      "subprocess.$FUNC([\"$$$_\",$$$_], $$$_)",
      "subprocess.$FUNC([\"=~/(python)/\",\"$$$_\",$$$_],$$$_)",
      "subprocess.$FUNC([\"=~/(python)/\",$$$_],$$$_)",
      "subprocess.$FUNC([\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\",\"$$$_\",$$$_],$$$_)",
      "subprocess.$FUNC([\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\",$$$_],$$$_)",
      "subprocess.$FUNC([*$ARR, $$$_])",
      "subprocess.CalledProcessError($$$_)",
      "subprocess.SubprocessError($$$_)"
    ])) as $all
    | ( ($all | of(["subprocess.$FUNC($$$_)"])
          | not_at($all | of(["subprocess.$FUNC(\"$$$_\", $$$_)"]))
          | not_at($all | of(["subprocess.$FUNC([\"$$$_\",$$$_], $$$_)"]))
          | not_at($all | of(["subprocess.$FUNC((\"$$$_\",$$$_), $$$_)"]))
          | not_at(($all | of(["subprocess.$FUNC(*$ARR, $$$_)","subprocess.$FUNC([*$ARR, $$$_])"])
          | in_files_without($all | of(["$ARR = [\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\", \"-c\", $$$_]\n$$$_"]))
          | in_files_with($all | of(["$ARR = [$$$_]\n$$$_"]))))
          | not_at($all | of(["subprocess.CalledProcessError($$$_)"]))
          | not_at($all | of(["subprocess.SubprocessError($$$_)"])))
          + ($all | of(["subprocess.$FUNC(\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\",$$$_)"])
          | not_at($all | of(["subprocess.$FUNC(\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\",\"$$$_\",$$$_)"])))
          + ($all | of(["subprocess.$FUNC([\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\",$$$_],$$$_)","subprocess.$FUNC((\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\",$$$_),$$$_)"])
          | not_at($all | of(["subprocess.$FUNC([\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\",\"$$$_\",$$$_],$$$_)"]))
          | not_at($all | of(["subprocess.$FUNC((\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\",\"$$$_\",$$$_),$$$_)"])))
          + ($all | of(["subprocess.$FUNC(\"=~/(python)/\",$$$_)"])
          | not_at($all | of(["subprocess.$FUNC(\"=~/(python)/\",\"$$$_\",$$$_)"])))
          + ($all | of(["subprocess.$FUNC([\"=~/(python)/\",$$$_],$$$_)","subprocess.$FUNC((\"=~/(python)/\",$$$_),$$$_)"])
          | not_at($all | of(["subprocess.$FUNC([\"=~/(python)/\",\"$$$_\",$$$_],$$$_)"]))
          | not_at($all | of(["subprocess.$FUNC((\"=~/(python)/\",\"$$$_\",$$$_),$$$_)"])))
        | finding("dangerous-subprocess-use-audit";
            "Detected subprocess function '$FUNC' without a static string.") ) )
| report
