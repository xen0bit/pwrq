# rules: use-defused-xml-parse
# from: python/lang/security/use-defused-xml-parse.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "xml.etree.ElementTree.parse(\"$$$_\")",
      "xml.etree.ElementTree.parse($$$ARGS)"
    ])) as $all
    | ( $all | of(["xml.etree.ElementTree.parse($$$ARGS)"])
          | not_at($all | of(["xml.etree.ElementTree.parse(\"$$$_\")"]))
        | finding("use-defused-xml-parse";
            "The native Python `xml` library is vulnerable to XML External Entity (XXE) attacks.") ) )
| report
