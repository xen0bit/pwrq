# rules: use-defused-xmlrpc
# languages: python
# from: python/lang/security/use-defused-xmlrpc.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "import SimpleXMLRPCServer",
      "import xmlrpc",
      "import xmlrpclib"
    ])) as $all
    | ( $all | of(["import xmlrpclib","import SimpleXMLRPCServer","import xmlrpc"])
        | finding("use-defused-xmlrpc";
            "Detected use of xmlrpc.") ) )
| report
