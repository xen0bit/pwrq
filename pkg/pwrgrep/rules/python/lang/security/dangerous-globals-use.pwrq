# rules: dangerous-globals-use
# from: python/lang/security/dangerous-globals-use.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$FUNC.__globals__[\"$$$_\"]",
      "$FUNC.__globals__[$$$_]",
      "$FUNC.__globals__[$$$_] = $$$_",
      "$G = globals()\n$$$_",
      "$G = locals()\n$$$_",
      "$G.get(\"$$$_\")",
      "$G.get($$$_)",
      "$G.get[\"$$$_\"]",
      "$G[\"$$$_\"]",
      "$G[$$$_]",
      "$G[$$$_] = $$$_",
      "globals().get(\"$$$_\")",
      "globals().get($$$_)",
      "globals()[\"$$$_\"]",
      "globals()[$$$_]",
      "globals()[$$$_] = $$$_",
      "locals().get(\"$$$_\")",
      "locals().get($$$_)",
      "locals()[\"$$$_\"]",
      "locals()[$$$_]",
      "locals()[$$$_] = $$$_"
    ])) as $all
    | ( ($all | of(["globals().get($$$_)"]))
          + ($all | of(["locals().get($$$_)"]))
          + ($all | of(["globals()[$$$_]"]))
          + ($all | of(["locals()[$$$_]"]))
          + (($all)
          + ($all)
          | at_same_place(($all | of(["$G.get($$$_)","$G[$$$_]"]))))
          + ($all | of(["$FUNC.__globals__[$$$_]"]))
          | not_at($all | of(["globals().get(\"$$$_\")"]))
          | not_at($all | of(["locals().get(\"$$$_\")"]))
          | not_at($all | of(["globals()[\"$$$_\"]"]))
          | not_at($all | of(["locals()[\"$$$_\"]"]))
          | not_at($all | of(["$G.get(\"$$$_\")"]))
          | not_at($all | of(["$G.get[\"$$$_\"]"]))
          | not_at($all | of(["$G[\"$$$_\"]"]))
          | not_at($all | of(["$FUNC.__globals__[\"$$$_\"]"]))
          | outside($all | of(["globals()[$$$_] = $$$_"]))
          | outside($all | of(["locals()[$$$_] = $$$_"]))
          | outside($all | of(["$G[$$$_] = $$$_"]))
          | outside($all | of(["$FUNC.__globals__[$$$_] = $$$_"]))
        | finding("dangerous-globals-use";
            "Found non static data as an index to 'globals()'.") ) )
| report
