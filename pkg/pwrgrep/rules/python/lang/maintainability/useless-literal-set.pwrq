# rules: useless-literal-set
# languages: python
# from: python/lang/maintainability/useless-literal-set.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "set($$$_, ($X, $A), $$$_, ($X, $B), $$$_)"
    ])) as $all
    | ( $all | of(["set($$$_, ($X, $A), $$$_, ($X, $B), $$$_)"])
          | focus("X")
        | finding("useless-literal-set";
            "`$X` is uselessly assigned twice inside the creation of the set") ) )
| report
