# rules: useless-if-conditional, useless-if-body
# from: python/lang/maintainability/useless-ifelse.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "if $X:\n    $$$_\nelif $X:\n    $$$_",
      "if $X:\n    $S\nelse:\n    $S"
    ])) as $all
    | ( $all | of(["if $X:\n    $$$_\nelif $X:\n    $$$_"])
        | finding("useless-if-conditional";
            "if block checks for the same condition on both branches (`$X`)") )
      + ( $all | of(["if $X:\n    $S\nelse:\n    $S"])
        | finding("useless-if-body";
            "Useless if statement; both blocks have the same body") ) )
| report
