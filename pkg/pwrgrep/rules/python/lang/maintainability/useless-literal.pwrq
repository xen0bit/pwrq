# rules: useless-literal
# languages: python
# from: python/lang/maintainability/useless-literal.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "dict($$$_, ($X, $A), $$$_, ($X, $B), $$$_)",
      "{$$$_, $X: $A, $$$_, $X: $B, $$$_}"
    ])) as $all
    | ( $all | of(["{$$$_, $X: $A, $$$_, $X: $B, $$$_}","dict($$$_, ($X, $A), $$$_, ($X, $B), $$$_)"])
          | focus("X")
        | finding("useless-literal";
            "key `$X` is uselessly assigned twice") ) )
| report
