# rules: uncaught-executor-exceptions
# from: python/lang/correctness/concurrent.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$EXECUTOR.map($$$_)",
      "$VAR = $EXECUTOR.map($$$_)\n$$$_\n[$$$_ for $$$_ in $VAR]",
      "$VAR = $EXECUTOR.map($$$_)\n$$$_\nfor $$$_ in $VAR:\n  $$$_",
      "[$$$_ for $$$_ in $EXECUTOR.map($$$_)]",
      "for $IT in $EXECUTOR.map($$$_):\n  $$$_",
      "with concurrent.futures.thread.ThreadPoolExecutor($$$_) as $EXECUTOR:\n  $$$_"
    ])) as $all
    | ( $all | of(["$EXECUTOR.map($$$_)"])
          | within($all | of(["with concurrent.futures.thread.ThreadPoolExecutor($$$_) as $EXECUTOR:\n  $$$_"]))
          | outside($all | of(["$VAR = $EXECUTOR.map($$$_)\n$$$_\nfor $$$_ in $VAR:\n  $$$_"]))
          | outside($all | of(["$VAR = $EXECUTOR.map($$$_)\n$$$_\n[$$$_ for $$$_ in $VAR]"]))
          | outside($all | of(["[$$$_ for $$$_ in $EXECUTOR.map($$$_)]"]))
          | outside($all | of(["for $IT in $EXECUTOR.map($$$_):\n  $$$_"]))
        | finding("uncaught-executor-exceptions";
            "Values returned by thread pool map must be read in order to raise exceptions.") ) )
| report
