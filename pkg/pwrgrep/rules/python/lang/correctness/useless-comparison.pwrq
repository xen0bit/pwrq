# rules: no-strings-as-booleans
# languages: python
# from: python/lang/correctness/useless-comparison.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "if \"$$$_\":\n    $$$_",
      "if $PWRQDEEP1:\n    $$$_",
      "if $X in \"$$$_\":\n  $$$_"
    ])) as $all
    | ( ($all | of(["if $PWRQDEEP1:\n    $$$_"])
          | where_capture_ast("PWRQDEEP1"; "\"$$$_\" and $$$_"))
          + ($all | of(["if $PWRQDEEP1:\n    $$$_"])
          | where_capture_ast("PWRQDEEP1"; "\"$$$_\" or $$$_"))
          + ($all | of(["if \"$$$_\":\n    $$$_"])
          | not_at($all | of(["if $X in \"$$$_\":\n  $$$_"])))
        | finding("no-strings-as-booleans";
            "Using strings as booleans in Python has unexpected results.") ) )
| report
