# rules: test-is-missing-assert
# languages: python
# from: python/lang/correctness/test-is-missing-assert.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$A == $B",
      "$EXPR[$$$_]",
      "$FUNC($$$_)",
      "$X &= $$$_",
      "$X += $$$_",
      "$X = $$$_",
      "$X and $Y",
      "$X or $Y",
      "$X |= $$$_",
      "[$$$_]",
      "assert $$$_",
      "if $$$_:\n    $$$_",
      "return $$$_",
      "while $EXPR:\n  $$$_",
      "with ($$$_):\n  $$$_",
      "yield $X"
    ])) as $all
    | ( $all | of(["$A == $B"])
          | outside($all | of(["assert $$$_"]))
          | outside($all | of(["$X = $$$_"]))
          | outside($all | of(["$X += $$$_"]))
          | outside($all | of(["$X |= $$$_"]))
          | outside($all | of(["$X &= $$$_"]))
          | outside($all | of(["yield $X"]))
          | outside($all | of(["$X and $Y"]))
          | outside($all | of(["$X or $Y"]))
          | outside($all | of(["return $$$_"]))
          | outside($all | of(["$FUNC($$$_)"]))
          | outside($all | of(["while $EXPR:\n  $$$_"]))
          | outside($all | of(["with ($$$_):\n  $$$_"]))
          | outside($all | of(["[$$$_]"]))
          | outside($all | of(["$EXPR[$$$_]"]))
          | outside($all | of(["if $$$_:\n    $$$_"]))
        | finding("test-is-missing-assert";
            "Comparison without assertion.") ) )
| report
