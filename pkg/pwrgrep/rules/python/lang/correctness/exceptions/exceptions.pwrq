# rules: raise-not-base-exception
# from: python/lang/correctness/exceptions/exceptions.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$X: BaseException\nraise $X($$$_)",
      "raise \"$$$_\"",
      "raise $EXCEPTION"
    ])) as $all
    | ( ($all | of(["raise \"$$$_\""]))
          + ($all | of(["$X: BaseException\nraise $X($$$_)"]))
          + ($all | of(["raise $EXCEPTION"])
          | where_capture("EXCEPTION"; "[0-9]*\\.?[0-9]+"))
        | finding("raise-not-base-exception";
            "In Python3, a runtime `TypeError` will be thrown if you attempt to raise an object or class which does not inherit from `BaseException`") ) )
| report
