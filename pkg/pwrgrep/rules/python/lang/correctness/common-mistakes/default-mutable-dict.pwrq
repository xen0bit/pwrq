# rules: default-mutable-dict
# from: python/lang/correctness/common-mistakes/default-mutable-dict.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$D = $D or {}\n$$$_",
      "$D = $D.copy()\n$$$_",
      "$D = copy.copy($D)\n$$$_",
      "$D = copy.deepcopy($D)\n$$$_",
      "$D = dict($$$_)\n$$$_",
      "$D = dict.copy($D)\n$$$_",
      "$D = {$$$_ for $$$_ in $$$_}\n$$$_",
      "$D = {}\n$$$_",
      "$D.setdefault($$$_)",
      "$D.update($$$_)",
      "$D[$$$_] = $$$_",
      "def $A($$$_):\n  $$$_\n  def $F($$$_, $D={}, $$$_):\n    $$$_",
      "def $F($$$_, $D={}, $$$_):\n  $$$_"
    ])) as $all
    | ( $all | of(["$D[$$$_] = $$$_","$D.update($$$_)","$D.setdefault($$$_)"])
          | outside($all | of(["def $A($$$_):\n  $$$_\n  def $F($$$_, $D={}, $$$_):\n    $$$_"]))
          | within($all | of(["def $F($$$_, $D={}, $$$_):\n  $$$_"]))
          | in_files_without($all | of(["$D = {}\n$$$_"]))
          | in_files_without($all | of(["$D = dict($$$_)\n$$$_"]))
          | in_files_without($all | of(["$D = $D.copy()\n$$$_"]))
          | in_files_without($all | of(["$D = copy.deepcopy($D)\n$$$_"]))
          | in_files_without($all | of(["$D = copy.copy($D)\n$$$_"]))
          | in_files_without($all | of(["$D = dict.copy($D)\n$$$_"]))
          | in_files_without($all | of(["$D = {$$$_ for $$$_ in $$$_}\n$$$_"]))
          | in_files_without($all | of(["$D = $D or {}\n$$$_"]))
        | finding("default-mutable-dict";
            "Function $F mutates default dict $D.") ) )
| report
