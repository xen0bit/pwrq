# rules: dict-del-while-iterate
# languages: python
# from: python/lang/correctness/dict-modify-iterating.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "for $KEY in $DICT.keys():\n    $$$_\n    del $DICT[$KEY]",
      "for $KEY, $VALUE in $DICT.items():\n    $$$_\n    del $DICT[$KEY]"
    ])) as $all
    | ( $all | of(["for $KEY, $VALUE in $DICT.items():\n    $$$_\n    del $DICT[$KEY]","for $KEY in $DICT.keys():\n    $$$_\n    del $DICT[$KEY]"])
        | finding("dict-del-while-iterate";
            "It appears that `$DICT[$KEY]` is a dict with items being deleted while in a for loop.") ) )
| report
