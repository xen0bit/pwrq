# rules: unchecked-subprocess-call
# languages: python
# from: python/lang/correctness/unchecked-returns.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$S = subprocess.call($$$_)",
      "return subprocess.call($$$_)",
      "subprocess.$CALL($$$_)",
      "subprocess.call($$$_) == $X"
    ])) as $all
    | ( $all | of(["subprocess.$CALL($$$_)"])
          | outside($all | of(["$S = subprocess.call($$$_)"]))
          | outside($all | of(["subprocess.call($$$_) == $X"]))
          | outside($all | of(["return subprocess.call($$$_)"]))
          | where_capture_ast("CALL"; "call")
          | focus("CALL")
        | finding("unchecked-subprocess-call";
            "This is not checking the return value of this subprocess call; if it fails no exception will be raised.") ) )
| report
