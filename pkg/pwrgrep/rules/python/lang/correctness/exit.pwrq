# rules: use-sys-exit
# from: python/lang/correctness/exit.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "exit($X)",
      "sys.exit($X)"
    ])) as $all
    | ( $all | of(["exit($X)"])
          | not_at($all | of(["sys.exit($X)"]))
        | finding("use-sys-exit";
            "Detected use of `exit`.") ) )
| report
