# rules: list-modify-while-iterate
# from: python/lang/correctness/list-modify-iterating.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "for $ELEMENT in $LIST:\n  $$$_\n  $LIST.append($$$_)",
      "for $ELEMENT in $LIST:\n  $$$_\n  $LIST.extend($$$_)",
      "for $ELEMENT in $LIST:\n  $$$_\n  $LIST.pop($$$_)",
      "for $ELEMENT in $LIST:\n  $$$_\n  $LIST.push($$$_)",
      "for $ELEMENT in $LIST:\n  $$$_\n  $LIST.remove($$$_)"
    ])) as $all
    | ( $all | of(["for $ELEMENT in $LIST:\n  $$$_\n  $LIST.pop($$$_)","for $ELEMENT in $LIST:\n  $$$_\n  $LIST.push($$$_)","for $ELEMENT in $LIST:\n  $$$_\n  $LIST.append($$$_)","for $ELEMENT in $LIST:\n  $$$_\n  $LIST.extend($$$_)","for $ELEMENT in $LIST:\n  $$$_\n  $LIST.remove($$$_)"])
        | finding("list-modify-while-iterate";
            "It appears that `$LIST` is a list that is being modified while in a for loop.") ) )
| report
