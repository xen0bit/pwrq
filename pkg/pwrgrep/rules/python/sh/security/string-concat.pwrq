# rules: string-concat
# from: python/sh/security/string-concat.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "sh.$BIN($X + $Y)",
      "sh.$BIN($X.format($$$_))",
      "sh.$BIN(f\"$$$_{$$$_}$$$_\")"
    ])) as $all
    | ( $all | of(["sh.$BIN($X + $Y)","sh.$BIN($X.format($$$_))","sh.$BIN(f\"$$$_{$$$_}$$$_\")"])
        | finding("string-concat";
            "Detected string concatenation or formatting in a call to a command via 'sh'.") ) )
| report
