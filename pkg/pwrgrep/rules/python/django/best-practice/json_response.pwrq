# rules: use-json-response
# from: python/django/best-practice/json_response.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$Y = json.dumps($$$_)\n$$$_\ndjango.http.HttpResponse($Y, $$$_)",
      "def $X($$$_):\n  $$$_"
    ])) as $all
    | ( $all | of(["$Y = json.dumps($$$_)\n$$$_\ndjango.http.HttpResponse($Y, $$$_)"])
          | within($all | of(["def $X($$$_):\n  $$$_"]))
        | finding("use-json-response";
            "Use JsonResponse instead") ) )
| report
