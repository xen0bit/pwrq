# rules: use-onetoonefield
# from: python/django/best-practice/use-onetoonefield.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$F = django.db.models.ForeignKey($$$_, unique=True, $$$_)",
      "class $M($$$_):\n  $$$_"
    ])) as $all
    | ( $all | of(["$F = django.db.models.ForeignKey($$$_, unique=True, $$$_)"])
          | within($all | of(["class $M($$$_):\n  $$$_"]))
        | finding("use-onetoonefield";
            "Use 'django.db.models.OneToOneField' instead of 'ForeignKey' with unique=True.") ) )
| report
