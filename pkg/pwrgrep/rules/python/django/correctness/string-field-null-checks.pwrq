# rules: no-null-string-field, string-field-must-set-null-true
# languages: python
# from: python/django/correctness/string-field-null-checks.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$F = django.db.models.CharField($$$_, null=True, $$$_)",
      "$F = django.db.models.CharField($$$_, null=True, unique=True, blank=True, $$$_)",
      "$F = django.db.models.CharField($$$_, unique=True, blank=True, $$$_)",
      "$F = django.db.models.CharField($$$_, unique=True, blank=True, null=True, $$$_)",
      "$F = django.db.models.TextField($$$_, null=True, $$$_)",
      "$F = django.db.models.TextField($$$_, null=True, unique=True, blank=True, $$$_)",
      "$F = django.db.models.TextField($$$_, unique=True, blank=True, $$$_)",
      "$F = django.db.models.TextField($$$_, unique=True, blank=True, null=True, $$$_)",
      "class $M($$$_):\n  $$$_"
    ])) as $all
    | ( $all | of(["$F = django.db.models.CharField($$$_, null=True, $$$_)","$F = django.db.models.TextField($$$_, null=True, $$$_)"])
          | within($all | of(["class $M($$$_):\n  $$$_"]))
          | not_at($all | of(["$F = django.db.models.CharField($$$_, null=True, unique=True, blank=True, $$$_)"]))
          | not_at($all | of(["$F = django.db.models.TextField($$$_, null=True, unique=True, blank=True, $$$_)"]))
        | finding("no-null-string-field";
            "Avoid using null on string-based fields such as CharField and TextField.") )
      + ( $all | of(["$F = django.db.models.CharField($$$_, unique=True, blank=True, $$$_)","$F = django.db.models.TextField($$$_, unique=True, blank=True, $$$_)"])
          | within($all | of(["class $M($$$_):\n  $$$_"]))
          | not_at($all | of(["$F = django.db.models.CharField($$$_, unique=True, blank=True, null=True, $$$_)"]))
          | not_at($all | of(["$F = django.db.models.TextField($$$_, unique=True, blank=True, null=True, $$$_)"]))
        | finding("string-field-must-set-null-true";
            "If a text field declares unique=True and blank=True, null=True must also be set to avoid unique constraint violations when saving multiple objects with blank values.") ) )
| report
