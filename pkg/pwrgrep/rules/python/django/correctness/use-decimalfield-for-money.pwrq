# rules: use-decimalfield-for-money
# from: python/django/correctness/use-decimalfield-for-money.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$F = django.db.models.FloatField($$$_)",
      "class $M($$$_):\n  $$$_"
    ])) as $all
    | ( $all | of(["$F = django.db.models.FloatField($$$_)"])
          | within($all | of(["class $M($$$_):\n  $$$_"]))
          | where_capture("F"; ".*([pP][rR][iI][cC][eE]|[aA][mM][oO][uU][nN][tT]|[sS][uU][bB][tT][oO][tT][aA][lL]|[dD][oO][nN][aA][tT][iI][oO][nN]|[fF][eE][eE]|[sS][aA][lL][aA][rR][yY]|[pP][rR][eE][cC][iI][oO]).*")
        | finding("use-decimalfield-for-money";
            "Found a FloatField used for variable $F.") ) )
| report
