# rules: use-count-method
# from: python/django/performance/upsell-count.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$X.objects.$FUNC($$$_).$FILTER().$UPDATE($$$_).len()",
      "$X.objects.$FUNC($$$_).$FILTER().len()",
      "$X.objects.$FUNC($$$_).len()"
    ])) as $all
    | ( $all | of(["$X.objects.$FUNC($$$_).len()","$X.objects.$FUNC($$$_).$FILTER().len()","$X.objects.$FUNC($$$_).$FILTER().$UPDATE($$$_).len()"])
        | finding("use-count-method";
            "Looks like you need to determine the number of records.") ) )
| report
