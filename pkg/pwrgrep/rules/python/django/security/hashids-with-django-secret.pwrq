# rules: hashids-with-django-secret
# languages: python
# from: python/django/security/hashids-with-django-secret.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "hashids.Hashids($$$_, salt=django.conf.settings.SECRET_KEY, $$$_)",
      "hashids.Hashids(django.conf.settings.SECRET_KEY, $$$_)"
    ])) as $all
    | ( $all | of(["hashids.Hashids($$$_, salt=django.conf.settings.SECRET_KEY, $$$_)","hashids.Hashids(django.conf.settings.SECRET_KEY, $$$_)"])
        | finding("hashids-with-django-secret";
            "The Django secret key is used as salt in HashIDs.") ) )
| report
