# rules: globals-as-template-context
# from: python/django/security/globals-as-template-context.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$CONTEXT = globals($$$_)\n$$$_",
      "django.shortcuts.render($$$_, $CONTEXT, $$$_)",
      "django.shortcuts.render($$$_, globals($$$_), $$$_)",
      "django.template.Template.render($$$_, $CONTEXT, $$$_)",
      "django.template.Template.render($$$_, globals($$$_), $$$_)"
    ])) as $all
    | ( ($all | of(["django.shortcuts.render($$$_, globals($$$_), $$$_)"]))
          + ($all | of(["django.template.Template.render($$$_, globals($$$_), $$$_)"]))
          + ($all | of(["django.shortcuts.render($$$_, $CONTEXT, $$$_)","django.template.Template.render($$$_, $CONTEXT, $$$_)"])
          | in_files_with($all | of(["$CONTEXT = globals($$$_)\n$$$_"])))
        | finding("globals-as-template-context";
            "Using 'globals()' as a context to 'render(...)' is extremely dangerous.") ) )
| report
