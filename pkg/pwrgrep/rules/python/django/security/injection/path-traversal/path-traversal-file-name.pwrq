# rules: path-traversal-file-name
# languages: python
# from: python/django/security/injection/path-traversal/path-traversal-file-name.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$V = request.$W\n$$$_\n$FILE % ($V)\n# match format use cases",
      "$V = request.$W\n$$$_\n$FILE.format($$$_, $V, $$$_)",
      "$V = request.$W($X)\n$$$_\n$FILE % ($V)",
      "$V = request.$W($X)\n$$$_\n$FILE.format($$$_, $V, $$$_)",
      "$V = request.$W.get($X)\n$$$_\n$FILE % ($V)",
      "$V = request.$W.get($X)\n$$$_\n$FILE.format($$$_, $V, $$$_)",
      "$V = request.$W[$X]\n$$$_\n$FILE % ($V)",
      "$V = request.$W[$X]\n$$$_\n$FILE.format($$$_, $V, $$$_)",
      "def $F($$$_):\n  $$$_",
      "def $F($$$_):\n  $$$_\n  os.path.abspath($$$_)\n  $$$_",
      "def $F($$$_):\n  $$$_\n  os.path.realpath($$$_)\n  $$$_"
    ])) as $all
    | ( $all | of(["$V = request.$W.get($X)\n$$$_\n$FILE % ($V)","$V = request.$W[$X]\n$$$_\n$FILE % ($V)","$V = request.$W($X)\n$$$_\n$FILE % ($V)","$V = request.$W\n$$$_\n$FILE % ($V)\n# match format use cases","$V = request.$W.get($X)\n$$$_\n$FILE.format($$$_, $V, $$$_)","$V = request.$W[$X]\n$$$_\n$FILE.format($$$_, $V, $$$_)","$V = request.$W($X)\n$$$_\n$FILE.format($$$_, $V, $$$_)","$V = request.$W\n$$$_\n$FILE.format($$$_, $V, $$$_)"])
          | within($all | of(["def $F($$$_):\n  $$$_"]))
          | outside($all | of(["def $F($$$_):\n  $$$_\n  os.path.realpath($$$_)\n  $$$_"]))
          | outside($all | of(["def $F($$$_):\n  $$$_\n  os.path.abspath($$$_)\n  $$$_"]))
          | where_capture("FILE"; "^(?:.*\\.(log|zip|txt|csv|xml|html).*)")
        | finding("path-traversal-file-name";
            "Data from request is passed to a file name `$FILE`.") ) )
| report
