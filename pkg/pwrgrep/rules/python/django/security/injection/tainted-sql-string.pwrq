# rules: tainted-sql-string
# languages: python
# from: python/django/security/injection/tainted-sql-string.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "\"$SQLSTR\" % $$$_",
      "\"$SQLSTR\" + $$$_",
      "\"$SQLSTR\".format($$$_)",
      "f\"$SQLSTR{$$$_}$$$_\"",
      "request.$ANYTHING",
      "request.build_absolute_uri"
    ])) as $all
    | ( (($all | of(["\"$SQLSTR\" + $$$_","\"$SQLSTR\" % $$$_","\"$SQLSTR\".format($$$_)","f\"$SQLSTR{$$$_}$$$_\""])
          | where_capture("SQLSTR"; "^(?:\\s*(?i)(select|delete|insert|create|update|alter|drop)\\b.*)")))
          | reaching((($all | of(["request.$ANYTHING"])
          | not_at($all | of(["request.build_absolute_uri"]))));
              ([]))
        | finding("tainted-sql-string";
            "Detected user input used to manually construct a SQL string.") ) )
| report
