# rules: user-exec
# from: python/django/security/injection/code/user-exec.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$V = request.$W($$$_)\n$$$_\nexec($$$_, $V, $$$_)",
      "$V = request.$W.get($$$_)\n$$$_\nexec($$$_, $V, $$$_)",
      "$V = request.$W.get($$$_)\n$$$_\nloop = asyncio.get_running_loop()\n$$$_\nawait loop.run_in_executor(None, exec, $V)",
      "$V = request.$W[$$$_]\n$$$_\nexec($$$_, $V, $$$_)",
      "$V = request.$W[$$$_]\n$$$_\nloop = asyncio.get_running_loop()\n$$$_\nawait loop.run_in_executor(None, exec, $V)",
      "def $F($$$_):\n  $$$_",
      "exec($$$_, request.$W($$$_), $$$_)",
      "exec($$$_, request.$W.get($$$_), $$$_)",
      "exec($$$_, request.$W[$$$_], $$$_)",
      "loop = asyncio.get_running_loop()\n$$$_\nawait loop.run_in_executor(None, exec, request.$W.get($$$_))",
      "loop = asyncio.get_running_loop()\n$$$_\nawait loop.run_in_executor(None, exec, request.$W[$$$_])"
    ])) as $all
    | ( $all | of(["exec($$$_, request.$W.get($$$_), $$$_)","$V = request.$W.get($$$_)\n$$$_\nexec($$$_, $V, $$$_)","exec($$$_, request.$W($$$_), $$$_)","$V = request.$W($$$_)\n$$$_\nexec($$$_, $V, $$$_)","exec($$$_, request.$W[$$$_], $$$_)","$V = request.$W[$$$_]\n$$$_\nexec($$$_, $V, $$$_)","loop = asyncio.get_running_loop()\n$$$_\nawait loop.run_in_executor(None, exec, request.$W[$$$_])","$V = request.$W[$$$_]\n$$$_\nloop = asyncio.get_running_loop()\n$$$_\nawait loop.run_in_executor(None, exec, $V)","loop = asyncio.get_running_loop()\n$$$_\nawait loop.run_in_executor(None, exec, request.$W.get($$$_))","$V = request.$W.get($$$_)\n$$$_\nloop = asyncio.get_running_loop()\n$$$_\nawait loop.run_in_executor(None, exec, $V)"])
          | within($all | of(["def $F($$$_):\n  $$$_"]))
        | finding("user-exec";
            "Found user data in a call to 'exec'.") ) )
| report
