# rules: user-eval
# from: python/django/security/injection/code/user-eval.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$V = request.$W($$$_)\n$$$_\neval($$$_, $V, $$$_)",
      "$V = request.$W.get($$$_)\n$$$_\neval($$$_, $V, $$$_)",
      "$V = request.$W[$$$_]\n$$$_\neval($$$_, $V, $$$_)",
      "def $F($$$_):\n  $$$_",
      "eval($$$_, request.$W($$$_), $$$_)",
      "eval($$$_, request.$W.get($$$_), $$$_)",
      "eval($$$_, request.$W[$$$_], $$$_)"
    ])) as $all
    | ( $all | of(["eval($$$_, request.$W.get($$$_), $$$_)","$V = request.$W.get($$$_)\n$$$_\neval($$$_, $V, $$$_)","eval($$$_, request.$W($$$_), $$$_)","$V = request.$W($$$_)\n$$$_\neval($$$_, $V, $$$_)","eval($$$_, request.$W[$$$_], $$$_)","$V = request.$W[$$$_]\n$$$_\neval($$$_, $V, $$$_)"])
          | within($all | of(["def $F($$$_):\n  $$$_"]))
        | finding("user-eval";
            "Found user data in a call to 'eval'.") ) )
| report
