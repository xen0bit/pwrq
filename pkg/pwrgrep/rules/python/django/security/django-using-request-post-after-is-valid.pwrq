# rules: django-using-request-post-after-is-valid
# from: python/django/security/django-using-request-post-after-is-valid.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "def $FUNC(request, $$$_):\n  $$$_",
      "if $FORM.is_valid():\n  $$$_",
      "request.POST.get($$$_)",
      "request.POST[$$$_]"
    ])) as $all
    | ( $all | of(["request.POST[$$$_]","request.POST.get($$$_)"])
          | within($all | of(["def $FUNC(request, $$$_):\n  $$$_"]))
          | within($all | of(["if $FORM.is_valid():\n  $$$_"]))
        | finding("django-using-request-post-after-is-valid";
            "Use $FORM.cleaned_data[] instead of request.POST[] after form.is_valid() has been executed to only access sanitized data") ) )
| report
