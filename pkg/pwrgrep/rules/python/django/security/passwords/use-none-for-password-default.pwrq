# rules: use-none-for-password-default
# languages: python
# from: python/django/security/passwords/use-none-for-password-default.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$VAR = request.$W.get($X, $EMPTY)\n$$$_\n$MODEL.set_password($VAR)\n$$$_\n$MODEL.save($$$_)",
      "def $F($$$_, $VAR=$EMPTY, $$$_):\n  $$$_\n  $MODEL.set_password($VAR)"
    ])) as $all
    | ( $all | of(["$VAR = request.$W.get($X, $EMPTY)\n$$$_\n$MODEL.set_password($VAR)\n$$$_\n$MODEL.save($$$_)","def $F($$$_, $VAR=$EMPTY, $$$_):\n  $$$_\n  $MODEL.set_password($VAR)"])
          | where_capture_ast("EMPTY"; "\"\"")
          | focus("EMPTY")
        | finding("use-none-for-password-default";
            "'$VAR' is using the empty string as its default and is being used to set the password on '$MODEL'.") ) )
| report
