# rules: password-empty-string
# languages: python
# from: python/django/security/passwords/password-empty-string.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$MODEL.set_password($EMPTY)\n$$$_\n$MODEL.save()",
      "$VAR = $EMPTY\n$$$_\n$MODEL.set_password($VAR)\n$$$_\n$MODEL.save()"
    ])) as $all
    | ( $all | of(["$MODEL.set_password($EMPTY)\n$$$_\n$MODEL.save()","$VAR = $EMPTY\n$$$_\n$MODEL.set_password($VAR)\n$$$_\n$MODEL.save()"])
          | where_capture("EMPTY"; "^(?:(\\'\\'|\\\"\\\"))")
        | finding("password-empty-string";
            "'$VAR' is the empty string and is being used to set the password on '$MODEL'.") ) )
| report
