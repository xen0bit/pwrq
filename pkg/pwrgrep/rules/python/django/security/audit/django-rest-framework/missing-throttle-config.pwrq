# rules: missing-throttle-config
# languages: python
# from: python/django/security/audit/django-rest-framework/missing-throttle-config.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "REST_FRAMEWORK",
      "REST_FRAMEWORK = $$$_",
      "REST_FRAMEWORK = {\n  $$$_,\n  \"DEFAULT_THROTTLE_RATES\": $$$_\n}"
    ])) as $all
    | ( $all | of(["REST_FRAMEWORK"])
          | outside($all | of(["REST_FRAMEWORK = {\n  $$$_,\n  \"DEFAULT_THROTTLE_RATES\": $$$_\n}"]))
          | within($all | of(["REST_FRAMEWORK = $$$_"]))
        | finding("missing-throttle-config";
            "Django REST framework configuration is missing default rate- limiting options.") ) )
| report
