# rules: custom-expression-as-sql
# from: python/django/security/audit/custom-expression-as-sql.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$EXPRESSION.as_sql($$$_)"
    ])) as $all
    | ( $all | of(["$EXPRESSION.as_sql($$$_)"])
        | finding("custom-expression-as-sql";
            "Detected a Custom Expression ''$EXPRESSION'' calling ''as_sql(...).'' This could lead to SQL injection, which can result in attackers exfiltrating sensitive data.") ) )
| report
