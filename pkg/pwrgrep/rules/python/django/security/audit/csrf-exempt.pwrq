# rules: no-csrf-exempt
# languages: python
# from: python/django/security/audit/csrf-exempt.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "@django.views.decorators.csrf.csrf_exempt\ndef $R($$$_):\n  $$$_"
    ])) as $all
    | ( $all | of(["@django.views.decorators.csrf.csrf_exempt\ndef $R($$$_):\n  $$$_"])
        | finding("no-csrf-exempt";
            "Detected usage of @csrf_exempt, which indicates that there is no CSRF token set for this route.") ) )
| report
