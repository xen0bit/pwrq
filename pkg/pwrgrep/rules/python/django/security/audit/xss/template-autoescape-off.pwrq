# rules: template-autoescape-off
# from: python/django/security/audit/xss/template-autoescape-off.yaml

. as $root
| ( ($root | scan_regex(["*.html"]; [
      "{%\\s+autoescape\\s+off\\s+%}"
    ])) as $all
    | ( $all | of(["{%\\s+autoescape\\s+off\\s+%}"])
        | finding("template-autoescape-off";
            "Detected a template block where autoescaping is explicitly disabled with '{% autoescape off %}'.") ) )
| report
