# rules: global-autoescape-off
# from: python/django/security/audit/xss/global-autoescape-off.yaml

. as $root
| ( ($root | scan_regex(["*.py"]; [
      "\\{[\\s\\S]*?,\\s+'BACKEND':\\s+[\\s\\S]*?,\\s+'OPTIONS':\\s+\\{[\\s\\S]*?,\\s+'autoescape':\\s+(?P<FALSE>\\S+),\\s+[\\s\\S]*?\\},\\s+[\\s\\S]*?\\}"
    ])) as $all
    | ( $all | of(["\\{[\\s\\S]*?,\\s+'BACKEND':\\s+[\\s\\S]*?,\\s+'OPTIONS':\\s+\\{[\\s\\S]*?,\\s+'autoescape':\\s+(?P<FALSE>\\S+),\\s+[\\s\\S]*?\\},\\s+[\\s\\S]*?\\}"])
          | where_capture_ast("FALSE"; "False")
          | focus("FALSE")
        | finding("global-autoescape-off";
            "Autoescape is globally disbaled for this Django application.") ) )
| report
