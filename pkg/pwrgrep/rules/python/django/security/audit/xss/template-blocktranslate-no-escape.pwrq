# rules: template-blocktranslate-no-escape
# from: python/django/security/audit/xss/template-blocktranslate-no-escape.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "\\{%[\\s\\S]*?filter[\\s\\S]*?force_escape[\\s\\S]*?%\\}\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+\\{%[\\s\\S]*?endfilter[\\s\\S]*?%\\}",
      "\\{%\\s+blocktrans[\\s\\S]*?%\\}",
      "\\{%\\s+blocktranslate[\\s\\S]*?%\\}"
    ])) as $all
    | ( $all | of(["\\{%\\s+blocktranslate[\\s\\S]*?%\\}","\\{%\\s+blocktrans[\\s\\S]*?%\\}"])
          | outside($all | of(["\\{%[\\s\\S]*?filter[\\s\\S]*?force_escape[\\s\\S]*?%\\}\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+\\{%[\\s\\S]*?endfilter[\\s\\S]*?%\\}"]))
        | finding("template-blocktranslate-no-escape";
            "Translated strings will not be escaped when rendered in a template.") ) )
| report
