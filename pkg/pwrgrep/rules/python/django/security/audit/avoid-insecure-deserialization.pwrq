# rules: avoid-insecure-deserialization
# languages: python
# from: python/django/security/audit/avoid-insecure-deserialization.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "_pickle.$PICKLEFUNC($$$_)",
      "cPickle.$PICKLEFUNC($$$_)",
      "def $INSIDE($$$_, $PARAM, $$$_):\n  $$$_",
      "dill.$DILLFUNC($$$_)",
      "pickle.$PICKLEFUNC($$$_)",
      "request.$REQFUNC($$$_)",
      "request.$REQFUNC.get($$$_)",
      "request.$REQFUNC[$$$_]",
      "shelve.$PICKLEFUNC($$$_)",
      "yaml.$YAMLFUNC($$$_)",
      "yaml.$YAMLFUNC($$$_, Dumper=SafeDumper, $$$_)",
      "yaml.$YAMLFUNC($$$_, Dumper=yaml.SafeDumper, $$$_)",
      "yaml.$YAMLFUNC($$$_, Loader=SafeLoader, $$$_)",
      "yaml.$YAMLFUNC($$$_, Loader=yaml.SafeLoader, $$$_)"
    ])) as $all
    | ( ((($all | of(["pickle.$PICKLEFUNC($$$_)","_pickle.$PICKLEFUNC($$$_)","cPickle.$PICKLEFUNC($$$_)","shelve.$PICKLEFUNC($$$_)"])
          | where_capture("PICKLEFUNC"; "^(?:dumps|dump|load|loads)"))
          + ($all | of(["dill.$DILLFUNC($$$_)"])
          | where_capture("DILLFUNC"; "^(?:dump|dump_session|dumps|load|load_session|loads)"))
          + ($all | of(["yaml.$YAMLFUNC($$$_)"])
          | not_at($all | of(["yaml.$YAMLFUNC($$$_, Dumper=SafeDumper, $$$_)"]))
          | not_at($all | of(["yaml.$YAMLFUNC($$$_, Dumper=yaml.SafeDumper, $$$_)"]))
          | not_at($all | of(["yaml.$YAMLFUNC($$$_, Loader=SafeLoader, $$$_)"]))
          | not_at($all | of(["yaml.$YAMLFUNC($$$_, Loader=yaml.SafeLoader, $$$_)"]))
          | where_capture("YAMLFUNC"; "^(?:dump|dump_all|load|load_all)"))))
          | reaching(((($all | of(["request.$REQFUNC($$$_)","request.$REQFUNC.get($$$_)","request.$REQFUNC[$$$_]"])
          | within($all | of(["def $INSIDE($$$_, $PARAM, $$$_):\n  $$$_"])))));
              ([]))
        | finding("avoid-insecure-deserialization";
            "Avoid using insecure deserialization library, backed by `pickle`, `_pickle`, `cpickle`, `dill`, `shelve`, or `yaml`, which are known to lead to remote code execution vulnerabilities.") ) )
| report
