# rules: unvalidated-password
# languages: python
# from: python/django/security/audit/unvalidated-password.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$MODEL.set_password($X)",
      "UserModel().set_password($X)",
      "django.contrib.auth.password_validation.validate_password($$$_)\n$$$_",
      "if $PWRQDEEP1:\n    $$$_",
      "try:\n  $$$_\n  django.contrib.auth.password_validation.validate_password($$$_)\n  $$$_\nexcept $EX as $E:\n  $$$_\n$$$_",
      "try:\n  $$$_\n  django.contrib.auth.password_validation.validate_password($$$_)\n  $$$_\nexcept $EX:\n  $$$_\n$$$_"
    ])) as $all
    | ( $all | of(["$MODEL.set_password($X)"])
          | outside($all | of(["if $PWRQDEEP1:\n    $$$_"])
          | where_capture_ast("PWRQDEEP1"; "django.contrib.auth.password_validation.validate_password($$$_)"))
          | in_files_without($all | of(["django.contrib.auth.password_validation.validate_password($$$_)\n$$$_"]))
          | in_files_without($all | of(["try:\n  $$$_\n  django.contrib.auth.password_validation.validate_password($$$_)\n  $$$_\nexcept $EX:\n  $$$_\n$$$_"]))
          | in_files_without($all | of(["try:\n  $$$_\n  django.contrib.auth.password_validation.validate_password($$$_)\n  $$$_\nexcept $EX as $E:\n  $$$_\n$$$_"]))
          | not_at($all | of(["UserModel().set_password($X)"]))
        | finding("unvalidated-password";
            "The password on '$MODEL' is being set without validating the password.") ) )
| report
