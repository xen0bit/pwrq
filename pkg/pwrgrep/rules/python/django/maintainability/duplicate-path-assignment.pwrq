# rules: duplicate-path-assignment, conflicting-path-assignment, duplicate-path-assignment-different-names, duplicate-name-assignment
# languages: python
# from: python/django/maintainability/duplicate-path-assignment.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "[$$$_, django.urls.path('$URL', $VIEW, $$$_), $$$_, django.urls.path('$URL', $DIFFERENT_VIEW, $$$_), $$$_]",
      "[$$$_, django.urls.path('$URL', $VIEW, $$$_), $$$_, django.urls.path('$URL', $VIEW, $$$_), $$$_]",
      "[$$$_, django.urls.path('$URL', $VIEW, name='$NAME', $$$_), $$$_, django.urls.path('$OTHER_URL', $OTHER_VIEW, name='$NAME', $$$_), $$$_]",
      "[$$$_, django.urls.path('$URL', $VIEW, name='$NAME', $$$_), $$$_, django.urls.path('$OTHER_URL', $VIEW, name='$NAME', $$$_), $$$_]",
      "[$$$_, django.urls.path('$URL', $VIEW, name='$NAME', $$$_), $$$_, django.urls.path('$URL', $OTHER_VIEW, name='$NAME', $$$_), $$$_]",
      "[$$$_, django.urls.path('$URL', $VIEW, name='$NAME', $$$_), $$$_, django.urls.path('$URL', $VIEW, name='$NAME', $$$_), $$$_]",
      "[$$$_, django.urls.path('$URL', $VIEW, name='$NAME', $$$_), $$$_, django.urls.path('$URL', $VIEW, name='$OTHER_NAME', $$$_), $$$_]"
    ])) as $all
    | ( $all | of(["[$$$_, django.urls.path('$URL', $VIEW, $$$_), $$$_, django.urls.path('$URL', $VIEW, $$$_), $$$_]"])
        | finding("duplicate-path-assignment";
            "path for `$URL` is uselessly assigned twice") )
      + ( $all | of(["[$$$_, django.urls.path('$URL', $VIEW, $$$_), $$$_, django.urls.path('$URL', $DIFFERENT_VIEW, $$$_), $$$_]"])
          | not_at($all | of(["[$$$_, django.urls.path('$URL', $VIEW, $$$_), $$$_, django.urls.path('$URL', $VIEW, $$$_), $$$_]"]))
        | finding("conflicting-path-assignment";
            "The path for `$URL` is assigned once to view `$VIEW` and once to `$DIFFERENT_VIEW`, which can lead to unexpected behavior.") )
      + ( $all | of(["[$$$_, django.urls.path('$URL', $VIEW, name='$NAME', $$$_), $$$_, django.urls.path('$URL', $VIEW, name='$OTHER_NAME', $$$_), $$$_]"])
          | not_at($all | of(["[$$$_, django.urls.path('$URL', $VIEW, name='$NAME', $$$_), $$$_, django.urls.path('$URL', $VIEW, name='$NAME', $$$_), $$$_]"]))
        | finding("duplicate-path-assignment-different-names";
            "path for `$URL` is assigned twice with different names") )
      + ( $all | of(["[$$$_, django.urls.path('$URL', $VIEW, name='$NAME', $$$_), $$$_, django.urls.path('$OTHER_URL', $OTHER_VIEW, name='$NAME', $$$_), $$$_]"])
          | not_at($all | of(["[$$$_, django.urls.path('$URL', $VIEW, name='$NAME', $$$_), $$$_, django.urls.path('$URL', $VIEW, name='$NAME', $$$_), $$$_]"]))
          | not_at($all | of(["[$$$_, django.urls.path('$URL', $VIEW, name='$NAME', $$$_), $$$_, django.urls.path('$URL', $OTHER_VIEW, name='$NAME', $$$_), $$$_]"]))
          | not_at($all | of(["[$$$_, django.urls.path('$URL', $VIEW, name='$NAME', $$$_), $$$_, django.urls.path('$OTHER_URL', $VIEW, name='$NAME', $$$_), $$$_]"]))
        | finding("duplicate-name-assignment";
            "The name `$NAME` is used for both `$URL` and `$OTHER_URL`, which can lead to unexpected behavior when using URL reversing.") ) )
| report
