# rules: pyramid-csrf-origin-check-disabled
# languages: python
# from: python/pyramid/audit/csrf-origin-check-disabled.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$CHECK_ORIGIN",
      "from pyramid.view import view_config\n$$$_\n@view_config($$$_, check_origin=$CHECK_ORIGIN, $$$_)\ndef $VIEW($$$_):\n  $$$_"
    ])) as $all
    | ( $all | of(["$CHECK_ORIGIN"])
          | within($all | of(["from pyramid.view import view_config\n$$$_\n@view_config($$$_, check_origin=$CHECK_ORIGIN, $$$_)\ndef $VIEW($$$_):\n  $$$_"]))
          | where_capture("CHECK_ORIGIN"; "^(?i:False)$")
        | finding("pyramid-csrf-origin-check-disabled";
            "Origin check for the CSRF token is disabled for this view.") ) )
| report
