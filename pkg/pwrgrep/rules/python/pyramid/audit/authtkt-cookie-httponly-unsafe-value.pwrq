# rules: pyramid-authtkt-cookie-httponly-unsafe-value
# languages: python
# from: python/pyramid/audit/authtkt-cookie-httponly-unsafe-value.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$HTTPONLY",
      "pyramid.authentication.AuthTktAuthenticationPolicy($$$_, **$PARAMS)",
      "pyramid.authentication.AuthTktAuthenticationPolicy($$$_, httponly=$HTTPONLY, $$$_)",
      "pyramid.authentication.AuthTktCookieHelper($$$_, **$PARAMS)",
      "pyramid.authentication.AuthTktCookieHelper($$$_, httponly=$HTTPONLY, $$$_)"
    ])) as $all
    | ( ($all | of(["pyramid.authentication.AuthTktCookieHelper($$$_, httponly=$HTTPONLY, $$$_)"])
          | not_at($all | of(["pyramid.authentication.AuthTktCookieHelper($$$_, **$PARAMS)"])))
          + ($all | of(["pyramid.authentication.AuthTktAuthenticationPolicy($$$_, httponly=$HTTPONLY, $$$_)"])
          | not_at($all | of(["pyramid.authentication.AuthTktAuthenticationPolicy($$$_, **$PARAMS)"])))
          | at_same_place(($all | of(["$HTTPONLY"])))
          | where_capture_ast("HTTPONLY"; "False")
        | finding("pyramid-authtkt-cookie-httponly-unsafe-value";
            "Found a Pyramid Authentication Ticket cookie without the httponly option correctly set.") ) )
| report
