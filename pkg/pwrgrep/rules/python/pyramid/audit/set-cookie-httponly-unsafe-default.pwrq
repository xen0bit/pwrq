# rules: pyramid-set-cookie-httponly-unsafe-default
# from: python/pyramid/audit/set-cookie-httponly-unsafe-default.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$RESPONSE.set_cookie($$$_)",
      "$RESPONSE.set_cookie($$$_, **$PARAMS)",
      "$RESPONSE.set_cookie($$$_, httponly=$HTTPONLY, $$$_)",
      "@pyramid.view.view_config($$$_)\ndef $VIEW($REQUEST):\n    $$$_\n    $RESPONSE = $REQUEST.response\n    $$$_",
      "def $VIEW($$$_):\n    $$$_\n    $RESPONSE = pyramid.httpexceptions.HTTPFound($$$_)\n    $$$_"
    ])) as $all
    | ( ($all)
          + ($all)
          | at_same_place(($all | of(["$RESPONSE.set_cookie($$$_)"])))
          | not_at($all | of(["$RESPONSE.set_cookie($$$_, httponly=$HTTPONLY, $$$_)"]))
          | not_at($all | of(["$RESPONSE.set_cookie($$$_, **$PARAMS)"]))
        | finding("pyramid-set-cookie-httponly-unsafe-default";
            "Found a Pyramid cookie using an unsafe default for the httponly option.") ) )
| report
