# rules: pyramid-authtkt-cookie-secure-unsafe-default
# from: python/pyramid/audit/authtkt-cookie-secure-unsafe-default.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "pyramid.authentication.AuthTktAuthenticationPolicy($$$_)",
      "pyramid.authentication.AuthTktAuthenticationPolicy($$$_, **$PARAMS)",
      "pyramid.authentication.AuthTktAuthenticationPolicy($$$_, secure=$SECURE, $$$_)",
      "pyramid.authentication.AuthTktCookieHelper($$$_)",
      "pyramid.authentication.AuthTktCookieHelper($$$_, **$PARAMS)",
      "pyramid.authentication.AuthTktCookieHelper($$$_, secure=$SECURE, $$$_)"
    ])) as $all
    | ( ($all | of(["pyramid.authentication.AuthTktCookieHelper($$$_)"])
          | not_at($all | of(["pyramid.authentication.AuthTktCookieHelper($$$_, secure=$SECURE, $$$_)"]))
          | not_at($all | of(["pyramid.authentication.AuthTktCookieHelper($$$_, **$PARAMS)"])))
          + ($all | of(["pyramid.authentication.AuthTktAuthenticationPolicy($$$_)"])
          | not_at($all | of(["pyramid.authentication.AuthTktAuthenticationPolicy($$$_, secure=$SECURE, $$$_)"]))
          | not_at($all | of(["pyramid.authentication.AuthTktAuthenticationPolicy($$$_, **$PARAMS)"])))
        | finding("pyramid-authtkt-cookie-secure-unsafe-default";
            "Found a Pyramid Authentication Ticket cookie using an unsafe default for the secure option.") ) )
| report
