# rules: pyramid-authtkt-cookie-httponly-unsafe-default
# languages: python
# from: python/pyramid/audit/authtkt-cookie-httponly-unsafe-default.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "pyramid.authentication.$FUNC($$$PARAMS)",
      "pyramid.authentication.$FUNC($$$_, **$PARAMS, $$$_)",
      "pyramid.authentication.$FUNC($$$_, httponly=$HTTPONLY, $$$_)"
    ])) as $all
    | ( $all | of(["pyramid.authentication.$FUNC($$$PARAMS)"])
          | not_at($all | of(["pyramid.authentication.$FUNC($$$_, httponly=$HTTPONLY, $$$_)"]))
          | not_at($all | of(["pyramid.authentication.$FUNC($$$_, **$PARAMS, $$$_)"]))
          | focus("PARAMS")
        | finding("pyramid-authtkt-cookie-httponly-unsafe-default";
            "Found a Pyramid Authentication Ticket cookie without the httponly option correctly set.") ) )
| report
