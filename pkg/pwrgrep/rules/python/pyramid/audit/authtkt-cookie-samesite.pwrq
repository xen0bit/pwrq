# rules: pyramid-authtkt-cookie-samesite
# languages: python
# from: python/pyramid/audit/authtkt-cookie-samesite.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$SAMESITE",
      "pyramid.authentication.AuthTktAuthenticationPolicy($$$_, samesite=$SAMESITE, $$$_)",
      "pyramid.authentication.AuthTktCookieHelper($$$_, samesite=$SAMESITE, $$$_)"
    ])) as $all
    | ( $all | of(["pyramid.authentication.AuthTktCookieHelper($$$_, samesite=$SAMESITE, $$$_)","pyramid.authentication.AuthTktAuthenticationPolicy($$$_, samesite=$SAMESITE, $$$_)"])
          | at_same_place(($all | of(["$SAMESITE"])))
          | where_capture_not("SAMESITE"; "^(?:'Lax')")
        | finding("pyramid-authtkt-cookie-samesite";
            "Found a Pyramid Authentication Ticket without the samesite option correctly set.") ) )
| report
