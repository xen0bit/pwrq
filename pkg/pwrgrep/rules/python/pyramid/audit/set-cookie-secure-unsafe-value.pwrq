# rules: pyramid-set-cookie-secure-unsafe-value
# languages: python
# from: python/pyramid/audit/set-cookie-secure-unsafe-value.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$RESPONSE.set_cookie($$$_, **$PARAMS)",
      "$RESPONSE.set_cookie($$$_, secure=$SECURE, $$$_)",
      "$SECURE",
      "@pyramid.view.view_config($$$_)\ndef $VIEW($REQUEST):\n    $$$_\n    $RESPONSE = $REQUEST.response\n    $$$_",
      "def $VIEW($$$_):\n    $$$_\n    $RESPONSE = pyramid.httpexceptions.HTTPFound($$$_)\n    $$$_"
    ])) as $all
    | ( ($all
          | within($all | of(["@pyramid.view.view_config($$$_)\ndef $VIEW($REQUEST):\n    $$$_\n    $RESPONSE = $REQUEST.response\n    $$$_"])))
          + ($all
          | within($all | of(["def $VIEW($$$_):\n    $$$_\n    $RESPONSE = pyramid.httpexceptions.HTTPFound($$$_)\n    $$$_"])))
          | at_same_place(($all | of(["$RESPONSE.set_cookie($$$_, secure=$SECURE, $$$_)"])))
          | at_same_place(($all | of(["$SECURE"])))
          | not_at($all | of(["$RESPONSE.set_cookie($$$_, **$PARAMS)"]))
          | where_capture_ast("SECURE"; "False")
        | finding("pyramid-set-cookie-secure-unsafe-value";
            "Found a Pyramid cookie without the secure option correctly set.") ) )
| report
