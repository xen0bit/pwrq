# rules: pyramid-set-cookie-samesite-unsafe-value
# languages: python
# from: python/pyramid/audit/set-cookie-samesite-unsafe-value.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$RESPONSE.set_cookie($$$_, **$PARAMS)",
      "$RESPONSE.set_cookie($$$_, samesite=$SAMESITE, $$$_)",
      "$SAMESITE",
      "@pyramid.view.view_config($$$_)\ndef $VIEW($REQUEST):\n    $$$_\n    $RESPONSE = $REQUEST.response\n    $$$_",
      "def $VIEW($$$_):\n    $$$_\n    $RESPONSE = pyramid.httpexceptions.HTTPFound($$$_)\n    $$$_"
    ])) as $all
    | ( ($all
          | within($all | of(["@pyramid.view.view_config($$$_)\ndef $VIEW($REQUEST):\n    $$$_\n    $RESPONSE = $REQUEST.response\n    $$$_"])))
          + ($all
          | within($all | of(["def $VIEW($$$_):\n    $$$_\n    $RESPONSE = pyramid.httpexceptions.HTTPFound($$$_)\n    $$$_"])))
          | at_same_place(($all | of(["$RESPONSE.set_cookie($$$_, samesite=$SAMESITE, $$$_)"])))
          | at_same_place(($all | of(["$SAMESITE"])))
          | not_at($all | of(["$RESPONSE.set_cookie($$$_, **$PARAMS)"]))
          | where_capture_not("SAMESITE"; "^(?:'Lax')")
        | finding("pyramid-set-cookie-samesite-unsafe-value";
            "Found a Pyramid cookie without the samesite option correctly set.") ) )
| report
