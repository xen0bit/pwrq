# rules: pyramid-direct-use-of-response
# languages: python
# from: python/pyramid/security/direct-use-of-response.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$REQ.$ANYTHING",
      "$REQ.dbsession",
      "$REQ.response.body = $SINK",
      "$REQ.response.text = $SINK",
      "$REQ.response.ubody = $SINK",
      "$REQ.response.unicode_body = $SINK",
      "$SINK",
      "@pyramid.view.view_config( $$$_ )\ndef $VIEW($REQ):\n  $$$_",
      "pyramid.request.Response($SINK)",
      "pyramid.request.Response.text($SINK)"
    ])) as $all
    | ( (($all | of(["pyramid.request.Response.text($SINK)","pyramid.request.Response($SINK)","$REQ.response.body = $SINK","$REQ.response.text = $SINK","$REQ.response.ubody = $SINK","$REQ.response.unicode_body = $SINK"])
          | at_same_place(($all | of(["$SINK"])))))
          | reaching((($all | of(["$REQ.$ANYTHING"])
          | within($all | of(["@pyramid.view.view_config( $$$_ )\ndef $VIEW($REQ):\n  $$$_"]))
          | not_at($all | of(["$REQ.dbsession"]))));
              ([]))
        | finding("pyramid-direct-use-of-response";
            "Detected data rendered directly to the end user via 'Response'.") ) )
| report
