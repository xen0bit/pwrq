# rules: insufficient-ec-key-size
# languages: python
# from: python/cryptography/security/insufficient-ec-key-size.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "cryptography.hazmat.primitives.asymmetric.ec.$SIZE",
      "cryptography.hazmat.primitives.asymmetric.ec.generate_private_key($$$_)"
    ])) as $all
    | ( $all | of(["cryptography.hazmat.primitives.asymmetric.ec.$SIZE"])
          | within($all | of(["cryptography.hazmat.primitives.asymmetric.ec.generate_private_key($$$_)"]))
          | focus("SIZE")
        | finding("insufficient-ec-key-size";
            "Detected an insufficient curve size for EC.") ) )
| report
