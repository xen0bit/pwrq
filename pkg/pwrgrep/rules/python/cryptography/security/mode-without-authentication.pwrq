# rules: crypto-mode-without-authentication
# languages: python
# from: python/cryptography/security/mode-without-authentication.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "Cipher($$$_, $HAZMAT_MODE($$$_),$$$_)",
      "Cipher($$$_, $HAZMAT_MODE($$$_),$$$_)\n$$$_\nHMAC($$$_)",
      "Cipher($$$_, $HAZMAT_MODE($$$_),$$$_)\n$$$_\nhmac.HMAC($$$_)"
    ])) as $all
    | ( ($all | of(["Cipher($$$_, $HAZMAT_MODE($$$_),$$$_)"])
          | outside($all | of(["Cipher($$$_, $HAZMAT_MODE($$$_),$$$_)\n$$$_\nHMAC($$$_)"]))
          | outside($all | of(["Cipher($$$_, $HAZMAT_MODE($$$_),$$$_)\n$$$_\nhmac.HMAC($$$_)"])))
        | finding("crypto-mode-without-authentication";
            "An encryption mode of operation is being used without proper message authentication.") ) )
| report
