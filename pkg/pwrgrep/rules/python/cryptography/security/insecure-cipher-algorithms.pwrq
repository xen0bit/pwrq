# rules: insecure-cipher-algorithm-idea
# languages: python
# from: python/cryptography/security/insecure-cipher-algorithms.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "cryptography.hazmat.primitives.ciphers.algorithms.$IDEA($KEY)"
    ])) as $all
    | ( $all | of(["cryptography.hazmat.primitives.ciphers.algorithms.$IDEA($KEY)"])
          | where_capture("IDEA"; "^(IDEA)$")
          | focus("IDEA")
        | finding("insecure-cipher-algorithm-idea";
            "IDEA (International Data Encryption Algorithm) is a block cipher created in 1991.") ) )
| report
