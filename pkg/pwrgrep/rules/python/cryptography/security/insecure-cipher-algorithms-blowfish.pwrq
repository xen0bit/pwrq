# rules: insecure-cipher-algorithm-blowfish
# languages: python
# from: python/cryptography/security/insecure-cipher-algorithms-blowfish.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "cryptography.hazmat.primitives.ciphers.algorithms.$BLOWFISH($KEY)"
    ])) as $all
    | ( $all | of(["cryptography.hazmat.primitives.ciphers.algorithms.$BLOWFISH($KEY)"])
          | where_capture("BLOWFISH"; "^(Blowfish)$")
          | focus("BLOWFISH")
        | finding("insecure-cipher-algorithm-blowfish";
            "Blowfish is a block cipher developed by Bruce Schneier.") ) )
| report
