# rules: require-encryption
# languages: python
# from: python/distributed/security.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "distributed.security.Security($$$_, require_encryption=$VAL, $$$_)"
    ])) as $all
    | ( $all | of(["distributed.security.Security($$$_, require_encryption=$VAL, $$$_)"])
          | where_capture_ast("VAL"; "False")
          | focus("VAL")
        | finding("require-encryption";
            "Initializing a security context for Dask (`distributed`) without \"require_encryption\" keyword argument may silently fail to provide security.") ) )
| report
