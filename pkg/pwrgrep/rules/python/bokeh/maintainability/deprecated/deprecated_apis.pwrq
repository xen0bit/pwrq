# rules: bokeh-deprecated-apis
# from: python/bokeh/maintainability/deprecated/deprecated_apis.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "import bokeh.layouts.widgetbox",
      "import bokeh.models.graphs.from_networkx"
    ])) as $all
    | ( $all | of(["import bokeh.layouts.widgetbox","import bokeh.models.graphs.from_networkx"])
        | finding("bokeh-deprecated-apis";
            "These APIs are deprecated in Bokeh see https://docs.bokeh.org/en/latest/docs/releases.html#api-deprecations") ) )
| report
