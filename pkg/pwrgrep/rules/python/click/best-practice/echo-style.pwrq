# rules: use-click-secho
# languages: python
# from: python/click/best-practice/echo-style.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "click.echo(click.style($X, $$$_))"
    ])) as $all
    | ( $all | of(["click.echo(click.style($X, $$$_))"])
        | finding("use-click-secho";
            "Use `click.secho($X)` instead.") ) )
| report
