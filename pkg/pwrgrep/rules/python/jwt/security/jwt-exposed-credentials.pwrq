# rules: jwt-python-exposed-credentials
# from: python/jwt/security/jwt-exposed-credentials.yaml

. as $root
| ( ($root | scan_regex(["*.py"]; [
      "(?P<PAYLOAD>\\S+)\\s+=\\s+\\{[\\s\\S]*?,\"password\":(?P<P>\\S+),[\\s\\S]*?\\}\\s+[\\s\\S]*?\\s+jwt\\.encode\\((?P<PAYLOAD>\\S+),[\\s\\S]*?\\)",
      "jwt\\.encode\\(\\{[\\s\\S]*?,\"password\":(?P<P>\\S+),[\\s\\S]*?\\},[\\s\\S]*?\\)"
    ])) as $all
    | ( $all | of(["jwt\\.encode\\(\\{[\\s\\S]*?,\"password\":(?P<P>\\S+),[\\s\\S]*?\\},[\\s\\S]*?\\)","(?P<PAYLOAD>\\S+)\\s+=\\s+\\{[\\s\\S]*?,\"password\":(?P<P>\\S+),[\\s\\S]*?\\}\\s+[\\s\\S]*?\\s+jwt\\.encode\\((?P<PAYLOAD>\\S+),[\\s\\S]*?\\)"])
        | finding("jwt-python-exposed-credentials";
            "Password is exposed through JWT token payload.") ) )
| report
