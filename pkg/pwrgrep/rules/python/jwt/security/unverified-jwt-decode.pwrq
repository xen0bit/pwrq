# rules: unverified-jwt-decode
# languages: python
# from: python/jwt/security/unverified-jwt-decode.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$OPTS = {$$$_, \"verify_signature\": $BOOL, $$$_}\n$$$_\njwt.decode($$$_, options=$OPTS, $$$_)",
      "jwt.decode($$$_, options={$$$_, \"verify_signature\": $BOOL, $$$_}, $$$_)"
    ])) as $all
    | ( ($all | of(["jwt.decode($$$_, options={$$$_, \"verify_signature\": $BOOL, $$$_}, $$$_)"])
          | where_capture_ast("BOOL"; "False")
          | focus("BOOL"))
          + ($all | of(["$OPTS = {$$$_, \"verify_signature\": $BOOL, $$$_}\n$$$_\njwt.decode($$$_, options=$OPTS, $$$_)"])
          | where_capture_ast("BOOL"; "False")
          | focus("BOOL"))
        | finding("unverified-jwt-decode";
            "Detected JWT token decoded with 'verify=False'.") ) )
| report
