# rules: dangerous-asyncio-exec
# languages: python
# from: python/aws-lambda/security/dangerous-asyncio-exec.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$LOOP.subprocess_exec($PROTOCOL, \"=~/(sh|bash|ksh|csh|tcsh|zsh)/\", \"-c\", $CMD, $$$_)",
      "$LOOP.subprocess_exec($PROTOCOL, $CMD, $$$_)",
      "$LOOP.subprocess_exec($PROTOCOL, [\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\", \"-c\", $CMD, $$$_], $$$_)",
      "$LOOP.subprocess_exec($PROTOCOL, [$CMD, $$$_], $$$_)",
      "def $HANDLER(event, context):\n  $$$_",
      "event"
    ])) as $all
    | ( (($all | of(["$LOOP.subprocess_exec($PROTOCOL, $CMD, $$$_)","$LOOP.subprocess_exec($PROTOCOL, [$CMD, $$$_], $$$_)","$LOOP.subprocess_exec($PROTOCOL, \"=~/(sh|bash|ksh|csh|tcsh|zsh)/\", \"-c\", $CMD, $$$_)","$LOOP.subprocess_exec($PROTOCOL, [\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\", \"-c\", $CMD, $$$_], $$$_)"])
          | focus("CMD")))
          | reaching((($all | of(["event"])
          | within($all | of(["def $HANDLER(event, context):\n  $$$_"]))));
              ([]))
        | finding("dangerous-asyncio-exec";
            "Detected subprocess function '$LOOP.subprocess_exec' with argument tainted by `event` object.") ) )
| report
