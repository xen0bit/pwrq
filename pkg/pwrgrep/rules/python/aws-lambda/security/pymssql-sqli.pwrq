# rules: pymssql-sqli
# languages: python
# from: python/aws-lambda/security/pymssql-sqli.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$CURSOR.execute($QUERY,$$$_)",
      "def $HANDLER(event, context):\n  $$$_",
      "event",
      "import pymssql\n$$$_"
    ])) as $all
    | ( (($all | of(["$CURSOR.execute($QUERY,$$$_)"])
          | focus("QUERY")
          | in_files_with($all | of(["import pymssql\n$$$_"]))))
          | reaching((($all | of(["event"])
          | within($all | of(["def $HANDLER(event, context):\n  $$$_"]))));
              ([]))
        | finding("pymssql-sqli";
            "Detected SQL statement that is tainted by `event` object.") ) )
| report
