# rules: tainted-sql-string
# languages: python
# from: python/aws-lambda/security/tainted-sql-string.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "\"$SQLSTR\" % $$$_",
      "\"$SQLSTR\" + $$$_",
      "\"$SQLSTR\".format($$$_)",
      "def $HANDLER(event, context):\n  $$$_",
      "event",
      "f\"$SQLSTR{$$$_}$$$_\"",
      "print($$$_)"
    ])) as $all
    | ( (($all | of(["\"$SQLSTR\" + $$$_","\"$SQLSTR\" % $$$_","\"$SQLSTR\".format($$$_)","f\"$SQLSTR{$$$_}$$$_\""])
          | where_capture("SQLSTR"; "^(?:\\s*(?i)(select|delete|insert|create|update|alter|drop)\\b.*=)")
          | outside($all | of(["print($$$_)"]))))
          | reaching((($all | of(["event"])
          | within($all | of(["def $HANDLER(event, context):\n  $$$_"]))));
              ([]))
        | finding("tainted-sql-string";
            "Detected user input used to manually construct a SQL string.") ) )
| report
