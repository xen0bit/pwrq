# rules: psycopg-sqli
# languages: python
# from: python/aws-lambda/security/psycopg-sqli.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$CURSOR.execute($QUERY,$$$_)",
      "$CURSOR.executemany($QUERY,$$$_)",
      "$CURSOR.mogrify($QUERY,$$$_)",
      "def $HANDLER(event, context):\n  $$$_",
      "event",
      "import psycopg2\n$$$_"
    ])) as $all
    | ( (($all | of(["$CURSOR.execute($QUERY,$$$_)","$CURSOR.executemany($QUERY,$$$_)","$CURSOR.mogrify($QUERY,$$$_)"])
          | focus("QUERY")
          | in_files_with($all | of(["import psycopg2\n$$$_"]))))
          | reaching((($all | of(["event"])
          | within($all | of(["def $HANDLER(event, context):\n  $$$_"]))));
              ([]))
        | finding("psycopg-sqli";
            "Detected SQL statement that is tainted by `event` object.") ) )
| report
