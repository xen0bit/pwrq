# rules: tainted-pickle-deserialization
# languages: python
# from: python/aws-lambda/security/tainted-pickle-deserialization.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "_pickle.load($SINK,$$$_)",
      "_pickle.loads($SINK,$$$_)",
      "cPickle.load($SINK,$$$_)",
      "cPickle.loads($SINK,$$$_)",
      "def $HANDLER(event, context):\n  $$$_",
      "dill.load($SINK,$$$_)",
      "dill.loads($SINK,$$$_)",
      "event",
      "pickle.load($SINK,$$$_)",
      "pickle.loads($SINK,$$$_)",
      "shelve.open($SINK,$$$_)"
    ])) as $all
    | ( (($all | of(["pickle.load($SINK,$$$_)","pickle.loads($SINK,$$$_)","_pickle.load($SINK,$$$_)","_pickle.loads($SINK,$$$_)","cPickle.load($SINK,$$$_)","cPickle.loads($SINK,$$$_)","dill.load($SINK,$$$_)","dill.loads($SINK,$$$_)","shelve.open($SINK,$$$_)"])
          | focus("SINK")))
          | reaching((($all | of(["event"])
          | within($all | of(["def $HANDLER(event, context):\n  $$$_"]))));
              ([]))
        | finding("tainted-pickle-deserialization";
            "Avoid using `pickle`, which is known to lead to code execution vulnerabilities.") ) )
| report
