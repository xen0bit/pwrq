# rules: mysql-sqli
# languages: python
# from: python/aws-lambda/security/mysql-sqli.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$CURSOR.execute($QUERY,$$$_)",
      "$CURSOR.executemany($QUERY,$$$_)",
      "def $HANDLER(event, context):\n  $$$_",
      "event",
      "import mysql\n$$$_",
      "import mysql.cursors\n$$$_"
    ])) as $all
    | ( (($all | of(["$CURSOR.execute($QUERY,$$$_)","$CURSOR.executemany($QUERY,$$$_)"])
          | at_same_place((($all
          | in_files_with($all | of(["import mysql\n$$$_"])))
          + ($all
          | in_files_with($all | of(["import mysql.cursors\n$$$_"])))))
          | focus("QUERY")))
          | reaching((($all | of(["event"])
          | within($all | of(["def $HANDLER(event, context):\n  $$$_"]))));
              ([]))
        | finding("mysql-sqli";
            "Detected SQL statement that is tainted by `event` object.") ) )
| report
