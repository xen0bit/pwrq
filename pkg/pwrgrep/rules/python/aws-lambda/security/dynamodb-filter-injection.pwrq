# rules: dynamodb-filter-injection
# languages: python
# from: python/aws-lambda/security/dynamodb-filter-injection.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$DB = boto3.resource('dynamodb', $$$_)\n$$$_",
      "$TABLE = $DB.Table($$$_)\n$$$_",
      "$TABLE = boto3.client('dynamodb', $$$_)\n$$$_",
      "$TABLE.query($$$_, QueryFilter = $SINK, $$$_)",
      "$TABLE.scan($$$_, ScanFilter = $SINK, $$$_)",
      "def $HANDLER(event, context):\n  $$$_",
      "event",
      "{$$$_}"
    ])) as $all
    | ( (($all | of(["$TABLE.scan($$$_, ScanFilter = $SINK, $$$_)","$TABLE.query($$$_, QueryFilter = $SINK, $$$_)"])
          | at_same_place((($all
          | in_files_with($all | of(["$TABLE = $DB.Table($$$_)\n$$$_"]))
          | in_files_with($all | of(["$DB = boto3.resource('dynamodb', $$$_)\n$$$_"])))
          + ($all
          | in_files_with($all | of(["$TABLE = boto3.client('dynamodb', $$$_)\n$$$_"])))))
          | focus("SINK")))
          | reaching((($all | of(["event"])
          | within($all | of(["def $HANDLER(event, context):\n  $$$_"]))));
              (($all | of(["{$$$_}"]))))
        | finding("dynamodb-filter-injection";
            "Detected DynamoDB query filter that is tainted by `$EVENT` object.") ) )
| report
