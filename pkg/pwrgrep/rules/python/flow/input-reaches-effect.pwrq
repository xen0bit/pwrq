# rules: python-input-reaches-effect
# languages: python
# fixture: python/input-reaches-effect.py
#
# Source to sink: a value from python-external-input that arrives, through
# assignments, at an argument of one of python-side-effects. It answers "what
# can the outside world steer?", which is a question about behaviour before it
# is one about security.
#
# The following is within one function and by assignment only - see reaching
# in pkg/udf/pwrgrep. A value handed to a helper and returned is not followed,
# so an absence here is not proof there is no path.

["os.environ[$K]", "os.environ.get($$$_)", "os.getenv($$$_)", "sys.argv", "$P.parse_args()",
 "input($$$_)", "sys.stdin", "request.args", "request.form", "request.json",
 "request.get_json($$$_)", "request.data", "request.cookies", "request.headers"] as $sources
| ["os.system($$$A)", "os.popen($$$A)", "subprocess.run($$$A)", "subprocess.call($$$A)",
   "subprocess.Popen($$$A)", "subprocess.check_output($$$A)", "os.remove($$$A)", "os.unlink($$$A)",
   "shutil.rmtree($$$A)", "open($$$A)", "requests.get($$$A)", "requests.post($$$A)",
   "urlopen($$$A)", "$C.execute($$$A)"] as $sinks
| scan_ast("*.py"; $sources + $sinks) as $all
| $all | of($sinks)
| reaching($all | of($sources); [])
| finding("python-input-reaches-effect"; "external input reaches this call's arguments $A")
| report
