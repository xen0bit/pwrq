# rules: twiml-injection
# languages: python
# from: python/twilio/security/twiml-injection.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "\"$$$_\" % $$$_",
      "\"$$$_\".format($$$_)",
      "$ARG",
      "$CLIENT.calls.create($$$_, twiml=$SINK, $$$_)",
      "def $F($$$_, $ARG, $$$_):\n    $$$_",
      "f\"$$$_\"",
      "html.escape($$$_)",
      "xml.sax.saxutils.escape($$$_)"
    ])) as $all
    | ( (($all | of(["$CLIENT.calls.create($$$_, twiml=$SINK, $$$_)"])
          | focus("SINK")))
          | reaching((($all | of(["f\"$$$_\""]))
              + ($all | of(["\"$$$_\" % $$$_"]))
              + ($all | of(["\"$$$_\".format($$$_)"]))
              + ($all | of(["$ARG"])
          | within($all | of(["def $F($$$_, $ARG, $$$_):\n    $$$_"]))));
              (($all | of(["xml.sax.saxutils.escape($$$_)"]))
              + ($all | of(["html.escape($$$_)"]))))
        | finding("twiml-injection";
            "Using non-constant TwiML (Twilio Markup Language) argument when creating a Twilio conversation could allow the injection of additional TwiML commands") ) )
| report
