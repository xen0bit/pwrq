# rules: avoid-accessing-request-in-wrong-handler
# languages: python
# from: python/flask/correctness/access-request-in-wrong-handler.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$Y = flask.request.data",
      "$Y = flask.request.form",
      "$Y = flask.request.json",
      "@app.route($$$_, method=\"GET\")\ndef $X($$$_):\n  $$$_"
    ])) as $all
    | ( $all | of(["$Y = flask.request.json","$Y = flask.request.form","$Y = flask.request.data"])
          | within($all | of(["@app.route($$$_, method=\"GET\")\ndef $X($$$_):\n  $$$_"]))
        | finding("avoid-accessing-request-in-wrong-handler";
            "Accessing request object inside a route handle for HTTP GET command will throw due to missing request body.") ) )
| report
