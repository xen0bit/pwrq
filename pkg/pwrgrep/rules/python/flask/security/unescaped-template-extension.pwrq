# rules: unescaped-template-extension
# from: python/flask/security/unescaped-template-extension.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "flask.render_template(\"$$$_\" % $Y, $$$_)",
      "flask.render_template(\"$$$_\", $$$_)",
      "flask.render_template(\"$$$_\".format($$$_), $$$_)",
      "flask.render_template(\"=~/.+\\.htm$/\" % $X, $$$_)",
      "flask.render_template(\"=~/.+\\.htm$/\", $$$_)",
      "flask.render_template(\"=~/.+\\.htm$/\".format($$$_), $$$_)",
      "flask.render_template(\"=~/.+\\.html$/\" % $X, $$$_)",
      "flask.render_template(\"=~/.+\\.html$/\", $$$_)",
      "flask.render_template(\"=~/.+\\.html$/\".format($$$_), $$$_)",
      "flask.render_template(\"=~/.+\\.xhtml$/\" % $X, $$$_)",
      "flask.render_template(\"=~/.+\\.xhtml$/\", $$$_)",
      "flask.render_template(\"=~/.+\\.xhtml$/\".format($$$_), $$$_)",
      "flask.render_template(\"=~/.+\\.xml$/\" % $X, $$$_)",
      "flask.render_template(\"=~/.+\\.xml$/\", $$$_)",
      "flask.render_template(\"=~/.+\\.xml$/\".format($$$_), $$$_)",
      "flask.render_template($TEMPLATE)",
      "flask.render_template($X + \"$$$_\", $$$_)",
      "flask.render_template($X + \"=~/\\.htm$/\", $$$_)",
      "flask.render_template($X + \"=~/\\.html$/\", $$$_)",
      "flask.render_template($X + \"=~/\\.xhtml$/\", $$$_)",
      "flask.render_template($X + \"=~/\\.xml$/\", $$$_)"
    ])) as $all
    | ( $all | of(["flask.render_template(\"$$$_\", $$$_)","flask.render_template($X + \"$$$_\", $$$_)","flask.render_template(\"$$$_\" % $Y, $$$_)","flask.render_template(\"$$$_\".format($$$_), $$$_)"])
          | not_at($all | of(["flask.render_template(\"=~/.+\\.html$/\", $$$_)"]))
          | not_at($all | of(["flask.render_template(\"=~/.+\\.xml$/\", $$$_)"]))
          | not_at($all | of(["flask.render_template(\"=~/.+\\.htm$/\", $$$_)"]))
          | not_at($all | of(["flask.render_template(\"=~/.+\\.xhtml$/\", $$$_)"]))
          | not_at($all | of(["flask.render_template($X + \"=~/\\.html$/\", $$$_)"]))
          | not_at($all | of(["flask.render_template($X + \"=~/\\.xml$/\", $$$_)"]))
          | not_at($all | of(["flask.render_template($X + \"=~/\\.htm$/\", $$$_)"]))
          | not_at($all | of(["flask.render_template($X + \"=~/\\.xhtml$/\", $$$_)"]))
          | not_at($all | of(["flask.render_template(\"=~/.+\\.html$/\" % $X, $$$_)"]))
          | not_at($all | of(["flask.render_template(\"=~/.+\\.xml$/\" % $X, $$$_)"]))
          | not_at($all | of(["flask.render_template(\"=~/.+\\.htm$/\" % $X, $$$_)"]))
          | not_at($all | of(["flask.render_template(\"=~/.+\\.xhtml$/\" % $X, $$$_)"]))
          | not_at($all | of(["flask.render_template(\"=~/.+\\.html$/\".format($$$_), $$$_)"]))
          | not_at($all | of(["flask.render_template(\"=~/.+\\.xml$/\".format($$$_), $$$_)"]))
          | not_at($all | of(["flask.render_template(\"=~/.+\\.htm$/\".format($$$_), $$$_)"]))
          | not_at($all | of(["flask.render_template(\"=~/.+\\.xhtml$/\".format($$$_), $$$_)"]))
          | not_at($all | of(["flask.render_template($TEMPLATE)"]))
        | finding("unescaped-template-extension";
            "Flask does not automatically escape Jinja templates unless they have .html, .htm, .xml, or .xhtml extensions.") ) )
| report
