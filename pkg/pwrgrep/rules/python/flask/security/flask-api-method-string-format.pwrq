# rules: flask-api-method-string-format
# from: python/flask/security/flask-api-method-string-format.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "class $CLASS($$$_):\n  method_decorators = $$$_\n  $$$_",
      "def $METHOD($$$_,$ARG,$$$_):\n  $$$_\n  $$$_ = requests.$REQMETHOD(\"$$$_\".format($$$_,$ARG,$$$_),$$$_)",
      "def $METHOD($$$_,$ARG,$$$_):\n  $$$_\n  $STRING = \"$$$_\".format($$$_,$ARG,$$$_)\n  $$$_\n  $$$_ = requests.$REQMETHOD($STRING,$$$_)"
    ])) as $all
    | ( $all | of(["def $METHOD($$$_,$ARG,$$$_):\n  $$$_\n  $STRING = \"$$$_\".format($$$_,$ARG,$$$_)\n  $$$_\n  $$$_ = requests.$REQMETHOD($STRING,$$$_)","def $METHOD($$$_,$ARG,$$$_):\n  $$$_\n  $$$_ = requests.$REQMETHOD(\"$$$_\".format($$$_,$ARG,$$$_),$$$_)"])
          | within($all | of(["class $CLASS($$$_):\n  method_decorators = $$$_\n  $$$_"]))
        | finding("flask-api-method-string-format";
            "Method $METHOD in API controller $CLASS provides user arg $ARG to requests method $REQMETHOD") ) )
| report
