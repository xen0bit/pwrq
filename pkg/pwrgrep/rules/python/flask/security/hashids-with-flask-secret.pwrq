# rules: hashids-with-flask-secret
# from: python/flask/security/hashids-with-flask-secret.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$APP = flask.Flask($$$_)\n$$$_",
      "hashids.Hashids($$$_, salt=$APP.config['SECRET_KEY'], $$$_)",
      "hashids.Hashids($$$_, salt=flask.current_app.config['SECRET_KEY'], $$$_)",
      "hashids.Hashids($APP.config['SECRET_KEY'], $$$_)",
      "hashids.Hashids(flask.current_app.config['SECRET_KEY'], $$$_)"
    ])) as $all
    | ( ($all | of(["hashids.Hashids($$$_, salt=flask.current_app.config['SECRET_KEY'], $$$_)"]))
          + ($all | of(["hashids.Hashids(flask.current_app.config['SECRET_KEY'], $$$_)"]))
          + ($all | of(["hashids.Hashids($$$_, salt=$APP.config['SECRET_KEY'], $$$_)","hashids.Hashids($APP.config['SECRET_KEY'], $$$_)"])
          | in_files_with($all | of(["$APP = flask.Flask($$$_)\n$$$_"])))
        | finding("hashids-with-flask-secret";
            "The Flask secret key is used as salt in HashIDs.") ) )
| report
