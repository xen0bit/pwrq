# rules: insecure-deserialization
# from: python/flask/security/insecure-deserialization.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$MODULE.$FUNC(\"$$$_\")",
      "$MODULE.$FUNC(open(\"$$$_\", $$$_))",
      "@app.route($$$_)\ndef $X($$$_):\n  $$$_",
      "_pickle.$FUNC($$$_)",
      "cPickle.$FUNC($$$_)",
      "dill.$FUNC($$$_)",
      "pickle.$FUNC($$$_)",
      "shelve.$FUNC($$$_)",
      "yaml.load($$$_)"
    ])) as $all
    | ( $all | of(["pickle.$FUNC($$$_)","_pickle.$FUNC($$$_)","cPickle.$FUNC($$$_)","dill.$FUNC($$$_)","shelve.$FUNC($$$_)","yaml.load($$$_)"])
          | within($all | of(["@app.route($$$_)\ndef $X($$$_):\n  $$$_"]))
          | not_at($all | of(["$MODULE.$FUNC(\"$$$_\")"]))
          | not_at($all | of(["$MODULE.$FUNC(open(\"$$$_\", $$$_))"]))
        | finding("insecure-deserialization";
            "Detected the use of an insecure deserialization library in a Flask route.") ) )
| report
