# rules: dangerous-template-string
# languages: python
# from: python/flask/security/dangerous-template-string.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$V = \"$$$_\"\n$$$_\n$V += $O\n$$$_\nflask.render_template_string($V, $$$_)",
      "$V = \"$$$_\"\n$$$_\n$V += $O\n$$$_\nreturn flask.render_template_string($V, $$$_), $MORE",
      "$V = \"$$$_\" % $S\n$$$_\nflask.render_template_string($V, $$$_)",
      "$V = \"$$$_\" % $S\n$$$_\nreturn flask.render_template_string($V, $$$_), $MORE",
      "$V = \"$$$_\".format($$$_)\n$$$_\nflask.render_template_string($V, $$$_)",
      "$V = \"$$$_\".format($$$_)\n$$$_\nreturn flask.render_template_string($V, $$$_), $MORE",
      "$V = f\"$$$_{$X}$$$_\"\n$$$_\nflask.render_template_string($V, $$$_)",
      "$V = f\"$$$_{$X}$$$_\"\n$$$_\nreturn flask.render_template_string($V, $$$_), $CODE"
    ])) as $all
    | ( $all | of(["$V = \"$$$_\".format($$$_)\n$$$_\nflask.render_template_string($V, $$$_)","$V = \"$$$_\".format($$$_)\n$$$_\nreturn flask.render_template_string($V, $$$_), $MORE","$V = \"$$$_\" % $S\n$$$_\nflask.render_template_string($V, $$$_)","$V = \"$$$_\" % $S\n$$$_\nreturn flask.render_template_string($V, $$$_), $MORE","$V = \"$$$_\"\n$$$_\n$V += $O\n$$$_\nflask.render_template_string($V, $$$_)","$V = \"$$$_\"\n$$$_\n$V += $O\n$$$_\nreturn flask.render_template_string($V, $$$_), $MORE","$V = f\"$$$_{$X}$$$_\"\n$$$_\nflask.render_template_string($V, $$$_)","$V = f\"$$$_{$X}$$$_\"\n$$$_\nreturn flask.render_template_string($V, $$$_), $CODE"])
        | finding("dangerous-template-string";
            "Found a template created with string formatting.") ) )
| report
