# rules: explicit-unescape-with-markup
# languages: python
# from: python/flask/security/xss/audit/explicit-unescape-with-markup.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$MARKUPOBJ.unescape()",
      "flask.Markup($Q)",
      "flask.Markup.unescape($$$_)",
      "markupsafe.Markup($Q)"
    ])) as $all
    | ( ($all | of(["flask.Markup.unescape($$$_)"]))
          + ($all | of(["$MARKUPOBJ.unescape()"]))
          + ($all | of(["flask.Markup($Q)","markupsafe.Markup($Q)"]))
        | finding("explicit-unescape-with-markup";
            "Detected explicitly unescaped content using 'Markup()'.") ) )
| report
