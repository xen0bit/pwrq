# rules: template-unquoted-attribute-var
# from: python/flask/security/xss/audit/template-unquoted-attribute-var.yaml

. as $root
| ( ($root | scan_regex(["*.html","*.py"]; [
      "<(?P<TAG>\\S+)\\s+[\\s\\S]*?\\s+>",
      "=\\{\\{(?P<VAR>[\\s\\S]*?)\\}\\}"
    ])) as $all
    | ( $all | of(["=\\{\\{(?P<VAR>[\\s\\S]*?)\\}\\}"])
          | within($all | of(["<(?P<TAG>\\S+)\\s+[\\s\\S]*?\\s+>"]))
        | finding("template-unquoted-attribute-var";
            "Detected a unquoted template variable as an attribute.") ) )
| report
