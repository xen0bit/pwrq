# rules: template-autoescape-off
# from: python/flask/security/xss/audit/template-autoescape-off.yaml

. as $root
| ( ($root | scan_regex(["*.html"]; [
      "{%\\s*autoescape\\s+false\\s*%}"
    ])) as $all
    | ( $all | of(["{%\\s*autoescape\\s+false\\s*%}"])
        | finding("template-autoescape-off";
            "Detected a segment of a Flask template where autoescaping is explicitly disabled with '{% autoescape off %}'.") ) )
| report
