# rules: host-header-injection-python
# languages: python
# from: python/flask/security/audit/host-header-injection-python.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$X = $PWRQDEEP1;",
      "$Z = flask.request.host;\n$$$_\n$X = $PWRQDEEP1;",
      "$Z = flask.request[\"host\"];\n$$$_\n$X = $PWRQDEEP1;",
      "@$APP.route($ROUTE, $$$_)\ndef $FUNC():\n  $$$_"
    ])) as $all
    | ( ($all | of(["$X = $PWRQDEEP1;"])
          | where_capture_ast("PWRQDEEP1"; "\"=~/.*http[s]*:///\" + flask.request.host"))
          + ($all | of(["$X = $PWRQDEEP1;"])
          | where_capture_ast("PWRQDEEP1"; "\"=~/.*http[s]*:///\" + flask.request[\"host\"]"))
          + ($all | of(["$Z = flask.request.host;\n$$$_\n$X = $PWRQDEEP1;"])
          | where_capture_ast("PWRQDEEP1"; "\"=~/.*http[s]*:///\" + $Z"))
          + ($all | of(["$Z = flask.request[\"host\"];\n$$$_\n$X = $PWRQDEEP1;"])
          | where_capture_ast("PWRQDEEP1"; "\"=~/.*http[s]*:///\" + $Z"))
          | within($all | of(["@$APP.route($ROUTE, $$$_)\ndef $FUNC():\n  $$$_"]))
        | finding("host-header-injection-python";
            "The `flask.request.host` is used to construct an HTTP request.") ) )
| report
