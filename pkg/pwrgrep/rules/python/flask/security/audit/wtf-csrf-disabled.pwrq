# rules: flask-wtf-csrf-disabled
# languages: python
# from: python/flask/security/audit/wtf-csrf-disabled.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$APP.config.$UPDATE(\n    $$$_,\n    DEBUG=True,\n    $$$_\n)",
      "$APP.config.$UPDATE(\n    $$$_,\n    TESTING=True,\n    $$$_\n)",
      "$APP.config.$UPDATE(\n  $$$_,\n  WTF_CSRF_ENABLED = $FALSE,\n  $$$_\n)",
      "$APP.config.WTF_CSRF_ENABLED = $FALSE",
      "$APP.config[\"WTF_CSRF_ENABLED\"] = $FALSE",
      "$OBJ = $CLASS()\n$$$_\n$OBJ.WTF_CSRF_ENABLED = $FALSE\n$$$_\n$APP.config.from_object($OBJ, $$$_)",
      "WTF_CSRF_ENABLED = $FALSE\n$$$_\n$APP.config.from_object(__name__)"
    ])) as $all
    | ( (($all | of(["$APP.config[\"WTF_CSRF_ENABLED\"] = $FALSE"]))
          + ($all | of(["$APP.config.WTF_CSRF_ENABLED = $FALSE"]))
          + ($all | of(["$APP.config.$UPDATE(\n  $$$_,\n  WTF_CSRF_ENABLED = $FALSE,\n  $$$_\n)"])
          | outside($all | of(["$APP.config.$UPDATE(\n    $$$_,\n    TESTING=True,\n    $$$_\n)"]))
          | outside($all | of(["$APP.config.$UPDATE(\n    $$$_,\n    DEBUG=True,\n    $$$_\n)"]))
          | where_capture("UPDATE"; "^(update|from_mapping)$"))
          + ($all | of(["$OBJ = $CLASS()\n$$$_\n$OBJ.WTF_CSRF_ENABLED = $FALSE\n$$$_\n$APP.config.from_object($OBJ, $$$_)"]))
          + ($all | of(["WTF_CSRF_ENABLED = $FALSE\n$$$_\n$APP.config.from_object(__name__)"]))
          | where_capture("FALSE"; "^(False)$")
          | focus("FALSE"))
        | finding("flask-wtf-csrf-disabled";
            "Setting 'WTF_CSRF_ENABLED' to 'False' explicitly disables CSRF protection.") ) )
| report
