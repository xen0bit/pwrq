# rules: avoid_app_run_with_bad_host
# languages: python
# from: python/flask/security/audit/app-run-param-config.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "app.run($$$_, \"0.0.0.0\", $$$_)",
      "app.run($$$_, host=\"0.0.0.0\", $$$_)"
    ])) as $all
    | ( $all | of(["app.run($$$_, host=\"0.0.0.0\", $$$_)","app.run($$$_, \"0.0.0.0\", $$$_)"])
        | finding("avoid_app_run_with_bad_host";
            "Running flask app with host 0.0.0.0 could expose the server publicly.") ) )
| report
