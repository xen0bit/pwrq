# rules: flask-cors-misconfiguration
# from: python/flask/security/audit/flask-cors-misconfiguration.yaml

. as $root
| ( ($root | scan_regex(["*.py"]; [
      "@cross_origin\\([\\s\\S]*?,\\s+origins=\"\\*\",\\s+supports_credentials=True,\\s+[\\s\\S]*?\\)",
      "CORS\\([\\s\\S]*?,\\s+resources=\\{\"[\\s\\S]*?\":\\s+\\{[\\s\\S]*?,\"origins\":\\s+\"\\*\",\\s+\"supports_credentials\":\\s+True,[\\s\\S]*?\\}\\}\\)",
      "CORS\\([\\s\\S]*?,\\s+supports_credentials=True,\\s+origins=\"\\*\",\\s+[\\s\\S]*?\\)"
    ])) as $all
    | ( $all | of(["@cross_origin\\([\\s\\S]*?,\\s+origins=\"\\*\",\\s+supports_credentials=True,\\s+[\\s\\S]*?\\)","CORS\\([\\s\\S]*?,\\s+supports_credentials=True,\\s+origins=\"\\*\",\\s+[\\s\\S]*?\\)","CORS\\([\\s\\S]*?,\\s+resources=\\{\"[\\s\\S]*?\":\\s+\\{[\\s\\S]*?,\"origins\":\\s+\"\\*\",\\s+\"supports_credentials\":\\s+True,[\\s\\S]*?\\}\\}\\)"])
        | finding("flask-cors-misconfiguration";
            "Setting 'support_credentials=True' together with 'origin=\"*\"' is a CORS misconfiguration that can allow third party origins to read sensitive data.") ) )
| report
