# rules: secure-set-cookie
# from: python/flask/security/audit/secure-set-cookie.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$RESP = flask.Response($$$_)\n$$$_",
      "$RESP = flask.make_response($$$_)\n$$$_",
      "$RESP.set_cookie($$$_)",
      "$RESP.set_cookie($$$_, **$A)",
      "$RESP.set_cookie($$$_, secure=$A, httponly=$B, samesite=$C, $$$_)"
    ])) as $all
    | ( ($all)
          + ($all)
          | at_same_place(($all | of(["$RESP.set_cookie($$$_)"])))
          | not_at($all | of(["$RESP.set_cookie($$$_, secure=$A, httponly=$B, samesite=$C, $$$_)"]))
          | not_at($all | of(["$RESP.set_cookie($$$_, **$A)"]))
        | finding("secure-set-cookie";
            "Found a Flask cookie with insecurely configured properties.") ) )
| report
