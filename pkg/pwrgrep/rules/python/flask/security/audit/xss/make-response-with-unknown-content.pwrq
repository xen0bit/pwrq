# rules: make-response-with-unknown-content
# from: python/flask/security/audit/xss/make-response-with-unknown-content.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$X = flask.jsonify($$$_)\n$$$_\nflask.make_response($X, $$$_)",
      "$X = flask.render_template($$$_)\n$$$_\nflask.make_response($X, $$$_)",
      "$X = json.dumps($$$_)\n$$$_\nflask.make_response($X, $$$_)",
      "flask.make_response(\"$$$_\", $$$_)",
      "flask.make_response($$$_)",
      "flask.make_response()",
      "flask.make_response(flask.jsonify($$$_), $$$_)",
      "flask.make_response(flask.redirect($$$_), $$$_)",
      "flask.make_response(flask.render_template($$$_), $$$_)",
      "flask.make_response(json.dumps($$$_), $$$_)",
      "flask.make_response({\"$$$_\": \"$$$_\"}, $$$_)"
    ])) as $all
    | ( $all | of(["flask.make_response($$$_)"])
          | outside($all | of(["flask.make_response()"]))
          | outside($all | of(["flask.make_response(\"$$$_\", $$$_)"]))
          | outside($all | of(["flask.make_response({\"$$$_\": \"$$$_\"}, $$$_)"]))
          | outside($all | of(["flask.make_response(flask.redirect($$$_), $$$_)"]))
          | outside($all | of(["flask.make_response(flask.render_template($$$_), $$$_)"]))
          | outside($all | of(["flask.make_response(flask.jsonify($$$_), $$$_)"]))
          | outside($all | of(["flask.make_response(json.dumps($$$_), $$$_)"]))
          | outside($all | of(["$X = flask.render_template($$$_)\n$$$_\nflask.make_response($X, $$$_)"]))
          | outside($all | of(["$X = flask.jsonify($$$_)\n$$$_\nflask.make_response($X, $$$_)"]))
          | outside($all | of(["$X = json.dumps($$$_)\n$$$_\nflask.make_response($X, $$$_)"]))
        | finding("make-response-with-unknown-content";
            "Be careful with `flask.make_response()`.") ) )
| report
