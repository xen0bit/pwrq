# rules: avoid_using_app_run_directly
# languages: python
# from: python/flask/security/audit/app-run-security-config.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "app.run($$$_)",
      "def $X($$$_):\n  $$$_",
      "if __name__ == '__main__':\n  $$$_"
    ])) as $all
    | ( $all | of(["app.run($$$_)"])
          | outside($all | of(["if __name__ == '__main__':\n  $$$_"]))
          | outside($all | of(["def $X($$$_):\n  $$$_"]))
        | finding("avoid_using_app_run_directly";
            "top-level app.run(...) is ignored by flask.") ) )
| report
