# rules: open-redirect
# languages: python
# from: python/flask/security/open-redirect.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$V = flask.request.$W\n$$$_\nflask.redirect($PWRQDEEP1, $$$_)",
      "$V = flask.request.$W($$$_)\n$$$_\nflask.redirect($PWRQDEEP1, $$$_)",
      "$V = flask.request.$W.get($$$_)\n$$$_\nflask.redirect($PWRQDEEP1, $$$_)",
      "$V = flask.request.$W[$$$_]\n$$$_\nflask.redirect($PWRQDEEP1, $$$_)",
      "@$APP.route($$$_)\ndef $X($$$_):\n  $$$_",
      "@$APP.route($$$_)\ndef $X($$$_):\n  $$$_\n  if $PWRQDEEP1:\n    $$$_",
      "flask.redirect($PWRQDEEP1, $$$_)",
      "flask.redirect(f\"{flask.request.path}$$$_\")",
      "flask.redirect(flask.request.path + $$$_)",
      "flask.redirect(flask.request.path)"
    ])) as $all
    | ( ($all | of(["flask.redirect($PWRQDEEP1, $$$_)"])
          | where_capture_ast("PWRQDEEP1"; "flask.request.$W.get($$$_)"))
          + ($all | of(["flask.redirect($PWRQDEEP1, $$$_)"])
          | where_capture_ast("PWRQDEEP1"; "flask.request.$W[$$$_]"))
          + ($all | of(["flask.redirect($PWRQDEEP1, $$$_)"])
          | where_capture_ast("PWRQDEEP1"; "flask.request.$W($$$_)"))
          + ($all | of(["flask.redirect($PWRQDEEP1, $$$_)"])
          | where_capture_ast("PWRQDEEP1"; "flask.request.$W"))
          + ($all | of(["$V = flask.request.$W.get($$$_)\n$$$_\nflask.redirect($PWRQDEEP1, $$$_)"])
          | where_capture_ast("PWRQDEEP1"; "$V"))
          + ($all | of(["$V = flask.request.$W[$$$_]\n$$$_\nflask.redirect($PWRQDEEP1, $$$_)"])
          | where_capture_ast("PWRQDEEP1"; "$V"))
          + ($all | of(["$V = flask.request.$W($$$_)\n$$$_\nflask.redirect($PWRQDEEP1, $$$_)"])
          | where_capture_ast("PWRQDEEP1"; "$V"))
          + ($all | of(["$V = flask.request.$W\n$$$_\nflask.redirect($PWRQDEEP1, $$$_)"])
          | where_capture_ast("PWRQDEEP1"; "$V"))
          | within($all | of(["@$APP.route($$$_)\ndef $X($$$_):\n  $$$_"]))
          | outside($all | of(["@$APP.route($$$_)\ndef $X($$$_):\n  $$$_\n  if $PWRQDEEP1:\n    $$$_"])
          | where_capture_ast("PWRQDEEP1"; "werkzeug.urls.url_parse($V)"))
          | not_at($all | of(["flask.redirect(flask.request.path)"]))
          | not_at($all | of(["flask.redirect(flask.request.path + $$$_)"]))
          | not_at($all | of(["flask.redirect(f\"{flask.request.path}$$$_\")"]))
        | finding("open-redirect";
            "Data from request is passed to redirect().") ) )
| report
