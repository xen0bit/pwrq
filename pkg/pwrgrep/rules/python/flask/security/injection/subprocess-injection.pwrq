# rules: subprocess-injection
# languages: python
# from: python/flask/security/injection/subprocess-injection.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$CMD = [\"$$$_\", $$$_]\n$$$_\nsubprocess.$FUNC($CMD, $$$_)",
      "$DICT[$KEY]",
      "@$APP.route($ROUTE, $$$_)\ndef $FUNC($$$_, $ROUTEVAR, $$$_):\n  $$$_",
      "flask.request.args.get($$$_)",
      "flask.request.args[$$$_]",
      "flask.request.cookies.get($$$_)",
      "flask.request.cookies[$$$_]",
      "flask.request.data",
      "flask.request.form.get($$$_)",
      "flask.request.form[$$$_]",
      "flask.request.full_path",
      "flask.request.get_json()",
      "flask.request.headers.get($$$_)",
      "flask.request.headers[$$$_]",
      "flask.request.json",
      "flask.request.stream",
      "flask.request.url",
      "flask.request.values.get($$$_)",
      "flask.request.values[$$$_]",
      "flask.request.view_args.get($$$_)",
      "flask.request.view_args[$$$_]",
      "subprocess.$FUNC(\"$$$_\", $$$_)",
      "subprocess.$FUNC($$$_)",
      "subprocess.$FUNC([\"$$$_\", $$$_], $$$_)",
      "subprocess.$FUNC([\"$INTERPRETER\", $$$_], $$$_)",
      "subprocess.$FUNC([\"$SHELL\", \"-c\", $$$_], $$$_)"
    ])) as $all
    | ( ((($all | of(["subprocess.$FUNC($$$_)"])
          | not_at($all | of(["subprocess.$FUNC(\"$$$_\", $$$_)"]))
          | not_at($all | of(["subprocess.$FUNC([\"$$$_\", $$$_], $$$_)"]))
          | outside($all | of(["$CMD = [\"$$$_\", $$$_]\n$$$_\nsubprocess.$FUNC($CMD, $$$_)"])))
          + ($all | of(["subprocess.$FUNC([\"$SHELL\", \"-c\", $$$_], $$$_)"])
          | where_capture("SHELL"; "^(sh|bash|ksh|csh|tcsh|zsh)$"))
          + ($all | of(["subprocess.$FUNC([\"$INTERPRETER\", $$$_], $$$_)"])
          | where_capture("INTERPRETER"; "^(python|python\\d)$"))))
          | reaching(((($all | of(["flask.request.form.get($$$_)","flask.request.form[$$$_]","flask.request.args.get($$$_)","flask.request.args[$$$_]","flask.request.values.get($$$_)","flask.request.values[$$$_]","flask.request.cookies.get($$$_)","flask.request.cookies[$$$_]","flask.request.stream","flask.request.headers.get($$$_)","flask.request.headers[$$$_]","flask.request.data","flask.request.full_path","flask.request.url","flask.request.json","flask.request.get_json()","flask.request.view_args.get($$$_)","flask.request.view_args[$$$_]"]))
          + ($all
          | within($all | of(["@$APP.route($ROUTE, $$$_)\ndef $FUNC($$$_, $ROUTEVAR, $$$_):\n  $$$_"]))
          | focus("ROUTEVAR"))));
              (($all | of(["$DICT[$KEY]"])
          | focus("KEY"))))
        | finding("subprocess-injection";
            "Detected user input entering a `subprocess` call unsafely.") ) )
| report
