# rules: tainted-sql-string
# languages: python
# from: python/flask/security/injection/tainted-sql-string.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "\"$SQLSTR\" % $$$_",
      "\"$SQLSTR\" + $$$_",
      "\"$SQLSTR\".format($$$_)",
      "$ROUTEVAR",
      "@$APP.route($$$_)\ndef $FUNC($$$_, $ROUTEVAR, $$$_):\n  $$$_",
      "f\"$SQLSTR{$$$_}$$$_\"",
      "flask.request.$ANYTHING"
    ])) as $all
    | ( (($all | of(["\"$SQLSTR\" + $$$_","\"$SQLSTR\" % $$$_","\"$SQLSTR\".format($$$_)","f\"$SQLSTR{$$$_}$$$_\""])
          | where_capture("SQLSTR"; "^(?:\\s*(?i)(select|delete|insert|create|update|alter|drop)\\b.*)")))
          | reaching(((($all | of(["flask.request.$ANYTHING"]))
          + ($all | of(["$ROUTEVAR"])
          | within($all | of(["@$APP.route($$$_)\ndef $FUNC($$$_, $ROUTEVAR, $$$_):\n  $$$_"])))));
              ([]))
        | finding("tainted-sql-string";
            "Detected user input used to manually construct a SQL string.") ) )
| report
