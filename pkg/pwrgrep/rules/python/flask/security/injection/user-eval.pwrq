# rules: eval-injection
# languages: python
# from: python/flask/security/injection/user-eval.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$INTERM = $PWRQDEEP1\n$$$_\neval($$$_, $PWRQDEEP2, $$$_)",
      "@$APP.route($ROUTE, $$$_)\ndef $FUNC($$$_, $ROUTEVAR, $$$_):\n  $$$_\n  $INTERM = $PWRQDEEP1\n  $$$_\n  eval($$$_, $PWRQDEEP2, $$$_)",
      "@$APP.route($ROUTE, $$$_)\ndef $FUNC($$$_, $ROUTEVAR, $$$_):\n  $$$_\n  eval($$$_, $PWRQDEEP1, $$$_)",
      "eval($$$_)",
      "eval($$$_, $PWRQDEEP1, $$$_)"
    ])) as $all
    | ( ($all | of(["eval($$$_)"])
          | at_same_place((($all
          | within($all | of(["@$APP.route($ROUTE, $$$_)\ndef $FUNC($$$_, $ROUTEVAR, $$$_):\n  $$$_\n  eval($$$_, $PWRQDEEP1, $$$_)"])
          | where_capture_ast("PWRQDEEP1"; "$ROUTEVAR")))
          + ($all
          | within($all | of(["@$APP.route($ROUTE, $$$_)\ndef $FUNC($$$_, $ROUTEVAR, $$$_):\n  $$$_\n  $INTERM = $PWRQDEEP1\n  $$$_\n  eval($$$_, $PWRQDEEP2, $$$_)"])
          | where_capture_ast("PWRQDEEP1"; "$ROUTEVAR")
          | where_capture_ast("PWRQDEEP2"; "$INTERM"))))))
          + ($all | of(["eval($$$_, $PWRQDEEP1, $$$_)"])
          | where_capture_ast("PWRQDEEP1"; "flask.request.$W.get($$$_)"))
          + ($all | of(["eval($$$_, $PWRQDEEP1, $$$_)"])
          | where_capture_ast("PWRQDEEP1"; "flask.request.$W[$$$_]"))
          + ($all | of(["eval($$$_, $PWRQDEEP1, $$$_)"])
          | where_capture_ast("PWRQDEEP1"; "flask.request.$W($$$_)"))
          + ($all | of(["eval($$$_, $PWRQDEEP1, $$$_)"])
          | where_capture_ast("PWRQDEEP1"; "flask.request.$W"))
          + ($all | of(["eval($$$_)"])
          | within($all | of(["$INTERM = $PWRQDEEP1\n$$$_\neval($$$_, $PWRQDEEP2, $$$_)"])
          | where_capture_ast("PWRQDEEP1"; "flask.request.$W.get($$$_)")
          | where_capture_ast("PWRQDEEP2"; "$INTERM")))
          + ($all | of(["eval($$$_)"])
          | within($all | of(["$INTERM = $PWRQDEEP1\n$$$_\neval($$$_, $PWRQDEEP2, $$$_)"])
          | where_capture_ast("PWRQDEEP1"; "flask.request.$W[$$$_]")
          | where_capture_ast("PWRQDEEP2"; "$INTERM")))
          + ($all | of(["eval($$$_)"])
          | within($all | of(["$INTERM = $PWRQDEEP1\n$$$_\neval($$$_, $PWRQDEEP2, $$$_)"])
          | where_capture_ast("PWRQDEEP1"; "flask.request.$W($$$_)")
          | where_capture_ast("PWRQDEEP2"; "$INTERM")))
          + ($all | of(["eval($$$_)"])
          | within($all | of(["$INTERM = $PWRQDEEP1\n$$$_\neval($$$_, $PWRQDEEP2, $$$_)"])
          | where_capture_ast("PWRQDEEP1"; "flask.request.$W")
          | where_capture_ast("PWRQDEEP2"; "$INTERM")))
        | finding("eval-injection";
            "Detected user data flowing into eval.") ) )
| report
