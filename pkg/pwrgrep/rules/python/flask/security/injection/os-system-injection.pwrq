# rules: os-system-injection
# languages: python
# from: python/flask/security/injection/os-system-injection.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$INTERM = $PWRQDEEP1\n$$$_\nos.system($PWRQDEEP2)",
      "@$APP.route($ROUTE, $$$_)\ndef $FUNC($$$_, $ROUTEVAR, $$$_):\n  $$$_\n  $INTERM = $PWRQDEEP1\n  $$$_\n  os.system($$$_, $PWRQDEEP2, $$$_)",
      "@$APP.route($ROUTE, $$$_)\ndef $FUNC($$$_, $ROUTEVAR, $$$_):\n  $$$_\n  os.system($$$_, $PWRQDEEP1, $$$_)",
      "os.system($$$_)",
      "os.system($$$_, $PWRQDEEP1, $$$_)"
    ])) as $all
    | ( ($all | of(["os.system($$$_)"])
          | at_same_place((($all
          | within($all | of(["@$APP.route($ROUTE, $$$_)\ndef $FUNC($$$_, $ROUTEVAR, $$$_):\n  $$$_\n  os.system($$$_, $PWRQDEEP1, $$$_)"])
          | where_capture_ast("PWRQDEEP1"; "$ROUTEVAR")))
          + ($all
          | within($all | of(["@$APP.route($ROUTE, $$$_)\ndef $FUNC($$$_, $ROUTEVAR, $$$_):\n  $$$_\n  $INTERM = $PWRQDEEP1\n  $$$_\n  os.system($$$_, $PWRQDEEP2, $$$_)"])
          | where_capture_ast("PWRQDEEP1"; "$ROUTEVAR")
          | where_capture_ast("PWRQDEEP2"; "$INTERM"))))))
          + ($all | of(["os.system($$$_, $PWRQDEEP1, $$$_)"])
          | where_capture_ast("PWRQDEEP1"; "flask.request.$W.get($$$_)"))
          + ($all | of(["os.system($$$_, $PWRQDEEP1, $$$_)"])
          | where_capture_ast("PWRQDEEP1"; "flask.request.$W[$$$_]"))
          + ($all | of(["os.system($$$_, $PWRQDEEP1, $$$_)"])
          | where_capture_ast("PWRQDEEP1"; "flask.request.$W($$$_)"))
          + ($all | of(["os.system($$$_, $PWRQDEEP1, $$$_)"])
          | where_capture_ast("PWRQDEEP1"; "flask.request.$W"))
          + ($all | of(["os.system($$$_)"])
          | within($all | of(["$INTERM = $PWRQDEEP1\n$$$_\nos.system($PWRQDEEP2)"])
          | where_capture_ast("PWRQDEEP1"; "flask.request.$W.get($$$_)")
          | where_capture_ast("PWRQDEEP2"; "$INTERM")))
          + ($all | of(["os.system($$$_)"])
          | within($all | of(["$INTERM = $PWRQDEEP1\n$$$_\nos.system($PWRQDEEP2)"])
          | where_capture_ast("PWRQDEEP1"; "flask.request.$W[$$$_]")
          | where_capture_ast("PWRQDEEP2"; "$INTERM")))
          + ($all | of(["os.system($$$_)"])
          | within($all | of(["$INTERM = $PWRQDEEP1\n$$$_\nos.system($PWRQDEEP2)"])
          | where_capture_ast("PWRQDEEP1"; "flask.request.$W($$$_)")
          | where_capture_ast("PWRQDEEP2"; "$INTERM")))
          + ($all | of(["os.system($$$_)"])
          | within($all | of(["$INTERM = $PWRQDEEP1\n$$$_\nos.system($PWRQDEEP2)"])
          | where_capture_ast("PWRQDEEP1"; "flask.request.$W")
          | where_capture_ast("PWRQDEEP2"; "$INTERM")))
        | finding("os-system-injection";
            "User data detected in os.system.") ) )
| report
