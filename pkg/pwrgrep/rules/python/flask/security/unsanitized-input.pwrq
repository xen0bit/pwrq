# rules: response-contains-unsanitized-input
# languages: python
# from: python/flask/security/unsanitized-input.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$X = flask.request.args.get($$$_)\n$$$_\nflask.make_response(\"$$$_\".format($X))",
      "$X = flask.request.args.get($$$_)\n$$$_\nflask.make_response(f\"$$$_{$X}\")",
      "$X = flask.request.args.get($$$_)\n$$$_\nflask.make_response(f\"$$$_{$X}$$$_\")",
      "$X = flask.request.args.get($$$_)\n$$$_\nflask.make_response(f\"{$X}$$$_\")"
    ])) as $all
    | ( $all | of(["$X = flask.request.args.get($$$_)\n$$$_\nflask.make_response(\"$$$_\".format($X))","$X = flask.request.args.get($$$_)\n$$$_\nflask.make_response(f\"$$$_{$X}$$$_\")","$X = flask.request.args.get($$$_)\n$$$_\nflask.make_response(f\"$$$_{$X}\")","$X = flask.request.args.get($$$_)\n$$$_\nflask.make_response(f\"{$X}$$$_\")"])
        | finding("response-contains-unsanitized-input";
            "Flask response reflects unsanitized user input.") ) )
| report
