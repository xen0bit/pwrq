# rules: flask-cache-query-string
# languages: python
# from: python/flask/caching/query-string.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "@app.route(\"$$$_\")\n@cache.cached($$$_)\ndef $HANDLER($$$_):\n  $$$_\n  request.args.get($$$_)",
      "@app.route(\"$$$_\")\n@cache.cached($$$_, query_string=True)\ndef $HANDLER($$$_):\n  $$$_\n  request.args.get($$$_)",
      "@app.route(\"$$$_\", methods=[$$$_, \"DELETE\", $$$_])\n@cache.cached($$$_)\ndef $HANDLER($$$_):\n  $$$_",
      "@app.route(\"$$$_\", methods=[$$$_, \"PATCH\", $$$_])\n@cache.cached($$$_)\ndef $HANDLER($$$_):\n  $$$_",
      "@app.route(\"$$$_\", methods=[$$$_, \"POST\", $$$_])\n@cache.cached($$$_)\ndef $HANDLER($$$_):\n  $$$_",
      "@app.route(\"$$$_\", methods=[$$$_, \"PUT\", $$$_])\n@cache.cached($$$_)\ndef $HANDLER($$$_):\n  $$$_"
    ])) as $all
    | ( $all | of(["@app.route(\"$$$_\")\n@cache.cached($$$_)\ndef $HANDLER($$$_):\n  $$$_\n  request.args.get($$$_)","@app.route(\"$$$_\", methods=[$$$_, \"POST\", $$$_])\n@cache.cached($$$_)\ndef $HANDLER($$$_):\n  $$$_","@app.route(\"$$$_\", methods=[$$$_, \"PUT\", $$$_])\n@cache.cached($$$_)\ndef $HANDLER($$$_):\n  $$$_","@app.route(\"$$$_\", methods=[$$$_, \"DELETE\", $$$_])\n@cache.cached($$$_)\ndef $HANDLER($$$_):\n  $$$_","@app.route(\"$$$_\", methods=[$$$_, \"PATCH\", $$$_])\n@cache.cached($$$_)\ndef $HANDLER($$$_):\n  $$$_"])
          | not_at($all | of(["@app.route(\"$$$_\")\n@cache.cached($$$_, query_string=True)\ndef $HANDLER($$$_):\n  $$$_\n  request.args.get($$$_)"]))
        | finding("flask-cache-query-string";
            "Flask-caching doesn't cache query strings by default.") ) )
| report
