# rules: flask-deprecated-apis
# from: python/flask/maintainability/deprecated/deprecated-apis.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$F = Flask($$$_)\n$$$_\n$F.init_jinja_globals($$$_)",
      "$F = Flask($$$_)\n$$$_\n$F.make_null_session($$$_)",
      "$F = Flask($$$_)\n$$$_\n$F.open_session($$$_)",
      "$F = Flask($$$_)\n$$$_\n$F.request_globals_class($$$_)",
      "$F = Flask($$$_)\n$$$_\n$F.save_session($$$_)",
      "$F = Flask($$$_)\n$$$_\n$F.static_path($$$_)",
      "app.config.from_json($$$_)",
      "app.init_jinja_globals($$$_)",
      "app.make_null_session($$$_)",
      "app.open_session($$$_)",
      "app.request_globals_class($$$_)",
      "app.save_session($$$_)",
      "app.static_path($$$_)",
      "flask.json_available",
      "flask.request.module",
      "flask.testing.make_test_environ_builder($$$_)"
    ])) as $all
    | ( $all | of(["$F = Flask($$$_)\n$$$_\n$F.open_session($$$_)","$F = Flask($$$_)\n$$$_\n$F.save_session($$$_)","$F = Flask($$$_)\n$$$_\n$F.make_null_session($$$_)","$F = Flask($$$_)\n$$$_\n$F.init_jinja_globals($$$_)","$F = Flask($$$_)\n$$$_\n$F.request_globals_class($$$_)","$F = Flask($$$_)\n$$$_\n$F.static_path($$$_)","app.open_session($$$_)","app.save_session($$$_)","app.make_null_session($$$_)","app.init_jinja_globals($$$_)","app.request_globals_class($$$_)","app.static_path($$$_)","app.config.from_json($$$_)","flask.json_available","flask.request.module","flask.testing.make_test_environ_builder($$$_)"])
        | finding("flask-deprecated-apis";
            "deprecated Flask API") ) )
| report
