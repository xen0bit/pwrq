# rules: flask-class-method-get-side-effects
# languages: python
# from: python/flask/best-practice/get-class-method-with-side-effects.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "def get(self,$$$_):\n    $$$_\n    $METHOD($$$_)",
      "def get(self,$$$_):\n    $$$_\n    $VAR = $METHOD($$$_)"
    ])) as $all
    | ( $all | of(["def get(self,$$$_):\n    $$$_\n    $METHOD($$$_)","def get(self,$$$_):\n    $$$_\n    $VAR = $METHOD($$$_)"])
          | where_capture("METHOD"; "^(?:(?i)(create|update|delete).*)")
        | finding("flask-class-method-get-side-effects";
            "Flask class method GET with side effects") ) )
| report
