# rules: use-jsonify
# languages: python
# from: python/flask/best-practice/use-jsonify.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$DATA = json.dumps($$$VAR)\n$$$_\nreturn $DATA",
      "$JSONDUMPS",
      "@app.route($$$_)\ndef $X():\n  $$$_",
      "return json.dumps($$$VAR)"
    ])) as $all
    | ( $all | of(["$JSONDUMPS"])
          | at_same_place((($all
          | within($all | of(["return json.dumps($$$VAR)"])))
          + ($all
          | within($all | of(["$DATA = json.dumps($$$VAR)\n$$$_\nreturn $DATA"])))))
          | within($all | of(["@app.route($$$_)\ndef $X():\n  $$$_"]))
          | where_capture_ast("JSONDUMPS"; "json.dumps($$$VAR)")
          | focus("JSONDUMPS")
        | finding("use-jsonify";
            "flask.jsonify() is a Flask helper method which handles the correct settings for returning JSON from Flask routes") ) )
| report
