# rules: absolute-urls
# from: apex/lang/best-practice/ncino/urls/AbsoluteUrls.yaml

. as $root
| ( ($root | scan_regex(["*.cls"]; [
      "\\(http\\|https\\):\\/\\/\\.\\*\\(salesforce\\|force\\|visualforce\\)\\\\\\.com\\\\\\.\\*"
    ])) as $all
    | ( $all | of(["\\(http\\|https\\):\\/\\/\\.\\*\\(salesforce\\|force\\|visualforce\\)\\\\\\.com\\\\\\.\\*"])
        | finding("absolute-urls";
            "Using absolute URLs to Salesforce Pages is bug prone.") ) )
| report
