# rules: avoid-native-dml-in-loops
# from: apex/lang/performance/ncino/operationsInLoops/AvoidNativeDmlInLoops.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "Database\\.delete\\((?P<DATA>\\S+)\\);",
      "Database\\.insert\\((?P<DATA>\\S+)\\);",
      "Database\\.update\\((?P<DATA>\\S+)\\);",
      "Database\\.upsert\\((?P<DATA>\\S+)\\);",
      "delete\\s+(?P<DATA>\\S+);",
      "do\\s+\\{\\s+[\\s\\S]*?\\s+\\}\\s+while\\s+\\([\\s\\S]*?\\);",
      "for\\s+\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}",
      "insert\\s+(?P<DATA>\\S+);",
      "update\\s+(?P<DATA>\\S+);",
      "upsert\\s+(?P<DATA>\\S+);",
      "while\\s+\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}"
    ])) as $all
    | ( ($all
          | within($all | of(["for\\s+\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}"])))
          + ($all
          | within($all | of(["while\\s+\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}"])))
          + ($all
          | within($all | of(["do\\s+\\{\\s+[\\s\\S]*?\\s+\\}\\s+while\\s+\\([\\s\\S]*?\\);"])))
          | at_same_place(($all | of(["insert\\s+(?P<DATA>\\S+);","update\\s+(?P<DATA>\\S+);","upsert\\s+(?P<DATA>\\S+);","delete\\s+(?P<DATA>\\S+);","Database\\.insert\\((?P<DATA>\\S+)\\);","Database\\.update\\((?P<DATA>\\S+)\\);","Database\\.upsert\\((?P<DATA>\\S+)\\);","Database\\.delete\\((?P<DATA>\\S+)\\);"])))
        | finding("avoid-native-dml-in-loops";
            "Avoid DML statements inside loops to avoid hitting the DML governor limit.") ) )
| report
