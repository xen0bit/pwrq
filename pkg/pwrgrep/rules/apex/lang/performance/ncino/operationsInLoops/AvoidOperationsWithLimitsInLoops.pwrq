# rules: avoid-operations-with-limits-in-loops
# from: apex/lang/performance/ncino/operationsInLoops/AvoidOperationsWithLimitsInLoops.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "Approval\\.ProcessSubmitRequest\\s+(?P<REQUEST>\\S+)\\s+=\\s+new\\s+Approval\\.ProcessSubmitRequest\\(\\);",
      "Messaging\\.sendEmail\\([\\s\\S]*?\\);",
      "System\\.enqueueJob\\([\\s\\S]*?\\);",
      "System\\.scheduleBatch\\([\\s\\S]*?\\);",
      "System\\.schedule\\([\\s\\S]*?\\);",
      "do\\s+\\{\\s+[\\s\\S]*?\\s+\\}\\s+while\\s+\\([\\s\\S]*?\\);",
      "for\\s+\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}",
      "while\\s+\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}"
    ])) as $all
    | ( ($all
          | within($all | of(["for\\s+\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}"])))
          + ($all
          | within($all | of(["while\\s+\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}"])))
          + ($all
          | within($all | of(["do\\s+\\{\\s+[\\s\\S]*?\\s+\\}\\s+while\\s+\\([\\s\\S]*?\\);"])))
          | at_same_place(($all | of(["Messaging\\.sendEmail\\([\\s\\S]*?\\);","Approval\\.ProcessSubmitRequest\\s+(?P<REQUEST>\\S+)\\s+=\\s+new\\s+Approval\\.ProcessSubmitRequest\\(\\);","System\\.enqueueJob\\([\\s\\S]*?\\);","System\\.schedule\\([\\s\\S]*?\\);","System\\.scheduleBatch\\([\\s\\S]*?\\);"])))
        | finding("avoid-operations-with-limits-in-loops";
            "Database class methods, DML operations, SOQL queries, SOSL queries, Approval class methods, Email sending, async scheduling or queueing within loops can cause governor limit exceptions.") ) )
| report
