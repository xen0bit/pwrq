# rules: soql-injection-unescaped-url-param
# languages: apex
# from: apex/lang/security/ncino/injection/ApexSOQLInjectionFromUnescapedURLParam.yaml

. as $root
| ( ($root | scan_ast(["*.cls"]; [
      "ApexPage.getCurrentPage().getParameters.get($URLPARAM);",
      "Database.query($SINK,$$$_);",
      "String.escapeSingleQuotes($$$_)"
    ])) as $all
    | ( (($all | of(["Database.query($SINK,$$$_);"])
          | focus("SINK")))
          | reaching((($all | of(["ApexPage.getCurrentPage().getParameters.get($URLPARAM);"])));
              (($all | of(["String.escapeSingleQuotes($$$_)"]))))
        | finding("soql-injection-unescaped-url-param";
            "If a dynamic query must be used,leverage nFORCE Query Builder.") ) )
| report
