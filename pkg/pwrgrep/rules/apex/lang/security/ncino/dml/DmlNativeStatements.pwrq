# rules: dml-native-statements
# from: apex/lang/security/ncino/dml/DmlNativeStatements.yaml

. as $root
| ( ($root | scan_regex(["*.cls"]; [
      "\\(insert\\|upsert\\|update\\|delete\\)\\[\\(\\]",
      "\\(insert\\|upsert\\|update\\|delete\\)\\[\\\\s\\]",
      "\\.\\*\\[=\\]\\.\\*\\(insert\\|upsert\\|update\\|delete\\)\\.\\*\\[,;\\]",
      "\\[\\\\\\/\\\\\\/\\]\\.\\*\\(insert\\|upsert\\|update\\|delete\\)\\.\\*",
      "\\[\\\\\\/\\\\\\/\\]\\.\\*\\(insert\\|upsert\\|update\\|delete\\)\\[\\\\n\\]"
    ])) as $all
    | ( $all | of(["\\(insert\\|upsert\\|update\\|delete\\)\\[\\\\s\\]","\\(insert\\|upsert\\|update\\|delete\\)\\[\\(\\]"])
          | not_at($all | of(["\\[\\\\\\/\\\\\\/\\]\\.\\*\\(insert\\|upsert\\|update\\|delete\\)\\.\\*"]))
          | not_at($all | of(["\\[\\\\\\/\\\\\\/\\]\\.\\*\\(insert\\|upsert\\|update\\|delete\\)\\[\\\\n\\]"]))
          | not_at($all | of(["\\.\\*\\[=\\]\\.\\*\\(insert\\|upsert\\|update\\|delete\\)\\.\\*\\[,;\\]"]))
        | finding("dml-native-statements";
            "Native Salesforce DML operations execute in system context, ignoring the current user's permissions, field-level security, organization-wide defaults, position in the role hierarchy, and sharing rules.") ) )
| report
