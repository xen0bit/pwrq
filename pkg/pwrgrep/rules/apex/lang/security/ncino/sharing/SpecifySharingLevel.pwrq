# rules: specify-sharing-level
# from: apex/lang/security/ncino/sharing/SpecifySharingLevel.yaml

. as $root
| ( ($root | scan_regex(["*.cls"]; [
      "\\(private\\|public\\|global\\)\\.\\*\\[with\\|without\\|inherited\\]\\\\s\\[sharing\\]\\.\\*\\\\s\\(class\\)\\\\s\\.\\*\\[\\{\\]",
      "\\(private\\|public\\|global\\)\\.\\*\\\\s\\(class\\)\\\\s\\.\\*\\(extends\\)\\\\s\\(Exception\\)\\.\\*\\[\\{\\]",
      "\\(private\\|public\\|global\\)\\.\\*\\\\s\\(class\\)\\\\s\\.\\*\\[\\{\\]"
    ])) as $all
    | ( $all | of(["\\(private\\|public\\|global\\)\\.\\*\\\\s\\(class\\)\\\\s\\.\\*\\[\\{\\]"])
          | not_at($all | of(["\\(private\\|public\\|global\\)\\.\\*\\[with\\|without\\|inherited\\]\\\\s\\[sharing\\]\\.\\*\\\\s\\(class\\)\\\\s\\.\\*\\[\\{\\]"]))
          | not_at($all | of(["\\(private\\|public\\|global\\)\\.\\*\\\\s\\(class\\)\\\\s\\.\\*\\(extends\\)\\\\s\\(Exception\\)\\.\\*\\[\\{\\]"]))
        | finding("specify-sharing-level";
            "Every Apex class should have an explicit sharing mode declared.") ) )
| report
