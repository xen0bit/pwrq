# rules: insecure-http-request
# from: apex/lang/security/ncino/endpoints/InsecureHttpRequest.yaml

. as $root
| ( ($root | scan_regex(["*.cls"]; [
      "\\/\\/\\.\\*",
      "\\[\\*\\]\\.\\*",
      "http\\[:\\]\\[\\/\\]\\[\\/\\]"
    ])) as $all
    | ( $all | of(["http\\[:\\]\\[\\/\\]\\[\\/\\]"])
          | not_at($all | of(["\\/\\/\\.\\*"]))
          | not_at($all | of(["\\[\\*\\]\\.\\*"]))
        | finding("insecure-http-request";
            "The software transmits sensitive or security-critical data in cleartext in a communication channel that can be sniffed by unauthorized actors.") ) )
| report
