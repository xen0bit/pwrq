# rules: named-credentials-string-match
# from: apex/lang/security/ncino/endpoints/NamedCredentialsStringMatch.yaml

. as $root
| ( ($root | scan_ast(["*.cls"]; [
      "$REQUEST.setHeader('Authorization', $AUTHSTRING);"
    ])) as $all
    | ( $all | of(["$REQUEST.setHeader('Authorization', $AUTHSTRING);"])
        | finding("named-credentials-string-match";
            "Named Credentials (and callout endpoints) should be used instead of hard-coding credentials.") ) )
| report
