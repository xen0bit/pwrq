# rules: plaintext-http-link
# from: html/security/plaintext-http-link.yaml

. as $root
| ( ($root | scan_ast(["*.html"]; [
      "<a href=\"$URL\">$$$_</a>"
    ])) as $all
    | ( $all | of(["<a href=\"$URL\">$$$_</a>"])
          | where_capture("URL"; "^(?i)http://")
        | finding("plaintext-http-link";
            "This link points to a plaintext HTTP URL.") ) )
| report
