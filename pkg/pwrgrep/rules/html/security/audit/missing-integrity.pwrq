# rules: missing-integrity
# from: html/security/audit/missing-integrity.yaml

. as $root
| ( ($root | scan_regex(["*.html"]; [
      "<link\\s+(?P<A>[\\s\\S]*?)\\s+>",
      "<script\\s+(?P<A>[\\s\\S]*?)\\s+>[\\s\\S]*?<\\/script>"
    ])) as $all
    | ( $all | of(["<script\\s+(?P<A>[\\s\\S]*?)\\s+>[\\s\\S]*?<\\/script>","<link\\s+(?P<A>[\\s\\S]*?)\\s+>"])
        | finding("missing-integrity";
            "This tag is missing an 'integrity' subresource integrity attribute.") ) )
| report
