# rules: insecure-document-method
# from: html/security/audit/insecure-document-method.yaml

. as $root
| ( ($root | scan_regex(["*.html"]; [
      "<script\\s+[\\s\\S]*?>(?P<A>[\\s\\S]*?)<\\/script>"
    ])) as $all
    | ( $all
          | within($all | of(["<script\\s+[\\s\\S]*?>(?P<A>[\\s\\S]*?)<\\/script>"]))
        | finding("insecure-document-method";
            "Detected the use of an inner/outerHTML assignment.") ) )
| report
