# rules: eval-detected
# from: html/security/audit/eval-detected.yaml

. as $root
| ( ($root | scan_regex(["*.html"]; [
      "<script\\s+[\\s\\S]*?>(?P<A>[\\s\\S]*?)<\\/script>"
    ])) as $all
    | ( $all
          | within($all | of(["<script\\s+[\\s\\S]*?>(?P<A>[\\s\\S]*?)<\\/script>"]))
        | finding("eval-detected";
            "Detected the use of eval(...).") ) )
| report
