# rules: robots-denied
# from: html/best-practice/robots-denied.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "<META\\s+NAME=\"ROBOTS\"\\s+[\\s\\S]*?>",
      "<meta\\s+name=\"robots\"\\s+[\\s\\S]*?>"
    ])) as $all
    | ( $all | of(["<meta\\s+name=\"robots\"\\s+[\\s\\S]*?>","<META\\s+NAME=\"ROBOTS\"\\s+[\\s\\S]*?>"])
        | finding("robots-denied";
            "This page denies crawlers from indexing the page.") ) )
| report
