# rules: atom_exhaustion
# languages: elixir
# from: elixir/lang/correctness/atom-exhaustion.yaml

. as $root
| ( ($root | scan_ast(["*.ex"]; [
      "$MODULE.to_atom($STRING)"
    ])) as $all
    | ( $all | of(["$MODULE.to_atom($STRING)"])
          | where_capture("MODULE"; "^(String|List)$")
        | finding("atom_exhaustion";
            "Atom values are appended to a global table but never removed.") ) )
| report
