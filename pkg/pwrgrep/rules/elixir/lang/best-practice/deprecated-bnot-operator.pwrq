# rules: deprecated_bnot_operator
# languages: elixir
# from: elixir/lang/best-practice/deprecated-bnot-operator.yaml

. as $root
| ( ($root | scan_ast(["*.ex"]; [
      "~~~$VAL"
    ])) as $all
    | ( $all | of(["~~~$VAL"])
        | finding("deprecated_bnot_operator";
            "The bitwise operator (`^^^`) is already deprecated.") ) )
| report
