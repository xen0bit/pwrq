# rules: spring-http-request
# languages: java
# from: problem-based-packs/insecure-transport/java-spring/spring-http-request.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "$RESTTEMP = new RestTemplate($$$_);\n$$$_\n$RESTTEMP.$FUNC(\"=~/[hH][tT][tT][pP]://.*/\", $$$_);",
      "$RESTTEMP = new RestTemplate($$$_);\n$$$_\n$URL = new URI($$$_, \"=~/[hH][tT][tT][pP]://.*/\", $$$_);\n$$$_\n$RESTTEMP.$FUNC($URL, $$$_);",
      "$RESTTEMP = new RestTemplate($$$_);\n$$$_\nString $URL = \"=~/[hH][tT][tT][pP]://.*/\";\n$$$_\n$RESTTEMP.$FUNC($URL, $$$_);"
    ])) as $all
    | ( $all | of(["$RESTTEMP = new RestTemplate($$$_);\n$$$_\n$RESTTEMP.$FUNC(\"=~/[hH][tT][tT][pP]://.*/\", $$$_);","$RESTTEMP = new RestTemplate($$$_);\n$$$_\nString $URL = \"=~/[hH][tT][tT][pP]://.*/\";\n$$$_\n$RESTTEMP.$FUNC($URL, $$$_);","$RESTTEMP = new RestTemplate($$$_);\n$$$_\n$URL = new URI($$$_, \"=~/[hH][tT][tT][pP]://.*/\", $$$_);\n$$$_\n$RESTTEMP.$FUNC($URL, $$$_);"])
          | where_capture("FUNC"; "^(?:(delete|doExecute|exchange|getForEntity|getForObject|headForHeaders|optionsForAllow|patchForObject|postForEntity|postForLocation|postForObject|put))")
        | finding("spring-http-request";
            "Checks for requests sent via Java Spring RestTemplate API to http:// URLS.") ) )
| report
