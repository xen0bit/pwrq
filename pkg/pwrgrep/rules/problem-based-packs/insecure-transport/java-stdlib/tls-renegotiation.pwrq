# rules: tls-renegotiation
# from: problem-based-packs/insecure-transport/java-stdlib/tls-renegotiation.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "java.lang.System.setProperty(\"sun.security.ssl.allowUnsafeRenegotiation\", true);"
    ])) as $all
    | ( $all | of(["java.lang.System.setProperty(\"sun.security.ssl.allowUnsafeRenegotiation\", true);"])
        | finding("tls-renegotiation";
            "Checks for cases where java applications are allowing unsafe renegotiation.") ) )
| report
