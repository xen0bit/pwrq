# rules: httpclient-http-request
# languages: java
# from: problem-based-packs/insecure-transport/java-stdlib/httpclient-http-request.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "HttpClient $CLIENT = $$$_;\n$$$_\nHttpRequest $REQ = $$$_;\n$$$_\n$CLIENT.send($$$_);",
      "HttpClient $CLIENT = $$$_;\n$$$_\nHttpRequest $REQ = $$$_;\n$$$_\n$CLIENT.sendAsync($$$_);",
      "String $URI = \"=~/[hH][tT][tT][pP]://.*/\";\n$$$_\nHttpClient $CLIENT = $$$_;\n$$$_\nHttpRequest $REQ = $$$_;\n$$$_\n$CLIENT.send($$$_);",
      "String $URI = \"=~/[hH][tT][tT][pP]://.*/\";\n$$$_\nHttpClient $CLIENT = $$$_;\n$$$_\nHttpRequest $REQ = $$$_;\n$$$_\n$CLIENT.sendAsync($$$_);",
      "URI.create(\"=~/[hH][tT][tT][pP]://.*/\", $$$_)",
      "URI.create($URI)"
    ])) as $all
    | ( ($all | of(["URI.create(\"=~/[hH][tT][tT][pP]://.*/\", $$$_)"])
          | within($all | of(["HttpClient $CLIENT = $$$_;\n$$$_\nHttpRequest $REQ = $$$_;\n$$$_\n$CLIENT.sendAsync($$$_);"])))
          + ($all | of(["URI.create(\"=~/[hH][tT][tT][pP]://.*/\", $$$_)"])
          | within($all | of(["HttpClient $CLIENT = $$$_;\n$$$_\nHttpRequest $REQ = $$$_;\n$$$_\n$CLIENT.send($$$_);"])))
          + ($all | of(["URI.create($URI)"])
          | within($all | of(["String $URI = \"=~/[hH][tT][tT][pP]://.*/\";\n$$$_\nHttpClient $CLIENT = $$$_;\n$$$_\nHttpRequest $REQ = $$$_;\n$$$_\n$CLIENT.send($$$_);"])))
          + ($all | of(["URI.create($URI)"])
          | within($all | of(["String $URI = \"=~/[hH][tT][tT][pP]://.*/\";\n$$$_\nHttpClient $CLIENT = $$$_;\n$$$_\nHttpRequest $REQ = $$$_;\n$$$_\n$CLIENT.sendAsync($$$_);"])))
        | finding("httpclient-http-request";
            "Checks for requests sent via HttpClient to http:// URLS.") ) )
| report
