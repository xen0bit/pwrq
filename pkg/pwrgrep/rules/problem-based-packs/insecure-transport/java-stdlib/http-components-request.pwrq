# rules: http-components-request
# languages: java
# from: problem-based-packs/insecure-transport/java-stdlib/http-components-request.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "$HTTPCLIENT = HttpClients.$CREATE($$$_);\n$$$_\n$HTTPREQ = new $HTTPFUNC(\"=~/[hH][tT][tT][pP]://.*/\");\n$$$_\n$RESPONSE = $HTTPCLIENT.execute($HTTPREQ);",
      "$HTTPCLIENT = HttpClients.$CREATE($$$_);\n$$$_\n$RESPONSE = $HTTPCLIENT.execute(new $HTTPFUNC(\"=~/[hH][tT][tT][pP]://.*/\"));"
    ])) as $all
    | ( $all | of(["$HTTPCLIENT = HttpClients.$CREATE($$$_);\n$$$_\n$HTTPREQ = new $HTTPFUNC(\"=~/[hH][tT][tT][pP]://.*/\");\n$$$_\n$RESPONSE = $HTTPCLIENT.execute($HTTPREQ);","$HTTPCLIENT = HttpClients.$CREATE($$$_);\n$$$_\n$RESPONSE = $HTTPCLIENT.execute(new $HTTPFUNC(\"=~/[hH][tT][tT][pP]://.*/\"));"])
        | finding("http-components-request";
            "Checks for requests sent via Apache HTTP Components to http:// URLS.") ) )
| report
