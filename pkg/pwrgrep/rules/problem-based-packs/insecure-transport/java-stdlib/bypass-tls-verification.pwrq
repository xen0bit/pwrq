# rules: bypass-tls-verification
# from: problem-based-packs/insecure-transport/java-stdlib/bypass-tls-verification.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "new X509TrustManager() {\n  $$$_\n  public void checkClientTrusted(X509Certificate[] certs, String authType) {$$$_}\n  $$$_\n}",
      "new X509TrustManager() {\n  $$$_\n  public void checkServerTrusted(X509Certificate[] certs, String authType) {\n    $$$_\n    throw new CertificateException($$$_);\n    $$$_\n  }\n  $$$_\n}",
      "new X509TrustManager() {\n  $$$_\n  public void checkServerTrusted(X509Certificate[] certs, String authType) {\n    $$$_\n    throw new IllegalArgumentException($$$_);\n    $$$_\n  }\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["new X509TrustManager() {\n  $$$_\n  public void checkClientTrusted(X509Certificate[] certs, String authType) {$$$_}\n  $$$_\n}"])
          | not_at($all | of(["new X509TrustManager() {\n  $$$_\n  public void checkServerTrusted(X509Certificate[] certs, String authType) {\n    $$$_\n    throw new CertificateException($$$_);\n    $$$_\n  }\n  $$$_\n}"]))
          | not_at($all | of(["new X509TrustManager() {\n  $$$_\n  public void checkServerTrusted(X509Certificate[] certs, String authType) {\n    $$$_\n    throw new IllegalArgumentException($$$_);\n    $$$_\n  }\n  $$$_\n}"]))
        | finding("bypass-tls-verification";
            "Checks for redefinitions of the checkServerTrusted function in the X509TrustManager class that disables TLS/SSL certificate verification.") ) )
| report
