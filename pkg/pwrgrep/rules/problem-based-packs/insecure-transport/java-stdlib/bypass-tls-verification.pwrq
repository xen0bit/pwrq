# rules: bypass-tls-verification
# from: problem-based-packs/insecure-transport/java-stdlib/bypass-tls-verification.yaml

. as $root
| ( ($root | scan_regex(["*.java"]; [
      "new\\s+X509TrustManager\\(\\)\\s+\\{\\s+[\\s\\S]*?\\s+public\\s+void\\s+checkClientTrusted\\(X509Certificate\\[\\]\\s+certs,\\s+String\\s+authType\\)\\s+\\{[\\s\\S]*?\\}\\s+[\\s\\S]*?\\s+\\}",
      "new\\s+X509TrustManager\\(\\)\\s+\\{\\s+[\\s\\S]*?\\s+public\\s+void\\s+checkServerTrusted\\(X509Certificate\\[\\]\\s+certs,\\s+String\\s+authType\\)\\s+\\{\\s+[\\s\\S]*?\\s+throw\\s+new\\s+CertificateException\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}",
      "new\\s+X509TrustManager\\(\\)\\s+\\{\\s+[\\s\\S]*?\\s+public\\s+void\\s+checkServerTrusted\\(X509Certificate\\[\\]\\s+certs,\\s+String\\s+authType\\)\\s+\\{\\s+[\\s\\S]*?\\s+throw\\s+new\\s+IllegalArgumentException\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}"
    ])) as $all
    | ( $all | of(["new\\s+X509TrustManager\\(\\)\\s+\\{\\s+[\\s\\S]*?\\s+public\\s+void\\s+checkClientTrusted\\(X509Certificate\\[\\]\\s+certs,\\s+String\\s+authType\\)\\s+\\{[\\s\\S]*?\\}\\s+[\\s\\S]*?\\s+\\}"])
          | not_at($all | of(["new\\s+X509TrustManager\\(\\)\\s+\\{\\s+[\\s\\S]*?\\s+public\\s+void\\s+checkServerTrusted\\(X509Certificate\\[\\]\\s+certs,\\s+String\\s+authType\\)\\s+\\{\\s+[\\s\\S]*?\\s+throw\\s+new\\s+CertificateException\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}"]))
          | not_at($all | of(["new\\s+X509TrustManager\\(\\)\\s+\\{\\s+[\\s\\S]*?\\s+public\\s+void\\s+checkServerTrusted\\(X509Certificate\\[\\]\\s+certs,\\s+String\\s+authType\\)\\s+\\{\\s+[\\s\\S]*?\\s+throw\\s+new\\s+IllegalArgumentException\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}"]))
        | finding("bypass-tls-verification";
            "Checks for redefinitions of the checkServerTrusted function in the X509TrustManager class that disables TLS/SSL certificate verification.") ) )
| report
