# rules: sling-http-request
# from: problem-based-packs/insecure-transport/go-stdlib/sling-http-request.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "$REQ = sling.New()\n$$$_\n$RES = $$$_",
      "$REQ = sling.New()\n$$$_\n$URL = \"=~/[hH][tT][tT][pP]://.*/\"\n$$$_\n$RES = $$$_",
      "$REQ.$FUNC(\"=~/[hH][tT][tT][pP]://.*/\")",
      "$REQ.$FUNC($URL)",
      "$URL = \"=~/[hH][tT][tT][pP]://.*/\"\n$$$_\n$RES = $$$_",
      "sling.New().$FUNC(\"=~/[hH][tT][tT][pP]://.*/\")",
      "sling.New().$FUNC($URL)"
    ])) as $all
    | ( ($all | of(["$REQ.$FUNC(\"=~/[hH][tT][tT][pP]://.*/\")"])
          | within($all | of(["$REQ = sling.New()\n$$$_\n$RES = $$$_"]))
          | where_capture("FUNC"; "(Get|Post|Delete|Head|Put|Options|Patch|Base|Connect)"))
          + ($all | of(["sling.New().$FUNC(\"=~/[hH][tT][tT][pP]://.*/\")"])
          | where_capture("FUNC"; "(Get|Post|Delete|Head|Put|Options|Patch|Base|Connect)"))
          + ($all | of(["$REQ.$FUNC($URL)"])
          | within($all | of(["$REQ = sling.New()\n$$$_\n$URL = \"=~/[hH][tT][tT][pP]://.*/\"\n$$$_\n$RES = $$$_"]))
          | where_capture("FUNC"; "(Get|Post|Delete|Head|Put|Options|Patch|Base|Connect)"))
          + ($all | of(["sling.New().$FUNC($URL)"])
          | within($all | of(["$URL = \"=~/[hH][tT][tT][pP]://.*/\"\n$$$_\n$RES = $$$_"]))
          | where_capture("FUNC"; "(Get|Post|Delete|Head|Put|Options|Patch|Base|Connect)"))
        | finding("sling-http-request";
            "Checks for requests to http (unencrypted) sites using gorequest, a popular HTTP client library.") ) )
| report
