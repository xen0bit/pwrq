# rules: disallow-old-tls-versions
# from: problem-based-packs/insecure-transport/go-stdlib/disallow-old-tls-versions.yaml

. as $root
| ( ($root | scan_regex(["*.go"]; [
      "(?P<CONFIG>\\S+)\\s+=\\s+&tls\\.Config\\{[\\s\\S]*?\\}\\s+[\\s\\S]*?\\s+(?P<CONFIG>\\S+)\\.MinVersion\\s+=\\s+(?P<TLS>\\S+)\\.(?P<VERSION>\\S+)",
      "tls\\.Config\\{[\\s\\S]*?,\\s+MinVersion:\\s+(?P<TLS>\\S+)\\.(?P<VERSION>\\S+),\\s+[\\s\\S]*?\\}"
    ])) as $all
    | ( $all | of(["tls\\.Config\\{[\\s\\S]*?,\\s+MinVersion:\\s+(?P<TLS>\\S+)\\.(?P<VERSION>\\S+),\\s+[\\s\\S]*?\\}","(?P<CONFIG>\\S+)\\s+=\\s+&tls\\.Config\\{[\\s\\S]*?\\}\\s+[\\s\\S]*?\\s+(?P<CONFIG>\\S+)\\.MinVersion\\s+=\\s+(?P<TLS>\\S+)\\.(?P<VERSION>\\S+)"])
          | where_capture("VERSION"; "^(?:(VersionTLS10|VersionTLS11|VersionSSL30))")
        | finding("disallow-old-tls-versions";
            "Detects creations of tls configuration objects with an insecure MinVersion of TLS.") ) )
| report
