# rules: ftp-request
# from: problem-based-packs/insecure-transport/go-stdlib/ftp-request.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "$URL = \"=~/^[fF][tT][pP]://.*/\"\n$$$_\nftp.Connect($URL)",
      "$URL = \"=~/^[fF][tT][pP]://.*/\"\n$$$_\nftp.Dial($URL, $$$_)",
      "$URL = \"=~/^[fF][tT][pP]://.*/\"\n$$$_\nftp.DialTimeout($URL, $$$_)",
      "ftp.Connect(\"=~/^[fF][tT][pP]://.*/\")",
      "ftp.Dial(\"=~/^[fF][tT][pP]://.*/\", $$$_)",
      "ftp.DialTimeout(\"=~/^[fF][tT][pP]://.*/\", $$$_)"
    ])) as $all
    | ( $all | of(["ftp.Dial(\"=~/^[fF][tT][pP]://.*/\", $$$_)","ftp.DialTimeout(\"=~/^[fF][tT][pP]://.*/\", $$$_)","ftp.Connect(\"=~/^[fF][tT][pP]://.*/\")","$URL = \"=~/^[fF][tT][pP]://.*/\"\n$$$_\nftp.Dial($URL, $$$_)","$URL = \"=~/^[fF][tT][pP]://.*/\"\n$$$_\nftp.DialTimeout($URL, $$$_)","$URL = \"=~/^[fF][tT][pP]://.*/\"\n$$$_\nftp.Connect($URL)"])
        | finding("ftp-request";
            "Checks for outgoing connections to ftp servers with the ftp package.") ) )
| report
