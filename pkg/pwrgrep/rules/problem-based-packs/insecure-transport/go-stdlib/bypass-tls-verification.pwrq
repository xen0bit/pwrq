# rules: bypass-tls-verification
# from: problem-based-packs/insecure-transport/go-stdlib/bypass-tls-verification.yaml

. as $root
| ( ($root | scan_regex(["*.go"]; [
      "(?P<CONFIG>\\S+)\\s+=\\s+&tls\\.Config\\{[\\s\\S]*?\\}\\s+[\\s\\S]*?\\s+(?P<CONFIG>\\S+)\\.InsecureSkipVerify\\s+=\\s+true",
      "tls\\.Config\\{[\\s\\S]*?,\\s+InsecureSkipVerify:\\s+true,\\s+[\\s\\S]*?\\}"
    ])) as $all
    | ( $all | of(["tls\\.Config\\{[\\s\\S]*?,\\s+InsecureSkipVerify:\\s+true,\\s+[\\s\\S]*?\\}","(?P<CONFIG>\\S+)\\s+=\\s+&tls\\.Config\\{[\\s\\S]*?\\}\\s+[\\s\\S]*?\\s+(?P<CONFIG>\\S+)\\.InsecureSkipVerify\\s+=\\s+true"])
        | finding("bypass-tls-verification";
            "Checks for disabling of TLS/SSL certificate verification.") ) )
| report
