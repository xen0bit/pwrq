# rules: grequests-http-request
# from: problem-based-packs/insecure-transport/go-stdlib/grequests-http-request.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "$FUNC($$$_,\"=~/[hH][tT][tT][pP]://.*/\", $$$_)",
      "grequests.$FUNC($$$_,\"=~/[hH][tT][tT][pP]://.*/\", $$$_)"
    ])) as $all
    | ( $all | of(["grequests.$FUNC($$$_,\"=~/[hH][tT][tT][pP]://.*/\", $$$_)","$FUNC($$$_,\"=~/[hH][tT][tT][pP]://.*/\", $$$_)"])
          | where_capture("FUNC"; "(Get|Head|Post|Put|Delete|Patch|Options|Req|DoRegularRequest)")
        | finding("grequests-http-request";
            "Checks for requests to http (unencrypted) sites using grequests, a popular HTTP client library.") ) )
| report
