# rules: http-request
# languages: go
# from: problem-based-packs/insecure-transport/go-stdlib/http-request.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "$CLIENT := &http.Client{$$$_}\n$$$_",
      "client.$FUNC(\"=~/[hH][tT][tT][pP]://.*/\", $$$_)",
      "client.$FUNC(\"=~/[hH][tT][tT][pP]://127.0.0.1.*/\", $$$_)",
      "client.$FUNC(\"=~/[hH][tT][tT][pP]://localhost.*/\", $$$_)",
      "http.$FUNC(\"=~/[hH][tT][tT][pP]://.*/\", $$$_)",
      "http.$FUNC(\"=~/[hH][tT][tT][pP]://127.0.0.1.*/\", $$$_)",
      "http.$FUNC(\"=~/[hH][tT][tT][pP]://localhost.*/\", $$$_)"
    ])) as $all
    | ( ($all | of(["http.$FUNC(\"=~/[hH][tT][tT][pP]://.*/\", $$$_)"]))
          + ($all | of(["client.$FUNC(\"=~/[hH][tT][tT][pP]://.*/\", $$$_)"])
          | in_files_with($all | of(["$CLIENT := &http.Client{$$$_}\n$$$_"])))
          | not_at($all | of(["http.$FUNC(\"=~/[hH][tT][tT][pP]://127.0.0.1.*/\", $$$_)"]))
          | not_at($all | of(["client.$FUNC(\"=~/[hH][tT][tT][pP]://127.0.0.1.*/\", $$$_)"]))
          | not_at($all | of(["http.$FUNC(\"=~/[hH][tT][tT][pP]://localhost.*/\", $$$_)"]))
          | not_at($all | of(["client.$FUNC(\"=~/[hH][tT][tT][pP]://localhost.*/\", $$$_)"]))
          | where_capture("FUNC"; "^(?:(Get|Post|Head|PostForm))")
        | finding("http-request";
            "Checks for requests sent via http.$FUNC to http:// URLS.") ) )
| report
