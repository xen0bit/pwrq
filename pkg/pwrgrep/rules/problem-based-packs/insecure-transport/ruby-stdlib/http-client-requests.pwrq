# rules: http-client-requests
# from: problem-based-packs/insecure-transport/ruby-stdlib/http-client-requests.yaml

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "$STRING = \"=~/[hH][tT][tT][pP]://.*/\"\n$$$_\nHTTParty.$PARTYVERB($STRING, $$$_)",
      "HTTParty.$PARTYVERB(\"=~/[hH][tT][tT][pP]://.*/\", $$$_)",
      "RestClient.$RESTVERB \"=~/[hH][tT][tT][pP]://.*/\", $$$_",
      "RestClient::Request.execute($$$_, url: \"=~/[hH][tT][tT][pP]://.*/\", $$$_)"
    ])) as $all
    | ( $all | of(["HTTParty.$PARTYVERB(\"=~/[hH][tT][tT][pP]://.*/\", $$$_)","$STRING = \"=~/[hH][tT][tT][pP]://.*/\"\n$$$_\nHTTParty.$PARTYVERB($STRING, $$$_)","RestClient.$RESTVERB \"=~/[hH][tT][tT][pP]://.*/\", $$$_","RestClient::Request.execute($$$_, url: \"=~/[hH][tT][tT][pP]://.*/\", $$$_)"])
        | finding("http-client-requests";
            "Checks for requests to http (unencrypted) sites using some of ruby's most popular REST/HTTP libraries, including httparty and restclient.") ) )
| report
