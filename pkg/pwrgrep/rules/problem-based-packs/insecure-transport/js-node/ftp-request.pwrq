# rules: ftp-request
# languages: javascript, typescript
# from: problem-based-packs/insecure-transport/js-node/ftp-request.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$C.connect($OPTIONS,$$$_);",
      "$C.connect({$$$_,secure: true});",
      "$OPTIONS = {secure: true};\n$$$_",
      "$X = require('ftp');\n$$$_\n$C = new $X();\n$$$_"
    ])) as $all
    | ( $all | of(["$C.connect($OPTIONS,$$$_);"])
          | in_files_with($all | of(["$X = require('ftp');\n$$$_\n$C = new $X();\n$$$_"]))
          | in_files_without($all | of(["$OPTIONS = {secure: true};\n$$$_"]))
          | not_at($all | of(["$C.connect({$$$_,secure: true});"]))
        | finding("ftp-request";
            "Checks for lack of usage of the \"secure: true\" option when sending ftp requests through the nodejs ftp module.") ) )
| report
