# rules: disallow-old-tls-versions2
# languages: javascript, typescript
# from: problem-based-packs/insecure-transport/js-node/disallow-old-tls-versions2.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$CONST = require('constants');\n$$$_",
      "$CONST = require('crypto');\n$$$_",
      "$HTTPS = require('https');\n$$$_",
      "$OPTIONS = {secureOptions: $CONST.SSL_OP_NO_SSLv2  | $CONST.SSL_OP_NO_TLSv1 | $CONST.SSL_OP_NO_SSLv3};\n$$$_\n$HTTPS.createServer($OPTIONS, $$$_);",
      "$OPTIONS = {secureOptions: $CONST.SSL_OP_NO_SSLv2 | $CONST.SSL_OP_NO_SSLv3 | $CONST.SSL_OP_NO_TLSv1};\n$$$_\n$HTTPS.createServer($OPTIONS, $$$_);",
      "$OPTIONS = {secureOptions: $CONST.SSL_OP_NO_SSLv3 | $CONST.SSL_OP_NO_SSLv2 | $CONST.SSL_OP_NO_TLSv1};\n$$$_\n$HTTPS.createServer($OPTIONS, $$$_);",
      "$OPTIONS = {secureOptions: $CONST.SSL_OP_NO_SSLv3 | $CONST.SSL_OP_NO_TLSv1 | $CONST.SSL_OP_NO_SSLv2};\n$$$_\n$HTTPS.createServer($OPTIONS, $$$_);",
      "$OPTIONS = {secureOptions: $CONST.SSL_OP_NO_TLSv1 | $CONST.SSL_OP_NO_SSLv2 | $CONST.SSL_OP_NO_SSLv3};\n$$$_\n$HTTPS.createServer($OPTIONS, $$$_);",
      "$OPTIONS = {secureOptions: $CONST.SSL_OP_NO_TLSv1 | $CONST.SSL_OP_NO_SSLv3 | $CONST.SSL_OP_NO_SSLv2};\n$$$_\n$HTTPS.createServer($OPTIONS, $$$_);",
      "$OPTIONS = {};\n$$$_\n$HTTPS.createServer($OPTIONS, $$$_);"
    ])) as $all
    | ( ($all
          | in_files_with($all | of(["$CONST = require('crypto');\n$$$_"])))
          + ($all
          | in_files_with($all | of(["$CONST = require('constants');\n$$$_"])))
          | at_same_place(($all | of(["$OPTIONS = {};\n$$$_\n$HTTPS.createServer($OPTIONS, $$$_);"])))
          | in_files_with($all | of(["$HTTPS = require('https');\n$$$_"]))
          | not_at($all | of(["$OPTIONS = {secureOptions: $CONST.SSL_OP_NO_TLSv1 | $CONST.SSL_OP_NO_SSLv3 | $CONST.SSL_OP_NO_SSLv2};\n$$$_\n$HTTPS.createServer($OPTIONS, $$$_);"]))
          | not_at($all | of(["$OPTIONS = {secureOptions: $CONST.SSL_OP_NO_TLSv1 | $CONST.SSL_OP_NO_SSLv2 | $CONST.SSL_OP_NO_SSLv3};\n$$$_\n$HTTPS.createServer($OPTIONS, $$$_);"]))
          | not_at($all | of(["$OPTIONS = {secureOptions: $CONST.SSL_OP_NO_SSLv2  | $CONST.SSL_OP_NO_TLSv1 | $CONST.SSL_OP_NO_SSLv3};\n$$$_\n$HTTPS.createServer($OPTIONS, $$$_);"]))
          | not_at($all | of(["$OPTIONS = {secureOptions: $CONST.SSL_OP_NO_SSLv2 | $CONST.SSL_OP_NO_SSLv3 | $CONST.SSL_OP_NO_TLSv1};\n$$$_\n$HTTPS.createServer($OPTIONS, $$$_);"]))
          | not_at($all | of(["$OPTIONS = {secureOptions: $CONST.SSL_OP_NO_SSLv3 | $CONST.SSL_OP_NO_SSLv2 | $CONST.SSL_OP_NO_TLSv1};\n$$$_\n$HTTPS.createServer($OPTIONS, $$$_);"]))
          | not_at($all | of(["$OPTIONS = {secureOptions: $CONST.SSL_OP_NO_SSLv3 | $CONST.SSL_OP_NO_TLSv1 | $CONST.SSL_OP_NO_SSLv2};\n$$$_\n$HTTPS.createServer($OPTIONS, $$$_);"]))
        | finding("disallow-old-tls-versions2";
            "Detects creations of $HTTPS servers from option objects that don't disallow SSL v2, SSL v3, and TLS v1.") ) )
| report
