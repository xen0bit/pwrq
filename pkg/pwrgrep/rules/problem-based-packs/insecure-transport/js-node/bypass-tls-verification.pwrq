# rules: bypass-tls-verification
# languages: javascript, typescript
# from: problem-based-packs/insecure-transport/js-node/bypass-tls-verification.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "process.env[\"NODE_TLS_REJECT_UNAUTHORIZED\"] = 0;",
      "{rejectUnauthorized:false}"
    ])) as $all
    | ( $all | of(["process.env[\"NODE_TLS_REJECT_UNAUTHORIZED\"] = 0;","{rejectUnauthorized:false}"])
        | finding("bypass-tls-verification";
            "Checks for setting the environment variable NODE_TLS_REJECT_UNAUTHORIZED to 0, which disables TLS verification.") ) )
| report
