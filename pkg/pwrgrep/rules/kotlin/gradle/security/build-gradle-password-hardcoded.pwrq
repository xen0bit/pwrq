# rules: build-gradle-password-hardcoded
# languages: kotlin
# from: kotlin/gradle/security/build-gradle-password-hardcoded.yaml

. as $root
| ( ($root | scan_ast(["*.kt"]; [
      "$PASS = env[$$$_] ?: $VALUE"
    ])) as $all
    | ( $all | of(["$PASS = env[$$$_] ?: $VALUE"])
          | where_capture("PASS"; "^(?:(password|pass|passwd|loginPassword))")
        | finding("build-gradle-password-hardcoded";
            "A secret is hard-coded in the application.") ) )
| report
