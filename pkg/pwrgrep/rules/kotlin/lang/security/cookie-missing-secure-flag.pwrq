# rules: cookie-missing-secure-flag
# languages: kotlin
# from: kotlin/lang/security/cookie-missing-secure-flag.yaml

. as $root
| ( ($root | scan_ast(["*.kt"]; [
      "$COOKIE.setSecure($$$_)\n$$$_",
      "$COOKIE.setSecure(false)",
      "$COOKIE.setValue(\"\")\n$$$_",
      "$RESPONSE.addCookie($COOKIE)"
    ])) as $all
    | ( ($all | of(["$COOKIE.setSecure(false)"]))
          + ($all | of(["$RESPONSE.addCookie($COOKIE)"])
          | in_files_without($all | of(["$COOKIE.setSecure($$$_)\n$$$_"])))
          | in_files_without($all | of(["$COOKIE.setValue(\"\")\n$$$_"]))
        | finding("cookie-missing-secure-flag";
            "A cookie was detected without setting the 'secure' flag.") ) )
| report
