# rules: correctness-double-epsilon-equality
# languages: c_sharp
# from: csharp/lang/correctness/double/double-epsilon-equality.yaml

. as $root
| ( ($root | scan_ast(["*.cs"]; [
      "$$$_ <= Double.Epsilon",
      "$V1 - $V2",
      "$V1 = 0;\n$$$_",
      "$V2 = 0;\n$$$_",
      "Double.Epsilon <= $$$_",
      "double $V1 = 0;\n$$$_",
      "double $V2 = 0;\n$$$_"
    ])) as $all
    | ( $all | of(["$V1 - $V2"])
          | at_same_place((($all
          | within($all | of(["$$$_ <= Double.Epsilon"])))
          + ($all
          | within($all | of(["Double.Epsilon <= $$$_"])))))
          | in_files_without($all | of(["double $V1 = 0;\n$$$_"]))
          | in_files_without($all | of(["double $V2 = 0;\n$$$_"]))
          | in_files_without($all | of(["$V1 = 0;\n$$$_"]))
          | in_files_without($all | of(["$V2 = 0;\n$$$_"]))
        | finding("correctness-double-epsilon-equality";
            "Double.Epsilon is defined by .NET as the smallest value that can be added to or subtracted from a zero-value Double.") ) )
| report
