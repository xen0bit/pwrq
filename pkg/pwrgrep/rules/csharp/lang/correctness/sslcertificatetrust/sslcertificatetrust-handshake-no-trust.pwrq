# rules: correctness-sslcertificatetrust-handshake-no-trust
# languages: c_sharp
# from: csharp/lang/correctness/sslcertificatetrust/sslcertificatetrust-handshake-no-trust.yaml

. as $root
| ( ($root | scan_ast(["*.cs"]; [
      "SslCertificateTrust.$METHOD($COLLECTION,sendTrustInHandshake=true)",
      "SslCertificateTrust.$METHOD($COLLECTION,true)"
    ])) as $all
    | ( $all | of(["SslCertificateTrust.$METHOD($COLLECTION,sendTrustInHandshake=true)","SslCertificateTrust.$METHOD($COLLECTION,true)"])
          | where_capture("METHOD"; "^(?:CreateForX509(Collection|Store))")
        | finding("correctness-sslcertificatetrust-handshake-no-trust";
            "Sending the trusted CA list increases the size of the handshake request and can leak system configuration information.") ) )
| report
