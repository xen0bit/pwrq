# rules: correctness-regioninfo-interop
# from: csharp/lang/correctness/regioninfo/regioninfo-interop.yaml

. as $root
| ( ($root | scan_ast(["*.cs"]; [
      "$WRITER.Write($RI);",
      "$WRITER.WriteAsync($RI);",
      "$WRITER.WriteLine($RI);",
      "$WRITER.WriteLineAsync($RI);",
      "RegionInfo $RI = new RegionInfo($REGION);\n$$$_\nusing($PIPESTREAM $P = $$$_){\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["$WRITER.Write($RI);","$WRITER.WriteAsync($RI);","$WRITER.WriteLine($RI);","$WRITER.WriteLineAsync($RI);"])
          | within($all | of(["RegionInfo $RI = new RegionInfo($REGION);\n$$$_\nusing($PIPESTREAM $P = $$$_){\n  $$$_\n}"]))
          | where_capture("REGION"; "^\"\\w{2}\"$")
          | where_capture("PIPESTREAM"; "(Anonymous|Named)Pipe(Server|Client)Stream")
        | finding("correctness-regioninfo-interop";
            "Potential inter-process write of RegionInfo $RI via $PIPESTREAM $P that was instantiated with a two-character culture code $REGION.") ) )
| report
