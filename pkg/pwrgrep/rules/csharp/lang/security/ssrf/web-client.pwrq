# rules: ssrf
# languages: c_sharp
# from: csharp/lang/security/ssrf/web-client.yaml

. as $root
| ( ($root | scan_ast(["*.cs"]; [
      "$T $F($$$_, $X, $$$_)\n{\n$$$_\n$A $B = $PWRQDEEP1;\n$$$_\nWebClient $Y = new WebClient();\n$$$_\n$$$_ $Y.DownloadString($B);\n}",
      "$T $F($$$_, $X, $$$_)\n{\n$$$_\n$A $B = $PWRQDEEP1;\n$$$_\nWebClient $Y = new WebClient();\n$$$_\n$$$_ $Y.OpenRead($B);\n}",
      "$T $F($$$_, $X, $$$_)\n{\n$$$_\n$A $B = $PWRQDEEP1;\n$$$_\nWebClient $Y = new WebClient();\n$$$_\n$$$_ $Y.OpenReadAsync($B, $$$_);\n}",
      "$T $F($$$_, $X, $$$_)\n{\n$$$_\nWebClient $Y = new WebClient();\n$$$_\n$$$_ $Y.DownloadString($PWRQDEEP1);\n}",
      "$T $F($$$_, $X, $$$_)\n{\n$$$_\nWebClient $Y = new WebClient();\n$$$_\n$$$_ $Y.OpenRead($PWRQDEEP1);\n}",
      "$T $F($$$_, $X, $$$_)\n{\n$$$_\nWebClient $Y = new WebClient();\n$$$_\n$$$_ $Y.OpenReadAsync($PWRQDEEP1, $$$_);\n}",
      "using System.Net;\n$$$_"
    ])) as $all
    | ( ($all | of(["$T $F($$$_, $X, $$$_)\n{\n$$$_\nWebClient $Y = new WebClient();\n$$$_\n$$$_ $Y.OpenRead($PWRQDEEP1);\n}"])
          | where_capture_ast("PWRQDEEP1"; "$X"))
          + ($all | of(["$T $F($$$_, $X, $$$_)\n{\n$$$_\n$A $B = $PWRQDEEP1;\n$$$_\nWebClient $Y = new WebClient();\n$$$_\n$$$_ $Y.OpenRead($B);\n}"])
          | where_capture_ast("PWRQDEEP1"; "$X"))
          + ($all | of(["$T $F($$$_, $X, $$$_)\n{\n$$$_\nWebClient $Y = new WebClient();\n$$$_\n$$$_ $Y.OpenReadAsync($PWRQDEEP1, $$$_);\n}"])
          | where_capture_ast("PWRQDEEP1"; "$X"))
          + ($all | of(["$T $F($$$_, $X, $$$_)\n{\n$$$_\n$A $B = $PWRQDEEP1;\n$$$_\nWebClient $Y = new WebClient();\n$$$_\n$$$_ $Y.OpenReadAsync($B, $$$_);\n}"])
          | where_capture_ast("PWRQDEEP1"; "$X"))
          + ($all | of(["$T $F($$$_, $X, $$$_)\n{\n$$$_\nWebClient $Y = new WebClient();\n$$$_\n$$$_ $Y.DownloadString($PWRQDEEP1);\n}"])
          | where_capture_ast("PWRQDEEP1"; "$X"))
          + ($all | of(["$T $F($$$_, $X, $$$_)\n{\n$$$_\n$A $B = $PWRQDEEP1;\n$$$_\nWebClient $Y = new WebClient();\n$$$_\n$$$_ $Y.DownloadString($B);\n}"])
          | where_capture_ast("PWRQDEEP1"; "$X"))
          | in_files_with($all | of(["using System.Net;\n$$$_"]))
        | finding("ssrf";
            "SSRF is an attack vector that abuses an application to interact with the internal/external network or the machine itself.") ) )
| report
