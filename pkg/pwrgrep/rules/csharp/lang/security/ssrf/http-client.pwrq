# rules: ssrf
# languages: c_sharp
# from: csharp/lang/security/ssrf/http-client.yaml

. as $root
| ( ($root | scan_ast(["*.cs"]; [
      "$T $F($$$_, $X, $$$_)\n{\n$$$_\n$A $B = $PWRQDEEP1;\n$$$_\nHttpClient $Y = new HttpClient();\n$$$_\n$$$_ $Y.GetAsync($B, $$$_);\n}",
      "$T $F($$$_, $X, $$$_)\n{\n$$$_\n$A $B = $PWRQDEEP1;\n$$$_\nHttpClient $Y = new HttpClient();\n$$$_\n$$$_ $Y.GetStringAsync($B);\n}",
      "$T $F($$$_, $X, $$$_)\n{\n$$$_\nHttpClient $Y = new HttpClient();\n$$$_\n$$$_ $Y.GetAsync($PWRQDEEP1, $$$_);\n}",
      "$T $F($$$_, $X, $$$_)\n{\n$$$_\nHttpClient $Y = new HttpClient();\n$$$_\n$$$_ $Y.GetStringAsync($PWRQDEEP1);\n}",
      "using System.Net.Http;\n$$$_"
    ])) as $all
    | ( ($all | of(["$T $F($$$_, $X, $$$_)\n{\n$$$_\nHttpClient $Y = new HttpClient();\n$$$_\n$$$_ $Y.GetAsync($PWRQDEEP1, $$$_);\n}"])
          | where_capture_ast("PWRQDEEP1"; "$X"))
          + ($all | of(["$T $F($$$_, $X, $$$_)\n{\n$$$_\n$A $B = $PWRQDEEP1;\n$$$_\nHttpClient $Y = new HttpClient();\n$$$_\n$$$_ $Y.GetAsync($B, $$$_);\n}"])
          | where_capture_ast("PWRQDEEP1"; "$X"))
          + ($all | of(["$T $F($$$_, $X, $$$_)\n{\n$$$_\nHttpClient $Y = new HttpClient();\n$$$_\n$$$_ $Y.GetStringAsync($PWRQDEEP1);\n}"])
          | where_capture_ast("PWRQDEEP1"; "$X"))
          + ($all | of(["$T $F($$$_, $X, $$$_)\n{\n$$$_\n$A $B = $PWRQDEEP1;\n$$$_\nHttpClient $Y = new HttpClient();\n$$$_\n$$$_ $Y.GetStringAsync($B);\n}"])
          | where_capture_ast("PWRQDEEP1"; "$X"))
          | in_files_with($all | of(["using System.Net.Http;\n$$$_"]))
        | finding("ssrf";
            "SSRF is an attack vector that abuses an application to interact with the internal/external network or the machine itself.") ) )
| report
