# rules: ssrf
# languages: c_sharp
# from: csharp/lang/security/ssrf/rest-client.yaml

. as $root
| ( ($root | scan_ast(["*.cs"]; [
      "$T $F($$$_, $X, $$$_)\n{\n$$$_\n$$$_ new RestClient($PWRQDEEP1);\n}",
      "$T $F($$$_, $X, $$$_)\n{\n$$$_\n$A $B = $PWRQDEEP1;\n$$$_\n$$$_ new RestClient($B);\n}",
      "using RestSharp;\n$$$_"
    ])) as $all
    | ( ($all | of(["$T $F($$$_, $X, $$$_)\n{\n$$$_\n$$$_ new RestClient($PWRQDEEP1);\n}"])
          | where_capture_ast("PWRQDEEP1"; "$X"))
          + ($all | of(["$T $F($$$_, $X, $$$_)\n{\n$$$_\n$A $B = $PWRQDEEP1;\n$$$_\n$$$_ new RestClient($B);\n}"])
          | where_capture_ast("PWRQDEEP1"; "$X"))
          | in_files_with($all | of(["using RestSharp;\n$$$_"]))
        | finding("ssrf";
            "SSRF is an attack vector that abuses an application to interact with the internal/external network or the machine itself.") ) )
| report
