# rules: missing-hsts-header
# languages: c_sharp
# from: csharp/lang/security/missing-hsts-header.yaml

. as $root
| ( ($root | scan_ast(["*.cs"]; [
      "public void Configure($$$_) {\n    $$$_\n    (IApplicationBuilder $APP). $$$_;\n    $$$_\n}",
      "public void Configure($$$_) {\n    $$$_\n    (IApplicationBuilder $APP).UseHsts($$$_);\n    $$$_\n}",
      "public void ConfigureServices($$$_) {\n    $$$_\n    (IServiceCollection $SERVICES). $$$_;\n    $$$_\n}",
      "public void ConfigureServices($$$_) {\n    $$$_\n    (IServiceCollection $SERVICES).AddHsts($$$_);\n    $$$_\n}"
    ])) as $all
    | ( ($all
          | within($all | of(["public void Configure($$$_) {\n    $$$_\n    (IApplicationBuilder $APP). $$$_;\n    $$$_\n}"]))
          | focus("APP")
          | outside($all | of(["public void Configure($$$_) {\n    $$$_\n    (IApplicationBuilder $APP).UseHsts($$$_);\n    $$$_\n}"])))
          + ($all
          | within($all | of(["public void ConfigureServices($$$_) {\n    $$$_\n    (IServiceCollection $SERVICES). $$$_;\n    $$$_\n}"]))
          | focus("SERVICES")
          | outside($all | of(["public void ConfigureServices($$$_) {\n    $$$_\n    (IServiceCollection $SERVICES).AddHsts($$$_);\n    $$$_\n}"])))
        | finding("missing-hsts-header";
            "The HSTS HTTP response security header is missing, allowing interaction and communication to be sent over the insecure HTTP protocol.") ) )
| report
