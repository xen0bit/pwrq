# rules: insecure-soapformatter-deserialization
# languages: c_sharp
# from: csharp/lang/security/insecure-deserialization/soap-formatter.yaml

. as $root
| ( ($root | scan_ast(["*.cs"]; [
      "new SoapFormatter();",
      "using System.Runtime.Serialization.Formatters.Soap;\n$$$_"
    ])) as $all
    | ( $all | of(["new SoapFormatter();"])
          | in_files_with($all | of(["using System.Runtime.Serialization.Formatters.Soap;\n$$$_"]))
        | finding("insecure-soapformatter-deserialization";
            "The SoapFormatter type is dangerous and is not recommended for data processing.") ) )
| report
