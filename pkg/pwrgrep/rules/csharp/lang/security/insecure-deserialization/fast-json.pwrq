# rules: insecure-fastjson-deserialization
# languages: c_sharp
# from: csharp/lang/security/insecure-deserialization/fast-json.yaml

. as $root
| ( ($root | scan_ast(["*.cs"]; [
      "new JSONParameters\n{\n  BadListTypeChecking = false\n}",
      "using fastJSON;\n$$$_"
    ])) as $all
    | ( $all | of(["new JSONParameters\n{\n  BadListTypeChecking = false\n}"])
          | in_files_with($all | of(["using fastJSON;\n$$$_"]))
        | finding("insecure-fastjson-deserialization";
            "$type extension has the potential to be unsafe, so use it with common sense and known json sources and not public facing ones to be safe") ) )
| report
