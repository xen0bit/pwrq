# rules: unsafe-path-combine
# languages: c_sharp
# from: csharp/lang/security/filesystem/unsafe-path-combine.yaml

. as $root
| ( ($root | scan_ast(["*.cs"]; [
      "$A",
      "$PWRQDEEP1",
      "$X",
      "$X = Path.GetFileName($$$_);\n$$$_",
      "File.$METHOD($X,$$$_)",
      "Path.Combine($$$_,$A,$$$_)",
      "Path.GetFileName($$$_)",
      "if($PWRQDEEP1){\n  $$$_\n  throw new $EXCEPTION($$$_);\n}\n$$$_",
      "public $TYPE $M($$$_,$A,$$$_){$$$_}"
    ])) as $all
    | ( (($all | of(["File.$METHOD($X,$$$_)"])
          | focus("X")
          | where_capture("METHOD"; "^(?:(?i)^(read|write))")))
          | reaching((($all | of(["$A"])
          | within($all | of(["Path.Combine($$$_,$A,$$$_)"]))
          | within($all | of(["public $TYPE $M($$$_,$A,$$$_){$$$_}"]))
          | outside($all | of(["$PWRQDEEP1"])
          | where_capture_ast("PWRQDEEP1"; "Path.GetFileName($A) != $A"))));
              (($all | of(["Path.GetFileName($$$_)"]))
              + ($all | of(["$X"])
          | in_files_with($all | of(["$X = Path.GetFileName($$$_);\n$$$_"])))
              + ($all | of(["$X"])
          | in_files_with($all | of(["if($PWRQDEEP1){\n  $$$_\n  throw new $EXCEPTION($$$_);\n}\n$$$_"])))))
        | finding("unsafe-path-combine";
            "String argument $A is used to read or write data from a file via Path.Combine without direct sanitization via Path.GetFileName.") ) )
| report
