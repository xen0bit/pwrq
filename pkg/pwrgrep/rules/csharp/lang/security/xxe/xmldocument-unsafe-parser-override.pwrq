# rules: xmldocument-unsafe-parser-override
# languages: c_sharp
# from: csharp/lang/security/xxe/xmldocument-unsafe-parser-override.yaml

. as $root
| ( ($root | scan_ast(["*.cs"]; [
      "$XMLDOCUMENT.$METHOD($$$_)",
      "XmlDocument $XMLDOCUMENT = new XmlDocument($$$_);\n$$$_\n$XMLDOCUMENT.XmlResolver = new XmlUrlResolver($$$_);\n$$$_",
      "public $T $M($$$_,string $ARG,$$$_){$$$_}"
    ])) as $all
    | ( (($all | of(["$XMLDOCUMENT.$METHOD($$$_)"])
          | in_files_with($all | of(["XmlDocument $XMLDOCUMENT = new XmlDocument($$$_);\n$$$_\n$XMLDOCUMENT.XmlResolver = new XmlUrlResolver($$$_);\n$$$_"]))))
          | reaching((($all
          | focus("ARG")
          | within($all | of(["public $T $M($$$_,string $ARG,$$$_){$$$_}"]))));
              ([]))
        | finding("xmldocument-unsafe-parser-override";
            "XmlReaderSettings found with DtdProcessing.Parse on an XmlReader handling a string argument from a public method.") ) )
| report
