# rules: xmlreadersettings-unsafe-parser-override
# languages: c_sharp
# from: csharp/lang/security/xxe/xmlreadersettings-unsafe-parser-override.yaml

. as $root
| ( ($root | scan_ast(["*.cs"]; [
      "XmlReader $READER = XmlReader.Create($$$_,$RS,$$$_);",
      "XmlReaderSettings $RS = new XmlReaderSettings();\n$$$_\n$RS.DtdProcessing = DtdProcessing.Parse;\n$$$_",
      "public $T $M($$$_,string $ARG,$$$_){$$$_}"
    ])) as $all
    | ( (($all | of(["XmlReader $READER = XmlReader.Create($$$_,$RS,$$$_);"])
          | in_files_with($all | of(["XmlReaderSettings $RS = new XmlReaderSettings();\n$$$_\n$RS.DtdProcessing = DtdProcessing.Parse;\n$$$_"]))))
          | reaching((($all
          | focus("ARG")
          | within($all | of(["public $T $M($$$_,string $ARG,$$$_){$$$_}"]))));
              ([]))
        | finding("xmlreadersettings-unsafe-parser-override";
            "XmlReaderSettings found with DtdProcessing.Parse on an XmlReader handling a string argument from a public method.") ) )
| report
