# rules: xmltextreader-unsafe-defaults
# languages: c_sharp
# from: csharp/lang/security/xxe/xmltextreader-unsafe-defaults.yaml

. as $root
| ( ($root | scan_ast(["*.cs"]; [
      "$READER.$METHOD($$$_)",
      "$READER.DtdProcessing = DtdProcessing.Prohibit;\n$$$_",
      "XmlTextReader $READER = new XmlTextReader($$$_);\n$$$_",
      "public $T $M($$$_,string $ARG,$$$_){$$$_}"
    ])) as $all
    | ( (($all | of(["$READER.$METHOD($$$_)"])
          | in_files_without($all | of(["$READER.DtdProcessing = DtdProcessing.Prohibit;\n$$$_"]))
          | in_files_with($all | of(["XmlTextReader $READER = new XmlTextReader($$$_);\n$$$_"]))))
          | reaching((($all
          | focus("ARG")
          | within($all | of(["public $T $M($$$_,string $ARG,$$$_){$$$_}"]))));
              ([]))
        | finding("xmltextreader-unsafe-defaults";
            "XmlReaderSettings found with DtdProcessing.Parse on an XmlReader handling a string argument from a public method.") ) )
| report
