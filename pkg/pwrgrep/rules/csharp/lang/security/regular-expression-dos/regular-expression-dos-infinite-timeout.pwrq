# rules: regular-expression-dos-infinite-timeout
# languages: c_sharp
# from: csharp/lang/security/regular-expression-dos/regular-expression-dos-infinite-timeout.yaml

. as $root
| ( ($root | scan_ast(["*.cs"]; [
      "new Regex($$$_, TimeSpan.FromHours($$$_))",
      "new Regex($$$_, TimeSpan.FromMinutes($$$_))",
      "new Regex($$$_, TimeSpan.FromSeconds($TIME))",
      "new Regex($$$_, TimeSpan.InfiniteMatchTimeout)",
      "using System.Text.RegularExpressions;\n$$$_"
    ])) as $all
    | ( ($all | of(["new Regex($$$_, TimeSpan.InfiniteMatchTimeout)"]))
          + ($all | of(["new Regex($$$_, TimeSpan.FromSeconds($TIME))"])
          | where_capture_compare("$TIME > 5"))
          + ($all | of(["new Regex($$$_, TimeSpan.FromMinutes($$$_))"]))
          + ($all | of(["new Regex($$$_, TimeSpan.FromHours($$$_))"]))
          | in_files_with($all | of(["using System.Text.RegularExpressions;\n$$$_"]))
        | finding("regular-expression-dos-infinite-timeout";
            "Specifying the regex timeout leaves the system vulnerable to a regex-based Denial of Service (DoS) attack.") ) )
| report
