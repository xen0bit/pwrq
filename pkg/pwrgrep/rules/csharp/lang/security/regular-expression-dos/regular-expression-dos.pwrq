# rules: regular-expression-dos
# from: csharp/lang/security/regular-expression-dos/regular-expression-dos.yaml

. as $root
| ( ($root | scan_regex(["*.cs"]; [
      "public\\s+(?P<T>\\S+)\\s+(?P<F>\\S+)\\((?P<X>\\S+)\\)\\s+\\{\\s+Regex\\s+(?P<Y>\\S+)\\s+=\\s+new\\s+Regex\\((?P<P>\\S+),\\s+(?P<O>\\S+)\\);\\s+[\\s\\S]*?\\s+(?P<Y>\\S+)\\.Match\\((?P<X>\\S+)\\);\\s+\\}",
      "public\\s+(?P<T>\\S+)\\s+(?P<F>\\S+)\\((?P<X>\\S+)\\)\\s+\\{\\s+Regex\\s+(?P<Y>\\S+)\\s+=\\s+new\\s+Regex\\((?P<P>\\S+)\\);\\s+[\\s\\S]*?\\s+(?P<Y>\\S+)\\.Match\\((?P<X>\\S+)\\);\\s+\\}",
      "public\\s+(?P<T>\\S+)\\s+(?P<F>\\S+)\\((?P<X>\\S+)\\)\\s+\\{\\s+[\\s\\S]*?\\s+Regex\\.Match\\((?P<X>\\S+),\\s+(?P<P>\\S+),\\s+(?P<O>\\S+)\\);\\s+\\}",
      "public\\s+(?P<T>\\S+)\\s+(?P<F>\\S+)\\((?P<X>\\S+)\\)\\s+\\{\\s+[\\s\\S]*?\\s+Regex\\.Match\\((?P<X>\\S+),\\s+(?P<P>\\S+)\\);\\s+\\}",
      "using\\s+System\\.Text\\.RegularExpressions;\\s+[\\s\\S]*?"
    ])) as $all
    | ( $all | of(["public\\s+(?P<T>\\S+)\\s+(?P<F>\\S+)\\((?P<X>\\S+)\\)\\s+\\{\\s+Regex\\s+(?P<Y>\\S+)\\s+=\\s+new\\s+Regex\\((?P<P>\\S+)\\);\\s+[\\s\\S]*?\\s+(?P<Y>\\S+)\\.Match\\((?P<X>\\S+)\\);\\s+\\}","public\\s+(?P<T>\\S+)\\s+(?P<F>\\S+)\\((?P<X>\\S+)\\)\\s+\\{\\s+Regex\\s+(?P<Y>\\S+)\\s+=\\s+new\\s+Regex\\((?P<P>\\S+),\\s+(?P<O>\\S+)\\);\\s+[\\s\\S]*?\\s+(?P<Y>\\S+)\\.Match\\((?P<X>\\S+)\\);\\s+\\}","public\\s+(?P<T>\\S+)\\s+(?P<F>\\S+)\\((?P<X>\\S+)\\)\\s+\\{\\s+[\\s\\S]*?\\s+Regex\\.Match\\((?P<X>\\S+),\\s+(?P<P>\\S+)\\);\\s+\\}","public\\s+(?P<T>\\S+)\\s+(?P<F>\\S+)\\((?P<X>\\S+)\\)\\s+\\{\\s+[\\s\\S]*?\\s+Regex\\.Match\\((?P<X>\\S+),\\s+(?P<P>\\S+),\\s+(?P<O>\\S+)\\);\\s+\\}"])
          | in_files_with($all | of(["using\\s+System\\.Text\\.RegularExpressions;\\s+[\\s\\S]*?"]))
        | finding("regular-expression-dos";
            "When using `System.Text.RegularExpressions` to process untrusted input, pass a timeout.") ) )
| report
