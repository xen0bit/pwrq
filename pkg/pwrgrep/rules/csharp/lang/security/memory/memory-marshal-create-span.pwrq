# rules: memory-marshal-create-span
# languages: c_sharp
# from: csharp/lang/security/memory/memory-marshal-create-span.yaml

. as $root
| ( ($root | scan_ast(["*.cs"]; [
      "MemoryMarshal.CreateReadOnlySpan($$$_)",
      "MemoryMarshal.CreateSpan($$$_)"
    ])) as $all
    | ( $all | of(["MemoryMarshal.CreateSpan($$$_)","MemoryMarshal.CreateReadOnlySpan($$$_)"])
        | finding("memory-marshal-create-span";
            "MemoryMarshal.CreateSpan and MemoryMarshal.CreateReadOnlySpan should be used with caution, as the length argument is not checked.") ) )
| report
