# rules: unsigned-security-token
# from: csharp/lang/security/cryptography/unsigned-security-token.yaml

. as $root
| ( ($root | scan_ast(["*.cs"]; [
      "RequireSignedTokens = false",
      "new TokenValidationParameters {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["RequireSignedTokens = false"])
          | within($all | of(["new TokenValidationParameters {\n  $$$_\n}"]))
        | finding("unsigned-security-token";
            "Accepting unsigned security tokens as valid security tokens allows an attacker to remove its signature and potentially forge an identity.") ) )
| report
