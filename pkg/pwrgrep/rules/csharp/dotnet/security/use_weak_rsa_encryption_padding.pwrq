# rules: use_weak_rsa_encryption_padding
# languages: c_sharp
# from: csharp/dotnet/security/use_weak_rsa_encryption_padding.yaml

. as $root
| ( ($root | scan_ast(["*.cs"]; [
      "(RSAPKCS1KeyExchangeDeformatter $DEFORMATER).DecryptKeyExchange($$$_);",
      "(RSAPKCS1KeyExchangeFormatter $FORMATER).CreateKeyExchange($$$_);"
    ])) as $all
    | ( $all | of(["(RSAPKCS1KeyExchangeFormatter $FORMATER).CreateKeyExchange($$$_);","(RSAPKCS1KeyExchangeDeformatter $DEFORMATER).DecryptKeyExchange($$$_);"])
        | finding("use_weak_rsa_encryption_padding";
            "You are using the outdated PKCS#1 v1.5 encryption padding for your RSA key.") ) )
| report
