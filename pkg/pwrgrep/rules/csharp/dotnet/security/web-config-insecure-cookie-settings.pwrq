# rules: web-config-insecure-cookie-settings
# from: csharp/dotnet/security/web-config-insecure-cookie-settings.yaml

. as $root
| ( ($root | scan_regex(["*web.config"]; [
      "<forms\\s+[\\s\\S]*?>",
      "<httpCookies\\s+[\\s\\S]*?>",
      "<roleManager\\s+[\\s\\S]*?>",
      "cookieRequireSSL=\"false\"",
      "requireSSL=\"false\""
    ])) as $all
    | ( $all | of(["requireSSL=\"false\"","cookieRequireSSL=\"false\""])
          | at_same_place((($all
          | within($all | of(["<httpCookies\\s+[\\s\\S]*?>"])))
          + ($all
          | within($all | of(["<forms\\s+[\\s\\S]*?>"])))
          + ($all
          | within($all | of(["<roleManager\\s+[\\s\\S]*?>"])))))
        | finding("web-config-insecure-cookie-settings";
            "Cookie Secure flag is explicitly disabled.") ) )
| report
