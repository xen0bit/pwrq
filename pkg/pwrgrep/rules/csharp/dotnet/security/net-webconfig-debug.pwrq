# rules: net-webconfig-debug
# from: csharp/dotnet/security/net-webconfig-debug.yaml

. as $root
| ( ($root | scan_regex(["*web.config*"]; [
      "<compilation\\s+[\\s\\S]*?\\s+debug\\s+=\\s+\"true\"\\s+[\\s\\S]*?\\s+\\/>",
      "<system\\.web>\\s+[\\s\\S]*?\\s+<\\/system\\.web>"
    ])) as $all
    | ( $all | of(["<compilation\\s+[\\s\\S]*?\\s+debug\\s+=\\s+\"true\"\\s+[\\s\\S]*?\\s+\\/>"])
          | within($all | of(["<system\\.web>\\s+[\\s\\S]*?\\s+<\\/system\\.web>"]))
        | finding("net-webconfig-debug";
            "ASP.NET applications built with `debug` set to true in production may leak debug information to attackers.") ) )
| report
