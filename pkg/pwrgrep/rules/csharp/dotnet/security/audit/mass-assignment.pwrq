# rules: mass-assignment
# languages: c_sharp
# from: csharp/dotnet/security/audit/mass-assignment.yaml

. as $root
| ( ($root | scan_ast(["*.cs"]; [
      "View($$$_)",
      "public ActionResult $METHOD($$$_, $TYPE $ARG, $$$_){\n  $$$_\n}",
      "public ActionResult $METHOD($$$_, [Bind($$$_)] $TYPE $ARG, $$$_){\n  $$$_\n}",
      "public IActionResult $METHOD($$$_, $TYPE $ARG, $$$_){\n  $$$_\n}",
      "public IActionResult $METHOD($$$_, [Bind($$$_)] $TYPE $ARG, $$$_){\n  $$$_\n}",
      "using Microsoft.AspNetCore.Mvc;\n$$$_"
    ])) as $all
    | ( (($all | of(["View($$$_)"])))
          | reaching((($all | of(["public IActionResult $METHOD($$$_, $TYPE $ARG, $$$_){\n  $$$_\n}","public ActionResult $METHOD($$$_, $TYPE $ARG, $$$_){\n  $$$_\n}"])
          | in_files_with($all | of(["using Microsoft.AspNetCore.Mvc;\n$$$_"]))
          | not_at($all | of(["public IActionResult $METHOD($$$_, [Bind($$$_)] $TYPE $ARG, $$$_){\n  $$$_\n}"]))
          | not_at($all | of(["public ActionResult $METHOD($$$_, [Bind($$$_)] $TYPE $ARG, $$$_){\n  $$$_\n}"]))
          | focus("ARG")));
              ([]))
        | finding("mass-assignment";
            "Mass assignment or Autobinding vulnerability in code allows an attacker to execute over-posting attacks, which could create a new parameter in the binding request and manipulate the underlying object in the application.") ) )
| report
