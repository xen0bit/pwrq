# rules: missing-or-broken-authorization
# languages: c_sharp
# from: csharp/dotnet/security/audit/missing-or-broken-authorization.yaml

. as $root
| ( ($root | scan_ast(["*.cs"]; [
      "[AllowAnonymous]\npublic class $CLASS : Controller {\n  $$$_\n}",
      "[Authorize(Policy = $$$_)]\npublic class $CLASS : Controller {\n  $$$_\n}",
      "[Authorize(Roles = $$$_)]\npublic class $CLASS : Controller {\n  $$$_\n}",
      "[Authorize]\npublic class $CLASS : Controller {\n  $$$_\n}",
      "public class $CLASS : Controller {\n  $$$_\n}",
      "using Microsoft.AspNetCore.Mvc;\n$$$_"
    ])) as $all
    | ( $all | of(["public class $CLASS : Controller {\n  $$$_\n}"])
          | in_files_with($all | of(["using Microsoft.AspNetCore.Mvc;\n$$$_"]))
          | not_at($all | of(["[AllowAnonymous]\npublic class $CLASS : Controller {\n  $$$_\n}"]))
          | not_at($all | of(["[Authorize]\npublic class $CLASS : Controller {\n  $$$_\n}"]))
          | not_at($all | of(["[Authorize(Roles = $$$_)]\npublic class $CLASS : Controller {\n  $$$_\n}"]))
          | not_at($all | of(["[Authorize(Policy = $$$_)]\npublic class $CLASS : Controller {\n  $$$_\n}"]))
        | finding("missing-or-broken-authorization";
            "Anonymous access shouldn't be allowed unless explicit by design.") ) )
| report
