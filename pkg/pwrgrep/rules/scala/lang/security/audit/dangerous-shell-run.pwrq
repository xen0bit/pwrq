# rules: dangerous-shell-run
# languages: scala
# from: scala/lang/security/audit/dangerous-shell-run.yaml

. as $root
| ( ($root | scan_ast(["*.scala"]; [
      "\"$$$_\"",
      "$CMD = \"$$$_\"\n$$$_",
      "Seq($$$_).!",
      "Seq($$$_).!!",
      "Seq($$$_).lazyLines",
      "Seq($SH, \"-c\", \"$$$_\", $$$_)",
      "Seq($SH, \"-c\", $CMD, $$$_)",
      "import sys.process\n$$$_"
    ])) as $all
    | ( $all | of(["Seq($SH, \"-c\", $CMD, $$$_)"])
          | at_same_place((($all
          | within($all | of(["Seq($$$_).!"])))
          + ($all
          | within($all | of(["Seq($$$_).!!"])))
          + ($all
          | within($all | of(["Seq($$$_).lazyLines"])))))
          | not_at($all | of(["Seq($SH, \"-c\", \"$$$_\", $$$_)"]))
          | in_files_with($all | of(["import sys.process\n$$$_"]))
          | in_files_without($all | of(["$CMD = \"$$$_\"\n$$$_","\"$$$_\""]))
          | where_capture("SH"; "^(?:\"(sh|bash|ksh|csh|tcsh|zsh)\")")
        | finding("dangerous-shell-run";
            "Found dynamic content used for the external process.") ) )
| report
