# rules: scalac-debug
# from: scala/lang/security/audit/scalac-debug.yaml

. as $root
| ( ($root | scan_regex(["*.sbt*"]; [
      "scalacOptions\\s+[\\s\\S]*?\\s+\"\\-Vdebug\"",
      "scalacOptions\\s+[\\s\\S]*?\\s+\"\\-Ydebug\""
    ])) as $all
    | ( $all | of(["scalacOptions\\s+[\\s\\S]*?\\s+\"\\-Vdebug\"","scalacOptions\\s+[\\s\\S]*?\\s+\"\\-Ydebug\""])
        | finding("scalac-debug";
            "Scala applications built with `debug` set to true in production may leak debug information to attackers.") ) )
| report
