# rules: scalaj-http-ssrf
# languages: scala
# from: scala/lang/security/audit/scalaj-http-ssrf.yaml

. as $root
| ( ($root | scan_ast(["*.scala"]; [
      "Http($URL)",
      "def $FUNC($$$_, $URL: $T, $$$_) = $A {\n  $$$_\n}",
      "def $FUNC($$$_, $URL: $T, $$$_) = {\n  $$$_\n}",
      "import scalaj.http.$HTTP\n$$$_"
    ])) as $all
    | ( $all | of(["Http($URL)"])
          | at_same_place((($all
          | within($all | of(["def $FUNC($$$_, $URL: $T, $$$_) = $A {\n  $$$_\n}"])))
          + ($all
          | within($all | of(["def $FUNC($$$_, $URL: $T, $$$_) = {\n  $$$_\n}"])))))
          | in_files_with($all | of(["import scalaj.http.$HTTP\n$$$_"]))
        | finding("scalaj-http-ssrf";
            "A parameter being passed directly into `Http` can likely lead to SSRF.") ) )
| report
