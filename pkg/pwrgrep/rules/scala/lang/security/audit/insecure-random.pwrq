# rules: insecure-random
# languages: scala
# from: scala/lang/security/audit/insecure-random.yaml

. as $root
| ( ($root | scan_ast(["*.scala"]; [
      "import scala.util.Random"
    ])) as $all
    | ( $all | of(["import scala.util.Random"])
        | finding("insecure-random";
            "Flags the use of a predictable random value from `scala.util.Random`.") ) )
| report
