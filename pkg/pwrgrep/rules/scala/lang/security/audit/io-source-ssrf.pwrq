# rules: io-source-ssrf
# languages: scala
# from: scala/lang/security/audit/io-source-ssrf.yaml

. as $root
| ( ($root | scan_ast(["*.scala"]; [
      "Source.fromURI($URL,$$$_)",
      "Source.fromURL($URL,$$$_)",
      "def $FUNC($$$_, $URL: $T, $$$_) = $A {\n  $$$_\n}",
      "def $FUNC($$$_, $URL: $T, $$$_) = {\n  $$$_\n}",
      "import scala.io.$SOURCE\n$$$_"
    ])) as $all
    | ( $all | of(["Source.fromURL($URL,$$$_)","Source.fromURI($URL,$$$_)"])
          | at_same_place((($all
          | within($all | of(["def $FUNC($$$_, $URL: $T, $$$_) = $A {\n  $$$_\n}"])))
          + ($all
          | within($all | of(["def $FUNC($$$_, $URL: $T, $$$_) = {\n  $$$_\n}"])))))
          | in_files_with($all | of(["import scala.io.$SOURCE\n$$$_"]))
        | finding("io-source-ssrf";
            "A parameter being passed directly into `fromURL` most likely lead to SSRF.") ) )
| report
