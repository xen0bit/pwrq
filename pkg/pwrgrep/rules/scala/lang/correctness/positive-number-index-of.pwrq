# rules: positive-number-index-of
# languages: scala
# from: scala/lang/correctness/positive-number-index-of.yaml

. as $root
| ( ($root | scan_ast(["*.scala"]; [
      "$OBJ.indexOf($$$_) > $VALUE",
      "$OBJ.indexOf($$$_) >= $SMALLERVAL"
    ])) as $all
    | ( ($all | of(["$OBJ.indexOf($$$_) > $VALUE"])
          | where_capture_compare("$VALUE >= 0"))
          + ($all | of(["$OBJ.indexOf($$$_) >= $SMALLERVAL"])
          | where_capture_compare("$SMALLERVAL > 0"))
        | finding("positive-number-index-of";
            "Flags scala code that look for values that are greater than 0.") ) )
| report
