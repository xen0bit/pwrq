# rules: jwt-scala-hardcode
# languages: scala
# from: scala/jwt-scala/security/jwt-scala-hardcode.yaml

. as $root
| ( ($root | scan_ast(["*.scala"]; [
      "$JWT.decode($X, \"$$$_\", $$$_)",
      "$JWT.decode($X, $KEY, $$$_)",
      "$JWT.decode($X, this.$KEY, $$$_)",
      "$JWT.decodeAll($X, \"$$$_\", $$$_)",
      "$JWT.decodeAll($X, $KEY, $$$_)",
      "$JWT.decodeAll($X, this.$KEY, $$$_)",
      "$JWT.decodeJson($X, \"$$$_\", $$$_)",
      "$JWT.decodeJson($X, $KEY, $$$_)",
      "$JWT.decodeJson($X, this.$KEY, $$$_)",
      "$JWT.decodeJsonAll($X, \"$$$_\", $$$_)",
      "$JWT.decodeJsonAll($X, $KEY, $$$_)",
      "$JWT.decodeJsonAll($X, this.$KEY, $$$_)",
      "$JWT.decodeRaw($X, \"$$$_\", $$$_)",
      "$JWT.decodeRaw($X, $KEY, $$$_)",
      "$JWT.decodeRaw($X, this.$KEY, $$$_)",
      "$JWT.decodeRawAll($X, \"$$$_\", $$$_)",
      "$JWT.decodeRawAll($X, $KEY, $$$_)",
      "$JWT.decodeRawAll($X, this.$KEY, $$$_)",
      "$JWT.encode($X, \"$$$_\", $$$_)",
      "$JWT.encode($X, $KEY, $$$_)",
      "$JWT.encode($X, this.$KEY, $$$_)",
      "$JWT.isValid($X, \"$$$_\", $$$_)",
      "$JWT.isValid($X, $KEY, $$$_)",
      "$JWT.isValid($X, this.$KEY, $$$_)",
      "$JWT.validate($X, \"$$$_\", $$$_)",
      "$JWT.validate($X, $KEY, $$$_)",
      "$JWT.validate($X, this.$KEY, $$$_)",
      "class $CL {\n  $$$_\n  $KEY = \"$$$_\"\n  $$$_\n}",
      "import pdi.jwt.$DEPS\n$$$_",
      "object $CL {\n  $$$_\n  $KEY = \"$$$_\"\n  $$$_\n}"
    ])) as $all
    | ( ($all | of(["$JWT.encode($X, \"$$$_\", $$$_)"]))
          + ($all | of(["$JWT.decode($X, \"$$$_\", $$$_)"]))
          + ($all | of(["$JWT.decodeRawAll($X, \"$$$_\", $$$_)"]))
          + ($all | of(["$JWT.decodeRaw($X, \"$$$_\", $$$_)"]))
          + ($all | of(["$JWT.decodeAll($X, \"$$$_\", $$$_)"]))
          + ($all | of(["$JWT.validate($X, \"$$$_\", $$$_)"]))
          + ($all | of(["$JWT.isValid($X, \"$$$_\", $$$_)"]))
          + ($all | of(["$JWT.decodeJson($X, \"$$$_\", $$$_)"]))
          + ($all | of(["$JWT.decodeJsonAll($X, \"$$$_\", $$$_)"]))
          + ($all | of(["$JWT.encode($X, $KEY, $$$_)","$JWT.decode($X, $KEY, $$$_)","$JWT.decodeRawAll($X, $KEY, $$$_)","$JWT.decodeRaw($X, $KEY, $$$_)","$JWT.decodeAll($X, $KEY, $$$_)","$JWT.validate($X, $KEY, $$$_)","$JWT.isValid($X, $KEY, $$$_)","$JWT.decodeJson($X, $KEY, $$$_)","$JWT.decodeJsonAll($X, $KEY, $$$_)","$JWT.encode($X, this.$KEY, $$$_)","$JWT.decode($X, this.$KEY, $$$_)","$JWT.decodeRawAll($X, this.$KEY, $$$_)","$JWT.decodeRaw($X, this.$KEY, $$$_)","$JWT.decodeAll($X, this.$KEY, $$$_)","$JWT.validate($X, this.$KEY, $$$_)","$JWT.isValid($X, this.$KEY, $$$_)","$JWT.decodeJson($X, this.$KEY, $$$_)","$JWT.decodeJsonAll($X, this.$KEY, $$$_)"])
          | at_same_place((($all
          | within($all | of(["class $CL {\n  $$$_\n  $KEY = \"$$$_\"\n  $$$_\n}"])))
          + ($all
          | within($all | of(["object $CL {\n  $$$_\n  $KEY = \"$$$_\"\n  $$$_\n}"]))))))
          | in_files_with($all | of(["import pdi.jwt.$DEPS\n$$$_"]))
        | finding("jwt-scala-hardcode";
            "Hardcoded JWT secret or private key is used.") ) )
| report
