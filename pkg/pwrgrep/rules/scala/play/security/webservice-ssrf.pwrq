# rules: webservice-ssrf
# languages: scala
# from: scala/play/security/webservice-ssrf.yaml

. as $root
| ( ($root | scan_ast(["*.scala"]; [
      "$WS = AhcWSClient($$$_)\n$$$_",
      "$WS.url($URL)",
      "class $CLASS ($$$_, $WS: WSClient, $$$_) {\n  $$$_\n}",
      "def $FUNC($$$_, $URL: $T, $$$_) = $A {\n  $$$_\n}",
      "def $FUNC($$$_, $URL: $T, $$$_) = {\n  $$$_\n}",
      "def $FUNC($$$_, $WS: WSClient, $$$_) = {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["$WS.url($URL)"])
          | at_same_place((($all
          | within($all | of(["class $CLASS ($$$_, $WS: WSClient, $$$_) {\n  $$$_\n}"])))
          + ($all
          | within($all | of(["def $FUNC($$$_, $WS: WSClient, $$$_) = {\n  $$$_\n}"])))
          + ($all
          | in_files_with($all | of(["$WS = AhcWSClient($$$_)\n$$$_"])))))
          | at_same_place((($all
          | within($all | of(["def $FUNC($$$_, $URL: $T, $$$_) = $A {\n  $$$_\n}"])))
          + ($all
          | within($all | of(["def $FUNC($$$_, $URL: $T, $$$_) = {\n  $$$_\n}"])))))
        | finding("webservice-ssrf";
            "A parameter being passed directly into `WSClient` most likely lead to SSRF.") ) )
| report
