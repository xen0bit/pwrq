# rules: scala-slick-overrideSql-literal
# languages: scala
# from: scala/slick/security/scala-slick-overrideSql-literal.yaml

. as $root
| ( ($root | scan_ast(["*.scala"]; [
      "\"$$$_\"",
      "$MODEL.overrideSql(\"$$$_\",$$$_)",
      "$MODEL.overrideSql($QUERY,$$$_)",
      "$QUERY = \"$$$_\"\n$$$_"
    ])) as $all
    | ( $all | of(["$MODEL.overrideSql($QUERY,$$$_)"])
          | not_at($all | of(["$MODEL.overrideSql(\"$$$_\",$$$_)"]))
          | in_files_without($all | of(["$QUERY = \"$$$_\"\n$$$_","\"$$$_\""]))
        | finding("scala-slick-overrideSql-literal";
            "Detected a formatted string in a SQL statement.") ) )
| report
