# rules: scala-jwt-hardcoded-secret
# languages: scala
# from: scala/scala-jwt/security/jwt-hardcode.yaml

. as $root
| ( ($root | scan_ast(["*.scala"]; [
      "$SECRET = \"$$$_\";\n$$$_\ncom.auth0.jwt.algorithms.Algorithm.HMAC256($SECRET);",
      "$SECRET = \"$$$_\";\n$$$_\ncom.auth0.jwt.algorithms.Algorithm.HMAC384($SECRET);",
      "$SECRET = \"$$$_\";\n$$$_\ncom.auth0.jwt.algorithms.Algorithm.HMAC512($SECRET);",
      "class $CLASS {\n  $$$_\n  $DECL $SECRET = \"$$$_\";\n  $$$_\n  def $FUNC ($$$_): $RETURNTYPE = {\n    $$$_\n    com.auth0.jwt.algorithms.Algorithm.HMAC256($SECRET);\n    $$$_\n  }\n  $$$_\n}",
      "class $CLASS {\n  $$$_\n  $DECL $SECRET = \"$$$_\";\n  $$$_\n  def $FUNC ($$$_): $RETURNTYPE = {\n    $$$_\n    com.auth0.jwt.algorithms.Algorithm.HMAC384($SECRET);\n    $$$_\n  }\n  $$$_\n}",
      "class $CLASS {\n  $$$_\n  $DECL $SECRET = \"$$$_\";\n  $$$_\n  def $FUNC ($$$_): $RETURNTYPE = {\n    $$$_\n    com.auth0.jwt.algorithms.Algorithm.HMAC512($SECRET);\n    $$$_\n  }\n  $$$_\n}",
      "com.auth0.jwt.algorithms.Algorithm.HMAC256(\"$$$_\");",
      "com.auth0.jwt.algorithms.Algorithm.HMAC384(\"$$$_\");",
      "com.auth0.jwt.algorithms.Algorithm.HMAC512(\"$$$_\");"
    ])) as $all
    | ( $all | of(["com.auth0.jwt.algorithms.Algorithm.HMAC256(\"$$$_\");","$SECRET = \"$$$_\";\n$$$_\ncom.auth0.jwt.algorithms.Algorithm.HMAC256($SECRET);","class $CLASS {\n  $$$_\n  $DECL $SECRET = \"$$$_\";\n  $$$_\n  def $FUNC ($$$_): $RETURNTYPE = {\n    $$$_\n    com.auth0.jwt.algorithms.Algorithm.HMAC256($SECRET);\n    $$$_\n  }\n  $$$_\n}","com.auth0.jwt.algorithms.Algorithm.HMAC384(\"$$$_\");","$SECRET = \"$$$_\";\n$$$_\ncom.auth0.jwt.algorithms.Algorithm.HMAC384($SECRET);","class $CLASS {\n  $$$_\n  $DECL $SECRET = \"$$$_\";\n  $$$_\n  def $FUNC ($$$_): $RETURNTYPE = {\n    $$$_\n    com.auth0.jwt.algorithms.Algorithm.HMAC384($SECRET);\n    $$$_\n  }\n  $$$_\n}","com.auth0.jwt.algorithms.Algorithm.HMAC512(\"$$$_\");","$SECRET = \"$$$_\";\n$$$_\ncom.auth0.jwt.algorithms.Algorithm.HMAC512($SECRET);","class $CLASS {\n  $$$_\n  $DECL $SECRET = \"$$$_\";\n  $$$_\n  def $FUNC ($$$_): $RETURNTYPE = {\n    $$$_\n    com.auth0.jwt.algorithms.Algorithm.HMAC512($SECRET);\n    $$$_\n  }\n  $$$_\n}"])
        | finding("scala-jwt-hardcoded-secret";
            "Hardcoded JWT secret or private key is used.") ) )
| report
