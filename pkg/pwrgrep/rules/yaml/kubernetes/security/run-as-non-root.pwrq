# rules: run-as-non-root
# from: yaml/kubernetes/security/run-as-non-root.yaml

. as $root
| ( ($root | scan_regex(["*.yaml"]; [
      "(?P<SPEC>\\S+):\\s+[\\s\\S]*?\\s+containers:\\s+[\\s\\S]*?",
      "(?P<SPEC>\\S+):\\s+[\\s\\S]*?\\s+containers:\\s+[\\s\\S]*?\\s+[\\s\\S]*?",
      "(?P<SPEC>\\S+):\\s+[\\s\\S]*?\\s+containers:\\s+[\\s\\S]*?\\s+\\-\\s+name:\\s+(?P<NAME>\\S+)\\s+image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+securityContext:\\s+[\\s\\S]*?\\s+runAsNonRoot:\\s+(?P<VALUE>\\S+)",
      "spec:\\s+[\\s\\S]*?\\s+securityContext:\\s+[\\s\\S]*?\\s+[\\s\\S]*?"
    ])) as $all
    | ( $all
          | within($all | of(["(?P<SPEC>\\S+):\\s+[\\s\\S]*?\\s+containers:\\s+[\\s\\S]*?\\s+[\\s\\S]*?"]))
          | where_capture("SPEC"; "^(spec)$")
          | outside($all | of(["spec:\\s+[\\s\\S]*?\\s+securityContext:\\s+[\\s\\S]*?\\s+[\\s\\S]*?"]))
          | within($all | of(["(?P<SPEC>\\S+):\\s+[\\s\\S]*?\\s+containers:\\s+[\\s\\S]*?"]))
          | outside($all | of(["(?P<SPEC>\\S+):\\s+[\\s\\S]*?\\s+containers:\\s+[\\s\\S]*?\\s+\\-\\s+name:\\s+(?P<NAME>\\S+)\\s+image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+securityContext:\\s+[\\s\\S]*?\\s+runAsNonRoot:\\s+(?P<VALUE>\\S+)"]))
          | focus("SPEC")
        | finding("run-as-non-root";
            "When running containers in Kubernetes, it's important to ensure that they are properly secured to prevent privilege escalation attacks.") ) )
| report
