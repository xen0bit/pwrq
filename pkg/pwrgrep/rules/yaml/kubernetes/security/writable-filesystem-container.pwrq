# rules: writable-filesystem-container
# from: yaml/kubernetes/security/writable-filesystem-container.yaml

. as $root
| ( ($root | scan_regex(["*.yaml"]; [
      "\\-\\s+name:\\s+(?P<CONTAINER>\\S+)\\s+[\\s\\S]*?",
      "containers:\\s+[\\s\\S]*?",
      "image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?",
      "image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+securityContext:\\s+[\\s\\S]*?\\s+readOnlyRootFilesystem:\\s+true"
    ])) as $all
    | ( $all | of(["image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?"])
          | within($all | of(["containers:\\s+[\\s\\S]*?"]))
          | within($all | of(["\\-\\s+name:\\s+(?P<CONTAINER>\\S+)\\s+[\\s\\S]*?"]))
          | not_at($all | of(["image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+securityContext:\\s+[\\s\\S]*?\\s+readOnlyRootFilesystem:\\s+true"]))
          | focus("CONTAINER")
        | finding("writable-filesystem-container";
            "Container $CONTAINER is running with a writable root filesystem.") ) )
| report
