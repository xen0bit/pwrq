# rules: run-as-non-root-unsafe-value
# from: yaml/kubernetes/security/run-as-non-root-unsafe-value.yaml

. as $root
| ( ($root | scan_regex(["*.yaml"]; [
      "containers:\\s+[\\s\\S]*?",
      "image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+securityContext:\\s+[\\s\\S]*?\\s+runAsNonRoot:\\s+(?P<VALUE>\\S+)",
      "spec:\\s+[\\s\\S]*?\\s+securityContext:\\s+[\\s\\S]*?\\s+runAsNonRoot:\\s+(?P<VALUE>\\S+)"
    ])) as $all
    | ( ($all | of(["spec:\\s+[\\s\\S]*?\\s+securityContext:\\s+[\\s\\S]*?\\s+runAsNonRoot:\\s+(?P<VALUE>\\S+)"]))
          + ($all | of(["image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+securityContext:\\s+[\\s\\S]*?\\s+runAsNonRoot:\\s+(?P<VALUE>\\S+)"])
          | within($all | of(["containers:\\s+[\\s\\S]*?"])))
          | where_capture_ast("VALUE"; "false")
          | focus("VALUE")
        | finding("run-as-non-root-unsafe-value";
            "When running containers in Kubernetes, it's important to ensure that they are properly secured to prevent privilege escalation attacks.") ) )
| report
