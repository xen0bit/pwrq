# rules: exposing-docker-socket-hostpath
# from: yaml/kubernetes/security/exposing-docker-socket-hostpath.yaml

. as $root
| ( ($root | scan_regex(["*.yaml"]; [
      "hostPath:\\s+[\\s\\S]*?\\s+path:\\s+\\/var\\/run\\/docker\\.sock",
      "volumes:\\s+[\\s\\S]*?"
    ])) as $all
    | ( $all | of(["hostPath:\\s+[\\s\\S]*?\\s+path:\\s+\\/var\\/run\\/docker\\.sock"])
          | within($all | of(["volumes:\\s+[\\s\\S]*?"]))
        | finding("exposing-docker-socket-hostpath";
            "Exposing host's Docker socket to containers via a volume.") ) )
| report
