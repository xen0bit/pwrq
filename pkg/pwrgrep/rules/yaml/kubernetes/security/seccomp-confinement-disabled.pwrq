# rules: seccomp-confinement-disabled
# from: yaml/kubernetes/security/seccomp-confinement-disabled.yaml

. as $root
| ( ($root | scan_regex(["*.yaml"]; [
      "containers:\\s+[\\s\\S]*?",
      "image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+securityContext:\\s+[\\s\\S]*?\\s+seccompProfile:\\s+unconfined"
    ])) as $all
    | ( $all | of(["image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+securityContext:\\s+[\\s\\S]*?\\s+seccompProfile:\\s+unconfined"])
          | within($all | of(["containers:\\s+[\\s\\S]*?"]))
        | finding("seccomp-confinement-disabled";
            "Container is explicitly disabling seccomp confinement.") ) )
| report
