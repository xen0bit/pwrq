# rules: hostipc-pod
# from: yaml/kubernetes/security/hostipc-pod.yaml

. as $root
| ( ($root | scan_regex(["*.yaml"]; [
      "hostIPC:\\s+true",
      "spec:\\s+[\\s\\S]*?"
    ])) as $all
    | ( $all | of(["hostIPC:\\s+true"])
          | within($all | of(["spec:\\s+[\\s\\S]*?"]))
        | finding("hostipc-pod";
            "Pod is sharing the host IPC namespace.") ) )
| report
