# rules: allow-privilege-escalation-true
# from: yaml/kubernetes/security/allow-privilege-escalation-true.yaml

. as $root
| ( ($root | scan_regex(["*.yaml"]; [
      "\\-\\s+name:\\s+(?P<CONTAINER>\\S+)\\s+[\\s\\S]*?",
      "allowPrivilegeEscalation:\\s+(?P<TRUE>\\S+)",
      "containers:\\s+[\\s\\S]*?",
      "image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?",
      "securityContext:\\s+[\\s\\S]*?"
    ])) as $all
    | ( $all | of(["allowPrivilegeEscalation:\\s+(?P<TRUE>\\S+)"])
          | within($all | of(["containers:\\s+[\\s\\S]*?"]))
          | within($all | of(["\\-\\s+name:\\s+(?P<CONTAINER>\\S+)\\s+[\\s\\S]*?"]))
          | in_files_with($all | of(["image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?"]))
          | within($all | of(["securityContext:\\s+[\\s\\S]*?"]))
          | where_capture_ast("TRUE"; "true")
          | focus("TRUE")
        | finding("allow-privilege-escalation-true";
            "In Kubernetes, each pod runs in its own isolated environment with its own set of security policies.") ) )
| report
