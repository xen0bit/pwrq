# rules: allow-privilege-escalation
# from: yaml/kubernetes/security/allow-privilege-escalation.yaml

. as $root
| ( ($root | scan_regex(["*.yaml"]; [
      "\\-\\s+name:\\s+(?P<CONTAINER>\\S+)\\s+[\\s\\S]*?",
      "containers:\\s+[\\s\\S]*?",
      "image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?",
      "image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+(?P<SC>\\S+):\\s+[\\s\\S]*?",
      "image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+securityContext:\\s+[\\s\\S]*?\\s+allowPrivilegeEscalation:\\s+(?P<VAL>\\S+)"
    ])) as $all
    | ( $all | of(["image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?"])
          | within($all | of(["containers:\\s+[\\s\\S]*?"]))
          | within($all | of(["\\-\\s+name:\\s+(?P<CONTAINER>\\S+)\\s+[\\s\\S]*?"]))
          | within($all | of(["image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+(?P<SC>\\S+):\\s+[\\s\\S]*?"]))
          | where_capture("SC"; "^(securityContext)$")
          | outside($all | of(["image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+securityContext:\\s+[\\s\\S]*?\\s+allowPrivilegeEscalation:\\s+(?P<VAL>\\S+)"]))
          | focus("SC")
        | finding("allow-privilege-escalation";
            "In Kubernetes, each pod runs in its own isolated environment with its own set of security policies.") ) )
| report
