# rules: hostnetwork-pod
# from: yaml/kubernetes/security/hostnetwork-pod.yaml

. as $root
| ( ($root | scan_regex(["*.yaml"]; [
      "hostNetwork:\\s+true",
      "spec:\\s+[\\s\\S]*?"
    ])) as $all
    | ( $all | of(["hostNetwork:\\s+true"])
          | within($all | of(["spec:\\s+[\\s\\S]*?"]))
        | finding("hostnetwork-pod";
            "Pod may use the node network namespace.") ) )
| report
