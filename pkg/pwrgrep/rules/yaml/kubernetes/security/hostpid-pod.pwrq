# rules: hostpid-pod
# from: yaml/kubernetes/security/hostpid-pod.yaml

. as $root
| ( ($root | scan_regex(["*.yaml"]; [
      "hostPID:\\s+true",
      "spec:\\s+[\\s\\S]*?"
    ])) as $all
    | ( $all | of(["hostPID:\\s+true"])
          | within($all | of(["spec:\\s+[\\s\\S]*?"]))
        | finding("hostpid-pod";
            "Pod is sharing the host process ID namespace.") ) )
| report
