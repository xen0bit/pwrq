# rules: allow-privilege-escalation-no-securitycontext
# from: yaml/kubernetes/security/allow-privilege-escalation-no-securitycontext.yaml

. as $root
| ( ($root | scan_regex(["*.yaml"]; [
      "\\-\\s+(?P<NAME>\\S+):\\s+(?P<CONTAINER>\\S+)\\s+[\\s\\S]*?",
      "containers:\\s+[\\s\\S]*?",
      "image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?",
      "image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+securityContext:\\s+[\\s\\S]*?"
    ])) as $all
    | ( $all | of(["image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?"])
          | within($all | of(["containers:\\s+[\\s\\S]*?"]))
          | within($all | of(["\\-\\s+(?P<NAME>\\S+):\\s+(?P<CONTAINER>\\S+)\\s+[\\s\\S]*?"]))
          | not_at($all | of(["image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+securityContext:\\s+[\\s\\S]*?"]))
          | where_capture("NAME"; "^(?:name)")
          | focus("NAME")
        | finding("allow-privilege-escalation-no-securitycontext";
            "In Kubernetes, each pod runs in its own isolated environment with its own set of security policies.") ) )
| report
