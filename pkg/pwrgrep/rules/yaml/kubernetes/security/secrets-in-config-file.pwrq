# rules: secrets-in-config-file
# languages: yaml
# from: yaml/kubernetes/security/secrets-in-config-file.yaml

. as $root
| ( ($root | scan_ast(["*.yaml"]; [
      "$KEY: $VALUE",
      "data: $$$_",
      "kind: Secret\n$$$_"
    ])) as $all
    | ( $all | of(["$KEY: $VALUE"])
          | within($all | of(["data: $$$_"]))
          | in_files_with($all | of(["kind: Secret\n$$$_"]))
          | where_capture("VALUE"; "^(?:(?i)^[aA-zZ0-9+/]+={0,2}$)")
          | where_capture_entropy("VALUE")
        | finding("secrets-in-config-file";
            "Secrets ($VALUE) should not be stored in infrastructure as code files.") ) )
| report
