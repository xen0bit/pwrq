# rules: run-as-non-root-container-level
# from: yaml/kubernetes/security/run-as-non-root-container-level.yaml

. as $root
| ( ($root | scan_regex(["*.yaml"]; [
      "\\-\\s+name:\\s+(?P<CONTAINER>\\S+)\\s+image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+(?P<SC>\\S+):\\s+[\\s\\S]*?",
      "\\-\\s+name:\\s+(?P<CONTAINER>\\S+)\\s+image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+securityContext:\\s+[\\s\\S]*?\\s+runAsNonRoot:\\s+(?P<VALUE>\\S+)",
      "spec:\\s+[\\s\\S]*?\\s+containers:\\s+[\\s\\S]*?",
      "spec:\\s+[\\s\\S]*?\\s+containers:\\s+[\\s\\S]*?\\s+[\\s\\S]*?",
      "spec:\\s+[\\s\\S]*?\\s+containers:\\s+[\\s\\S]*?\\s+\\-\\s+name:\\s+(?P<NAME>\\S+)\\s+image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+securityContext:\\s+[\\s\\S]*?\\s+runAsNonRoot:\\s+(?P<VALUE>\\S+)",
      "spec:\\s+[\\s\\S]*?\\s+securityContext:\\s+[\\s\\S]*?\\s+runAsNonRoot:\\s+(?P<VAL>\\S+)\\s+[\\s\\S]*?"
    ])) as $all
    | ( $all | of(["\\-\\s+name:\\s+(?P<CONTAINER>\\S+)\\s+image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+(?P<SC>\\S+):\\s+[\\s\\S]*?"])
          | within($all | of(["spec:\\s+[\\s\\S]*?\\s+containers:\\s+[\\s\\S]*?\\s+[\\s\\S]*?"]))
          | outside($all | of(["spec:\\s+[\\s\\S]*?\\s+securityContext:\\s+[\\s\\S]*?\\s+runAsNonRoot:\\s+(?P<VAL>\\S+)\\s+[\\s\\S]*?"]))
          | within($all | of(["spec:\\s+[\\s\\S]*?\\s+containers:\\s+[\\s\\S]*?"]))
          | within($all | of(["spec:\\s+[\\s\\S]*?\\s+containers:\\s+[\\s\\S]*?\\s+\\-\\s+name:\\s+(?P<NAME>\\S+)\\s+image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+securityContext:\\s+[\\s\\S]*?\\s+runAsNonRoot:\\s+(?P<VALUE>\\S+)"]))
          | where_capture("SC"; "^(securityContext)$")
          | not_at($all | of(["\\-\\s+name:\\s+(?P<CONTAINER>\\S+)\\s+image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+securityContext:\\s+[\\s\\S]*?\\s+runAsNonRoot:\\s+(?P<VALUE>\\S+)"]))
          | focus("SC")
        | finding("run-as-non-root-container-level";
            "When running containers in Kubernetes, it's important to ensure that they are properly secured to prevent privilege escalation attacks.") ) )
| report
