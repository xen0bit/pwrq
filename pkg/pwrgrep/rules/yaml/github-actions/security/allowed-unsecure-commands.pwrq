# rules: allowed-unsecure-commands
# languages: yaml
# from: yaml/github-actions/security/allowed-unsecure-commands.yaml

. as $root
| ( ($root | scan_ast(["*.yaml"]; [
      "ACTIONS_ALLOW_UNSECURE_COMMANDS: true",
      "{env: $$$_}"
    ])) as $all
    | ( ($all | of(["ACTIONS_ALLOW_UNSECURE_COMMANDS: true"])
          | within($all | of(["{env: $$$_}"])))
        | finding("allowed-unsecure-commands";
            "The environment variable `ACTIONS_ALLOW_UNSECURE_COMMANDS` grants this workflow permissions to use the `set-env` and `add-path` commands.") ) )
| report
