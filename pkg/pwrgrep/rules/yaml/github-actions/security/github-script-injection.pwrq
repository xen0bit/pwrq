# rules: github-script-injection
# languages: yaml
# from: yaml/github-actions/security/github-script-injection.yaml

. as $root
| ( ($root | scan_ast(["*.yaml"]; [
      "script: $SHELL",
      "steps: [$$$_]",
      "uses: $ACTION\n$$$_",
      "with:\n  $$$_\n  script: $$$_\n  $$$_"
    ])) as $all
    | ( $all | of(["script: $SHELL"])
          | within($all | of(["steps: [$$$_]"]))
          | in_files_with($all | of(["uses: $ACTION\n$$$_"]))
          | within($all | of(["with:\n  $$$_\n  script: $$$_\n  $$$_"]))
          | where_capture("ACTION"; "^(?:actions/github-script@.*)")
        | finding("github-script-injection";
            "Using variable interpolation `${{...}}` with `github` context data in a `actions/github-script`'s `script:` step could allow an attacker to inject their own code into the runner.") ) )
| report
