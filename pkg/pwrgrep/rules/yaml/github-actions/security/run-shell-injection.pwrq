# rules: run-shell-injection
# languages: yaml
# from: yaml/github-actions/security/run-shell-injection.yaml

. as $root
| ( ($root | scan_ast(["*.yaml"]; [
      "- run: $$$_\n  $$$_",
      "run: $SHELL",
      "steps: [$$$_]"
    ])) as $all
    | ( $all | of(["run: $SHELL"])
          | within($all | of(["steps: [$$$_]"]))
          | within($all | of(["- run: $$$_\n  $$$_"]))
        | finding("run-shell-injection";
            "Using variable interpolation `${{...}}` with `github` context data in a `run:` step could allow an attacker to inject their own code into the runner.") ) )
| report
