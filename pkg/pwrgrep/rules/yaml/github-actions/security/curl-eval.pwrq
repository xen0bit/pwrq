# rules: curl-eval
# languages: yaml
# from: yaml/github-actions/security/curl-eval.yaml

. as $root
| ( ($root | scan_ast(["*.yaml"]; [
      "- run: $$$_\n  $$$_",
      "run: $SHELL",
      "steps: [$$$_]"
    ])) as $all
    | ( $all | of(["run: $SHELL"])
          | within($all | of(["steps: [$$$_]"]))
          | within($all | of(["- run: $$$_\n  $$$_"]))
        | finding("curl-eval";
            "Data is being eval'd from a `curl` command.") ) )
| report
