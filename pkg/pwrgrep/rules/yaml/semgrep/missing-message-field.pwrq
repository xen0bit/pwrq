# rules: missing-message-field
# from: yaml/semgrep/missing-message-field.yaml

. as $root
| ( ($root | scan_regex(["*.yaml"]; [
      "\\-\\s+[\\s\\S]*?\\s+message:\\s+[\\s\\S]*?",
      "\\-\\s+[\\s\\S]*?\\s+mode:\\s+extract",
      "id:\\s+(?P<RULEID>\\S+)",
      "rules:\\s+\\[[\\s\\S]*?,\\s+(?P<RULE>\\S+),\\s+[\\s\\S]*?\\]"
    ])) as $all
    | ( $all | of(["id:\\s+(?P<RULEID>\\S+)"])
          | within($all | of(["rules:\\s+\\[[\\s\\S]*?,\\s+(?P<RULE>\\S+),\\s+[\\s\\S]*?\\]"]))
          | outside($all | of(["\\-\\s+[\\s\\S]*?\\s+message:\\s+[\\s\\S]*?"]))
          | outside($all | of(["\\-\\s+[\\s\\S]*?\\s+mode:\\s+extract"]))
        | finding("missing-message-field";
            "This rule does not have a message.") ) )
| report
