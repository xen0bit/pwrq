# rules: slow-pattern-general-func
# languages: yaml
# from: yaml/semgrep/slow-pattern-general-function.yaml

. as $root
| ( ($root | scan_ast(["*.yaml"]; [
      "\"javascript\"",
      "\"typescript\"",
      "languages: [$$$_,\"javascript\",$$$_]\n$$$_",
      "languages: [$$$_,\"typescript\",$$$_]\n$$$_",
      "pattern-inside: $X",
      "pattern-not-inside: $X",
      "pattern-not: $X",
      "pattern: $X"
    ])) as $all
    | ( ($all
          | within($all | of(["pattern-inside: $X"])))
          + ($all
          | within($all | of(["pattern-not-inside: $X"])))
          + ($all
          | within($all | of(["pattern: $X"])))
          + ($all
          | within($all | of(["pattern-not: $X"])))
          | at_same_place((($all
          | in_files_with($all | of(["languages: [$$$_,\"javascript\",$$$_]\n$$$_","\"javascript\""])))
          + ($all
          | in_files_with($all | of(["languages: [$$$_,\"typescript\",$$$_]\n$$$_","\"typescript\""])))))
          | where_text("function[^{]*{[\\s\\n]*\\.\\.\\.[\\s\\n]*}")
        | finding("slow-pattern-general-func";
            "Using patterns like `function (...) {...}` is too general it will probably slow down the rule performance.") ) )
| report
