# rules: half-written-crypto-example
# from: yaml/semgrep/message-whitespace.test.yaml

. as $root
| ( ($root | scan_ast(["*.js"]; [
      "createCipheriv($ALGO, $KEY, $IV);"
    ])) as $all
    | ( $all | of(["createCipheriv($ALGO, $KEY, $IV);"])
        | finding("half-written-crypto-example";
            "# ruleid: message-whitespace-check Semgrep found a match # ruleid: message-whitespace-check I like big space") ) )
| report
