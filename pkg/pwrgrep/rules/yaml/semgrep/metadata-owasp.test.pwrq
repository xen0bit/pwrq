# rules: example-1, example-1b, example-k8s-1, example-k8s-1b, example-bad-zero, example-bad-double-zero-year, example-bad-missing-leading-zero, example-bad-greater-than-10, example-bad-missing-details, example-bad-missing-colon, example-good-list, example-bad-list
# from: yaml/semgrep/metadata-owasp.test.yaml

. as $root
| ( ($root | scan_ast(["*.json","*.yaml"]; [
      "$$$_"
    ])) as $all
    | ( $all | of(["$$$_"])
        | finding("example-1";
            "Example") )
      + ( $all | of(["$$$_"])
        | finding("example-1b";
            "Example") )
      + ( $all | of(["$$$_"])
        | finding("example-k8s-1";
            "Example") )
      + ( $all | of(["$$$_"])
        | finding("example-k8s-1b";
            "Example") )
      + ( $all | of(["$$$_"])
        | finding("example-bad-zero";
            "Example") )
      + ( $all | of(["$$$_"])
        | finding("example-bad-double-zero-year";
            "Example") )
      + ( $all | of(["$$$_"])
        | finding("example-bad-missing-leading-zero";
            "Example") )
      + ( $all | of(["$$$_"])
        | finding("example-bad-greater-than-10";
            "Example") )
      + ( $all | of(["$$$_"])
        | finding("example-bad-missing-details";
            "Example") )
      + ( $all | of(["$$$_"])
        | finding("example-bad-missing-colon";
            "Example") )
      + ( $all | of(["$$$_"])
        | finding("example-good-list";
            "Example") )
      + ( $all | of(["$$$_"])
        | finding("example-bad-list";
            "Example") ) )
| report
