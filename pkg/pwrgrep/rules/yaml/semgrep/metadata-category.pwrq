# rules: metadata-category
# from: yaml/semgrep/metadata-category.yaml

. as $root
| ( ($root | scan_regex(["*.yaml"]; [
      "\\-\\s+[\\s\\S]*?\\s+metadata:\\s+[\\s\\S]*?\\s+category:\\s+(?P<CATEGORY>\\S+)",
      "id:\\s+(?P<RULEID>\\S+)",
      "rules:\\s+\\[[\\s\\S]*?,\\s+(?P<RULE>\\S+),\\s+[\\s\\S]*?\\]"
    ])) as $all
    | ( $all | of(["id:\\s+(?P<RULEID>\\S+)"])
          | within($all | of(["rules:\\s+\\[[\\s\\S]*?,\\s+(?P<RULE>\\S+),\\s+[\\s\\S]*?\\]"]))
          | outside($all | of(["\\-\\s+[\\s\\S]*?\\s+metadata:\\s+[\\s\\S]*?\\s+category:\\s+(?P<CATEGORY>\\S+)"]))
        | finding("metadata-category";
            "This Semgrep rule is missing a valid 'category' field in the 'metadata'.") ) )
| report
