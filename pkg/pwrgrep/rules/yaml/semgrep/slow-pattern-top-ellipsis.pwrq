# rules: slow-pattern-top-ellipsis
# languages: yaml
# from: yaml/semgrep/slow-pattern-top-ellipsis.yaml

. as $root
| ( ($root | scan_ast(["*.yaml"]; [
      "pattern-inside: $X",
      "pattern-not-inside: $X",
      "pattern-not: $X",
      "pattern: $X"
    ])) as $all
    | ( ($all
          | within($all | of(["pattern-inside: $X"])))
          + ($all
          | within($all | of(["pattern-not-inside: $X"])))
          + ($all
          | within($all | of(["pattern: $X"])))
          + ($all
          | within($all | of(["pattern-not: $X"])))
          | where_text("\\|\\s*\\n\\s*\\.\\.\\.\\s*\\n[^\\n]*\\n\\s*\\.\\.\\.")
        | finding("slow-pattern-top-ellipsis";
            "Using the ellipsis operator `...` at the top of the pattern drastically slows down the rule performance.") ) )
| report
