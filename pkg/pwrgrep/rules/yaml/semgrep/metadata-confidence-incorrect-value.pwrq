# rules: metadata-confidence-incorrect-value
# from: yaml/semgrep/metadata-confidence-incorrect-value.yaml

. as $root
| ( ($root | scan_regex(["*.yaml"]; [
      "confidence:\\s+(?P<VALUE>\\S+)",
      "confidence:\\s+HIGH",
      "confidence:\\s+LOW",
      "confidence:\\s+MEDIUM",
      "metadata:\\s+[\\s\\S]*?\\s+category:\\s+security\\s+[\\s\\S]*?",
      "rules:\\s+[\\s\\S]*?"
    ])) as $all
    | ( $all | of(["confidence:\\s+(?P<VALUE>\\S+)"])
          | within($all | of(["rules:\\s+[\\s\\S]*?"]))
          | within($all | of(["metadata:\\s+[\\s\\S]*?\\s+category:\\s+security\\s+[\\s\\S]*?"]))
          | not_at($all | of(["confidence:\\s+LOW"]))
          | not_at($all | of(["confidence:\\s+MEDIUM"]))
          | not_at($all | of(["confidence:\\s+HIGH"]))
        | finding("metadata-confidence-incorrect-value";
            "Semgrep rule confidence: $VALUE detected, but the value must be LOW, MEDIUM, or HIGH.") ) )
| report
