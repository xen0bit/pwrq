# rules: empty-message
# languages: yaml
# from: yaml/semgrep/empty-message.yaml

. as $root
| ( ($root | scan_ast(["*.yaml"]; [
      "message: \"\"",
      "rules: [$$$_, $RULE, $$$_]"
    ])) as $all
    | ( $all | of(["message: \"\""])
          | within($all | of(["rules: [$$$_, $RULE, $$$_]"]))
        | finding("empty-message";
            "This rule has an empty message field.") ) )
| report
