# rules: metadata-impact
# from: yaml/semgrep/metadata-impact.yaml

. as $root
| ( ($root | scan_ast(["*.yaml"]; [
      "metadata: \n  $$$_\n  category: security\n  $$$_",
      "metadata: \n  $$$_\n  impact: $VALUE",
      "rules: \n  $$$_"
    ])) as $all
    | ( $all
          | within($all | of(["rules: \n  $$$_"]))
          | within($all | of(["metadata: \n  $$$_\n  category: security\n  $$$_"]))
          | outside($all | of(["metadata: \n  $$$_\n  impact: $VALUE"]))
        | finding("metadata-impact";
            "This Semgrep rule is missing a valid 'impact' field in the 'metadata'.") ) )
| report
