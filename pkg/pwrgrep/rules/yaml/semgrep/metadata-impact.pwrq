# rules: metadata-impact
# from: yaml/semgrep/metadata-impact.yaml

. as $root
| ( ($root | scan_regex(["*.yaml"]; [
      "metadata:\\s+[\\s\\S]*?\\s+category:\\s+security\\s+[\\s\\S]*?",
      "metadata:\\s+[\\s\\S]*?\\s+impact:\\s+(?P<VALUE>\\S+)",
      "rules:\\s+[\\s\\S]*?"
    ])) as $all
    | ( $all
          | within($all | of(["rules:\\s+[\\s\\S]*?"]))
          | within($all | of(["metadata:\\s+[\\s\\S]*?\\s+category:\\s+security\\s+[\\s\\S]*?"]))
          | outside($all | of(["metadata:\\s+[\\s\\S]*?\\s+impact:\\s+(?P<VALUE>\\S+)"]))
        | finding("metadata-impact";
            "This Semgrep rule is missing a valid 'impact' field in the 'metadata'.") ) )
| report
