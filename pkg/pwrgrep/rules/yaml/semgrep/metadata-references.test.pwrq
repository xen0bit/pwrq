# rules: example-1, example-2
# from: yaml/semgrep/metadata-references.test.yaml

. as $root
| ( ($root | scan_ast(["*.json","*.yaml"]; [
      "$$$_"
    ])) as $all
    | ( $all | of(["$$$_"])
        | finding("example-1";
            "Example") )
      + ( $all | of(["$$$_"])
        | finding("example-2";
            "Example") ) )
| report
