# rules: javascript.phantom.security.audit.phantom-injection.phantom-injection, javascript.playwright.security.audit.playwright-evaluate-arg-injection.playwright-evaluate-arg-injection
# from: yaml/semgrep/slow-pattern-top-ellipsis.test.yaml

. as $root
| ( ($root | scan_ast(["*.js"]; [
      "\"$$$_\"",
      "$$$_\n$PHANTOM = require('phantom');\n$$$_",
      "$$$_\nrequire('playwright');\n$$$_",
      "function $FUNC ($$$_,$INPUT,$$$_) {$$$_}",
      "function ($$$_,$INPUT,$$$_) {$$$_}",
      "var $INPUT = \"$$$_\";\n$$$_"
    ])) as $all
    | ( $all | of(["$$$_\n$PHANTOM = require('phantom');\n$$$_"])
          | in_files_without($all | of(["var $INPUT = \"$$$_\";\n$$$_","\"$$$_\""]))
        | finding("javascript.phantom.security.audit.phantom-injection.phantom-injection";
            "If unverified user data can reach the `phantom` page methods it can result in Server-Side Request Forgery vulnerabilities") )
      + ( ($all)
          + ($all)
          | in_files_with($all | of(["$$$_\nrequire('playwright');\n$$$_"]))
        | finding("javascript.playwright.security.audit.playwright-evaluate-arg-injection.playwright-evaluate-arg-injection";
            "If unverified user data can reach the `evaluate` method it can result in Server-Side Request Forgery vulnerabilities") ) )
| report
