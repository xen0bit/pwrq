# rules: lang-consistency-elixir
# from: yaml/semgrep/consistency/lang-consistency-elixir.yaml

. as $root
| ( ($root | scan_ast(["*.yaml"]; [
      "$X",
      "languages: $$$_"
    ])) as $all
    | ( $all | of(["$X"])
          | within($all | of(["languages: $$$_"]))
          | where_capture("X"; "^(ex)$")
        | finding("lang-consistency-elixir";
            "Found '$X' in language config which diverges from semgrep.dev normalization.") ) )
| report
