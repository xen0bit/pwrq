# rules: lang-consistency-csharp
# from: yaml/semgrep/consistency/lang-consistency-csharp.yaml

. as $root
| ( ($root | scan_regex(["*.yaml"]; [
      "(?P<X>\\S+)",
      "languages:\\s+[\\s\\S]*?"
    ])) as $all
    | ( $all | of(["(?P<X>\\S+)"])
          | within($all | of(["languages:\\s+[\\s\\S]*?"]))
          | where_capture("X"; "^(c\\#)$")
        | finding("lang-consistency-csharp";
            "Found '$X' in language config which diverges from semgrep.dev normalization.") ) )
| report
