# rules: unnecessary-parent-operator
# languages: yaml
# from: yaml/semgrep/unnecessary-parent.yaml

. as $root
| ( ($root | scan_ast(["*.yaml"]; [
      "pattern-either:\n- $$$_\n- pattern-either:\n  - $$$_",
      "pattern-either:\n- $THING1\n- $$$_",
      "pattern-either:\n- $THING1\n- $THING2\n- $$$_",
      "patterns:\n- $THING1\n- $$$_",
      "patterns:\n- $THING1\n- $THING2\n- $$$_",
      "rules: [$$$_, $RULE, $$$_]"
    ])) as $all
    | ( ($all | of(["pattern-either:\n- $THING1\n- $$$_"])
          | not_at($all | of(["pattern-either:\n- $THING1\n- $THING2\n- $$$_"])))
          + ($all | of(["patterns:\n- $THING1\n- $$$_"])
          | not_at($all | of(["patterns:\n- $THING1\n- $THING2\n- $$$_"])))
          + ($all | of(["pattern-either:\n- $$$_\n- pattern-either:\n  - $$$_"]))
          | within($all | of(["rules: [$$$_, $RULE, $$$_]"]))
        | finding("unnecessary-parent-operator";
            "Unnecessary parent operator.") ) )
| report
