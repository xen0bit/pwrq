# rules: duplicate-id
# from: yaml/semgrep/duplicate-id.yaml

. as $root
| ( ($root | scan_regex(["*.yaml"]; [
      "[\\s\\S]*?\\s+\\-\\s+id:\\s+(?P<X>\\S+)\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+\\-\\s+id:\\s+(?P<X>\\S+)\\s+[\\s\\S]*?\\s+[\\s\\S]*?",
      "id:\\s+(?P<X>\\S+)",
      "rules:\\s+\\[[\\s\\S]*?,\\s+(?P<RULE>\\S+),\\s+[\\s\\S]*?\\]"
    ])) as $all
    | ( $all | of(["id:\\s+(?P<X>\\S+)"])
          | within($all | of(["rules:\\s+\\[[\\s\\S]*?,\\s+(?P<RULE>\\S+),\\s+[\\s\\S]*?\\]"]))
          | in_files_with($all | of(["[\\s\\S]*?\\s+\\-\\s+id:\\s+(?P<X>\\S+)\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+\\-\\s+id:\\s+(?P<X>\\S+)\\s+[\\s\\S]*?\\s+[\\s\\S]*?"]))
        | finding("duplicate-id";
            "The 'id' field $X was used multiple times.") ) )
| report
