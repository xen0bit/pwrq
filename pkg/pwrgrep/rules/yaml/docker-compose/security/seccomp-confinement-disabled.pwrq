# rules: seccomp-confinement-disabled
# from: yaml/docker-compose/security/seccomp-confinement-disabled.yaml

. as $root
| ( ($root | scan_regex(["*.yaml"]; [
      "(?P<SERVICE>\\S+):\\s+[\\s\\S]*?\\s+image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+security_opt:\\s+\\-\\s+[\\s\\S]*?\\s+\\-\\s+seccomp:unconfined",
      "version:\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+services:\\s+[\\s\\S]*?"
    ])) as $all
    | ( $all | of(["(?P<SERVICE>\\S+):\\s+[\\s\\S]*?\\s+image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+security_opt:\\s+\\-\\s+[\\s\\S]*?\\s+\\-\\s+seccomp:unconfined"])
          | within($all | of(["version:\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+services:\\s+[\\s\\S]*?"]))
        | finding("seccomp-confinement-disabled";
            "Service '$SERVICE' is explicitly disabling seccomp confinement.") ) )
| report
