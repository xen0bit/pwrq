# rules: seccomp-confinement-disabled
# from: yaml/docker-compose/security/seccomp-confinement-disabled.yaml

. as $root
| ( ($root | scan_ast(["*.yaml"]; [
      "$SERVICE:\n  $$$_\n  image: $$$_\n  $$$_\n  security_opt:\n    - $$$_\n    - seccomp:unconfined",
      "version: $$$_\n$$$_\nservices:\n  $$$_"
    ])) as $all
    | ( $all | of(["$SERVICE:\n  $$$_\n  image: $$$_\n  $$$_\n  security_opt:\n    - $$$_\n    - seccomp:unconfined"])
          | within($all | of(["version: $$$_\n$$$_\nservices:\n  $$$_"]))
        | finding("seccomp-confinement-disabled";
            "Service '$SERVICE' is explicitly disabling seccomp confinement.") ) )
| report
