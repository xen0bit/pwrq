# rules: selinux-separation-disabled
# from: yaml/docker-compose/security/selinux-separation-disabled.yaml

. as $root
| ( ($root | scan_regex(["*.yaml"]; [
      "(?P<SERVICE>\\S+):\\s+[\\s\\S]*?\\s+image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+security_opt:\\s+\\-\\s+[\\s\\S]*?\\s+\\-\\s+label:disable",
      "version:\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+services:\\s+[\\s\\S]*?"
    ])) as $all
    | ( $all | of(["(?P<SERVICE>\\S+):\\s+[\\s\\S]*?\\s+image:\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+security_opt:\\s+\\-\\s+[\\s\\S]*?\\s+\\-\\s+label:disable"])
          | within($all | of(["version:\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+services:\\s+[\\s\\S]*?"]))
        | finding("selinux-separation-disabled";
            "Service '$SERVICE' is explicitly disabling SELinux separation.") ) )
| report
