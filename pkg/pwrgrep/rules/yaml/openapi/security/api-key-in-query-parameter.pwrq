# rules: api-key-in-query-parameter
# from: yaml/openapi/security/api-key-in-query-parameter.yaml

. as $root
| ( ($root | scan_regex(["*.yaml"]; [
      "(?P<SECURITY_SCHEME>\\S+):\\s+[\\s\\S]*?\\s+type:\\s+apiKey\\s+[\\s\\S]*?\\s+in:\\s+query",
      "openapi:\\s+(?P<VERSION>\\S+)\\s+[\\s\\S]*?\\s+components:\\s+[\\s\\S]*?\\s+securitySchemes:\\s+[\\s\\S]*?"
    ])) as $all
    | ( $all | of(["(?P<SECURITY_SCHEME>\\S+):\\s+[\\s\\S]*?\\s+type:\\s+apiKey\\s+[\\s\\S]*?\\s+in:\\s+query"])
          | within($all | of(["openapi:\\s+(?P<VERSION>\\S+)\\s+[\\s\\S]*?\\s+components:\\s+[\\s\\S]*?\\s+securitySchemes:\\s+[\\s\\S]*?"]))
          | where_capture("VERSION"; "^(?:3.*)")
        | finding("api-key-in-query-parameter";
            "The $SECURITY_SCHEME security scheme passes an API key in a query parameter.") ) )
| report
