# rules: changes-with-when-never
# languages: yaml
# from: yaml/gitlab/correctness/changes-with-when-never.yaml

. as $root
| ( ($root | scan_ast(["*.yaml"]; [
      "- changes:\n  - $$$_\n  when: never"
    ])) as $all
    | ( $all | of(["- changes:\n  - $$$_\n  when: never"])
        | finding("changes-with-when-never";
            "This Gitlab CI YAML will never run on default branches due to a `changes` rule with `when:never`.") ) )
| report
