# rules: wp-file-download-audit
# languages: php
# from: php/wordpress-plugins/security/audit/wp-file-download-audit.yaml

. as $root
| ( ($root | scan_ast(["*.php"]; [
      "file($$$_)",
      "file_get_contents($$$_)",
      "readfile($$$_)"
    ])) as $all
    | ( $all | of(["file($$$_)","readfile($$$_)","file_get_contents($$$_)"])
        | finding("wp-file-download-audit";
            "These functions can be used to read to content of the files if the data inside is user-controlled.") ) )
| report
