# rules: wp-code-execution-audit
# from: php/wordpress-plugins/security/audit/wp-code-execution-audit.yaml

. as $root
| ( ($root | scan_ast(["*.php"]; [
      "assert($$$_)",
      "call_user_func($$$_)",
      "eval($$$_)"
    ])) as $all
    | ( $all | of(["eval($$$_)","assert($$$_)","call_user_func($$$_)"])
        | finding("wp-code-execution-audit";
            "These functions can lead to code injection if the data inside them is user-controlled.") ) )
| report
