# rules: doctrine-dbal-dangerous-query
# languages: php
# from: php/doctrine/security/audit/doctrine-dbal-dangerous-query.yaml

. as $root
| ( ($root | scan_ast(["*.php"]; [
      "$CONNECTION = $SMTH->getConnection($$$_);\n$$$_",
      "$CONNECTION->createQuery(\"$$$_\",$$$_)",
      "$CONNECTION->createQuery($QUERY,$$$_)",
      "$CONNECTION->executeQuery(\"$$$_\",$$$_)",
      "$CONNECTION->executeQuery($QUERY,$$$_)",
      "$CONNECTION->prepare(\"$$$_\",$$$_)",
      "$CONNECTION->prepare($QUERY,$$$_)",
      "use Doctrine\\DBAL\\Connection;\n$$$_"
    ])) as $all
    | ( $all | of(["$CONNECTION->prepare($QUERY,$$$_)","$CONNECTION->createQuery($QUERY,$$$_)","$CONNECTION->executeQuery($QUERY,$$$_)"])
          | at_same_place((($all
          | in_files_with($all | of(["use Doctrine\\DBAL\\Connection;\n$$$_"])))
          + ($all
          | in_files_with($all | of(["$CONNECTION = $SMTH->getConnection($$$_);\n$$$_"])))))
          | not_at($all | of(["$CONNECTION->prepare(\"$$$_\",$$$_)"]))
          | not_at($all | of(["$CONNECTION->createQuery(\"$$$_\",$$$_)"]))
          | not_at($all | of(["$CONNECTION->executeQuery(\"$$$_\",$$$_)"]))
        | finding("doctrine-dbal-dangerous-query";
            "Detected string concatenation with a non-literal variable in a Doctrine DBAL query method.") ) )
| report
