# rules: doctrine-orm-dangerous-query
# languages: php
# from: php/doctrine/security/audit/doctrine-orm-dangerous-query.yaml

. as $root
| ( ($root | scan_ast(["*.php"]; [
      "\"$$$_\".$SMTH",
      "$Q = $X->createQueryBuilder();\n$$$_",
      "$Q = new QueryBuilder($$$_);\n$$$_",
      "$QUERY->add($$$_,$SINK,$$$_)",
      "$QUERY->addGroupBy($$$_,$SINK,$$$_)",
      "$QUERY->addOrderBy($$$_,$SINK,$$$_)",
      "$QUERY->addSelect($$$_,$SINK,$$$_)",
      "$QUERY->andHaving($$$_,$SINK,$$$_)",
      "$QUERY->andWhere($$$_,$SINK,$$$_)",
      "$QUERY->delete($$$_,$SINK,$$$_)",
      "$QUERY->from($$$_,$SINK,$$$_)",
      "$QUERY->groupBy($$$_,$SINK,$$$_)",
      "$QUERY->having($$$_,$SINK,$$$_)",
      "$QUERY->innerJoin($$$_,$SINK,$$$_)",
      "$QUERY->insert($$$_,$SINK,$$$_)",
      "$QUERY->join($$$_,$SINK,$$$_)",
      "$QUERY->leftJoin($$$_,$SINK,$$$_)",
      "$QUERY->orHaving($$$_,$SINK,$$$_)",
      "$QUERY->orWhere($$$_,$SINK,$$$_)",
      "$QUERY->orderBy($$$_,$SINK,$$$_)",
      "$QUERY->rightJoin($$$_,$SINK,$$$_)",
      "$QUERY->select($$$_,$SINK,$$$_)",
      "$QUERY->set($SINK,$$$_)",
      "$QUERY->setValue($SINK,$$$_)",
      "$QUERY->update($$$_,$SINK,$$$_)",
      "$QUERY->where($$$_,$SINK,$$$_)",
      "sprintf($$$_)"
    ])) as $all
    | ( (($all | of(["$QUERY->add($$$_,$SINK,$$$_)","$QUERY->select($$$_,$SINK,$$$_)","$QUERY->addSelect($$$_,$SINK,$$$_)","$QUERY->delete($$$_,$SINK,$$$_)","$QUERY->update($$$_,$SINK,$$$_)","$QUERY->insert($$$_,$SINK,$$$_)","$QUERY->from($$$_,$SINK,$$$_)","$QUERY->join($$$_,$SINK,$$$_)","$QUERY->innerJoin($$$_,$SINK,$$$_)","$QUERY->leftJoin($$$_,$SINK,$$$_)","$QUERY->rightJoin($$$_,$SINK,$$$_)","$QUERY->where($$$_,$SINK,$$$_)","$QUERY->andWhere($$$_,$SINK,$$$_)","$QUERY->orWhere($$$_,$SINK,$$$_)","$QUERY->groupBy($$$_,$SINK,$$$_)","$QUERY->addGroupBy($$$_,$SINK,$$$_)","$QUERY->having($$$_,$SINK,$$$_)","$QUERY->andHaving($$$_,$SINK,$$$_)","$QUERY->orHaving($$$_,$SINK,$$$_)","$QUERY->orderBy($$$_,$SINK,$$$_)","$QUERY->addOrderBy($$$_,$SINK,$$$_)","$QUERY->set($SINK,$$$_)","$QUERY->setValue($SINK,$$$_)"])
          | at_same_place((($all
          | in_files_with($all | of(["$Q = $X->createQueryBuilder();\n$$$_"])))
          + ($all
          | in_files_with($all | of(["$Q = new QueryBuilder($$$_);\n$$$_"])))))
          | focus("SINK")))
          | reaching((($all | of(["sprintf($$$_)","\"$$$_\".$SMTH"])));
              ([]))
        | finding("doctrine-orm-dangerous-query";
            "`$QUERY` Detected string concatenation with a non-literal variable in a Doctrine QueryBuilder method.") ) )
| report
