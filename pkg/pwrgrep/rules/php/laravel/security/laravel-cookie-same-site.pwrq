# rules: laravel-cookie-same-site
# languages: php
# from: php/laravel/security/laravel-cookie-same-site.yaml

. as $root
| ( ($root | scan_ast(["*.php"]; [
      "'cookie'",
      "return [\n  $$$_,\n  'cookie' => env($$$_),\n  $$$_\n];",
      "return [\n  $$$_,\n  'same_site' => 'lax',\n  $$$_\n];",
      "return [\n  $$$_,\n  'same_site' => 'strict',\n  $$$_\n];",
      "return [\n  $$$_,\n  'same_site' => env('$NAME', $DEFAULT),\n  $$$_\n];"
    ])) as $all
    | ( $all | of(["'cookie'"])
          | within($all | of(["return [\n  $$$_,\n  'cookie' => env($$$_),\n  $$$_\n];"]))
          | outside($all | of(["return [\n  $$$_,\n  'same_site' => 'lax',\n  $$$_\n];"]))
          | outside($all | of(["return [\n  $$$_,\n  'same_site' => 'strict',\n  $$$_\n];"]))
          | outside($all | of(["return [\n  $$$_,\n  'same_site' => env('$NAME', $DEFAULT),\n  $$$_\n];"]))
        | finding("laravel-cookie-same-site";
            "Found a configuration file where the same_site attribute is not set to 'lax' or 'strict'.") ) )
| report
