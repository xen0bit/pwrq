# rules: laravel-dangerous-model-construction
# from: php/laravel/security/laravel-dangerous-model-construction.yaml

. as $root
| ( ($root | scan_regex(["*.php"]; [
      "\\$guarded\\s+=\\s+\\[\\];",
      "class\\s+(?P<CLASS>\\S+)\\s+extends\\s+Model\\s+\\{\\s+[\\s\\S]*?\\s+\\}"
    ])) as $all
    | ( $all | of(["\\$guarded\\s+=\\s+\\[\\];"])
          | within($all | of(["class\\s+(?P<CLASS>\\S+)\\s+extends\\s+Model\\s+\\{\\s+[\\s\\S]*?\\s+\\}"]))
        | finding("laravel-dangerous-model-construction";
            "Setting `$guarded` to an empty array allows mass assignment to every property in a Laravel model.") ) )
| report
