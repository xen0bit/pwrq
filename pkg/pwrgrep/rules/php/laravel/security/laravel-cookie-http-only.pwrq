# rules: laravel-cookie-http-only
# languages: php
# from: php/laravel/security/laravel-cookie-http-only.yaml

. as $root
| ( ($root | scan_ast(["*.php"]; [
      "'cookie'",
      "return [\n  $$$_,\n  'cookie' => env($$$_),\n  $$$_\n];",
      "return [\n  $$$_,\n  'http_only' => env('$NAME', $DEFAULT),\n  $$$_\n];",
      "return [\n  $$$_,\n  'http_only' => true,\n  $$$_\n];"
    ])) as $all
    | ( $all | of(["'cookie'"])
          | within($all | of(["return [\n  $$$_,\n  'cookie' => env($$$_),\n  $$$_\n];"]))
          | outside($all | of(["return [\n  $$$_,\n  'http_only' => true,\n  $$$_\n];"]))
          | outside($all | of(["return [\n  $$$_,\n  'http_only' => env('$NAME', $DEFAULT),\n  $$$_\n];"]))
        | finding("laravel-cookie-http-only";
            "Found a configuration file where the HttpOnly attribute is not set to true.") ) )
| report
