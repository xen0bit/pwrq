# rules: laravel-cookie-secure-set
# languages: php
# from: php/laravel/security/laravel-cookie-secure-set.yaml

. as $root
| ( ($root | scan_ast(["*.php"]; [
      "'cookie'",
      "return [\n  $$$_,\n  'cookie' => env($$$_),\n  $$$_\n];",
      "return [\n  $$$_,\n  'secure' => env('$NAME', $DEFAULT),\n  $$$_\n];",
      "return [\n  $$$_,\n  'secure' => true,\n  $$$_\n];"
    ])) as $all
    | ( $all | of(["'cookie'"])
          | within($all | of(["return [\n  $$$_,\n  'cookie' => env($$$_),\n  $$$_\n];"]))
          | outside($all | of(["return [\n  $$$_,\n  'secure' => true,\n  $$$_\n];"]))
          | outside($all | of(["return [\n  $$$_,\n  'secure' => env('$NAME', $DEFAULT),\n  $$$_\n];"]))
        | finding("laravel-cookie-secure-set";
            "Found a configuration file where the secure attribute is not set to 'true'.") ) )
| report
