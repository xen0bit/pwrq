# rules: symfony-permissive-cors
# languages: php
# from: php/symfony/security/audit/symfony-permissive-cors.yaml

. as $root
| ( ($root | scan_ast(["*.php"]; [
      "$HEADERS = [$KEY => $VALUE];\n$$$_",
      "$RES->headers->set($KEY, $VALUE)",
      "new $R($X, $Y, [$KEY => $VALUE], $$$_)",
      "new Response($X, $Y, $HEADERS, $$$_)",
      "new Symfony\\Component\\HttpFoundation\\Response($X, $Y, $HEADERS, $$$_)",
      "use Symfony\\Component\\HttpFoundation\\Response;\n$$$_"
    ])) as $all
    | ( ($all | of(["new Symfony\\Component\\HttpFoundation\\Response($X, $Y, $HEADERS, $$$_)","new Response($X, $Y, $HEADERS, $$$_)"])
          | at_same_place((($all | of(["new $R($X, $Y, [$KEY => $VALUE], $$$_)"]))
          + ($all
          | in_files_with($all | of(["$HEADERS = [$KEY => $VALUE];\n$$$_"]))))))
          + ($all | of(["$RES->headers->set($KEY, $VALUE)"]))
          | in_files_with($all | of(["use Symfony\\Component\\HttpFoundation\\Response;\n$$$_"]))
          | where_capture("KEY"; "^(?:(\\'|\\\")\\s*(Access-Control-Allow-Origin|access-control-allow-origin)\\s*(\\'|\\\"))")
          | where_capture("VALUE"; "^(?:(\\'|\\\")\\s*(\\*)\\s*(\\'|\\\"))")
        | finding("symfony-permissive-cors";
            "Access-Control-Allow-Origin response header is set to \"*\".") ) )
| report
