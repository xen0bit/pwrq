# rules: md5-loose-equality
# languages: php
# from: php/lang/security/md5-loose-equality.yaml

. as $root
| ( ($root | scan_ast(["*.php"]; [
      "$FUNC($$$_) == $FUNC($$$_)",
      "$FUNC($$$_) == $X",
      "$X == $FUNC($$$_)"
    ])) as $all
    | ( $all | of(["$X == $FUNC($$$_)","$FUNC($$$_) == $X","$FUNC($$$_) == $FUNC($$$_)"])
          | where_capture("FUNC"; "^(?:md5|md5_file)")
        | finding("md5-loose-equality";
            "Make sure comparisons involving md5 values are strict (use `===` not `==`) to avoid type juggling issues") ) )
| report
