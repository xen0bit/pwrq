# rules: md5-used-as-password
# languages: php
# from: php/lang/security/md5-used-as-password.yaml

. as $root
| ( ($root | scan_ast(["*.php"]; [
      "$FUNCTION($$$_)",
      "hash('md5', $$$_)",
      "md5($$$_)"
    ])) as $all
    | ( (($all | of(["$FUNCTION($$$_)"])
          | where_capture("FUNCTION"; "^(?:(?i)(.*password.*))")))
          | reaching((($all | of(["md5($$$_)","hash('md5', $$$_)"])));
              ([]))
        | finding("md5-used-as-password";
            "It looks like MD5 is used as a password hash.") ) )
| report
