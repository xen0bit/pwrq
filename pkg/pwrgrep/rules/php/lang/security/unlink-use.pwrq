# rules: unlink-use
# from: php/lang/security/unlink-use.yaml

. as $root
| ( ($root | scan_ast(["*.php"]; [
      "unlink(\"$$$_\",$$$_)",
      "unlink($$$_)"
    ])) as $all
    | ( $all | of(["unlink($$$_)"])
          | not_at($all | of(["unlink(\"$$$_\",$$$_)"]))
        | finding("unlink-use";
            "Using user input when deleting files with `unlink()` is potentially dangerous.") ) )
| report
