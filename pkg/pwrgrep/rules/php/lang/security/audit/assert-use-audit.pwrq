# rules: assert-use-audit
# languages: php
# from: php/lang/security/audit/assert-use-audit.yaml

. as $root
| ( ($root | scan_ast(["*.php"]; [
      "assert(\"$$$_\", $$$_);",
      "assert($ASSERT, $$$_);"
    ])) as $all
    | ( $all | of(["assert($ASSERT, $$$_);"])
          | not_at($all | of(["assert(\"$$$_\", $$$_);"]))
          | where_capture("ASSERT"; "^\\$[A-Za-z\\[\\]\\-_'\"\\$]+(\\-\\>\\w+)?$")
        | finding("assert-use-audit";
            "Calling assert with user input is equivalent to eval'ing.") ) )
| report
