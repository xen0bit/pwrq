# rules: openssl-cbc-static-iv
# languages: php
# from: php/lang/security/openssl-cbc-static-iv.yaml

. as $root
| ( ($root | scan_ast(["*.php"]; [
      "openssl_decrypt($D, $M, $K, $FLAGS, \"$$$_\",$$$_);",
      "openssl_encrypt($D, $M, $K, $FLAGS, \"$$$_\",$$$_);"
    ])) as $all
    | ( $all | of(["openssl_encrypt($D, $M, $K, $FLAGS, \"$$$_\",$$$_);","openssl_decrypt($D, $M, $K, $FLAGS, \"$$$_\",$$$_);"])
          | where_capture("M"; "^(?:.*-CBC)")
        | finding("openssl-cbc-static-iv";
            "Static IV used with AES in CBC mode.") ) )
| report
