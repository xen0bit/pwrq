# rules: extract-user-data
# languages: php
# from: php/lang/security/deserialization.yaml

. as $root
| ( ($root | scan_ast(["*.php"]; [
      "$_FILES[$$$_]",
      "$_GET[$$$_]",
      "$_POST[$$$_]",
      "extract($$$_)",
      "extract($VAR, EXTR_SKIP,$$$_)"
    ])) as $all
    | ( (($all | of(["extract($$$_)"])))
          | reaching((($all | of(["$_GET[$$$_]","$_FILES[$$$_]","$_POST[$$$_]"])));
              (($all | of(["extract($VAR, EXTR_SKIP,$$$_)"]))))
        | finding("extract-user-data";
            "Do not call 'extract()' on user-controllable data.") ) )
| report
