# rules: php-permissive-cors
# languages: php
# from: php/lang/security/php-permissive-cors.yaml

. as $root
| ( ($root | scan_ast(["*.php"]; [
      "\"$$$_\"",
      "$VALUE = \"$$$_\";\n$$$_",
      "header(\"$$$_\",$$$_)",
      "header($VALUE,$$$_)"
    ])) as $all
    | ( $all | of(["header($VALUE,$$$_)"])
          | at_same_place((($all | of(["header(\"$$$_\",$$$_)"]))
          + ($all
          | in_files_with($all | of(["$VALUE = \"$$$_\";\n$$$_","\"$$$_\""])))))
          | where_capture("VALUE"; "^(?:(\\'|\\\")\\s*(Access-Control-Allow-Origin|access-control-allow-origin)\\s*:\\s*(\\*)\\s*(\\'|\\\"))")
        | finding("php-permissive-cors";
            "Access-Control-Allow-Origin response header is set to \"*\".") ) )
| report
