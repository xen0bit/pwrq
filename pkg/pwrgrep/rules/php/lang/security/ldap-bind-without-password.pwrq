# rules: ldap-bind-without-password
# languages: php
# from: php/lang/security/ldap-bind-without-password.yaml

. as $root
| ( ($root | scan_ast(["*.php"]; [
      "ldap_bind($$$_)",
      "ldap_bind($LDAP, $DN, $PASSWORD)",
      "ldap_bind($LDAP, $DN, '')",
      "ldap_bind($LDAP, $DN, NULL)"
    ])) as $all
    | ( ($all | of(["ldap_bind($LDAP, $DN, NULL)"]))
          + ($all | of(["ldap_bind($LDAP, $DN, '')"]))
          + ($all | of(["ldap_bind($$$_)"])
          | not_at($all | of(["ldap_bind($LDAP, $DN, $PASSWORD)"])))
        | finding("ldap-bind-without-password";
            "Detected anonymous LDAP bind.") ) )
| report
