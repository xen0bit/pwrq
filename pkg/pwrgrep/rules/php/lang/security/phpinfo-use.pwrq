# rules: phpinfo-use
# from: php/lang/security/phpinfo-use.yaml

. as $root
| ( ($root | scan_ast(["*.php"]; [
      "phpinfo($$$_);"
    ])) as $all
    | ( $all | of(["phpinfo($$$_);"])
        | finding("phpinfo-use";
            "The 'phpinfo' function may reveal sensitive information about your environment.") ) )
| report
