# rules: unserialize-use
# languages: php
# from: php/lang/security/unserialize-use.yaml

. as $root
| ( ($root | scan_ast(["*.php"]; [
      "unserialize(\"$$$_\",$$$_)",
      "unserialize($$$_)"
    ])) as $all
    | ( $all | of(["unserialize($$$_)"])
          | not_at($all | of(["unserialize(\"$$$_\",$$$_)"]))
        | finding("unserialize-use";
            "Calling `unserialize()` with user input in the pattern can lead to arbitrary code execution.") ) )
| report
