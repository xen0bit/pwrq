# rules: mb-ereg-replace-eval
# languages: php
# from: php/lang/security/mb-ereg-replace-eval.yaml

. as $root
| ( ($root | scan_ast(["*.php"]; [
      "mb_ereg_replace($PATTERN, $REPL, $STR, \"$$$_\");",
      "mb_ereg_replace($PATTERN, $REPL, $STR, $OPTIONS);"
    ])) as $all
    | ( $all | of(["mb_ereg_replace($PATTERN, $REPL, $STR, $OPTIONS);"])
          | not_at($all | of(["mb_ereg_replace($PATTERN, $REPL, $STR, \"$$$_\");"]))
        | finding("mb-ereg-replace-eval";
            "Calling mb_ereg_replace with user input in the options can lead to arbitrary code execution.") ) )
| report
