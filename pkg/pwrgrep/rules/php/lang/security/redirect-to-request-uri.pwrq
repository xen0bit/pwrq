# rules: redirect-to-request-uri
# languages: php
# from: php/lang/security/redirect-to-request-uri.yaml

. as $root
| ( ($root | scan_ast(["*.php"]; [
      "header('$LOCATION' . $_SERVER['REQUEST_URI'] . $MORE);",
      "header('$LOCATION' . $_SERVER['REQUEST_URI']);"
    ])) as $all
    | ( $all | of(["header('$LOCATION' . $_SERVER['REQUEST_URI']);","header('$LOCATION' . $_SERVER['REQUEST_URI'] . $MORE);"])
          | where_capture("LOCATION"; "^(?i)location:\\s*$")
        | finding("redirect-to-request-uri";
            "Redirecting to the current request URL may redirect to another domain, if the current path starts with two slashes.") ) )
| report
