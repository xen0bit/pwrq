# rules: jjwt-none-alg
# languages: java
# from: java/jjwt/security/jwt-none-alg.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "$RETURNTYPE $FUNC($$$_) {\n  $$$_\n  $JWTS.signWith($$$_);\n  $$$_\n}",
      "io.jsonwebtoken.Jwts.builder();"
    ])) as $all
    | ( $all | of(["io.jsonwebtoken.Jwts.builder();"])
          | outside($all | of(["$RETURNTYPE $FUNC($$$_) {\n  $$$_\n  $JWTS.signWith($$$_);\n  $$$_\n}"]))
        | finding("jjwt-none-alg";
            "Detected use of the 'none' algorithm in a JWT token.") ) )
| report
