# rules: java-jwt-hardcoded-secret
# from: java/java-jwt/security/jwt-hardcode.yaml

. as $root
| ( ($root | scan_regex(["*.java"]; [
      "(?P<SECRET>\\S+)\\s+=\\s+\"(?P<Y>\\S+)\";\\s+[\\s\\S]*?\\s+\\(Algorithm\\s+(?P<ALG>\\S+)\\)\\s+=\\s+(?P<ALGO>\\S+)\\.(?P<HMAC>\\S+)\\((?P<SECRET>\\S+)\\);",
      "\\(Algorithm\\s+(?P<ALG>\\S+)\\)\\s+=\\s+(?P<ALGO>\\S+)\\.(?P<HMAC>\\S+)\\(\"(?P<Y>\\S+)\"\\);",
      "class\\s+(?P<CLASS>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<TYPE>\\S+)\\s+(?P<SECRET>\\S+)\\s+=\\s+\"(?P<Y>\\S+)\";\\s+[\\s\\S]*?\\s+(?P<RETURNTYPE>\\S+)\\s+(?P<FUNC>\\S+)\\s+\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\(Algorithm\\s+(?P<ALG>\\S+)\\)\\s+=\\s+(?P<ALGO>\\S+)\\.(?P<HMAC>\\S+)\\((?P<SECRET>\\S+)\\);\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}"
    ])) as $all
    | ( $all | of(["\\(Algorithm\\s+(?P<ALG>\\S+)\\)\\s+=\\s+(?P<ALGO>\\S+)\\.(?P<HMAC>\\S+)\\(\"(?P<Y>\\S+)\"\\);","(?P<SECRET>\\S+)\\s+=\\s+\"(?P<Y>\\S+)\";\\s+[\\s\\S]*?\\s+\\(Algorithm\\s+(?P<ALG>\\S+)\\)\\s+=\\s+(?P<ALGO>\\S+)\\.(?P<HMAC>\\S+)\\((?P<SECRET>\\S+)\\);","class\\s+(?P<CLASS>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<TYPE>\\S+)\\s+(?P<SECRET>\\S+)\\s+=\\s+\"(?P<Y>\\S+)\";\\s+[\\s\\S]*?\\s+(?P<RETURNTYPE>\\S+)\\s+(?P<FUNC>\\S+)\\s+\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\(Algorithm\\s+(?P<ALG>\\S+)\\)\\s+=\\s+(?P<ALGO>\\S+)\\.(?P<HMAC>\\S+)\\((?P<SECRET>\\S+)\\);\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}"])
          | focus("Y")
          | where_capture("HMAC"; "^(?:(HMAC384|HMAC256|HMAC512))")
        | finding("java-jwt-hardcoded-secret";
            "A hard-coded credential was detected.") ) )
| report
