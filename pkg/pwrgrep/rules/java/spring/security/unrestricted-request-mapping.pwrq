# rules: unrestricted-request-mapping
# from: java/spring/security/unrestricted-request-mapping.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "@RequestMapping($$$_)\n$RETURNTYPE $METHOD($$$_) { $$$_ }",
      "@RequestMapping($$$_, method = $X, $$$_)\n$RETURNTYPE $METHOD($$$_) { $$$_ }",
      "RequestMapping"
    ])) as $all
    | ( $all | of(["RequestMapping"])
          | within($all | of(["@RequestMapping($$$_)\n$RETURNTYPE $METHOD($$$_) { $$$_ }"]))
          | outside($all | of(["@RequestMapping($$$_, method = $X, $$$_)\n$RETURNTYPE $METHOD($$$_) { $$$_ }"]))
        | finding("unrestricted-request-mapping";
            "Detected a method annotated with 'RequestMapping' that does not specify the HTTP method.") ) )
| report
