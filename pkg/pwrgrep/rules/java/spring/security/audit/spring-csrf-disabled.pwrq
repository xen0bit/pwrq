# rules: spring-csrf-disabled
# languages: java
# from: java/spring/security/audit/spring-csrf-disabled.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "$OBJ.csrf($$$_).disable($$$_)"
    ])) as $all
    | ( $all | of(["$OBJ.csrf($$$_).disable($$$_)"])
        | finding("spring-csrf-disabled";
            "CSRF protection is disabled for this configuration.") ) )
| report
