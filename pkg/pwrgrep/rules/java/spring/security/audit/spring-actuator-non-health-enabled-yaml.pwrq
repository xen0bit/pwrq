# rules: spring-actuator-dangerous-endpoints-enabled-yaml
# from: java/spring/security/audit/spring-actuator-non-health-enabled-yaml.yaml

. as $root
| ( ($root | scan_regex(["*.yaml"]; [
      "include:\\s+\\[[\\s\\S]*?,\\s+(?P<ACTUATOR>\\S+),\\s+[\\s\\S]*?\\]",
      "management:\\s+[\\s\\S]*?\\s+endpoints:\\s+[\\s\\S]*?\\s+web:\\s+[\\s\\S]*?\\s+exposure:\\s+[\\s\\S]*?\\s+include:\\s+[\\s\\S]*?"
    ])) as $all
    | ( $all | of(["include:\\s+\\[[\\s\\S]*?,\\s+(?P<ACTUATOR>\\S+),\\s+[\\s\\S]*?\\]"])
          | within($all | of(["management:\\s+[\\s\\S]*?\\s+endpoints:\\s+[\\s\\S]*?\\s+web:\\s+[\\s\\S]*?\\s+exposure:\\s+[\\s\\S]*?\\s+include:\\s+[\\s\\S]*?"]))
          | where_capture_not("ACTUATOR"; "^\"?(?:health|\\*)\"?$")
        | finding("spring-actuator-dangerous-endpoints-enabled-yaml";
            "Spring Boot Actuator \"$ACTUATOR\" is enabled.") ) )
| report
