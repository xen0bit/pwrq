# rules: spel-injection
# from: java/spring/security/audit/spel-injection.yaml

. as $root
| ( ($root | scan_regex(["*.java"]; [
      "(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<PARSER>\\S+)\\.parseExpression\\(\"[\\s\\S]*?\"\\);\\s+[\\s\\S]*?\\s+\\}",
      "(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<PARSER>\\S+)\\.parseExpression\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}",
      "(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+ExpressionParser\\s+(?P<PARSER>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+\\}",
      "(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+SpelExpressionParser\\s+(?P<PARSER>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+\\}",
      "(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+String\\s+(?P<S>\\S+)\\s+=\\s+\"[\\s\\S]*?\";\\s+[\\s\\S]*?\\s+(?P<PARSER>\\S+)\\.parseExpression\\((?P<S>\\S+)\\);\\s+[\\s\\S]*?\\s+\\}",
      "(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+TemplateAwareExpressionParser\\s+(?P<PARSER>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+\\}",
      "class\\s+(?P<CLASS>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+ExpressionParser\\s+(?P<PARSER>\\S+);\\s+[\\s\\S]*?\\s+\\}",
      "class\\s+(?P<CLASS>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+ExpressionParser\\s+(?P<PARSER>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+\\}",
      "class\\s+(?P<CLASS>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+SpelExpressionParser\\s+(?P<PARSER>\\S+);\\s+[\\s\\S]*?\\s+\\}",
      "class\\s+(?P<CLASS>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+SpelExpressionParser\\s+(?P<PARSER>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+\\}",
      "class\\s+(?P<CLASS>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+TemplateAwareExpressionParser\\s+(?P<PARSER>\\S+);\\s+[\\s\\S]*?\\s+\\}",
      "class\\s+(?P<CLASS>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+TemplateAwareExpressionParser\\s+(?P<PARSER>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+\\}"
    ])) as $all
    | ( ($all
          | within($all | of(["class\\s+(?P<CLASS>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+ExpressionParser\\s+(?P<PARSER>\\S+);\\s+[\\s\\S]*?\\s+\\}"])))
          + ($all
          | within($all | of(["class\\s+(?P<CLASS>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+ExpressionParser\\s+(?P<PARSER>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+\\}"])))
          + ($all
          | within($all | of(["(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+ExpressionParser\\s+(?P<PARSER>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+\\}"])))
          + ($all
          | within($all | of(["class\\s+(?P<CLASS>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+SpelExpressionParser\\s+(?P<PARSER>\\S+);\\s+[\\s\\S]*?\\s+\\}"])))
          + ($all
          | within($all | of(["class\\s+(?P<CLASS>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+SpelExpressionParser\\s+(?P<PARSER>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+\\}"])))
          + ($all
          | within($all | of(["(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+SpelExpressionParser\\s+(?P<PARSER>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+\\}"])))
          + ($all
          | within($all | of(["class\\s+(?P<CLASS>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+TemplateAwareExpressionParser\\s+(?P<PARSER>\\S+);\\s+[\\s\\S]*?\\s+\\}"])))
          + ($all
          | within($all | of(["class\\s+(?P<CLASS>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+TemplateAwareExpressionParser\\s+(?P<PARSER>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+\\}"])))
          + ($all
          | within($all | of(["(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+TemplateAwareExpressionParser\\s+(?P<PARSER>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+\\}"])))
          | at_same_place(($all | of(["(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<PARSER>\\S+)\\.parseExpression\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}"])))
          | not_at($all | of(["(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<PARSER>\\S+)\\.parseExpression\\(\"[\\s\\S]*?\"\\);\\s+[\\s\\S]*?\\s+\\}"]))
          | not_at($all | of(["(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+String\\s+(?P<S>\\S+)\\s+=\\s+\"[\\s\\S]*?\";\\s+[\\s\\S]*?\\s+(?P<PARSER>\\S+)\\.parseExpression\\((?P<S>\\S+)\\);\\s+[\\s\\S]*?\\s+\\}"]))
        | finding("spel-injection";
            "A Spring expression is built with a dynamic value.") ) )
| report
