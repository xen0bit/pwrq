# rules: nsc-allows-plaintext-traffic, nsc-pinning-without-backup, nsc-pinning-without-expiration, nsc-allows-user-ca-certs, nsc-allows-user-ca-certs-for-domain
# from: java/android/best-practice/network-security-config.yml

. as $root
| ( ($root | scan_regex(["*.xml"]; [
      "<!\\-\\-\\s+[\\s\\S]*?\\s+\\-\\->",
      "<base\\-config\\s+[\\s\\S]*?\\s+>\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+<\\/base\\-config>",
      "<base\\-config\\s+[\\s\\S]*?\\s+cleartextTrafficPermitted=\"true\"\\s+[\\s\\S]*?\\s+>",
      "<certificates\\s+[\\s\\S]*?\\s+user\\s+[\\s\\S]*?\\s+\\/>",
      "<certificates\\s+src=\"user\"\\s+[\\s\\S]*?\\s+\\/>",
      "<domain\\-config\\s+[\\s\\S]*?\\s+>\\s+[\\s\\S]*?\\s+<domain\\s+[\\s\\S]*?>\\s+(?P<DOMAIN>\\S+)\\s+<\\/domain>[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+<\\/domain\\-config>",
      "<domain\\-config\\s+[\\s\\S]*?\\s+>\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+<\\/domain\\-config>",
      "<network\\-security\\-config\\s+[\\s\\S]*?\\s+AcceptsUserCertificates\\s+[\\s\\S]*?\\s+>[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+<\\/network\\-security\\-config>",
      "<network\\-security\\-config\\s+[\\s\\S]*?\\s+InsecureBaseConfiguration\\s+[\\s\\S]*?\\s+>[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+<\\/network\\-security\\-config>",
      "<pin\\-set\\s+[\\s\\S]*?>[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?<\\/pin\\-set>",
      "<pin\\-set\\s+[\\s\\S]*?>\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+<\\/pin\\-set>",
      "<pin\\-set\\s+[\\s\\S]*?\\s+expiration=\"[\\s\\S]*?\">\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+<\\/pin\\-set>",
      "<pin\\s+[\\s\\S]*?>[\\s\\S]*?<\\/pin>",
      "<pin\\s+[\\s\\S]*?>[\\s\\S]*?<\\/pin>[\\s\\S]*?<pin\\s+[\\s\\S]*?>[\\s\\S]*?<\\/pin>",
      "<trust\\-anchors>\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+<\\/trust\\-anchors>"
    ])) as $all
    | ( $all | of(["<base\\-config\\s+[\\s\\S]*?\\s+cleartextTrafficPermitted=\"true\"\\s+[\\s\\S]*?\\s+>"])
          | outside($all | of(["<!\\-\\-\\s+[\\s\\S]*?\\s+\\-\\->"]))
          | outside($all | of(["<network\\-security\\-config\\s+[\\s\\S]*?\\s+InsecureBaseConfiguration\\s+[\\s\\S]*?\\s+>[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+<\\/network\\-security\\-config>"]))
        | finding("nsc-allows-plaintext-traffic";
            "The Network Security Config is set to allow non-encrypted connections.") )
      + ( $all | of(["<pin\\s+[\\s\\S]*?>[\\s\\S]*?<\\/pin>"])
          | outside($all | of(["<pin\\s+[\\s\\S]*?>[\\s\\S]*?<\\/pin>[\\s\\S]*?<pin\\s+[\\s\\S]*?>[\\s\\S]*?<\\/pin>"]))
          | within($all | of(["<pin\\-set\\s+[\\s\\S]*?>\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+<\\/pin\\-set>"]))
          | within($all | of(["<domain\\-config\\s+[\\s\\S]*?\\s+>\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+<\\/domain\\-config>"]))
          | outside($all | of(["<!\\-\\-\\s+[\\s\\S]*?\\s+\\-\\->"]))
        | finding("nsc-pinning-without-backup";
            "Your app uses TLS public key pinning without specifying a backup key.") )
      + ( $all | of(["<pin\\-set\\s+[\\s\\S]*?>[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?<\\/pin\\-set>"])
          | outside($all | of(["<pin\\-set\\s+[\\s\\S]*?\\s+expiration=\"[\\s\\S]*?\">\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+<\\/pin\\-set>"]))
          | within($all | of(["<domain\\-config\\s+[\\s\\S]*?\\s+>\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+<\\/domain\\-config>"]))
          | outside($all | of(["<!\\-\\-\\s+[\\s\\S]*?\\s+\\-\\->"]))
        | finding("nsc-pinning-without-expiration";
            "Your app uses TLS public key pinning without specifying an expiration date.") )
      + ( $all | of(["<certificates\\s+[\\s\\S]*?\\s+user\\s+[\\s\\S]*?\\s+\\/>"])
          | within($all | of(["<base\\-config\\s+[\\s\\S]*?\\s+>\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+<\\/base\\-config>"]))
          | outside($all | of(["<!\\-\\-\\s+[\\s\\S]*?\\s+\\-\\->"]))
          | outside($all | of(["<network\\-security\\-config\\s+[\\s\\S]*?\\s+AcceptsUserCertificates\\s+[\\s\\S]*?\\s+>[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+<\\/network\\-security\\-config>"]))
        | finding("nsc-allows-user-ca-certs";
            "The Network Security Config is set to accept user-installed CAs.") )
      + ( $all | of(["<certificates\\s+src=\"user\"\\s+[\\s\\S]*?\\s+\\/>"])
          | within($all | of(["<trust\\-anchors>\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+<\\/trust\\-anchors>"]))
          | within($all | of(["<domain\\-config\\s+[\\s\\S]*?\\s+>\\s+[\\s\\S]*?\\s+<domain\\s+[\\s\\S]*?>\\s+(?P<DOMAIN>\\S+)\\s+<\\/domain>[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+<\\/domain\\-config>"]))
          | outside($all | of(["<!\\-\\-\\s+[\\s\\S]*?\\s+\\-\\->"]))
          | outside($all | of(["<network\\-security\\-config\\s+[\\s\\S]*?\\s+AcceptsUserCertificates\\s+[\\s\\S]*?\\s+>[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+<\\/network\\-security\\-config>"]))
        | finding("nsc-allows-user-ca-certs-for-domain";
            "The Network Security Config is set to accept user-installed CAs for the domain `$DOMAIN`.") ) )
| report
