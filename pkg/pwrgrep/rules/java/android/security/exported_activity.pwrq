# rules: exported_activity
# from: java/android/security/exported_activity.yaml

. as $root
| ( ($root | scan_regex(["*AndroidManifest.xml"]; [
      "<activity\\s+[\\s\\S]*?\\s+<intent\\-filter>\\s+[\\s\\S]*?\\s+\\/>",
      "<activity\\s+[\\s\\S]*?\\s+\\/>",
      "<activity\\s+[\\s\\S]*?\\s+android:exported=\"false\"\\s+[\\s\\S]*?\\s+\\/>",
      "<activity\\s+[\\s\\S]*?\\s+android:exported=\"true\"\\s+[\\s\\S]*?\\s+\\/>"
    ])) as $all
    | ( $all | of(["<activity\\s+[\\s\\S]*?\\s+android:exported=\"true\"\\s+[\\s\\S]*?\\s+\\/>","<activity\\s+[\\s\\S]*?\\s+<intent\\-filter>\\s+[\\s\\S]*?\\s+\\/>"])
          | outside($all | of(["<activity\\s+[\\s\\S]*?\\s+android:exported=\"false\"\\s+[\\s\\S]*?\\s+\\/>"]))
          | within($all | of(["<activity\\s+[\\s\\S]*?\\s+\\/>"]))
        | finding("exported_activity";
            "The application exports an activity.") ) )
| report
