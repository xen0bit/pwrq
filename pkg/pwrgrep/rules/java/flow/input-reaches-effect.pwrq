# rules: java-input-reaches-effect
# languages: java
# fixture: java/InputReachesEffect.java
#
# Source to sink: a value from java-external-input that arrives, through
# assignments, at an argument of one of java-side-effects. It answers "what
# can the outside world steer?", which is a question about behaviour before it
# is one about security.
#
# The following is within one method and by assignment only - see reaching in
# pkg/udf/pwrgrep. A value handed to a helper and returned is not followed, so
# an absence here is not proof there is no path. Parameters Spring binds from
# a request are not sources here, because a parameter is not an assignment.

["System.getenv($$$_)", "System.getProperty($$$_)", "$R.getParameter($$$_)", "$R.getHeader($$$_)",
 "$R.getQueryString()", "Files.readString($$$_)"] as $sources
| ["Runtime.getRuntime().exec($$$A)", "new ProcessBuilder($$$A)", "Files.write($$$A)",
   "Files.writeString($$$A)", "Files.delete($$$A)", "new FileOutputStream($$$A)", "new FileWriter($$$A)",
   "new URL($$$A)"] as $sinks
| ["$S.executeQuery($$$A)", "$S.executeUpdate($$$A)", "$S.execute($$$A)"] as $queries
| scan_ast("*.java"; $sources + $sinks + $queries) as $all
| ($all | of($sinks)) + ($all | of($queries) | where_capture("S"; "(?i)stmt|statement|conn|em|entityManager|session"))
| reaching($all | of($sources); [])
| finding("java-input-reaches-effect"; "external input reaches this call's arguments $A")
| report
