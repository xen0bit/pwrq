# rules: servletresponse-writer-xss
# languages: java
# from: java/lang/security/servletresponse-writer-xss.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "$RESP.getWriter($$$_).write($$$_, $VAR, $$$_);",
      "$TYPE $FUNC($$$_, HttpServletResponse $RESP, $$$_) { $$$_ }",
      "$VAR = $REQ.getParameter($$$_); $$$_",
      "$WRITER = $RESP.getWriter($$$_);\n$$$_\n$WRITER.write($$$_, $VAR, $$$_);"
    ])) as $all
    | ( $all | of(["$RESP.getWriter($$$_).write($$$_, $VAR, $$$_);","$WRITER = $RESP.getWriter($$$_);\n$$$_\n$WRITER.write($$$_, $VAR, $$$_);"])
          | within($all | of(["$TYPE $FUNC($$$_, HttpServletResponse $RESP, $$$_) { $$$_ }"]))
          | within($all | of(["$VAR = $REQ.getParameter($$$_); $$$_"]))
        | finding("servletresponse-writer-xss";
            "Cross-site scripting detected in HttpServletResponse writer with variable '$VAR'.") ) )
| report
