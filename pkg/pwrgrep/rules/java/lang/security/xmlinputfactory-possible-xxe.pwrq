# rules: xmlinputfactory-possible-xxe
# languages: java
# from: java/lang/security/xmlinputfactory-possible-xxe.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "$METHOD($$$_) {\n  $$$_\n  $XMLFACTORY.setProperty(\"javax.xml.stream.isSupportingExternalEntities\", Boolean.FALSE);\n  $$$_\n}",
      "$METHOD($$$_) {\n  $$$_\n  $XMLFACTORY.setProperty(\"javax.xml.stream.isSupportingExternalEntities\", false);\n  $$$_\n}",
      "$METHOD($$$_) {\n  $$$_\n  $XMLFACTORY.setProperty(javax.xml.stream.XMLInputFactory.IS_SUPPORTING_EXTERNAL_ENTITIES, Boolean.FALSE);\n  $$$_\n}",
      "$METHOD($$$_) {\n  $$$_\n  $XMLFACTORY.setProperty(javax.xml.stream.XMLInputFactory.IS_SUPPORTING_EXTERNAL_ENTITIES, false);\n  $$$_\n}",
      "javax.xml.stream.XMLInputFactory.newFactory($$$_)",
      "new XMLInputFactory($$$_)"
    ])) as $all
    | ( $all | of(["javax.xml.stream.XMLInputFactory.newFactory($$$_)","new XMLInputFactory($$$_)"])
          | outside($all | of(["$METHOD($$$_) {\n  $$$_\n  $XMLFACTORY.setProperty(\"javax.xml.stream.isSupportingExternalEntities\", false);\n  $$$_\n}"]))
          | outside($all | of(["$METHOD($$$_) {\n  $$$_\n  $XMLFACTORY.setProperty(javax.xml.stream.XMLInputFactory.IS_SUPPORTING_EXTERNAL_ENTITIES, false);\n  $$$_\n}"]))
          | outside($all | of(["$METHOD($$$_) {\n  $$$_\n  $XMLFACTORY.setProperty(\"javax.xml.stream.isSupportingExternalEntities\", Boolean.FALSE);\n  $$$_\n}"]))
          | outside($all | of(["$METHOD($$$_) {\n  $$$_\n  $XMLFACTORY.setProperty(javax.xml.stream.XMLInputFactory.IS_SUPPORTING_EXTERNAL_ENTITIES, Boolean.FALSE);\n  $$$_\n}"]))
        | finding("xmlinputfactory-possible-xxe";
            "XML external entities are not explicitly disabled for this XMLInputFactory.") ) )
| report
