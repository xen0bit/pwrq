# rules: cookie-missing-secure-flag
# languages: java
# from: java/lang/security/audit/cookie-missing-secure-flag.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "$COOKIE = ResponseCookie.from($$$_). $$$_; $$$_",
      "$COOKIE.setSecure($$$_); $$$_",
      "$COOKIE.setSecure(false);",
      "$COOKIE.setValue(\"\"); $$$_",
      "$RESPONSE.addCookie($COOKIE);"
    ])) as $all
    | ( ($all | of(["$COOKIE.setSecure(false);"]))
          + ($all | of(["$RESPONSE.addCookie($COOKIE);"])
          | outside($all | of(["$COOKIE.setSecure($$$_); $$$_"]))
          | outside($all | of(["$COOKIE = ResponseCookie.from($$$_). $$$_; $$$_"])))
          | outside($all | of(["$COOKIE.setValue(\"\"); $$$_"]))
        | finding("cookie-missing-secure-flag";
            "A cookie was detected without setting the 'secure' flag.") ) )
| report
