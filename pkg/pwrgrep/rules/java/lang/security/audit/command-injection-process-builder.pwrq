# rules: command-injection-process-builder
# from: java/lang/security/audit/command-injection-process-builder.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "\"$$$_\"",
      "\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\"",
      "$ARG = \"$$$_\";\n$$$_",
      "$CMD = \"$$$_\";\n$$$_",
      "$CMD = \"=~/(sh|bash|ksh|csh|tcsh|zsh)/\";\n$$$_",
      "$CMD = \"cmd\";\n$$$_",
      "$CMD = Arrays.asList(\"$$$_\",$$$_);\n$$$_",
      "$CMD = new String[]{\"$$$_\",$$$_};\n$$$_",
      "$PB.command(\"$$$_\",\"$$$_\",\"$$$_\",$$$_)",
      "$PB.command(\"$$$_\",$$$_)",
      "$PB.command(\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\",$ARG,$$$_)",
      "$PB.command(\"cmd\",\"/c\",$ARG,$$$_)",
      "$PB.command($CMD,\"-c\",$ARG,$$$_)",
      "$PB.command($CMD,\"/c\",$ARG,$$$_)",
      "$PB.command($CMD,$$$_)",
      "$PB.command(Arrays.asList(\"$$$_\",\"$$$_\",\"$$$_\",$$$_),$$$_)",
      "$PB.command(Arrays.asList(\"$$$_\",$$$_),$$$_)",
      "$PB.command(Arrays.asList(\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\",$ARG,$$$_),$$$_)",
      "$PB.command(Arrays.asList(\"cmd\",\"/c\",$ARG,$$$_),$$$_)",
      "$PB.command(Arrays.asList($CMD,\"-c\",$ARG,$$$_),$$$_)",
      "$PB.command(Arrays.asList($CMD,\"/c\",$ARG,$$$_),$$$_)",
      "$PB.command(new String[]{\"$$$_\",\"$$$_\",\"$$$_\",$$$_},$$$_)",
      "$PB.command(new String[]{\"$$$_\",$$$_},$$$_)",
      "$PB.command(new String[]{\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\",$ARG,$$$_},$$$_)",
      "$PB.command(new String[]{\"cmd\",\"/c\",$ARG,$$$_},$$$_)",
      "$PB.command(new String[]{$CMD,\"-c\",$ARG,$$$_},$$$_)",
      "$PB.command(new String[]{$CMD,\"/c\",$ARG,$$$_},$$$_)",
      "$TYPE $PB = new ProcessBuilder($$$_);\n$$$_",
      "new ProcessBuilder(\"$$$_\",\"$$$_\",\"$$$_\",$$$_)",
      "new ProcessBuilder(\"$$$_\",$$$_)",
      "new ProcessBuilder(\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\",$ARG,$$$_)",
      "new ProcessBuilder(\"cmd\",\"/c\",$ARG,$$$_)",
      "new ProcessBuilder($CMD,\"/c\",$ARG,$$$_)",
      "new ProcessBuilder($CMD,$$$_)",
      "new ProcessBuilder(Arrays.asList(\"$$$_\",\"$$$_\",\"$$$_\",$$$_),$$$_)",
      "new ProcessBuilder(Arrays.asList(\"$$$_\",$$$_),$$$_)",
      "new ProcessBuilder(Arrays.asList(\"cmd\",\"/c\",$ARG,$$$_),$$$_)",
      "new ProcessBuilder(Arrays.asList($CMD,\"/c\",$ARG,$$$_),$$$_)",
      "new ProcessBuilder(new String[]{\"$$$_\",\"$$$_\",\"$$$_\",$$$_},$$$_)",
      "new ProcessBuilder(new String[]{\"$$$_\",$$$_},$$$_)",
      "new ProcessBuilder(new String[]{\"cmd\",\"/c\",$ARG,$$$_},$$$_)",
      "new ProcessBuilder(new String[]{$CMD,\"/c\",$ARG,$$$_},$$$_)"
    ])) as $all
    | ( ($all | of(["new ProcessBuilder($CMD,$$$_)"])
          | in_files_without($all | of(["$CMD = \"$$$_\";\n$$$_","\"$$$_\""]))
          | in_files_without($all | of(["$CMD = Arrays.asList(\"$$$_\",$$$_);\n$$$_","\"$$$_\""]))
          | in_files_without($all | of(["$CMD = new String[]{\"$$$_\",$$$_};\n$$$_","\"$$$_\""]))
          | not_at($all | of(["new ProcessBuilder(\"$$$_\",$$$_)"]))
          | not_at($all | of(["new ProcessBuilder(new String[]{\"$$$_\",$$$_},$$$_)"]))
          | not_at($all | of(["new ProcessBuilder(Arrays.asList(\"$$$_\",$$$_),$$$_)"])))
          + ($all | of(["$PB.command($CMD,$$$_)"])
          | in_files_with($all | of(["$TYPE $PB = new ProcessBuilder($$$_);\n$$$_"]))
          | in_files_without($all | of(["$CMD = \"$$$_\";\n$$$_","\"$$$_\""]))
          | in_files_without($all | of(["$CMD = Arrays.asList(\"$$$_\",$$$_);\n$$$_","\"$$$_\""]))
          | in_files_without($all | of(["$CMD = new String[]{\"$$$_\",$$$_};\n$$$_","\"$$$_\""]))
          | not_at($all | of(["$PB.command(\"$$$_\",$$$_)"]))
          | not_at($all | of(["$PB.command(new String[]{\"$$$_\",$$$_},$$$_)"]))
          | not_at($all | of(["$PB.command(Arrays.asList(\"$$$_\",$$$_),$$$_)"])))
          + (($all | of(["new ProcessBuilder(\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\",$ARG,$$$_)"]))
          + ($all | of(["new ProcessBuilder(\"cmd\",\"/c\",$ARG,$$$_)"]))
          + ($all | of(["new ProcessBuilder(Arrays.asList(\"cmd\",\"/c\",$ARG,$$$_),$$$_)"]))
          + ($all | of(["new ProcessBuilder(new String[]{\"cmd\",\"/c\",$ARG,$$$_},$$$_)"]))
          + ($all | of(["new ProcessBuilder($CMD,\"/c\",$ARG,$$$_)","new ProcessBuilder(Arrays.asList($CMD,\"/c\",$ARG,$$$_),$$$_)","new ProcessBuilder(new String[]{$CMD,\"/c\",$ARG,$$$_},$$$_)"])
          | in_files_with($all | of(["$CMD = \"cmd\";\n$$$_"])))
          | in_files_without($all | of(["$ARG = \"$$$_\";\n$$$_","\"$$$_\""]))
          | not_at($all | of(["new ProcessBuilder(\"$$$_\",\"$$$_\",\"$$$_\",$$$_)"]))
          | not_at($all | of(["new ProcessBuilder(new String[]{\"$$$_\",\"$$$_\",\"$$$_\",$$$_},$$$_)"]))
          | not_at($all | of(["new ProcessBuilder(Arrays.asList(\"$$$_\",\"$$$_\",\"$$$_\",$$$_),$$$_)"])))
          + (($all | of(["$PB.command(\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\",$ARG,$$$_)"]))
          + ($all | of(["$PB.command(\"cmd\",\"/c\",$ARG,$$$_)"]))
          + ($all | of(["$PB.command(Arrays.asList(\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\",$ARG,$$$_),$$$_)"]))
          + ($all | of(["$PB.command(Arrays.asList(\"cmd\",\"/c\",$ARG,$$$_),$$$_)"]))
          + ($all | of(["$PB.command(new String[]{\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\",\"-c\",$ARG,$$$_},$$$_)"]))
          + ($all | of(["$PB.command(new String[]{\"cmd\",\"/c\",$ARG,$$$_},$$$_)"]))
          + ($all | of(["$PB.command($CMD,\"-c\",$ARG,$$$_)","$PB.command(Arrays.asList($CMD,\"-c\",$ARG,$$$_),$$$_)","$PB.command(new String[]{$CMD,\"-c\",$ARG,$$$_},$$$_)"])
          | in_files_with($all | of(["$CMD = \"=~/(sh|bash|ksh|csh|tcsh|zsh)/\";\n$$$_","\"=~/(sh|bash|ksh|csh|tcsh|zsh)/\""])))
          + ($all | of(["$PB.command($CMD,\"/c\",$ARG,$$$_)","$PB.command(Arrays.asList($CMD,\"/c\",$ARG,$$$_),$$$_)","$PB.command(new String[]{$CMD,\"/c\",$ARG,$$$_},$$$_)"])
          | in_files_with($all | of(["$CMD = \"cmd\";\n$$$_"])))
          | in_files_with($all | of(["$TYPE $PB = new ProcessBuilder($$$_);\n$$$_"]))
          | in_files_without($all | of(["$ARG = \"$$$_\";\n$$$_","\"$$$_\""]))
          | not_at($all | of(["$PB.command(\"$$$_\",\"$$$_\",\"$$$_\",$$$_)"]))
          | not_at($all | of(["$PB.command(new String[]{\"$$$_\",\"$$$_\",\"$$$_\",$$$_},$$$_)"]))
          | not_at($all | of(["$PB.command(Arrays.asList(\"$$$_\",\"$$$_\",\"$$$_\",$$$_),$$$_)"])))
        | finding("command-injection-process-builder";
            "A formatted or concatenated string was detected as input to a ProcessBuilder call.") ) )
| report
