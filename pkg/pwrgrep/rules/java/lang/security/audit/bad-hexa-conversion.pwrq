# rules: bad-hexa-conversion
# languages: java
# from: java/lang/security/audit/bad-hexa-conversion.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "$X $METHOD($$$_) {\n  $$$_\n  MessageDigest $MD = $$$_;\n  $$$_\n  $MD.digest($$$_);\n  $$$_\n  Integer.toHexString($$$_);\n}"
    ])) as $all
    | ( $all | of(["$X $METHOD($$$_) {\n  $$$_\n  MessageDigest $MD = $$$_;\n  $$$_\n  $MD.digest($$$_);\n  $$$_\n  Integer.toHexString($$$_);\n}"])
        | finding("bad-hexa-conversion";
            "'Integer.toHexString()' strips leading zeroes from each byte if read byte-by-byte.") ) )
| report
