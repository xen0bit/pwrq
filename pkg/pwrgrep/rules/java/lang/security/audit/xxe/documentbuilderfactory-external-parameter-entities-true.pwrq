# rules: documentbuilderfactory-external-parameter-entities-true
# languages: java
# from: java/lang/security/audit/xxe/documentbuilderfactory-external-parameter-entities-true.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "$DBFACTORY.setFeature(\"http://xml.org/sax/features/external-parameter-entities\", true);"
    ])) as $all
    | ( $all | of(["$DBFACTORY.setFeature(\"http://xml.org/sax/features/external-parameter-entities\", true);"])
        | finding("documentbuilderfactory-external-parameter-entities-true";
            "External entities are allowed for $DBFACTORY.") ) )
| report
