      "(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+String\\s+(?P<S>\\S+)\\s+=\\s+\"[\\s\\S]*?\";\\s+[\\s\\S]*?\\s+(?P<EF>\\S+)\\.createValueExpression\\((?P<CTX>\\S+),(?P<S>\\S+),[\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}",
