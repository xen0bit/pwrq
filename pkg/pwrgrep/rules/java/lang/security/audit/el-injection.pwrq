      "(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+ExpressionFactory\\s+(?P<EF>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+(?P<EF>\\S+)\\.createMethodExpression\\((?P<CTX>\\S+),(?P<INPUT>\\S+),[\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}",
