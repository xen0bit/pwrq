\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?,ExpressionFactory\\s+(?P<EF>\\S+),[\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<EF>\\S+)\\.createMethodExpression\\((?P<CTX>\\S+),(?P<INPUT>\\S+),[\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}","(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\(String\\s+(?P<INPUT>\\S+),\\s+[\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<OBJECT>\\S+)\\.buildConstraintViolationWithTemplate\\((?P<INPUT>\\S+),\\s+[\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}"])
          | not_at($all | of(["(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<EF>\\S+)\\.createValueExpression\\((?P<CTX>\\S+),\"[\\s\\S]*?\",[\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}"]))
