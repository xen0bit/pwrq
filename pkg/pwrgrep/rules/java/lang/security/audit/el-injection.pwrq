      "(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?,ExpressionFactory\\s+(?P<EF>\\S+),[\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<EF>\\S+)\\.createValueExpression\\((?P<CTX>\\S+),(?P<INPUT>\\S+),[\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}",
