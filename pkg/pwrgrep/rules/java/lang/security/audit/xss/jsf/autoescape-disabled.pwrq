# rules: autoescape-disabled
# from: java/lang/security/audit/xss/jsf/autoescape-disabled.yaml

. as $root
| ( ($root | scan_regex(["*.html","*.xhtml"]; [
      ".*escape.*?=.*?false.*"
    ])) as $all
    | ( $all | of([".*escape.*?=.*?false.*"])
        | finding("autoescape-disabled";
            "Detected an element with disabled HTML escaping.") ) )
| report
