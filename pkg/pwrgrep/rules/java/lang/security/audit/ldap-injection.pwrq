# rules: ldap-injection
# languages: java
# from: java/lang/security/audit/ldap-injection.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "$X $METHOD($$$_) {\n  $$$_\n  $CTX.search($Y,\"$$$_\",$$$_);\n  $$$_\n}",
      "$X $METHOD($$$_) {\n  $$$_\n  $CTX.search($Y,$INPUT,$$$_);\n  $$$_\n}",
      "$X $METHOD($$$_) {\n  $$$_\n  DirContext $CTX = $$$_;\n  $$$_\n}",
      "$X $METHOD($$$_) {\n  $$$_\n  EventDirContext $CTX = $$$_;\n  $$$_\n}",
      "$X $METHOD($$$_) {\n  $$$_\n  InitialDirContext $CTX = $$$_;\n  $$$_\n}",
      "$X $METHOD($$$_) {\n  $$$_\n  InitialLdapContext $CTX = $$$_;\n  $$$_\n}",
      "$X $METHOD($$$_) {\n  $$$_\n  LdapContext $CTX = $$$_;\n  $$$_\n}",
      "$X $METHOD($$$_) {\n  $$$_\n  LdapCtx $CTX = $$$_;\n  $$$_\n}"
    ])) as $all
    | ( ($all
          | within($all | of(["$X $METHOD($$$_) {\n  $$$_\n  InitialDirContext $CTX = $$$_;\n  $$$_\n}"])))
          + ($all
          | within($all | of(["$X $METHOD($$$_) {\n  $$$_\n  DirContext $CTX = $$$_;\n  $$$_\n}"])))
          + ($all
          | within($all | of(["$X $METHOD($$$_) {\n  $$$_\n  InitialLdapContext $CTX = $$$_;\n  $$$_\n}"])))
          + ($all
          | within($all | of(["$X $METHOD($$$_) {\n  $$$_\n  LdapContext $CTX = $$$_;\n  $$$_\n}"])))
          + ($all
          | within($all | of(["$X $METHOD($$$_) {\n  $$$_\n  LdapCtx $CTX = $$$_;\n  $$$_\n}"])))
          + ($all
          | within($all | of(["$X $METHOD($$$_) {\n  $$$_\n  EventDirContext $CTX = $$$_;\n  $$$_\n}"])))
          | at_same_place(($all | of(["$X $METHOD($$$_) {\n  $$$_\n  $CTX.search($Y,$INPUT,$$$_);\n  $$$_\n}"])))
          | not_at($all | of(["$X $METHOD($$$_) {\n  $$$_\n  $CTX.search($Y,\"$$$_\",$$$_);\n  $$$_\n}"]))
        | finding("ldap-injection";
            "Detected non-constant data passed into an LDAP query.") ) )
| report
