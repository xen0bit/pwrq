# rules: vertx-sqli
# languages: java
# from: java/lang/security/audit/sqli/vertx-sqli.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "$SC.$METHOD(\"$$$_\" + \"$$$_\",$$$_);",
      "$SC.$METHOD($SQL,$$$_)",
      "$SC.$METHOD($X + $Y,$$$_);",
      "$SC.$METHOD(String.format($$$_),$$$_);",
      "$TYPE $FUNC($$$_,SqlClient $SC,$$$_) {\n  $$$_\n}",
      "$TYPE $FUNC($$$_,SqlConnection $SC,$$$_) {\n  $$$_\n}",
      "$TYPE $FUNC($$$_,String $SQL,$$$_) {\n  $$$_\n}",
      "SqlClient $SC = $$$_;\n$$$_",
      "SqlConnection $SC = $$$_;\n$$$_",
      "String $SQL = \"$$$_\" + \"$$$_\";\n$$$_",
      "String $SQL = $X + $Y;\n$$$_",
      "String $SQL = String.format($$$_);\n$$$_"
    ])) as $all
    | ( (($all
          | in_files_with($all | of(["String $SQL = $X + $Y;\n$$$_"])))
          + ($all
          | in_files_with($all | of(["String $SQL = String.format($$$_);\n$$$_"])))
          + ($all
          | within($all | of(["$TYPE $FUNC($$$_,String $SQL,$$$_) {\n  $$$_\n}"])))
          | at_same_place(($all | of(["$SC.$METHOD($SQL,$$$_)"])))
          | in_files_without($all | of(["String $SQL = \"$$$_\" + \"$$$_\";\n$$$_"])))
          + ($all | of(["$SC.$METHOD(String.format($$$_),$$$_);"]))
          + ($all | of(["$SC.$METHOD($X + $Y,$$$_);"]))
          | at_same_place((($all
          | in_files_with($all | of(["SqlClient $SC = $$$_;\n$$$_"])))
          + ($all
          | in_files_with($all | of(["SqlConnection $SC = $$$_;\n$$$_"])))
          + ($all
          | within($all | of(["$TYPE $FUNC($$$_,SqlClient $SC,$$$_) {\n  $$$_\n}"])))
          + ($all
          | within($all | of(["$TYPE $FUNC($$$_,SqlConnection $SC,$$$_) {\n  $$$_\n}"])))))
          | not_at($all | of(["$SC.$METHOD(\"$$$_\" + \"$$$_\",$$$_);"]))
          | where_capture("METHOD"; "^(query|preparedQuery|prepare)$")
        | finding("vertx-sqli";
            "Detected a formatted string in a SQL statement.") ) )
| report
