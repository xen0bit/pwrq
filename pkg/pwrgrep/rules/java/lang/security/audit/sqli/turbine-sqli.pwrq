# rules: turbine-sqli
# from: java/lang/security/audit/sqli/turbine-sqli.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "$P.executeQuery(\"$$$_\" + \"$$$_\",$$$_)",
      "$P.executeQuery($SQL,$$$_)",
      "$P.executeQuery($X + $Y,$$$_)",
      "$P.executeQuery(String.format($$$_),$$$_)",
      "$PEER.executeQuery(\"$$$_\" + \"$$$_\",$$$_)",
      "$PEER.executeQuery($SQL,$$$_)",
      "$PEER.executeQuery($X + $Y,$$$_)",
      "$PEER.executeQuery(String.format($$$_),$$$_)",
      "$VAL $FUNC($$$_,BasePeer $P,$$$_) {\n  $$$_\n}",
      "$VAL $FUNC($$$_,GroupPeer $P,$$$_) {\n  $$$_\n}",
      "$VAL $FUNC($$$_,String $SQL,$$$_) {\n  $$$_\n}",
      "BasePeer $P = $$$_;\n$$$_",
      "GroupPeer $P = $$$_;\n$$$_",
      "String $SQL = \"$$$_\" + \"$$$_\";\n$$$_",
      "String $SQL = $X + $Y;\n$$$_",
      "String $SQL = String.format($$$_);\n$$$_"
    ])) as $all
    | ( ((($all)
          + ($all)
          + ($all)
          | at_same_place(($all | of(["$PEER.executeQuery($SQL,$$$_)"])))
          | in_files_without($all | of(["String $SQL = \"$$$_\" + \"$$$_\";\n$$$_"])))
          + ($all | of(["$PEER.executeQuery(String.format($$$_),$$$_)"]))
          + ($all | of(["$PEER.executeQuery($X + $Y,$$$_)"]))
          | not_at($all | of(["$PEER.executeQuery(\"$$$_\" + \"$$$_\",$$$_)"]))
          | where_capture("PEER"; "(BasePeer|GroupPeer)"))
          + ((($all)
          + ($all)
          + ($all)
          | at_same_place(($all | of(["$P.executeQuery($SQL,$$$_)"])))
          | in_files_without($all | of(["String $SQL = \"$$$_\" + \"$$$_\";\n$$$_"])))
          + ($all | of(["$P.executeQuery(String.format($$$_),$$$_)"]))
          + ($all | of(["$P.executeQuery($X + $Y,$$$_)"]))
          | at_same_place((($all)
          + ($all)
          + ($all)
          + ($all)))
          | not_at($all | of(["$P.executeQuery(\"$$$_\" + \"$$$_\",$$$_)"])))
        | finding("turbine-sqli";
            "Detected a formatted string in a SQL statement.") ) )
| report
