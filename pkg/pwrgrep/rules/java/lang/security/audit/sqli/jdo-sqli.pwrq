# rules: jdo-sqli
# from: java/lang/security/audit/sqli/jdo-sqli.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "$PM.newQuery($$$_,\"$$$_\" + \"$$$_\",$$$_);",
      "$PM.newQuery($$$_,$SQL,$$$_)",
      "$PM.newQuery($$$_,$X + $Y,$$$_);",
      "$PM.newQuery($$$_,String.format($$$_),$$$_);",
      "$Q.$METHOD(\"$$$_\" + \"$$$_\",$$$_);",
      "$Q.$METHOD($SQL,$$$_)",
      "$Q.$METHOD($X + $Y,$$$_);",
      "$Q.$METHOD(String.format($$$_),$$$_);",
      "$TYPE $FUNC($$$_,String $SQL,$$$_) {\n  $$$_\n}",
      "$TYPE $FUNC($$$_,javax.jdo.PersistenceManager $PM,$$$_) {\n  $$$_\n}",
      "$TYPE $FUNC($$$_,javax.jdo.Query $Q,$$$_) {\n  $$$_\n}",
      "$VAL $FUNC($$$_,String $SQL,$$$_) {\n  $$$_\n}",
      "String $SQL = \"$$$_\" + \"$$$_\";\n$$$_",
      "String $SQL = $X + $Y;\n$$$_",
      "String $SQL = String.format($$$_);\n$$$_",
      "javax.jdo.PersistenceManager $PM = $$$_;\n$$$_",
      "javax.jdo.Query $Q = $$$_;\n$$$_"
    ])) as $all
    | ( ((($all)
          + ($all)
          + ($all)
          | at_same_place(($all | of(["$Q.$METHOD($SQL,$$$_)"])))
          | in_files_without($all | of(["String $SQL = \"$$$_\" + \"$$$_\";\n$$$_"])))
          + ($all | of(["$Q.$METHOD(String.format($$$_),$$$_);"]))
          + ($all | of(["$Q.$METHOD($X + $Y,$$$_);"]))
          | at_same_place((($all)
          + ($all)))
          | not_at($all | of(["$Q.$METHOD(\"$$$_\" + \"$$$_\",$$$_);"]))
          | where_capture("METHOD"; "^(setFilter|setGrouping)$"))
          + ((($all)
          + ($all)
          + ($all)
          | at_same_place(($all | of(["$PM.newQuery($$$_,$SQL,$$$_)"])))
          | in_files_without($all | of(["String $SQL = \"$$$_\" + \"$$$_\";\n$$$_"])))
          + ($all | of(["$PM.newQuery($$$_,String.format($$$_),$$$_);"]))
          + ($all | of(["$PM.newQuery($$$_,$X + $Y,$$$_);"]))
          | at_same_place((($all)
          + ($all)))
          | not_at($all | of(["$PM.newQuery($$$_,\"$$$_\" + \"$$$_\",$$$_);"])))
        | finding("jdo-sqli";
            "Detected a formatted string in a SQL statement.") ) )
| report
