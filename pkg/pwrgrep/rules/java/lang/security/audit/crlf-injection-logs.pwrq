# rules: crlf-injection-logs
# from: java/lang/security/audit/crlf-injection-logs.yaml

. as $root
| ( ($root | scan_regex(["*.java"]; [
      "(?P<LOG>\\S+)\\.(?P<LEVEL>\\S+)\\(<[\\s\\S]*?\\s+(?P<REQ>\\S+)\\.getParameter\\([\\s\\S]*?\\)\\s+[\\s\\S]*?>\\);",
      "(?P<LOG>\\S+)\\.log\\((?P<LEVEL>\\S+),<[\\s\\S]*?\\s+(?P<REQ>\\S+)\\.getParameter\\([\\s\\S]*?\\)\\s+[\\s\\S]*?>\\);",
      "(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?,HttpServletRequest\\s+(?P<REQ>\\S+),[\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}",
      "(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?,ServletRequest\\s+(?P<REQ>\\S+),[\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}",
      "(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+HttpServletRequest\\s+(?P<REQ>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+\\}",
      "(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+Logger\\s+(?P<LOG>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+HttpServletRequest\\s+(?P<REQ>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+\\}",
      "(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+Logger\\s+(?P<LOG>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+ServletRequest\\s+(?P<REQ>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+\\}",
      "(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+ServletRequest\\s+(?P<REQ>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+\\}",
      "String\\s+(?P<VAL>\\S+)\\s+=\\s+(?P<REQ>\\S+)\\.getParameter\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+(?P<LOG>\\S+)\\.(?P<LEVEL>\\S+)\\(<[\\s\\S]*?\\s+(?P<VAL>\\S+)\\s+[\\s\\S]*?>\\);",
      "String\\s+(?P<VAL>\\S+)\\s+=\\s+(?P<REQ>\\S+)\\.getParameter\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+(?P<LOG>\\S+)\\.log\\((?P<LEVEL>\\S+),<[\\s\\S]*?\\s+(?P<VAL>\\S+)\\s+[\\s\\S]*?>\\);",
      "class\\s+(?P<CLASS>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+Logger\\s+(?P<LOG>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+\\}"
    ])) as $all
    | ( (($all
          | within($all | of(["(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?,HttpServletRequest\\s+(?P<REQ>\\S+),[\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}"])))
          + ($all
          | within($all | of(["(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?,ServletRequest\\s+(?P<REQ>\\S+),[\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}"])))
          + ($all
          | within($all | of(["(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+HttpServletRequest\\s+(?P<REQ>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+\\}"])))
          + ($all
          | within($all | of(["(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+ServletRequest\\s+(?P<REQ>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+\\}"])))
          | within($all | of(["class\\s+(?P<CLASS>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+Logger\\s+(?P<LOG>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+\\}"])))
          + ($all
          | within($all | of(["(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+Logger\\s+(?P<LOG>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+HttpServletRequest\\s+(?P<REQ>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+\\}"])))
          + ($all
          | within($all | of(["(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+Logger\\s+(?P<LOG>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+ServletRequest\\s+(?P<REQ>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+\\}"])))
          | at_same_place(($all | of(["String\\s+(?P<VAL>\\S+)\\s+=\\s+(?P<REQ>\\S+)\\.getParameter\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+(?P<LOG>\\S+)\\.(?P<LEVEL>\\S+)\\(<[\\s\\S]*?\\s+(?P<VAL>\\S+)\\s+[\\s\\S]*?>\\);","String\\s+(?P<VAL>\\S+)\\s+=\\s+(?P<REQ>\\S+)\\.getParameter\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+(?P<LOG>\\S+)\\.log\\((?P<LEVEL>\\S+),<[\\s\\S]*?\\s+(?P<VAL>\\S+)\\s+[\\s\\S]*?>\\);","(?P<LOG>\\S+)\\.(?P<LEVEL>\\S+)\\(<[\\s\\S]*?\\s+(?P<REQ>\\S+)\\.getParameter\\([\\s\\S]*?\\)\\s+[\\s\\S]*?>\\);","(?P<LOG>\\S+)\\.log\\((?P<LEVEL>\\S+),<[\\s\\S]*?\\s+(?P<REQ>\\S+)\\.getParameter\\([\\s\\S]*?\\)\\s+[\\s\\S]*?>\\);"])))
        | finding("crlf-injection-logs";
            "When data from an untrusted source is put into a logger and not neutralized correctly, an attacker could forge log entries or include malicious content.") ) )
| report
