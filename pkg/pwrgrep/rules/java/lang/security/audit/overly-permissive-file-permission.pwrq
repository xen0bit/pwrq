# rules: overly-permissive-file-permission
# languages: java
# from: java/lang/security/audit/overly-permissive-file-permission.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "$P.add(java.nio.file.attribute.PosixFilePermission.OTHERS_EXECUTE);\n$$$_\njava.nio.file.Files.setPosixFilePermissions($FILE, $P);",
      "$P.add(java.nio.file.attribute.PosixFilePermission.OTHERS_READ);\n$$$_\njava.nio.file.Files.setPosixFilePermissions($FILE, $P);",
      "$P.add(java.nio.file.attribute.PosixFilePermission.OTHERS_WRITE);\n$$$_\njava.nio.file.Files.setPosixFilePermissions($FILE, $P);",
      "$TYPE $P = java.nio.file.attribute.PosixFilePermissions.fromString(\"=~/(^$$$_$$$_r..$)|(^$$$_$$$_.w.$)|(^$$$_$$$_..x$)/\");\n$$$_\njava.nio.file.Files.setPosixFilePermissions($FILE, $P);",
      "java.nio.file.Files.setPosixFilePermissions($FILE, java.nio.file.attribute.PosixFilePermissions.fromString(\"=~/(^$$$_$$$_r..$)|(^$$$_$$$_.w.$)|(^$$$_$$$_..x$)/\"));"
    ])) as $all
    | ( $all | of(["java.nio.file.Files.setPosixFilePermissions($FILE, java.nio.file.attribute.PosixFilePermissions.fromString(\"=~/(^$$$_$$$_r..$)|(^$$$_$$$_.w.$)|(^$$$_$$$_..x$)/\"));","$TYPE $P = java.nio.file.attribute.PosixFilePermissions.fromString(\"=~/(^$$$_$$$_r..$)|(^$$$_$$$_.w.$)|(^$$$_$$$_..x$)/\");\n$$$_\njava.nio.file.Files.setPosixFilePermissions($FILE, $P);","$P.add(java.nio.file.attribute.PosixFilePermission.OTHERS_READ);\n$$$_\njava.nio.file.Files.setPosixFilePermissions($FILE, $P);","$P.add(java.nio.file.attribute.PosixFilePermission.OTHERS_WRITE);\n$$$_\njava.nio.file.Files.setPosixFilePermissions($FILE, $P);","$P.add(java.nio.file.attribute.PosixFilePermission.OTHERS_EXECUTE);\n$$$_\njava.nio.file.Files.setPosixFilePermissions($FILE, $P);"])
        | finding("overly-permissive-file-permission";
            "Detected file permissions that are overly permissive (read, write, and execute).") ) )
| report
