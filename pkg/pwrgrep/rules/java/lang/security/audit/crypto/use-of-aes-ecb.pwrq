# rules: use-of-aes-ecb
# from: java/lang/security/audit/crypto/use-of-aes-ecb.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "$CIPHER.getInstance(\"=~/AES/ECB.*/\")"
    ])) as $all
    | ( $all | of(["$CIPHER.getInstance(\"=~/AES/ECB.*/\")"])
        | finding("use-of-aes-ecb";
            "Use of AES with ECB mode detected.") ) )
| report
