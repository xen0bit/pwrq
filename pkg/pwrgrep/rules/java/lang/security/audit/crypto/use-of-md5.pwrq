# rules: use-of-md5
# languages: java
# from: java/lang/security/audit/crypto/use-of-md5.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "java.security.MessageDigest.getInstance($ALGO, $$$_);"
    ])) as $all
    | ( $all | of(["java.security.MessageDigest.getInstance($ALGO, $$$_);"])
          | where_capture("ALGO"; "^(?:(.MD5.))")
          | focus("ALGO")
        | finding("use-of-md5";
            "Detected MD5 hash algorithm which is considered insecure.") ) )
| report
