# rules: insecure-trust-manager
# languages: java
# from: java/lang/security/audit/crypto/ssl/insecure-trust-manager.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "class $CLASS implements X509ExtendedTrustManager {\n  $$$_\n}",
      "class $CLASS implements X509TrustManager {\n  $$$_\n}",
      "new X509ExtendedTrustManager() {\n  $$$_\n}",
      "new X509TrustManager() {\n  $$$_\n}",
      "public X509Certificate[] getAcceptedIssuers($$$_) { return null; }",
      "public void checkClientTrusted($$$_) { $SOMETHING; }",
      "public void checkClientTrusted($$$_) {}",
      "public void checkServerTrusted($$$_) { $SOMETHING; }",
      "public void checkServerTrusted($$$_) {}"
    ])) as $all
    | ( ($all
          | within($all | of(["class $CLASS implements X509TrustManager {\n  $$$_\n}"])))
          + ($all
          | within($all | of(["new X509TrustManager() {\n  $$$_\n}"])))
          + ($all
          | within($all | of(["class $CLASS implements X509ExtendedTrustManager {\n  $$$_\n}"])))
          + ($all
          | within($all | of(["new X509ExtendedTrustManager() {\n  $$$_\n}"])))
          | at_same_place(($all | of(["public void checkClientTrusted($$$_) {}","public void checkServerTrusted($$$_) {}","public X509Certificate[] getAcceptedIssuers($$$_) { return null; }"])))
          | not_at($all | of(["public void checkClientTrusted($$$_) { $SOMETHING; }"]))
          | not_at($all | of(["public void checkServerTrusted($$$_) { $SOMETHING; }"]))
        | finding("insecure-trust-manager";
            "Detected empty trust manager implementations.") ) )
| report
