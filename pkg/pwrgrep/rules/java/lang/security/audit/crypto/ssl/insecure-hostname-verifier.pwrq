# rules: insecure-hostname-verifier
# from: java/lang/security/audit/crypto/ssl/insecure-hostname-verifier.yaml

. as $root
| ( ($root | scan_regex(["*.java"]; [
      "class\\s+(?P<CLASS>\\S+)\\s+implements\\s+HostnameVerifier\\s+\\{\\s+[\\s\\S]*?\\s+public\\s+boolean\\s+verify\\([\\s\\S]*?\\)\\s+\\{\\s+return\\s+true;\\s+\\}\\s+\\}",
      "import\\s+org\\.apache\\.http\\.conn\\.ssl\\.NoopHostnameVerifier;",
      "new\\s+HostnameVerifier\\([\\s\\S]*?\\)\\{\\s+public\\s+boolean\\s+verify\\([\\s\\S]*?\\)\\s+\\{\\s+return\\s+true;\\s+\\}\\s+\\}"
    ])) as $all
    | ( $all | of(["class\\s+(?P<CLASS>\\S+)\\s+implements\\s+HostnameVerifier\\s+\\{\\s+[\\s\\S]*?\\s+public\\s+boolean\\s+verify\\([\\s\\S]*?\\)\\s+\\{\\s+return\\s+true;\\s+\\}\\s+\\}","new\\s+HostnameVerifier\\([\\s\\S]*?\\)\\{\\s+public\\s+boolean\\s+verify\\([\\s\\S]*?\\)\\s+\\{\\s+return\\s+true;\\s+\\}\\s+\\}","import\\s+org\\.apache\\.http\\.conn\\.ssl\\.NoopHostnameVerifier;"])
        | finding("insecure-hostname-verifier";
            "Insecure HostnameVerifier implementation detected.") ) )
| report
