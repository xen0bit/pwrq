# rules: unencrypted-socket
# languages: java
# from: java/lang/security/audit/crypto/unencrypted-socket.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "new ServerSocket($$$_)",
      "new Socket($$$_)"
    ])) as $all
    | ( $all | of(["new ServerSocket($$$_)","new Socket($$$_)"])
        | finding("unencrypted-socket";
            "Detected use of a Java socket that is not encrypted.") ) )
| report
