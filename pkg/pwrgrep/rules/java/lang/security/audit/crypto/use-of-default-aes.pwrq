# rules: use-of-default-aes
# from: java/lang/security/audit/crypto/use-of-default-aes.yaml

. as $root
| ( ($root | scan_regex(["*.java"]; [
      "Cipher\\.getInstance\\(\"AES\"\\)",
      "\\(Cipher\\s+(?P<CIPHER>\\S+)\\)\\.getInstance\\(\"AES\"\\)",
      "\\(crypto\\.Cipher\\s+(?P<CIPHER>\\S+)\\)\\.getInstance\\(\"AES\"\\)",
      "\\(javax\\.crypto\\.Cipher\\s+(?P<CIPHER>\\S+)\\)\\.getInstance\\(\"AES\"\\)",
      "crypto\\.Cipher\\.getInstance\\(\"AES\"\\)",
      "import\\s+javax;\\s+[\\s\\S]*?",
      "import\\s+javax\\.\\*;\\s+[\\s\\S]*?",
      "import\\s+javax\\.crypto;\\s+[\\s\\S]*?",
      "import\\s+javax\\.crypto\\.Cipher;\\s+[\\s\\S]*?",
      "import\\s+javax\\.crypto\\.\\*;\\s+[\\s\\S]*?",
      "javax\\.crypto\\.Cipher\\.getInstance\\(\"AES\"\\)"
    ])) as $all
    | ( (($all
          | in_files_with($all | of(["import\\s+javax;\\s+[\\s\\S]*?"])))
          | at_same_place(($all | of(["javax\\.crypto\\.Cipher\\.getInstance\\(\"AES\"\\)","\\(javax\\.crypto\\.Cipher\\s+(?P<CIPHER>\\S+)\\)\\.getInstance\\(\"AES\"\\)"]))))
          + (($all
          | in_files_with($all | of(["import\\s+javax\\.\\*;\\s+[\\s\\S]*?"])))
          + ($all
          | in_files_with($all | of(["import\\s+javax\\.crypto;\\s+[\\s\\S]*?"])))
          | at_same_place(($all | of(["crypto\\.Cipher\\.getInstance\\(\"AES\"\\)","\\(crypto\\.Cipher\\s+(?P<CIPHER>\\S+)\\)\\.getInstance\\(\"AES\"\\)"]))))
          + (($all
          | in_files_with($all | of(["import\\s+javax\\.crypto\\.\\*;\\s+[\\s\\S]*?"])))
          + ($all
          | in_files_with($all | of(["import\\s+javax\\.crypto\\.Cipher;\\s+[\\s\\S]*?"])))
          | at_same_place(($all | of(["Cipher\\.getInstance\\(\"AES\"\\)","\\(Cipher\\s+(?P<CIPHER>\\S+)\\)\\.getInstance\\(\"AES\"\\)"]))))
        | finding("use-of-default-aes";
            "Use of AES with no settings detected.") ) )
| report
