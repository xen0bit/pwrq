# rules: use-of-rc2
# languages: java
# from: java/lang/security/audit/crypto/use-of-rc2.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "$CIPHER.getInstance(\"RC2\")"
    ])) as $all
    | ( $all | of(["$CIPHER.getInstance(\"RC2\")"])
        | finding("use-of-rc2";
            "Use of RC2 was detected.") ) )
| report
