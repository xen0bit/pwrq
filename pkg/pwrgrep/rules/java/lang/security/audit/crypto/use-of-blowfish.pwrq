# rules: use-of-blowfish
# languages: java
# from: java/lang/security/audit/crypto/use-of-blowfish.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "$CIPHER.getInstance(\"Blowfish\")"
    ])) as $all
    | ( $all | of(["$CIPHER.getInstance(\"Blowfish\")"])
        | finding("use-of-blowfish";
            "Use of Blowfish was detected.") ) )
| report
