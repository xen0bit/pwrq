# rules: ldap-entry-poisoning
# languages: java
# from: java/lang/security/audit/ldap-entry-poisoning.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "SearchControls $VAR = new SearchControls();\n$$$_\n$VAR.setReturningObjFlag(true);",
      "new SearchControls($S, $CL, $TL, $AT, true, $DEREF)"
    ])) as $all
    | ( $all | of(["new SearchControls($S, $CL, $TL, $AT, true, $DEREF)","SearchControls $VAR = new SearchControls();\n$$$_\n$VAR.setReturningObjFlag(true);"])
        | finding("ldap-entry-poisoning";
            "An object-returning LDAP search will allow attackers to control the LDAP response.") ) )
| report
