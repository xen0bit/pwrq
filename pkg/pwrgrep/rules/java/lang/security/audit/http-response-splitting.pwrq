# rules: http-response-splitting
# languages: java
# from: java/lang/security/audit/http-response-splitting.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "$COOKIE = new Cookie($$$_, $VAR, $$$_);\n$$$_\n$RESP.addCookie($COOKIE, $$$_);",
      "$RETTYPE $FUNC($$$_,@PathVariable $TYPE $VAR, $$$_) {\n  $$$_\n}",
      "$VAR = $REQ.getParameter($$$_);\n$$$_\n$COOKIE = new Cookie($$$_, $VAR, $$$_);\n$$$_\n$RESP.addCookie($COOKIE, $$$_);"
    ])) as $all
    | ( ($all | of(["$VAR = $REQ.getParameter($$$_);\n$$$_\n$COOKIE = new Cookie($$$_, $VAR, $$$_);\n$$$_\n$RESP.addCookie($COOKIE, $$$_);"]))
          + ($all | of(["$COOKIE = new Cookie($$$_, $VAR, $$$_);\n$$$_\n$RESP.addCookie($COOKIE, $$$_);"])
          | within($all | of(["$RETTYPE $FUNC($$$_,@PathVariable $TYPE $VAR, $$$_) {\n  $$$_\n}"])))
        | finding("http-response-splitting";
            "Older Java application servers are vulnerable to HTTP response splitting, which may occur if an HTTP request can be injected with CRLF characters.") ) )
| report
