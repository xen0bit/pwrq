# rules: script-engine-injection
# from: java/lang/security/audit/script-engine-injection.yaml

. as $root
| ( ($root | scan_regex(["*.java"]; [
      "(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<SE>\\S+)\\.eval\\(\"[\\s\\S]*?\"\\);\\s+[\\s\\S]*?\\s+\\}",
      "(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<SE>\\S+)\\.eval\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}",
      "(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+ScriptEngine\\s+(?P<SE>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+\\}",
      "(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+String\\s+(?P<S>\\S+)\\s+=\\s+\"[\\s\\S]*?\";\\s+[\\s\\S]*?\\s+(?P<SE>\\S+)\\.eval\\((?P<S>\\S+)\\);\\s+[\\s\\S]*?\\s+\\}",
      "class\\s+(?P<CLASS>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+ScriptEngine\\s+(?P<SE>\\S+);\\s+[\\s\\S]*?\\s+\\}",
      "class\\s+(?P<CLASS>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+ScriptEngine\\s+(?P<SE>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+\\}"
    ])) as $all
    | ( ($all
          | within($all | of(["class\\s+(?P<CLASS>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+ScriptEngine\\s+(?P<SE>\\S+);\\s+[\\s\\S]*?\\s+\\}"])))
          + ($all
          | within($all | of(["class\\s+(?P<CLASS>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+ScriptEngine\\s+(?P<SE>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+\\}"])))
          + ($all
          | within($all | of(["(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+ScriptEngine\\s+(?P<SE>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+\\}"])))
          | at_same_place(($all | of(["(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<SE>\\S+)\\.eval\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}"])))
          | not_at($all | of(["(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<SE>\\S+)\\.eval\\(\"[\\s\\S]*?\"\\);\\s+[\\s\\S]*?\\s+\\}"]))
          | not_at($all | of(["(?P<X>\\S+)\\s+(?P<METHOD>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+String\\s+(?P<S>\\S+)\\s+=\\s+\"[\\s\\S]*?\";\\s+[\\s\\S]*?\\s+(?P<SE>\\S+)\\.eval\\((?P<S>\\S+)\\);\\s+[\\s\\S]*?\\s+\\}"]))
        | finding("script-engine-injection";
            "Detected potential code injection using ScriptEngine.") ) )
| report
