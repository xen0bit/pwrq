# rules: url-rewriting
# languages: java
# from: java/lang/security/audit/url-rewriting.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "$X $METHOD($$$_) {\n  $$$_\n  HttpServletResponse $RES = $$$_;\n  $$$_\n  $RES.encodeRedirectURL($$$_);\n  $$$_\n}",
      "$X $METHOD($$$_) {\n  $$$_\n  HttpServletResponse $RES = $$$_;\n  $$$_\n  $RES.encodeRedirectUrl($$$_);\n  $$$_\n}",
      "$X $METHOD($$$_) {\n  $$$_\n  HttpServletResponse $RES = $$$_;\n  $$$_\n  $RES.encodeURL($$$_);\n  $$$_\n}",
      "$X $METHOD($$$_) {\n  $$$_\n  HttpServletResponse $RES = $$$_;\n  $$$_\n  $RES.encodeUrl($$$_);\n  $$$_\n}",
      "$X $METHOD($$$_,HttpServletResponse $RES,$$$_) {\n  $$$_\n  $RES.encodeRedirectURL($$$_);\n  $$$_\n}",
      "$X $METHOD($$$_,HttpServletResponse $RES,$$$_) {\n  $$$_\n  $RES.encodeRedirectUrl($$$_);\n  $$$_\n}",
      "$X $METHOD($$$_,HttpServletResponse $RES,$$$_) {\n  $$$_\n  $RES.encodeURL($$$_);\n  $$$_\n}",
      "$X $METHOD($$$_,HttpServletResponse $RES,$$$_) {\n  $$$_\n  $RES.encodeUrl($$$_);\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["$X $METHOD($$$_,HttpServletResponse $RES,$$$_) {\n  $$$_\n  $RES.encodeURL($$$_);\n  $$$_\n}","$X $METHOD($$$_,HttpServletResponse $RES,$$$_) {\n  $$$_\n  $RES.encodeUrl($$$_);\n  $$$_\n}","$X $METHOD($$$_,HttpServletResponse $RES,$$$_) {\n  $$$_\n  $RES.encodeRedirectURL($$$_);\n  $$$_\n}","$X $METHOD($$$_,HttpServletResponse $RES,$$$_) {\n  $$$_\n  $RES.encodeRedirectUrl($$$_);\n  $$$_\n}","$X $METHOD($$$_) {\n  $$$_\n  HttpServletResponse $RES = $$$_;\n  $$$_\n  $RES.encodeURL($$$_);\n  $$$_\n}","$X $METHOD($$$_) {\n  $$$_\n  HttpServletResponse $RES = $$$_;\n  $$$_\n  $RES.encodeUrl($$$_);\n  $$$_\n}","$X $METHOD($$$_) {\n  $$$_\n  HttpServletResponse $RES = $$$_;\n  $$$_\n  $RES.encodeRedirectURL($$$_);\n  $$$_\n}","$X $METHOD($$$_) {\n  $$$_\n  HttpServletResponse $RES = $$$_;\n  $$$_\n  $RES.encodeRedirectUrl($$$_);\n  $$$_\n}"])
        | finding("url-rewriting";
            "URL rewriting has significant security risks.") ) )
| report
