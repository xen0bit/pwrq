# rules: assignment-comparison
# languages: java
# from: java/lang/correctness/assignment-comparison.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "if ($X=false) { $$$_ }",
      "if ($X=true) { $$$_ }"
    ])) as $all
    | ( $all | of(["if ($X=true) { $$$_ }","if ($X=false) { $$$_ }"])
        | finding("assignment-comparison";
            "The value of `$X` is being ignored and will be used in the conditional test") ) )
| report
