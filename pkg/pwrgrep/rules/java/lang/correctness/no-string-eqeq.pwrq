# rules: no-string-eqeq
# from: java/lang/correctness/no-string-eqeq.yaml

. as $root
| ( ($root | scan_regex(["*.java"]; [
      "(?P<X>\\S+)\\s+==\\s+\\(String\\s+(?P<Y>\\S+)\\)",
      "null\\s+==\\s+\\(String\\s+(?P<Y>\\S+)\\)"
    ])) as $all
    | ( $all | of(["(?P<X>\\S+)\\s+==\\s+\\(String\\s+(?P<Y>\\S+)\\)"])
          | not_at($all | of(["null\\s+==\\s+\\(String\\s+(?P<Y>\\S+)\\)"]))
        | finding("no-string-eqeq";
            "Strings should not be compared with '=='.") ) )
| report
