# rules: default-resteasy-provider-abuse
# from: java/jax-rs/security/insecure-resteasy.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "@Consumes($$$_)\npublic class $CLASSNAME { $$$_ }",
      "@GET\npublic $RETURNTYPE $METHOD($$$_) { $$$_}",
      "@Path(\"$$$_\")\n@Consumes($$$_)\npublic $RETURNTYPE $METHOD($$$_) { $$$_}",
      "@Path(\"$$$_\")\npublic $RETURNTYPE $METHOD($$$_) { $$$_}"
    ])) as $all
    | ( $all | of(["@Path(\"$$$_\")\npublic $RETURNTYPE $METHOD($$$_) { $$$_}"])
          | outside($all | of(["@GET\npublic $RETURNTYPE $METHOD($$$_) { $$$_}"]))
          | outside($all | of(["@Path(\"$$$_\")\n@Consumes($$$_)\npublic $RETURNTYPE $METHOD($$$_) { $$$_}"]))
          | outside($all | of(["@Consumes($$$_)\npublic class $CLASSNAME { $$$_ }"]))
        | finding("default-resteasy-provider-abuse";
            "When a Restful webservice endpoint isn't configured with a @Consumes annotation, an attacker could abuse the SerializableProvider by sending a HTTP Request with a Content-Type of application/x-java-serialized-object.") ) )
| report
