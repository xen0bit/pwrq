# rules: jax-rs-path-traversal
# from: java/jax-rs/security/jax-rs-path-traversal.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "$RETURNTYPE $FUNC ($$$_, @PathParam($$$_) $TYPE $VAR, $$$_) {\n  $$$_\n  new File($$$_, $VAR, $$$_);\n  $$$_\n}",
      "$RETURNTYPE $FUNC ($$$_, @javax.ws.rs.PathParam($$$_) $TYPE $VAR, $$$_) {\n  $$$_\n  new File($$$_, $VAR, $$$_);\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["$RETURNTYPE $FUNC ($$$_, @PathParam($$$_) $TYPE $VAR, $$$_) {\n  $$$_\n  new File($$$_, $VAR, $$$_);\n  $$$_\n}","$RETURNTYPE $FUNC ($$$_, @javax.ws.rs.PathParam($$$_) $TYPE $VAR, $$$_) {\n  $$$_\n  new File($$$_, $VAR, $$$_);\n  $$$_\n}"])
        | finding("jax-rs-path-traversal";
            "Detected a potential path traversal.") ) )
| report
