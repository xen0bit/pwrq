# rules: info-leak-on-non-formated-string
# languages: c
# from: c/lang/security/info-leak-on-non-formatted-string.yaml

. as $root
| ( ($root | scan_ast(["*.c"]; [
      "printf(argv[$NUM]);"
    ])) as $all
    | ( $all | of(["printf(argv[$NUM]);"])
        | finding("info-leak-on-non-formated-string";
            "Use %s, %d, %c...") ) )
| report
