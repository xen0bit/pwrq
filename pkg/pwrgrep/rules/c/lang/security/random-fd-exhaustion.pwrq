# rules: random-fd-exhaustion
# languages: c
# from: c/lang/security/random-fd-exhaustion.yaml

. as $root
| ( ($root | scan_ast(["*.c"]; [
      "$FD = open(\"/dev/random\", $$$_);\n$$$_\n$BYTES_READ = read($FD, $$$_);",
      "$FD = open(\"/dev/random\", $$$_);\n$$$_\nread($FD, $$$_);",
      "$FD = open(\"/dev/urandom\", $$$_);\n$$$_\n$BYTES_READ = read($FD, $$$_);",
      "$FD = open(\"/dev/urandom\", $$$_);\n$$$_\nread($FD, $$$_);"
    ])) as $all
    | ( ($all | of(["$FD = open(\"/dev/urandom\", $$$_);\n$$$_\nread($FD, $$$_);"])
          | not_at($all | of(["$FD = open(\"/dev/urandom\", $$$_);\n$$$_\n$BYTES_READ = read($FD, $$$_);"])))
          + ($all | of(["$FD = open(\"/dev/random\", $$$_);\n$$$_\nread($FD, $$$_);"])
          | not_at($all | of(["$FD = open(\"/dev/random\", $$$_);\n$$$_\n$BYTES_READ = read($FD, $$$_);"])))
        | finding("random-fd-exhaustion";
            "Call to 'read()' without error checking is susceptible to file descriptor exhaustion.") ) )
| report
