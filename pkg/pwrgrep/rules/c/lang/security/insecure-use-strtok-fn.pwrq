# rules: insecure-use-strtok-fn
# languages: c
# from: c/lang/security/insecure-use-strtok-fn.yaml

. as $root
| ( ($root | scan_ast(["*.c"]; [
      "strtok($$$_)"
    ])) as $all
    | ( $all | of(["strtok($$$_)"])
        | finding("insecure-use-strtok-fn";
            "Avoid using 'strtok()'.") ) )
| report
