# rules: use-after-free
# from: c/lang/security/use-after-free.yaml

. as $root
| ( ($root | scan_regex(["*.c"]; [
      "(?P<VAR>\\S+)\\->(?P<ACCESSOR>\\S+)",
      "(?P<VAR>\\S+)\\[(?P<NUM>\\S+)\\]",
      "(?P<VAR>\\S+)\\s+=\\s+NULL;\\s+[\\s\\S]*?",
      "\\(\\*(?P<VAR>\\S+)\\)\\.(?P<ACCESSOR>\\S+)",
      "free\\((?P<VAR>\\S+)\\);\\s+[\\s\\S]*?",
      "free\\((?P<VAR>\\S+)\\);\\s+[\\s\\S]*?\\s+(?P<VAR>\\S+)\\s+=\\s+malloc\\([\\s\\S]*?\\);\\s+[\\s\\S]*?"
    ])) as $all
    | ( $all | of(["(?P<VAR>\\S+)\\->(?P<ACCESSOR>\\S+)","\\(\\*(?P<VAR>\\S+)\\)\\.(?P<ACCESSOR>\\S+)","(?P<VAR>\\S+)\\[(?P<NUM>\\S+)\\]"])
          | within($all | of(["free\\((?P<VAR>\\S+)\\);\\s+[\\s\\S]*?"]))
          | outside($all | of(["(?P<VAR>\\S+)\\s+=\\s+NULL;\\s+[\\s\\S]*?"]))
          | outside($all | of(["free\\((?P<VAR>\\S+)\\);\\s+[\\s\\S]*?\\s+(?P<VAR>\\S+)\\s+=\\s+malloc\\([\\s\\S]*?\\);\\s+[\\s\\S]*?"]))
        | finding("use-after-free";
            "Variable '$VAR' was used after being freed.") ) )
| report
