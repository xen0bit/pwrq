# rules: incorrect-use-ato-fn
# languages: c
# from: c/lang/correctness/incorrect-use-ato-fn.yaml

. as $root
| ( ($root | scan_ast(["*.c"]; [
      "atoi($$$_)",
      "atol($$$_)",
      "atoll($$$_)"
    ])) as $all
    | ( $all | of(["atoi($$$_)","atol($$$_)","atoll($$$_)"])
        | finding("incorrect-use-ato-fn";
            "Avoid the 'ato*()' family of functions.") ) )
| report
