# rules: c-string-equality
# from: c/lang/correctness/c-string-equality.yaml

. as $root
| ( ($root | scan_regex(["*.c"]; [
      "\\(char\\s+\\*(?P<X>\\S+)\\)\\s+==\\s+\\(char\\s+\\*(?P<Y>\\S+)\\)"
    ])) as $all
    | ( $all | of(["\\(char\\s+\\*(?P<X>\\S+)\\)\\s+==\\s+\\(char\\s+\\*(?P<Y>\\S+)\\)"])
          | where_capture_compare("$X != 0")
          | where_capture_compare("$Y != 0")
        | finding("c-string-equality";
            "Using == on char* performs pointer comparison, use strcmp instead") ) )
| report
