# rules: aws-dynamodb-table-unencrypted
# languages: hcl
# from: terraform/aws/security/aws-dynamodb-table-unencrypted.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_dynamodb_table\" $ANYTHING {\n  $$$_\n  server_side_encryption {\n    enabled = true\n    kms_key_arn = $$$_\n  }\n  $$$_\n}",
      "resource \"aws_dynamodb_table\" $ANYTHING {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"aws_dynamodb_table\" $ANYTHING {\n  $$$_\n}"])
          | outside($all | of(["resource \"aws_dynamodb_table\" $ANYTHING {\n  $$$_\n  server_side_encryption {\n    enabled = true\n    kms_key_arn = $$$_\n  }\n  $$$_\n}"]))
        | finding("aws-dynamodb-table-unencrypted";
            "By default, AWS DynamoDB Table is encrypted using AWS-managed keys.") ) )
| report
