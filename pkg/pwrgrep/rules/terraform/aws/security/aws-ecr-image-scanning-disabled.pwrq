# rules: aws-ecr-image-scanning-disabled
# languages: hcl
# from: terraform/aws/security/aws-ecr-image-scanning-disabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_ecr_repository\" $ANYTHING {\n  $$$_\n  image_scanning_configuration {\n    $$$_\n    scan_on_push = true\n    $$$_\n  }\n  $$$_\n}",
      "resource \"aws_ecr_repository\" $ANYTHING {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"aws_ecr_repository\" $ANYTHING {\n  $$$_\n}"])
          | outside($all | of(["resource \"aws_ecr_repository\" $ANYTHING {\n  $$$_\n  image_scanning_configuration {\n    $$$_\n    scan_on_push = true\n    $$$_\n  }\n  $$$_\n}"]))
        | finding("aws-ecr-image-scanning-disabled";
            "The ECR repository has image scans disabled.") ) )
| report
