# rules: aws-config-aggregator-not-all-regions
# languages: hcl
# from: terraform/aws/security/aws-config-aggregator-not-all-regions.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_config_configuration_aggregator\" $ANYTHING {\n  $$$_\n  account_aggregation_source {\n    $$$_\n    regions = $$$_\n    $$$_\n  }\n  $$$_\n}",
      "resource \"aws_config_configuration_aggregator\" $ANYTHING {\n  $$$_\n  organization_aggregation_source {\n    $$$_\n    regions = $$$_\n    $$$_\n  }\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"aws_config_configuration_aggregator\" $ANYTHING {\n  $$$_\n  account_aggregation_source {\n    $$$_\n    regions = $$$_\n    $$$_\n  }\n  $$$_\n}","resource \"aws_config_configuration_aggregator\" $ANYTHING {\n  $$$_\n  organization_aggregation_source {\n    $$$_\n    regions = $$$_\n    $$$_\n  }\n  $$$_\n}"])
        | finding("aws-config-aggregator-not-all-regions";
            "The AWS configuration aggregator does not aggregate all AWS Config region.") ) )
| report
