# rules: aws-s3-object-copy-encrypted-with-cmk
# languages: hcl
# from: terraform/aws/security/aws-s3-object-copy-encrypted-with-cmk.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_s3_object_copy\" $ANYTHING {\n  $$$_\n  kms_key_id = $$$_\n  $$$_\n}",
      "resource \"aws_s3_object_copy\" $ANYTHING {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"aws_s3_object_copy\" $ANYTHING {\n  $$$_\n}"])
          | outside($all | of(["resource \"aws_s3_object_copy\" $ANYTHING {\n  $$$_\n  kms_key_id = $$$_\n  $$$_\n}"]))
        | finding("aws-s3-object-copy-encrypted-with-cmk";
            "Ensure S3 object copies are encrypted at rest using KMS CMKs.") ) )
| report
