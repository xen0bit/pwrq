# rules: aws-ssm-document-logging-issues
# languages: hcl
# from: terraform/aws/security/aws-ssm-document-logging-issues.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "content = \"$STATEMENT\"",
      "resource \"aws_ssm_document\" $ANYTHING {\n  $$$_\n  document_format = \"YAML\"\n  $$$_\n}"
    ])) as $all
    | ( ($all | of(["content = \"$STATEMENT\""])
          | outside($all | of(["resource \"aws_ssm_document\" $ANYTHING {\n  $$$_\n  document_format = \"YAML\"\n  $$$_\n}"])))
        | finding("aws-ssm-document-logging-issues";
            "The AWS SSM logs are unencrypted or disabled.") ) )
| report
