# rules: aws-ec2-launch-configuration-ebs-block-device-unencrypted
# languages: hcl
# from: terraform/aws/security/aws-ec2-launch-configuration-ebs-block-device-unencrypted.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "ebs_block_device {\n  $$$_\n  encrypted = true\n  $$$_\n}",
      "ebs_block_device {\n  $$$_\n}",
      "resource \"aws_launch_configuration\" $ANYTHING {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["ebs_block_device {\n  $$$_\n}"])
          | within($all | of(["resource \"aws_launch_configuration\" $ANYTHING {\n  $$$_\n}"]))
          | not_at($all | of(["ebs_block_device {\n  $$$_\n  encrypted = true\n  $$$_\n}"]))
        | finding("aws-ec2-launch-configuration-ebs-block-device-unencrypted";
            "The AWS launch configuration EBS block device is unencrypted.") ) )
| report
