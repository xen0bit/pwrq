# rules: aws-kinesis-stream-unencrypted
# languages: hcl
# from: terraform/aws/security/aws-kinesis-stream-unencrypted.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_kinesis_stream\" $ANYTHING {\n  $$$_\n  encryption_type = \"KMS\"\n  $$$_\n}",
      "resource \"aws_kinesis_stream\" $ANYTHING {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"aws_kinesis_stream\" $ANYTHING {\n  $$$_\n}"])
          | not_at($all | of(["resource \"aws_kinesis_stream\" $ANYTHING {\n  $$$_\n  encryption_type = \"KMS\"\n  $$$_\n}"]))
        | finding("aws-kinesis-stream-unencrypted";
            "The AWS Kinesis stream does not encrypt data at rest.") ) )
| report
