# rules: aws-codebuild-project-unencrypted
# languages: hcl
# from: terraform/aws/security/aws-codebuild-project-unencrypted.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_codebuild_project\" $ANYTHING {\n  $$$_\n  encryption_key = $$$_\n  $$$_\n}",
      "resource \"aws_codebuild_project\" $ANYTHING {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"aws_codebuild_project\" $ANYTHING {\n  $$$_\n}"])
          | outside($all | of(["resource \"aws_codebuild_project\" $ANYTHING {\n  $$$_\n  encryption_key = $$$_\n  $$$_\n}"]))
        | finding("aws-codebuild-project-unencrypted";
            "The AWS CodeBuild Project is unencrypted.") ) )
| report
