# rules: aws-backup-vault-unencrypted
# languages: hcl
# from: terraform/aws/security/aws-backup-vault-unencrypted.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_backup_vault\" $BACKUP {\n  $$$_\n  kms_key_arn = $$$_\n  $$$_\n}",
      "resource \"aws_backup_vault\" $BACKUP {$$$_}"
    ])) as $all
    | ( $all | of(["resource \"aws_backup_vault\" $BACKUP {$$$_}"])
          | outside($all | of(["resource \"aws_backup_vault\" $BACKUP {\n  $$$_\n  kms_key_arn = $$$_\n  $$$_\n}"]))
        | finding("aws-backup-vault-unencrypted";
            "The AWS Backup vault is unencrypted.") ) )
| report
