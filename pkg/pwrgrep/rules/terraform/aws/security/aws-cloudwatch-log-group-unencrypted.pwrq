# rules: aws-cloudwatch-log-group-unencrypted
# languages: hcl
# from: terraform/aws/security/aws-cloudwatch-log-group-unencrypted.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_cloudwatch_log_group\" $ANYTHING {\n  $$$_\n  kms_key_id = $$$_\n  $$$_\n}",
      "resource \"aws_cloudwatch_log_group\" $ANYTHING {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"aws_cloudwatch_log_group\" $ANYTHING {\n  $$$_\n}"])
          | outside($all | of(["resource \"aws_cloudwatch_log_group\" $ANYTHING {\n  $$$_\n  kms_key_id = $$$_\n  $$$_\n}"]))
        | finding("aws-cloudwatch-log-group-unencrypted";
            "By default, AWS CloudWatch Log Group is encrypted using AWS-managed keys.") ) )
| report
