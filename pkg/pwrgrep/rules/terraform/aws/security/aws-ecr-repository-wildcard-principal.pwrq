# rules: aws-ecr-repository-wildcard-principal
# from: terraform/aws/security/aws-ecr-repository-wildcard-principal.yaml

. as $root
| ( ($root | scan_regex(["*.tf"]; [
      "\\{[\\s\\S]*?,\\s+Effect\\s+=\\s+\"Deny\",\\s+[\\s\\S]*?\\}",
      "\\{[\\s\\S]*?,\\s+Principal\\s+=\\s+\"\\*\",\\s+[\\s\\S]*?\\}",
      "\\{[\\s\\S]*?,\\s+Principal\\s+=\\s+\\[[\\s\\S]*?,\\s+\"\\*\",\\s+[\\s\\S]*?\\],\\s+[\\s\\S]*?\\}",
      "\\{[\\s\\S]*?,\\s+Principal\\s+=\\s+\\{\\s+AWS\\s+=\\s+\"\\*\"\\s+\\},\\s+[\\s\\S]*?\\}",
      "\\{[\\s\\S]*?,\\s+Principal\\s+=\\s+\\{\\s+AWS\\s+=\\s+\\[[\\s\\S]*?,\\s+\"\\*\",\\s+[\\s\\S]*?\\]\\s+\\},\\s+[\\s\\S]*?\\}",
      "policy\\s+=\\s+\"(?P<JSONPOLICY>\\S+)\"",
      "policy\\s+=\\s+jsonencode\\([\\s\\S]*?\\)",
      "resource\\s+\"aws_ecr_repository_policy\"\\s+(?P<ANYTHING>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+\\}"
    ])) as $all
    | ( ($all | of(["policy\\s+=\\s+\"(?P<JSONPOLICY>\\S+)\""]))
          + ($all | of(["\\{[\\s\\S]*?,\\s+Principal\\s+=\\s+\"\\*\",\\s+[\\s\\S]*?\\}","\\{[\\s\\S]*?,\\s+Principal\\s+=\\s+\\[[\\s\\S]*?,\\s+\"\\*\",\\s+[\\s\\S]*?\\],\\s+[\\s\\S]*?\\}","\\{[\\s\\S]*?,\\s+Principal\\s+=\\s+\\{\\s+AWS\\s+=\\s+\"\\*\"\\s+\\},\\s+[\\s\\S]*?\\}","\\{[\\s\\S]*?,\\s+Principal\\s+=\\s+\\{\\s+AWS\\s+=\\s+\\[[\\s\\S]*?,\\s+\"\\*\",\\s+[\\s\\S]*?\\]\\s+\\},\\s+[\\s\\S]*?\\}"])
          | within($all | of(["policy\\s+=\\s+jsonencode\\([\\s\\S]*?\\)"]))
          | outside($all | of(["\\{[\\s\\S]*?,\\s+Effect\\s+=\\s+\"Deny\",\\s+[\\s\\S]*?\\}"])))
          | within($all | of(["resource\\s+\"aws_ecr_repository_policy\"\\s+(?P<ANYTHING>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+\\}"]))
        | finding("aws-ecr-repository-wildcard-principal";
            "Detected wildcard access granted in your ECR repository policy principal.") ) )
| report
