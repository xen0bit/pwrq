# rules: aws-opensearchserverless-encrypted-with-cmk
# from: terraform/aws/security/aws-opensearchserverless-encrypted-with-cmk.yaml

. as $root
| ( ($root | scan_regex(["*.tf"]; [
      "\\{[\\s\\S]*?,\\s+AWSOwnedKey\\s+=\\s+true,\\s+[\\s\\S]*?\\}",
      "policy\\s+=\\s+\"(?P<JSONPOLICY>\\S+)\"",
      "policy\\s+=\\s+jsonencode\\([\\s\\S]*?\\)",
      "resource\\s+\"aws_opensearchserverless_security_policy\"\\s+(?P<ANYTHING>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+type\\s+=\\s+\"encryption\"\\s+[\\s\\S]*?\\s+\\}"
    ])) as $all
    | ( ($all | of(["policy\\s+=\\s+\"(?P<JSONPOLICY>\\S+)\""])
          | where_capture_ast("JSONPOLICY"; "\\{[\\s\\S]*?,\\s+\"AWSOwnedKey\":true,\\s+[\\s\\S]*?\\s+\\}"))
          + ($all | of(["\\{[\\s\\S]*?,\\s+AWSOwnedKey\\s+=\\s+true,\\s+[\\s\\S]*?\\}"])
          | within($all | of(["policy\\s+=\\s+jsonencode\\([\\s\\S]*?\\)"])))
          | within($all | of(["resource\\s+\"aws_opensearchserverless_security_policy\"\\s+(?P<ANYTHING>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+type\\s+=\\s+\"encryption\"\\s+[\\s\\S]*?\\s+\\}"]))
        | finding("aws-opensearchserverless-encrypted-with-cmk";
            "Ensure opensearch serverless is encrypted at rest using AWS KMS (Key Management Service) CMK (Customer Managed Keys).") ) )
| report
