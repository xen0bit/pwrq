# rules: aws-insecure-cloudfront-distribution-tls-version
# languages: hcl
# from: terraform/aws/security/aws-cloudfront-insecure-tls.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_cloudfront_distribution\" $ANYTHING {\n  $$$_\n  viewer_certificate {\n    $$$_\n    minimum_protocol_version = \"TLSv1.2_2018\"\n    $$$_\n  }\n  $$$_\n}",
      "resource \"aws_cloudfront_distribution\" $ANYTHING {\n  $$$_\n  viewer_certificate {\n    $$$_\n    minimum_protocol_version = \"TLSv1.2_2019\"\n    $$$_\n  }\n  $$$_\n}",
      "resource \"aws_cloudfront_distribution\" $ANYTHING {\n  $$$_\n  viewer_certificate {\n    $$$_\n    minimum_protocol_version = \"TLSv1.2_2021\"\n    $$$_\n  }\n  $$$_\n}",
      "resource \"aws_cloudfront_distribution\" $ANYTHING {\n  $$$_\n  viewer_certificate {\n    $$$_\n  }\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"aws_cloudfront_distribution\" $ANYTHING {\n  $$$_\n  viewer_certificate {\n    $$$_\n  }\n  $$$_\n}"])
          | outside($all | of(["resource \"aws_cloudfront_distribution\" $ANYTHING {\n  $$$_\n  viewer_certificate {\n    $$$_\n    minimum_protocol_version = \"TLSv1.2_2018\"\n    $$$_\n  }\n  $$$_\n}"]))
          | outside($all | of(["resource \"aws_cloudfront_distribution\" $ANYTHING {\n  $$$_\n  viewer_certificate {\n    $$$_\n    minimum_protocol_version = \"TLSv1.2_2019\"\n    $$$_\n  }\n  $$$_\n}"]))
          | outside($all | of(["resource \"aws_cloudfront_distribution\" $ANYTHING {\n  $$$_\n  viewer_certificate {\n    $$$_\n    minimum_protocol_version = \"TLSv1.2_2021\"\n    $$$_\n  }\n  $$$_\n}"]))
        | finding("aws-insecure-cloudfront-distribution-tls-version";
            "Detected an AWS CloudFront Distribution with an insecure TLS version.") ) )
| report
