# rules: aws-emr-encrypted-with-cmk
# languages: hcl
# from: terraform/aws/security/aws-emr-encrypted-with-cmk.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "configuration = \"$STATEMENT\"",
      "resource \"aws_emr_security_configuration\" $ANYTHING {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["configuration = \"$STATEMENT\""])
          | within($all | of(["resource \"aws_emr_security_configuration\" $ANYTHING {\n  $$$_\n}"]))
        | finding("aws-emr-encrypted-with-cmk";
            "Ensure EMR is encrypted at rest using KMS CMKs.") ) )
| report
