# rules: aws-secretsmanager-secret-unencrypted
# languages: hcl
# from: terraform/aws/security/aws-secretsmanager-secret-unencrypted.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_secretsmanager_secret\" $ANYTHING {\n  $$$_\n  kms_key_id = $$$_\n  $$$_\n}",
      "resource \"aws_secretsmanager_secret\" $ANYTHING {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"aws_secretsmanager_secret\" $ANYTHING {\n  $$$_\n}"])
          | outside($all | of(["resource \"aws_secretsmanager_secret\" $ANYTHING {\n  $$$_\n  kms_key_id = $$$_\n  $$$_\n}"]))
        | finding("aws-secretsmanager-secret-unencrypted";
            "By default, AWS SecretManager secrets are encrypted using AWS-managed keys.") ) )
| report
