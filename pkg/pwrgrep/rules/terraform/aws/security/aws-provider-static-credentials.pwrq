# rules: aws-provider-static-credentials
# languages: hcl
# from: terraform/aws/security/aws-provider-static-credentials.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "provider \"aws\" {\n$$$_\n    secret_key = \"$SECRET\"\n}"
    ])) as $all
    | ( $all
          | within($all | of(["provider \"aws\" {\n$$$_\n    secret_key = \"$SECRET\"\n}"]))
          | focus("SECRET")
        | finding("aws-provider-static-credentials";
            "A hard-coded credential was detected.") ) )
| report
