# rules: wildcard-assume-role
# languages: hcl
# from: terraform/aws/security/wildcard-assume-role.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "assume_role_policy = \"$STATEMENT\"",
      "resource \"aws_iam_role\" $NAME {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["assume_role_policy = \"$STATEMENT\""])
          | within($all | of(["resource \"aws_iam_role\" $NAME {\n  $$$_\n}"]))
        | finding("wildcard-assume-role";
            "Detected wildcard access granted to sts:AssumeRole.") ) )
| report
