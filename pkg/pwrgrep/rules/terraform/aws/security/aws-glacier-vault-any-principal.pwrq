# rules: aws-glacier-vault-any-principal
# languages: hcl
# from: terraform/aws/security/aws-glacier-vault-any-principal.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "access_policy = \"$STATEMENT\"",
      "resource \"aws_glacier_vault\" $ANYTHING {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["access_policy = \"$STATEMENT\""])
          | within($all | of(["resource \"aws_glacier_vault\" $ANYTHING {\n  $$$_\n}"]))
        | finding("aws-glacier-vault-any-principal";
            "Detected wildcard access granted to Glacier Vault.") ) )
| report
