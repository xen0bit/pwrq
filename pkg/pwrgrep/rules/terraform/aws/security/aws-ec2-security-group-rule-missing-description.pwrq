# rules: aws-ec2-security-group-rule-missing-description
# languages: hcl
# from: terraform/aws/security/aws-ec2-security-group-rule-missing-description.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"$SECGROUP\" $ANYTHING {\n  $$$_\n  description = $$$_\n  $$$_\n}",
      "resource \"$SECGROUP\" $ANYTHING {\n  $$$_\n  description = $DESCR\n  $$$_\n}",
      "resource \"$SECGROUP\" $ANYTHING {\n  $$$_\n}",
      "resource \"aws_security_group\" $ANYTHING {\n  $$$_\n  $INGRESS {\n    $$$_\n    description = $$$_\n    $$$_\n  }\n  $$$_\n}",
      "resource \"aws_security_group\" $ANYTHING {\n  $$$_\n  $INGRESS {\n    $$$_\n    description = $DESCR\n    $$$_\n  }\n  $$$_\n}",
      "resource \"aws_security_group\" $ANYTHING {\n  $$$_\n  $INGRESS {\n    $$$_\n  }\n  $$$_\n}"
    ])) as $all
    | ( (($all
          | within($all | of(["resource \"aws_security_group\" $ANYTHING {\n  $$$_\n  $INGRESS {\n    $$$_\n    description = $DESCR\n    $$$_\n  }\n  $$$_\n}"]))
          | where_capture("INGRESS"; "^(ingress|egress)$"))
          + ($all
          | within($all | of(["resource \"$SECGROUP\" $ANYTHING {\n  $$$_\n  description = $DESCR\n  $$$_\n}"]))
          | where_capture("SECGROUP"; "^(aws_security_group_rule|aws_security_group)$"))
          | where_capture("DESCR"; "^(['\\\"]['\\\"]|['\\\"]Managed by Terraform['\\\"])$")
          | focus("DESCR"))
          + ($all | of(["resource \"aws_security_group\" $ANYTHING {\n  $$$_\n  $INGRESS {\n    $$$_\n  }\n  $$$_\n}"])
          | where_capture("INGRESS"; "^(ingress|egress)$")
          | not_at($all | of(["resource \"aws_security_group\" $ANYTHING {\n  $$$_\n  $INGRESS {\n    $$$_\n    description = $$$_\n    $$$_\n  }\n  $$$_\n}"])))
          + ($all | of(["resource \"$SECGROUP\" $ANYTHING {\n  $$$_\n}"])
          | where_capture("SECGROUP"; "^(aws_security_group_rule|aws_security_group)$")
          | not_at($all | of(["resource \"$SECGROUP\" $ANYTHING {\n  $$$_\n  description = $$$_\n  $$$_\n}"])))
        | finding("aws-ec2-security-group-rule-missing-description";
            "The AWS security group rule is missing a description, or its description is empty or the default value.") ) )
| report
