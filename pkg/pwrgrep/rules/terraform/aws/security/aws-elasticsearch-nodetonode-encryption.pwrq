# rules: aws-elasticsearch-nodetonode-encryption-not-enabled
# languages: hcl
# from: terraform/aws/security/aws-elasticsearch-nodetonode-encryption.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_elasticsearch_domain\" $ANYTHING {\n  $$$_\n  cluster_config {\n    $$$_\n    instance_count = $COUNT\n    $$$_\n  }\n  node_to_node_encryption {\n    $$$_\n    enabled = true\n    $$$_\n  }\n}",
      "resource \"aws_elasticsearch_domain\" $ANYTHING {\n  $$$_\n  cluster_config {\n    $$$_\n    instance_count = $COUNT\n    $$$_\n  }\n}",
      "resource \"aws_elasticsearch_domain\" $ANYTHING {\n  $$$_\n  node_to_node_encryption {\n    $$$_\n    enabled = false\n    $$$_\n  }\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"aws_elasticsearch_domain\" $ANYTHING {\n  $$$_\n  node_to_node_encryption {\n    $$$_\n    enabled = false\n    $$$_\n  }\n  $$$_\n}","resource \"aws_elasticsearch_domain\" $ANYTHING {\n  $$$_\n  cluster_config {\n    $$$_\n    instance_count = $COUNT\n    $$$_\n  }\n}"])
          | outside($all | of(["resource \"aws_elasticsearch_domain\" $ANYTHING {\n  $$$_\n  cluster_config {\n    $$$_\n    instance_count = $COUNT\n    $$$_\n  }\n  node_to_node_encryption {\n    $$$_\n    enabled = true\n    $$$_\n  }\n}"]))
          | where_capture_compare("$COUNT > 1")
        | finding("aws-elasticsearch-nodetonode-encryption-not-enabled";
            "Ensure all Elasticsearch has node-to-node encryption enabled.") ) )
| report
