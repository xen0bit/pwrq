# rules: aws-sqs-queue-policy-wildcard-principal
# from: terraform/aws/security/aws-sqs-queue-policy-wildcard-principal.yaml

. as $root
| ( ($root | scan_regex(["*.tf"]; [
      "\\{[\\s\\S]*?,\\s+Effect\\s+=\\s+\"Deny\",\\s+[\\s\\S]*?\\}",
      "\\{[\\s\\S]*?,\\s+Principal\\s+=\\s+\"\\*\",\\s+[\\s\\S]*?\\}",
      "\\{[\\s\\S]*?,\\s+Principal\\s+=\\s+\\[[\\s\\S]*?,\\s+\"\\*\",\\s+[\\s\\S]*?\\],\\s+[\\s\\S]*?\\}",
      "\\{[\\s\\S]*?,\\s+Principal\\s+=\\s+\\{\\s+AWS\\s+=\\s+\"\\*\"\\s+\\},\\s+[\\s\\S]*?\\}",
      "\\{[\\s\\S]*?,\\s+Principal\\s+=\\s+\\{\\s+AWS\\s+=\\s+\\[[\\s\\S]*?,\\s+\"\\*\",\\s+[\\s\\S]*?\\]\\s+\\},\\s+[\\s\\S]*?\\}",
      "policy\\s+=\\s+\"(?P<JSONPOLICY>\\S+)\"",
      "policy\\s+=\\s+jsonencode\\([\\s\\S]*?\\)",
      "resource\\s+\"aws_sqs_queue\"\\s+(?P<ANYTHING>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+\\}",
      "resource\\s+\"aws_sqs_queue_policy\"\\s+(?P<ANYTHING>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+\\}"
    ])) as $all
    | ( ($all
          | within($all | of(["resource\\s+\"aws_sqs_queue_policy\"\\s+(?P<ANYTHING>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+\\}"])))
          + ($all
          | within($all | of(["resource\\s+\"aws_sqs_queue\"\\s+(?P<ANYTHING>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+\\}"])))
          | at_same_place((($all | of(["policy\\s+=\\s+\"(?P<JSONPOLICY>\\S+)\""]))
          + ($all | of(["\\{[\\s\\S]*?,\\s+Principal\\s+=\\s+\"\\*\",\\s+[\\s\\S]*?\\}","\\{[\\s\\S]*?,\\s+Principal\\s+=\\s+\\[[\\s\\S]*?,\\s+\"\\*\",\\s+[\\s\\S]*?\\],\\s+[\\s\\S]*?\\}","\\{[\\s\\S]*?,\\s+Principal\\s+=\\s+\\{\\s+AWS\\s+=\\s+\"\\*\"\\s+\\},\\s+[\\s\\S]*?\\}","\\{[\\s\\S]*?,\\s+Principal\\s+=\\s+\\{\\s+AWS\\s+=\\s+\\[[\\s\\S]*?,\\s+\"\\*\",\\s+[\\s\\S]*?\\]\\s+\\},\\s+[\\s\\S]*?\\}"])
          | within($all | of(["policy\\s+=\\s+jsonencode\\([\\s\\S]*?\\)"]))
          | outside($all | of(["\\{[\\s\\S]*?,\\s+Effect\\s+=\\s+\"Deny\",\\s+[\\s\\S]*?\\}"])))))
        | finding("aws-sqs-queue-policy-wildcard-principal";
            "Wildcard used in your SQS queue policy principal.") ) )
| report
