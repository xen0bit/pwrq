# rules: aws-documentdb-auditing-disabled
# languages: hcl
# from: terraform/aws/security/aws-documentdb-auditing-disabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_docdb_cluster\" $ANYTHING {\n  $$$_\n  enabled_cloudwatch_logs_exports = [$$$_, \"audit\", $$$_]\n  $$$_\n}",
      "resource \"aws_docdb_cluster\" $ANYTHING {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"aws_docdb_cluster\" $ANYTHING {\n  $$$_\n}"])
          | outside($all | of(["resource \"aws_docdb_cluster\" $ANYTHING {\n  $$$_\n  enabled_cloudwatch_logs_exports = [$$$_, \"audit\", $$$_]\n  $$$_\n}"]))
        | finding("aws-documentdb-auditing-disabled";
            "Auditing is not enabled for DocumentDB.") ) )
| report
