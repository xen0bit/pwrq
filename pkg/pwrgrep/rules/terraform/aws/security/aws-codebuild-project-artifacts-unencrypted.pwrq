# rules: aws-codebuild-project-artifacts-unencrypted
# languages: hcl
# from: terraform/aws/security/aws-codebuild-project-artifacts-unencrypted.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_codebuild_project\" $ANYTHING {\n  $$$_\n  artifacts {\n    $$$_\n    encryption_disabled = true\n    $$$_\n  }\n  $$$_\n}",
      "resource \"aws_codebuild_project\" $ANYTHING {\n  $$$_\n  artifacts {\n    type = \"NO_ARTIFACTS\"\n    encryption_disabled = true\n  }\n  $$$_\n}",
      "resource \"aws_codebuild_project\" $ANYTHING {\n  $$$_\n  artifacts {\n    type = \"NO_ARTIFACTS\"\n  }\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"aws_codebuild_project\" $ANYTHING {\n  $$$_\n  artifacts {\n    $$$_\n    encryption_disabled = true\n    $$$_\n  }\n  $$$_\n}"])
          | outside($all | of(["resource \"aws_codebuild_project\" $ANYTHING {\n  $$$_\n  artifacts {\n    type = \"NO_ARTIFACTS\"\n    encryption_disabled = true\n  }\n  $$$_\n}"]))
          | outside($all | of(["resource \"aws_codebuild_project\" $ANYTHING {\n  $$$_\n  artifacts {\n    type = \"NO_ARTIFACTS\"\n  }\n  $$$_\n}"]))
        | finding("aws-codebuild-project-artifacts-unencrypted";
            "The AWS CodeBuild Project Artifacts are unencrypted.") ) )
| report
