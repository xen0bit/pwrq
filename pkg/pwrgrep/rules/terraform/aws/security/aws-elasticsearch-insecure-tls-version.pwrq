# rules: aws-elasticsearch-insecure-tls-version
# languages: hcl
# from: terraform/aws/security/aws-elasticsearch-insecure-tls-version.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_elasticsearch_domain\" $ANYTHING {\n  $$$_\n  domain_endpoint_options {\n    $$$_\n    enforce_https = true\n    tls_security_policy = \"Policy-Min-TLS-1-0-2019-07\"\n    $$$_\n  }\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"aws_elasticsearch_domain\" $ANYTHING {\n  $$$_\n  domain_endpoint_options {\n    $$$_\n    enforce_https = true\n    tls_security_policy = \"Policy-Min-TLS-1-0-2019-07\"\n    $$$_\n  }\n  $$$_\n}"])
        | finding("aws-elasticsearch-insecure-tls-version";
            "Detected an AWS Elasticsearch domain using an insecure version of TLS.") ) )
| report
