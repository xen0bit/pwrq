# rules: aws-ebs-snapshot-encrypted-with-cmk
# languages: hcl
# from: terraform/aws/security/aws-ebs-snapshot-encrypted-with-cmk.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_ebs_snapshot_copy\" $ANYTHING {\n  $$$_\n  encrypted = true\n  $$$_\n}",
      "resource \"aws_ebs_snapshot_copy\" $ANYTHING {\n  $$$_\n  encrypted = true\n  kms_key_id = $$$_\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"aws_ebs_snapshot_copy\" $ANYTHING {\n  $$$_\n  encrypted = true\n  $$$_\n}"])
          | outside($all | of(["resource \"aws_ebs_snapshot_copy\" $ANYTHING {\n  $$$_\n  encrypted = true\n  kms_key_id = $$$_\n  $$$_\n}"]))
        | finding("aws-ebs-snapshot-encrypted-with-cmk";
            "Ensure EBS Snapshot is encrypted at rest using KMS CMKs.") ) )
| report
