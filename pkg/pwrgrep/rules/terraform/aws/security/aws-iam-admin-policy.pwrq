# rules: aws-iam-admin-policy
# languages: hcl
# from: terraform/aws/security/aws-iam-admin-policy.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "policy = \"$STATEMENT\"",
      "resource \"aws_iam_policy\" $ANYTHING {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["policy = \"$STATEMENT\""])
          | within($all | of(["resource \"aws_iam_policy\" $ANYTHING {\n  $$$_\n}"]))
        | finding("aws-iam-admin-policy";
            "Detected admin access granted in your policy.") ) )
| report
