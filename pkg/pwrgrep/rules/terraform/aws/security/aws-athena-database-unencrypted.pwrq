# rules: aws-athena-database-unencrypted
# languages: hcl
# from: terraform/aws/security/aws-athena-database-unencrypted.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_athena_database\" $ANYTHING {\n  $$$_\n  encryption_configuration {\n    $$$_\n  }\n  $$$_\n}",
      "resource \"aws_athena_database\" $ANYTHING {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"aws_athena_database\" $ANYTHING {\n  $$$_\n}"])
          | outside($all | of(["resource \"aws_athena_database\" $ANYTHING {\n  $$$_\n  encryption_configuration {\n    $$$_\n  }\n  $$$_\n}"]))
        | finding("aws-athena-database-unencrypted";
            "The Athena database is unencrypted at rest.") ) )
| report
