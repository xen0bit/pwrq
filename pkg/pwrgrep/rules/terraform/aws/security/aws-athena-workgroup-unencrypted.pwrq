# rules: aws-athena-workgroup-unencrypted
# languages: hcl
# from: terraform/aws/security/aws-athena-workgroup-unencrypted.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_athena_workgroup\" $ANYTHING {\n  $$$_\n  configuration {\n    $$$_\n    result_configuration {\n      $$$_\n      encryption_configuration {\n        $$$_\n      }\n      $$$_\n    }\n    $$$_\n  }\n  $$$_\n}",
      "resource \"aws_athena_workgroup\" $ANYTHING {\n  $$$_\n  configuration {\n    $$$_\n    result_configuration {\n      $$$_\n    }\n    $$$_\n  }\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"aws_athena_workgroup\" $ANYTHING {\n  $$$_\n  configuration {\n    $$$_\n    result_configuration {\n      $$$_\n    }\n    $$$_\n  }\n  $$$_\n}"])
          | outside($all | of(["resource \"aws_athena_workgroup\" $ANYTHING {\n  $$$_\n  configuration {\n    $$$_\n    result_configuration {\n      $$$_\n      encryption_configuration {\n        $$$_\n      }\n      $$$_\n    }\n    $$$_\n  }\n  $$$_\n}"]))
        | finding("aws-athena-workgroup-unencrypted";
            "The AWS Athena Work Group is unencrypted.") ) )
| report
