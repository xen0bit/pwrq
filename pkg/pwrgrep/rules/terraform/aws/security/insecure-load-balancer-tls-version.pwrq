# rules: insecure-load-balancer-tls-version
# languages: hcl
# from: terraform/aws/security/insecure-load-balancer-tls-version.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "protocol = \"HTTP\"",
      "resource $ANYTHING $NAME {\n  $$$_\n  default_action {\n    $$$_\n    redirect {\n      $$$_\n      protocol = \"HTTPS\"\n      $$$_\n    }\n    $$$_\n  }\n  $$$_\n}",
      "resource $RESOURCE $X {\n  $$$_\n}",
      "ssl_policy = $ANYTHING"
    ])) as $all
    | ( ($all | of(["ssl_policy = $ANYTHING"])
          | where_text_not("ELBSecurityPolicy-TLS13-1-[23]-[0-9-]+")
          | where_text_not("ELBSecurityPolicy-FS-1-2-[(Res)0-9-]+"))
          + ($all | of(["protocol = \"HTTP\""])
          | outside($all | of(["resource $ANYTHING $NAME {\n  $$$_\n  default_action {\n    $$$_\n    redirect {\n      $$$_\n      protocol = \"HTTPS\"\n      $$$_\n    }\n    $$$_\n  }\n  $$$_\n}"])))
          | within($all | of(["resource $RESOURCE $X {\n  $$$_\n}"]))
        | finding("insecure-load-balancer-tls-version";
            "Detected an AWS load balancer with an insecure TLS version.") ) )
| report
