# rules: aws-sns-topic-unencrypted
# languages: hcl
# from: terraform/aws/security/aws-sns-topic-unencrypted.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_sns_topic\" $ANYTHING {\n  $$$_\n  kms_master_key_id = $$$_\n  $$$_\n}",
      "resource \"aws_sns_topic\" $ANYTHING {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"aws_sns_topic\" $ANYTHING {\n  $$$_\n}"])
          | outside($all | of(["resource \"aws_sns_topic\" $ANYTHING {\n  $$$_\n  kms_master_key_id = $$$_\n  $$$_\n}"]))
        | finding("aws-sns-topic-unencrypted";
            "The AWS SNS topic is unencrypted.") ) )
| report
