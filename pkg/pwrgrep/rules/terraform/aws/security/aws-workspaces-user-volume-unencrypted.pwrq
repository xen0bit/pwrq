# rules: aws-workspaces-user-volume-unencrypted
# languages: hcl
# from: terraform/aws/security/aws-workspaces-user-volume-unencrypted.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_workspaces_workspace\" $ANYTHING {\n  $$$_\n  user_volume_encryption_enabled = true\n  $$$_\n}",
      "resource \"aws_workspaces_workspace\" $ANYTHING {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"aws_workspaces_workspace\" $ANYTHING {\n  $$$_\n}"])
          | outside($all | of(["resource \"aws_workspaces_workspace\" $ANYTHING {\n  $$$_\n  user_volume_encryption_enabled = true\n  $$$_\n}"]))
        | finding("aws-workspaces-user-volume-unencrypted";
            "The AWS Workspace user volume is unencrypted.") ) )
| report
