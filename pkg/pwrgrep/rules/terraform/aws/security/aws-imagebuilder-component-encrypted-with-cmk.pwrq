# rules: aws-imagebuilder-component-encrypted-with-cmk
# languages: hcl
# from: terraform/aws/security/aws-imagebuilder-component-encrypted-with-cmk.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_imagebuilder_component\" $ANYTHING {\n  $$$_\n  kms_key_id = $$$_\n  $$$_\n}",
      "resource \"aws_imagebuilder_component\" $ANYTHING {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"aws_imagebuilder_component\" $ANYTHING {\n  $$$_\n}"])
          | outside($all | of(["resource \"aws_imagebuilder_component\" $ANYTHING {\n  $$$_\n  kms_key_id = $$$_\n  $$$_\n}"]))
        | finding("aws-imagebuilder-component-encrypted-with-cmk";
            "Ensure ImageBuilder component is encrypted at rest using KMS CMKs.") ) )
| report
