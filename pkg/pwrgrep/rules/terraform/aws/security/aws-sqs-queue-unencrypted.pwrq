# rules: aws-sqs-queue-unencrypted
# languages: hcl
# from: terraform/aws/security/aws-sqs-queue-unencrypted.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_sqs_queue\" $ANYTHING {\n  $$$_\n  kms_master_key_id = $$$_\n  $$$_\n}",
      "resource \"aws_sqs_queue\" $ANYTHING {\n  $$$_\n  sqs_managed_sse_enabled = true\n  $$$_\n}",
      "resource \"aws_sqs_queue\" $ANYTHING {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"aws_sqs_queue\" $ANYTHING {\n  $$$_\n}"])
          | not_at($all | of(["resource \"aws_sqs_queue\" $ANYTHING {\n  $$$_\n  sqs_managed_sse_enabled = true\n  $$$_\n}"]))
          | not_at($all | of(["resource \"aws_sqs_queue\" $ANYTHING {\n  $$$_\n  kms_master_key_id = $$$_\n  $$$_\n}"]))
        | finding("aws-sqs-queue-unencrypted";
            "The AWS SQS queue contents are unencrypted.") ) )
| report
