# rules: aws-lambda-x-ray-tracing-not-active
# languages: hcl
# from: terraform/aws/security/aws-lambda-x-ray-tracing-not-active.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_lambda_function\" $ANYTHING {\n  $$$_\n  tracing_config {\n    $$$_\n    mode = \"Active\"\n    $$$_\n  }\n  $$$_\n}",
      "resource \"aws_lambda_function\" $ANYTHING {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"aws_lambda_function\" $ANYTHING {\n  $$$_\n}"])
          | not_at($all | of(["resource \"aws_lambda_function\" $ANYTHING {\n  $$$_\n  tracing_config {\n    $$$_\n    mode = \"Active\"\n    $$$_\n  }\n  $$$_\n}"]))
        | finding("aws-lambda-x-ray-tracing-not-active";
            "The AWS Lambda function does not have active X-Ray tracing enabled.") ) )
| report
