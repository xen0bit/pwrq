# rules: aws-redshift-cluster-encrypted-with-cmk
# languages: hcl
# from: terraform/aws/security/aws-redshift-cluster-encrypted-with-cmk.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_redshift_cluster\" $ANYTHING {\n  $$$_\n  kms_key_id = $$$_\n  $$$_\n}",
      "resource \"aws_redshift_cluster\" $ANYTHING {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"aws_redshift_cluster\" $ANYTHING {\n  $$$_\n}"])
          | outside($all | of(["resource \"aws_redshift_cluster\" $ANYTHING {\n  $$$_\n  kms_key_id = $$$_\n  $$$_\n}"]))
        | finding("aws-redshift-cluster-encrypted-with-cmk";
            "Ensure AWS Redshift cluster is encrypted at rest using KMS CMKs.") ) )
| report
