# rules: aws-elb-access-logs-not-enabled
# languages: hcl
# from: terraform/aws/security/aws-elb-access-logs-not-enabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_alb\" $ANYTHING {\n  $$$_\n}",
      "resource \"aws_lb\" $ANYTHING {\n  $$$_\n}",
      "resource $ANYLB $ANYTHING {\n  $$$_\n  access_logs {\n    $$$_\n    enabled = true\n    $$$_\n  }\n  $$$_\n}",
      "resource $ANYLB $ANYTHING {\n  $$$_\n  subnet_mapping {\n    $$$_\n  }\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"aws_lb\" $ANYTHING {\n  $$$_\n}","resource \"aws_alb\" $ANYTHING {\n  $$$_\n}"])
          | outside($all | of(["resource $ANYLB $ANYTHING {\n  $$$_\n  access_logs {\n    $$$_\n    enabled = true\n    $$$_\n  }\n  $$$_\n}"]))
          | outside($all | of(["resource $ANYLB $ANYTHING {\n  $$$_\n  subnet_mapping {\n    $$$_\n  }\n  $$$_\n}"]))
        | finding("aws-elb-access-logs-not-enabled";
            "ELB has no logging.") ) )
| report
