# rules: subscription-filter-missing-depends
# languages: hcl
# from: terraform/aws/correctness/subscription-filter-missing-depends.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_cloudwatch_log_subscription_filter\" $NAME {\n  $$$_\n  depends_on = [$$$_, aws_lambda_permission.$PERMISSION_NAME, $$$_]\n}",
      "resource \"aws_cloudwatch_log_subscription_filter\" $NAME {\n  $$$_\n  destination_arn = aws_lambda_function.$LAMBDA_NAME.arn\n}"
    ])) as $all
    | ( $all | of(["resource \"aws_cloudwatch_log_subscription_filter\" $NAME {\n  $$$_\n  destination_arn = aws_lambda_function.$LAMBDA_NAME.arn\n}"])
          | outside($all | of(["resource \"aws_cloudwatch_log_subscription_filter\" $NAME {\n  $$$_\n  depends_on = [$$$_, aws_lambda_permission.$PERMISSION_NAME, $$$_]\n}"]))
        | finding("subscription-filter-missing-depends";
            "The `aws_cloudwatch_log_subscription_filter` resource \"$NAME\" needs a `depends_on` clause on the `aws_lambda_permission`, otherwise Terraform may try to create these out-of-order and fail.") ) )
| report
