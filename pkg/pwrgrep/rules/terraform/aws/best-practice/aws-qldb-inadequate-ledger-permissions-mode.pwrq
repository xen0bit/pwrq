# rules: aws-qldb-inadequate-ledger-permissions-mode
# languages: hcl
# from: terraform/aws/best-practice/aws-qldb-inadequate-ledger-permissions-mode.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_qldb_ledger\" $ANYTHING {\n  $$$_\n  permissions_mode = \"ALLOW_ALL\"\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"aws_qldb_ledger\" $ANYTHING {\n  $$$_\n  permissions_mode = \"ALLOW_ALL\"\n  $$$_\n}"])
        | finding("aws-qldb-inadequate-ledger-permissions-mode";
            "The AWS QLDB ledger permissions are too permissive.") ) )
| report
