# rules: missing-cloudwatch-log-group-retention
# languages: hcl
# from: terraform/aws/best-practice/missing-cloudwatch-log-group-retention.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_cloudwatch_log_group\" $ANYTHING {\n  $$$_\n  retention_in_days = $$$_\n  $$$_\n}",
      "resource \"aws_cloudwatch_log_group\" $ANYTHING {$$$_}"
    ])) as $all
    | ( $all
        | finding("missing-cloudwatch-log-group-retention";
            "The AWS CloudWatch Log group is missing log retention time.") ) )
| report
