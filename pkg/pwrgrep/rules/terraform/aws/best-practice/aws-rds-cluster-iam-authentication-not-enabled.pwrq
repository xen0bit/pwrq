# rules: aws-rds-cluster-iam-authentication-not-enabled
# languages: hcl
# from: terraform/aws/best-practice/aws-rds-cluster-iam-authentication-not-enabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_rds_cluster\" $ANYTHING {\n  $$$_\n  iam_database_authentication_enabled = true\n  $$$_\n}",
      "resource \"aws_rds_cluster\" $ANYTHING {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"aws_rds_cluster\" $ANYTHING {\n  $$$_\n}"])
          | outside($all | of(["resource \"aws_rds_cluster\" $ANYTHING {\n  $$$_\n  iam_database_authentication_enabled = true\n  $$$_\n}"]))
        | finding("aws-rds-cluster-iam-authentication-not-enabled";
            "The AWS RDS Cluster is not configured to use IAM authentication.") ) )
| report
