# rules: missing-autoscaling-group-tags
# from: terraform/aws/best-practice/missing-autoscaling-group-tags.yaml

. as $root
| ( ($root | scan_regex(["*.tf"]; [
      "resource\\s+\"aws_autoscaling_group\"\\s+(?P<ANYTHING>\\S+)\\s+\\{[\\s\\S]*?\\}",
      "resource\\s+\"aws_autoscaling_group\"\\s+(?P<ANYTHING>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+tag\\s+\\{[\\s\\S]*?\\}\\s+[\\s\\S]*?\\s+\\}",
      "resource\\s+\"aws_autoscaling_group\"\\s+(?P<ANYTHING>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+tags\\s+=\\s+concat\\([\\s\\S]*?\\)\\s+[\\s\\S]*?\\s+\\}"
    ])) as $all
    | ( $all
        | finding("missing-autoscaling-group-tags";
            "There are missing tags for an AWS Auto Scaling group.") ) )
| report
