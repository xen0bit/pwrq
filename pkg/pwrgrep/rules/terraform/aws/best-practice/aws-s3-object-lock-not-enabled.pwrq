# rules: aws-s3-object-lock-not-enabled
# languages: hcl
# from: terraform/aws/best-practice/aws-s3-object-lock-not-enabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_s3_bucket\" $ANYTHING {\n  $$$_\n  object_lock_configuration = {\n    object_lock_enabled = \"Disabled\"\n  }\n  $$$_\n}",
      "resource \"aws_s3_bucket\" $ANYTHING {\n  $$$_\n  object_lock_configuration {\n    object_lock_enabled = \"Disabled\"\n  }\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"aws_s3_bucket\" $ANYTHING {\n  $$$_\n  object_lock_configuration = {\n    object_lock_enabled = \"Disabled\"\n  }\n  $$$_\n}","resource \"aws_s3_bucket\" $ANYTHING {\n  $$$_\n  object_lock_configuration {\n    object_lock_enabled = \"Disabled\"\n  }\n  $$$_\n}"])
        | finding("aws-s3-object-lock-not-enabled";
            "The AWS S3 object lock is not enabled.") ) )
| report
