# rules: missing-aws-lb-deletion-protection
# languages: hcl
# from: terraform/aws/best-practice/missing-aws-lb-deletion-protection.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_alb\" \"$$$_\" {\n$$$_\n}",
      "resource \"aws_lb\" \"$$$_\" {\n$$$_\n}",
      "resource $ANYLB $ANYTHING {\n  $$$_\n  enable_deletion_protection = true\n  $$$_\n}"
    ])) as $all
    | ( ($all
          | within($all | of(["resource \"aws_alb\" \"$$$_\" {\n$$$_\n}"])))
          + ($all
          | within($all | of(["resource \"aws_lb\" \"$$$_\" {\n$$$_\n}"])))
          | outside($all | of(["resource $ANYLB $ANYTHING {\n  $$$_\n  enable_deletion_protection = true\n  $$$_\n}"]))
        | finding("missing-aws-lb-deletion-protection";
            "The AWS LoadBalancer deletion protection is not enabled.") ) )
| report
