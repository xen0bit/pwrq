# rules: missing-aws-qldb-deletion-protection
# languages: hcl
# from: terraform/aws/best-practice/missing-aws-qldb-deletion-protection.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_qldb_ledger\" $ANYTHING {\n  $$$_\n  deletion_protection = false\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"aws_qldb_ledger\" $ANYTHING {\n  $$$_\n  deletion_protection = false\n  $$$_\n}"])
        | finding("missing-aws-qldb-deletion-protection";
            "The AWS QLDB deletion protection is not enabled.") ) )
| report
