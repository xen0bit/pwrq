# rules: ec2-imdsv1-optional
# languages: hcl
# from: terraform/lang/security/ec2-imdsv1-optional.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "http_tokens = \"optional\"",
      "metadata_options { $$$_ }",
      "resource \"aws_instance\" \"$NAME\" {\n  $$$_\n  metadata_options {\n    $$$_\n    http_endpoint = \"disabled\"\n    $$$_\n  }\n  $$$_\n}",
      "resource \"aws_instance\" \"$NAME\" {\n  $$$_\n  metadata_options {\n    $$$_\n    http_tokens = \"optional\"\n    $$$_\n  }\n  $$$_\n}",
      "resource \"aws_instance\" \"$NAME\" {\n  $$$_\n  metadata_options {\n    $$$_\n    http_tokens = \"required\"\n    $$$_\n  }\n  $$$_\n}",
      "resource \"aws_instance\" \"$NAME\" {\n  $$$_\n}"
    ])) as $all
    | ( ($all | of(["http_tokens = \"optional\""])
          | within($all | of(["metadata_options { $$$_ }"])))
          + ($all | of(["resource \"aws_instance\" \"$NAME\" {\n  $$$_\n}"])
          | not_at($all | of(["resource \"aws_instance\" \"$NAME\" {\n  $$$_\n  metadata_options {\n    $$$_\n    http_tokens = \"required\"\n    $$$_\n  }\n  $$$_\n}"]))
          | not_at($all | of(["resource \"aws_instance\" \"$NAME\" {\n  $$$_\n  metadata_options {\n    $$$_\n    http_tokens = \"optional\"\n    $$$_\n  }\n  $$$_\n}"]))
          | not_at($all | of(["resource \"aws_instance\" \"$NAME\" {\n  $$$_\n  metadata_options {\n    $$$_\n    http_endpoint = \"disabled\"\n    $$$_\n  }\n  $$$_\n}"])))
        | finding("ec2-imdsv1-optional";
            "AWS EC2 Instance allowing use of the IMDSv1") ) )
| report
