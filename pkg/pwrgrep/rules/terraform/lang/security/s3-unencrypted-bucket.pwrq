# rules: s3-unencrypted-bucket
# languages: hcl
# from: terraform/lang/security/s3-unencrypted-bucket.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "a",
      "b"
    ])) as $all
    | ( $all | of(["a"])
          | at_same_place(($all | of(["b"])))
        | finding("s3-unencrypted-bucket";
            "This rule has been deprecated, as all s3 buckets are encrypted by default with no way to disable it.") ) )
| report
