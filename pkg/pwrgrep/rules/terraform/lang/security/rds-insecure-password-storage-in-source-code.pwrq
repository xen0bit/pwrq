# rules: rds-insecure-password-storage-in-source-code
# languages: hcl
# from: terraform/lang/security/rds-insecure-password-storage-in-source-code.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "master_password = \"$$$_\"",
      "password = \"$$$_\"",
      "resource \"aws_db_instance\" \"$$$_\" {\n  $$$_\n}",
      "resource \"aws_rds_cluster\" \"$$$_\" {\n  $$$_\n}"
    ])) as $all
    | ( ($all | of(["password = \"$$$_\""])
          | within($all | of(["resource \"aws_db_instance\" \"$$$_\" {\n  $$$_\n}"])))
          + ($all | of(["master_password = \"$$$_\""])
          | within($all | of(["resource \"aws_rds_cluster\" \"$$$_\" {\n  $$$_\n}"])))
        | finding("rds-insecure-password-storage-in-source-code";
            "RDS instance or cluster with hardcoded credentials in source code.") ) )
| report
