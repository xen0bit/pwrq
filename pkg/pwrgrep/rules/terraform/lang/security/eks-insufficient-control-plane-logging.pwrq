# rules: eks-insufficient-control-plane-logging
# languages: hcl
# from: terraform/lang/security/eks-insufficient-control-plane-logging.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "name = $$$_",
      "resource \"aws_eks_cluster\" \"$$$_\" {\n  $$$_\n  enabled_cluster_log_types = [$$$_, \"api\", $$$_, \"audit\", $$$_]\n  $$$_\n}",
      "resource \"aws_eks_cluster\" \"$$$_\" {\n  $$$_\n  enabled_cluster_log_types = [$$$_, \"audit\", $$$_, \"api\", $$$_]\n  $$$_\n}",
      "resource \"aws_eks_cluster\" \"$$$_\" {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["name = $$$_"])
          | within($all | of(["resource \"aws_eks_cluster\" \"$$$_\" {\n  $$$_\n}"]))
          | outside($all | of(["resource \"aws_eks_cluster\" \"$$$_\" {\n  $$$_\n  enabled_cluster_log_types = [$$$_, \"api\", $$$_, \"audit\", $$$_]\n  $$$_\n}"]))
          | outside($all | of(["resource \"aws_eks_cluster\" \"$$$_\" {\n  $$$_\n  enabled_cluster_log_types = [$$$_, \"audit\", $$$_, \"api\", $$$_]\n  $$$_\n}"]))
        | finding("eks-insufficient-control-plane-logging";
            "Missing EKS control plane logging.") ) )
| report
