# rules: s3-public-rw-bucket
# languages: hcl
# from: terraform/lang/security/s3-public-rw-bucket.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "acl = \"public-read-write\""
    ])) as $all
    | ( $all | of(["acl = \"public-read-write\""])
        | finding("s3-public-rw-bucket";
            "S3 bucket with public read-write access detected.") ) )
| report
