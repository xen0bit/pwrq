# rules: rds-public-access
# languages: hcl
# from: terraform/lang/security/rds-public-access.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "publicly_accessible = true",
      "resource \"aws_db_instance\" \"$$$_\" {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["publicly_accessible = true"])
          | within($all | of(["resource \"aws_db_instance\" \"$$$_\" {\n  $$$_\n}"]))
        | finding("rds-public-access";
            "RDS instance accessible from the Internet detected.") ) )
| report
