# rules: no-iam-star-actions
# from: terraform/lang/security/iam/no-iam-star-actions.yaml

. as $root
| ( ($root | scan_regex(["*.tf"]; [
      "Action\\s+=\\s+\"\\*\"",
      "Action\\s+=\\s+\\[\"\\*\"\\]",
      "actions\\s+=\\s+\\[\"\\*\"\\]",
      "data\\s+aws_iam_policy_document\\s+\"[\\s\\S]*?\"\\s+\\{\\s+[\\s\\S]*?\\s+statement\\s+\\{\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}",
      "data\\s+aws_iam_policy_document\\s+\"[\\s\\S]*?\"\\s+\\{\\s+[\\s\\S]*?\\s+statement\\s+\\{\\s+[\\s\\S]*?\\s+effect\\s+=\\s+\"Deny\"\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}",
      "resource\\s+(?P<TYPE>\\S+)\\s+\"[\\s\\S]*?\"\\s+\\{\\s+[\\s\\S]*?\\s+policy\\s+=\\s+jsonencode\\(\\{\\s+[\\s\\S]*?\\s+Statement\\s+=\\s+\\[\\s+[\\s\\S]*?,\\s+\\{[\\s\\S]*?\\s+Effect\\s+=\\s+\"Deny\"\\s+[\\s\\S]*?\\},\\s+[\\s\\S]*?\\s+\\]\\s+[\\s\\S]*?\\s+\\}\\)\\s+[\\s\\S]*?\\s+\\}",
      "resource\\s+(?P<TYPE>\\S+)\\s+\"[\\s\\S]*?\"\\s+\\{\\s+[\\s\\S]*?\\s+policy\\s+=\\s+jsonencode\\(\\{\\s+[\\s\\S]*?\\s+Statement\\s+=\\s+\\[\\s+[\\s\\S]*?\\s+\\]\\s+[\\s\\S]*?\\s+\\}\\)\\s+[\\s\\S]*?\\s+\\}"
    ])) as $all
    | ( ($all | of(["Action\\s+=\\s+\"\\*\"","Action\\s+=\\s+\\[\"\\*\"\\]"])
          | within($all | of(["resource\\s+(?P<TYPE>\\S+)\\s+\"[\\s\\S]*?\"\\s+\\{\\s+[\\s\\S]*?\\s+policy\\s+=\\s+jsonencode\\(\\{\\s+[\\s\\S]*?\\s+Statement\\s+=\\s+\\[\\s+[\\s\\S]*?\\s+\\]\\s+[\\s\\S]*?\\s+\\}\\)\\s+[\\s\\S]*?\\s+\\}"]))
          | outside($all | of(["resource\\s+(?P<TYPE>\\S+)\\s+\"[\\s\\S]*?\"\\s+\\{\\s+[\\s\\S]*?\\s+policy\\s+=\\s+jsonencode\\(\\{\\s+[\\s\\S]*?\\s+Statement\\s+=\\s+\\[\\s+[\\s\\S]*?,\\s+\\{[\\s\\S]*?\\s+Effect\\s+=\\s+\"Deny\"\\s+[\\s\\S]*?\\},\\s+[\\s\\S]*?\\s+\\]\\s+[\\s\\S]*?\\s+\\}\\)\\s+[\\s\\S]*?\\s+\\}"])))
          + ($all | of(["actions\\s+=\\s+\\[\"\\*\"\\]"])
          | within($all | of(["data\\s+aws_iam_policy_document\\s+\"[\\s\\S]*?\"\\s+\\{\\s+[\\s\\S]*?\\s+statement\\s+\\{\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}"]))
          | outside($all | of(["data\\s+aws_iam_policy_document\\s+\"[\\s\\S]*?\"\\s+\\{\\s+[\\s\\S]*?\\s+statement\\s+\\{\\s+[\\s\\S]*?\\s+effect\\s+=\\s+\"Deny\"\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}"])))
        | finding("no-iam-star-actions";
            "Ensure that no IAM policies allow \"*\" as a statement's actions.") ) )
| report
