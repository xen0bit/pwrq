# rules: gcp-gke-enable-shielded-nodes
# languages: hcl
# from: terraform/gcp/best-practice/gcp-gke-enable-shielded-nodes.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_container_cluster\" \"$$$_\" {\n$$$_\nenable_shielded_nodes = false\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"google_container_cluster\" \"$$$_\" {\n$$$_\nenable_shielded_nodes = false\n$$$_\n}"]))
        | finding("gcp-gke-enable-shielded-nodes";
            "Ensure Shielded GKE Nodes are Enabled") ) )
| report
