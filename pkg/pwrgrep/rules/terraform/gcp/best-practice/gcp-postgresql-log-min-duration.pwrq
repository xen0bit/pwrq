# rules: gcp-postgresql-log-min-duration
# languages: hcl
# from: terraform/gcp/best-practice/gcp-postgresql-log-min-duration.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_sql_database_instance\" \"$$$_\" {\n  $$$_\n  database_flags {\n    $$$_\n    name  = \"log_min_duration_statement\"\n    value = \"-1\"\n    $$$_\n  }\n  $$$_\n}",
      "resource \"google_sql_database_instance\" \"$$$_\" {\n  $$$_\n  database_flags {\n    $$$_\n  }\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"google_sql_database_instance\" \"$$$_\" {\n  $$$_\n  database_flags {\n    $$$_\n  }\n  $$$_\n}"]))
          | outside($all | of(["resource \"google_sql_database_instance\" \"$$$_\" {\n  $$$_\n  database_flags {\n    $$$_\n    name  = \"log_min_duration_statement\"\n    value = \"-1\"\n    $$$_\n  }\n  $$$_\n}"]))
        | finding("gcp-postgresql-log-min-duration";
            "Ensure PostgreSQL database 'log_min_duration_statement' flag is set to '-1'") ) )
| report
