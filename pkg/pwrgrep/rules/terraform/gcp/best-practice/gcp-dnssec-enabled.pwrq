# rules: gcp-dnssec-enabled
# languages: hcl
# from: terraform/gcp/best-practice/gcp-dnssec-enabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_dns_managed_zone\" \"$$$_\" {\n$$$_\ndnssec_config {\n    state = on\n}\n$$$_\n}",
      "resource \"google_dns_managed_zone\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"google_dns_managed_zone\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"google_dns_managed_zone\" \"$$$_\" {\n$$$_\ndnssec_config {\n    state = on\n}\n$$$_\n}"]))
        | finding("gcp-dnssec-enabled";
            "Ensure that RSASHA1 is not used for the zone-signing and key-signing keys in Cloud DNS DNSSEC") ) )
| report
