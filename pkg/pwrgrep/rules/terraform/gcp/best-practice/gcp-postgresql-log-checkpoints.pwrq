# rules: gcp-postgresql-log-checkpoints
# languages: hcl
# from: terraform/gcp/best-practice/gcp-postgresql-log-checkpoints.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_sql_database_instance\" \"$$$_\" {\n  $$$_\n  database_flags {\n    $$$_\n    name  = \"log_checkpoints\"\n    value = \"off\"\n    $$$_\n  }\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"google_sql_database_instance\" \"$$$_\" {\n  $$$_\n  database_flags {\n    $$$_\n    name  = \"log_checkpoints\"\n    value = \"off\"\n    $$$_\n  }\n  $$$_\n}"]))
        | finding("gcp-postgresql-log-checkpoints";
            "Ensure PostgreSQL database 'log_checkpoints' flag is set to 'on'") ) )
| report
