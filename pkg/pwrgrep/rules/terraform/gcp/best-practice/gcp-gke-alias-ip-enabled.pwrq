# rules: gcp-gke-alias-ip-enabled
# languages: hcl
# from: terraform/gcp/best-practice/gcp-gke-alias-ip-enabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_container_cluster\" \"$$$_\" {\n$$$_\nip_allocation_policy {\n  $$$_\n  use_ip_aliases = \"false\"\n  $$$_\n}\n$$$_\n}",
      "resource \"google_container_cluster\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"google_container_cluster\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"google_container_cluster\" \"$$$_\" {\n$$$_\nip_allocation_policy {\n  $$$_\n  use_ip_aliases = \"false\"\n  $$$_\n}\n$$$_\n}"]))
        | finding("gcp-gke-alias-ip-enabled";
            "Ensure Kubernetes Cluster is created with Alias IP ranges enabled") ) )
| report
