# rules: gcp-gke-metadata-server-enabled
# languages: hcl
# from: terraform/gcp/best-practice/gcp-gke-metadata-server-enabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_container_cluster\" \"$$$_\" {\n$$$_\nnode_config {\n  $$$_\n  workload_metadata_config = $$$_\n  $$$_\n}\n$$$_\n}",
      "resource \"google_container_cluster\" \"$$$_\" {\n$$$_\nnode_config {\n  $$$_\n  workload_metadata_config {\n    $$$_\n    mode = \"GKE_METADATA\"\n    $$$_\n  }\n  $$$_\n}\n$$$_\n}",
      "resource \"google_container_cluster\" \"$$$_\" {\n$$$_\nnode_config {\n  $$$_\n  workload_metadata_config {\n    $$$_\n    node_metadata = \"GKE_METADATA_SERVER\"\n    $$$_\n  }\n  $$$_\n}\n$$$_\n}",
      "resource \"google_container_cluster\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"google_container_cluster\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"google_container_cluster\" \"$$$_\" {\n$$$_\nnode_config {\n  $$$_\n  workload_metadata_config {\n    $$$_\n    node_metadata = \"GKE_METADATA_SERVER\"\n    $$$_\n  }\n  $$$_\n}\n$$$_\n}"]))
          | outside($all | of(["resource \"google_container_cluster\" \"$$$_\" {\n$$$_\nnode_config {\n  $$$_\n  workload_metadata_config {\n    $$$_\n    mode = \"GKE_METADATA\"\n    $$$_\n  }\n  $$$_\n}\n$$$_\n}"]))
          | outside($all | of(["resource \"google_container_cluster\" \"$$$_\" {\n$$$_\nnode_config {\n  $$$_\n  workload_metadata_config = $$$_\n  $$$_\n}\n$$$_\n}"]))
        | finding("gcp-gke-metadata-server-enabled";
            "Ensure the GKE Metadata Server is Enabled") ) )
| report
