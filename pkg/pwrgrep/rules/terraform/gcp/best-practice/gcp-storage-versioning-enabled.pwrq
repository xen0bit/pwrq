# rules: gcp-storage-versioning-enabled
# languages: hcl
# from: terraform/gcp/best-practice/gcp-storage-versioning-enabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_storage_bucket\" \"$$$_\" {\n$$$_\nversioning = {\n  enabled = true\n}\n$$$_\n}",
      "resource \"google_storage_bucket\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"google_storage_bucket\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"google_storage_bucket\" \"$$$_\" {\n$$$_\nversioning = {\n  enabled = true\n}\n$$$_\n}"]))
        | finding("gcp-storage-versioning-enabled";
            "Ensure Cloud storage has versioning enabled") ) )
| report
