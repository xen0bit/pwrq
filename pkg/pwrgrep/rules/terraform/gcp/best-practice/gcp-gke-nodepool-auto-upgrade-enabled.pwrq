# rules: gcp-gke-nodepool-auto-upgrade-enabled
# languages: hcl
# from: terraform/gcp/best-practice/gcp-gke-nodepool-auto-upgrade-enabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_container_node_pool\" \"$$$_\" {\n$$$_\nmanagement {\n  $$$_\n  auto_upgrade = false\n  $$$_\n}\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"google_container_node_pool\" \"$$$_\" {\n$$$_\nmanagement {\n  $$$_\n  auto_upgrade = false\n  $$$_\n}\n$$$_\n}"]))
        | finding("gcp-gke-nodepool-auto-upgrade-enabled";
            "Ensure 'Automatic node upgrade' is enabled for Kubernetes Clusters") ) )
| report
