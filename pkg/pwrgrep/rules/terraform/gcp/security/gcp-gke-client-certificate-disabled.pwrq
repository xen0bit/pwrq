# rules: gcp-gke-client-certificate-disabled
# languages: hcl
# from: terraform/gcp/security/gcp-gke-client-certificate-disabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_container_cluster\" \"$$$_\" {\n$$$_\nmaster_auth {\n  $$$_\n  client_certificate_config {\n    $$$_\n    issue_client_certificate = false\n    $$$_\n  }\n  $$$_\n}\n$$$_\n}",
      "resource \"google_container_cluster\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"google_container_cluster\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"google_container_cluster\" \"$$$_\" {\n$$$_\nmaster_auth {\n  $$$_\n  client_certificate_config {\n    $$$_\n    issue_client_certificate = false\n    $$$_\n  }\n  $$$_\n}\n$$$_\n}"]))
        | finding("gcp-gke-client-certificate-disabled";
            "Ensure client certificate authentication to Kubernetes Engine Clusters is disabled") ) )
| report
