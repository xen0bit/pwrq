# rules: gcp-compute-firewall-unrestricted-ingress-80
# languages: hcl
# from: terraform/gcp/security/gcp-compute-firewall-unrestricted-ingress-80.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_compute_firewall\" \"$$$_\" {\n$$$_\nallow {\n  protocol = \"tcp\"\n  ports    = [$$$_, \"80\", $$$_]\n}\nsource_ranges = [\"0.0.0.0/0\"]\n$$$_\n}",
      "resource \"google_compute_firewall\" \"$$$_\" {\n$$$_\nallow {\n  protocol = \"tcp\"\n  ports    = [80]\n}\nsource_ranges = [\"0.0.0.0/0\"]\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | at_same_place((($all
          | within($all | of(["resource \"google_compute_firewall\" \"$$$_\" {\n$$$_\nallow {\n  protocol = \"tcp\"\n  ports    = [80]\n}\nsource_ranges = [\"0.0.0.0/0\"]\n$$$_\n}"])))
          + ($all
          | within($all | of(["resource \"google_compute_firewall\" \"$$$_\" {\n$$$_\nallow {\n  protocol = \"tcp\"\n  ports    = [$$$_, \"80\", $$$_]\n}\nsource_ranges = [\"0.0.0.0/0\"]\n$$$_\n}"])))))
        | finding("gcp-compute-firewall-unrestricted-ingress-80";
            "Ensure Google compute firewall ingress does not allow unrestricted HTTP access") ) )
| report
