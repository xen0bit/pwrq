# rules: gcp-gke-basic-auth
# languages: hcl
# from: terraform/gcp/security/gcp-gke-basic-auth.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_container_cluster\" \"$$$_\" {\n$$$_\nmaster_auth {\n  $$$_\n  username = \"\"\n  password = \"\"\n  $$$_\n}\n$$$_\n}",
      "resource \"google_container_cluster\" \"$$$_\" {\n$$$_\nmaster_auth {\n  client_certificate_config {\n    $$$_\n  }\n}\n$$$_\n}",
      "resource \"google_container_cluster\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"google_container_cluster\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"google_container_cluster\" \"$$$_\" {\n$$$_\nmaster_auth {\n  client_certificate_config {\n    $$$_\n  }\n}\n$$$_\n}"]))
          | outside($all | of(["resource \"google_container_cluster\" \"$$$_\" {\n$$$_\nmaster_auth {\n  $$$_\n  username = \"\"\n  password = \"\"\n  $$$_\n}\n$$$_\n}"]))
        | finding("gcp-gke-basic-auth";
            "Ensure GKE basic auth is disabled") ) )
| report
