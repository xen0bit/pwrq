# rules: gcp-compute-project-os-login
# languages: hcl
# from: terraform/gcp/security/gcp-compute-project-os-login.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_compute_project_metadata\" \"$$$_\" {\n$$$_\nmetadata = {\n    enable-oslogin = \"True\"\n}\n$$$_\n}",
      "resource \"google_compute_project_metadata\" \"$$$_\" {\n$$$_\nmetadata = {\n    enable-oslogin = True\n}\n$$$_\n}",
      "resource \"google_compute_project_metadata\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"google_compute_project_metadata\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"google_compute_project_metadata\" \"$$$_\" {\n$$$_\nmetadata = {\n    enable-oslogin = \"True\"\n}\n$$$_\n}"]))
          | outside($all | of(["resource \"google_compute_project_metadata\" \"$$$_\" {\n$$$_\nmetadata = {\n    enable-oslogin = True\n}\n$$$_\n}"]))
        | finding("gcp-compute-project-os-login";
            "Ensure oslogin is enabled for a Project") ) )
| report
