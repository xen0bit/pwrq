# rules: gcp-gke-private-cluster-config
# languages: hcl
# from: terraform/gcp/security/gcp-gke-private-cluster-config.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_container_cluster\" \"$$$_\" {\n$$$_\nprivate_cluster_config {\n  $$$_\n}\n$$$_\n}",
      "resource \"google_container_cluster\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"google_container_cluster\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"google_container_cluster\" \"$$$_\" {\n$$$_\nprivate_cluster_config {\n  $$$_\n}\n$$$_\n}"]))
        | finding("gcp-gke-private-cluster-config";
            "Ensure Kubernetes Cluster is created with Private cluster enabled") ) )
| report
