# rules: gcp-compute-template-ip-forward
# languages: hcl
# from: terraform/gcp/security/gcp-compute-template-ip-forward.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_compute_instance_template\" \"$$$_\" {\n$$$_\ncan_ip_forward = true\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"google_compute_instance_template\" \"$$$_\" {\n$$$_\ncan_ip_forward = true\n$$$_\n}"]))
        | finding("gcp-compute-template-ip-forward";
            "Ensure that IP forwarding is not enabled on Instances.") ) )
| report
