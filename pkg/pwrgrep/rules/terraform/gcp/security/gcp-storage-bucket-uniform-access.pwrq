# rules: gcp-storage-bucket-uniform-access
# languages: hcl
# from: terraform/gcp/security/gcp-storage-bucket-uniform-access.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_storage_bucket\" \"$$$_\" {\n$$$_\nuniform_bucket_level_access = true\n$$$_\n}",
      "resource \"google_storage_bucket\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"google_storage_bucket\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"google_storage_bucket\" \"$$$_\" {\n$$$_\nuniform_bucket_level_access = true\n$$$_\n}"]))
        | finding("gcp-storage-bucket-uniform-access";
            "Ensure that Cloud Storage buckets have uniform bucket-level access enabled") ) )
| report
