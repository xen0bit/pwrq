# rules: gcp-gke-pod-security-policy-enabled
# languages: hcl
# from: terraform/gcp/security/gcp-gke-pod-security-policy-enabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_container_cluster\" \"$$$_\" {\n$$$_\npod_security_policy_config {\n  $$$_\n  enabled = true\n  $$$_\n}\n$$$_\n}",
      "resource \"google_container_cluster\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"google_container_cluster\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"google_container_cluster\" \"$$$_\" {\n$$$_\npod_security_policy_config {\n  $$$_\n  enabled = true\n  $$$_\n}\n$$$_\n}"]))
        | finding("gcp-gke-pod-security-policy-enabled";
            "Ensure PodSecurityPolicy controller is enabled on the Kubernetes Engine Clusters") ) )
| report
