# rules: gcp-gke-kubernetes-rbac-google-groups
# languages: hcl
# from: terraform/gcp/security/gcp-gke-kubernetes-rbac-google-groups.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_container_cluster\" \"$$$_\" {\n$$$_\nauthenticator_groups_config {\n  $$$_\n  security_group = \"$$$_\"\n  $$$_\n}\n$$$_\n}",
      "resource \"google_container_cluster\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"google_container_cluster\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"google_container_cluster\" \"$$$_\" {\n$$$_\nauthenticator_groups_config {\n  $$$_\n  security_group = \"$$$_\"\n  $$$_\n}\n$$$_\n}"]))
        | finding("gcp-gke-kubernetes-rbac-google-groups";
            "Manage Kubernetes RBAC users with Google Groups for GKE") ) )
| report
