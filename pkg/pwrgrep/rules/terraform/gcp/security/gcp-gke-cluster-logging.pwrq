# rules: gcp-gke-cluster-logging
# languages: hcl
# from: terraform/gcp/security/gcp-gke-cluster-logging.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"google_container_cluster\" $ANYTHING {\n  $$$_\n  logging_service = \"none\"\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"google_container_cluster\" $ANYTHING {\n  $$$_\n  logging_service = \"none\"\n  $$$_\n}"])
        | finding("gcp-gke-cluster-logging";
            "Ensure logging is set to Enabled on Kubernetes Engine Clusters") ) )
| report
