# rules: gcp-folder-impersonation-roles-iam-binding
# languages: hcl
# from: terraform/gcp/security/gcp-folder-impersonation-roles-iam-binding.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_folder_iam_binding\" \"$$$_\" {\n$$$_\nrole = \"roles/editor\"\nmembers = [ $$$_ ]\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"google_folder_iam_binding\" \"$$$_\" {\n$$$_\nrole = \"roles/editor\"\nmembers = [ $$$_ ]\n$$$_\n}"]))
        | finding("gcp-folder-impersonation-roles-iam-binding";
            "Ensure no roles that enable to impersonate and manage all service accounts are used at a folder level") ) )
| report
