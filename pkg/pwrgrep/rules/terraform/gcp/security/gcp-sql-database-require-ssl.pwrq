# rules: gcp-sql-database-require-ssl
# languages: hcl
# from: terraform/gcp/security/gcp-sql-database-require-ssl.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_sql_database_instance\" \"$$$_\" {\n    $$$_\n    ip_configuration {\n        $$$_\n        require_ssl = true\n        $$$_\n    }\n    $$$_\n}",
      "resource \"google_sql_database_instance\" \"$$$_\" {\n    $$$_\n    ip_configuration {\n        $$$_\n        ssl_mode = $$$_\n        $$$_\n    }\n    $$$_\n}",
      "resource \"google_sql_database_instance\" \"$$$_\" {\n    $$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"google_sql_database_instance\" \"$$$_\" {\n    $$$_\n}"]))
          | outside($all | of(["resource \"google_sql_database_instance\" \"$$$_\" {\n    $$$_\n    ip_configuration {\n        $$$_\n        require_ssl = true\n        $$$_\n    }\n    $$$_\n}"]))
          | outside($all | of(["resource \"google_sql_database_instance\" \"$$$_\" {\n    $$$_\n    ip_configuration {\n        $$$_\n        ssl_mode = $$$_\n        $$$_\n    }\n    $$$_\n}"]))
        | finding("gcp-sql-database-require-ssl";
            "Ensure all Cloud SQL database instance requires all incoming connections to use SSL") ) )
| report
