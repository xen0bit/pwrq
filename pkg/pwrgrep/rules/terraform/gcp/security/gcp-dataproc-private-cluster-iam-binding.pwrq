# rules: gcp-dataproc-private-cluster-iam-binding
# languages: hcl
# from: terraform/gcp/security/gcp-dataproc-private-cluster-iam-binding.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_dataproc_cluster_iam_binding\" \"$$$_\" {\n$$$_\nmembers = [ $$$_, \"allAuthenticatedUsers\", $$$_]\n$$$_\n}",
      "resource \"google_dataproc_cluster_iam_binding\" \"$$$_\" {\n$$$_\nmembers = [ $$$_, \"allUsers\", $$$_]\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | at_same_place((($all
          | within($all | of(["resource \"google_dataproc_cluster_iam_binding\" \"$$$_\" {\n$$$_\nmembers = [ $$$_, \"allAuthenticatedUsers\", $$$_]\n$$$_\n}"])))
          + ($all
          | within($all | of(["resource \"google_dataproc_cluster_iam_binding\" \"$$$_\" {\n$$$_\nmembers = [ $$$_, \"allUsers\", $$$_]\n$$$_\n}"])))))
        | finding("gcp-dataproc-private-cluster-iam-binding";
            "Ensure that Dataproc clusters are not anonymously or publicly accessible") ) )
| report
