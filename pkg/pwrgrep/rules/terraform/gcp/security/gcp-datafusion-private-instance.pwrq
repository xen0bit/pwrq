# rules: gcp-datafusion-private-instance
# languages: hcl
# from: terraform/gcp/security/gcp-datafusion-private-instance.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_data_fusion_instance\" \"$$$_\" {\n$$$_\nprivate_instance = true\n$$$_\n}",
      "resource \"google_data_fusion_instance\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"google_data_fusion_instance\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"google_data_fusion_instance\" \"$$$_\" {\n$$$_\nprivate_instance = true\n$$$_\n}"]))
        | finding("gcp-datafusion-private-instance";
            "Ensure Data fusion instances are private") ) )
| report
