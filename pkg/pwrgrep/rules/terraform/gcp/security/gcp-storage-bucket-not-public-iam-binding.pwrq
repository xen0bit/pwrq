# rules: gcp-storage-bucket-not-public-iam-binding
# languages: hcl
# from: terraform/gcp/security/gcp-storage-bucket-not-public-iam-binding.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_storage_bucket_iam_binding\" \"$$$_\" {\n$$$_\nmembers = [ $$$_, \"allAuthenticatedUsers\", $$$_]\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"google_storage_bucket_iam_binding\" \"$$$_\" {\n$$$_\nmembers = [ $$$_, \"allAuthenticatedUsers\", $$$_]\n$$$_\n}"]))
        | finding("gcp-storage-bucket-not-public-iam-binding";
            "Ensure that Container Registry repositories are not anonymously or publicly accessible") ) )
| report
