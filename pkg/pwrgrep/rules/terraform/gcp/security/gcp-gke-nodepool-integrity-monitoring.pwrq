# rules: gcp-gke-nodepool-integrity-monitoring
# languages: hcl
# from: terraform/gcp/security/gcp-gke-nodepool-integrity-monitoring.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"google_container_node_pool\" $ANYTHING {\n  $$$_\n  node_config {\n    $$$_\n    shielded_instance_config {\n      enable_integrity_monitoring = false\n    }\n    $$$_\n  }     \n  $$$_\n}"
    ])) as $all
    | ( $all
          | within($all | of(["resource \"google_container_node_pool\" $ANYTHING {\n  $$$_\n  node_config {\n    $$$_\n    shielded_instance_config {\n      enable_integrity_monitoring = false\n    }\n    $$$_\n  }     \n  $$$_\n}"]))
        | finding("gcp-gke-nodepool-integrity-monitoring";
            "Ensure Integrity Monitoring for Shielded GKE Nodes is Enabled") ) )
| report
