# rules: gcp-vertexai-metadata-store-encrypted-with-cmk
# languages: hcl
# from: terraform/gcp/security/gcp-vertexai-metadata-store-encrypted-with-cmk.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"google_vertex_ai_metadata_store\" $ANYTHING {\n  $$$_\n  encryption_spec {\n    $$$_\n    kms_key_name = $$$_\n    $$$_\n  }\n  $$$_\n}",
      "resource \"google_vertex_ai_metadata_store\" $ANYTHING {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"google_vertex_ai_metadata_store\" $ANYTHING {\n  $$$_\n}"])
          | outside($all | of(["resource \"google_vertex_ai_metadata_store\" $ANYTHING {\n  $$$_\n  encryption_spec {\n    $$$_\n    kms_key_name = $$$_\n    $$$_\n  }\n  $$$_\n}"]))
        | finding("gcp-vertexai-metadata-store-encrypted-with-cmk";
            "Ensure Vertex AI Metadata Store uses a CMK (Customer Manager Key)") ) )
| report
