# rules: gcp-gke-monitoring-enabled
# languages: hcl
# from: terraform/gcp/security/gcp-gke-monitoring-enabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"google_container_cluster\" $ANYTHING {\n  $$$_\n  monitoring_service = \"none\"  \n  $$$_\n}"
    ])) as $all
    | ( $all
          | within($all | of(["resource \"google_container_cluster\" $ANYTHING {\n  $$$_\n  monitoring_service = \"none\"  \n  $$$_\n}"]))
        | finding("gcp-gke-monitoring-enabled";
            "Ensure monitoring is set to Enabled on Kubernetes Engine Clusters") ) )
| report
