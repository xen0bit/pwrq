# rules: gcp-folder-member-default-service-account-iam-binding
# languages: hcl
# from: terraform/gcp/security/gcp-folder-member-default-service-account-iam-binding.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_folder_iam_binding\" \"$$$_\" {\n$$$_\nmembers = [$$$_, $MEMBER, $$$_]\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"google_folder_iam_binding\" \"$$$_\" {\n$$$_\nmembers = [$$$_, $MEMBER, $$$_]\n$$$_\n}"]))
          | where_capture("MEMBER"; "^(?:((.*)-compute@appspot.gserviceaccount.com))")
        | finding("gcp-folder-member-default-service-account-iam-binding";
            "Ensure Default Service account is not used at a folder level") ) )
| report
