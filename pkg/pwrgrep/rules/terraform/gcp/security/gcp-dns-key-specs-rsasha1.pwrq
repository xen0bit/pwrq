# rules: gcp-dns-key-specs-rsasha1
# languages: hcl
# from: terraform/gcp/security/gcp-dns-key-specs-rsasha1.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_dns_managed_zone\" \"$$$_\" {\n$$$_\ndnssec_config {\n    $$$_\n    default_key_specs {\n        $$$_\n        algorithm  = \"rsasha1\"\n        key_type   = \"keySigning\"\n        $$$_\n    }\n    $$$_\n}\n$$$_\n}",
      "resource \"google_dns_managed_zone\" \"$$$_\" {\n$$$_\ndnssec_config {\n    $$$_\n    default_key_specs {\n        $$$_\n        algorithm  = \"rsasha1\"\n        key_type   = \"zoneSigning\"\n        $$$_\n    }\n    $$$_\n}\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"google_dns_managed_zone\" \"$$$_\" {\n$$$_\ndnssec_config {\n    $$$_\n    default_key_specs {\n        $$$_\n        algorithm  = \"rsasha1\"\n        key_type   = \"zoneSigning\"\n        $$$_\n    }\n    $$$_\n}\n$$$_\n}"]))
          | within($all | of(["resource \"google_dns_managed_zone\" \"$$$_\" {\n$$$_\ndnssec_config {\n    $$$_\n    default_key_specs {\n        $$$_\n        algorithm  = \"rsasha1\"\n        key_type   = \"keySigning\"\n        $$$_\n    }\n    $$$_\n}\n$$$_\n}"]))
        | finding("gcp-dns-key-specs-rsasha1";
            "Ensure that RSASHA1 is not used for the zone-signing and key-signing keys in Cloud DNS DNSSEC") ) )
| report
