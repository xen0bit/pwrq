# rules: gcp-dataproc-private-cluster-iam-member
# languages: hcl
# from: terraform/gcp/security/gcp-dataproc-private-cluster-iam-member.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_dataproc_cluster_iam_member\" \"$$$_\" {\n$$$_\nmember = \"allAuthenticatedUsers\"\n$$$_\n}",
      "resource \"google_dataproc_cluster_iam_member\" \"$$$_\" {\n$$$_\nmember = \"allUsers\"\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | at_same_place((($all
          | within($all | of(["resource \"google_dataproc_cluster_iam_member\" \"$$$_\" {\n$$$_\nmember = \"allUsers\"\n$$$_\n}"])))
          + ($all
          | within($all | of(["resource \"google_dataproc_cluster_iam_member\" \"$$$_\" {\n$$$_\nmember = \"allAuthenticatedUsers\"\n$$$_\n}"])))))
        | finding("gcp-dataproc-private-cluster-iam-member";
            "Ensure that Dataproc clusters are not anonymously or publicly accessible") ) )
| report
