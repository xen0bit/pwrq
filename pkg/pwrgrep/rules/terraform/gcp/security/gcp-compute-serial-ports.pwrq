# rules: gcp-compute-serial-ports
# languages: hcl
# from: terraform/gcp/security/gcp-compute-serial-ports.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_compute_instance\" \"$$$_\" {\n$$$_\nmetadata = {\n    serial-port-enable = true\n}\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"google_compute_instance\" \"$$$_\" {\n$$$_\nmetadata = {\n    serial-port-enable = true\n}\n$$$_\n}"]))
        | finding("gcp-compute-serial-ports";
            "Ensure 'Enable connecting to serial ports' is not enabled for VM Instance") ) )
| report
