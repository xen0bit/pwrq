# rules: gcp-project-member-default-service-account-iam-member
# languages: hcl
# from: terraform/gcp/security/gcp-project-member-default-service-account-iam-member.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_project_iam_member\" \"$$$_\" {\n$$$_\nmember = $MEMBER\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"google_project_iam_member\" \"$$$_\" {\n$$$_\nmember = $MEMBER\n$$$_\n}"]))
          | where_capture("MEMBER"; "^(?:((.*)-compute@developer.gserviceaccount.com))")
        | finding("gcp-project-member-default-service-account-iam-member";
            "Ensure Default Service account is not used at a project level") ) )
| report
