# rules: gcp-project-service-account-user-iam-member
# languages: hcl
# from: terraform/gcp/security/gcp-project-service-account-user-iam-member.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_project_iam_member\" \"$$$_\" {\n$$$_\nrole = \"roles/iam.serviceAccountTokenCreator\"\n$$$_\n}",
      "resource \"google_project_iam_member\" \"$$$_\" {\n$$$_\nrole = \"roles/iam.serviceAccountUser\"\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | at_same_place((($all
          | within($all | of(["resource \"google_project_iam_member\" \"$$$_\" {\n$$$_\nrole = \"roles/iam.serviceAccountTokenCreator\"\n$$$_\n}"])))
          + ($all
          | within($all | of(["resource \"google_project_iam_member\" \"$$$_\" {\n$$$_\nrole = \"roles/iam.serviceAccountUser\"\n$$$_\n}"])))))
        | finding("gcp-project-service-account-user-iam-member";
            "Ensure that IAM users are not assigned the Service Account User or Service Account Token Creator roles at project level") ) )
| report
