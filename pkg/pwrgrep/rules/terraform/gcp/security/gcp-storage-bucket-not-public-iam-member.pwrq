# rules: gcp-storage-bucket-not-public-iam-member
# languages: hcl
# from: terraform/gcp/security/gcp-storage-bucket-not-public-iam-member.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_storage_bucket_iam_member\" \"$$$_\" {\n$$$_\nmember = \"allUsers\"\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"google_storage_bucket_iam_member\" \"$$$_\" {\n$$$_\nmember = \"allUsers\"\n$$$_\n}"]))
        | finding("gcp-storage-bucket-not-public-iam-member";
            "Ensure that Container Registry repositories are not anonymously or publicly accessible") ) )
| report
