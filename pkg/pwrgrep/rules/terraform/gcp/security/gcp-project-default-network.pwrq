# rules: gcp-project-default-network
# languages: hcl
# from: terraform/gcp/security/gcp-project-default-network.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_project\" \"$$$_\" {\n$$$_\nauto_create_network   = false\n$$$_\n}",
      "resource \"google_project\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"google_project\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"google_project\" \"$$$_\" {\n$$$_\nauto_create_network   = false\n$$$_\n}"]))
        | finding("gcp-project-default-network";
            "Ensure that the default network does not exist in a project.") ) )
| report
