# rules: gcp-gke-legacy-auth-enabled
# languages: hcl
# from: terraform/gcp/security/gcp-gke-legacy-auth-enabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_container_cluster\" \"$$$_\" {\n$$$_\nenable_legacy_abac = true\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"google_container_cluster\" \"$$$_\" {\n$$$_\nenable_legacy_abac = true\n$$$_\n}"]))
        | finding("gcp-gke-legacy-auth-enabled";
            "Ensure Legacy Authorization is set to Disabled on Kubernetes Engine Clusters") ) )
| report
