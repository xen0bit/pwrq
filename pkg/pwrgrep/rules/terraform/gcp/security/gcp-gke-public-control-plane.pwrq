# rules: gcp-gke-public-control-plane
# languages: hcl
# from: terraform/gcp/security/gcp-gke-public-control-plane.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_container_cluster\" \"$$$_\" {\n$$$_\nmaster_authorized_networks_config {\n  $$$_\n  cidr_blocks {\n        $$$_\n  }\n  $$$_\n}\n$$$_\n}",
      "resource \"google_container_cluster\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"google_container_cluster\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"google_container_cluster\" \"$$$_\" {\n$$$_\nmaster_authorized_networks_config {\n  $$$_\n  cidr_blocks {\n        $$$_\n  }\n  $$$_\n}\n$$$_\n}"]))
        | finding("gcp-gke-public-control-plane";
            "Ensure GKE Control Plane is not public") ) )
| report
