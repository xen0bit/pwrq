# rules: gcp-vertexai-private-instance
# languages: hcl
# from: terraform/gcp/security/gcp-vertexai-private-instance.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_notebooks_instance\" \"$$$_\" {\n$$$_\nno_public_ip = true\n$$$_\n}",
      "resource \"google_notebooks_instance\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"google_notebooks_instance\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"google_notebooks_instance\" \"$$$_\" {\n$$$_\nno_public_ip = true\n$$$_\n}"]))
        | finding("gcp-vertexai-private-instance";
            "Ensure Vertex AI instances are private") ) )
| report
