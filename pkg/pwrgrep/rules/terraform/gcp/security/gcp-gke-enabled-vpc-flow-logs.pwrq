# rules: gcp-gke-enabled-vpc-flow-logs
# languages: hcl
# from: terraform/gcp/security/gcp-gke-enabled-vpc-flow-logs.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"google_container_cluster\" $ANYTHING {\n  $$$_\n  enable_intranode_visibility = true\n  $$$_\n}",
      "resource \"google_container_cluster\" $ANYTHING {\n  $$$_\n}"
    ])) as $all
    | ( $all
          | within($all | of(["resource \"google_container_cluster\" $ANYTHING {\n  $$$_\n}"]))
          | outside($all | of(["resource \"google_container_cluster\" $ANYTHING {\n  $$$_\n  enable_intranode_visibility = true\n  $$$_\n}"]))
        | finding("gcp-gke-enabled-vpc-flow-logs";
            "Enable VPC Flow Logs and Intranode Visibility") ) )
| report
