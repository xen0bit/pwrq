# rules: gcp-insecure-load-balancer-tls-version
# languages: hcl
# from: terraform/gcp/security/gcp-insecure-load-balancer-tls-version.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"google_compute_ssl_policy\" $ANYTHING {\n  $$$_\n  min_tls_version = \"$$$_\"\n  $$$_\n}",
      "resource \"google_compute_ssl_policy\" $ANYTHING {\n  $$$_\n  min_tls_version = \"TLS_1_2\"\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"google_compute_ssl_policy\" $ANYTHING {\n  $$$_\n  min_tls_version = \"$$$_\"\n  $$$_\n}"])
          | not_at($all | of(["resource \"google_compute_ssl_policy\" $ANYTHING {\n  $$$_\n  min_tls_version = \"TLS_1_2\"\n  $$$_\n}"]))
        | finding("gcp-insecure-load-balancer-tls-version";
            "Detected GCP Load Balancer to be using an insecure version of TLS.") ) )
| report
