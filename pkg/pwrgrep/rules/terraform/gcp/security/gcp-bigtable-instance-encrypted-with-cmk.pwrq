# rules: gcp-bigtable-instance-encrypted-with-cmk
# languages: hcl
# from: terraform/gcp/security/gcp-bigtable-instance-encrypted-with-cmk.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"google_bigtable_instance\" $ANYTHING {\n  $$$_\n  cluster {\n    $$$_\n    kms_key_name = $$$_\n    $$$_\n  }\n  $$$_\n}",
      "resource \"google_bigtable_instance\" $ANYTHING {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"google_bigtable_instance\" $ANYTHING {\n  $$$_\n}"])
          | outside($all | of(["resource \"google_bigtable_instance\" $ANYTHING {\n  $$$_\n  cluster {\n    $$$_\n    kms_key_name = $$$_\n    $$$_\n  }\n  $$$_\n}"]))
        | finding("gcp-bigtable-instance-encrypted-with-cmk";
            "Ensure Big Table Instances are encrypted with Customer Supplied Encryption Keys (CSEK)") ) )
| report
