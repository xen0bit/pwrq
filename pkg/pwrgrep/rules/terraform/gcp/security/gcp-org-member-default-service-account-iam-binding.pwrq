# rules: gcp-org-member-default-service-account-iam-binding
# languages: hcl
# from: terraform/gcp/security/gcp-org-member-default-service-account-iam-binding.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"google_organization_iam_binding\" \"$$$_\" {\n$$$_\nmembers = [$$$_, $MEMBER, $$$_]\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"google_organization_iam_binding\" \"$$$_\" {\n$$$_\nmembers = [$$$_, $MEMBER, $$$_]\n$$$_\n}"]))
          | where_capture("MEMBER"; "^(?:((.*)-compute@developer.gserviceaccount.com))")
        | finding("gcp-org-member-default-service-account-iam-binding";
            "Ensure default service account is not used at an organization level") ) )
| report
