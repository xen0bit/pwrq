# rules: azure-secret-expiration-date
# languages: hcl
# from: terraform/azure/best-practice/azure-secret-expiration-date.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_key_vault_secret\" \"$$$_\" {\n$$$_\nexpiration_date = \"$$$_\"\n$$$_\n}",
      "resource \"azurerm_key_vault_secret\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"azurerm_key_vault_secret\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"azurerm_key_vault_secret\" \"$$$_\" {\n$$$_\nexpiration_date = \"$$$_\"\n$$$_\n}"]))
        | finding("azure-secret-expiration-date";
            "Ensure that the expiration date is set on all secrets") ) )
| report
