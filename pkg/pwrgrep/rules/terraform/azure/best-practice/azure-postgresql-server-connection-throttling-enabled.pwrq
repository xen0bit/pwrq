# rules: azure-postgresql-server-connection-throttling-enabled
# languages: hcl
# from: terraform/azure/best-practice/azure-postgresql-server-connection-throttling-enabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_postgresql_configuration\" \"$$$_\" {\n$$$_\nname = \"connection_throttling\"\nvalue = \"on\"\n$$$_\n}",
      "resource \"azurerm_postgresql_configuration\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"azurerm_postgresql_configuration\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"azurerm_postgresql_configuration\" \"$$$_\" {\n$$$_\nname = \"connection_throttling\"\nvalue = \"on\"\n$$$_\n}"]))
        | finding("azure-postgresql-server-connection-throttling-enabled";
            "Ensure server parameter connection_throttling is set to ON for PostgreSQL Database Server") ) )
| report
