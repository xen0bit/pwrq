# rules: azure-appservice-ftps-state
# languages: hcl
# from: terraform/azure/best-practice/azure-appservice-ftps-state.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\nsite_config {\n  ftps_state = \"Disabled\"\n}\n$$$_\n}",
      "resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\nsite_config {\n  ftps_state = \"FtpsOnly\"\n}\n$$$_\n}",
      "resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\nsite_config {\n  ftps_state = \"FtpsOnly\"\n}\n$$$_\n}"]))
          | outside($all | of(["resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\nsite_config {\n  ftps_state = \"Disabled\"\n}\n$$$_\n}"]))
          | within($all | of(["resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n}"]))
        | finding("azure-appservice-ftps-state";
            "Ensure FTP deployments are disabled") ) )
| report
