# rules: azure-sqlserver-email-alerts-enabled
# languages: hcl
# from: terraform/azure/best-practice/azure-sqlserver-email-alerts-enabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_mssql_server_security_alert_policy\" \"$$$_\" {\n$$$_\nstate = \"Enabled\"\nemail_addresses = [\"$$$_\", $$$_]\n$$$_\n}",
      "resource \"azurerm_mssql_server_security_alert_policy\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"azurerm_mssql_server_security_alert_policy\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"azurerm_mssql_server_security_alert_policy\" \"$$$_\" {\n$$$_\nstate = \"Enabled\"\nemail_addresses = [\"$$$_\", $$$_]\n$$$_\n}"]))
        | finding("azure-sqlserver-email-alerts-enabled";
            "Ensure that Send Alerts To is enabled for MSSQL servers") ) )
| report
