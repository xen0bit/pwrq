# rules: azure-ad-used-auth-service-fabric
# languages: hcl
# from: terraform/azure/best-practice/azure-ad-used-auth-service-fabric.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_service_fabric_cluster\" \"$$$_\" {\n$$$_\nazure_active_directory {\n  tenant_id = \"$$$_\"\n}\n$$$_\n}",
      "resource \"azurerm_service_fabric_cluster\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_service_fabric_cluster\" \"$$$_\" {\n$$$_\nazure_active_directory {\n  tenant_id = \"$$$_\"\n}\n$$$_\n}"]))
          | within($all | of(["resource \"azurerm_service_fabric_cluster\" \"$$$_\" {\n$$$_\n}"]))
        | finding("azure-ad-used-auth-service-fabric";
            "Ensures that Active Directory is used for authentication for Service Fabric") ) )
| report
