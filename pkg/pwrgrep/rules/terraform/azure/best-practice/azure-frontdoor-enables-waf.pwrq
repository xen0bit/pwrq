# rules: azure-frontdoor-enables-waf
# languages: hcl
# from: terraform/azure/best-practice/azure-frontdoor-enables-waf.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_frontdoor\" \"$$$_\" {\n$$$_\nweb_application_firewall_policy_link_id = \"$$$_\"\n$$$_\n}",
      "resource \"azurerm_frontdoor\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_frontdoor\" \"$$$_\" {\n$$$_\nweb_application_firewall_policy_link_id = \"$$$_\"\n$$$_\n}"]))
          | within($all | of(["resource \"azurerm_frontdoor\" \"$$$_\" {\n$$$_\n}"]))
        | finding("azure-frontdoor-enables-waf";
            "Ensure that Azure Front Door enables WAF") ) )
| report
