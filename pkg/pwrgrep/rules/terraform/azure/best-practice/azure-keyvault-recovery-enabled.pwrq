# rules: azure-keyvault-recovery-enabled
# languages: hcl
# from: terraform/azure/best-practice/azure-keyvault-recovery-enabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"azurerm_key_vault\" \"$$$_\" {\n$$$_\npurge_protection_enabled = true\n$$$_\n}",
      "resource \"azurerm_key_vault\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"azurerm_key_vault\" \"$$$_\" {\n$$$_\n}"])
          | outside($all | of(["resource \"azurerm_key_vault\" \"$$$_\" {\n$$$_\npurge_protection_enabled = true\n$$$_\n}"]))
        | finding("azure-keyvault-recovery-enabled";
            "Ensure the key vault is recoverable https://docs.bridgecrew.io/docs/ensure-the-key-vault-is-recoverable") ) )
| report
