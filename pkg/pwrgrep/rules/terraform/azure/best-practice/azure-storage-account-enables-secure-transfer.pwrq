# rules: azure-storage-account-enables-secure-transfer
# languages: hcl
# from: terraform/azure/best-practice/azure-storage-account-enables-secure-transfer.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_storage_account\" \"$$$_\" {\n$$$_\nenable_https_traffic_only = false\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"azurerm_storage_account\" \"$$$_\" {\n$$$_\nenable_https_traffic_only = false\n$$$_\n}"]))
        | finding("azure-storage-account-enables-secure-transfer";
            "Ensure that storage account enables secure transfer") ) )
| report
