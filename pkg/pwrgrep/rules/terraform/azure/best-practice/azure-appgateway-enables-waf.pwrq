# rules: azure-appgateway-enables-waf
# languages: hcl
# from: terraform/azure/best-practice/azure-appgateway-enables-waf.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_application_gateway\" \"$$$_\" {\n$$$_\nwaf_configuration {\n  enabled = true\n}\n$$$_\n}",
      "resource \"azurerm_application_gateway\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_application_gateway\" \"$$$_\" {\n$$$_\nwaf_configuration {\n  enabled = true\n}\n$$$_\n}"]))
          | within($all | of(["resource \"azurerm_application_gateway\" \"$$$_\" {\n$$$_\n}"]))
        | finding("azure-appgateway-enables-waf";
            "Ensure that Application Gateway enables WAF") ) )
| report
