# rules: azure-functionapps-accessible-over-https
# languages: hcl
# from: terraform/azure/best-practice/azure-functionapps-accessible-over-https.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\nhttps_only = true\n$$$_\n}",
      "resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\nhttps_only = true\n$$$_\n}"]))
          | within($all | of(["resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n}"]))
        | finding("azure-functionapps-accessible-over-https";
            "Ensure that HTTP Version is the latest if used to run the Function app") ) )
| report
