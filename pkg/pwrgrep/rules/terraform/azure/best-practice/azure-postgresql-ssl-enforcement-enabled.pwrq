# rules: azure-postgresql-ssl-enforcement-enabled
# languages: hcl
# from: terraform/azure/best-practice/azure-postgresql-ssl-enforcement-enabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_postgresql_server\" \"$$$_\" {\n$$$_\nssl_enforcement_enabled = true\n$$$_\n}",
      "resource \"azurerm_postgresql_server\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"azurerm_postgresql_server\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"azurerm_postgresql_server\" \"$$$_\" {\n$$$_\nssl_enforcement_enabled = true\n$$$_\n}"]))
        | finding("azure-postgresql-ssl-enforcement-enabled";
            "Ensure Enforce SSL connection is set to Enabled for PostgreSQL servers") ) )
| report
