# rules: azure-defenderon-container-registry
# languages: hcl
# from: terraform/azure/best-practice/azure-defenderon-container-registry.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_security_center_subscription_pricing\" \"$$$_\" {\n$$$_\ntier = \"Free\"\nresource_type = \"ContainerRegistry\"\n$$$_\n}",
      "resource \"azurerm_security_center_subscription_pricing\" \"$$$_\" {\n$$$_\ntier = \"Standard\"\nresource_type = \"ContainerRegistry\"\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_security_center_subscription_pricing\" \"$$$_\" {\n$$$_\ntier = \"Standard\"\nresource_type = \"ContainerRegistry\"\n$$$_\n}"]))
          | within($all | of(["resource \"azurerm_security_center_subscription_pricing\" \"$$$_\" {\n$$$_\ntier = \"Free\"\nresource_type = \"ContainerRegistry\"\n$$$_\n}"]))
        | finding("azure-defenderon-container-registry";
            "Ensure that Azure Defender is set to On for Container") ) )
| report
