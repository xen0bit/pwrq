# rules: azure-secret-content-type
# languages: hcl
# from: terraform/azure/best-practice/azure-secret-content-type.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_key_vault_secret\" \"$$$_\" {\n$$$_\ncontent_type = \"$$$_\"\n$$$_\n}",
      "resource \"azurerm_key_vault_secret\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"azurerm_key_vault_secret\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"azurerm_key_vault_secret\" \"$$$_\" {\n$$$_\ncontent_type = \"$$$_\"\n$$$_\n}"]))
        | finding("azure-secret-content-type";
            "Ensure that key vault secrets have “content_type” set") ) )
| report
