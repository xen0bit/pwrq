# rules: azure-appservice-used-azure-files
# languages: hcl
# from: terraform/azure/best-practice/azure-appservice-used-azure-files.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\nstorage_account {\n  $$$_\n  type = \"AzureFiles\"\n  $$$_\n}\n$$$_\n}",
      "resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\nstorage_account {\n  $$$_\n  type = \"AzureFiles\"\n  $$$_\n}\n$$$_\n}"]))
          | within($all | of(["resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n}"]))
        | finding("azure-appservice-used-azure-files";
            "Ensure that app services use Azure Files") ) )
| report
