# rules: azure-mariadb-sslenforcement-enabled
# languages: hcl
# from: terraform/azure/best-practice/azure-mariadb-sslenforcement-enabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_mariadb_server\" \"$$$_\" {\n$$$_\nssl_enforcement_enabled = true\n$$$_\n}",
      "resource \"azurerm_mariadb_server\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_mariadb_server\" \"$$$_\" {\n$$$_\nssl_enforcement_enabled = true\n$$$_\n}"]))
          | within($all | of(["resource \"azurerm_mariadb_server\" \"$$$_\" {\n$$$_\n}"]))
        | finding("azure-mariadb-sslenforcement-enabled";
            "Ensure Enforce SSL connection is set to Enabled for MariaDB servers") ) )
| report
