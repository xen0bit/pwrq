# rules: azure-keyvault-enables-soft-delete
# languages: hcl
# from: terraform/azure/best-practice/azure-keyvault-enables-soft-delete.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_key_vault\" \"$$$_\" {\n$$$_\nsoft_delete_enabled = false\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"azurerm_key_vault\" \"$$$_\" {\n$$$_\nsoft_delete_enabled = false\n$$$_\n}"]))
        | finding("azure-keyvault-enables-soft-delete";
            "Ensure that key vault enables soft delete") ) )
| report
