# rules: azure-keyvault-enables-purge-protection
# languages: hcl
# from: terraform/azure/best-practice/azure-keyvault-enables-purge-protection.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_key_vault\" \"$$$_\" {\n$$$_\npurge_protection_enabled = true\n}",
      "resource \"azurerm_key_vault\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_key_vault\" \"$$$_\" {\n$$$_\npurge_protection_enabled = true\n}"]))
          | within($all | of(["resource \"azurerm_key_vault\" \"$$$_\" {\n$$$_\n}"]))
        | finding("azure-keyvault-enables-purge-protection";
            "Ensure that key vault enables purge protection") ) )
| report
