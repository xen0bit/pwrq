# rules: azure-mariadb-geo-backup-enabled
# languages: hcl
# from: terraform/azure/best-practice/azure-mariadb-geo-backup-enabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_mariadb_server\" \"$$$_\" {\n$$$_\ngeo_redundant_backup_enabled = true\n$$$_\n}",
      "resource \"azurerm_mariadb_server\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_mariadb_server\" \"$$$_\" {\n$$$_\ngeo_redundant_backup_enabled = true\n$$$_\n}"]))
          | within($all | of(["resource \"azurerm_mariadb_server\" \"$$$_\" {\n$$$_\n}"]))
        | finding("azure-mariadb-geo-backup-enabled";
            "Ensure that MariaDB server enables geo-redundant backups") ) )
| report
