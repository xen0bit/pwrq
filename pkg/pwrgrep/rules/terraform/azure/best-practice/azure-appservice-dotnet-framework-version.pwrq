# rules: azure-appservice-dotnet-framework-version
# languages: hcl
# from: terraform/azure/best-practice/azure-appservice-dotnet-framework-version.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\nsite_config {\n  $$$_\n  dotnet_framework_version = \"v6.0\"\n  $$$_\n}\n$$$_\n}",
      "resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\nsite_config {\n  $$$_\n  dotnet_framework_version = \"v6.0\"\n  $$$_\n}\n$$$_\n}"]))
          | within($all | of(["resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n}"]))
        | finding("azure-appservice-dotnet-framework-version";
            "Ensure that Net Framework version is the latest, if used as a part of the web app") ) )
| report
