# rules: azure-postgresql-server-log-connections-enabled
# languages: hcl
# from: terraform/azure/best-practice/azure-postgresql-server-log-connections-enabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_postgresql_configuration\" \"$$$_\" {\n$$$_\nname = \"log_connections\"\nvalue = \"on\"\n$$$_\n}",
      "resource \"azurerm_postgresql_configuration\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"azurerm_postgresql_configuration\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"azurerm_postgresql_configuration\" \"$$$_\" {\n$$$_\nname = \"log_connections\"\nvalue = \"on\"\n$$$_\n}"]))
        | finding("azure-postgresql-server-log-connections-enabled";
            "Ensure server parameter log_connections is set to ON for PostgreSQL Database Server") ) )
| report
