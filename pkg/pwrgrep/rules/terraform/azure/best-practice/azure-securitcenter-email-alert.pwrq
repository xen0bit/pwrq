# rules: azure-securitcenter-email-alert
# languages: hcl
# from: terraform/azure/best-practice/azure-securitcenter-email-alert.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_security_center_contact\" \"$$$_\" {\n$$$_\nalert_notifications = true\n$$$_\n}",
      "resource \"azurerm_security_center_contact\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"azurerm_security_center_contact\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"azurerm_security_center_contact\" \"$$$_\" {\n$$$_\nalert_notifications = true\n$$$_\n}"]))
        | finding("azure-securitcenter-email-alert";
            "Ensure that Send email notification for high severity alerts is set to On") ) )
| report
