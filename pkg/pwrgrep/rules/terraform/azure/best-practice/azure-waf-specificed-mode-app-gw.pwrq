# rules: azure-waf-specificed-mode-app-gw
# languages: hcl
# from: terraform/azure/best-practice/azure-waf-specificed-mode-app-gw.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_web_application_firewall_policy\" \"$$$_\" {\n$$$_\npolicy_settings {\n  enabled = false\n}\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"azurerm_web_application_firewall_policy\" \"$$$_\" {\n$$$_\npolicy_settings {\n  enabled = false\n}\n$$$_\n}"]))
        | finding("azure-waf-specificed-mode-app-gw";
            "Ensure that Application Gateway uses WAF in “Detection” or “Prevention” modes") ) )
| report
