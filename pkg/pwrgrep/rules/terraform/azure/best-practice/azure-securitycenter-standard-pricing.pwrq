# rules: azure-securitycenter-standard-pricing
# languages: hcl
# from: terraform/azure/best-practice/azure-securitycenter-standard-pricing.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_security_center_subscription_pricing\" \"$$$_\" {\n$$$_\ntier = \"Standard\"\n$$$_\n}",
      "resource \"azurerm_security_center_subscription_pricing\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"azurerm_security_center_subscription_pricing\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"azurerm_security_center_subscription_pricing\" \"$$$_\" {\n$$$_\ntier = \"Standard\"\n$$$_\n}"]))
        | finding("azure-securitycenter-standard-pricing";
            "Ensure that standard pricing tier is selected") ) )
| report
