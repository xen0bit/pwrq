# rules: azure-securitycenter-contact-phone
# languages: hcl
# from: terraform/azure/best-practice/azure-securitycenter-contact-phone.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_security_center_contact\" \"$$$_\" {\n$$$_\nphone = \"$$$_\"\n$$$_\n}",
      "resource \"azurerm_security_center_contact\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"azurerm_security_center_contact\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"azurerm_security_center_contact\" \"$$$_\" {\n$$$_\nphone = \"$$$_\"\n$$$_\n}"]))
        | finding("azure-securitycenter-contact-phone";
            "Ensure that Security contact Phone number is set") ) )
| report
