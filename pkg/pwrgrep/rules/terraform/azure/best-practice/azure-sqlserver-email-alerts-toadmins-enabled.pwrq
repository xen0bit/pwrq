# rules: azure-sqlserver-email-alerts-toadmins-enabled
# languages: hcl
# from: terraform/azure/best-practice/azure-sqlserver-email-alerts-toadmins-enabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_mssql_server_security_alert_policy\" \"$$$_\" {\n$$$_\nstate = \"Enabled\"\nemail_account_admins = true\n$$$_\n}",
      "resource \"azurerm_mssql_server_security_alert_policy\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"azurerm_mssql_server_security_alert_policy\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"azurerm_mssql_server_security_alert_policy\" \"$$$_\" {\n$$$_\nstate = \"Enabled\"\nemail_account_admins = true\n$$$_\n}"]))
        | finding("azure-sqlserver-email-alerts-toadmins-enabled";
            "Ensure that Email service and co-administrators is Enabled for MSSQL servers") ) )
| report
