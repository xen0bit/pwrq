# rules: azure-aks-uses-azure-policies-addon
# languages: hcl
# from: terraform/azure/best-practice/azure-aks-uses-azure-policies-addon.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_kubernetes_cluster\" \"$$$_\" {\n$$$_\naddon_profile {\n  azure_policy {\n    enabled = true\n  }\n}\n$$$_\n}",
      "resource \"azurerm_kubernetes_cluster\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_kubernetes_cluster\" \"$$$_\" {\n$$$_\naddon_profile {\n  azure_policy {\n    enabled = true\n  }\n}\n$$$_\n}"]))
          | within($all | of(["resource \"azurerm_kubernetes_cluster\" \"$$$_\" {\n$$$_\n}"]))
        | finding("azure-aks-uses-azure-policies-addon";
            "Ensure that AKS uses Azure Policies Add-on") ) )
| report
