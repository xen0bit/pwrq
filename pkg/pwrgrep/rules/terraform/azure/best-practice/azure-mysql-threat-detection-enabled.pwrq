# rules: azure-mysql-threat-detection-enabled
# languages: hcl
# from: terraform/azure/best-practice/azure-mysql-threat-detection-enabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_mysql_server\" \"$$$_\" {\n$$$_\nthreat_detection_policy {\n    $$$_\n    enabled = true\n    $$$_\n}\n$$$_\n}",
      "resource \"azurerm_mysql_server\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"azurerm_mysql_server\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"azurerm_mysql_server\" \"$$$_\" {\n$$$_\nthreat_detection_policy {\n    $$$_\n    enabled = true\n    $$$_\n}\n$$$_\n}"]))
        | finding("azure-mysql-threat-detection-enabled";
            "Ensure that MySQL server enables Threat detection policy") ) )
| report
