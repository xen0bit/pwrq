# rules: azure-keyvault-enables-firewall-rules-settings
# languages: hcl
# from: terraform/azure/best-practice/azure-keyvault-enables-firewall-rules-settings.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_key_vault\" \"$$$_\" {\n$$$_\nnetwork_acls {\n  $$$_\n  default_action = \"Deny\"\n  $$$_\n}\n$$$_\n}",
      "resource \"azurerm_key_vault\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_key_vault\" \"$$$_\" {\n$$$_\nnetwork_acls {\n  $$$_\n  default_action = \"Deny\"\n  $$$_\n}\n$$$_\n}"]))
          | within($all | of(["resource \"azurerm_key_vault\" \"$$$_\" {\n$$$_\n}"]))
        | finding("azure-keyvault-enables-firewall-rules-settings";
            "Ensure that key vault allows firewall rules settings") ) )
| report
