# rules: azure-synapse-workscape-enables-managed-virtual-network
# languages: hcl
# from: terraform/azure/best-practice/azure-synapse-workscape-enables-managed-virtual-network.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_synapse_workspace\" \"$$$_\" {\n$$$_\nmanaged_virtual_network_enabled = true\n$$$_\n}",
      "resource \"azurerm_synapse_workspace\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"azurerm_synapse_workspace\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"azurerm_synapse_workspace\" \"$$$_\" {\n$$$_\nmanaged_virtual_network_enabled = true\n$$$_\n}"]))
        | finding("azure-synapse-workscape-enables-managed-virtual-network";
            "Ensure that Azure Synapse workspaces enables managed virtual networks") ) )
| report
