# rules: azure-securitycenter-email-alert-admins
# languages: hcl
# from: terraform/azure/best-practice/azure-securitycenter-email-alert-admins.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_security_center_contact\" \"$$$_\" {\n$$$_\nalerts_to_admins = true\n$$$_\n}",
      "resource \"azurerm_security_center_contact\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"azurerm_security_center_contact\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"azurerm_security_center_contact\" \"$$$_\" {\n$$$_\nalerts_to_admins = true\n$$$_\n}"]))
        | finding("azure-securitycenter-email-alert-admins";
            "Ensure that Send email notification for high severity alerts is set to On") ) )
| report
