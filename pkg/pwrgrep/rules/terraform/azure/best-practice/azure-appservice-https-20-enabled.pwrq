# rules: azure-appservice-https-20-enabled
# languages: hcl
# from: terraform/azure/best-practice/azure-appservice-https-20-enabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\nsite_config {\n  http2_enabled = true\n}\n$$$_\n}",
      "resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\nsite_config {\n  http2_enabled = true\n}\n$$$_\n}"]))
          | within($all | of(["resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n}"]))
        | finding("azure-appservice-https-20-enabled";
            "Ensure that HTTP Version is the latest if used to run the web app") ) )
| report
