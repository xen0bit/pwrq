# rules: azure-iot-no-public-network-access
# languages: hcl
# from: terraform/azure/security/azure-iot-no-public-network-access.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_iothub\" \"$$$_\" {\n$$$_\npublic_network_access_enabled = true\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"azurerm_iothub\" \"$$$_\" {\n$$$_\npublic_network_access_enabled = true\n$$$_\n}"]))
        | finding("azure-iot-no-public-network-access";
            "Ensure that Azure IoT Hub disables public network access") ) )
| report
