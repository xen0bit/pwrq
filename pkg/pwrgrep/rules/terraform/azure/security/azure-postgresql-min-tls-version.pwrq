# rules: azure-postgresql-min-tls-version
# from: terraform/azure/security/azure-postgresql-min-tls-version.yaml

. as $root
| ( ($root | scan_regex(["*.tf"]; [
      "\"TLS1_0\"",
      "\"TLS1_1\"",
      "\"TLS1_2\"",
      "(?P<RESOURCE>\\S+)\\s+\"azurerm_postgresql_server\"\\s+\"[\\s\\S]*?\"\\s+\\{\\s+[\\s\\S]*?\\s+\\}",
      "(?P<RESOURCE>\\S+)\\s+\"azurerm_postgresql_server\"\\s+\"[\\s\\S]*?\"\\s+\\{\\s+[\\s\\S]*?\\s+ssl_enforcement_enabled\\s+=\\s+true\\s+[\\s\\S]*?\\s+\\}",
      "ssl_minimal_tls_version_enforced\\s+=\\s+[\\s\\S]*?"
    ])) as $all
    | ( $all | of(["\"TLS1_2\"","\"TLS1_1\"","\"TLS1_0\""])
          | within($all | of(["ssl_minimal_tls_version_enforced\\s+=\\s+[\\s\\S]*?"]))
          | within($all | of(["(?P<RESOURCE>\\S+)\\s+\"azurerm_postgresql_server\"\\s+\"[\\s\\S]*?\"\\s+\\{\\s+[\\s\\S]*?\\s+\\}"]))
          | outside($all | of(["(?P<RESOURCE>\\S+)\\s+\"azurerm_postgresql_server\"\\s+\"[\\s\\S]*?\"\\s+\\{\\s+[\\s\\S]*?\\s+ssl_enforcement_enabled\\s+=\\s+true\\s+[\\s\\S]*?\\s+\\}"]))
        | finding("azure-postgresql-min-tls-version";
            "Ensure PostgreSQL is using the latest version of TLS encryption") ) )
| report
