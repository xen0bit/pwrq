# rules: azure-managed-disk-encryption
# languages: hcl
# from: terraform/azure/security/azure-managed-disk-encryption.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_managed_disk\" \"$$$_\" {\n$$$_\nencryption_settings {\n  $$$_\n  enabled = false\n  $$$_\n}\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"azurerm_managed_disk\" \"$$$_\" {\n$$$_\nencryption_settings {\n  $$$_\n  enabled = false\n  $$$_\n}\n$$$_\n}"]))
        | finding("azure-managed-disk-encryption";
            "Ensure Azure managed disk has encryption enabled") ) )
| report
