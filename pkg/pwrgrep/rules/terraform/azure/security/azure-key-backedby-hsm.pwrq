# rules: azure-key-backedby-hsm
# languages: hcl
# from: terraform/azure/security/azure-key-backedby-hsm.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_key_vault_key\" \"$$$_\" {\n$$$_\nkey_type = \"EC-HSM\"\n$$$_\n}",
      "resource \"azurerm_key_vault_key\" \"$$$_\" {\n$$$_\nkey_type = \"RSA-HSM\"\n$$$_\n}",
      "resource \"azurerm_key_vault_key\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_key_vault_key\" \"$$$_\" {\n$$$_\nkey_type = \"EC-HSM\"\n$$$_\n}"]))
          | outside($all | of(["resource \"azurerm_key_vault_key\" \"$$$_\" {\n$$$_\nkey_type = \"RSA-HSM\"\n$$$_\n}"]))
          | within($all | of(["resource \"azurerm_key_vault_key\" \"$$$_\" {\n$$$_\n}"]))
        | finding("azure-key-backedby-hsm";
            "Ensure that key vault key is backed by HSM") ) )
| report
