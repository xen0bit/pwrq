# rules: keyvault-purge-enabled
# languages: hcl
# from: terraform/azure/security/keyvault/keyvault-purge-enabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_key_vault\" \"$$$_\" {\n$$$_\n  purge_protection_enabled = false\n$$$_\n}",
      "resource \"azurerm_key_vault\" \"$$$_\" {\n$$$_\n purge_protection_enabled = true\n$$$_\n}",
      "resource \"azurerm_key_vault\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | at_same_place((($all
          | within($all | of(["resource \"azurerm_key_vault\" \"$$$_\" {\n$$$_\n}"])))
          + ($all
          | within($all | of(["resource \"azurerm_key_vault\" \"$$$_\" {\n$$$_\n  purge_protection_enabled = false\n$$$_\n}"])))))
          | outside($all | of(["resource \"azurerm_key_vault\" \"$$$_\" {\n$$$_\n purge_protection_enabled = true\n$$$_\n}"]))
        | finding("keyvault-purge-enabled";
            "Key vault should have purge protection enabled") ) )
| report
