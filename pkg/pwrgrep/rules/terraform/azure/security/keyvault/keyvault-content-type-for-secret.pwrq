# rules: keyvault-content-type-for-secret
# languages: hcl
# from: terraform/azure/security/keyvault/keyvault-content-type-for-secret.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_key_vault_secret\" \"$$$_\" {\n$$$_\ncontent_type = \"$$$_\"\n$$$_\n}",
      "resource \"azurerm_key_vault_secret\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_key_vault_secret\" \"$$$_\" {\n$$$_\ncontent_type = \"$$$_\"\n$$$_\n}"]))
          | within($all | of(["resource \"azurerm_key_vault_secret\" \"$$$_\" {\n$$$_\n}"]))
        | finding("keyvault-content-type-for-secret";
            "Key vault Secret should have a content type set") ) )
| report
