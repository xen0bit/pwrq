# rules: azure-instance-extensions
# languages: hcl
# from: terraform/azure/security/azure-instance-extensions.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_linux_virtual_machine\" \"$$$_\" {\n$$$_\nallow_extension_operations = false\n$$$_\n}",
      "resource \"azurerm_linux_virtual_machine\" \"$$$_\" {\n$$$_\n}",
      "resource \"azurerm_windows_virtual_machine\" \"$$$_\" {\n$$$_\nallow_extension_operations = false\n$$$_\n}",
      "resource \"azurerm_windows_virtual_machine\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | at_same_place((($all
          | within($all | of(["resource \"azurerm_linux_virtual_machine\" \"$$$_\" {\n$$$_\n}"])))
          + ($all
          | within($all | of(["resource \"azurerm_windows_virtual_machine\" \"$$$_\" {\n$$$_\n}"])))))
          | outside($all | of(["resource \"azurerm_linux_virtual_machine\" \"$$$_\" {\n$$$_\nallow_extension_operations = false\n$$$_\n}"]))
          | outside($all | of(["resource \"azurerm_windows_virtual_machine\" \"$$$_\" {\n$$$_\nallow_extension_operations = false\n$$$_\n}"]))
        | finding("azure-instance-extensions";
            "Ensure Virtual Machine Extensions are not Installed") ) )
| report
