# rules: azure-automation-encrypted
# languages: hcl
# from: terraform/azure/security/azure-automation-encrypted.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"azurerm_automation_variable_datetime\" \"$$$_\" {\n$$$_\nencrypted = true\n$$$_\n}",
      "resource \"azurerm_automation_variable_datetime\" \"$$$_\" {\n$$$_\n}",
      "resource \"azurerm_automation_variable_int\" \"$$$_\" {\n$$$_\nencrypted = true\n$$$_\n}",
      "resource \"azurerm_automation_variable_int\" \"$$$_\" {\n$$$_\n}",
      "resource \"azurerm_automation_variable_string\" \"$$$_\" {\n$$$_\nencrypted = true\n$$$_\n}",
      "resource \"azurerm_automation_variable_string\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( ($all
          | within($all | of(["resource \"azurerm_automation_variable_string\" \"$$$_\" {\n$$$_\n}"])))
          + ($all
          | within($all | of(["resource \"azurerm_automation_variable_datetime\" \"$$$_\" {\n$$$_\n}"])))
          + ($all
          | within($all | of(["resource \"azurerm_automation_variable_int\" \"$$$_\" {\n$$$_\n}"])))
          | outside($all | of(["resource \"azurerm_automation_variable_string\" \"$$$_\" {\n$$$_\nencrypted = true\n$$$_\n}"]))
          | outside($all | of(["resource \"azurerm_automation_variable_datetime\" \"$$$_\" {\n$$$_\nencrypted = true\n$$$_\n}"]))
          | outside($all | of(["resource \"azurerm_automation_variable_int\" \"$$$_\" {\n$$$_\nencrypted = true\n$$$_\n}"]))
        | finding("azure-automation-encrypted";
            "Ensure that Automation account variables are encrypted") ) )
| report
