# rules: azure-datafactory-uses-git-repository
# languages: hcl
# from: terraform/azure/security/azure-datafactory-uses-git-repository.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_data_factory\" \"$$$_\" {\n$$$_\ngithub_configuration {\n  $$$_\n}\n$$$_\n}",
      "resource \"azurerm_data_factory\" \"$$$_\" {\n$$$_\nvsts_configuration {\n  $$$_\n}\n$$$_\n}",
      "resource \"azurerm_data_factory\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_data_factory\" \"$$$_\" {\n$$$_\ngithub_configuration {\n  $$$_\n}\n$$$_\n}"]))
          | outside($all | of(["resource \"azurerm_data_factory\" \"$$$_\" {\n$$$_\nvsts_configuration {\n  $$$_\n}\n$$$_\n}"]))
          | within($all | of(["resource \"azurerm_data_factory\" \"$$$_\" {\n$$$_\n}"]))
        | finding("azure-datafactory-uses-git-repository";
            "Ensure that Azure Data Factory uses Git repository for source control") ) )
| report
