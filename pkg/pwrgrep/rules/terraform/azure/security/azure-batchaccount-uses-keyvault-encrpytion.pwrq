# rules: azure-batchaccount-uses-keyvault-encrpytion
# languages: hcl
# from: terraform/azure/security/azure-batchaccount-uses-keyvault-encrpytion.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_batch_account\" \"$$$_\" {\n$$$_\nkey_vault_reference {\n  $$$_\n}\n$$$_\n}",
      "resource \"azurerm_batch_account\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_batch_account\" \"$$$_\" {\n$$$_\nkey_vault_reference {\n  $$$_\n}\n$$$_\n}"]))
          | within($all | of(["resource \"azurerm_batch_account\" \"$$$_\" {\n$$$_\n}"]))
        | finding("azure-batchaccount-uses-keyvault-encrpytion";
            "Ensure that Azure Batch account uses key vault to encrypt data") ) )
| report
