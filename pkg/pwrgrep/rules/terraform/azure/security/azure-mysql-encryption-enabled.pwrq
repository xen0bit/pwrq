# rules: azure-mysql-encryption-enabled
# languages: hcl
# from: terraform/azure/security/azure-mysql-encryption-enabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_mysql_server\" \"$$$_\" {\n$$$_\ninfrastructure_encryption_enabled = true\n$$$_\n}",
      "resource \"azurerm_mysql_server\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"azurerm_mysql_server\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"azurerm_mysql_server\" \"$$$_\" {\n$$$_\ninfrastructure_encryption_enabled = true\n$$$_\n}"]))
        | finding("azure-mysql-encryption-enabled";
            "Ensure that MySQL server enables infrastructure encryption") ) )
| report
