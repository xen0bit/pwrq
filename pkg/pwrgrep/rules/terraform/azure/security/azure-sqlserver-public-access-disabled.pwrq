# rules: azure-sqlserver-public-access-disabled
# languages: hcl
# from: terraform/azure/security/azure-sqlserver-public-access-disabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_mssql_server\" \"$$$_\" {\n$$$_\npublic_network_access_enabled = false\n$$$_\n}",
      "resource \"azurerm_mssql_server\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"azurerm_mssql_server\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"azurerm_mssql_server\" \"$$$_\" {\n$$$_\npublic_network_access_enabled = false\n$$$_\n}"]))
        | finding("azure-sqlserver-public-access-disabled";
            "Ensure that SQL server disables public network access") ) )
| report
