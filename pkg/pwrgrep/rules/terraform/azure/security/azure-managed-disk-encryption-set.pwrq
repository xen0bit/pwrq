# rules: azure-managed-disk-encryption-set
# languages: hcl
# from: terraform/azure/security/azure-managed-disk-encryption-set.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_managed_disk\" \"$$$_\" {\n$$$_\ndisk_encryption_set_id = $$$_\n$$$_\n}",
      "resource \"azurerm_managed_disk\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_managed_disk\" \"$$$_\" {\n$$$_\ndisk_encryption_set_id = $$$_\n$$$_\n}"]))
          | within($all | of(["resource \"azurerm_managed_disk\" \"$$$_\" {\n$$$_\n}"]))
        | finding("azure-managed-disk-encryption-set";
            "Ensure that managed disks use a specific set of disk encryption sets for the customer-managed key encryption") ) )
| report
