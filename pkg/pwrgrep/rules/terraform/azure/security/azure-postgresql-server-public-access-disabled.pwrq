# rules: azure-postgresql-server-public-access-disabled
# languages: hcl
# from: terraform/azure/security/azure-postgresql-server-public-access-disabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_postgresql_server\" \"$$$_\" {\n$$$_\npublic_network_access_enabled = false\n$$$_\n}",
      "resource \"azurerm_postgresql_server\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"azurerm_postgresql_server\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"azurerm_postgresql_server\" \"$$$_\" {\n$$$_\npublic_network_access_enabled = false\n$$$_\n}"]))
        | finding("azure-postgresql-server-public-access-disabled";
            "Ensure public network access enabled is set to False for PostgreSQL servers") ) )
| report
