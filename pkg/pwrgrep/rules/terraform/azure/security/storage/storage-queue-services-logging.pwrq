# rules: storage-queue-services-logging
# languages: hcl
# from: terraform/azure/security/storage/storage-queue-services-logging.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"azurerm_storage_account\" \"$$$_\" {\n  $$$_\n        queue_properties  {\n          $$$_\n          logging {\n            $$$_\n          }\n          $$$_\n        }\n  $$$_\n}",
      "resource \"azurerm_storage_account\" \"$$$_\" {\n  $$$_\n      queue_properties  {\n        $$$_\n      }\n  $$$_\n}",
      "resource \"azurerm_storage_account\" \"$$$_\" {\n  $$$_\n}"
    ])) as $all
    | ( ($all
          | within($all | of(["resource \"azurerm_storage_account\" \"$$$_\" {\n  $$$_\n      queue_properties  {\n        $$$_\n      }\n  $$$_\n}"])))
          + ($all
          | within($all | of(["resource \"azurerm_storage_account\" \"$$$_\" {\n  $$$_\n}"])))
          | outside($all | of(["resource \"azurerm_storage_account\" \"$$$_\" {\n  $$$_\n        queue_properties  {\n          $$$_\n          logging {\n            $$$_\n          }\n          $$$_\n        }\n  $$$_\n}"]))
        | finding("storage-queue-services-logging";
            "Storage Analytics logs detailed information about successful and failed requests to a storage service.") ) )
| report
