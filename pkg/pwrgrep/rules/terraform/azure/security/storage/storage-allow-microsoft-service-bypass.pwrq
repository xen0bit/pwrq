# rules: storage-allow-microsoft-service-bypass
# languages: hcl
# from: terraform/azure/security/storage/storage-allow-microsoft-service-bypass.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"azurerm_storage_account\" \"$$$_\" {\n$$$_\n  network_rules {\n    $$$_\n    bypass = [\"$$$_\", \"AzureServices\"]\n    $$$_\n  }\n$$$_\n}",
      "resource \"azurerm_storage_account\" \"$$$_\" {\n$$$_\n  network_rules {\n    $$$_\n    bypass = [$ANYTHING]\n    $$$_\n  }\n$$$_\n}",
      "resource \"azurerm_storage_account_network_rules\" \"$$$_\" {\n$$$_\n  bypass = [\"$$$_\", \"AzureServices\"]\n$$$_\n}",
      "resource \"azurerm_storage_account_network_rules\" \"$$$_\" {\n$$$_\nbypass = [$ANYTHING]\n$$$_\n}"
    ])) as $all
    | ( ($all
          | within($all | of(["resource \"azurerm_storage_account_network_rules\" \"$$$_\" {\n$$$_\nbypass = [$ANYTHING]\n$$$_\n}"])))
          + ($all
          | within($all | of(["resource \"azurerm_storage_account\" \"$$$_\" {\n$$$_\n  network_rules {\n    $$$_\n    bypass = [$ANYTHING]\n    $$$_\n  }\n$$$_\n}"])))
          | outside($all | of(["resource \"azurerm_storage_account\" \"$$$_\" {\n$$$_\n  network_rules {\n    $$$_\n    bypass = [\"$$$_\", \"AzureServices\"]\n    $$$_\n  }\n$$$_\n}"]))
          | outside($all | of(["resource \"azurerm_storage_account_network_rules\" \"$$$_\" {\n$$$_\n  bypass = [\"$$$_\", \"AzureServices\"]\n$$$_\n}"]))
        | finding("storage-allow-microsoft-service-bypass";
            "Some Microsoft services that interact with storage accounts operate from networks that can't be granted access through network rules.") ) )
| report
