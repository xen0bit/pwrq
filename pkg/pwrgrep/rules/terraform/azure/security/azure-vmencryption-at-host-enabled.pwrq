# rules: azure-vmencryption-at-host-enabled
# languages: hcl
# from: terraform/azure/security/azure-vmencryption-at-host-enabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_linux_virtual_machine_scale_set\" \"$$$_\" {\n$$$_\nencryption_at_host_enabled = true\n$$$_\n}",
      "resource \"azurerm_linux_virtual_machine_scale_set\" \"$$$_\" {\n$$$_\n}",
      "resource \"azurerm_windows_virtual_machine_scale_set\" \"$$$_\" {\n$$$_\nencryption_at_host_enabled = true\n$$$_\n}",
      "resource \"azurerm_windows_virtual_machine_scale_set\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | at_same_place((($all
          | within($all | of(["resource \"azurerm_windows_virtual_machine_scale_set\" \"$$$_\" {\n$$$_\n}"])))
          + ($all
          | within($all | of(["resource \"azurerm_linux_virtual_machine_scale_set\" \"$$$_\" {\n$$$_\n}"])))))
          | outside($all | of(["resource \"azurerm_windows_virtual_machine_scale_set\" \"$$$_\" {\n$$$_\nencryption_at_host_enabled = true\n$$$_\n}"]))
          | outside($all | of(["resource \"azurerm_linux_virtual_machine_scale_set\" \"$$$_\" {\n$$$_\nencryption_at_host_enabled = true\n$$$_\n}"]))
        | finding("azure-vmencryption-at-host-enabled";
            "Ensure that Virtual machine scale sets have encryption at host enabled") ) )
| report
