# rules: azure-containergroup-deployed-into-virtualnetwork
# languages: hcl
# from: terraform/azure/security/azure-containergroup-deployed-into-virtualnetwork.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_container_group\" \"$$$_\" {\n$$$_\ncontainer {\n  $$$_\n}\n$$$_\n}",
      "resource \"azurerm_container_group\" \"$$$_\" {\n$$$_\ncontainer {\n  $$$_\n}\nnetwork_profile_id = \"$$$_\"  \n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_container_group\" \"$$$_\" {\n$$$_\ncontainer {\n  $$$_\n}\nnetwork_profile_id = \"$$$_\"  \n$$$_\n}"]))
          | within($all | of(["resource \"azurerm_container_group\" \"$$$_\" {\n$$$_\ncontainer {\n  $$$_\n}\n$$$_\n}"]))
        | finding("azure-containergroup-deployed-into-virtualnetwork";
            "Ensure that Azure Container group is deployed into virtual network") ) )
| report
