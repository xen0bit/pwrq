# rules: azure-functionapps-enable-auth
# languages: hcl
# from: terraform/azure/security/azure-functionapps-enable-auth.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_function_app\" \"$$$_\" {\n$$$_\nauth_settings {\n  $$$_\n  enabled = true\n  $$$_\n}\n$$$_\n}",
      "resource \"azurerm_function_app\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_function_app\" \"$$$_\" {\n$$$_\nauth_settings {\n  $$$_\n  enabled = true\n  $$$_\n}\n$$$_\n}"]))
          | within($all | of(["resource \"azurerm_function_app\" \"$$$_\" {\n$$$_\n}"]))
        | finding("azure-functionapps-enable-auth";
            "Ensure that function apps enables Authentication") ) )
| report
