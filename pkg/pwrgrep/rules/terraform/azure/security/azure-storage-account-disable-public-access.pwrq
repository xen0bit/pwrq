# rules: azure-storage-account-disable-public-access
# languages: hcl
# from: terraform/azure/security/azure-storage-account-disable-public-access.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_storage_account\" \"$$$_\" {\n$$$_\nallow_blob_public_access = true\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"azurerm_storage_account\" \"$$$_\" {\n$$$_\nallow_blob_public_access = true\n$$$_\n}"]))
        | finding("azure-storage-account-disable-public-access";
            "Ensure default network access rule for Storage Accounts is set to deny") ) )
| report
