# rules: azure-appservice-http-logging-enabled
# languages: hcl
# from: terraform/azure/security/appservice/azure-appservice-http-logging-enabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\nlogs {\n$$$_\n  dynamic \"http_logs\" {\n  $$$_\n  }\n}\n$$$_\n}",
      "resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\nlogs {\n$$$_\n  http_logs {\n  $$$_\n  }\n}\n$$$_\n}",
      "resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\nlogs {\n$$$_\n  http_logs {\n  $$$_\n  }\n}\n$$$_\n}"]))
          | outside($all | of(["resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\nlogs {\n$$$_\n  dynamic \"http_logs\" {\n  $$$_\n  }\n}\n$$$_\n}"]))
          | within($all | of(["resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n}"]))
        | finding("azure-appservice-http-logging-enabled";
            "Ensure that App service enables HTTP logging") ) )
| report
