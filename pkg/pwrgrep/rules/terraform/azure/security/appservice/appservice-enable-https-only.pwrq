# rules: appservice-enable-https-only
# languages: hcl
# from: terraform/azure/security/appservice/appservice-enable-https-only.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n  https_only = false\n$$$_\n}",
      "resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n  https_only = true\n$$$_\n}",
      "resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | at_same_place((($all
          | within($all | of(["resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n}"])))
          + ($all
          | within($all | of(["resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n  https_only = false\n$$$_\n}"])))))
          | outside($all | of(["resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n  https_only = true\n$$$_\n}"]))
        | finding("appservice-enable-https-only";
            "By default, clients can connect to App Service by using both HTTP or HTTPS.") ) )
| report
