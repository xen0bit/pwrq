# rules: azure-appservice-auth
# languages: hcl
# from: terraform/azure/security/appservice/azure-appservice-auth.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\nauth_settings {\n  $$$_\n  enabled = true\n  $$$_\n}\n$$$_\n}",
      "resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\nauth_settings {\n  $$$_\n  enabled = true\n  $$$_\n}\n$$$_\n}"]))
          | within($all | of(["resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n}"]))
        | finding("azure-appservice-auth";
            "Ensure App Service Authentication is set on Azure App Service") ) )
| report
