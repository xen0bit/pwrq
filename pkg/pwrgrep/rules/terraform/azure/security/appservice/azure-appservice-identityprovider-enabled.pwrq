# rules: azure-appservice-identityprovider-enabled
# languages: hcl
# from: terraform/azure/security/appservice/azure-appservice-identityprovider-enabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\nidentity {\n$$$_\ntype = \"SystemAssigned\"\n$$$_\n}\n$$$_\n}",
      "resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\nidentity {\n$$$_\ntype = \"SystemAssigned\"\n$$$_\n}\n$$$_\n}"]))
          | within($all | of(["resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n}"]))
        | finding("azure-appservice-identityprovider-enabled";
            "Ensure that Managed identity provider is enabled for app services") ) )
| report
