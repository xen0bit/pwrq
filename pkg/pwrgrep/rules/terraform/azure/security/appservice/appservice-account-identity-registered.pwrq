# rules: appservice-account-identity-registered
# languages: hcl
# from: terraform/azure/security/appservice/appservice-account-identity-registered.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n  identity {\n    type = \"$$$_\"\n    identity_ids = \"$$$_\"\n  }\n$$$_\n}",
      "resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n  identity {\n    type = \"SystemAssigned\"\n  }\n$$$_\n}",
      "resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n  identity {\n    type = \"$$$_\"\n    identity_ids = \"$$$_\"\n  }\n$$$_\n}"]))
          | outside($all | of(["resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n  identity {\n    type = \"SystemAssigned\"\n  }\n$$$_\n}"]))
          | within($all | of(["resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n}"]))
        | finding("appservice-account-identity-registered";
            "Registering the identity used by an App with AD allows it to interact with other services without using username and password.") ) )
| report
