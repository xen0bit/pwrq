# rules: appservice-require-client-cert
# languages: hcl
# from: terraform/azure/security/appservice/appservice-require-client-cert.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n  client_cert_enabled = false\n$$$_\n}",
      "resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n  client_cert_enabled = true\n$$$_\n}",
      "resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | at_same_place((($all
          | within($all | of(["resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n}"])))
          + ($all
          | within($all | of(["resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n  client_cert_enabled = false\n$$$_\n}"])))))
          | outside($all | of(["resource \"azurerm_app_service\" \"$$$_\" {\n$$$_\n  client_cert_enabled = true\n$$$_\n}"]))
        | finding("appservice-require-client-cert";
            "Detected an AppService that was not configured to use a client certificate.") ) )
| report
