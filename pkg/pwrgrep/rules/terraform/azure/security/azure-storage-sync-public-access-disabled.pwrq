# rules: azure-storage-sync-public-access-disabled
# languages: hcl
# from: terraform/azure/security/azure-storage-sync-public-access-disabled.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_storage_sync\" \"$$$_\" {\n$$$_\nincoming_traffic_policy = AllowVirtualNetworksOnly\n$$$_\n}",
      "resource \"azurerm_storage_sync\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"azurerm_storage_sync\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"azurerm_storage_sync\" \"$$$_\" {\n$$$_\nincoming_traffic_policy = AllowVirtualNetworksOnly\n$$$_\n}"]))
        | finding("azure-storage-sync-public-access-disabled";
            "Ensure that Azure File Sync disables public network access") ) )
| report
