# rules: azure-service-fabric-cluster-protection-level
# languages: hcl
# from: terraform/azure/security/azure-service-fabric-cluster-protection-level.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_service_fabric_cluster\" \"$$$_\" {\n$$$_\nfabric_settings {\n  name = \"Security\"\n  parameters = {\n    $$$_\n    name = \"ClusterProtectionLevel\"\n    value = \"EncryptAndSign\"\n    $$$_\n  }\n  $$$_\n}\n$$$_\n}",
      "resource \"azurerm_service_fabric_cluster\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"azurerm_service_fabric_cluster\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"azurerm_service_fabric_cluster\" \"$$$_\" {\n$$$_\nfabric_settings {\n  name = \"Security\"\n  parameters = {\n    $$$_\n    name = \"ClusterProtectionLevel\"\n    value = \"EncryptAndSign\"\n    $$$_\n  }\n  $$$_\n}\n$$$_\n}"]))
        | finding("azure-service-fabric-cluster-protection-level";
            "Ensure that Service Fabric use three levels of protection available") ) )
| report
