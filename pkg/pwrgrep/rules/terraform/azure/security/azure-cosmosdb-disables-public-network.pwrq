# rules: azure-cosmosdb-disables-public-network
# languages: hcl
# from: terraform/azure/security/azure-cosmosdb-disables-public-network.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_cosmosdb_account\" \"$$$_\" {\n$$$_\npublic_network_access_enabled = false\n$$$_\n}",
      "resource \"azurerm_cosmosdb_account\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_cosmosdb_account\" \"$$$_\" {\n$$$_\npublic_network_access_enabled = false\n$$$_\n}"]))
          | within($all | of(["resource \"azurerm_cosmosdb_account\" \"$$$_\" {\n$$$_\n}"]))
        | finding("azure-cosmosdb-disables-public-network";
            "Ensure that Azure Cosmos DB disables public network access") ) )
| report
