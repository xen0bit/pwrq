# rules: azure-cosmosdb-disable-access-key-write
# languages: hcl
# from: terraform/azure/security/azure-cosmosdb-disable-access-key-write.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_cosmosdb_account\" \"$$$_\" {\n$$$_\naccess_key_metadata_writes_enabled = false\n$$$_\n}",
      "resource \"azurerm_cosmosdb_account\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_cosmosdb_account\" \"$$$_\" {\n$$$_\naccess_key_metadata_writes_enabled = false\n$$$_\n}"]))
          | within($all | of(["resource \"azurerm_cosmosdb_account\" \"$$$_\" {\n$$$_\n}"]))
        | finding("azure-cosmosdb-disable-access-key-write";
            "Ensure that Cosmos DB accounts have access key write capability disabled") ) )
| report
