# rules: azure-cosmosdb-have-cmk
# languages: hcl
# from: terraform/azure/security/azure-cosmosdb-have-cmk.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_cosmosdb_account\" \"$$$_\" {\n$$$_\nkey_vault_key_id = $$$_\n$$$_\n}",
      "resource \"azurerm_cosmosdb_account\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_cosmosdb_account\" \"$$$_\" {\n$$$_\nkey_vault_key_id = $$$_\n$$$_\n}"]))
          | within($all | of(["resource \"azurerm_cosmosdb_account\" \"$$$_\" {\n$$$_\n}"]))
        | finding("azure-cosmosdb-have-cmk";
            "Ensure that Cosmos DB accounts have customer-managed keys to encrypt data at rest") ) )
| report
