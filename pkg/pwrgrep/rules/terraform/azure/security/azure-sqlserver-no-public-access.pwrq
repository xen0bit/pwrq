# rules: azure-sqlserver-no-public-access
# languages: hcl
# from: terraform/azure/security/azure-sqlserver-no-public-access.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_mysql_firewall_rule\" \"$$$_\" {\n$$$_\nstart_ip_address    = \"0.0.0.0\"\nend_ip_address      = \"255.255.255.255\"\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"azurerm_mysql_firewall_rule\" \"$$$_\" {\n$$$_\nstart_ip_address    = \"0.0.0.0\"\nend_ip_address      = \"255.255.255.255\"\n$$$_\n}"]))
        | finding("azure-sqlserver-no-public-access";
            "Ensure no SQL Databases allow ingress from 0.0.0.0/0 (ANY IP)") ) )
| report
