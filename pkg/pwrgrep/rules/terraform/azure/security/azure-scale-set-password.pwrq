# rules: azure-scale-set-password
# languages: hcl
# from: terraform/azure/security/azure-scale-set-password.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_linux_virtual_machine_scale_set\" \"$$$_\" {\n$$$_\ndisable_password_authentication = true\n$$$_\n}",
      "resource \"azurerm_linux_virtual_machine_scale_set\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | within($all | of(["resource \"azurerm_linux_virtual_machine_scale_set\" \"$$$_\" {\n$$$_\n}"]))
          | outside($all | of(["resource \"azurerm_linux_virtual_machine_scale_set\" \"$$$_\" {\n$$$_\ndisable_password_authentication = true\n$$$_\n}"]))
        | finding("azure-scale-set-password";
            "Ensure that Virtual machine does not enable password authentication") ) )
| report
