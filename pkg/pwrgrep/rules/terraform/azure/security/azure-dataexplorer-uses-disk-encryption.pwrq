# rules: azure-dataexplorer-uses-disk-encryption
# languages: hcl
# from: terraform/azure/security/azure-dataexplorer-uses-disk-encryption.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_kusto_cluster\" \"$$$_\" {\n$$$_\nenable_disk_encryption = true\n$$$_\n}",
      "resource \"azurerm_kusto_cluster\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_kusto_cluster\" \"$$$_\" {\n$$$_\nenable_disk_encryption = true\n$$$_\n}"]))
          | within($all | of(["resource \"azurerm_kusto_cluster\" \"$$$_\" {\n$$$_\n}"]))
        | finding("azure-dataexplorer-uses-disk-encryption";
            "Ensure that Azure Data Explorer uses disk encryption") ) )
| report
