# rules: azure-aks-apiserver-auth-ip-ranges
# languages: hcl
# from: terraform/azure/security/aks/azure-aks-apiserver-auth-ip-ranges.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_kubernetes_cluster\" \"$$$_\" {\n$$$_\napi_server_authorized_ip_ranges = [\"$$$_\"]\n$$$_\n}",
      "resource \"azurerm_kubernetes_cluster\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_kubernetes_cluster\" \"$$$_\" {\n$$$_\napi_server_authorized_ip_ranges = [\"$$$_\"]\n$$$_\n}"]))
          | within($all | of(["resource \"azurerm_kubernetes_cluster\" \"$$$_\" {\n$$$_\n}"]))
        | finding("azure-aks-apiserver-auth-ip-ranges";
            "Ensure AKS has an API Server Authorized IP Ranges enabled") ) )
| report
