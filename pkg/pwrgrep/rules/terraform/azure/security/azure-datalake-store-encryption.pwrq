# rules: azure-datalake-store-encryption
# languages: hcl
# from: terraform/azure/security/azure-datalake-store-encryption.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource",
      "resource \"azurerm_data_lake_store\" \"$$$_\" {\n$$$_\nencryption_state = \"Enabled\"\n$$$_\n}",
      "resource \"azurerm_data_lake_store\" \"$$$_\" {\n$$$_\n}"
    ])) as $all
    | ( $all | of(["resource"])
          | outside($all | of(["resource \"azurerm_data_lake_store\" \"$$$_\" {\n$$$_\nencryption_state = \"Enabled\"\n$$$_\n}"]))
          | within($all | of(["resource \"azurerm_data_lake_store\" \"$$$_\" {\n$$$_\n}"]))
        | finding("azure-datalake-store-encryption";
            "Ensure that Data Lake Store accounts enables encryption") ) )
| report
