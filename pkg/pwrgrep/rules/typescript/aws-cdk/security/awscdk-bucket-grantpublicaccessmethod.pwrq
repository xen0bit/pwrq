# rules: awscdk-bucket-grantpublicaccessmethod
# languages: typescript
# from: typescript/aws-cdk/security/awscdk-bucket-grantpublicaccessmethod.yml

. as $root
| ( ($root | scan_ast(["*.ts"]; [
      "const $X = new $Y.Bucket($$$_)\n$$$_\n$X.grantPublicAccess($$$_)",
      "const $X = new Bucket($$$_)\n$$$_\n$X.grantPublicAccess($$$_)",
      "import * as $Y from '@aws-cdk/aws-s3'\n$$$_",
      "import {Bucket} from '@aws-cdk/aws-s3'\n$$$_"
    ])) as $all
    | ( ($all | of(["const $X = new Bucket($$$_)\n$$$_\n$X.grantPublicAccess($$$_)"])
          | in_files_with($all | of(["import {Bucket} from '@aws-cdk/aws-s3'\n$$$_"])))
          + ($all | of(["const $X = new $Y.Bucket($$$_)\n$$$_\n$X.grantPublicAccess($$$_)"])
          | in_files_with($all | of(["import * as $Y from '@aws-cdk/aws-s3'\n$$$_"])))
        | finding("awscdk-bucket-grantpublicaccessmethod";
            "Using the GrantPublicAccess method on bucket contruct $X will make the objects in the bucket world accessible.") ) )
| report
