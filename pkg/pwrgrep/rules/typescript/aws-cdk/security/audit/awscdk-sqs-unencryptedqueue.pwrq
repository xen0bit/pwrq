# rules: awscdk-sqs-unencryptedqueue
# from: typescript/aws-cdk/security/audit/awscdk-sqs-unencryptedqueue.yml

. as $root
| ( ($root | scan_ast(["*.ts"]; [
      "const $X = new $Y.Queue($$$_)",
      "const $X = new $Y.Queue($$$_, {$$$_, encryption: $Y.QueueEncryption.KMS, $$$_})",
      "const $X = new $Y.Queue($$$_, {$$$_, encryption: $Y.QueueEncryption.KMS_MANAGED, $$$_})",
      "const $X = new Queue($$$_)",
      "const $X = new Queue($$$_, {$$$_, encryption: QueueEncryption.KMS, $$$_})",
      "const $X = new Queue($$$_, {$$$_, encryption: QueueEncryption.KMS_MANAGED, $$$_})",
      "import * as $Y from '@aws-cdk/aws-sqs'\n$$$_",
      "import {Queue} from '@aws-cdk/aws-sqs'\n$$$_"
    ])) as $all
    | ( ($all | of(["const $X = new Queue($$$_)"])
          | in_files_with($all | of(["import {Queue} from '@aws-cdk/aws-sqs'\n$$$_"]))
          | not_at($all | of(["const $X = new Queue($$$_, {$$$_, encryption: QueueEncryption.KMS_MANAGED, $$$_})"]))
          | not_at($all | of(["const $X = new Queue($$$_, {$$$_, encryption: QueueEncryption.KMS, $$$_})"])))
          + ($all | of(["const $X = new $Y.Queue($$$_)"])
          | in_files_with($all | of(["import * as $Y from '@aws-cdk/aws-sqs'\n$$$_"]))
          | not_at($all | of(["const $X = new $Y.Queue($$$_, {$$$_, encryption: $Y.QueueEncryption.KMS_MANAGED, $$$_})"]))
          | not_at($all | of(["const $X = new $Y.Queue($$$_, {$$$_, encryption: $Y.QueueEncryption.KMS, $$$_})"])))
        | finding("awscdk-sqs-unencryptedqueue";
            "Queue $X is missing encryption at rest.") ) )
| report
