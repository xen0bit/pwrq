# rules: aws-cdk-bucket-enforcessl
# languages: typescript
# from: typescript/aws-cdk/security/audit/awscdk-bucket-enforcessl.yml

. as $root
| ( ($root | scan_ast(["*.ts"]; [
      "const $X = new $Y.Bucket($$$_)",
      "const $X = new $Y.Bucket($$$_, {$$$_, enforceSSL: true, $$$_})",
      "const $X = new Bucket($$$_)",
      "const $X = new Bucket($$$_, {enforceSSL: true}, $$$_)",
      "import * as $Y from '@aws-cdk/aws-s3';\n$$$_",
      "import {Bucket} from '@aws-cdk/aws-s3';\n$$$_"
    ])) as $all
    | ( ($all | of(["const $X = new Bucket($$$_)"])
          | in_files_with($all | of(["import {Bucket} from '@aws-cdk/aws-s3';\n$$$_"]))
          | not_at($all | of(["const $X = new Bucket($$$_, {enforceSSL: true}, $$$_)"])))
          + ($all | of(["const $X = new $Y.Bucket($$$_)"])
          | in_files_with($all | of(["import * as $Y from '@aws-cdk/aws-s3';\n$$$_"]))
          | not_at($all | of(["const $X = new $Y.Bucket($$$_, {$$$_, enforceSSL: true, $$$_})"])))
        | finding("aws-cdk-bucket-enforcessl";
            "Bucket $X is not set to enforce encryption-in-transit, if not explictly setting this on the bucket policy - the property \"enforceSSL\" should be set to true") ) )
| report
