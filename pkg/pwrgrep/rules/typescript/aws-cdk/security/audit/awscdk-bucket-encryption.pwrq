# rules: awscdk-bucket-encryption
# languages: typescript
# from: typescript/aws-cdk/security/audit/awscdk-bucket-encryption.yml

. as $root
| ( ($root | scan_ast(["*.ts"]; [
      "const $X = new $Y.Bucket($$$_)",
      "const $X = new $Y.Bucket($$$_, {$$$_, encryption: $Y.BucketEncryption.KMS, $$$_})",
      "const $X = new $Y.Bucket($$$_, {$$$_, encryption: $Y.BucketEncryption.KMS_MANAGED, $$$_})",
      "const $X = new $Y.Bucket($$$_, {$$$_, encryption: $Y.BucketEncryption.S3_MANAGED, $$$_})",
      "const $X = new Bucket($$$_)",
      "const $X = new Bucket($$$_, {$$$_, encryption: BucketEncryption.KMS, $$$_})",
      "const $X = new Bucket($$$_, {$$$_, encryption: BucketEncryption.KMS_MANAGED, $$$_})",
      "const $X = new Bucket($$$_, {$$$_, encryption: BucketEncryption.S3_MANAGED, $$$_})",
      "import * as $Y from '@aws-cdk/aws-s3'\n$$$_",
      "import {Bucket} from '@aws-cdk/aws-s3'\n$$$_"
    ])) as $all
    | ( ($all | of(["const $X = new Bucket($$$_)"])
          | in_files_with($all | of(["import {Bucket} from '@aws-cdk/aws-s3'\n$$$_"]))
          | not_at($all | of(["const $X = new Bucket($$$_, {$$$_, encryption: BucketEncryption.KMS_MANAGED, $$$_})"]))
          | not_at($all | of(["const $X = new Bucket($$$_, {$$$_, encryption: BucketEncryption.KMS, $$$_})"]))
          | not_at($all | of(["const $X = new Bucket($$$_, {$$$_, encryption: BucketEncryption.S3_MANAGED, $$$_})"])))
          + ($all | of(["const $X = new $Y.Bucket($$$_)"])
          | in_files_with($all | of(["import * as $Y from '@aws-cdk/aws-s3'\n$$$_"]))
          | not_at($all | of(["const $X = new $Y.Bucket($$$_, {$$$_, encryption: $Y.BucketEncryption.KMS_MANAGED, $$$_})"]))
          | not_at($all | of(["const $X = new $Y.Bucket($$$_, {$$$_, encryption: $Y.BucketEncryption.KMS, $$$_})"]))
          | not_at($all | of(["const $X = new $Y.Bucket($$$_, {$$$_, encryption: $Y.BucketEncryption.S3_MANAGED, $$$_})"])))
        | finding("awscdk-bucket-encryption";
            "Add \"encryption: $Y.BucketEncryption.KMS_MANAGED\" or \"encryption: $Y.BucketEncryption.S3_MANAGED\" to the bucket props for Bucket construct $X") ) )
| report
