# rules: useless-ternary
# languages: javascript, typescript
# from: typescript/lang/correctness/useless-ternary.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$CONDITION ? $ANS : $ANS"
    ])) as $all
    | ( $all | of(["$CONDITION ? $ANS : $ANS"])
        | finding("useless-ternary";
            "It looks like no matter how $CONDITION is evaluated, this expression returns $ANS.") ) )
| report
