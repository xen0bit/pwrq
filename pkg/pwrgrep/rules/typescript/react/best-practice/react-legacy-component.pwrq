# rules: react-legacy-component
# from: typescript/react/best-practice/react-legacy-component.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$METHOD($$$_) {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["$METHOD($$$_) {\n  $$$_\n}"])
          | where_capture("METHOD"; "componentWillMount|componentWillReceiveProps|componentWillUpdate")
        | finding("react-legacy-component";
            "Legacy component lifecycle was detected - $METHOD.") ) )
| report
