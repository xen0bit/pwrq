    ])) as $all
    | ( (($all | of(["{$$$_,dangerouslySetInnerHTML: {__html: $X},$$$_}","<$Y $$$_ dangerouslySetInnerHTML={{__html: $X}} />"])
          | focus("X")
          | not_at($all | of(["<$Y $$$_ dangerouslySetInnerHTML={{__html: \"$$$_\"}} />"]))
          | not_at($all | of(["{$$$_,dangerouslySetInnerHTML:{__html: \"$$$_\"},$$$_}"]))
          | not_at($all | of(["$PWRQDEEP1"])
