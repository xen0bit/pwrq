# rules: react-jwt-decoded-property
# from: typescript/react/security/audit/react-jwt-decoded-property.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "\"jwt-decode\"",
      "$DECODED = jwt_decode($TOKEN,$$$_);\n$$$_",
      "$DECODED.$PROPERTY",
      "import jwt_decode from \"jwt-decode\";\n$$$_"
    ])) as $all
    | ( $all | of(["$DECODED.$PROPERTY"])
          | in_files_with($all | of(["import jwt_decode from \"jwt-decode\";\n$$$_","\"jwt-decode\""]))
          | in_files_with($all | of(["$DECODED = jwt_decode($TOKEN,$$$_);\n$$$_"]))
        | finding("react-jwt-decoded-property";
            "Property decoded from JWT token without verifying and cannot be trustworthy.") ) )
| report
