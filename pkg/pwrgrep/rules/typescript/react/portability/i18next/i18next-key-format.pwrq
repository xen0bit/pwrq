# rules: i18next-key-format
# languages: javascript, typescript
# from: typescript/react/portability/i18next/i18next-key-format.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$I18NEXT.t('$KEY')",
      "$I18NEXT.t('$KEY', $OPTIONS)",
      "$I18NEXT.t([$DYNAMIC_KEY, '$KEY'])",
      "$I18NEXT.t([$DYNAMIC_KEY, '$KEY'], $OPTIONS)",
      "t('$KEY')",
      "t('$KEY', $OPTIONS)",
      "t([$DYNAMIC_KEY, '$KEY'])",
      "t([$DYNAMIC_KEY, '$KEY'], $OPTIONS)"
    ])) as $all
    | ( ($all | of(["t('$KEY')","t('$KEY', $OPTIONS)","t([$DYNAMIC_KEY, '$KEY'])","t([$DYNAMIC_KEY, '$KEY'], $OPTIONS)"])
          | where_capture_not("KEY"; "^[a-z0-9-]+\\.[a-z0-9-]+\\.[a-zA-Z0-9_.-]+$"))
          + ($all | of(["t([$DYNAMIC_KEY, '$KEY'])","t([$DYNAMIC_KEY, '$KEY'], $OPTIONS)"])
          | where_capture_not("DYNAMIC_KEY"; "^[`][a-z0-9-]+[.][a-z0-9-]+[.]\\S+$"))
          + ($all | of(["$I18NEXT.t('$KEY')","$I18NEXT.t('$KEY', $OPTIONS)","$I18NEXT.t([$DYNAMIC_KEY, '$KEY'])","$I18NEXT.t([$DYNAMIC_KEY, '$KEY'], $OPTIONS)"])
          | where_capture("I18NEXT"; "^(?:(^i18n|i18next$))")
          | where_capture_not("KEY"; "^[a-z0-9-]+\\.[a-z0-9-]+\\.[a-zA-Z0-9_.-]+$"))
          + ($all | of(["$I18NEXT.t([$DYNAMIC_KEY, '$KEY'])","$I18NEXT.t([$DYNAMIC_KEY, '$KEY'], $OPTIONS)"])
          | where_capture("I18NEXT"; "^(?:(^(i18n|i18next)$))")
          | where_capture_not("DYNAMIC_KEY"; "^[`][a-z0-9-]+[.][a-z0-9-]+[.]\\S+$"))
        | finding("i18next-key-format";
            "Translation key '$KEY' should match format 'MODULE.FEATURE.*'") ) )
| report
