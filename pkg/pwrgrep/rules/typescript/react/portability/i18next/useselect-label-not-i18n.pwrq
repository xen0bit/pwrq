# rules: useselect-label-not-i18n
# from: typescript/react/portability/i18next/useselect-label-not-i18n.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "useSelect($X1, $X2, '$LABEL', $X4)",
      "useSelect($X1, $X2, t('$$$_'), $X4)"
    ])) as $all
    | ( $all | of(["useSelect($X1, $X2, '$LABEL', $X4)"])
          | where_capture("LABEL"; "(.*[A-Za-z].*)")
          | not_at($all | of(["useSelect($X1, $X2, t('$$$_'), $X4)"]))
        | finding("useselect-label-not-i18n";
            "React useSelect() label is not internationalized - '$LABEL'.") ) )
| report
