# rules: jsx-label-not-i18n
# from: typescript/react/portability/i18next/jsx-label-not-i18n.yaml

. as $root
| ( ($root | scan_ast(["*.js"]; [
      "<$ELEMENT $$$_ label=\"\" $$$_ />",
      "<$ELEMENT $$$_ label={t($KEY, $$$_)} $$$_ />",
      "<Tab $$$_ label=\"$MESSAGE\" $$$_ />",
      "<TextField $$$_ label=\"$MESSAGE\" $$$_ />"
    ])) as $all
    | ( $all | of(["<TextField $$$_ label=\"$MESSAGE\" $$$_ />","<Tab $$$_ label=\"$MESSAGE\" $$$_ />"])
          | where_capture("MESSAGE"; "(.*[a-zA-Z]+.*)")
          | not_at($all | of(["<$ELEMENT $$$_ label=\"\" $$$_ />"]))
          | not_at($all | of(["<$ELEMENT $$$_ label={t($KEY, $$$_)} $$$_ />"]))
        | finding("jsx-label-not-i18n";
            "JSX Component label not internationalized: '$MESSAGE'") ) )
| report
