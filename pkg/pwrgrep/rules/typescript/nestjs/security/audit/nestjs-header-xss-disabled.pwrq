# rules: nestjs-header-xss-disabled
# languages: typescript
# from: typescript/nestjs/security/audit/nestjs-header-xss-disabled.yaml

. as $root
| ( ($root | scan_ast(["*.ts"]; [
      "class $CN {\n    $$$_\n    @Header(\"=~/[Xx]-[Xx][Ss][Ss]-[Pp][Rr][Oo][Tt][Ee][Cc][Tt][Ii][Oo][Nn]/\", '0')\n    $FN($$$_) {\n        $$$_\n    }\n    $$$_\n}"
    ])) as $all
    | ( $all | of(["class $CN {\n    $$$_\n    @Header(\"=~/[Xx]-[Xx][Ss][Ss]-[Pp][Rr][Oo][Tt][Ee][Cc][Tt][Ii][Oo][Nn]/\", '0')\n    $FN($$$_) {\n        $$$_\n    }\n    $$$_\n}"])
        | finding("nestjs-header-xss-disabled";
            "X-XSS-Protection header is set to 0.") ) )
| report
