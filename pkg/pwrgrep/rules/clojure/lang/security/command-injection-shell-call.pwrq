# rules: command-injection-shell-call
# from: clojure/lang/security/command-injection-shell-call.yaml

. as $root
| ( ($root | scan_regex(["*.clj"]; [
      "\\(ns\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+\\(:require\\s+[\\s\\S]*?\\s+\\[clojure\\.java\\.shell\\s+[\\s\\S]*?\\s+\\[sh\\]\\]\\s+[\\s\\S]*?\\s+\\)\\)\\s+[\\s\\S]*?",
      "\\(ns\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+\\(:use\\s+[\\s\\S]*?\\s+\\[clojure\\.java\\.shell\\s+[\\s\\S]*?\\s+\\[sh\\]\\]\\s+[\\s\\S]*?\\s+\\)\\)\\s+[\\s\\S]*?",
      "\\(sh\\s+\"[\\s\\S]*?\"\\s+[\\s\\S]*?\\)",
      "\\(sh\\s+(?P<ARG>\\S+)\\s+[\\s\\S]*?\\)",
      "\\(sh\\s+(?P<BASH>\\S+)\\s+[\\s\\S]*?\\)"
    ])) as $all
    | ( ($all
          | in_files_with($all | of(["\\(ns\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+\\(:require\\s+[\\s\\S]*?\\s+\\[clojure\\.java\\.shell\\s+[\\s\\S]*?\\s+\\[sh\\]\\]\\s+[\\s\\S]*?\\s+\\)\\)\\s+[\\s\\S]*?"])))
          + ($all
          | in_files_with($all | of(["\\(ns\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+\\(:use\\s+[\\s\\S]*?\\s+\\[clojure\\.java\\.shell\\s+[\\s\\S]*?\\s+\\[sh\\]\\]\\s+[\\s\\S]*?\\s+\\)\\)\\s+[\\s\\S]*?"])))
          | at_same_place((($all | of(["\\(sh\\s+(?P<BASH>\\S+)\\s+[\\s\\S]*?\\)"])
          | where_capture("BASH"; "^(?:(.*)(sh|bash|ksh|csh|tcsh|zsh))"))
          + ($all | of(["\\(sh\\s+(?P<ARG>\\S+)\\s+[\\s\\S]*?\\)"])
          | not_at($all | of(["\\(sh\\s+\"[\\s\\S]*?\"\\s+[\\s\\S]*?\\)"])))))
        | finding("command-injection-shell-call";
            "A call to clojure.java.shell has been found, this could lead to an RCE if the inputs are user-controllable.") ) )
| report
