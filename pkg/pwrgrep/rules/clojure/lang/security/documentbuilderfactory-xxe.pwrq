# rules: documentbuilderfactory-xxe
# from: clojure/lang/security/documentbuilderfactory-xxe.yaml

. as $root
| ( ($root | scan_regex(["*.clj"]; [
      "\\(\\.setFeature\\s+\"http:\\/\\/apache\\.org\\/xml\\/features\\/disallow\\-doctype\\-decl\"\\s+false\\)",
      "\\(clojure\\.xml\\/parse\\s+(?P<INPUT>\\S+)\\)",
      "\\(def\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+\\(\\s+[\\s\\S]*?\\s+\\)\\)",
      "\\(defn\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+\\(\\s+[\\s\\S]*?\\s+\\)\\)",
      "\\(doto\\s+\\(javax\\.xml\\.parsers\\.SAXParserFactory\\/newInstance\\)\\s+[\\s\\S]*?\\)",
      "\\(doto\\s+\\(javax\\.xml\\.parsers\\.SAXParserFactory\\/newInstance\\)\\s+[\\s\\S]*?\\s+\\(\\.setFeature\\s+\"http:\\/\\/xml\\.org\\/sax\\/features\\/external\\-general\\-entities\"\\s+false\\)\\s+[\\s\\S]*?\\s+\\(\\.setFeature\\s+\"http:\\/\\/xml\\.org\\/sax\\/features\\/external\\-parameter\\-entities\"\\s+false\\)\\s+[\\s\\S]*?\\)",
      "\\(doto\\s+\\(javax\\.xml\\.parsers\\.SAXParserFactory\\/newInstance\\)\\s+[\\s\\S]*?\\s+\\(\\.setFeature\\s+\"http:\\/\\/xml\\.org\\/sax\\/features\\/external\\-parameter\\-entities\"\\s+false\\)\\s+[\\s\\S]*?\\s+\\(\\.setFeature\\s+\"http:\\/\\/xml\\.org\\/sax\\/features\\/external\\-general\\-entities\"\\s+false\\)\\s+[\\s\\S]*?\\)",
      "\\(ns\\s+[\\s\\S]*?\\s+\\(:require\\s+\\[clojure\\.xml\\s+:as\\s+[\\s\\S]*?\\]\\)\\)\\s+[\\s\\S]*?"
    ])) as $all
    | ( ($all
          | within($all | of(["\\(def\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+\\(\\s+[\\s\\S]*?\\s+\\)\\)"])))
          + ($all
          | within($all | of(["\\(defn\\s+[\\s\\S]*?\\s+[\\s\\S]*?\\s+\\(\\s+[\\s\\S]*?\\s+\\)\\)"])))
          | at_same_place((($all | of(["\\(clojure\\.xml\\/parse\\s+(?P<INPUT>\\S+)\\)"]))
          + ($all | of(["\\(\\.setFeature\\s+\"http:\\/\\/apache\\.org\\/xml\\/features\\/disallow\\-doctype\\-decl\"\\s+false\\)"])
          | within($all | of(["\\(doto\\s+\\(javax\\.xml\\.parsers\\.SAXParserFactory\\/newInstance\\)\\s+[\\s\\S]*?\\)"]))
          | outside($all | of(["\\(doto\\s+\\(javax\\.xml\\.parsers\\.SAXParserFactory\\/newInstance\\)\\s+[\\s\\S]*?\\s+\\(\\.setFeature\\s+\"http:\\/\\/xml\\.org\\/sax\\/features\\/external\\-general\\-entities\"\\s+false\\)\\s+[\\s\\S]*?\\s+\\(\\.setFeature\\s+\"http:\\/\\/xml\\.org\\/sax\\/features\\/external\\-parameter\\-entities\"\\s+false\\)\\s+[\\s\\S]*?\\)"]))
          | outside($all | of(["\\(doto\\s+\\(javax\\.xml\\.parsers\\.SAXParserFactory\\/newInstance\\)\\s+[\\s\\S]*?\\s+\\(\\.setFeature\\s+\"http:\\/\\/xml\\.org\\/sax\\/features\\/external\\-parameter\\-entities\"\\s+false\\)\\s+[\\s\\S]*?\\s+\\(\\.setFeature\\s+\"http:\\/\\/xml\\.org\\/sax\\/features\\/external\\-general\\-entities\"\\s+false\\)\\s+[\\s\\S]*?\\)"])))))
          | in_files_with($all | of(["\\(ns\\s+[\\s\\S]*?\\s+\\(:require\\s+\\[clojure\\.xml\\s+:as\\s+[\\s\\S]*?\\]\\)\\)\\s+[\\s\\S]*?"]))
        | finding("documentbuilderfactory-xxe";
            "DOCTYPE declarations are enabled for javax.xml.parsers.SAXParserFactory.") ) )
| report
