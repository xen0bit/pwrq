# rules: use-of-sha1
# from: clojure/lang/security/use-of-sha1.yaml

. as $root
| ( ($root | scan_ast(["*.clj"]; [
      "(MessageDigest/getInstance $ALGO)",
      "(java.security.MessageDigest/getInstance $ALGO)"
    ])) as $all
    | ( $all | of(["(MessageDigest/getInstance $ALGO)","(java.security.MessageDigest/getInstance $ALGO)"])
          | where_capture("ALGO"; "(((org\\.apache\\.commons\\.codec\\.digest\\.)?MessageDigestAlgorithms/)?\"?(SHA-1|SHA1)\"?)")
        | finding("use-of-sha1";
            "Detected SHA1 hash algorithm which is considered insecure.") ) )
| report
