# rules: read-string-unsafe
# languages: clojure
# from: clojure/security/clojure-read-string/read-string-unsafe.yaml

. as $root
| ( ($root | scan_ast(["*.clj"]; [
      "(defn $VAR [$X]$$$_)",
      "(ns $$$_\n($$$_ :exclude [read read-string]))\n$$$_\n(defn $VAR [$X]$$$_)",
      "(read-string $X)"
    ])) as $all
    | ( $all | of(["(read-string $X)"])
          | outside($all | of(["(ns $$$_\n($$$_ :exclude [read read-string]))\n$$$_\n(defn $VAR [$X]$$$_)"]))
          | within($all | of(["(defn $VAR [$X]$$$_)"]))
        | finding("read-string-unsafe";
            "The default core Clojure read-string method is dangerous and can lead to deserialization vulnerabilities.") ) )
| report
