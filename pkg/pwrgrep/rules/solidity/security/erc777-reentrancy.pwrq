# rules: erc777-reentrancy
# languages: solidity
# from: solidity/security/erc777-reentrancy.yaml

. as $root
| ( ($root | scan_ast(["*.sol"]; [
      "$X.tokensReceived($$$_);"
    ])) as $all
    | ( $all | of(["$X.tokensReceived($$$_);"])
        | finding("erc777-reentrancy";
            "ERC777 tokensReceived() reentrancy") ) )
| report
