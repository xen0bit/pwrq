# rules: arbitrary-low-level-call
# languages: solidity
# from: solidity/security/arbitrary-low-level-call.yaml

. as $root
| ( ($root | scan_ast(["*.sol"]; [
      "$ADDR.call($DATA);",
      "$ADDR.call{$VALUE:$$$_, $GAS:$$$_}($DATA);",
      "$ADDR.call{$VALUE:$$$_}($DATA);",
      "function $F($$$_, address $ADDR, $$$_, bytes calldata $DATA, $$$_) external { $$$_ }",
      "function $F($$$_, address $ADDR, $$$_, bytes calldata $DATA, $$$_) public { $$$_ }"
    ])) as $all
    | ( ($all
          | within($all | of(["function $F($$$_, address $ADDR, $$$_, bytes calldata $DATA, $$$_) external { $$$_ }"])))
          + ($all
          | within($all | of(["function $F($$$_, address $ADDR, $$$_, bytes calldata $DATA, $$$_) public { $$$_ }"])))
          | at_same_place(($all | of(["$ADDR.call($DATA);","$ADDR.call{$VALUE:$$$_}($DATA);","$ADDR.call{$VALUE:$$$_, $GAS:$$$_}($DATA);"])))
        | finding("arbitrary-low-level-call";
            "An attacker may perform call() to an arbitrary address with controlled calldata") ) )
| report
