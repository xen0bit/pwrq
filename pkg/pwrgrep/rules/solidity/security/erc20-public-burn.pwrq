# rules: erc20-public-burn
# from: solidity/security/erc20-public-burn.yaml

. as $root
| ( ($root | scan_ast(["*.sol"]; [
      "function burn($$$_) $M { $$$_ }",
      "function burn($$$_) $M($$$_) { $$$_ }",
      "function burn($$$_) external { \n    _burn($ACCOUNT, $AMOUNT);\n }",
      "function burn($$$_) public { \n    _burn($ACCOUNT, $AMOUNT);\n }",
      "function burn($$$_) {\n  _burn(_msgSender(), $$$_);\n}",
      "function burn($$$_) {\n  _burn(_tokenId, $$$_);\n}",
      "function burn($$$_) {\n  _burn(msg.sender, $$$_);\n}",
      "function burn($$$_) {\n  _burn(tokenId, $$$_);\n}"
    ])) as $all
    | ( $all | of(["function burn($$$_) public { \n    _burn($ACCOUNT, $AMOUNT);\n }","function burn($$$_) external { \n    _burn($ACCOUNT, $AMOUNT);\n }"])
          | not_at($all | of(["function burn($$$_) $M { $$$_ }"]))
          | not_at($all | of(["function burn($$$_) $M($$$_) { $$$_ }"]))
          | not_at($all | of(["function burn($$$_) {\n  _burn(msg.sender, $$$_);\n}"]))
          | not_at($all | of(["function burn($$$_) {\n  _burn(_msgSender(), $$$_);\n}"]))
          | not_at($all | of(["function burn($$$_) {\n  _burn(tokenId, $$$_);\n}"]))
          | not_at($all | of(["function burn($$$_) {\n  _burn(_tokenId, $$$_);\n}"]))
        | finding("erc20-public-burn";
            "Anyone can burn tokens of other accounts") ) )
| report
