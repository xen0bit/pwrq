# rules: unrestricted-transferownership
# languages: solidity
# from: solidity/security/unrestricted-transferownership.yaml

. as $root
| ( ($root | scan_ast(["*.sol"]; [
      "function transferOwnership(address $X) $M {$$$_}",
      "function transferOwnership(address $X) $M($$$_) {$$$_}",
      "function transferOwnership(address $X) external {$$$_}",
      "function transferOwnership(address $X) public {$$$_}",
      "function transferOwnership(address $X) {\n  $$$_\n  $C._enforceIsContractOwner($$$_);\n  $$$_\n}",
      "function transferOwnership(address $X) {\n  $$$_\n  $C._enforceOwner($$$_);\n  $$$_\n}",
      "function transferOwnership(address $X) {\n  $$$_\n  $C.enforceIsContractOwner($$$_);\n  $$$_\n}",
      "function transferOwnership(address $X) {\n  $$$_\n  _requireOwnership($$$_);\n  $$$_\n}",
      "function transferOwnership(address $X) {\n  $$$_\n  if ($PWRQDEEP1) {\n    $$$_\n  }\n  $$$_\n}",
      "function transferOwnership(address $X) {\n  $$$_\n  onlyOwner($$$_);\n  $$$_\n}",
      "function transferOwnership(address $X) {\n  $$$_\n  require($PWRQDEEP1, $$$_);\n  $$$_\n}",
      "function transferOwnership(address $X) {\n  $$$_\n  requireOwner($$$_);\n  $$$_\n}",
      "function transferOwnership(address $X) {}"
    ])) as $all
    | ( $all | of(["function transferOwnership(address $X) public {$$$_}","function transferOwnership(address $X) external {$$$_}"])
          | not_at($all | of(["function transferOwnership(address $X) $M {$$$_}"]))
          | not_at($all | of(["function transferOwnership(address $X) $M($$$_) {$$$_}"]))
          | not_at($all | of(["function transferOwnership(address $X) {\n  $$$_\n  require($PWRQDEEP1, $$$_);\n  $$$_\n}"])
          | where_capture_ast("PWRQDEEP1"; "msg.sender"))
          | not_at($all | of(["function transferOwnership(address $X) {\n  $$$_\n  require($PWRQDEEP1, $$$_);\n  $$$_\n}"])
          | where_capture_ast("PWRQDEEP1"; "_msgSender"))
          | not_at($all | of(["function transferOwnership(address $X) {\n  $$$_\n  if ($PWRQDEEP1) {\n    $$$_\n  }\n  $$$_\n}"])
          | where_capture_ast("PWRQDEEP1"; "msg.sender"))
          | not_at($all | of(["function transferOwnership(address $X) {\n  $$$_\n  if ($PWRQDEEP1) {\n    $$$_\n  }\n  $$$_\n}"])
          | where_capture_ast("PWRQDEEP1"; "_msgSender"))
          | not_at($all | of(["function transferOwnership(address $X) {\n  $$$_\n  onlyOwner($$$_);\n  $$$_\n}"]))
          | not_at($all | of(["function transferOwnership(address $X) {\n  $$$_\n  requireOwner($$$_);\n  $$$_\n}"]))
          | not_at($all | of(["function transferOwnership(address $X) {\n  $$$_\n  _requireOwnership($$$_);\n  $$$_\n}"]))
          | not_at($all | of(["function transferOwnership(address $X) {\n  $$$_\n  $C._enforceIsContractOwner($$$_);\n  $$$_\n}"]))
          | not_at($all | of(["function transferOwnership(address $X) {\n  $$$_\n  $C._enforceOwner($$$_);\n  $$$_\n}"]))
          | not_at($all | of(["function transferOwnership(address $X) {\n  $$$_\n  $C.enforceIsContractOwner($$$_);\n  $$$_\n}"]))
          | not_at($all | of(["function transferOwnership(address $X) {}"]))
        | finding("unrestricted-transferownership";
            "Unrestricted transferOwnership") ) )
| report
