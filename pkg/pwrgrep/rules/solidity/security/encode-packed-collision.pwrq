# rules: encode-packed-collision
# languages: solidity
# from: solidity/security/encode-packed-collision.yaml

. as $root
| ( ($root | scan_ast(["*.sol"]; [
      "$X = abi.encodePacked($$$_, $A, $B, $$$_);\n$$$_\nkeccak256($X);",
      "function $F($$$_, address[] $A, $$$_, address[] $B, $$$_) external {\n  $$$_\n}",
      "function $F($$$_, address[] $A, $$$_, address[] $B, $$$_) public {\n  $$$_\n}",
      "function $F($$$_, bytes $A, $$$_, bytes $B, $$$_) external {\n  $$$_\n}",
      "function $F($$$_, bytes $A, $$$_, bytes $B, $$$_) public {\n  $$$_\n}",
      "function $F($$$_, bytes $A, $$$_, string $B, $$$_) external {\n  $$$_\n}",
      "function $F($$$_, bytes $A, $$$_, string $B, $$$_) public {\n  $$$_\n}",
      "function $F($$$_, string $A, $$$_, bytes $B, $$$_) external {\n  $$$_\n}",
      "function $F($$$_, string $A, $$$_, bytes $B, $$$_) public {\n  $$$_\n}",
      "function $F($$$_, string $A, $$$_, string $B, $$$_) external {\n  $$$_\n}",
      "function $F($$$_, string $A, $$$_, string $B, $$$_) public {\n  $$$_\n}",
      "function $F($$$_, uint256[] $A, $$$_, uint256[] $B, $$$_) external {\n  $$$_\n}",
      "function $F($$$_, uint256[] $A, $$$_, uint256[] $B, $$$_) public {\n  $$$_\n}",
      "keccak256(abi.encodePacked($$$_, $A, $B, $$$_))"
    ])) as $all
    | ( ($all
          | within($all | of(["function $F($$$_, bytes $A, $$$_, bytes $B, $$$_) public {\n  $$$_\n}"])))
          + ($all
          | within($all | of(["function $F($$$_, string $A, $$$_, string $B, $$$_) public {\n  $$$_\n}"])))
          + ($all
          | within($all | of(["function $F($$$_, bytes $A, $$$_, string $B, $$$_) public {\n  $$$_\n}"])))
          + ($all
          | within($all | of(["function $F($$$_, string $A, $$$_, bytes $B, $$$_) public {\n  $$$_\n}"])))
          + ($all
          | within($all | of(["function $F($$$_, address[] $A, $$$_, address[] $B, $$$_) public {\n  $$$_\n}"])))
          + ($all
          | within($all | of(["function $F($$$_, uint256[] $A, $$$_, uint256[] $B, $$$_) public {\n  $$$_\n}"])))
          + ($all
          | within($all | of(["function $F($$$_, bytes $A, $$$_, bytes $B, $$$_) external {\n  $$$_\n}"])))
          + ($all
          | within($all | of(["function $F($$$_, string $A, $$$_, string $B, $$$_) external {\n  $$$_\n}"])))
          + ($all
          | within($all | of(["function $F($$$_, bytes $A, $$$_, string $B, $$$_) external {\n  $$$_\n}"])))
          + ($all
          | within($all | of(["function $F($$$_, string $A, $$$_, bytes $B, $$$_) external {\n  $$$_\n}"])))
          + ($all
          | within($all | of(["function $F($$$_, address[] $A, $$$_, address[] $B, $$$_) external {\n  $$$_\n}"])))
          + ($all
          | within($all | of(["function $F($$$_, uint256[] $A, $$$_, uint256[] $B, $$$_) external {\n  $$$_\n}"])))
          | at_same_place(($all | of(["keccak256(abi.encodePacked($$$_, $A, $B, $$$_))","$X = abi.encodePacked($$$_, $A, $B, $$$_);\n$$$_\nkeccak256($X);"])))
        | finding("encode-packed-collision";
            "abi.encodePacked hash collision with variable length arguments in $F()") ) )
| report
