# rules: balancer-readonly-reentrancy-getpooltokens
# from: solidity/security/balancer-readonly-reentrancy-getpooltokens.yaml

. as $root
| ( ($root | scan_regex(["*.sol"]; [
      "contract\\s+(?P<C>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+function\\s+(?P<CHECKFUNC>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<VAULT>\\S+)\\.manageUserBalance\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+function\\s+(?P<F>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<CHECKFUNC>\\S+)\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+(?P<RETURN>\\S+)\\s+=\\s+(?P<VAULT>\\S+)\\.getPoolTokens\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}",
      "contract\\s+(?P<C>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+function\\s+(?P<CHECKFUNC>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<VAULT>\\S+)\\.manageUserBalance\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+function\\s+(?P<F>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<RETURN>\\S+)\\s+=\\s+(?P<VAULT>\\S+)\\.getPoolTokens\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+(?P<CHECKFUNC>\\S+)\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}",
      "contract\\s+(?P<C>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+function\\s+(?P<CHECKFUNC>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+VaultReentrancyLib\\.ensureNotInVaultContext\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+function\\s+(?P<F>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<CHECKFUNC>\\S+)\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+(?P<RETURN>\\S+)\\s+=\\s+(?P<VAULT>\\S+)\\.getPoolTokens\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}",
      "contract\\s+(?P<C>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+function\\s+(?P<CHECKFUNC>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+VaultReentrancyLib\\.ensureNotInVaultContext\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+function\\s+(?P<F>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<RETURN>\\S+)\\s+=\\s+(?P<VAULT>\\S+)\\.getPoolTokens\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+(?P<CHECKFUNC>\\S+)\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}",
      "contract\\s+BalancerQueries\\s+\\{\\s+[\\s\\S]*?\\s+\\}",
      "contract\\s+BaseWeightedPool\\s+\\{\\s+[\\s\\S]*?\\s+\\}",
      "contract\\s+ComposableStablePoolStorage\\s+\\{\\s+[\\s\\S]*?\\s+\\}",
      "contract\\s+ComposableStablePool\\s+\\{\\s+[\\s\\S]*?\\s+\\}",
      "contract\\s+LinearPool\\s+\\{\\s+[\\s\\S]*?\\s+\\}",
      "contract\\s+ManagedPool\\s+\\{\\s+[\\s\\S]*?\\s+\\}",
      "contract\\s+RecoveryModeHelper\\s+\\{\\s+[\\s\\S]*?\\s+\\}",
      "function\\s+(?P<F>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<RETURN>\\S+)\\s+=\\s+(?P<VAULT>\\S+)\\.getPoolTokens\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}",
      "function\\s+(?P<F>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<VAULT>\\S+)\\.manageUserBalance\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}",
      "function\\s+(?P<F>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+VaultReentrancyLib\\.ensureNotInVaultContext\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}"
    ])) as $all
    | ( $all | of(["function\\s+(?P<F>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<RETURN>\\S+)\\s+=\\s+(?P<VAULT>\\S+)\\.getPoolTokens\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}"])
          | where_capture_ast("RETURN"; "\\.\\*uint256\\\\\\[\\]\\.\\*")
          | outside($all | of(["contract\\s+(?P<C>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+function\\s+(?P<CHECKFUNC>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+VaultReentrancyLib\\.ensureNotInVaultContext\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+function\\s+(?P<F>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<CHECKFUNC>\\S+)\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+(?P<RETURN>\\S+)\\s+=\\s+(?P<VAULT>\\S+)\\.getPoolTokens\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}"]))
          | outside($all | of(["contract\\s+(?P<C>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+function\\s+(?P<CHECKFUNC>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+VaultReentrancyLib\\.ensureNotInVaultContext\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+function\\s+(?P<F>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<RETURN>\\S+)\\s+=\\s+(?P<VAULT>\\S+)\\.getPoolTokens\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+(?P<CHECKFUNC>\\S+)\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}"]))
          | outside($all | of(["contract\\s+(?P<C>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+function\\s+(?P<CHECKFUNC>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<VAULT>\\S+)\\.manageUserBalance\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+function\\s+(?P<F>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<RETURN>\\S+)\\s+=\\s+(?P<VAULT>\\S+)\\.getPoolTokens\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+(?P<CHECKFUNC>\\S+)\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}"]))
          | outside($all | of(["contract\\s+(?P<C>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+function\\s+(?P<CHECKFUNC>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<VAULT>\\S+)\\.manageUserBalance\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+function\\s+(?P<F>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<CHECKFUNC>\\S+)\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+(?P<RETURN>\\S+)\\s+=\\s+(?P<VAULT>\\S+)\\.getPoolTokens\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}"]))
          | not_at($all | of(["function\\s+(?P<F>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+VaultReentrancyLib\\.ensureNotInVaultContext\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}"]))
          | not_at($all | of(["function\\s+(?P<F>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<VAULT>\\S+)\\.manageUserBalance\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}"]))
          | outside($all | of(["contract\\s+LinearPool\\s+\\{\\s+[\\s\\S]*?\\s+\\}"]))
          | outside($all | of(["contract\\s+ComposableStablePool\\s+\\{\\s+[\\s\\S]*?\\s+\\}"]))
          | outside($all | of(["contract\\s+BalancerQueries\\s+\\{\\s+[\\s\\S]*?\\s+\\}"]))
          | outside($all | of(["contract\\s+ManagedPool\\s+\\{\\s+[\\s\\S]*?\\s+\\}"]))
          | outside($all | of(["contract\\s+BaseWeightedPool\\s+\\{\\s+[\\s\\S]*?\\s+\\}"]))
          | outside($all | of(["contract\\s+ComposableStablePoolStorage\\s+\\{\\s+[\\s\\S]*?\\s+\\}"]))
          | outside($all | of(["contract\\s+RecoveryModeHelper\\s+\\{\\s+[\\s\\S]*?\\s+\\}"]))
          | focus("VAULT")
        | finding("balancer-readonly-reentrancy-getpooltokens";
            "$VAULT.getPoolTokens() call on a Balancer pool is not protected from the read-only reentrancy.") ) )
| report
