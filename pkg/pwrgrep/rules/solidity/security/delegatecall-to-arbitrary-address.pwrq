# rules: delegatecall-to-arbitrary-address
# languages: solidity
# from: solidity/security/delegatecall-to-arbitrary-address.yaml

. as $root
| ( ($root | scan_ast(["*.sol"]; [
      "$CONTRACT.delegatecall($$$_);",
      "$CONTRACT.delegatecall{gas:$GAS}($$$_);",
      "address(this).delegatecall($$$_);",
      "constructor($$$_) { $$$_ }",
      "function $ANY($$$_) $M { $$$_ }",
      "function $ANY($$$_) $M($$$_) { $$$_ }",
      "function $ANY($$$_, address $CONTRACT, $$$_) external {$$$_}",
      "function $ANY($$$_, address $CONTRACT, $$$_) public {$$$_}",
      "function $ANY($$$_, address payable $CONTRACT, $$$_) external {$$$_}",
      "function $ANY($$$_, address payable $CONTRACT, $$$_) public {$$$_}",
      "if($PWRQDEEP1) revert($$$_);\n$$$_",
      "require($PWRQDEEP1, $$$_);\n$$$_"
    ])) as $all
    | ( (($all | of(["$CONTRACT.delegatecall($$$_);","$CONTRACT.delegatecall{gas:$GAS}($$$_);"])
          | in_files_without($all | of(["require($PWRQDEEP1, $$$_);\n$$$_"]))
          | in_files_without($all | of(["require($PWRQDEEP1, $$$_);\n$$$_"]))
          | in_files_without($all | of(["if($PWRQDEEP1) revert($$$_);\n$$$_"]))
          | in_files_without($all | of(["if($PWRQDEEP1) revert($$$_);\n$$$_"]))
          | not_at($all | of(["address(this).delegatecall($$$_);"]))))
          | reaching((($all | of(["function $ANY($$$_, address $CONTRACT, $$$_) public {$$$_}","function $ANY($$$_, address $CONTRACT, $$$_) external {$$$_}","function $ANY($$$_, address payable $CONTRACT, $$$_) public {$$$_}","function $ANY($$$_, address payable $CONTRACT, $$$_) external {$$$_}"])
          | not_at($all | of(["constructor($$$_) { $$$_ }"]))
          | not_at($all | of(["function $ANY($$$_) $M { $$$_ }"]))
          | not_at($all | of(["function $ANY($$$_) $M($$$_) { $$$_ }"]))
          | focus("CONTRACT")));
              ([]))
        | finding("delegatecall-to-arbitrary-address";
            "An attacker may perform delegatecall() to an arbitrary address.") ) )
| report
