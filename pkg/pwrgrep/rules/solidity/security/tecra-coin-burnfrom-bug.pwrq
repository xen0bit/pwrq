# rules: tecra-coin-burnfrom-bug
# languages: solidity
# from: solidity/security/tecra-coin-burnfrom-bug.yaml

. as $root
| ( ($root | scan_ast(["*.sol"]; [
      "function $BURN($$$_, address $FROM, $$$_) {\n    $$$_\n    _burn($FROM, $$$_);\n    $$$_\n}",
      "require(_allowances[$S][$FROM] >= $X, $$$_)",
      "require(allowance($S, $FROM) >= $X, $$$_)"
    ])) as $all
    | ( $all | of(["require(_allowances[$S][$FROM] >= $X, $$$_)","require(allowance($S, $FROM) >= $X, $$$_)"])
          | within($all | of(["function $BURN($$$_, address $FROM, $$$_) {\n    $$$_\n    _burn($FROM, $$$_);\n    $$$_\n}"]))
        | finding("tecra-coin-burnfrom-bug";
            "Parameter \"from\" is checked at incorrect position in \"_allowances\" mapping") ) )
| report
