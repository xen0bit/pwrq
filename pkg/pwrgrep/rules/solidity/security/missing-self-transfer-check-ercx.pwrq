# rules: missing-self-transfer-check-ercx
# languages: solidity
# from: solidity/security/missing-self-transfer-check-ercx.yaml

. as $root
| ( ($root | scan_ast(["*.sol"]; [
      "_balances[$FROM] = $FROM_BALANCE - value;",
      "_balances[$TO] = $TO_BALANCE + value;",
      "function _update(address $FROM, address $TO, uint256 value, bool mint) internal virtual {\n  $$$_\n}",
      "if ($FROM != $TO) {\n  $$$_\n  _balances[$FROM] = $FROM_BALANCE - value;\n  $$$_\n  _balances[$TO] = $TO_BALANCE + value;\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["_balances[$FROM] = $FROM_BALANCE - value;","_balances[$TO] = $TO_BALANCE + value;"])
          | outside($all | of(["if ($FROM != $TO) {\n  $$$_\n  _balances[$FROM] = $FROM_BALANCE - value;\n  $$$_\n  _balances[$TO] = $TO_BALANCE + value;\n  $$$_\n}"]))
          | within($all | of(["function _update(address $FROM, address $TO, uint256 value, bool mint) internal virtual {\n  $$$_\n}"]))
        | finding("missing-self-transfer-check-ercx";
            "Missing check for 'from' and 'to' being the same before updating balances could lead to incorrect balance manipulation on self-transfers.") ) )
| report
