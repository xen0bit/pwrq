# rules: no-bidi-characters
# from: solidity/security/no-bidi-characters.yaml

. as $root
| ( ($root | scan_regex(["*.sol"]; [
      "‪",
      "‫",
      "‬",
      "‭",
      "‮",
      "⁦",
      "⁧",
      "⁨",
      "⁩"
    ])) as $all
    | ( $all | of(["‪","‫","‭","‮","⁦","⁧","⁨","‬","⁩"])
        | finding("no-bidi-characters";
            "The code must not contain any of Unicode Direction Control Characters") ) )
| report
