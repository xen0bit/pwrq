# rules: no-slippage-check
# languages: solidity
# from: solidity/security/no-slippage-check.yaml

. as $root
| ( ($root | scan_ast(["*.sol"]; [
      "$X.exactInputSingle($SWAPROUTER.ExactInputSingleParams({\n  tokenIn: $A,\n  tokenOut: $B,\n  fee: $C,\n  recipient: $D,\n  deadline: $E,\n  amountIn: $F,\n  amountOutMinimum: $LIMIT,\n  sqrtPriceLimitX96: 0\n}));",
      "$X.exactOutputSingle($SWAPROUTER.ExactOutputSingleParams({\n  tokenIn: $A,\n  tokenOut: $B,\n  fee: $C,\n  recipient: $D,\n  deadline: $E,\n  amountOut: $F,\n  amountInMaximum: $LIMIT,\n  sqrtPriceLimitX96: 0\n}));",
      "$X.swap($RECIPIENT, $ZEROFORONE, $AMOUNTIN, $LIMIT, $DATA)",
      "$X.swapExactETHForTokensSupportingFeeOnTransferTokens{$VALUE:$$$_}($LIMIT, $A, $B, $C)",
      "$X.swapExactETHForTokens{$VALUE:$$$_}($LIMIT, $A, $B, $C)",
      "$X.swapExactTokensForETH($A, $LIMIT, $B, $C, $D)",
      "$X.swapExactTokensForETHSupportingFeeOnTransferTokens($A, $LIMIT, $B, $C, $D)",
      "$X.swapExactTokensForTokens($A, $LIMIT, $B, $C, $D)",
      "$X.swapExactTokensForTokensSupportingFeeOnTransferTokens($A, $LIMIT, $B, $C, $D)",
      "$X.swapTokensForExactETH($A, $LIMIT, $B, $C, $D)",
      "$X.swapTokensForExactTokens($A, $LIMIT, $B, $C, $D)",
      "function $FUNC($$$_) {\n  $$$_\n  $Y = $SWAPROUTER.ExactInputSingleParams({\n    tokenIn: $A, \n    tokenOut: $B, \n    fee: $C, \n    recipient: $D, \n    deadline: $E, \n    amountIn: $F, \n    amountOutMinimum: $LIMIT, \n    sqrtPriceLimitX96: 0\n  });\n  $$$_\n  $X.exactInputSingle($Y);\n  $$$_\n}",
      "function $FUNC($$$_) {\n  $$$_\n  $Y = $SWAPROUTER.ExactOutputSingleParams({\n    tokenIn: $A,\n    tokenOut: $B,\n    fee: $C,\n    recipient: $D,\n    deadline: $E,\n    amountOut: $F,\n    amountInMaximum: $LIMIT,\n    sqrtPriceLimitX96: 0\n  });\n  $$$_\n  $X.exactOutputSingle($Y);\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["$X.swapExactTokensForTokens($A, $LIMIT, $B, $C, $D)","$X.swapExactTokensForTokensSupportingFeeOnTransferTokens($A, $LIMIT, $B, $C, $D)","$X.swapExactTokensForETH($A, $LIMIT, $B, $C, $D)","$X.swapExactTokensForETHSupportingFeeOnTransferTokens($A, $LIMIT, $B, $C, $D)","$X.swapExactETHForTokens{$VALUE:$$$_}($LIMIT, $A, $B, $C)","$X.swapExactETHForTokensSupportingFeeOnTransferTokens{$VALUE:$$$_}($LIMIT, $A, $B, $C)","$X.swapTokensForExactTokens($A, $LIMIT, $B, $C, $D)","$X.swapTokensForExactETH($A, $LIMIT, $B, $C, $D)","function $FUNC($$$_) {\n  $$$_\n  $Y = $SWAPROUTER.ExactInputSingleParams({\n    tokenIn: $A, \n    tokenOut: $B, \n    fee: $C, \n    recipient: $D, \n    deadline: $E, \n    amountIn: $F, \n    amountOutMinimum: $LIMIT, \n    sqrtPriceLimitX96: 0\n  });\n  $$$_\n  $X.exactInputSingle($Y);\n  $$$_\n}","$X.exactInputSingle($SWAPROUTER.ExactInputSingleParams({\n  tokenIn: $A,\n  tokenOut: $B,\n  fee: $C,\n  recipient: $D,\n  deadline: $E,\n  amountIn: $F,\n  amountOutMinimum: $LIMIT,\n  sqrtPriceLimitX96: 0\n}));","function $FUNC($$$_) {\n  $$$_\n  $Y = $SWAPROUTER.ExactOutputSingleParams({\n    tokenIn: $A,\n    tokenOut: $B,\n    fee: $C,\n    recipient: $D,\n    deadline: $E,\n    amountOut: $F,\n    amountInMaximum: $LIMIT,\n    sqrtPriceLimitX96: 0\n  });\n  $$$_\n  $X.exactOutputSingle($Y);\n  $$$_\n}","$X.exactOutputSingle($SWAPROUTER.ExactOutputSingleParams({\n  tokenIn: $A,\n  tokenOut: $B,\n  fee: $C,\n  recipient: $D,\n  deadline: $E,\n  amountOut: $F,\n  amountInMaximum: $LIMIT,\n  sqrtPriceLimitX96: 0\n}));","$X.swap($RECIPIENT, $ZEROFORONE, $AMOUNTIN, $LIMIT, $DATA)"])
          | where_capture("LIMIT"; "^(0)|(0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff)|(type\\(uint(256)?\\)\\.max)|(uint(256)?\\(-1)|(115792089237316195423570985008687907853269984665640564039457584007913129639935)|(2\\s?\\*\\*\\s?256\\s?-\\s?1)$")
        | finding("no-slippage-check";
            "No slippage check in a Uniswap v2/v3 trade") ) )
| report
