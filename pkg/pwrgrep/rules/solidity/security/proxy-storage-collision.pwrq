# rules: proxy-storage-collision
# from: solidity/security/proxy-storage-collision.yaml

. as $root
| ( ($root | scan_regex(["*.sol"]; [
      "contract\\s+(?P<CONTRACT>\\S+)\\s+is\\s+[\\s\\S]*?,\\s+(?P<PROXY>\\S+),\\s+[\\s\\S]*?\\s+\\{\\s+(?P<TYPE>\\S+)\\s+constant\\s+(?P<VAR>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+constructor\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}",
      "contract\\s+(?P<CONTRACT>\\S+)\\s+is\\s+[\\s\\S]*?,\\s+(?P<PROXY>\\S+),\\s+[\\s\\S]*?\\s+\\{\\s+(?P<TYPE>\\S+)\\s+immutable\\s+(?P<VAR>\\S+);\\s+[\\s\\S]*?\\s+constructor\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}",
      "contract\\s+(?P<CONTRACT>\\S+)\\s+is\\s+[\\s\\S]*?,\\s+(?P<PROXY>\\S+),\\s+[\\s\\S]*?\\s+\\{\\s+(?P<TYPE>\\S+)\\s+immutable\\s+(?P<VAR>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+constructor\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}",
      "contract\\s+(?P<CONTRACT>\\S+)\\s+is\\s+[\\s\\S]*?,\\s+(?P<PROXY>\\S+),\\s+[\\s\\S]*?\\s+\\{\\s+[\\s\\S]*?\\s+(?P<TYPE>\\S+)\\s+(?P<VAR>\\S+);\\s+[\\s\\S]*?\\s+constructor\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}",
      "contract\\s+(?P<CONTRACT>\\S+)\\s+is\\s+[\\s\\S]*?,\\s+(?P<PROXY>\\S+),\\s+[\\s\\S]*?\\s+\\{\\s+[\\s\\S]*?\\s+(?P<TYPE>\\S+)\\s+(?P<VAR>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+constructor\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}"
    ])) as $all
    | ( $all | of(["contract\\s+(?P<CONTRACT>\\S+)\\s+is\\s+[\\s\\S]*?,\\s+(?P<PROXY>\\S+),\\s+[\\s\\S]*?\\s+\\{\\s+[\\s\\S]*?\\s+(?P<TYPE>\\S+)\\s+(?P<VAR>\\S+);\\s+[\\s\\S]*?\\s+constructor\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}","contract\\s+(?P<CONTRACT>\\S+)\\s+is\\s+[\\s\\S]*?,\\s+(?P<PROXY>\\S+),\\s+[\\s\\S]*?\\s+\\{\\s+[\\s\\S]*?\\s+(?P<TYPE>\\S+)\\s+(?P<VAR>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+constructor\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}"])
          | not_at($all | of(["contract\\s+(?P<CONTRACT>\\S+)\\s+is\\s+[\\s\\S]*?,\\s+(?P<PROXY>\\S+),\\s+[\\s\\S]*?\\s+\\{\\s+(?P<TYPE>\\S+)\\s+immutable\\s+(?P<VAR>\\S+);\\s+[\\s\\S]*?\\s+constructor\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}"]))
          | not_at($all | of(["contract\\s+(?P<CONTRACT>\\S+)\\s+is\\s+[\\s\\S]*?,\\s+(?P<PROXY>\\S+),\\s+[\\s\\S]*?\\s+\\{\\s+(?P<TYPE>\\S+)\\s+immutable\\s+(?P<VAR>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+constructor\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}"]))
          | not_at($all | of(["contract\\s+(?P<CONTRACT>\\S+)\\s+is\\s+[\\s\\S]*?,\\s+(?P<PROXY>\\S+),\\s+[\\s\\S]*?\\s+\\{\\s+(?P<TYPE>\\S+)\\s+constant\\s+(?P<VAR>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+constructor\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}"]))
          | where_capture_not("CONTRACT"; "^(?:AdminUpgradeabilityProxy|OwnedUpgrade*abilityProxy)")
          | where_capture("PROXY"; "^(?:(UpgradeabilityProxy|AdminUpgradeabilityProxy|OwnedUpgrade*abilityProxy|TransparentUpgradeableProxy|ERC1967Proxy))")
          | focus("PROXY")
        | finding("proxy-storage-collision";
            "Proxy declares a state var that may override a storage slot of the implementation") ) )
| report
