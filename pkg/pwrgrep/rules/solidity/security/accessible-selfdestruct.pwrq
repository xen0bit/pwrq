# rules: accessible-selfdestruct
# languages: solidity
# from: solidity/security/accessible-selfdestruct.yaml

. as $root
| ( ($root | scan_ast(["*.sol"]; [
      "function $FUNC($$$_) $MODIFIER { $$$_ }",
      "function $FUNC($$$_) $MODIFIER($$$_) { $$$_ }",
      "function $FUNC($$$_) {\n  $$$_\n  $C._enforceIsContractOwner($$$_);\n  $$$_\n}",
      "function $FUNC($$$_) {\n  $$$_\n  $C._enforceOwner($$$_);\n  $$$_\n}",
      "function $FUNC($$$_) {\n  $$$_\n  $C.enforceIsContractOwner($$$_);\n  $$$_\n}",
      "function $FUNC($$$_) {\n  $$$_\n  _requireOwnership($$$_);\n  $$$_\n}",
      "function $FUNC($$$_) {\n  $$$_\n  assert($PWRQDEEP1, $$$_);\n  $$$_\n}",
      "function $FUNC($$$_) {\n  $$$_\n  if ($PWRQDEEP1) {\n    $$$_\n  }\n  $$$_\n}",
      "function $FUNC($$$_) {\n  $$$_\n  onlyOwner($$$_);\n  $$$_\n}",
      "function $FUNC($$$_) {\n  $$$_\n  require($PWRQDEEP1, $$$_);\n  $$$_\n}",
      "function $FUNC($$$_) {\n  $$$_\n  requireOwner($$$_);\n  $$$_\n}",
      "function $FUNC($$$_, address $ADDR, $$$_) external { $$$_ }",
      "function $FUNC($$$_, address $ADDR, $$$_) public { $$$_ }",
      "selfdestruct($$$_);",
      "suicide($$$_);"
    ])) as $all
    | ( (($all | of(["selfdestruct($$$_);","suicide($$$_);"])))
          | reaching((($all | of(["function $FUNC($$$_, address $ADDR, $$$_) external { $$$_ }","function $FUNC($$$_, address $ADDR, $$$_) public { $$$_ }"])
          | focus("ADDR")
          | not_at($all | of(["function $FUNC($$$_) $MODIFIER { $$$_ }"]))
          | not_at($all | of(["function $FUNC($$$_) $MODIFIER($$$_) { $$$_ }"]))
          | not_at($all | of(["function $FUNC($$$_) {\n  $$$_\n  require($PWRQDEEP1, $$$_);\n  $$$_\n}"])
          | where_capture_ast("PWRQDEEP1"; "msg.sender"))
          | not_at($all | of(["function $FUNC($$$_) {\n  $$$_\n  assert($PWRQDEEP1, $$$_);\n  $$$_\n}"])
          | where_capture_ast("PWRQDEEP1"; "msg.sender"))
          | not_at($all | of(["function $FUNC($$$_) {\n  $$$_\n  require($PWRQDEEP1, $$$_);\n  $$$_\n}"])
          | where_capture_ast("PWRQDEEP1"; "_msgSender"))
          | not_at($all | of(["function $FUNC($$$_) {\n  $$$_\n  assert($PWRQDEEP1, $$$_);\n  $$$_\n}"])
          | where_capture_ast("PWRQDEEP1"; "_msgSender"))
          | not_at($all | of(["function $FUNC($$$_) {\n  $$$_\n  if ($PWRQDEEP1) {\n    $$$_\n  }\n  $$$_\n}"])
          | where_capture_ast("PWRQDEEP1"; "msg.sender"))
          | not_at($all | of(["function $FUNC($$$_) {\n  $$$_\n  if ($PWRQDEEP1) {\n    $$$_\n  }\n  $$$_\n}"])
          | where_capture_ast("PWRQDEEP1"; "_msgSender"))
          | not_at($all | of(["function $FUNC($$$_) {\n  $$$_\n  onlyOwner($$$_);\n  $$$_\n}"]))
          | not_at($all | of(["function $FUNC($$$_) {\n  $$$_\n  requireOwner($$$_);\n  $$$_\n}"]))
          | not_at($all | of(["function $FUNC($$$_) {\n  $$$_\n  _requireOwnership($$$_);\n  $$$_\n}"]))
          | not_at($all | of(["function $FUNC($$$_) {\n  $$$_\n  $C._enforceIsContractOwner($$$_);\n  $$$_\n}"]))
          | not_at($all | of(["function $FUNC($$$_) {\n  $$$_\n  $C._enforceOwner($$$_);\n  $$$_\n}"]))
          | not_at($all | of(["function $FUNC($$$_) {\n  $$$_\n  $C.enforceIsContractOwner($$$_);\n  $$$_\n}"]))));
              ([]))
        | finding("accessible-selfdestruct";
            "Contract can be destructed by anyone in $FUNC") ) )
| report
