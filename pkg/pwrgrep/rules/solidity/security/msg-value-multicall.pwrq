# rules: msg-value-multicall
# languages: solidity
# from: solidity/security/msg-value-multicall.yaml

. as $root
| ( ($root | scan_ast(["*.sol"]; [
      "contract $C is $$$_, BoringBatchable, $$$_ {\n  $$$_\n}",
      "contract $C is $$$_, Multicall, $$$_ {\n  $$$_\n}",
      "function $F($$$_) {\n  $$$_\n}",
      "msg.value"
    ])) as $all
    | ( ($all
          | within($all | of(["contract $C is $$$_, BoringBatchable, $$$_ {\n  $$$_\n}"])))
          + ($all
          | within($all | of(["contract $C is $$$_, Multicall, $$$_ {\n  $$$_\n}"])))
          | at_same_place(($all | of(["msg.value"])))
          | within($all | of(["function $F($$$_) {\n  $$$_\n}"]))
        | finding("msg-value-multicall";
            "$F with constant msg.value can be called multiple times") ) )
| report
