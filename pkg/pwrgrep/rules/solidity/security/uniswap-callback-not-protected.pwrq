# rules: uniswap-callback-not-protected
# languages: solidity
# from: solidity/security/uniswap-callback-not-protected.yaml

. as $root
| ( ($root | scan_ast(["*.sol"]; [
      "function $CALLBACK($$$_) isCallback {\n    $$$_\n}",
      "function $CALLBACK($$$_) {\n    $$$_\n    $CHECK(_msgSender() == $U.$PAIR($$$_), $$$_);\n    $$$_\n}",
      "function $CALLBACK($$$_) {\n    $$$_\n    $CHECK(msg.sender == $U.$PAIR($$$_), $$$_);\n    $$$_\n}",
      "function $CALLBACK($$$_) {\n    $$$_\n    $VALIDATION.verifyCallback($$$_);\n    $$$_\n}",
      "function $CALLBACK($$$_) {\n    $$$_\n    _verifyCallback($$$_);\n    $$$_\n}",
      "function $CALLBACK($$$_) {\n    $$$_\n    if (_msgSender() != $POOL) {\n      $$$_\n    }\n    $$$_\n}",
      "function $CALLBACK($$$_) {\n    $$$_\n    if (_msgSender() == $POOL) {\n      $$$_\n    }\n    $$$_\n}",
      "function $CALLBACK($$$_) {\n    $$$_\n    if (msg.sender != $POOL) {\n      $$$_\n    }\n    $$$_\n}",
      "function $CALLBACK($$$_) {\n    $$$_\n    if (msg.sender == $POOL) {\n      $$$_\n    }\n    $$$_\n}",
      "function $CALLBACK($$$_) {\n    $$$_\n    if(!$POOLS[_msgSender()]) {\n      $$$_\n    }\n    $$$_\n}",
      "function $CALLBACK($$$_) {\n    $$$_\n    if(!$POOLS[msg.sender]) {\n      $$$_\n    }\n    $$$_\n}",
      "function $CALLBACK($$$_) {\n    $$$_\n    require($POOL == _msgSender(), $$$_);\n    $$$_\n}",
      "function $CALLBACK($$$_) {\n    $$$_\n    require($POOL == msg.sender, $$$_);\n    $$$_\n}",
      "function $CALLBACK($$$_) {\n    $$$_\n    require($POOLS[_msgSender()], $$$_);\n    $$$_\n}",
      "function $CALLBACK($$$_) {\n    $$$_\n    require($POOLS[msg.sender], $$$_);\n    $$$_\n}",
      "function $CALLBACK($$$_) {\n    $$$_\n    require(_msgSender() == $POOL, $$$_);\n    $$$_\n}",
      "function $CALLBACK($$$_) {\n    $$$_\n    require(msg.sender == $POOL, $$$_);\n    $$$_\n}",
      "function $CALLBACK($$$_) { $$$_ }"
    ])) as $all
    | ( $all | of(["function $CALLBACK($$$_) { $$$_ }"])
          | not_at($all | of(["function $CALLBACK($$$_) {\n    $$$_\n    $VALIDATION.verifyCallback($$$_);\n    $$$_\n}"]))
          | not_at($all | of(["function $CALLBACK($$$_) {\n    $$$_\n    $CHECK(msg.sender == $U.$PAIR($$$_), $$$_);\n    $$$_\n}"]))
          | not_at($all | of(["function $CALLBACK($$$_) {\n    $$$_\n    $CHECK(_msgSender() == $U.$PAIR($$$_), $$$_);\n    $$$_\n}"]))
          | not_at($all | of(["function $CALLBACK($$$_) {\n    $$$_\n    require(msg.sender == $POOL, $$$_);\n    $$$_\n}"]))
          | not_at($all | of(["function $CALLBACK($$$_) {\n    $$$_\n    require(_msgSender() == $POOL, $$$_);\n    $$$_\n}"]))
          | not_at($all | of(["function $CALLBACK($$$_) {\n    $$$_\n    require($POOL == msg.sender, $$$_);\n    $$$_\n}"]))
          | not_at($all | of(["function $CALLBACK($$$_) {\n    $$$_\n    require($POOL == _msgSender(), $$$_);\n    $$$_\n}"]))
          | not_at($all | of(["function $CALLBACK($$$_) {\n    $$$_\n    if (msg.sender != $POOL) {\n      $$$_\n    }\n    $$$_\n}"]))
          | not_at($all | of(["function $CALLBACK($$$_) {\n    $$$_\n    if (_msgSender() != $POOL) {\n      $$$_\n    }\n    $$$_\n}"]))
          | not_at($all | of(["function $CALLBACK($$$_) {\n    $$$_\n    if (msg.sender == $POOL) {\n      $$$_\n    }\n    $$$_\n}"]))
          | not_at($all | of(["function $CALLBACK($$$_) {\n    $$$_\n    if (_msgSender() == $POOL) {\n      $$$_\n    }\n    $$$_\n}"]))
          | not_at($all | of(["function $CALLBACK($$$_) {\n    $$$_\n    if(!$POOLS[msg.sender]) {\n      $$$_\n    }\n    $$$_\n}"]))
          | not_at($all | of(["function $CALLBACK($$$_) {\n    $$$_\n    if(!$POOLS[_msgSender()]) {\n      $$$_\n    }\n    $$$_\n}"]))
          | not_at($all | of(["function $CALLBACK($$$_) {\n    $$$_\n    _verifyCallback($$$_);\n    $$$_\n}"]))
          | not_at($all | of(["function $CALLBACK($$$_) isCallback {\n    $$$_\n}"]))
          | not_at($all | of(["function $CALLBACK($$$_) {\n    $$$_\n    require($POOLS[msg.sender], $$$_);\n    $$$_\n}"]))
          | not_at($all | of(["function $CALLBACK($$$_) {\n    $$$_\n    require($POOLS[_msgSender()], $$$_);\n    $$$_\n}"]))
          | where_capture("CALLBACK"; "^(?:(uniswapV2Call|uniswapV3SwapCallback|uniswapV3FlashCallback|uniswapV3MintCallback))")
        | finding("uniswap-callback-not-protected";
            "Uniswap callback is not protected") ) )
| report
