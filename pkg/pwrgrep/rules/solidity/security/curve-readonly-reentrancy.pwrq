# rules: curve-readonly-reentrancy
# from: solidity/security/curve-readonly-reentrancy.yaml

. as $root
| ( ($root | scan_regex(["*.sol"]; [
      "(?P<POOL>\\S+)\\.get_virtual_price\\(\\)",
      "contract\\s+(?P<C>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+function\\s+(?P<CHECKFUNC>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<VAR>\\S+)\\.withdraw_admin_fees\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+function\\s+(?P<F>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<CHECKFUNC>\\S+)\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+(?P<POOL>\\S+)\\.get_virtual_price\\(\\);\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}",
      "contract\\s+(?P<C>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+function\\s+(?P<CHECKFUNC>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<VAR>\\S+)\\.withdraw_admin_fees\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+function\\s+(?P<F>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<POOL>\\S+)\\.get_virtual_price\\(\\);\\s+[\\s\\S]*?\\s+(?P<CHECKFUNC>\\S+)\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}",
      "function\\s+(?P<F>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<VAR>\\S+)\\.withdraw_admin_fees\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}"
    ])) as $all
    | ( $all | of(["(?P<POOL>\\S+)\\.get_virtual_price\\(\\)"])
          | outside($all | of(["function\\s+(?P<F>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<VAR>\\S+)\\.withdraw_admin_fees\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}"]))
          | outside($all | of(["function\\s+(?P<F>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<VAR>\\S+)\\.withdraw_admin_fees\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}"]))
          | outside($all | of(["contract\\s+(?P<C>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+function\\s+(?P<CHECKFUNC>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<VAR>\\S+)\\.withdraw_admin_fees\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+function\\s+(?P<F>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<CHECKFUNC>\\S+)\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+(?P<POOL>\\S+)\\.get_virtual_price\\(\\);\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}"]))
          | outside($all | of(["contract\\s+(?P<C>\\S+)\\s+\\{\\s+[\\s\\S]*?\\s+function\\s+(?P<CHECKFUNC>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<VAR>\\S+)\\.withdraw_admin_fees\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+function\\s+(?P<F>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<POOL>\\S+)\\.get_virtual_price\\(\\);\\s+[\\s\\S]*?\\s+(?P<CHECKFUNC>\\S+)\\([\\s\\S]*?\\);\\s+[\\s\\S]*?\\s+\\}\\s+[\\s\\S]*?\\s+\\}"]))
        | finding("curve-readonly-reentrancy";
            "$POOL.get_virtual_price() call on a Curve pool is not protected from the read-only reentrancy.") ) )
| report
