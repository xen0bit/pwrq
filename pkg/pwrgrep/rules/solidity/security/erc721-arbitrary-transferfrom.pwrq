# rules: erc721-arbitrary-transferfrom
# from: solidity/security/erc721-arbitrary-transferfrom.yaml

. as $root
| ( ($root | scan_regex(["*.sol"]; [
      "\\(<[\\s\\S]*?\\s+_msgSender\\(\\)\\s+==\\s+(?P<FROM>\\S+)\\s+[\\s\\S]*?>\\);\\s+[\\s\\S]*?",
      "\\(<[\\s\\S]*?\\s+_msgSender\\(\\)\\s+==\\s+(?P<PREV>\\S+)\\.(?P<ADDR>\\S+)\\s+[\\s\\S]*?>\\);\\s+[\\s\\S]*?",
      "\\(<[\\s\\S]*?\\s+msg\\.sender\\s+==\\s+(?P<FROM>\\S+)\\s+[\\s\\S]*?>\\);\\s+[\\s\\S]*?",
      "_approve\\([\\s\\S]*?\\);",
      "function\\s+_transfer\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}",
      "require\\(_isApprovedOrOwner\\([\\s\\S]*?\\),\\s+[\\s\\S]*?\\);\\s+[\\s\\S]*?",
      "require\\(prevOwnership\\.addr\\s+==\\s+(?P<FROM>\\S+),\\s+[\\s\\S]*?\\);\\s+[\\s\\S]*?"
    ])) as $all
    | ( $all | of(["_approve\\([\\s\\S]*?\\);"])
          | within($all | of(["function\\s+_transfer\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}"]))
          | in_files_with($all | of(["require\\(prevOwnership\\.addr\\s+==\\s+(?P<FROM>\\S+),\\s+[\\s\\S]*?\\);\\s+[\\s\\S]*?"]))
          | in_files_without($all | of(["\\(<[\\s\\S]*?\\s+_msgSender\\(\\)\\s+==\\s+(?P<FROM>\\S+)\\s+[\\s\\S]*?>\\);\\s+[\\s\\S]*?"]))
          | in_files_without($all | of(["\\(<[\\s\\S]*?\\s+_msgSender\\(\\)\\s+==\\s+(?P<PREV>\\S+)\\.(?P<ADDR>\\S+)\\s+[\\s\\S]*?>\\);\\s+[\\s\\S]*?"]))
          | in_files_without($all | of(["\\(<[\\s\\S]*?\\s+msg\\.sender\\s+==\\s+(?P<FROM>\\S+)\\s+[\\s\\S]*?>\\);\\s+[\\s\\S]*?"]))
          | in_files_without($all | of(["require\\(_isApprovedOrOwner\\([\\s\\S]*?\\),\\s+[\\s\\S]*?\\);\\s+[\\s\\S]*?"]))
        | finding("erc721-arbitrary-transferfrom";
            "Custom ERC721 implementation lacks access control checks in _transfer()") ) )
| report
