# rules: array-length-outside-loop
# from: solidity/performance/array-length-outside-loop.yaml

. as $root
| ( ($root | scan_regex(["*.sol"]; [
      "(?P<VAR>\\S+)\\.length",
      "for\\s+\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}",
      "function\\s+(?P<F>\\S+)\\([\\s\\S]*?,\\s+(?P<TYPE>\\S+)\\s+calldata\\s+(?P<VAR>\\S+),\\s+[\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}",
      "function\\s+(?P<F>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<TYPE>\\S+)\\[[\\s\\S]*?\\]\\s+storage\\s+(?P<VAR>\\S+);\\s+[\\s\\S]*?\\s+\\}",
      "function\\s+(?P<F>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<TYPE>\\S+)\\[[\\s\\S]*?\\]\\s+storage\\s+(?P<VAR>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+\\}",
      "while\\s+\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}"
    ])) as $all
    | ( ($all
          | within($all | of(["for\\s+\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}"])))
          + ($all
          | within($all | of(["while\\s+\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}"])))
          | at_same_place(($all | of(["(?P<VAR>\\S+)\\.length"])))
          | outside($all | of(["function\\s+(?P<F>\\S+)\\([\\s\\S]*?,\\s+(?P<TYPE>\\S+)\\s+calldata\\s+(?P<VAR>\\S+),\\s+[\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}"]))
          | outside($all | of(["function\\s+(?P<F>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<TYPE>\\S+)\\[[\\s\\S]*?\\]\\s+storage\\s+(?P<VAR>\\S+);\\s+[\\s\\S]*?\\s+\\}"]))
          | outside($all | of(["function\\s+(?P<F>\\S+)\\([\\s\\S]*?\\)\\s+\\{\\s+[\\s\\S]*?\\s+(?P<TYPE>\\S+)\\[[\\s\\S]*?\\]\\s+storage\\s+(?P<VAR>\\S+)\\s+=\\s+[\\s\\S]*?;\\s+[\\s\\S]*?\\s+\\}"]))
        | finding("array-length-outside-loop";
            "Caching the array length outside a loop saves reading it on each iteration, as long as the array's length is not changed during the loop.") ) )
| report
