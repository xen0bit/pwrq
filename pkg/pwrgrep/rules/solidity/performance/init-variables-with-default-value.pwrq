# rules: init-variables-with-default-value
# languages: solidity
# from: solidity/performance/init-variables-with-default-value.yaml

. as $root
| ( ($root | scan_ast(["*.sol"]; [
      "$TYPE $VAR = \"\";",
      "$TYPE $VAR = '';",
      "$TYPE $VAR = 0;",
      "$TYPE $VAR = false;",
      "$TYPE constant $VAR = $$$_;",
      "contract $C {\n  $$$_\n  $TYPE immutable $VAR = $$$_;\n  $$$_\n}",
      "function $F($$$_) {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["$TYPE $VAR = 0;","$TYPE $VAR = false;","$TYPE $VAR = \"\";","$TYPE $VAR = '';"])
          | not_at($all | of(["$TYPE constant $VAR = $$$_;"]))
          | outside($all | of(["contract $C {\n  $$$_\n  $TYPE immutable $VAR = $$$_;\n  $$$_\n}"]))
          | outside($all | of(["function $F($$$_) {\n  $$$_\n}"]))
        | finding("init-variables-with-default-value";
            "Uninitialized variables are assigned with the types default value.") ) )
| report
