# rules: use-prefix-increment-not-postfix
# from: solidity/performance/use-prefix-increment-not-postfix.yaml

. as $root
| ( ($root | scan_regex(["*.sol"]; [
      "(?P<B>\\S+)\\s+=\\s+[\\s\\S]*?",
      "(?P<VAR>\\S+)\\+\\+",
      "if\\s+\\(<[\\s\\S]*?\\s+(?P<VAR>\\S+)\\+\\+\\s+[\\s\\S]*?>\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}",
      "require\\s+\\(<[\\s\\S]*?\\s+(?P<VAR>\\S+)\\+\\+\\s+[\\s\\S]*?>\\)",
      "return\\s+[\\s\\S]*?;",
      "while\\s+\\(<[\\s\\S]*?\\s+(?P<VAR>\\S+)\\+\\+\\s+[\\s\\S]*?>\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}"
    ])) as $all
    | ( $all | of(["(?P<VAR>\\S+)\\+\\+"])
          | outside($all | of(["(?P<B>\\S+)\\s+=\\s+[\\s\\S]*?"]))
          | outside($all | of(["if\\s+\\(<[\\s\\S]*?\\s+(?P<VAR>\\S+)\\+\\+\\s+[\\s\\S]*?>\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}"]))
          | outside($all | of(["require\\s+\\(<[\\s\\S]*?\\s+(?P<VAR>\\S+)\\+\\+\\s+[\\s\\S]*?>\\)"]))
          | outside($all | of(["while\\s+\\(<[\\s\\S]*?\\s+(?P<VAR>\\S+)\\+\\+\\s+[\\s\\S]*?>\\)\\s+\\{\\s+[\\s\\S]*?\\s+\\}"]))
          | outside($all | of(["return\\s+[\\s\\S]*?;"]))
        | finding("use-prefix-increment-not-postfix";
            "Consider using the prefix increment expression whenever the return value is not needed.") ) )
| report
