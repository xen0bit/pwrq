# rules: non-payable-constructor
# languages: solidity
# from: solidity/performance/non-payable-constructor.yaml

. as $root
| ( ($root | scan_ast(["*.sol"]; [
      "abstract contract $ANY{\n  $$$_\n}",
      "constructor($$$_) payable{\n  $$$_\n}",
      "constructor($$$_){\n  $$$_\n}",
      "contract $ANY{\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["constructor($$$_){\n  $$$_\n}"])
          | within($all | of(["contract $ANY{\n  $$$_\n}"]))
          | outside($all | of(["abstract contract $ANY{\n  $$$_\n}"]))
          | not_at($all | of(["constructor($$$_) payable{\n  $$$_\n}"]))
        | finding("non-payable-constructor";
            "Consider making costructor payable to save gas.") ) )
| report
