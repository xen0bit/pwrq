# rules: non-optimal-variables-swap
# languages: solidity
# from: solidity/performance/non-optimal-variables-swap.yaml

. as $root
| ( ($root | scan_ast(["*.sol"]; [
      "$TMP = $VAR1;\n$$$_\n$VAR1 = $VAR2;\n$$$_\n$VAR2 = $TMP;"
    ])) as $all
    | ( $all | of(["$TMP = $VAR1;\n$$$_\n$VAR1 = $VAR2;\n$$$_\n$VAR2 = $TMP;"])
        | finding("non-optimal-variables-swap";
            "Consider swapping variables using `($VAR1, $VAR2) = ($VAR2, $VAR1)` to save gas") ) )
| report
