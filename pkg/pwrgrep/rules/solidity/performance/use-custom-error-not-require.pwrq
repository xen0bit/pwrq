# rules: use-custom-error-not-require
# from: solidity/performance/use-custom-error-not-require.yaml

. as $root
| ( ($root | scan_regex(["*.sol"]; [
      "require\\([\\s\\S]*?,\\s+\"(?P<MSG>\\S+)\"\\);",
      "revert\\(\"(?P<MSG>\\S+)\"\\);"
    ])) as $all
    | ( $all | of(["require\\([\\s\\S]*?,\\s+\"(?P<MSG>\\S+)\"\\);","revert\\(\"(?P<MSG>\\S+)\"\\);"])
        | finding("use-custom-error-not-require";
            "Consider using custom errors as they are more gas efficient while allowing developers to describe the error in detail using NatSpec.") ) )
| report
