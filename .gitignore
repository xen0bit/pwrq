# Binaries. Anchored to the repository root: unanchored, `pwrq` matches a
# directory of that name anywhere, which once silently swallowed a directory
# of rules that was called pwrq.
/pwrq
/pwrq-viz

# Compiled test binaries. `go test -c` and a `-o` build drop these next to the
# package; pwrgrep.test was committed by accident once already.
*.test

# GoReleaser output
/dist/

# `make rules.export` — the corpus copied out of the module cache for packaging
/build/

# Coverage files
coverage.out
coverage.html

# Web build artifacts
pkg/web/dist/
pkg/web/src/wasm/
pkg/web/src/js/wasm_exec.js
pkg/web/src/node_modules/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~