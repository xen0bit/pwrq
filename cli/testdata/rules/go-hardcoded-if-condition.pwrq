include "opengrep";

# fixture: fixtures/go/hardcoded-if-condition.go
# ported-from: go/lang/correctness/useless-eqeq.yaml (hardcoded-eq-true-or-false)
#
# A branch that is not a branch: the condition is decided before the program
# runs, so one arm is dead and the other is unconditional.
#
# The original writes `if (true) { ... }` and relies on Semgrep normalising the
# parentheses away. pwrq does not: the pattern is matched against the parse
# tree as written, and `(true)` is a parenthesised expression wrapping the
# constant rather than the constant. Both spellings are therefore patterns.
# Gofmt removes the parentheses, so the second pair only ever fires on code
# that has not been formatted - which is exactly the code worth checking.

["if true { $$$_ }", "if false { $$$_ }",
 "if (true) { $$$_ }", "if (false) { $$$_ }"] as $constant
| scan("*.go"; $constant)
| finding("go-hardcoded-if-condition";
    "this condition is a constant, so one arm of the branch is unreachable")
| report
