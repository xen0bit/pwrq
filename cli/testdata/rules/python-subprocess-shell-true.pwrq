include "opengrep";

# fixture: fixtures/python/subprocess-shell-true.py
# ported-from: python/lang/security/audit/subprocess-shell-true.yaml (subprocess-shell-true)
#
# A subprocess run through a shell, so every character of the command is
# syntax to something.
#
# The original's `focus-metavariable: $TRUE` has no port. It moves where the
# finding points - at the `shell=True` rather than at the whole call - and a
# capture in pwrq reports text, not a place, so there is nothing to point at.
# The rule fires on exactly the same calls; the caret sits further left.
#
# `metavariable-pattern` restricting $TRUE to `True` is not needed either: the
# pattern can say True where the original had to say $TRUE and then constrain
# it, because there is no `focus-metavariable` here wanting a name to focus on.

["subprocess.$F($$$_, shell=True, $$$_)"] as $shelled
| ["subprocess.$F($S:string, shell=True, $$$_)"] as $constant
| scan("*.py"; $shelled + $constant) as $all
| ($all | of($shelled) | not_at($all | of($constant)))
| finding("python-subprocess-shell-true";
    "subprocess.\(.Captures.F) runs this through a shell, so the command string "
    + "is parsed rather than executed; pass a list and shell=False")
| report
