include "opengrep";

# fixture: fixtures/go/useless-comparison.go
# ported-from: go/lang/correctness/useless-eqeq.yaml (eqeq-is-bad)
#
# A comparison of something with itself, which is a constant with extra steps
# and usually a typo for a comparison with something else.
#
# This is the rule that made the case for reading a repeated hole as a repeated
# hole. The original is `pattern: $X == $X`, one name used twice, and select_ast
# used to refuse it: a match keeps one capture per name, so the second use added
# no constraint and the pattern would have matched `a == b`. The port had to
# name the two sides apart and compare what they caught afterwards. It does not
# any more - the query says it with a predicate - so the port is now the
# original, character for character.
#
# The rest is the original's three guards, one operator each: `pattern-either`
# is two patterns, `pattern-not: 1 == 1` is not_at, and `pattern-not-inside:
# assert(...)` is outside - the one place in this corpus where a rule really
# does mean a span containing another span rather than a file containing one.

["$X == $X", "$X != $X"] as $compare
| scan("*.go"; $compare + ["1 == 1", "assert($$$_)"]) as $all
| ($all | of($compare)
   | not_at($all | of("1 == 1"))
   | outside($all | of("assert($$$_)")))
| finding("go-useless-comparison";
    "\(.Text) compares \(.Captures.X) with itself and is always the same answer")
| report
