include "opengrep";

# fixture: fixtures/go/useless-comparison.go
# ported-from: go/lang/correctness/useless-eqeq.yaml (eqeq-is-bad)
#
# A comparison of something with itself, which is a constant with extra steps
# and usually a typo for a comparison with something else.
#
# This is the rule that pwrq refuses to write the way Semgrep writes it. The
# original is `pattern: $X == $X`, one hole used twice, and select_ast will not
# compile that: a match keeps one capture per name, so the second use adds no
# constraint at all and `$X == $X` matches `a == b`. The port names the two
# sides separately and compares what they caught, which is where_same.
#
# The rest is the original's three guards, one operator each: `pattern-either`
# is two patterns, `pattern-not: 1 == 1` is not_at, and `pattern-not-inside:
# assert(...)` is outside - the one place in this corpus where a rule really
# does mean a span containing another span rather than a file containing one.

["$A == $B", "$A != $B"] as $compare
| scan("*.go"; $compare + ["1 == 1", "assert($$$_)"]) as $all
| ($all | of($compare)
   | where_same("A"; "B")
   | not_at($all | of("1 == 1"))
   | outside($all | of("assert($$$_)")))
| finding("go-useless-comparison";
    "\(.Text) compares \(.Captures.A) with itself and is always the same answer")
| report
